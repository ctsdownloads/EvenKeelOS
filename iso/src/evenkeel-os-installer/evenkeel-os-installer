#!/usr/bin/python3
"""The EvenKeelOS installer on the live USB: one window, one screen at a time (the *screens.py files)."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GdkPixbuf, Gio, GLib, Gtk  # noqa: E402

import disk_screens  # noqa: E402
from i18n import _  # noqa: E402
import finish_screens  # noqa: E402
import locale_screens  # noqa: E402
import screens  # noqa: E402

LOGO = "/usr/share/evenkeel-os-installer/logo-wide.svg"     # build_files/branding/logo-EvenKeel-wide.svg


STEPS = [locale_screens.LanguageScreen, locale_screens.KeyboardScreen, locale_screens.BootKeyboardScreen,
         locale_screens.NetworkScreen, locale_screens.TimeZoneScreen, locale_screens.DateTimeScreen,
         locale_screens.ClockScreen, disk_screens.DiskScreen, disk_screens.EraseScreen, disk_screens.EncryptionScreen,
         disk_screens.RootScreen, disk_screens.UserScreen, disk_screens.ComputerNameScreen,
         disk_screens.ExperienceScreen, disk_screens.LayoutScreen, disk_screens.ReviewScreen]


class InstallerWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, default_width=980, default_height=760)
        self.choices = screens.Choices()
        self.returning = False                 # changing one thing from Review: Next goes back there

        header = Adw.HeaderBar(css_classes=["brand"], show_title=True)
        brand = Gtk.Box(spacing=12)
        # Drawn at the bar's height, not the SVG's own size.
        scale = self.get_scale_factor()
        logo = GdkPixbuf.Pixbuf.new_from_file_at_scale(LOGO, -1, 34 * scale, True)
        picture = Gtk.Picture.new_for_paintable(Gdk.Texture.new_for_pixbuf(logo))
        picture.set_size_request(logo.get_width() // scale, 34)
        brand.append(picture)
        self.badge = Gtk.Label(css_classes=["release-stage"], valign=Gtk.Align.CENTER)
        brand.append(self.badge)
        header.pack_start(brand)
        header.set_title_widget(Gtk.Label())
        self.step = Gtk.Label(css_classes=["step"])
        header.pack_end(self.step)

        self.heading = Gtk.Label(xalign=0, wrap=True, css_classes=["title-1"])
        self.intro = Gtk.Label(xalign=0, wrap=True, css_classes=["intro"])
        self.status = Gtk.Label(xalign=0, wrap=True, css_classes=["status"])
        self.stack = Gtk.Stack(vexpand=True)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=24, margin_bottom=12,
                       margin_start=24, margin_end=24, vexpand=True)
        for w in (self.heading, self.intro, self.status, self.stack):
            page.append(w)
        clamp = Adw.Clamp(maximum_size=760, child=page, vexpand=True, valign=Gtk.Align.FILL)

        self.buttons = Gtk.Box(spacing=10, halign=Gtk.Align.END, hexpand=True, margin_top=12, margin_bottom=12,
                               margin_start=24, margin_end=24)

        view = Adw.ToolbarView(content=clamp)
        view.add_top_bar(header)
        view.add_bottom_bar(self.buttons)
        self.set_content(view)

        self.made = {}
        self.installing = False
        self.connect("close-request", self.closing)
        self.show_screen(STEPS[0])

    def screen(self, cls):
        if cls not in self.made:
            self.made[cls] = cls(self)
            self.stack.add_child(self.made[cls].body)
        return self.made[cls]

    def show_screen(self, cls):
        self.current = self.screen(cls)
        self.current.enter()
        self.stack.set_visible_child(self.current.body)
        self.update()

    def go_next(self):
        cls = type(self.current)
        if self.returning and cls not in (disk_screens.DiskScreen, disk_screens.EraseScreen):
            self.show_screen(disk_screens.ReviewScreen)
            return
        self.show_screen(STEPS[STEPS.index(cls) + 1])
        if type(self.current) is disk_screens.ReviewScreen:
            self.returning = False

    def go_back(self):
        if self.current.go_back():
            return
        cls = type(self.current)
        if self.returning:
            self.returning = False
            self.show_screen(disk_screens.ReviewScreen)
        elif cls in STEPS and STEPS.index(cls) > 0:
            self.show_screen(STEPS[STEPS.index(cls) - 1])

    def change(self, cls):
        """From Review: show one screen; Next comes back to Review."""
        self.returning = True
        self.show_screen(cls)

    def install(self):
        self.installing = True
        self.show_screen(finish_screens.InstallingScreen)
        self.current.start()

    def install_done(self):
        self.installing = False
        self.show_screen(finish_screens.DoneScreen)

    def install_failed(self, problem, log, english=None):
        """problem is shown; english (the same words in English) goes into the GitHub report."""
        self.installing = False
        self.screen(finish_screens.ErrorScreen).failed(problem, log, english)
        self.show_screen(finish_screens.ErrorScreen)

    def restart(self):
        """Restart the computer; if it doesn't start, show systemctl's message and exit code."""
        self.set_visible(False)
        proc = Gio.Subprocess.new(["systemctl", "reboot"],
                                  Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        proc.communicate_utf8_async(None, None, self._restart_answered)

    def _restart_answered(self, proc, result):
        _ok, out, _err = proc.communicate_utf8_finish(result)
        if proc.get_if_exited() and proc.get_exit_status() == 0:
            return                          # the computer is restarting
        code = (proc.get_exit_status() if proc.get_if_exited() else
                _("signal {number}").format(number=proc.get_term_sig()))
        self.set_visible(True)
        self.update()
        message = (out or "").strip() or _("(nothing was printed)")
        dialog = Adw.AlertDialog(heading=_("The restart didn't start"),
                                 body=_("The restart said:\n\n{message}\n\nExit code: {code}").format(
                                     message=message, code=code))
        dialog.add_response("ok", _("OK"))
        dialog.present(self)

    def closing(self, *_args):
        """The window can't be closed while the disk is being written."""
        return self.installing

    def update(self):
        s = self.current
        cls = type(s)
        self.set_title(_("Install EvenKeelOS"))
        self.badge.set_text(_("Alpha"))
        s.relabel()
        if cls in STEPS:
            self.step.set_text(_("Step {number} of {total}: {name}").format(number=STEPS.index(cls) + 1,
                                                                            total=len(STEPS), name=_(s.step)))
        else:
            self.step.set_text("")
        self.heading.set_text(_(s.title))
        self.intro.set_text(s.intro)
        status = s.status()
        self.status.set_text(status)
        in_body = isinstance(s, (disk_screens.EraseScreen, disk_screens.ReviewScreen))     # they show it themselves
        self.status.set_visible(bool(status) and not in_body)

        child = self.buttons.get_first_child()
        while child:
            self.buttons.remove(child)
            child = self.buttons.get_first_child()
        if s.back or self.returning:
            self._button(_("Back"), self.go_back)
        danger, main = (_(x) if x else None for x in (s.danger, s.main))
        for name, do in s.actions():
            css = "destructive-action" if name == danger else "suggested-action" if name == main else None
            self._button(name, do, css)
        if s.next_label:
            self._button(_(s.next_label), self.go_next, "suggested-action").set_sensitive(s.ready())

    def _button(self, name, do, css=None):
        b = Gtk.Button(label=name, css_classes=["pill"] + ([css] if css else []))
        b.connect("clicked", lambda *_args: do())
        self.buttons.append(b)
        return b


class Installer(Adw.Application):
    def __init__(self):
        super().__init__(application_id="io.github.ctsdownloads.EvenKeelOS.Installer",
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self):
        Adw.Application.do_startup(self)
        self.styles = {}
        for name in ("style.css", "style-dark.css"):
            p = Gtk.CssProvider()
            p.load_from_path(os.path.join(HERE, name))
            self.styles[name] = p
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.styles["style.css"],
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        manager = Adw.StyleManager.get_default()
        manager.connect("notify::dark", self._dark)
        self._dark(manager)

    def _dark(self, manager, *_args):
        display = Gdk.Display.get_default()
        if manager.get_dark():
            Gtk.StyleContext.add_provider_for_display(display, self.styles["style-dark.css"],
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        else:
            Gtk.StyleContext.remove_provider_for_display(display, self.styles["style-dark.css"])

    def do_activate(self):
        (self.get_active_window() or InstallerWindow(self)).present()


if __name__ == "__main__":
    GLib.set_prgname("evenkeel-os-installer")
    sys.exit(Installer().run(sys.argv))
