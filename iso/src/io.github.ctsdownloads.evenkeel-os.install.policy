<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Live USB only: the person at the computer starts the install engine without a password. -->
<policyconfig>
  <action id="io.github.ctsdownloads.evenkeel-os.install">
    <description>Install EvenKeelOS on this computer</description>
    <message>Authentication is required to install EvenKeelOS</message>
    <icon_name>evenkeel-os-installer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/evenkeel-os-install-engine</annotate>
  </action>
</policyconfig>
