# Test-only copy of the new image for the boot test on GitHub; never published.
ARG BASE
FROM ${BASE}
COPY boot_test/boot-check /usr/libexec/evenkeel-os-boot-check
COPY boot_test/check-lib.sh /usr/libexec/evenkeel-os-boot-check-lib.sh
COPY boot_test/boot-check-root /usr/libexec/evenkeel-os-boot-check-root
COPY boot_test/rollback-step /usr/libexec/evenkeel-os-rollback-step
# A small package for the rollback tests to add the way Install Package File does.
RUN dnf -q download --destdir=/usr/share/evenkeel-os-boot-test sl
# Test copy only: automatic login, SSH for the runner, no Flathub downloads, sudo for the two root test programs.
RUN printf '[daemon]\nAutomaticLoginEnable=True\nAutomaticLogin=tester\n' > /etc/gdm/custom.conf && \
    systemctl enable sshd.service && \
    systemctl mask evenkeel-os-flatpak-apps.service && \
    firewall-offline-cmd --zone=evenkeel-public --add-service=ssh && \
    chmod 755 /usr/libexec/evenkeel-os-boot-check /usr/libexec/evenkeel-os-boot-check-root \
      /usr/libexec/evenkeel-os-rollback-step && \
    printf 'tester ALL=(root) NOPASSWD: %s, %s\n' /usr/libexec/evenkeel-os-boot-check-root \
      /usr/libexec/evenkeel-os-rollback-step > /etc/sudoers.d/boot-test && \
    chmod 440 /etc/sudoers.d/boot-test && \
    visudo -cf /etc/sudoers.d/boot-test
