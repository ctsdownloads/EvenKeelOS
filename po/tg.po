msgstr "Он дар шабакаи «Хона» худ аз худ дубора фаъол мешавад."

msgid "It could not reach the internet. Check the connection, then try again."
msgstr ""
"Ба интернет пайваст шудан нашуд. Пайвастро санҷед, баъд дубора кӯшиш кунед."

msgid "It didn't work, and nothing was changed."
msgstr "Ин натиҷа надод ва ҳеҷ чиз тағйир дода нашуд."

#, python-brace-format
msgid ""
"It didn't work, and nothing was changed.\n"
"\n"
"The details are in {log}"
msgstr ""
"Ин натиҷа надод ва ҳеҷ чиз тағйир дода нашуд.\n"
"\n"
"Тафсилот дар {log}"

#, python-brace-format
msgid ""
"It didn't work, and nothing was changed. Try again later.\n"
"\n"
"The details are in {log}"
