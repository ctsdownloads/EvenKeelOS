msgid "Layout set to {layout}. Log out and back in to finish."
msgstr ""
"چیدمان روی {layout} تنظیم شد. برای پایان کار، خارج شوید و دوباره وارد شوید."

msgid "Let an app in"
msgstr "اجازه دادن به یک برنامه"

msgid "Let an app in on Home"
msgstr "اجازه دادن به یک برنامه در «خانه»"

msgid "Let an app in on Work"
msgstr "اجازه دادن به یک برنامه در «محل کار»"

msgid "Let an app in on a Public place"
msgstr "اجازه دادن به یک برنامه در «مکان عمومی»"

msgid "Let an app or game in"
msgstr "اجازه دادن به یک برنامه یا بازی"

msgid ""
"Let computers on your Home network open folders you pick, with a password"
msgstr ""
"به رایانه‌های شبکهٔ «خانه» اجازه دهید پوشه‌هایی را که انتخاب می‌کنید، با "
"گذرواژه، باز کنند"

msgid "Let in a port by its number, with a name for it"
msgstr "اجازه دادن به یک درگاه با شماره‌اش، همراه با نامی برای آن"

msgid "Let it in"
msgstr "اجازه دادن"

msgid "Let other computers in"
msgstr "اجازه دادن به رایانه‌های دیگر"

#, python-brace-format
msgid "Let {name} in on a Public place?"
msgstr "به {name} در «مکان عمومی» اجازه داده شود؟"

msgid "Light and dark"
msgstr "روشن و تیره"

msgid "Light and dark schedule and wallpaper slideshow"
msgstr "زمان‌بندی روشن و تیره و نمایش پی‌درپی تصاویر پس‌زمینه"

msgid "Light from"
msgstr "روشن از"

msgid "Locked"
msgstr "قفل‌شده"

msgid "Log in from another computer (SSH)"
msgstr "ورود از رایانه‌ای دیگر (SSH)"

msgid ""
"Log in from another computer (SSH): for people who use a terminal. Leave it "
"off if you don't know it."
msgstr ""
"ورود از رایانه‌ای دیگر (SSH): برای کسانی که پایانه به کار می‌برند. اگر آن را "
"نمی‌شناسید، خاموش بگذارید."

msgid ""
"Log in when the login screen shows. About 3 minutes after you log in, a "
"window asks before the computer restarts. That happens on 2 starts, and the "
"third start is back on this version. If nobody logs in, each start waits 15 "
"minutes first, then restarts by itself."
msgstr ""
"وقتی صفحهٔ ورود نمایش داده شد وارد شوید. حدود ۳ دقیقه پس از ورود، پنجره‌ای "
"پیش از راه‌اندازی دوبارهٔ رایانه می‌پرسد. این در ۲ راه‌اندازی رخ می‌دهد و "
"راه‌اندازی سوم دوباره روی همین نسخه است. اگر کسی وارد نشود، هر راه‌اندازی اول"
" ۱۵ دقیقه صبر می‌کند، سپس خودبه‌خود دوباره راه‌اندازی می‌شود."

#, python-brace-format
msgid "Log out and back in once, so {title} lets your account use it."
msgstr ""
"یک بار خارج شوید و دوباره وارد شوید تا {title} به حساب شما اجازهٔ استفاده "
"بدهد."

msgid "Log out and back in to see it."
msgstr "برای دیدن آن، خارج شوید و دوباره وارد شوید."

msgid "Log out and back in to see the new layout."
msgstr "برای دیدن چیدمان جدید، خارج شوید و دوباره وارد شوید."

msgid "Logging in drops you back"
msgstr "ورود شما را دوباره به صفحهٔ ورود برمی‌گرداند"

msgid "Login loop"
msgstr "حلقهٔ ورود"

msgid "Looking up website names (DNS)"
msgstr "در حال یافتن نام وب‌سایت‌ها (DNS)"

