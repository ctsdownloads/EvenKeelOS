msgstr "گروه {group} وجود ندارد، یا هیچ کاربری برای افزودن به آن وجود ندارد."

msgid "No guide at login, with the Standard desktop"
msgstr "بدون راهنما هنگام ورود، با میزکار استاندارد"

msgid "No login screen"
msgstr "بدون صفحهٔ ورود"

