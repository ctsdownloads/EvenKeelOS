msgstr ""
"ثابت‌افزار نرم‌افزاری است که درون خود قطعات رایانه ساخته شده، مانند BIOS."

msgid "Firmware updated."
msgstr "ثابت‌افزار به‌روز شد."

msgid "Firmware updated. Some updates finish while the computer restarts."
msgstr ""
"ثابت‌افزار به‌روز شد. برخی به‌روزرسانی‌ها هنگام راه‌اندازی دوبارهٔ رایانه "
"تمام می‌شوند."

msgid "Firmware updates are available for:"
msgstr "به‌روزرسانی ثابت‌افزار برای این‌ها موجود است:"

#, python-brace-format
msgid ""
"First time only: downloads a few hundred MB and uses about {disk} of disk "
