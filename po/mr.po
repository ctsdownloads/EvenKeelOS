msgstr "EvenKeelOS ने कोणती भाषा वापरावी?"

msgid "Which one? Back goes to the list of languages."
msgstr "कोणती? \"मागे\" भाषांच्या सूचीवर परत नेते."

msgid "Which tool do you want?"
msgstr "तुम्हाला कोणते साधन हवे आहे?"

msgid "Wi-Fi"
msgstr "वाय-फाय"

msgid "Wi-Fi driver blocked"
