msgstr ""
"Najprej jih odstranite: zaženite  codecs remove , znova zaženite računalnik, "
"nato pa znova izberite »Vse«."

msgid "Remove things the computer no longer needs"
msgstr "Odstrani stvari, ki jih računalnik ne potrebuje več"

#, python-brace-format
msgid "Remove {title}?"
msgstr "Želite odstraniti {title}?"

