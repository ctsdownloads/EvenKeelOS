msgstr "Инсталирај"

msgid "Install Chrome"
msgstr "Инсталирај го Chrome"

msgid "Install EvenKeelOS"
msgstr "Инсталирај EvenKeelOS"

msgid "Install EvenKeelOS on this computer"
msgstr "Инсталирај EvenKeelOS на овој компјутер"

msgid ""
"Install EvenKeelOS puts it on this computer. Or Try it first: Install "
"EvenKeelOS is also in the dock."
msgstr ""
"„Инсталирај EvenKeelOS“ го става на овој компјутер. Или „Прво пробај го“: "
"„Инсталирај EvenKeelOS“ се наоѓа и во докот."

msgid "Install EvenKeelOS, or try it first"
msgstr "Инсталирајте го EvenKeelOS или прво пробајте го"

msgid "Install Media Codecs"
msgstr "Инсталирај медиумски кодеци"

msgid "Install Package File"
msgstr "Инсталирај датотека со пакет"

msgid "Install Package File is open"
msgstr "Прозорецот „Инсталирај датотека со пакет“ е отворен"

msgid "Install Package File is open. Cancel it when you're done looking."
msgstr ""
"Прозорецот „Инсталирај датотека со пакет“ е отворен. Кликнете на „Откажи“ "
"кога ќе завршите со разгледувањето."

msgid "Install Package File: after restart"
msgstr "Инсталирај датотека со пакет: по рестартирањето"

msgid "Install a package file"
msgstr "Инсталирај датотека со пакет"

msgid "Install an app from an .rpm or .deb file"
msgstr "Инсталирајте апликација од датотека .rpm или .deb"

