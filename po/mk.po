msgstr "Споделувањето не започна"

msgid "Sharing is off"
msgstr "Споделувањето е исклучено"

msgid "Sharing is off."
msgstr "Споделувањето е исклучено."

msgid "Sharing is on."
msgstr "Споделувањето е вклучено."

#, python-brace-format
msgid "Sharing on {networks}"
msgstr "Споделување на {networks}"

msgid "Sharing password"
msgstr "Лозинка за споделување"

msgid "Sharing password saved."
msgstr "Лозинката за споделување е зачувана."

msgid "Sharing starts by itself on a Home network."
msgstr "Споделувањето само започнува на домашна мрежа."

msgid "Sharing waits for a Home network"
msgstr "Споделувањето чека домашна мрежа"

msgid "Shift+Print Screen takes a picture of the whole screen straight away."
msgstr "Со Shift+Print Screen веднаш се прави слика од целиот екран."

msgid "Show"
msgstr "Прикажи"

msgid "Show a QR code"
msgstr "Прикажи QR-код"

msgid "Show me"
msgstr "Покажи ми"

#, python-brace-format
