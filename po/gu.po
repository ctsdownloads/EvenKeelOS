msgstr "અજ્ઞાત ડેસ્કટૉપ લેઆઉટ {layout}."

#, python-brace-format
msgid "Unknown experience {experience}."
msgstr "અજ્ઞાત શરૂઆતનો વિકલ્પ {experience}."

msgid "Unknown option: %s. Run  codecs  to see the choices."
msgstr "અજ્ઞાત વિકલ્પ: %s. વિકલ્પો જોવા માટે  codecs  ચલાવો."

#, python-brace-format
