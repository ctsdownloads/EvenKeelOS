msgstr "પ્રમાણભૂત"

msgid "Standard top bar, or Windows-style bottom bar and start menu"
msgstr "પ્રમાણભૂત ટોચનો બાર, અથવા Windows-શૈલીનો નીચેનો બાર અને સ્ટાર્ટ મેનૂ"

msgid "Start"
msgstr "શરૂ કરો"

msgid "Start Apps at Login"
msgstr "લૉગ ઇન વખતે ઍપ્સ શરૂ કરો"

msgid "Start Apps at Login is open"
msgstr "\"લૉગ ઇન વખતે ઍપ્સ શરૂ કરો\" ખુલ્લું છે"

msgid "Start an app when you log in"
msgstr "તમે લૉગ ઇન કરો ત્યારે કોઈ ઍપ શરૂ કરો"

msgid "Start apps at login"
msgstr "લૉગ ઇન વખતે ઍપ્સ શરૂ કરો"

msgid ""
"Start menu: with the Windows-style layout, the sailboat button at the bottom "
"left. With the standard layout, press the Windows key."
msgstr ""
"સ્ટાર્ટ મેનૂ: Windows-શૈલીના લેઆઉટમાં, નીચે ડાબી બાજુએ સઢવાળી હોડીનું બટન. "
"પ્રમાણભૂત લેઆઉટમાં, Windows કી દબાવો."

msgid "Start mode"
msgstr "શરૂઆતનો મોડ"

msgid "Start the USB stick again with the first entry, EvenKeelOS Live."
msgstr "USB સ્ટિકને ફરીથી પહેલી એન્ટ્રી, EvenKeelOS Live, વડે શરૂ કરો."

msgid "Start the test"
msgstr "ટેસ્ટ શરૂ કરો"

msgid "Started in UEFI mode."
msgstr "UEFI મોડમાં શરૂ થયું."

msgid "Started in basic graphics mode, so graphics can't be checked."
msgstr "મૂળભૂત ગ્રાફિક્સ મોડમાં શરૂ થયું, તેથી ગ્રાફિક્સ તપાસી શકાતા નથી."

msgid "Starting"
msgstr "શરૂ થઈ રહ્યું છે"

msgid "Starting hangs (about 7 minutes)"
msgstr "શરૂ થતી વખતે અટકી જાય છે (લગભગ 7 મિનિટ)"

msgid ""
"Starting hangs on the startup screen and the login screen never shows. After "
"3 minutes the computer restarts by itself. That happens twice (about 7 "
"minutes), and the third start is back on this version."
msgstr ""
"શરૂઆતની સ્ક્રીન પર અટકી જાય છે અને લૉગિન સ્ક્રીન ક્યારેય દેખાતી નથી. 3 મિનિટ "
"પછી કમ્પ્યુટર પોતે જ રીસ્ટાર્ટ થાય છે. આવું બે વાર થાય છે (લગભગ 7 મિનિટ), અને"
" ત્રીજી શરૂઆત ફરી આ વર્ઝન પર થાય છે."

msgid "Starting the computer"
msgstr "કમ્પ્યુટર શરૂ કરી રહ્યા છીએ"

msgid "Starts at login"
msgstr "લૉગ ઇન વખતે શરૂ થાય છે"

msgid "Status"
msgstr "સ્થિતિ"

#, python-brace-format
msgid "Step {number} of {total}: {name}"
msgstr "પગલું {number}/{total}: {name}"

#, python-brace-format
msgid ""
"Still not working after a restart.\n"
"\n"
"These still don't work since the Boot options change:\n"
"{broke}"
msgstr ""
"રીસ્ટાર્ટ પછી પણ કામ કરતું નથી.\n"
"\n"
"બૂટ વિકલ્પોના ફેરફાર પછીથી આ હજી કામ કરતાં નથી:\n"
"{broke}"

#, python-brace-format
msgid ""
"Still not working after a restart.\n"
"\n"
"These still don't work since the update:\n"
"{broke}"
msgstr ""
"રીસ્ટાર્ટ પછી પણ કામ કરતું નથી.\n"
"\n"
"અપડેટ પછીથી આ હજી કામ કરતાં નથી:\n"
"{broke}"

msgid "Stop sharing it"
msgstr "તેને શેર કરવાનું બંધ કરો"

#, python-brace-format
msgid "Stop sharing {name}"
msgstr "{name} શેર કરવાનું બંધ કરો"

msgid ""
"Stopping %s in its box. This takes a few seconds. If GNOME shows a Force Quit"
" / Wait window, you do not need to press anything: %s closes on its own."
msgstr ""
"%sને તેના બોક્સમાં બંધ કરી રહ્યા છીએ. આમાં થોડી સેકન્ડ લાગે છે. જો GNOME "
"\"Force Quit / Wait\" વિન્ડો બતાવે, તો તમારે કંઈ દબાવવાની જરૂર નથી: %s પોતે જ"
" બંધ થઈ જાય છે."

msgid ""
"Strangers on the same network, in a café, hotel or airport, could reach it "
"too. Only do this if you need it here, and close it again when you're done."
msgstr ""
"એ જ નેટવર્ક પરના અજાણ્યા લોકો, કેફે, હોટેલ કે એરપોર્ટમાં, પણ તેના સુધી પહોંચી"
" શકે છે. અહીં જરૂર હોય તો જ આ કરો, અને કામ પૂરું થાય ત્યારે તેને ફરીથી બંધ "
"કરો."

#, python-brace-format
msgid "Strength: {strength}."
msgstr "મજબૂતી: {strength}."

msgid "Strong"
msgstr "મજબૂત"

msgid "Stuck while starting"
msgstr "શરૂ થતી વખતે અટકી ગયું"

msgid ""
"Style: Default (light) or Dark. Accent Color: the color of buttons and folder"
" icons."
msgstr ""
"Style: Default (લાઇટ) અથવા Dark. Accent Color: બટનો અને ફોલ્ડર આઇકનનો રંગ."

msgid "Suggested"
msgstr "સૂચવેલ"

msgid ""
"Sunset and sunrise can't be worked out for this time zone. Use Custom times."
msgstr ""
"આ સમય ઝોન માટે સૂર્યાસ્ત અને સૂર્યોદયનો સમય ગણી શકાતો નથી. \"કસ્ટમ સમય\" "
"વાપરો."

msgid "Sunset to sunrise"
msgstr "સૂર્યાસ્તથી સૂર્યોદય સુધી"

msgid "Switch"
msgstr "બદલો"

msgid ""
"Switch between light and dark yourself, in Settings or the quick settings "
"menu."
msgstr ""
"સુયોજનોમાં અથવા Quick Settings મેનૂમાં, લાઇટ અને ડાર્ક વચ્ચે જાતે બદલો."

msgid "Switch to the dark style at sunset, or at times you pick"
msgstr "સૂર્યાસ્ત સમયે, અથવા તમે પસંદ કરો તે સમયે, ડાર્ક સ્ટાઇલ પર બદલો"

msgid ""
"Switches the dark style for you. Night Light in Settings only warms the "
"colors. You can still switch it yourself any time."
msgstr ""
"તમારા માટે ડાર્ક સ્ટાઇલ બદલે છે. સુયોજનોમાંનું Night Light ફક્ત રંગોને ગરમ "
"બનાવે છે. તમે હજી પણ ગમે ત્યારે તેને જાતે બદલી શકો છો."

msgid "Switching the desktop layout."
msgstr "ડેસ્કટૉપ લેઆઉટ બદલી રહ્યા છીએ."

msgid "System"
msgstr "સિસ્ટમ"

msgid "System Update"
msgstr "સિસ્ટમ અપડેટ"

msgid "Take a screenshot or record the screen"
msgstr "સ્ક્રીનશૉટ લો અથવા સ્ક્રીન રેકોર્ડ કરો"

msgid "Take it out"
msgstr "તેને કાઢો"

#, python-brace-format
msgid "Take out {setting}"
msgstr "{setting} કાઢો"

msgid "Take the extra formats out again"
msgstr "વધારાના ફોર્મેટ ફરીથી કાઢો"

msgid "Task Manager: Resources. Find it in the start menu."
msgstr "Task Manager: Resources. તેને સ્ટાર્ટ મેનૂમાં શોધો."

msgid "Teal to start. Folder icons follow whatever color you pick."
msgstr "શરૂઆતમાં ટીલ. તમે જે પણ રંગ પસંદ કરો, ફોલ્ડર આઇકન તે રંગને અનુસરે છે."

msgid "Test automatic rollback"
msgstr "સ્વચાલિત રોલબેક ટેસ્ટ કરો"

msgid "Text size"
msgstr "ટેક્સ્ટનું કદ"

msgid "That couldn't be saved."
msgstr "તે સાચવી શકાયું નહીં."

msgid "That didn't save. Try again in Wheelhouse, Network safety."
msgstr "તે સચવાયું નહીં. Wheelhouse, નેટવર્ક સુરક્ષામાં ફરી પ્રયાસ કરો."

msgid "That folder belongs to someone else."
msgstr "તે ફોલ્ડર બીજા કોઈની માલિકીનું છે."

msgid "That folder has no pictures in it (JPEG, PNG or WebP)."
msgstr "તે ફોલ્ડરમાં કોઈ ચિત્રો નથી (JPEG, PNG અથવા WebP)."

#, python-brace-format
msgid "That folder is already shared, as {name}."
msgstr "તે ફોલ્ડર પહેલેથી જ {name} તરીકે શેર કરવામાં આવ્યું છે."

msgid "That folder isn't shared."
msgstr "તે ફોલ્ડર શેર કરેલું નથી."

msgid "That folder wasn't found."
msgstr "તે ફોલ્ડર મળ્યું નથી."

msgid "That folder's name can't be shared. Rename it or pick another."
msgstr ""
"તે ફોલ્ડરનું નામ શેર કરી શકાતું નથી. તેનું નામ બદલો અથવા બીજું પસંદ કરો."

msgid "That isn't let in here."
msgstr "તેને અહીં પ્રવેશ નથી."

msgid "That isn't the disk password, so nothing was changed. Try again."
msgstr "તે ડિસ્ક પાસવર્ડ નથી, તેથી કંઈ બદલાયું નથી. ફરી પ્રયાસ કરો."

msgid ""
"That was the wrong disk password too many times, so it's locked for an hour. "
"Nothing was changed. Try again after that."
msgstr ""
"ડિસ્ક પાસવર્ડ ઘણી વાર ખોટો લખાયો, તેથી તે એક કલાક માટે લૉક થઈ ગયું છે. કંઈ "
"બદલાયું નથી. તે પછી ફરી પ્રયાસ કરો."

msgid ""
"The BIOS screen uses the keyboard. When you're done, choose Save and Exit, or"
" Exit."
msgstr ""
"BIOS સ્ક્રીન કીબોર્ડ વડે વપરાય છે. પૂરું થાય ત્યારે Save and Exit, અથવા Exit "
"પસંદ કરો."

msgid ""
"The BIOS's RAID setting (Intel RST) hides the disk. Restart into the BIOS and"
" set the storage mode (often called SATA mode or SATA operation) to AHCI. "
"Windows on this disk won't start after that change, but installing EvenKeelOS"
" erases it anyway."
msgstr ""
"BIOSની RAID સેટિંગ (Intel RST) ડિસ્કને છુપાવે છે. BIOSમાં રીસ્ટાર્ટ કરો અને "
"સ્ટોરેજ મોડ (ઘણી વાર SATA mode અથવા SATA operation કહેવાય છે) AHCI પર સેટ "
"કરો. તે ફેરફાર પછી આ ડિસ્ક પરનું Windows શરૂ થશે નહીં, પરંતુ EvenKeelOS "
"ઇન્સ્ટોલ કરવાથી તે આમ પણ ભૂંસાઈ જાય છે."

msgid "The Bluetooth driver is blocked, so there's no Bluetooth."
msgstr "બ્લૂટૂથ ડ્રાઇવર બ્લોક થયેલ છે, તેથી બ્લૂટૂથ ઉપલબ્ધ નથી."

msgid ""
"The NVIDIA card runs on the open-source driver built into EvenKeelOS. The "
"proprietary NVIDIA driver isn't used: it breaks too often to keep the promise"
" that EvenKeelOS just works. If you need it, use Bazzite or Bluefin's NVIDIA "
"editions instead."
msgstr ""
"NVIDIA કાર્ડ EvenKeelOSમાં બિલ્ટ-ઇન ઓપન-સોર્સ ડ્રાઇવર પર ચાલે છે. NVIDIAનો "
"પ્રોપ્રાઇટરી ડ્રાઇવર વાપરવામાં આવતો નથી: તે એટલી વાર તૂટે છે કે EvenKeelOS બસ"
" ચાલે છે એ વચન પાળી શકાય નહીં. જો તમને તેની જરૂર હોય, તો તેના બદલે Bazzite "
"અથવા Bluefinની NVIDIA આવૃત્તિઓ વાપરો."

msgid "The QR code could not be made. Save the log to a stick instead."
msgstr "QR કોડ બનાવી શકાયો નહીં. તેના બદલે લૉગને સ્ટિક પર સાચવો."

msgid "The USB stick could not be opened."
msgstr "USB સ્ટિક ખોલી શકાઈ નહીં."

msgid "The VPN list is missing."
msgstr "VPN યાદી ખૂટે છે."

msgid "The Wi-Fi card's driver is blocked, so there's no Wi-Fi."
msgstr "Wi-Fi કાર્ડનો ડ્રાઇવર બ્લોક છે, તેથી Wi-Fi નથી."

msgid "The administrator password was not given, so nothing was changed."
msgstr "એડમિનિસ્ટ્રેટર પાસવર્ડ આપવામાં આવ્યો નહીં, તેથી કંઈ બદલાયું નથી."

msgid "The administrator password wasn't given, so nothing was changed."
msgstr "એડમિનિસ્ટ્રેટર પાસવર્ડ આપવામાં આવ્યો નહીં, તેથી કંઈ બદલાયું નથી."

msgid "The app system (Flatpak)"
msgstr "ઍપ સિસ્ટમ (Flatpak)"

msgid "The app's instructions say TCP, UDP or both"
msgstr "ઍપની સૂચનાઓ TCP, UDP અથવા બંને જણાવે છે"

msgid "The automatic rollback test worked."
msgstr "સ્વચાલિત રોલબેક ટેસ્ટ સફળ રહ્યો."

msgid ""
"The automatic update is already running, so this window follows it until it's"
" done. You can keep working."
msgstr ""
"સ્વચાલિત અપડેટ પહેલેથી ચાલી રહ્યું છે, તેથી તે પૂરું થાય ત્યાં સુધી આ વિન્ડો "
"તેને અનુસરે છે. તમે કામ ચાલુ રાખી શકો છો."

msgid ""
"The battery is at %s%% and the computer isn't plugged in. If the battery runs"
" out during the update, the update is lost and has to start "
"again.\\n\\nRecommended: Not now. Plug the computer in, then start System "
"Update again.\\n\\nOr Update anyway."
msgstr ""
"બેટરી %s%% પર છે અને કમ્પ્યુટર પ્લગ ઇન નથી. જો અપડેટ દરમિયાન બેટરી ખતમ થઈ "
"જાય, તો અપડેટ વેડફાઈ જાય છે અને ફરીથી શરૂ કરવું પડે છે.\\n\\nભલામણ: હમણાં "
"નહીં. કમ્પ્યુટર પ્લગ ઇન કરો, પછી ફરીથી સિસ્ટમ અપડેટ શરૂ કરો.\\n\\nઅથવા તો પણ "
"અપડેટ કરો."

msgid ""
"The battery is at %s%%. Plug the computer in: if it runs out during the "
"update, the update is lost."
msgstr ""
"બેટરી %s%% પર છે. કમ્પ્યુટર પ્લગ ઇન કરો: જો અપડેટ દરમિયાન બેટરી ખતમ થઈ જાય, "
"તો અપડેટ વેડફાઈ જાય છે."

#, python-brace-format
msgid "The biggest disk holds {gb} GB."
msgstr "સૌથી મોટી ડિસ્કમાં {gb} GB છે."

msgid "The boot entry is already named %s. Nothing to do."
msgstr "બૂટ એન્ટ્રીનું નામ પહેલેથી જ %s છે. કંઈ કરવાની જરૂર નથી."

msgid "The boot options can't be read right now"
msgstr "હમણાં બૂટ વિકલ્પો વાંચી શકાતા નથી"

#, python-brace-format
msgid "The boot options didn't change: {reason}"
msgstr "બૂટ વિકલ્પો બદલાયા નથી: {reason}"

msgid "The boot options the computer starts with couldn't be read."
msgstr "કમ્પ્યુટર જે બૂટ વિકલ્પો સાથે શરૂ થાય છે તે વાંચી શકાયા નહીં."

msgid "The box is missing or broken."
msgstr "બોક્સ નથી અથવા ખરાબ છે."

msgid ""
