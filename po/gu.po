msgid ""
"  codecs web   Web video in Firefox only. Replaces Fedora's empty OpenH264 stand-in with\n"
"               Cisco's OpenH264 from Fedora's Cisco repository, under Cisco's own H.264\n"
"               patent license.\n"
"  codecs full  Everything. Replaces Fedora's free ffmpeg libraries with the full ffmpeg,\n"
"               x264 and x265 from RPM Fusion, the source standard Fedora uses."
msgstr ""
"  codecs web   વેબ વિડિયો ફક્ત Firefoxમાં. Fedoraના ખાલી OpenH264 અવેજને\n"
"               Fedoraની Cisco રિપોઝિટરીમાંથી Ciscoના OpenH264 વડે બદલે છે, Ciscoના પોતાના H.264\n"
"               પેટન્ટ લાઇસન્સ હેઠળ.\n"
"  codecs full  બધું જ. Fedoraની મફત ffmpeg લાઇબ્રેરીઓને RPM Fusionમાંથી સંપૂર્ણ ffmpeg,\n"
"               x264 અને x265 વડે બદલે છે; આ એ જ સ્રોત છે જે સામાન્ય Fedora વાપરે છે."

msgid ""
"  evenkeel-os-packages install [FILE]   install an .rpm or .deb (no FILE: pick one from Downloads)\n"
"  evenkeel-os-packages remove           remove an app installed this way\n"
"  evenkeel-os-packages check FILE       say what a package needs, without installing anything\n"
"  evenkeel-os-packages repair           set a broken app box up again (--if-broken: only if one does not work)\n"
"  evenkeel-os-packages login            choose box apps that start when you log in\n"
"  evenkeel-os-packages windows FILE     a Windows .exe or .msi: offer a Linux app that does its job\n"
"  evenkeel-os-packages check-windows FILE  say what a Windows file is and what would be offered, without any window\n"
"  evenkeel-os-packages zoom LINK        a Zoom \"open the app\" link: open the meeting in Zoom's web version, in Chrome\n"
"  evenkeel-os-packages vpn [NAME]       add a VPN from its company's own download source (mullvad, proton, ivpn,\n"
"                                        nordvpn; no NAME: pick one)"
msgstr ""
"  evenkeel-os-packages install [FILE]   .rpm અથવા .deb ઇન્સ્ટોલ કરો (FILE ન આપો તો: ડાઉનલોડ્સમાંથી એક પસંદ કરો)\n"
"  evenkeel-os-packages remove           આ રીતે ઇન્સ્ટોલ કરેલી ઍપ દૂર કરો\n"
"  evenkeel-os-packages check FILE       કંઈ પણ ઇન્સ્ટોલ કર્યા વિના, પેકેજને શું જોઈએ છે તે જણાવો\n"
"  evenkeel-os-packages repair           ખરાબ થયેલું ઍપ બોક્સ ફરીથી સેટ કરો (--if-broken: ફક્ત ત્યારે જ, જો કોઈ કામ ન કરતું હોય)\n"
"  evenkeel-os-packages login            તમે લૉગ ઇન કરો ત્યારે શરૂ થતી બોક્સ ઍપ્સ પસંદ કરો\n"
"  evenkeel-os-packages windows FILE     Windows .exe અથવા .msi: તેનું કામ કરતી Linux ઍપ સૂચવો\n"
"  evenkeel-os-packages check-windows FILE  કોઈ વિન્ડો ખોલ્યા વિના જણાવો કે Windows ફાઇલ શું છે અને શું સૂચવવામાં આવશે\n"
"  evenkeel-os-packages zoom LINK        Zoomની \"ઍપ ખોલો\" લિંક: મીટિંગને Chromeમાં Zoomના વેબ વર્ઝનમાં ખોલો\n"
"  evenkeel-os-packages vpn [NAME]       VPNને તેની કંપનીના પોતાના ડાઉનલોડ સ્રોતમાંથી ઉમેરો (mullvad, proton, ivpn,\n"
"                                        nordvpn; NAME ન આપો તો: એક પસંદ કરો)"

#, python-brace-format
msgid ""
"\"{name}\" comes with Fedora. The trusted list is rebuilt from Fedora's "
"current list at every start, so an update replaces or drops it; keep "
"automatic updates on. If this alert stays after updating and restarting, tell"
" your helper."
msgstr ""
"\"{name}\" Fedora સાથે આવે છે. વિશ્વસનીય યાદી દરેક વખતે સિસ્ટમ શરૂ થાય ત્યારે"
" Fedoraની હાલની યાદી પરથી ફરીથી બનાવવામાં આવે છે, તેથી અપડેટ તેને બદલે છે "
"અથવા દૂર કરે છે; સ્વચાલિત અપડેટ્સ ચાલુ રાખો. જો અપડેટ કર્યા અને રીસ્ટાર્ટ "
"કર્યા પછી પણ આ ચેતવણી રહે છે, તો તમારા મદદગારને જણાવો."

#, python-brace-format
msgid ""
"\"{name}\" has expired, but its file ({file}) holds {n} certificate, and "
"removing it would remove them all, the good ones too. Tell your helper."
msgid_plural ""
"\"{name}\" has expired, but its file ({file}) holds {n} certificates, and "
"removing it would remove them all, the good ones too. Tell your helper."
msgstr[0] ""
"\"{name}\"ની મુદત પૂરી થઈ ગઈ છે, પરંતુ તેની ફાઇલ ({file})માં {n} પ્રમાણપત્ર "
"છે, અને તેને દૂર કરવાથી તે બધાં જ દૂર થઈ જશે, સારાં પ્રમાણપત્રો પણ. તમારા "
"મદદગારને જણાવો."
msgstr[1] ""
"\"{name}\"ની મુદત પૂરી થઈ ગઈ છે, પરંતુ તેની ફાઇલ ({file})માં {n} પ્રમાણપત્રો "
"છે, અને તેને દૂર કરવાથી તે બધાં જ દૂર થઈ જશે, સારાં પ્રમાણપત્રો પણ. તમારા "
"મદદગારને જણાવો."

#, python-brace-format
msgid ""
"\"{name}\" has expired. It was added in a way Wheelhouse can't remove; tell "
"your helper."
msgstr ""
"\"{name}\"ની મુદત પૂરી થઈ ગઈ છે. તેને એવી રીતે ઉમેરવામાં આવ્યું હતું કે "
"Wheelhouse તેને દૂર કરી શકતું નથી; તમારા મદદગારને જણાવો."

#, python-brace-format
msgid "\"{name}\" is removed and no longer trusted."
msgstr "\"{name}\" દૂર કરવામાં આવ્યું છે અને હવે તેના પર વિશ્વાસ નથી."

#, python-brace-format
msgid ""
"\"{name}\" was added to this computer and expired on {date}. An expired "
"certificate shouldn't be relied on. Remove it if you no longer need it; if "
"you do, ask whoever gave it to you for a new one. Removing it needs your "
"password."
msgstr ""
"\"{name}\" આ કમ્પ્યુટરમાં ઉમેરવામાં આવ્યું હતું અને તેની મુદત {date}ના રોજ "
"પૂરી થઈ ગઈ. મુદત પૂરી થયેલા પ્રમાણપત્ર પર ભરોસો ન રાખવો જોઈએ. જો તમને તેની "
"હવે જરૂર ન હોય, તો તેને દૂર કરો; જો જરૂર હોય, તો જેણે તમને તે આપ્યું હોય તેની"
" પાસે નવું માંગો. તેને દૂર કરવા માટે તમારો પાસવર્ડ જરૂરી છે."

#, python-brace-format
msgid ""
"\"{name}\" was added to this computer and expires on {date}. Ask whoever gave"
" it to you for a new one before then."
msgstr ""
"\"{name}\" આ કમ્પ્યુટરમાં ઉમેરવામાં આવ્યું હતું અને તેની મુદત {date}ના રોજ "
"પૂરી થાય છે. તે પહેલાં, જેણે તમને તે આપ્યું હોય તેની પાસે નવું માંગો."

msgid "(nothing was printed)"
msgstr "(કોઈ આઉટપુટ મળ્યું નથી)"

#, python-brace-format
msgid "- and {n} more"
msgid_plural "- and {n} more"
msgstr[0] "- અને {n} વધુ"
msgstr[1] "- અને {n} વધુ"

msgid ""
"1.00 is the normal size. Large text in Settings, Accessibility sets 1.25."
msgstr ""
"1.00 એ સામાન્ય કદ છે. સુયોજનો, Accessibilityમાંનું \"લાંબુ લખાણ\" (Large "
"Text) 1.25 સેટ કરે છે."

msgid "12 hour"
msgstr "12 કલાક"

msgid "24 hour"
msgstr "24 કલાક"

msgid ""
"A .deb driver can't be installed. The window says how to get the .rpm from "
"the maker."
msgstr ""
".deb ડ્રાઇવર ઇન્સ્ટોલ કરી શકાતો નથી. વિન્ડો જણાવે છે કે ઉત્પાદક પાસેથી .rpm "
"કેવી રીતે મેળવવી."

msgid "A USB mouse works."
msgstr "USB માઉસ કામ કરે છે."

msgid "A USB webcam works."
msgstr "USB વેબકૅમ કામ કરે છે."

msgid "A VPN"
msgstr "VPN"

msgid "A Windows program you downloaded (.exe or .msi)"
msgstr "તમે ડાઉનલોડ કરેલ Windows પ્રોગ્રામ (.exe અથવા .msi)"

msgid "A background service fails"
msgstr "બેકગ્રાઉન્ડ સર્વિસ નિષ્ફળ જાય છે"

msgid ""
"A background service that runs on this computer fails to start (the mobile "
"broadband service, or the graphics switching service)."
msgstr ""
"આ કમ્પ્યુટર પર ચાલતી એક બેકગ્રાઉન્ડ સર્વિસ શરૂ થતી નથી (મોબાઇલ બ્રોડબેન્ડ "
"સર્વિસ, અથવા ગ્રાફિક્સ સ્વિચિંગ સર્વિસ)."

msgid "A bottom bar, with a start menu on the logo"
msgstr "લોગો પર સ્ટાર્ટ મેનૂ સાથેનો નીચેનો બાર"

msgid "A broken app box"
msgstr "એક ખરાબ થયેલું ઍપ બોક્સ"

msgid "A built-in camera of the newer laptop kind was found."
msgstr "નવા પ્રકારના લેપટોપમાં હોય તેવો બિલ્ટ-ઇન કેમેરા મળ્યો."

msgid "A café, hotel, airport, or anywhere else. Nothing gets in."
msgstr "કેફે, હોટેલ, એરપોર્ટ અથવા બીજું કોઈ પણ સ્થળ. કંઈપણ અંદર આવતું નથી."

#, python-brace-format
msgid "A certificate needs attention"
msgid_plural "{n} certificates need attention"
msgstr[0] "{n} પ્રમાણપત્ર પર ધ્યાન આપવાની જરૂર છે"
msgstr[1] "{n} પ્રમાણપત્રો પર ધ્યાન આપવાની જરૂર છે"

msgid ""
"A change to the boot options is waiting. It starts at your next restart. It isn't an update.\n"
"\n"
"If you don't want it: Don't use it. The computer starts with the boot options it has now, and automatic updates aren't paused.\n"
"\n"
"Or Keep it."
msgstr ""
"બૂટ વિકલ્પોમાં એક ફેરફાર રાહ જોઈ રહ્યો છે. તે તમારા આગામી રીસ્ટાર્ટ વખતે શરૂ થશે. આ અપડેટ નથી.\n"
"\n"
"જો તમે તેને ન ઇચ્છતા હો: તેનો ઉપયોગ કરશો નહીં. કમ્પ્યુટર હાલના બૂટ વિકલ્પો સાથે જ શરૂ થાય છે, અને સ્વચાલિત અપડેટ્સ થોભાવવામાં આવતાં નથી.\n"
"\n"
"અથવા તેને રાખો."

msgid "A device"
msgstr "એક ઉપકરણ"

#, python-brace-format
msgid "A device lost its driver ({driver})"
msgstr "એક ઉપકરણે તેનો ડ્રાઇવર ગુમાવ્યો ({driver})"

msgid "A disk is hidden."
msgstr "એક ડિસ્ક છુપાયેલી છે."

msgid "A driver file from the maker"
msgstr "ઉત્પાદક તરફથી ડ્રાઇવર ફાઇલ"

msgid "A file of recent errors to email to your helper"
msgstr "તમારા મદદગારને ઇમેઇલ કરવા માટે તાજેતરની ભૂલોની ફાઇલ"

msgid "A full name can't have : or , in it."
msgstr "સંપૂર્ણ નામમાં : અથવા , હોઈ શકતા નથી."

msgid "A graphics chip has no driver."
msgstr "ગ્રાફિક્સ ચિપમાં ડ્રાઇવર નથી."

msgid ""
"A network is only needed for automatic time and time zone. To use Wi-Fi, "
"click a network. Or click Next to go on without it."
msgstr ""
"નેટવર્કની જરૂર માત્ર આપમેળે સમય અને સમય ઝોન સેટ કરવા માટે પડે છે. Wi-Fi "
"વાપરવા માટે, કોઈ નેટવર્ક પર ક્લિક કરો. અથવા તેના વિના આગળ વધવા માટે આગળ પર "
"ક્લિક કરો."

msgid ""
"A new layout shows after you log out and back in. It changes only your own "
"desktop."
msgstr ""
"તમે લૉગ આઉટ કરીને ફરીથી લૉગ ઇન કરો પછી એક નવું લેઆઉટ દેખાય છે. તે ફક્ત તમારા "
"પોતાના ડેસ્કટૉપને જ બદલે છે."

msgid "A new system is ready."
msgstr "નવી સિસ્ટમ તૈયાર છે."

msgid "A new system is ready. Restart to use it."
msgstr "નવી સિસ્ટમ તૈયાર છે. તેનો ઉપયોગ કરવા માટે રીસ્ટાર્ટ કરો."

msgid ""
"A new system version is used from the next restart. Keep working, and restart"
" when it suits you."
msgstr ""
"આગામી રીસ્ટાર્ટથી સિસ્ટમના નવા વર્ઝનનો ઉપયોગ થશે. કામ ચાલુ રાખો, અને તમને "
"અનુકૂળ હોય ત્યારે રીસ્ટાર્ટ કરો."

msgid ""
"A new version also goes back if something that worked before is broken after "
"you log in, like sound, Wi-Fi, Bluetooth, the camera or printing. Unplugged "
"or switched-off things don't count."
msgstr ""
"જો તમે લૉગ ઇન કર્યા પછી અગાઉ કામ કરતી કોઈ વસ્તુ, જેમ કે સાઉન્ડ, Wi-Fi, "
"બ્લૂટૂથ, કેમેરા અથવા પ્રિન્ટિંગ, કામ ન કરે, તો પણ નવું વર્ઝન પાછું જાય છે. "
"પ્લગ કાઢેલી કે બંધ કરેલી વસ્તુઓ ગણાતી નથી."

msgid "A new version is ready"
msgstr "નવું વર્ઝન તૈયાર છે"

msgid ""
"A note at the next login says so and names what broke, and automatic updates "
"pause for 3 days."
msgstr ""
"આગામી લૉગિન વખતે એક નોંધ આ વાત જણાવે છે અને શું ખરાબ થયું તેનું નામ આપે છે, "
"અને સ્વચાલિત અપડેટ્સ 3 દિવસ માટે થોભી જાય છે."

msgid ""
"A rollback test copy is running. Restart first, so the computer goes back to "
"the usual version."
msgstr ""
"રોલબેક ટેસ્ટ કૉપિ ચાલી રહી છે. પહેલાં રીસ્ટાર્ટ કરો, જેથી કમ્પ્યુટર સામાન્ય "
"વર્ઝન પર પાછું જાય."

msgid "A security certificate expired, expires within 30 days, or was removed."
msgstr ""
"સુરક્ષા પ્રમાણપત્રની મુદત પૂરી થઈ ગઈ છે, 30 દિવસમાં પૂરી થવાની છે, અથવા તેને "
"દૂર કરવામાં આવ્યું છે."

msgid "A slideshow of your own pictures"
msgstr "તમારા પોતાના ચિત્રોનો સ્લાઇડશો"

msgid "A sound chip was found, but it didn't start."
msgstr "સાઉન્ડ ચિપ મળી, પણ તે શરૂ થઈ નહીં."

msgid "A start-up check fails"
msgstr "સ્ટાર્ટ-અપ તપાસ નિષ્ફળ જાય છે"

msgid ""
"A start-up check fails on purpose. The computer restarts by itself within "
"seconds, twice, and the third start is back on this version."
msgstr ""
"સ્ટાર્ટ-અપ તપાસ જાણીજોઈને નિષ્ફળ જાય છે. કમ્પ્યુટર થોડી જ સેકન્ડમાં પોતે જ બે"
" વાર રીસ્ટાર્ટ થાય છે, અને ત્રીજી વખતે ફરી આ વર્ઝન પર જ પાછું આવે છે."

msgid "A system service fails"
msgstr "સિસ્ટમ સર્વિસ નિષ્ફળ જાય છે"

msgid "A system update is also waiting for a restart."
msgstr "સિસ્ટમ અપડેટ પણ રીસ્ટાર્ટની રાહ જોઈ રહ્યું છે."

msgid "A tool"
msgstr "એક સાધન"

msgid "A top bar, with the logo menu at the top left"
msgstr "ટોચનો બાર, જેમાં ટોચની ડાબી બાજુએ લોગો મેનૂ છે"

msgid ""
"A user name uses small letters, digits, - and _, and starts with a letter."
msgstr ""
"વપરાશકર્તા નામમાં નાના અક્ષરો, અંકો, - અને _નો ઉપયોગ થાય છે, અને તેની શરૂઆત "
"અક્ષરથી થાય છે."

msgid ""
"A wired network is set to Home, so this happens on any cable you plug in."
msgstr ""
"વાયર્ડ નેટવર્ક ઘર પર સેટ કરેલું છે, તેથી તમે જે પણ કેબલ પ્લગ ઇન કરો તેના પર "
"આવું થાય છે."

msgid "A wireless chip was found, but it didn't start."
msgstr "વાયરલેસ ચિપ મળી, પરંતુ તે શરૂ થઈ નહીં."

msgid "A wireless chip was found, with no driver for it."
msgstr "એક વાયરલેસ ચિપ મળી, પરંતુ તેના માટે કોઈ ડ્રાઇવર નથી."

msgid "AMD: flicker, turn off Panel Replay"
msgstr "AMD: સ્ક્રીન ઝબકે છે, Panel Replay બંધ કરો"

msgid "AMD: flicker, turn off Panel Self Refresh"
msgstr "AMD: સ્ક્રીન ઝબકે છે, Panel Self Refresh બંધ કરો"

msgid "AMD: flicker, turn off both"
msgstr "AMD: સ્ક્રીન ઝબકે છે, બંને બંધ કરો"

msgid "AMD: screen dims or shifts colors on its own"
msgstr "AMD: સ્ક્રીન પોતે જ ઝાંખી થઈ જાય છે અથવા તેના રંગો બદલાઈ જાય છે"

msgid "AMD: white flickering"
msgstr "AMD: સફેદ ઝબકારા"

msgid ""
"About 20 seconds after the login screen shows, the computer locks up. Hold "
"the power button until it turns off, then turn it on. After the second "
"freeze, the next start is back on this version."
msgstr ""
"લૉગિન સ્ક્રીન દેખાયાના લગભગ 20 સેકન્ડ પછી, કમ્પ્યુટર અટકી જાય છે. કમ્પ્યુટર "
"બંધ ન થાય ત્યાં સુધી પાવર બટન દબાવી રાખો, પછી તેને ચાલુ કરો. બીજી વખત અટકી "
"ગયા પછી, આગલી શરૂઆત ફરી આ વર્ઝન પર થાય છે."

msgid "About it"
msgstr "તે વિશે"

msgid "About this driver"
msgstr "આ ડ્રાઇવર વિશે"

msgid "Accent color and wallpaper"
msgstr "એક્સેન્ટ રંગ અને વોલપેપર"

msgid "Account"
msgstr "એકાઉન્ટ"

msgid "Add"
msgstr "ઉમેરો"

msgid "Add a folder"
msgstr "ફોલ્ડર ઉમેરો"

msgid "Add a folder and set the sharing password below."
msgstr "ફોલ્ડર ઉમેરો અને નીચે શેરિંગ પાસવર્ડ સેટ કરો."

msgid "Add a folder from your home folder."
msgstr "તમારા હોમ ફોલ્ડરમાંથી એક ફોલ્ડર ઉમેરો."

msgid "Add a printer"
msgstr "પ્રિન્ટર ઉમેરો"

msgid "Add a setting, like amdgpu.abmlevel=0"
msgstr "એક સેટિંગ ઉમેરો, જેમ કે amdgpu.abmlevel=0"

msgid "Add anyway"
msgstr "તો પણ ઉમેરો"

msgid "Add it"
msgstr "તેને ઉમેરો"

msgid ""
"Add it only if you know you need it. If the computer then won't start, "
"automatic rollback goes back to the version before."
msgstr ""
"તેને ફક્ત ત્યારે જ ઉમેરો જ્યારે તમને ખબર હોય કે તેની જરૂર છે. જો પછી "
"કમ્પ્યુટર શરૂ ન થાય, તો સ્વચાલિત રોલબેક પહેલાંના વર્ઝન પર પાછું જાય છે."

msgid "Add or remove an app's hardware rules"
msgstr "ઍપના હાર્ડવેર નિયમો ઉમેરો અથવા દૂર કરો"

msgid "Add or remove media codecs"
msgstr "મીડિયા કોડેક્સ ઉમેરો અથવા દૂર કરો"

msgid "Add the media codecs"
msgstr "મીડિયા કોડેક્સ ઉમેરો"

msgid "Add to the system"
msgstr "સિસ્ટમમાં ઉમેરો"

msgid "Add video and audio codecs"
msgstr "વિડિયો અને ઑડિયો કોડેક્સ ઉમેરો"

msgid "Add, turn on or remove a VPN or an app's background service"
msgstr "VPN અથવા કોઈ ઍપની બેકગ્રાઉન્ડ સર્વિસ ઉમેરો, ચાલુ કરો અથવા દૂર કરો"

msgid "Added by you"
msgstr "તમે ઉમેરેલું"

msgid "Added to this computer"
msgstr "આ કમ્પ્યુટરમાં ઉમેરવામાં આવ્યું"

msgid "Adding a printer, and printer driver files from the maker"
msgstr "પ્રિન્ટર ઉમેરવું, અને ઉત્પાદક તરફથી પ્રિન્ટર ડ્રાઇવર ફાઇલો"

msgid ""
"Adding the desktop parts apps expect (progress windows and notifications)"
msgstr ""
"ઍપ્સ જેની અપેક્ષા રાખે છે તે ડેસ્કટૉપ ભાગો (પ્રગતિ વિન્ડો અને સૂચનાઓ) ઉમેરવા"

#, python-brace-format
msgid "Adding the download source {name}"
msgstr "ડાઉનલોડ સ્રોત {name} ઉમેરી રહ્યા છીએ"

#, python-brace-format
msgid "Adding {title} to the system"
msgstr "સિસ્ટમમાં {title} ઉમેરી રહ્યાં છીએ"

#, python-brace-format
msgid "Adding {title} to the system from Fedora. A progress window shows it."
msgstr ""
"Fedoraમાંથી {title}ને સિસ્ટમમાં ઉમેરી રહ્યા છીએ. પ્રગતિ વિન્ડો તે બતાવે છે."

#, python-brace-format
msgid "Adding {title} to the system from Fedora. This can take a few minutes."
msgstr ""
"Fedoraમાંથી {title}ને સિસ્ટમમાં ઉમેરી રહ્યા છીએ. આમાં થોડી મિનિટો લાગી શકે "
"છે."

#, python-brace-format
msgid "Adding {title} to the system. A progress window shows it."
msgstr "સિસ્ટમમાં {title} ઉમેરી રહ્યાં છીએ. પ્રગતિ વિન્ડો તે બતાવે છે."

#, python-brace-format
msgid "Adding {title} to the system. This can take a few minutes."
msgstr "{title}ને સિસ્ટમમાં ઉમેરી રહ્યા છીએ. આમાં થોડી મિનિટો લાગી શકે છે."

msgid "Administrator"
msgstr "એડમિનિસ્ટ્રેટર"

msgid "Administrator account (root)"
msgstr "એડમિનિસ્ટ્રેટર એકાઉન્ટ (રૂટ)"

msgid "Administrator: no."
msgstr "એડમિનિસ્ટ્રેટર: ના."

msgid "Administrator: yes."
msgstr "એડમિનિસ્ટ્રેટર: હા."

msgid ""
"After a BIOS update, it may ask for the disk password again. Turn it on again"
" here."
msgstr ""
"BIOS અપડેટ પછી, તે ફરીથી ડિસ્ક પાસવર્ડ માંગી શકે છે. તેને અહીં ફરીથી ચાલુ "
"કરો."

msgid ""
"After an undo, so the same update doesn't come straight back. They turn back "
"on by themselves."
msgstr ""
"પૂર્વવત્ કર્યા પછી, જેથી એ જ અપડેટ તરત જ પાછું ન આવે. તે પોતે જ ફરી ચાલુ થઈ "
"જાય છે."

msgid "After the restart, you will be asked to add your printer."
msgstr "રીસ્ટાર્ટ પછી, તમને તમારું પ્રિન્ટર ઉમેરવા માટે કહેવામાં આવશે."

msgid ""
"After the restart, you'll be asked for your password once, to turn it on."
msgstr ""
"રીસ્ટાર્ટ પછી, તેને ચાલુ કરવા માટે તમને એક વખત તમારો પાસવર્ડ પૂછવામાં આવશે."

msgid "After the restart, you'll get a message when it's ready."
msgstr "રીસ્ટાર્ટ પછી, જ્યારે તે તૈયાર હશે ત્યારે તમને એક સંદેશ મળશે."

msgid "Alpha"
msgstr "આલ્ફા"

msgid "Also let in, on Home"
msgstr "ઘર પર આને પણ પ્રવેશ મળે છે"

msgid ""
"Alt+Tab switches between apps. Alt and the key above Tab switches between "
"windows of the same app."
msgstr ""
"Alt+Tab એ ઍપ્સ વચ્ચે સ્વિચ કરે છે. Alt અને Tabની ઉપરની કી દબાવવાથી એક જ ઍપની "
"જુદી-જુદી વિન્ડો વચ્ચે સ્વિચ થાય છે."

msgid ""
"An .rpm or .deb installs the app. An .exe or .msi gets its Linux version."
msgstr ""
".rpm અથવા .deb ફાઇલ ઍપને ઇન્સ્ટોલ કરે છે. .exe અથવા .msi ફાઇલ તેનું Linux "
"વર્ઝન મેળવે છે."

msgid "An app that comes as a .rpm or .deb file"
msgstr "એક ઍપ જે .rpm અથવા .deb ફાઇલ તરીકે આવે છે"

msgid "An office. Nothing gets in, and your folders aren't shared."
msgstr "એક ઓફિસ. અંદર કંઈ જ આવતું નથી, અને તમારા ફોલ્ડર્સ શેર થતા નથી."

#, python-brace-format
msgid ""
"An update from {staged} is waiting. It starts at your next restart. The version you're using now is from {booted}.\n"
"\n"
"If you don't want it: Don't use it. Your computer keeps the version it has now. A boot options change made since the update came is dropped with it."
msgstr ""
"{staged}નું એક અપડેટ રાહ જોઈ રહ્યું છે. તે તમારા આગામી રીસ્ટાર્ટ વખતે શરૂ થશે. તમે હાલમાં જે વર્ઝન વાપરો છો તે {booted}નું છે.\n"
"\n"
"જો તમે તેને ન ઇચ્છતા હો: તેનો ઉપયોગ કરશો નહીં. તમારું કમ્પ્યુટર હાલનું વર્ઝન જ રાખે છે. અપડેટ આવ્યા પછી બૂટ વિકલ્પોમાં કરેલો ફેરફાર પણ તેની સાથે રદ થાય છે."

msgid "An update is waiting for a restart. Restart first, then run the test."
msgstr ""
"એક અપડેટ રીસ્ટાર્ટની રાહ જોઈ રહ્યું છે. પહેલાં રીસ્ટાર્ટ કરો, પછી ટેસ્ટ "
"ચલાવો."

msgid "Another disk is hidden by a BIOS setting."
msgstr "BIOS સેટિંગને લીધે બીજી એક ડિસ્ક છુપાયેલી છે."

#, python-brace-format
msgid ""
"Another install or removal is running ({doing}). This waits for it to finish,"
" then goes on."
msgstr ""
"અન્ય ઇન્સ્ટોલેશન અથવા દૂર કરવાની પ્રક્રિયા ચાલી રહી છે ({doing}). આ તે પૂર્ણ "
"થાય તેની રાહ જુએ છે, પછી આગળ વધે છે."

msgid ""
"Another version is set to start at your next restart (after Undo the last "
"update, or picking a version in the boot menu), so the test wouldn't test "
"anything. Restart first, then run the test."
msgstr ""
"તમારા આગામી રીસ્ટાર્ટ વખતે બીજું વર્ઝન શરૂ થવા માટે સેટ છે (\"છેલ્લું અપડેટ "
"પૂર્વવત્ કરો\" પછી, અથવા બૂટ મેનૂમાં કોઈ વર્ઝન પસંદ કર્યા પછી), તેથી ટેસ્ટ "
"કંઈ જ ચકાસશે નહીં. પહેલાં રીસ્ટાર્ટ કરો, પછી ટેસ્ટ ચલાવો."

msgid "App"
msgstr "ઍપ"

msgid "App, game or port number"
msgstr "ઍપ, ગેમ અથવા પોર્ટ નંબર"

msgid ""
"Applies them at login: the next slide for \"at each login\", and dark or "
"light for the time of day"
msgstr ""
"તેમને લૉગિન વખતે લાગુ કરે છે: \"દરેક લૉગિન વખતે\" માટે આગામી સ્લાઇડ, અને "
"દિવસના સમય પ્રમાણે ડાર્ક કે લાઇટ"

msgid "Apps"
msgstr "ઍપ્સ"

msgid "Apps and ports let in"
msgstr "પ્રવેશ આપેલી ઍપ્સ અને પોર્ટ્સ"

msgid "Apps from Bazaar have this setting inside the app."
msgstr "Bazaarની ઍપ્સમાં આ સેટિંગ ઍપની અંદર જ હોય છે."

msgid "Apps from Bazaar update on their own. Remove them in Bazaar too."
msgstr "Bazaarની ઍપ્સ પોતાની જાતે અપડેટ થાય છે. તેમને Bazaarમાં જ દૂર કરો."

msgid "Apps from Bazaar: open Bazaar and remove it there."
msgstr "Bazaarમાંથી આવેલી ઍપ્સ: Bazaar ખોલો અને તેને ત્યાં જ દૂર કરો."

msgid ""
"Apps from a file, Get a VPN or a Windows program: Wheelhouse, Apps, Remove "
"apps."
msgstr ""
"ફાઇલમાંથી, \"VPN મેળવો\"માંથી અથવા Windows પ્રોગ્રામમાંથી આવેલી ઍપ્સ: "
"Wheelhouse, ઍપ્સ, ઍપ્સ દૂર કરો."

msgid ""
"Apps from a file: open Wheelhouse, Apps, Start apps at login, and pick the "
"app. Picking it again stops it."
msgstr ""
"ફાઇલમાંથી આવેલી ઍપ્સ: Wheelhouse, ઍપ્સ, લૉગ ઇન વખતે ઍપ્સ શરૂ કરો ખોલો, અને ઍપ"
" પસંદ કરો. તેને ફરીથી પસંદ કરવાથી તે બંધ થાય છે."

msgid "Apps from package files"
msgstr "પેકેજ ફાઇલોમાંથી ઍપ્સ"

msgid "Apps from their own download sources"
msgstr "તેમના પોતાના ડાઉનલોડ સ્રોતોમાંથી ઍપ્સ"

msgid "Apps you added from files, Get a VPN or Windows programs"
msgstr ""
"તમે ફાઇલોમાંથી, \"VPN મેળવો\"માંથી અથવા Windows પ્રોગ્રામ્સમાંથી ઉમેરેલી ઍપ્સ"

msgid "April"
msgstr "એપ્રિલ"

msgid ""
"ArtCraft's downloads can't be reached right now. Check the internet "
"connection and try again."
msgstr ""
"હમણાં ArtCraftની ડાઉનલોડ્સ સુધી પહોંચી શકાતું નથી. ઇન્ટરનેટ કનેક્શન તપાસો અને"
" ફરી પ્રયાસ કરો."

msgid "ArtCraft's signature is checked first, and it updates once a day."
msgstr ""
"સૌ પહેલાં ArtCraftની સહી તપાસવામાં આવે છે, અને તે દિવસમાં એક વાર અપડેટ થાય "
"છે."

msgid ""
"Asks once whether a password Wi-Fi or wired network is Home, Work or a Public"
" place"
msgstr ""
"એક વાર પૂછે છે કે પાસવર્ડવાળું Wi-Fi અથવા વાયર્ડ નેટવર્ક ઘર, કાર્યસ્થળ કે "
"જાહેર સ્થળ છે"

msgid "At each login"
msgstr "દરેક લૉગિન વખતે"

msgid "August"
msgstr "ઓગસ્ટ"

msgid "Authentication is required to add or remove an app's hardware rules"
msgstr "ઍપના હાર્ડવેર નિયમો ઉમેરવા અથવા દૂર કરવા માટે પ્રમાણીકરણ જરૂરી છે"

msgid "Authentication is required to add or remove media codecs"
msgstr "મીડિયા કોડેક્સ ઉમેરવા અથવા દૂર કરવા માટે પ્રમાણીકરણ જરૂરી છે"

msgid ""
"Authentication is required to add, turn on or remove a VPN or an app's "
"background service"
msgstr ""
"VPN અથવા કોઈ ઍપની બેકગ્રાઉન્ડ સર્વિસ ઉમેરવા, ચાલુ કરવા અથવા દૂર કરવા માટે "
"પ્રમાણીકરણ જરૂરી છે"

msgid "Authentication is required to change a Wheelhouse setting"
msgstr "Wheelhouse સેટિંગ બદલવા માટે પ્રમાણીકરણ જરૂરી છે"

msgid "Authentication is required to change the boot options"
msgstr "બૂટ વિકલ્પો બદલવા માટે પ્રમાણીકરણ જરૂરી છે"

msgid ""
"Authentication is required to delete important settings for the repair test"
msgstr ""
"રિપેર ટેસ્ટ માટેની મહત્વની સેટિંગ્સ કાઢી નાખવા માટે પ્રમાણીકરણ જરૂરી છે"

msgid "Authentication is required to install EvenKeelOS"
msgstr "EvenKeelOS ઇન્સ્ટોલ કરવા માટે પ્રમાણીકરણ જરૂરી છે"

msgid "Authentication is required to remove a trusted certificate"
msgstr "વિશ્વસનીય પ્રમાણપત્ર દૂર કરવા માટે પ્રમાણીકરણ જરૂરી છે"

msgid "Automatic"
msgstr "સ્વચાલિત"

msgid "Automatic disk unlock"
msgstr "આપમેળે ડિસ્ક અનલૉક"

msgid "Automatic rollback"
msgstr "સ્વચાલિત રોલબેક"

msgid "Automatic rollback note"
msgstr "સ્વચાલિત રોલબેક વિશે નોંધ"

msgid "Automatic updates"
msgstr "સ્વચાલિત અપડેટ્સ"

msgid "Automatic updates are back on."
msgstr "સ્વચાલિત અપડેટ્સ ફરી ચાલુ છે."

msgid "Automatic updates are back on. The next daily update runs as normal."
msgstr "સ્વચાલિત અપડેટ્સ ફરી ચાલુ છે. આગામી દૈનિક અપડેટ સામાન્ય રીતે ચાલશે."

msgid "Automatic updates are off"
msgstr "સ્વચાલિત અપડેટ્સ બંધ છે"

msgid "Automatic updates are off. Run System Update yourself to update."
msgstr "સ્વચાલિત અપડેટ્સ બંધ છે. અપડેટ કરવા માટે સિસ્ટમ અપડેટ જાતે ચલાવો."

msgid ""
"Automatic updates are off: nothing updates until you run System Update yourself.\n"
"\n"
"Recommended: Turn on. Everything then updates by itself every day at 4 am, and updates fix security problems."
msgstr ""
"સ્વચાલિત અપડેટ્સ બંધ છે: જ્યાં સુધી તમે જાતે સિસ્ટમ અપડેટ ચલાવશો નહીં ત્યાં સુધી કંઈ અપડેટ થશે નહીં.\n"
"\n"
"ભલામણ: ચાલુ કરો. ત્યાર બાદ દરરોજ સવારે 4 વાગ્યે બધું આપમેળે અપડેટ થાય છે, અને અપડેટ્સ સુરક્ષાની સમસ્યાઓ ઠીક કરે છે."

msgid "Automatic updates are on."
msgstr "સ્વચાલિત અપડેટ્સ ચાલુ છે."

msgid ""
"Automatic updates are on: everything updates by itself every day at 4 am.\n"
"\n"
"Recommended: Keep them on. Updates fix security problems.\n"
"\n"
"Or Turn off: nothing updates until you run System Update yourself."
msgstr ""
"સ્વચાલિત અપડેટ્સ ચાલુ છે: દરરોજ સવારે 4 વાગ્યે બધું પોતે જ અપડેટ થાય છે.\n"
"\n"
"ભલામણ: તેમને ચાલુ રાખો. અપડેટ્સ સુરક્ષાની સમસ્યાઓ ઠીક કરે છે.\n"
"\n"
"અથવા બંધ કરો: જ્યાં સુધી તમે જાતે સિસ્ટમ અપડેટ ચલાવો નહીં ત્યાં સુધી કંઈ અપડેટ થશે નહીં."

#, python-brace-format
msgid "Automatic updates are paused until {day}"
msgstr "સ્વચાલિત અપડેટ્સ {day} સુધી થોભાવવામાં આવ્યા છે"

#, python-brace-format
msgid ""
"Automatic updates are paused until {day}, after an undo, so the bad update doesn't come back. They turn back on by themselves.\n"
"\n"
"Recommended: Keep the pause.\n"
"\n"
"Or Resume now: the next daily update runs as normal. Or Turn off: nothing updates until you run System Update yourself."
msgstr ""
"પૂર્વવત્ કર્યા પછી, ખરાબ અપડેટ પાછું ન આવે તે માટે સ્વચાલિત અપડેટ્સ {day} સુધી થોભાવવામાં આવ્યાં છે. તે પોતે જ ફરી ચાલુ થઈ જાય છે.\n"
"\n"
"ભલામણ: વિરામ જાળવી રાખો.\n"
"\n"
"અથવા હમણાં ફરી ચાલુ કરો: આગામી દૈનિક અપડેટ સામાન્ય રીતે ચાલશે. અથવા બંધ કરો: જ્યાં સુધી તમે જાતે સિસ્ટમ અપડેટ ચલાવો નહીં ત્યાં સુધી કંઈ અપડેટ થશે નહીં."

#, python-brace-format
msgid ""
"Automatic updates are paused until {day}, so the bad update doesn't come "
"back. They turn back on by themselves."
msgstr ""
"સ્વચાલિત અપડેટ્સ {day} સુધી થોભાવવામાં આવ્યાં છે, જેથી ખરાબ અપડેટ પાછું ન "
"આવે. તે પોતે જ ફરી ચાલુ થઈ જાય છે."

#, python-brace-format
msgid ""
"Automatic updates are paused until {day}, so the same update doesn't come "
"straight back. They turn back on by themselves."
msgstr ""
"સ્વચાલિત અપડેટ્સ {day} સુધી થોભાવવામાં આવ્યાં છે, જેથી એ જ અપડેટ તરત જ પાછું "
"ન આવે. તે પોતે જ ફરી ચાલુ થઈ જાય છે."

msgid ""
"Automatic updates are still paused after the undo. Resume them in Automatic "
"updates."
msgstr ""
"પૂર્વવત્ કર્યા પછી પણ સ્વચાલિત અપડેટ્સ હજી થોભાવેલાં છે. તેમને \"સ્વચાલિત "
"અપડેટ્સ\"માં ફરી ચાલુ કરો."

msgid ""
"Automatic updates could not be paused, so the next one may bring the update "
"back. If it does, turn off Automatic updates in Wheelhouse and tell your "
"helper."
msgstr ""
"સ્વચાલિત અપડેટ્સ થોભાવી શકાયાં નહીં, તેથી આગામી અપડેટ આ અપડેટને પાછું લાવી "
"શકે છે. જો આવું થાય, તો Wheelhouseમાં સ્વચાલિત અપડેટ્સ બંધ કરો અને તમારા "
"મદદગારને જણાવો."

msgid ""
"Automatic updates pause for 3 days, so the same update doesn't come straight "
"back. They turn back on by themselves."
msgstr ""
"સ્વચાલિત અપડેટ્સ 3 દિવસ માટે થોભી જાય છે, જેથી એ જ અપડેટ તરત જ પાછું ન આવે. "
"તે પોતે જ ફરી ચાલુ થઈ જાય છે."

msgid ""
"Automatic updates then pause for 3 days, so the bad update doesn't come "
"straight back. If the problem returns after that, turn off Automatic updates "
"in Wheelhouse and tell your helper."
msgstr ""
"પછી સ્વચાલિત અપડેટ્સ 3 દિવસ માટે થોભી જાય છે, જેથી ખરાબ અપડેટ તરત જ પાછું ન "
"આવે. જો ત્યાર પછી પણ સમસ્યા પાછી આવે, તો Wheelhouseમાં સ્વચાલિત અપડેટ્સ બંધ "
"કરો અને તમારા મદદગારને જણાવો."

msgid "Automatic updates, undoing an update, firmware and certificate alerts"
msgstr ""
"સ્વચાલિત અપડેટ્સ, અપડેટને પૂર્વવત્ કરવું, ફર્મવેર અને પ્રમાણપત્ર ચેતવણીઓ"

msgid ""
"Away from home, the switch shows off: sharing only runs on a Home network, "
"and comes back by itself there."
msgstr ""
"ઘરથી દૂર હો ત્યારે સ્વિચ બંધ દેખાય છે: શેરિંગ ફક્ત ઘર નેટવર્ક પર જ ચાલે છે, "
"અને ત્યાં તે આપમેળે ફરી ચાલુ થઈ જાય છે."

msgid "BIOS settings"
msgstr "BIOS સેટિંગ્સ"

msgid "Back"
msgstr "પાછળ"

msgid "Back to the original"
msgstr "મૂળ પર પાછા જાઓ"

msgid "Background: click a picture. To use your own photo, click Add Picture."
msgstr ""
"પાશ્વ ભાગ (Background): કોઈ ચિત્ર પર ક્લિક કરો. તમારો પોતાનો ફોટો વાપરવા "
"માટે, \"Add Picture\" પર ક્લિક કરો."

msgid "Basic graphics only"
msgstr "ફક્ત મૂળભૂત ગ્રાફિક્સ"

msgid "Battery status"
msgstr "બેટરીની સ્થિતિ"

msgid "Bazaar is open. Close it when you're done looking."
msgstr "Bazaar ખુલ્લું છે. તમે જોવાનું પૂરું કરી લો પછી તેને બંધ કરો."

msgid "Bazaar, the app store (Flathub)"
msgstr "Bazaar, ઍપ સ્ટોર (Flathub)"

msgid ""
"Before you unplug it, click the eject button next to its name, and wait until"
" it's gone from the list."
msgstr ""
"તમે તેને અનપ્લગ કરો તે પહેલાં, તેના નામની બાજુમાં આવેલા ઇજેક્ટ બટન પર ક્લિક "
"કરો અને જ્યાં સુધી તે યાદીમાંથી દૂર ન થઈ જાય ત્યાં સુધી રાહ જુઓ."

msgid "Bluetooth"
msgstr "બ્લૂટૂથ"

msgid "Bluetooth driver blocked"
msgstr "બ્લૂટૂથ ડ્રાઇવર બ્લોક થયેલ છે"

msgid "Bluetooth found."
msgstr "બ્લૂટૂથ મળ્યું."

msgid "Boot entries that will be renamed to \"%s\":"
msgstr "બૂટ એન્ટ્રીઓ કે જેનું નામ બદલીને \"%s\" રાખવામાં આવશે:"

msgid "Boot options"
msgstr "બૂટ વિકલ્પો"

msgid "Boot options in Wheelhouse can change them back later."
msgstr "Wheelhouseમાં \"બૂટ વિકલ્પો\" વડે તેમને પછીથી પાછા બદલી શકાય છે."

msgid "Both"
msgstr "બંને"

msgid "Both ask for your password, and work only on Home."
msgstr "બંને તમારો પાસવર્ડ માંગે છે, અને ફક્ત ઘર પર જ કામ કરે છે."

msgid "Bottom bar and a start menu"
msgstr "નીચેનો બાર અને સ્ટાર્ટ મેનૂ"

msgid "Box"
msgstr "બોક્સ"

msgid "Broadcom Wi-Fi chip found. Its driver or firmware can't be included."
msgstr ""
"Broadcom Wi-Fi ચિપ મળી. તેનો ડ્રાઇવર અથવા ફર્મવેર સામેલ કરી શકાતાં નથી."

msgid "Browse and install apps in Bazaar. They update on their own."
msgstr "Bazaarમાં ઍપ્સ બ્રાઉઝ કરો અને ઇન્સ્ટોલ કરો. તેઓ પોતે જ અપડેટ થાય છે."

msgid "Camera"
msgstr "કેમેરા"

msgid "Camera found."
msgstr "કેમેરો મળ્યો."

msgid "Can install software and change system settings. Click to turn it off."
msgstr ""
"સોફ્ટવેર ઇન્સ્ટોલ કરી શકે છે અને સિસ્ટમ સેટિંગ્સ બદલી શકે છે. તેને બંધ કરવા "
"માટે ક્લિક કરો."

msgid "Can install software and change system settings. Click to turn it on."
msgstr ""
"સોફ્ટવેર ઇન્સ્ટોલ કરી શકે છે અને સિસ્ટમ સેટિંગ્સ બદલી શકે છે. તેને ચાલુ કરવા "
"માટે ક્લિક કરો."

msgid "Cancel"
msgstr "રદ કરો"

msgid "Certificate"
msgstr "પ્રમાણપત્ર"

msgid "Certificate alert"
msgstr "પ્રમાણપત્ર ચેતવણી"

msgid "Certificate alerts"
msgstr "પ્રમાણપત્ર ચેતવણીઓ"

msgid ""
"Certificates are how the computer knows a secure website is real. An alert "
"shows when one has expired, expires soon, or was removed."
msgstr ""
"પ્રમાણપત્રો વડે કમ્પ્યુટર જાણે છે કે કોઈ સુરક્ષિત વેબસાઇટ સાચી છે. જ્યારે કોઈ"
" પ્રમાણપત્રની મુદત પૂરી થઈ ગઈ હોય, ટૂંક સમયમાં પૂરી થવાની હોય અથવા તેને દૂર "
"કરવામાં આવ્યું હોય ત્યારે ચેતવણી દેખાય છે."

msgid "Change"
msgstr "બદલો"

msgid "Change Scale. A bigger number makes everything bigger."
msgstr "\"Scale\" (માપ) બદલો. મોટો આંકડો બધું મોટું બનાવે છે."

msgid "Change a Wheelhouse setting"
msgstr "Wheelhouse સેટિંગ બદલો"

msgid "Change it"
msgstr "તેને બદલો"

msgid "Change the kernel settings the computer starts with"
msgstr "કમ્પ્યુટર જે કર્નલ સેટિંગ્સ સાથે શરૂ થાય છે તે બદલો"

msgid "Change the layout"
msgstr "લેઆઉટ બદલો"

msgid "Change the wallpaper to the next picture in a folder"
msgstr "વોલપેપરને ફોલ્ડરમાંના આગલા ચિત્ર પર બદલો"

msgid ""
"Changed your mind? Open Undo the last update again and click Use the newer "
"version."
msgstr ""
"વિચાર બદલાયો? \"છેલ્લું અપડેટ પૂર્વવત્ કરો\" ફરીથી ખોલો અને \"નવું વર્ઝન "
"વાપરો\" પર ક્લિક કરો."

#, python-brace-format
msgid "Changing {title}"
msgstr "{title} બદલી રહ્યું છે"

msgid ""
"Check everything. Click a line to change it, or click Install to put "
"EvenKeelOS on the disk."
msgstr ""
"બધું તપાસો. કોઈ લાઇન બદલવા માટે તેના પર ક્લિક કરો, અથવા EvenKeelOSને ડિસ્ક પર"
" મૂકવા માટે \"ઇન્સ્ટોલ કરો\" પર ક્લિક કરો."

msgid "Check that automatic rollback works"
msgstr "તપાસો કે સ્વચાલિત રોલબેક કામ કરે છે"

msgid "Check that it can't break"
msgstr "તપાસો કે તે બગડી ન શકે"

msgid ""
"Check that the computer goes back by itself when a new version won't start, "
"and puts back deleted settings"
msgstr ""
"તપાસો કે નવું વર્ઝન શરૂ ન થાય ત્યારે કમ્પ્યુટર પોતે જ પાછું જાય છે, અને કાઢી "
"નાખેલી સેટિંગ્સ પાછી મૂકે છે"

msgid "Check the BIOS's storage settings."
msgstr "BIOSની સ્ટોરેજ સેટિંગ્સ તપાસો."

msgid "Check the boxes"
msgstr "ઍપ બોક્સ તપાસો"

msgid "Checked against its own docs"
msgstr "તેના પોતાના દસ્તાવેજો સાથે સરખાવીને તપાસવામાં આવ્યું"

msgid "Checked every day too"
msgstr "દરરોજ પણ તપાસવામાં આવે છે"

msgid "Checking for firmware updates."
msgstr "ફર્મવેર અપડેટ્સ માટે તપાસી રહ્યું છે."

msgid "Checking sharing…"
msgstr "શેરિંગ તપાસી રહ્યું છે…"

msgid "Checking the network…"
msgstr "નેટવર્ક તપાસી રહ્યું છે…"

msgid "Checking this computer's parts..."
msgstr "આ કમ્પ્યુટરના ભાગો તપાસી રહ્યાં છીએ..."

#, python-brace-format
msgid "Checking whether Fedora has {name}."
msgstr "Fedora પાસે {name} છે કે કેમ તે તપાસી રહ્યું છે."

msgid "Checking…"
msgstr "તપાસી રહ્યાં છીએ…"

msgid "Choose"
msgstr "પસંદ કરો"

msgid "Choose apps from .rpm or .deb files that start when you log in"
msgstr ""
".rpm અથવા .deb ફાઇલોમાંથી એવી ઍપ્સ પસંદ કરો જે તમે લૉગ ઇન કરો ત્યારે શરૂ થાય "
"છે"

msgid "Choose which app opens a file"
msgstr "ફાઇલ ખોલવા માટે કઈ ઍપ વાપરવી તે પસંદ કરો"

#, python-brace-format
msgid "Chosen: automatic, from {servers}."
msgstr "પસંદ કરેલ: સ્વચાલિત, {servers}માંથી."

msgid "Chosen: don't encrypt."
msgstr "પસંદ કરેલ: એન્ક્રિપ્ટ કરશો નહીં."

msgid "Chosen: enabled."
msgstr "પસંદ કરેલ: સક્ષમ."

msgid "Chosen: encrypt."
msgstr "પસંદ કરેલ: એન્ક્રિપ્ટ કરો."

msgid "Chosen: locked."
msgstr "પસંદ કરેલ: લૉક કરેલ."

#, python-brace-format
msgid "Chosen: {disk}."
msgstr "પસંદ કરેલ: {disk}."

#, python-brace-format
msgid "Chosen: {names}."
msgstr "પસંદ કરેલ: {names}."

#, python-brace-format
msgid "Chosen: {name}."
msgstr "પસંદ કરેલ: {name}."

#, python-brace-format
msgid "Chosen: {time}."
msgstr "પસંદ કરેલ: {time}."

msgid ""
"Click Add a folder and pick it. It starts as Read only: change it to Read and"
" write if the other computer should save there too."
msgstr ""
"\"ફોલ્ડર ઉમેરો\" પર ક્લિક કરો અને તેને પસંદ કરો. તે શરૂઆતમાં \"ફક્ત વાંચવા "
"માટે\" હોય છે: જો બીજા કમ્પ્યુટરે પણ ત્યાં સાચવવું હોય, તો તેને \"વાંચવા અને "
"લખવા માટે\" પર બદલો."

msgid "Click Apply, then Keep Changes if it looks right."
msgstr ""
"\"લાગુ કરો\" પર ક્લિક કરો, પછી જો બરાબર લાગે તો \"ફેરફારો કરો\" (Keep "
"Changes) પર ક્લિક કરો."

msgid "Click Back to the original to undo all of it."
msgstr "બધું જ પૂર્વવત્ કરવા માટે \"મૂળ પર પાછા જાઓ\" પર ક્લિક કરો."

msgid ""
"Click Free up disk space, then Free up space. Your files and apps aren't "
"touched."
msgstr ""
"\"ડિસ્ક જગ્યા ખાલી કરો\" પર ક્લિક કરો, પછી \"જગ્યા ખાલી કરો\" પર ક્લિક કરો. "
"તમારી ફાઇલો અને ઍપ્સને કંઈ થતું નથી."

msgid ""
"Click Install the driver, type your password, and restart. Then add the "
"printer."
msgstr ""
"\"ડ્રાઇવર ઇન્સ્ટોલ કરો\" પર ક્લિક કરો, તમારો પાસવર્ડ લખો અને રીસ્ટાર્ટ કરો. "
"પછી પ્રિન્ટર ઉમેરો."

msgid "Click Install, and it installs that instead."
msgstr "\"ઇન્સ્ટોલ કરો\" પર ક્લિક કરો, અને તે તેના બદલે એને ઇન્સ્ટોલ કરશે."

msgid ""
"Click Let an app in, type its name, like Minecraft or Jellyfin, and click it."
msgstr ""
"\"ઍપને પ્રવેશ આપો\" પર ક્લિક કરો, તેનું નામ લખો, જેમ કે Minecraft અથવા "
"Jellyfin, અને તેના પર ક્લિક કરો."

msgid ""
"Click Restart to start EvenKeelOS. Click Save the log to put the details of "
"this install on a second USB stick."
msgstr ""
"EvenKeelOS શરૂ કરવા માટે \"રીસ્ટાર્ટ કરો\" પર ક્લિક કરો. આ ઇન્સ્ટોલની વિગતો "
"બીજી USB સ્ટિક પર મૂકવા માટે \"લૉગ સાચવો\" પર ક્લિક કરો."

msgid ""
"Click Save details. It makes one file of recent errors, in Documents. Nothing"
" is sent anywhere."
msgstr ""
"\"વિગતો સાચવો\" પર ક્લિક કરો. તે દસ્તાવેજોમાં તાજેતરની ભૂલોની એક ફાઇલ બનાવે "
"છે. ક્યાંય કંઈ મોકલવામાં આવતું નથી."

msgid "Click Show the file, then attach it to an email to your helper."
msgstr ""
"\"ફાઇલ બતાવો\" પર ક્લિક કરો, પછી તેને તમારા મદદગારને મોકલવા માટે ઇમેઇલમાં "
"જોડો."

msgid "Click Test to hear each speaker."
msgstr "દરેક સ્પીકર સાંભળવા માટે \"Test\" (ચકાસો) પર ક્લિક કરો."

msgid "Click Turn off or Turn on. Turning them off asks for your password."
msgstr ""
"\"બંધ કરો\" અથવા \"ચાલુ કરો\" પર ક્લિક કરો. તેમને બંધ કરવા માટે તમારો પાસવર્ડ"
" માંગવામાં આવે છે."

msgid "Click Turn on, type the disk password once, and restart."
msgstr "\"ચાલુ કરો\" પર ક્લિક કરો, ડિસ્ક પાસવર્ડ એક વાર લખો, અને રીસ્ટાર્ટ કરો."

msgid ""
"Click Undo the update, type your password, and restart. Your files and apps "
"aren't touched."
msgstr ""
"\"અપડેટ પૂર્વવત્ કરો\" પર ક્લિક કરો, તમારો પાસવર્ડ લખો, અને રીસ્ટાર્ટ કરો. "
"તમારી ફાઇલો અને ઍપ્સને કંઈ થતું નથી."

msgid ""
"Click a font to pick another, or change Text size. 1.00 is the normal size."
msgstr ""
"બીજો ફોન્ટ પસંદ કરવા માટે કોઈ ફોન્ટ પર ક્લિક કરો, અથવા ટેક્સ્ટનું કદ બદલો. "
"1.00 એ સામાન્ય કદ છે."

msgid "Click the USB stick to save them on."
msgstr "તેમને સાચવવા માટે USB સ્ટિક પર ક્લિક કરો."

msgid ""
"Click the clock to see your notifications and the calendar. Or press Windows "
"key + V."
msgstr ""
"તમારી સૂચનાઓ અને કૅલેન્ડર જોવા માટે ઘડિયાળ પર ક્લિક કરો. અથવા Windows કી + V "
"દબાવો."

msgid "Click the copy button next to a command, then paste it in Terminal."
msgstr ""
"આદેશની બાજુમાં આવેલા કૉપિ બટન પર ક્લિક કરો, પછી તેને ટર્મિનલમાં પેસ્ટ કરો."

msgid "Click the device's name when it shows in the list."
msgstr "જ્યારે ઉપકરણનું નામ યાદીમાં દેખાય ત્યારે તેના પર ક્લિક કરો."

msgid ""
"Click the icons at the end of the bar, then the arrow next to Wi-Fi. Or open "
"Settings, Wi-Fi."
msgstr ""
"બારના છેડે આવેલા આઇકન પર ક્લિક કરો, પછી Wi-Fiની બાજુમાં આવેલા તીર પર ક્લિક "
"કરો. અથવા સુયોજનો ખોલો, પછી Wi-Fi."

msgid ""
"Click the icons at the end of the bar: the bottom right with the Windows-"
"style layout, the top right with the standard one. Or press Windows key + S."
msgstr ""
"બારના છેડે આવેલા આઇકન પર ક્લિક કરો: Windows-શૈલીના લેઆઉટમાં નીચે જમણી બાજુએ, "
"પ્રમાણભૂત લેઆઉટમાં ઉપર જમણી બાજુએ. અથવા Windows કી + S દબાવો."

msgid ""
"Click the magnifying glass, or press Ctrl+F, and type to search this folder "
"and the folders in it."
msgstr ""
"મેગ્નિફાઇંગ ગ્લાસ પર ક્લિક કરો, અથવા Ctrl+F દબાવો, અને આ ફોલ્ડર તથા તેમાં "
"રહેલા ફોલ્ડરોમાં શોધવા માટે લખો."

msgid "Click the meeting link you were sent."
msgstr "તમને મોકલવામાં આવેલી મીટિંગની લિંક પર ક્લિક કરો."

msgid "Click the network's name, type its password, and press Enter."
msgstr "નેટવર્કના નામ પર ક્લિક કરો, તેનો પાસવર્ડ લખો અને Enter દબાવો."

msgid ""
"Click the printer when it shows, then Add. Most printers need nothing else."
msgstr ""
"પ્રિન્ટર દેખાય ત્યારે તેના પર ક્લિક કરો, પછી \"ઉમેરો\" પર ક્લિક કરો. મોટા "
"ભાગના પ્રિન્ટરોને બીજું કંઈ જોઈતું નથી."

msgid "Clock"
msgstr "ઘડિયાળ"

msgid "Clock sync"
msgstr "ઘડિયાળનું સિંક્રનાઇઝેશન"

msgid "Close"
msgstr "બંધ કરો"

msgid "Close it again"
msgstr "તેને ફરીથી બંધ કરો"

#, python-brace-format
msgid "Close {name} again"
msgstr "{name} ફરીથી બંધ કરો"

msgid "Code and terminal"
msgstr "કોડ અને ટર્મિનલ"

msgid "Collecting the problem details."
msgstr "સમસ્યાની વિગતો એકત્રિત કરી રહ્યાં છીએ."

msgid "Colors and wallpaper"
msgstr "રંગો અને વોલપેપર"

msgid "Comes with the system"
msgstr "સિસ્ટમ સાથે આવે છે"

msgid "Coming from Windows"
msgstr "Windows પરથી આવી રહ્યા છો"

msgid "Coming from Windows: where things are, and what's different"
msgstr "Windows પરથી આવી રહ્યા છો: વસ્તુઓ ક્યાં છે, અને શું અલગ છે"

msgid "Coming from Windows?"
msgstr "Windows પરથી આવી રહ્યા છો?"

msgid "Common fixes"
msgstr "સામાન્ય સુધારા"

msgid "Computer name"
msgstr "કમ્પ્યુટરનું નામ"

#, python-brace-format
msgid "Computer name: {name}."
msgstr "કમ્પ્યુટરનું નામ: {name}."

msgid "Connect"
msgstr "કનેક્ટ કરો"

msgid "Connect a Bluetooth device"
msgstr "બ્લૂટૂથ ઉપકરણ કનેક્ટ કરો"

#, python-brace-format
msgid "Connected to {network}."
msgstr "{network} સાથે કનેક્ટ થઈ ગયા."

#, python-brace-format
msgid "Connecting to {network}..."
msgstr "{network} સાથે કનેક્ટ થઈ રહ્યું છે..."

msgid ""
"Control Panel: Settings, for Wi-Fi, screens, sound, printers and accounts. "
"Wheelhouse, for updates, apps and fixes. A ship is steered from its "
"wheelhouse; this is where you steer your computer."
msgstr ""
"નિયંત્રણ પેનલ: સુયોજનો, Wi-Fi, સ્ક્રીન, સાઉન્ડ, પ્રિન્ટરો અને એકાઉન્ટ્સ માટે."
" Wheelhouse, અપડેટ્સ, ઍપ્સ અને સુધારાઓ માટે. જહાજને તેના wheelhouse "
"(સુકાન-ખંડ)માંથી ચલાવવામાં આવે છે; અહીંથી તમે તમારું કમ્પ્યુટર ચલાવો છો."

#, python-brace-format
msgid "Copied: {command}"
msgstr "કૉપિ કર્યું: {command}"

msgid "Copy files by dragging them onto it, or with Ctrl+C and Ctrl+V."
msgstr "ફાઇલોને તેના પર ખેંચીને મૂકીને અથવા Ctrl+C અને Ctrl+V વડે કૉપિ કરો."

msgid "Copy the command"
msgstr "આદેશ કૉપિ કરો"

#, python-brace-format
msgid "Copy {command}"
msgstr "{command} કૉપિ કરો"

msgid "Copying EvenKeelOS to the disk"
msgstr "EvenKeelOSને ડિસ્ક પર કૉપિ કરી રહ્યું છે"

msgid "Copying EvenKeelOS to the disk failed."
msgstr "EvenKeelOSને ડિસ્ક પર કૉપિ કરી શકાયું નહીં."

#, python-brace-format
msgid "Could not connect to {network}. Check the password."
msgstr "{network} સાથે કનેક્ટ થઈ શકાયું નથી. પાસવર્ડ તપાસો."

msgid ""
"Couldn't check for firmware updates. Check your internet connection and try "
"again."
msgstr ""
"ફર્મવેર અપડેટ્સ માટે તપાસી શકાયું નહીં. તમારું ઇન્ટરનેટ કનેક્શન તપાસો અને ફરી"
