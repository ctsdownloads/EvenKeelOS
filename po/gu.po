msgid "Installing {title}."
msgstr "{title} ઇન્સ્ટોલ કરી રહ્યું છે."

msgid "Intel (newest chips): flicker or black flashes"
msgstr "Intel (સૌથી નવી ચિપ્સ): ઝબકારા અથવા કાળી ઝલક"

msgid "Intel (older chips): flicker or freezes"
msgstr "Intel (જૂની ચિપ્સ): ઝબકારા અથવા અટકી જવું"

msgid "Internet and networks"
msgstr "ઇન્ટરનેટ અને નેટવર્ક્સ"

msgid "It adds its maker's download source, so it updates with System Update."
msgstr ""
"તે તેના ઉત્પાદકના ડાઉનલોડ સ્રોતને ઉમેરે છે, તેથી તે સિસ્ટમ અપડેટ સાથે અપડેટ "
"થાય છે."

msgid ""
"It also has a device rule. That goes on the system, so you will be asked for "
"your password."
msgstr ""
"તેમાં એક ઉપકરણ નિયમ પણ છે. તે સિસ્ટમ પર જાય છે, તેથી તમને તમારો પાસવર્ડ "
"પૂછવામાં આવશે."

msgid "It comes back on by itself on a Home network."
msgstr "તે ઘર નેટવર્ક પર આપમેળે ફરી ચાલુ થાય છે."

msgid "It could not reach the internet. Check the connection, then try again."
msgstr ""
"તે ઇન્ટરનેટ સુધી પહોંચી શક્યું નહીં. કનેક્શન તપાસો, પછી ફરી પ્રયાસ કરો."

msgid "It didn't work, and nothing was changed."
msgstr "તે કામ ન થયું, અને કંઈ બદલાયું નથી."

#, python-brace-format
msgid ""
"It didn't work, and nothing was changed.\n"
"\n"
"The details are in {log}"
msgstr ""
"તે કામ ન થયું, અને કંઈ બદલાયું નથી.\n"
"\n"
"વિગતો {log}માં છે"

#, python-brace-format
msgid ""
"It didn't work, and nothing was changed. Try again later.\n"
"\n"
"The details are in {log}"
msgstr ""
"તે કામ ન થયું, અને કંઈ બદલાયું નથી. પછીથી ફરી પ્રયાસ કરો.\n"
"\n"
"વિગતો {log}માં છે"

#, python-brace-format
msgid ""
"It didn't work.\n"
"\n"
"The details are in {log}"
msgstr ""
"તે કામ ન થયું.\n"
"\n"
"વિગતો {log}માં છે"

msgid ""
"It gives anyone at the keyboard a shell with full control, with no password."
msgstr ""
"તે કીબોર્ડ પર બેઠેલા કોઈપણ વ્યક્તિને પાસવર્ડ વિના, સંપૂર્ણ નિયંત્રણ સાથેનું "
"શેલ આપે છે."

#, python-brace-format
msgid "It goes in the {label} and updates with System Update."
msgstr "તે {label}માં જાય છે અને સિસ્ટમ અપડેટ સાથે અપડેટ થાય છે."

msgid "It has no app of its own; other apps in the box use it."
msgstr "તેની પોતાની કોઈ ઍપ નથી; બોક્સમાંની બીજી ઍપ્સ તેનો ઉપયોગ કરે છે."

msgid "It has no window of its own in Show Apps."
msgstr "\"Show Apps\"માં તેની પોતાની કોઈ વિન્ડો નથી."

msgid "It is a command-line tool, so it has no window in Show Apps."
msgstr "આ કમાન્ડ-લાઇન સાધન છે, તેથી \"Show Apps\"માં તેની કોઈ વિન્ડો નથી."

msgid "It is made for a different kind of processor than this computer has."
msgstr ""
"તે આ કમ્પ્યુટરમાં છે તેનાથી અલગ પ્રકારના પ્રોસેસર માટે બનાવવામાં આવ્યું છે."

msgid ""
"It may not work yet. When it does, it works in Firefox and the Camera app, "
"not every app."
msgstr ""
"તે કદાચ હજી કામ ન કરે. જ્યારે કરે, ત્યારે તે Firefox અને કેમેરા ઍપમાં કામ કરે"
" છે, દરેક ઍપમાં નહીં."

msgid ""
"It needs parts that the Ubuntu box (Ubuntu 24.04) does not have. It may be "
"made for a newer or older Ubuntu."
msgstr ""
"તેને એવા ઘટકોની જરૂર છે જે Ubuntu બોક્સ (Ubuntu 24.04) પાસે નથી. તે કદાચ નવા "
"કે જૂના Ubuntu માટે બનાવવામાં આવ્યું હશે."

#, python-brace-format
msgid ""
"It needs {name}, which Fedora {version} does not have. It may be made for a "
"different Fedora version."
msgstr ""
"તેને {name}ની જરૂર છે, જે Fedora {version} પાસે નથી. તે કદાચ Fedoraના બીજા "
"વર્ઝન માટે બનાવવામાં આવ્યું હોય."

#, python-brace-format
msgid ""
"It needs {name}, which the Ubuntu box (Ubuntu 24.04) does not have. It may be"
" made for a newer or older Ubuntu."
msgstr ""
"તેને {name}ની જરૂર છે, જે Ubuntu બોક્સ (Ubuntu 24.04) પાસે નથી. તે નવા કે "
"જૂના Ubuntu માટે બનાવવામાં આવેલું હોઈ શકે છે."

msgid "It never updates."
msgstr "તે ક્યારેય અપડેટ થતું નથી."

msgid ""
"It opens file sharing ports: folders are shared only on Home networks, in "
"Shared folders."
msgstr ""
"તે ફાઇલ શેરિંગ પોર્ટ્સ ખોલે છે: ફોલ્ડર્સ ફક્ત ઘર નેટવર્ક્સ પર, \"શેર કરેલાં "
"ફોલ્ડર્સ\"માં જ શેર થાય છે."

msgid "It says first whether the app keeps itself updated, then installs it."
msgstr ""
"તે પહેલાં જણાવે છે કે ઍપ પોતાને અપડેટ રાખે છે કે નહીં, પછી તેને ઇન્સ્ટોલ કરે "
"છે."

msgid "It starts when you restart the computer."
msgstr "જ્યારે તમે કમ્પ્યુટરને રીસ્ટાર્ટ કરો છો ત્યારે તે શરૂ થાય છે."

msgid ""
"It stops a driver from loading. If it's the drive's or the screen's driver, "
"the computer won't start."
msgstr ""
"તે ડ્રાઇવરને લોડ થતાં અટકાવે છે. જો તે ડ્રાઇવનો અથવા સ્ક્રીનનો ડ્રાઇવર હોય, "
"તો કમ્પ્યુટર શરૂ થશે નહીં."

msgid ""
"It tells you whether there's a version for EvenKeelOS, or a replacement that "
"does the same job."
msgstr ""
"તે તમને જણાવે છે કે EvenKeelOS માટે કોઈ વર્ઝન છે કે નહીં, અથવા એ જ કામ કરતો "
"કોઈ વિકલ્પ છે કે નહીં."

msgid ""
"It turns off SELinux, which keeps apps and services from reaching what they "
"shouldn't."
msgstr ""
"તે SELinux બંધ કરે છે, જે ઍપ્સ અને સર્વિસને એવી વસ્તુઓ સુધી પહોંચતા અટકાવે છે"
" જ્યાં તેઓને ન જવું જોઈએ."

msgid "It turns off or weakens a security protection."
msgstr "તે કોઈ સુરક્ષા રક્ષણને બંધ કરે છે અથવા નબળું પાડે છે."

msgid "It turns off protection against processor security flaws."
msgstr "તે પ્રોસેસરની સુરક્ષા ખામીઓ સામેનું રક્ષણ બંધ કરે છે."

msgid ""
"It turns off the graphics driver: low resolution, no outside screens, and "
"sleep may not work."
msgstr ""
"તે ગ્રાફિક્સ ડ્રાઇવરને બંધ કરે છે: રિઝોલ્યુશન ઓછું હશે, બહારની સ્ક્રીનો કામ "
"કરશે નહીં, અને સ્લીપ મોડ પણ કદાચ કામ કરશે નહીં."

msgid "It updates by itself."
msgstr "તે પોતે જ અપડેટ થાય છે."

msgid ""
"It would replace a file that belongs to the system, so it was not added."
msgstr "તે સિસ્ટમની એક ફાઇલને બદલી નાખત, તેથી તેને ઉમેરવામાં આવ્યું નથી."

#, python-brace-format
msgid "It's already set: the version from {date} starts at your next restart."
msgstr ""
"તે પહેલેથી જ સેટ છે: {date}નું વર્ઝન તમારા આગામી રીસ્ટાર્ટ વખતે શરૂ થશે."

msgid "It's in Wheelhouse if you want it again."
msgstr "જો તમારે તે ફરીથી જોઈએ, તો તે Wheelhouseમાં છે."

msgid "It's on. From your next restart, the disk unlocks by itself."
msgstr "તે ચાલુ છે. તમારા આગામી રીસ્ટાર્ટથી, ડિસ્ક પોતે જ અનલૉક થશે."

msgid ""
"Its file changed or holds more than one certificate, so nothing was removed. "
"Tell your helper."
msgstr ""
"તેની ફાઇલ બદલાઈ ગઈ છે અથવા તેમાં એક કરતાં વધુ પ્રમાણપત્ર છે, તેથી કંઈ દૂર "
"કરવામાં આવ્યું નથી. તમારા મદદગારને જણાવો."

#, python-brace-format
msgid ""
"Its file is removed, but \"{name}\" is still trusted: it was added somewhere "
"else too. Tell your helper."
msgstr ""
"તેની ફાઇલ દૂર કરવામાં આવી છે, પરંતુ \"{name}\" પર હજી પણ વિશ્વાસ છે: તેને "
"બીજી જગ્યાએ પણ ઉમેરવામાં આવ્યું હતું. તમારા મદદગારને જણાવો."

