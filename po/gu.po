msgstr "એડેપ્ટિવ બેકલાઇટ બંધ કરે છે"

msgid "Two choices:"
msgstr "બે વિકલ્પો:"

msgid "Type a setting first."
msgstr "પહેલાં એક સેટિંગ લખો."

msgid "Type it again"
msgstr "તેને ફરીથી લખો"

msgid "Type it, then type it again below."
msgstr "તેને લખો, પછી નીચે ફરીથી લખો."

msgid "Type the disk password (the one you type when the computer starts):"
msgstr "ડિસ્ક પાસવર્ડ લખો (જે તમે કમ્પ્યુટર શરૂ થાય ત્યારે લખો છો):"

msgid "Type the disk password twice."
msgstr "ડિસ્ક પાસવર્ડ બે વાર લખો."

#, python-brace-format
msgid ""
"Type the password for {network}, then click Connect. Back goes to the list."
msgstr ""
"{network} માટેનો પાસવર્ડ લખો, પછી \"કનેક્ટ કરો\" પર ક્લિક કરો. \"પાછળ\" યાદી "
"પર પાછું લઈ જાય છે."

msgid "Type the password twice."
msgstr "પાસવર્ડ બે વાર લખો."

msgid ""
"Type your full name. Your user name is made from it; type over it to change "
"it."
msgstr ""
"તમારું પૂરું નામ લખો. તમારું વપરાશકર્તા નામ તેના પરથી બને છે; તેને બદલવા માટે"
" તેના પર લખો."

msgid "Type your password, then restart. The fix starts at the restart."
msgstr ""
"તમારો પાસવર્ડ લખો, પછી રીસ્ટાર્ટ કરો. સુધારો રીસ્ટાર્ટ વખતે શરૂ થાય છે."

msgid "USB drives and memory cards"
msgstr "USB ડ્રાઇવ્સ અને મેમરી કાર્ડ્સ"

msgid "USB or Bluetooth headphones may still work."
msgstr "USB અથવા બ્લૂટૂથ હેડફોન હજી પણ કામ કરી શકે છે."

msgid "USB stick"
msgstr "USB સ્ટિક"

msgid "Ubuntu box"
msgstr "Ubuntu બોક્સ"

msgid "Undo it. See Updates and safety."
msgstr "તેને પૂર્વવત્ કરો. \"અપડેટ્સ અને સુરક્ષા\" જુઓ."

msgid "Undo the change"
msgstr "ફેરફાર પૂર્વવત્ કરો"

msgid "Undo the last update"
msgstr "છેલ્લું અપડેટ પૂર્વવત્ કરો"

msgid "Undo the last update in Wheelhouse can still take you back later."
msgstr ""
"Wheelhouseમાંનું \"છેલ્લું અપડેટ પૂર્વવત્ કરો\" પછીથી પણ તમને પાછા લઈ જઈ શકે "
"છે."

msgid "Undo the update"
msgstr "અપડેટ પૂર્વવત્ કરો"

msgid "Unknown"
msgstr "અજ્ઞાત"

#, python-brace-format
