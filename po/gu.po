msgstr "અપડેટ થયું, આ સિવાય: %s"

msgid "Updates"
msgstr "અપડેટ્સ"

msgid "Updates and safety"
msgstr "અપડેટ્સ અને સુરક્ષા"

msgid "Updates can't run"
msgstr "અપડેટ્સ ચલાવી શકાતાં નથી"

msgid "Updates for the computer's own parts, like the BIOS"
msgstr "કમ્પ્યુટરના પોતાના ભાગો, જેમ કે BIOS માટેના અપડેટ્સ"

msgid "Updates happen on their own"
msgstr "અપડેટ્સ પોતાની જાતે થાય છે"

msgid ""
"Updates install on their own. If one stops the computer starting properly, it"
" goes back to the version before by itself and tells you."
msgstr ""
"અપડેટ્સ પોતાની જાતે ઇન્સ્ટોલ થાય છે. જો કોઈ અપડેટને કારણે કમ્પ્યુટર બરાબર શરૂ"
" ન થાય, તો તે પોતે જ પહેલાંના વર્ઝન પર પાછું જાય છે અને તમને જણાવે છે."

#, python-brace-format
msgid ""
"Updates: automatic, from {maker}'s own download source. A daily check finds "
"new versions, which start at the next restart."
msgstr ""
"અપડેટ્સ: સ્વચાલિત, {maker}ના પોતાના ડાઉનલોડ સ્રોતમાંથી. દૈનિક તપાસ નવાં વર્ઝન"
" શોધે છે, જે આગામી રીસ્ટાર્ટ વખતે શરૂ થાય છે."

msgid "Updates: automatic, with System Update."
msgstr "અપડેટ્સ: સ્વચાલિત, સિસ્ટમ અપડેટ સાથે."

msgid "Updates: automatic."
msgstr "અપડેટ્સ: સ્વચાલિત."

msgid ""
"Updates: none, because it came from a file. To update, install a newer file. "
"(Some apps, like Discord, update themselves.)"
msgstr ""
"અપડેટ્સ: કોઈ નહીં, કારણ કે તે ફાઇલમાંથી આવી છે. અપડેટ કરવા માટે, નવી ફાઇલ "
"ઇન્સ્ટોલ કરો. (Discord જેવી કેટલીક ઍપ્સ પોતાને અપડેટ કરે છે.)"

#, python-brace-format
msgid "Updates: {how}"
msgstr "અપડેટ્સ: {how}"

msgid "Updating"
msgstr "અપડેટ થઈ રહ્યું છે"

msgid ""
"Updating everything: the system, your apps and the app boxes. This can take a"
" while. You can keep working."
msgstr ""
"બધું અપડેટ થઈ રહ્યું છે: સિસ્ટમ, તમારી ઍપ્સ અને ઍપ બોક્સ. આમાં થોડો સમય લાગી "
"શકે છે. તમે કામ ચાલુ રાખી શકો છો."

msgid "Updating firmware. Keep the computer plugged in."
msgstr "ફર્મવેર અપડેટ થઈ રહ્યું છે. કમ્પ્યુટર પ્લગ ઇન રાખો."

msgid "Updating the system, apps and containers. This can take a while."
msgstr ""
"સિસ્ટમ, ઍપ્સ અને કન્ટેનર્સ અપડેટ કરી રહ્યા છીએ. આમાં થોડો સમય લાગી શકે છે."

msgid "Updating the system: checking for a new version."
msgstr "સિસ્ટમ અપડેટ થઈ રહી છે: નવું વર્ઝન તપાસી રહ્યા છીએ."

#, python-brace-format
msgid "Updating the system: downloaded part {done} of {total}."
msgstr "સિસ્ટમ અપડેટ થઈ રહી છે: ભાગ {done}/{total} ડાઉનલોડ થયો."

#, python-brace-format
msgid ""
"Updating the system: downloading part {part} of {total}, about {got} of "
"{size} so far."
msgstr ""
"સિસ્ટમ અપડેટ થઈ રહી છે: ભાગ {part}/{total} ડાઉનલોડ થઈ રહ્યો છે, અત્યાર સુધી "
"લગભગ {got} / {size}."

#, python-brace-format
msgid "Updating the system: downloading the new version, {size} in {n} parts."
msgid_plural ""
"Updating the system: downloading the new version, {size} in {n} parts."
msgstr[0] ""
"સિસ્ટમ અપડેટ થઈ રહી છે: નવું વર્ઝન ડાઉનલોડ થઈ રહ્યું છે, {size}, {n} ભાગમાં."
msgstr[1] ""
"સિસ્ટમ અપડેટ થઈ રહી છે: નવું વર્ઝન ડાઉનલોડ થઈ રહ્યું છે, {size}, {n} ભાગોમાં."

msgid "Updating the system: it is already up to date."
msgstr "સિસ્ટમ અપડેટ થઈ રહી છે: તે પહેલેથી જ અપ ટુ ડેટ છે."

#, python-brace-format
msgid "Updating the system: step {step} of {total}, {stage} ({elapsed})."
msgstr "સિસ્ટમ અપડેટ થઈ રહી છે: પગલું {step}/{total}, {stage} ({elapsed})."

#, python-brace-format
msgid "Updating the system: step {step} of {total}, {stage}."
msgstr "સિસ્ટમ અપડેટ થઈ રહી છે: પગલું {step}/{total}, {stage}."

msgid ""
"Updating the system: the new version is installed. It starts at your next "
"restart."
msgstr ""
"સિસ્ટમ અપડેટ થઈ રહી છે: નવું વર્ઝન ઇન્સ્ટોલ થઈ ગયું છે. તે તમારા આગામી "
"રીસ્ટાર્ટ વખતે શરૂ થશે."

#, python-brace-format
msgid "Updating {title}"
msgstr "{title} અપડેટ કરી રહ્યું છે"

#, python-brace-format
msgid "Updating {title} in the {label}."
msgstr "{label}માં {title} અપડેટ કરી રહ્યું છે."

#, python-brace-format
msgid "Updating {title} on the system"
msgstr "સિસ્ટમ પર {title} અપડેટ કરી રહ્યું છે"

#, python-brace-format
msgid "Updating {title} on the system. A progress window shows it."
msgstr "સિસ્ટમ પર {title} અપડેટ થઈ રહ્યું છે. પ્રગતિ વિન્ડો તે બતાવે છે."

#, python-brace-format
msgid "Updating {title} on the system. This can take a few minutes."
msgstr "સિસ્ટમ પર {title} અપડેટ થઈ રહ્યું છે. આમાં થોડી મિનિટો લાગી શકે છે."

#, python-brace-format
msgid "Updating {title}: {description}"
msgstr "{title} અપડેટ કરી રહ્યું છે: {description}"

#, python-brace-format
msgid ""
"Use 1 to {max} ports from 1 to 65535, each as 8096/tcp or 2456-2458/udp."
msgstr ""
"1થી 65535 વચ્ચેના 1થી {max} પોર્ટ્સ વાપરો, દરેક 8096/tcp અથવા 2456-2458/udp "
"રૂપે."

msgid "Use Flathub"
msgstr "Flathub વાપરો"

msgid "Use Open a port with its number."
msgstr "\"પોર્ટ ખોલો\" તેના નંબર સાથે વાપરો."

msgid "Use a network cable, or a USB Wi-Fi adapter that works with Linux."
msgstr "નેટવર્ક કેબલ, અથવા Linux સાથે કામ કરતું USB Wi-Fi એડેપ્ટર વાપરો."

msgid "Use a network cable."
msgstr "નેટવર્ક કેબલ વાપરો."

msgid "Use letters, digits and -, not at the start or end."
msgstr "અક્ષરો, અંકો અને - વાપરો, પણ - શરૂઆતમાં કે અંતે નહીં."

msgid "Use the file"
msgstr "ફાઇલનો ઉપયોગ કરો"

msgid "Use the newer version"
msgstr "નવું વર્ઝન વાપરો"

msgid "Use the number the app's own instructions give."
msgstr "ઍપની પોતાની સૂચનાઓમાં જણાવેલ નંબરનો ઉપયોગ કરો."

msgid "Use the usual browser"
msgstr "સામાન્ય બ્રાઉઝર વાપરો"

#, python-brace-format
msgid "Use {min} to 127 characters, on one line."
msgstr "{min}થી 127 અક્ષરો વાપરો, એક જ લાઇનમાં."

msgid "User name"
msgstr "વપરાશકર્તા નામ"

msgid "VPN"
msgstr "VPN"

msgid ""
"VPNs, codecs and apps added to the system, while automatic updates are on. "
"New versions start at the next restart."
msgstr ""
"સ્વચાલિત અપડેટ્સ ચાલુ હોય ત્યારે, સિસ્ટમમાં ઉમેરેલાં VPN, કોડેક્સ અને ઍપ્સ. "
"નવાં વર્ઝન આગામી રીસ્ટાર્ટ વખતે શરૂ થાય છે."

msgid ""
"Video and audio that need them stop playing. Needs your password and a "
"restart."
msgstr ""
"જે વિડિયો અને ઑડિયોને તેમની જરૂર હોય તે ચાલવાનું બંધ થાય છે. તમારો પાસવર્ડ "
"અને રીસ્ટાર્ટ જરૂરી છે."

#, python-brace-format
msgid "Waiting for the other install or removal to finish ({doing})."
msgstr ""
"બીજું ઇન્સ્ટોલ અથવા દૂર કરવાનું પૂરું થાય તેની રાહ જોઈ રહ્યા છીએ ({doing})."

msgid "Wallpaper slideshow"
msgstr "વોલપેપર સ્લાઇડશો"

msgid "Weak"
msgstr "નબળું"

msgid "Web video is already installed. Restart if you have not yet."
msgstr ""
"વેબ વિડિયો પહેલેથી ઇન્સ્ટોલ છે. જો તમે હજી રીસ્ટાર્ટ ન કર્યું હોય, તો "
"રીસ્ટાર્ટ કરો."

msgid "Web video only"
msgstr "ફક્ત વેબ વિડિયો"

msgid "Welcome to EvenKeelOS"
msgstr "EvenKeelOSમાં આપનું સ્વાગત છે"

msgid ""
"Welcome. A few things to set up, one at a time.\n"
"\n"
"1. Media codecs, for web video\n"
"2. Skip the disk password at startup\n"
"3. How to get apps\n"
"\n"
"Each can be skipped.\n"
"\n"
"Recommended: Start. Or Later: this opens again at the next login. Or Don't show again: it's in Wheelhouse any time."
msgstr ""
"સ્વાગત છે. થોડી વસ્તુઓ સેટ કરવાની છે, એક પછી એક.\n"
"\n"
"1. મીડિયા કોડેક્સ, વેબ વિડિયો માટે\n"
"2. શરૂઆત વખતે ડિસ્ક પાસવર્ડ છોડો\n"
"3. ઍપ્સ કેવી રીતે મેળવવી\n"
"\n"
"દરેકને છોડી શકાય છે.\n"
"\n"
"ભલામણ: શરૂ કરો. અથવા પછીથી: આ આગામી લૉગિન વખતે ફરીથી ખૂલે છે. અથવા ફરીથી બતાવશો નહીં: તે ગમે ત્યારે Wheelhouseમાં છે."

msgid "What happens"
msgstr "શું થાય છે"

msgid "What is new:"
msgstr "નવું શું છે:"

msgid "What it does"
msgstr "તે શું કરે છે"

msgid "What stopped working with them:"
msgstr "તેમની સાથે શું કામ કરતું બંધ થયું:"

msgid "What the test copy found broken:"
msgstr "ટેસ્ટ કૉપિમાં શું ખરાબ મળ્યું:"

msgid "What's different"
msgstr "શું અલગ છે"

msgid "Wheelhouse"
msgstr "Wheelhouse"

msgid "When neither of the two above is enough"
msgstr "જ્યારે ઉપરના બંનેમાંથી કોઈ પણ પૂરતું ન હોય"

#, python-brace-format
msgid "Where is {name}?"
msgstr "{name} ક્યાં છે?"

#, python-brace-format
msgid ""
"Where is {network}? This sets what other devices on it can reach once "
"EvenKeelOS is installed. Pick Public place anywhere you're not sure."
msgstr ""
"{network} ક્યાં છે? EvenKeelOS ઇન્સ્ટોલ થયા પછી તેના પરનાં અન્ય ઉપકરણો શેના "
"સુધી પહોંચી શકે તે આ નક્કી કરે છે. જ્યાં ખાતરી ન હોય ત્યાં જાહેર સ્થળ પસંદ "
"કરો."

msgid "Where it's from"
msgstr "તે ક્યાંથી આવે છે"

msgid "Where things are"
msgstr "વસ્તુઓ ક્યાં છે"

msgid ""
"Which VPN do you want? Each one comes from its company's own download source "
"and keeps updating. To connect, you need an account with that company."
msgstr ""
"તમને કયું VPN જોઈએ છે? દરેક તેની કંપનીના પોતાના ડાઉનલોડ સ્રોતમાંથી આવે છે અને"
" અપડેટ થતું રહે છે. કનેક્ટ થવા માટે, તમારે તે કંપનીમાં એકાઉન્ટની જરૂર છે."

msgid "Which app do you want to remove?"
msgstr "તમે કઈ ઍપ દૂર કરવા માંગો છો?"

msgid "Which app do you want? Start typing its name."
msgstr "તમને કઈ ઍપ જોઈએ છે? તેનું નામ લખવાનું શરૂ કરો."

msgid "Which app should start, or stop starting, when you log in?"
msgstr "તમે લૉગ ઇન કરો ત્યારે કઈ ઍપ શરૂ થવી જોઈએ, અથવા શરૂ થતી બંધ થવી જોઈએ?"

msgid "Which box do you want to repair?"
msgstr "તમે કયું બોક્સ રિપેર કરવા માંગો છો?"

#, python-brace-format
msgid "Which city in {region} has your time? Back goes to the regions."
msgstr "{region}માં કયા શહેરનો સમય તમારો છે? \"પાછળ\" પ્રદેશો પર પાછું લઈ જાય છે."

msgid ""
"Which disk should EvenKeelOS go on? Everything on it will be erased. The USB "
"stick this runs from is not listed."
msgstr ""
"EvenKeelOS કઈ ડિસ્ક પર મૂકવું? તેના પરનું બધું ભૂંસાઈ જશે. આ જે USB સ્ટિક "
"પરથી ચાલે છે તે યાદીમાં નથી."

msgid "Which file do you want to install?"
msgstr "તમે કઈ ફાઇલ ઇન્સ્ટોલ કરવા માંગો છો?"

msgid ""
"Which keyboard layouts do you use? Click one to add it, or click it again to "
"take it off. The first one is used unless you switch."
msgstr ""
"તમે કયાં કીબોર્ડ લેઆઉટ વાપરો છો? ઉમેરવા માટે એક પર ક્લિક કરો, અથવા કાઢવા માટે"
" તેના પર ફરીથી ક્લિક કરો. તમે બદલો નહીં ત્યાં સુધી પહેલું વપરાય છે."

msgid "Which language should EvenKeelOS use?"
msgstr "EvenKeelOS કઈ ભાષા વાપરે?"

msgid "Which one? Back goes to the list of languages."
msgstr "કઈ? \"પાછળ\" ભાષાઓની યાદી પર પાછું લઈ જાય છે."

msgid "Which tool do you want?"
msgstr "તમને કયું સાધન જોઈએ છે?"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Wi-Fi driver blocked"
msgstr "Wi-Fi ડ્રાઇવર બ્લોક થયેલ છે"

msgid "Wi-Fi found."
msgstr "Wi-Fi મળ્યું."

msgid "Wi-Fi password"
msgstr "Wi-Fi પાસવર્ડ"

msgid "Wi-Fi, how safe each network is, and Bluetooth"
msgstr "Wi-Fi, દરેક નેટવર્ક કેટલું સુરક્ષિત છે, અને બ્લૂટૂથ"

msgid "Wi-Fi, sound, brightness and power"
msgstr "Wi-Fi, સાઉન્ડ, બ્રાઇટનેસ અને પાવર"

msgid "Will this computer work?"
msgstr "શું આ કમ્પ્યુટર કામ કરશે?"

msgid "Windows Program"
msgstr "Windows પ્રોગ્રામ"

msgid "Windows Program is open"
msgstr "\"Windows પ્રોગ્રામ\" ખુલ્લું છે"

msgid "Windows key + L locks the screen."
msgstr "Windows કી + L સ્ક્રીનને લૉક કરે છે."

msgid "Windows programs"
msgstr "Windows પ્રોગ્રામ્સ"

msgid ""
"Windows programs (.exe and .msi) don't run here. Open one anyway: Wheelhouse "
"tells you the version for EvenKeelOS, or a replacement when there is one, and"
" installs it."
msgstr ""
"Windows પ્રોગ્રામ્સ (.exe અને .msi) અહીં ચાલતા નથી. તો પણ એક ખોલો: Wheelhouse"
" તમને EvenKeelOS માટેનું વર્ઝન, અથવા કોઈ વિકલ્પ હોય તો તે, જણાવે છે, અને તેને"
" ઇન્સ્ટોલ કરે છે."

msgid "Windows programs (.exe, .msi)"
msgstr "Windows પ્રોગ્રામ્સ (.exe, .msi)"

msgid "Windows-style"
msgstr "Windows-શૈલી"

msgid "Windows-style bottom bar or the standard top bar"
msgstr "Windows-શૈલીનો નીચેનો બાર અથવા પ્રમાણભૂત ટોચનો બાર"

msgid "Wired"
msgstr "વાયર્ડ"

msgid "Wired network"
msgstr "વાયર્ડ નેટવર્ક"

msgid "Wired network: connected."
msgstr "વાયર્ડ નેટવર્ક: કનેક્ટ છે."

msgid "Wired network: not connected."
msgstr "વાયર્ડ નેટવર્ક: કનેક્ટ નથી."

msgid ""
"With the Windows-style layout: click the sailboat button at the bottom left, "
"then Wheelhouse."
msgstr ""
"Windows-શૈલીના લેઆઉટમાં: નીચે ડાબી બાજુના સઢવાળી હોડીના બટન પર ક્લિક કરો, પછી"
" Wheelhouse."

msgid ""
"With the Windows-style layout: click the sailboat button at the bottom left, "
"then click the app, or start typing its name and press Enter."
msgstr ""
"Windows-શૈલીના લેઆઉટમાં: નીચે ડાબી બાજુના સઢવાળી હોડીના બટન પર ક્લિક કરો, પછી"
" ઍપ પર ક્લિક કરો, અથવા તેનું નામ લખવાનું શરૂ કરો અને Enter દબાવો."

msgid ""
"With the standard layout: click the logo at the top left, then Wheelhouse."
msgstr "પ્રમાણભૂત લેઆઉટમાં: ઉપર ડાબી બાજુના લોગો પર ક્લિક કરો, પછી Wheelhouse."

msgid ""
"With the standard layout: press the Windows key, start typing the app's name,"
" and press Enter. Or press Windows key + A to see every app."
msgstr ""
