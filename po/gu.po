msgstr "લેઆઉટ બદલાયું નથી."

msgid ""
"The layout, colors, wallpaper, dark at night, fonts, screen size, night "
"light, sound and accounts"
msgstr ""
"લેઆઉટ, રંગો, વોલપેપર, રાત્રે ડાર્ક, ફોન્ટ્સ, સ્ક્રીનનું કદ, નાઇટ લાઇટ, સાઉન્ડ"
" અને એકાઉન્ટ્સ"

msgid "The login screen doesn't start"
msgstr "લૉગિન સ્ક્રીન શરૂ થતી નથી"

msgid ""
"The login screen fails to start, so you never see it. The computer restarts "
"by itself within seconds, twice, and the third start is back on this version."
msgstr ""
"લૉગિન સ્ક્રીન શરૂ થતી નથી, તેથી તમને તે ક્યારેય દેખાતી નથી. કમ્પ્યુટર થોડી જ "
"સેકન્ડમાં પોતે જ બે વાર રીસ્ટાર્ટ થાય છે, અને ત્રીજી શરૂઆત ફરી આ વર્ઝન પર થાય"
" છે."

msgid ""
"The login screen works, but logging in drops you back to it. Log in a second "
"time; after the second drop the computer restarts by itself. Do that on 2 "
"starts, and the third start is back on this version."
msgstr ""
"લૉગિન સ્ક્રીન કામ કરે છે, પરંતુ લૉગ ઇન કર્યા પછી તમે ફરી તે જ સ્ક્રીન પર આવી "
"જાઓ છો. બીજી વાર લૉગ ઇન કરો; બીજી વાર પાછા આવ્યા પછી કમ્પ્યુટર પોતે જ "
"રીસ્ટાર્ટ થાય છે. આવું 2 શરૂઆતમાં કરો, અને ત્રીજી શરૂઆત ફરી આ વર્ઝન પર થાય "
"છે."

msgid "The media codecs start working after a restart."
msgstr "મીડિયા કોડેક્સ રીસ્ટાર્ટ પછી કામ કરવાનું શરૂ કરે છે."

msgid ""
"The menu that opens has Wi-Fi, Bluetooth, the sound volume, the screen "
"brightness, the power mode, dark style and night light."
msgstr ""
"જે મેનૂ ખૂલે છે તેમાં Wi-Fi, બ્લૂટૂથ, સાઉન્ડ વોલ્યુમ, સ્ક્રીન બ્રાઇટનેસ, પાવર"
" મોડ, ડાર્ક સ્ટાઇલ અને નાઇટ લાઇટ હોય છે."

msgid "The new files could not be labelled."
msgstr "નવી ફાઇલોને લેબલ કરી શકાયું નહીં."

msgid "The new partitions did not show up."
msgstr "નવાં પાર્ટીશનો દેખાયાં નહીં."

msgid "The new system could not be set to take signed updates."
msgstr "નવી સિસ્ટમને સહી કરેલા અપડેટ્સ લેવા માટે સેટ કરી શકાઈ નહીં."

#, python-brace-format
msgid "The new system has no {name} group."
msgstr "નવી સિસ્ટમમાં {name} જૂથ નથી."

msgid "The new system's desktop layouts could not be found."
msgstr "નવી સિસ્ટમનાં ડેસ્કટૉપ લેઆઉટ મળ્યાં નહીં."

msgid "The new system's settings database could not be found."
msgstr "નવી સિસ્ટમનો સેટિંગ્સ ડેટાબેઝ મળ્યો નહીં."

msgid "The next network you join starts as a Public place."
msgstr "તમે જે આગલા નેટવર્ક સાથે જોડાશો તે જાહેર સ્થળ તરીકે શરૂ થશે."

#, python-brace-format
msgid "The next start uses: {settings}"
msgstr "આગલી શરૂઆતમાં આ વપરાશે: {settings}"

msgid "The one-time setup window is already closed."
msgstr "એક વારની સેટઅપ વિન્ડો પહેલેથી બંધ છે."

msgid "The password is typed and matches."
msgstr "પાસવર્ડ લખવામાં આવ્યો છે અને તે મેળ ખાય છે."

#, python-brace-format
msgid "The password wasn't saved: {reason}"
msgstr "પાસવર્ડ સચવાયો નહીં: {reason}"

msgid ""
"The picture is copied, ready to paste, and saved in Pictures, Screenshots."
msgstr ""
"ચિત્ર કૉપિ થઈ ગયું છે, પેસ્ટ કરવા માટે તૈયાર છે, અને ચિત્રો, Screenshotsમાં "
"સાચવેલું છે."

msgid ""
"The power button in that menu has Suspend, Restart, Power Off and Log Out."
msgstr ""
"તે મેનૂમાંના પાવર બટનમાં Suspend (અટકાવો), Restart (પુન:શરૂ કરો), Power Off "
"(પાવર બંધ) અને Log Out (બહાર નીકળો) છે."

#, python-brace-format
msgid "The printer driver {title} is ready."
msgstr "પ્રિન્ટર ડ્રાઇવર {title} તૈયાર છે."

#, python-brace-format
msgid ""
"The printer driver {title} is ready.\n"
"\n"
"Open Printers: choose Add Printer, then your printer."
msgstr ""
"પ્રિન્ટર ડ્રાઇવર {title} તૈયાર છે.\n"
"\n"
"પ્રિન્ટરો ખોલો: \"Add Printer\" (પ્રિન્ટરને ઉમેરો) પસંદ કરો, પછી તમારું પ્રિન્ટર."

msgid "The printing service fails to start."
msgstr "પ્રિન્ટિંગ સર્વિસ શરૂ થતી નથી."

msgid "The restart didn't start"
msgstr "રીસ્ટાર્ટ શરૂ થયું નહીં"

#, python-brace-format
msgid ""
"The restart said:\n"
"\n"
"{message}\n"
"\n"
"Exit code: {code}"
msgstr ""
"રીસ્ટાર્ટે આ જણાવ્યું:\n"
"\n"
"{message}\n"
"\n"
"એક્ઝિટ કોડ: {code}"

msgid ""
"The root account is the system's own administrator. Most people never need "
"it: your own account can be an administrator instead."
msgstr ""
"રૂટ એકાઉન્ટ સિસ્ટમનો પોતાનો એડમિનિસ્ટ્રેટર છે. મોટા ભાગના લોકોને તેની ક્યારેય"
" જરૂર પડતી નથી: તેના બદલે તમારું પોતાનું એકાઉન્ટ એડમિનિસ્ટ્રેટર બની શકે છે."

msgid "The root password could not be set."
msgstr "રૂટ પાસવર્ડ સેટ કરી શકાયો નહીં."

msgid "The screen flashes white, often with an outside display"
msgstr "સ્ક્રીન સફેદ ઝબકે છે, ઘણી વાર બહારના ડિસ્પ્લે સાથે"

msgid ""
"The settings are deleted, but the computer didn't restart. Restart it now: "
"the next start puts them back."
msgstr ""
"સેટિંગ્સ કાઢી નાખવામાં આવી છે, પરંતુ કમ્પ્યુટર રીસ્ટાર્ટ થયું નહીં. હમણાં "
"તેને રીસ્ટાર્ટ કરો: આગલી શરૂઆત તેમને પાછી મૂકે છે."

msgid "The settings repair test didn't work."
msgstr "સેટિંગ્સ રિપેર ટેસ્ટ સફળ ન થયો."

#, python-brace-format
msgid ""
"The settings repair test didn't work: your computer couldn't put the deleted settings back, so it went back to the version from {since}, which has its own settings. Your files and apps aren't touched, and automatic updates aren't paused.\n"
"\n"
"Tell your helper. Save problem details in Wheelhouse makes a file to send them."
msgstr ""
"સેટિંગ્સ રિપેર ટેસ્ટ સફળ ન થયો: તમારું કમ્પ્યુટર કાઢી નાખેલી સેટિંગ્સ પાછી મૂકી શક્યું નહીં, તેથી તે {since}ના વર્ઝન પર પાછું ગયું, જેની પોતાની સેટિંગ્સ છે. તમારી ફાઇલો અને ઍપ્સને કંઈ થતું નથી, અને સ્વચાલિત અપડેટ્સ થોભાવવામાં આવ્યાં નથી.\n"
"\n"
"તમારા મદદગારને જણાવો. Wheelhouseમાં \"સમસ્યાની વિગતો સાચવો\" તેમને મોકલવા માટે એક ફાઇલ બનાવે છે."

msgid "The settings repair test worked."
msgstr "સેટિંગ્સ રિપેર ટેસ્ટ સફળ રહ્યો."

msgid "The sound chip's driver is blocked, so there's no sound."
msgstr "સાઉન્ડ ચિપનો ડ્રાઇવર બ્લોક થયેલ છે, તેથી સાઉન્ડ નથી."

msgid ""
"The start menu, windows, the menu at the end of the bar, notifications, "
"screenshots and shortcuts"
msgstr ""
"સ્ટાર્ટ મેનૂ, વિન્ડો, બારના છેડેનું મેનૂ, સૂચનાઓ, સ્ક્રીનશૉટ અને શૉર્ટકટ્સ"

msgid "The sun doesn't set or rise here today, so it's dark until it rises."
msgstr ""
"આજે અહીં સૂર્ય આથમતો કે ઊગતો નથી, તેથી સૂર્ય ઊગે ત્યાં સુધી ડાર્ક રહે છે."

msgid "The sun doesn't set or rise here today, so it's light until it sets."
msgstr ""
"આજે અહીં સૂર્ય આથમતો કે ઊગતો નથી, તેથી સૂર્ય આથમે ત્યાં સુધી લાઇટ રહે છે."

msgid "The system core crashed (a protection fault)"
msgstr "સિસ્ટમ કોર ક્રેશ થયો (protection fault)"

msgid "The system core crashed (an oops)"
msgstr "સિસ્ટમ કોર ક્રેશ થયો (oops)"

msgid "The system core reported a bug"
msgstr "સિસ્ટમ કોરે બગની જાણ કરી"

msgid ""
"The system itself can't be changed by apps or by mistake. Each update "
"replaces it whole."
msgstr ""
"સિસ્ટમ પોતે ઍપ્સ દ્વારા કે ભૂલથી બદલી શકાતી નથી. દરેક અપડેટ તેને આખેઆખી બદલી "
"નાખે છે."

#, python-brace-format
msgid "The test copy ({name}) is ready. It starts at your next restart."
msgstr "ટેસ્ટ કૉપિ ({name}) તૈયાર છે. તે તમારા આગામી રીસ્ટાર્ટ વખતે શરૂ થશે."

msgid ""
"The test marker is removed. The version without it starts at your next "
"restart."
msgstr ""
"ટેસ્ટ માર્કર દૂર કરવામાં આવ્યો છે. તેના વિનાનું વર્ઝન તમારા આગામી રીસ્ટાર્ટ "
"વખતે શરૂ થશે."

#, python-brace-format
msgid ""
"The test worked. At the next start your computer found important settings missing, put back {n} setting from the copy it saved {saved}, and restarted by itself.\n"
"\n"
"Put back: {what}."
msgid_plural ""
"The test worked. At the next start your computer found important settings missing, put back {n} settings from the copy it saved {saved}, and restarted by itself.\n"
"\n"
"Put back: {what}."
msgstr[0] ""
"ટેસ્ટ સફળ રહ્યો. આગલી શરૂઆતમાં તમારા કમ્પ્યુટરને મહત્વની સેટિંગ્સ ખૂટતી મળી, તેણે {saved} સાચવેલી કૉપિમાંથી {n} સેટિંગ પાછી મૂકી, અને પોતે જ રીસ્ટાર્ટ થયું.\n"
"\n"
"પાછું મૂક્યું: {what}."
msgstr[1] ""
"ટેસ્ટ સફળ રહ્યો. આગલી શરૂઆતમાં તમારા કમ્પ્યુટરને મહત્વની સેટિંગ્સ ખૂટતી મળી, તેણે {saved} સાચવેલી કૉપિમાંથી {n} સેટિંગ્સ પાછી મૂકી, અને પોતે જ રીસ્ટાર્ટ થયું.\n"
"\n"
"પાછું મૂક્યું: {what}."

#, python-brace-format
msgid ""
"The test worked. Your computer went back by itself to the version from "
"{since}, and the test copy is removed."
msgstr ""
"ટેસ્ટ સફળ રહ્યો. તમારું કમ્પ્યુટર પોતે જ {since}ના વર્ઝન પર પાછું ગયું, અને "
"ટેસ્ટ કૉપિ દૂર કરવામાં આવી છે."

#, python-brace-format
msgid "The touchpad ({device})"
msgstr "ટચપેડ ({device})"

msgid "The two don't match yet."
msgstr "બંને હજી મેળ ખાતા નથી."

msgid "The update did not finish. Details: journalctl -u %s"
msgstr "અપડેટ પૂર્ણ થયું નથી. વિગતો: journalctl -u %s"

msgid "The update didn't finish."
msgstr "અપડેટ પૂર્ણ થયું નથી."

msgid ""
"The update didn't finish. Nothing is broken: your computer keeps running the "
"version it has.\\n\\nTry again later."
msgstr ""
"અપડેટ પૂર્ણ થયું નથી. કંઈ ખરાબ થયું નથી: તમારું કમ્પ્યુટર હાલનું વર્ઝન જ "
"ચલાવતું રહે છે.\\n\\nથોડી વાર પછી ફરી પ્રયાસ કરો."

msgid "The update program"
msgstr "અપડેટ પ્રોગ્રામ"

msgid ""
"The update program is swapped for one that always fails (until the next "
"restart; nothing on the disk changes)."
msgstr ""
"અપડેટ પ્રોગ્રામને એવા પ્રોગ્રામથી બદલવામાં આવે છે જે હંમેશાં નિષ્ફળ જાય છે "
"(આગામી રીસ્ટાર્ટ સુધી; ડિસ્ક પર કંઈ બદલાતું નથી)."

msgid "The user name is empty."
msgstr "વપરાશકર્તા નામ ખાલી છે."

#, python-brace-format
msgid ""
"The version you're using now is from {current}. The one from before it, from {older}, is still on this computer.\n"
"\n"
"If something stopped working after the last update: Undo the update. The version from {older} starts at your next restart. Your files and your apps aren't touched."
msgstr ""
"તમે હમણાં જે વર્ઝન વાપરો છો તે {current}નું છે. તેની પહેલાંનું, {older}નું વર્ઝન, હજી પણ આ કમ્પ્યુટર પર છે.\n"
"\n"
"જો છેલ્લા અપડેટ પછી કંઈક કામ કરતું બંધ થયું હોય: અપડેટ પૂર્વવત્ કરો. {older}નું વર્ઝન તમારા આગામી રીસ્ટાર્ટ વખતે શરૂ થશે. તમારી ફાઇલો અને તમારી ઍપ્સને કંઈ થતું નથી."

msgid ""
"The version you're using now is the one before it with boot options changed in Wheelhouse.\n"
"\n"
"Undo the change: the computer starts with the boot options it had before, at your next restart. Automatic updates aren't paused.\n"
"\n"
"Or Cancel."
msgstr ""
"તમે હમણાં જે વર્ઝન વાપરો છો તે પહેલાંનું જ વર્ઝન છે, Wheelhouseમાં બદલેલા બૂટ વિકલ્પો સાથે.\n"
"\n"
"ફેરફાર પૂર્વવત્ કરો: તમારા આગામી રીસ્ટાર્ટ વખતે કમ્પ્યુટર પહેલાંના બૂટ વિકલ્પો સાથે શરૂ થાય છે. સ્વચાલિત અપડેટ્સ થોભાવવામાં આવતાં નથી.\n"
"\n"
"અથવા રદ કરો."

msgid "The wallpaper changes to the next picture in a folder of yours."
msgstr "વોલપેપર તમારા એક ફોલ્ડરમાંના આગલા ચિત્ર પર બદલાય છે."

#, python-brace-format
msgid ""
"The {fs} file system could not be loaded, so the disk can't be prepared."
msgstr "{fs} ફાઇલ સિસ્ટમ લોડ થઈ શકી નહીં, તેથી ડિસ્ક તૈયાર કરી શકાતી નથી."

#, python-brace-format
msgid "The {label} is deleted."
msgstr "{label} કાઢી નાખવામાં આવ્યું છે."

#, python-brace-format
msgid "The {label} is not working."
msgstr "{label} કામ કરતું નથી."

#, python-brace-format
msgid "The {label} is repaired."
msgstr "{label} રિપેર થઈ ગયું છે."

#, python-brace-format
msgid ""
"The {label} isn't working.\n"
"\n"
"Recommended: Repair the box. It rebuilds the box, puts your apps back, then installs {title}. Your files aren't touched."
msgstr ""
"{label} કામ કરતું નથી.\n"
"\n"
"ભલામણ: બોક્સ રિપેર કરો. તે બોક્સને ફરીથી બનાવે છે, તમારી ઍપ્સ પાછી મૂકે છે, પછી {title} ઇન્સ્ટોલ કરે છે. તમારી ફાઇલોને કંઈ થતું નથી."

#, python-brace-format
msgid "The {name} ({unit})"
msgstr "{name} ({unit})"

#, python-brace-format
msgid "The {name} graphics drive the screen."
msgstr "{name} ગ્રાફિક્સ સ્ક્રીનને ચલાવે છે."

#, python-brace-format
msgid "The {name} service ({unit})"
msgstr "{name} સર્વિસ ({unit})"

#, python-brace-format
msgid "The {title} download isn't signed by ArtCraft, so it was not installed."
msgstr ""
"{title}નું ડાઉનલોડ ArtCraft દ્વારા સહી કરેલું નથી, તેથી તેને ઇન્સ્ટોલ કરવામાં"
" આવ્યું નથી."

msgid "There are no app boxes to repair."
msgstr "રિપેર કરવા માટે કોઈ ઍપ બોક્સ નથી."

#, python-brace-format
msgid "There is no start-up keyboard layout for {layout}."
msgstr "{layout} માટે કોઈ સ્ટાર્ટ-અપ કીબોર્ડ લેઆઉટ નથી."

msgid ""
"There's no earlier version on this computer to go back to. Only the version "
"you're using now is kept."
msgstr ""
"આ કમ્પ્યુટર પર પાછા જવા માટે કોઈ પહેલાંનું વર્ઝન નથી. ફક્ત તમે હમણાં વાપરો છો"
" તે વર્ઝન જ રાખવામાં આવે છે."

msgid ""
"There's no earlier version to fall back to if putting the settings back "
"doesn't work, so the test doesn't run. Try it after the next update."
msgstr ""
"જો સેટિંગ્સ પાછી મૂકવાથી કામ ન થાય તો પાછા જવા માટે કોઈ પહેલાંનું વર્ઝન નથી, "
"તેથી ટેસ્ટ ચાલતો નથી. આગામી અપડેટ પછી પ્રયાસ કરો."

msgid "These security certificates need attention. Pick one to see what to do."
msgstr ""
"આ સુરક્ષા પ્રમાણપત્રો પર ધ્યાન આપવાની જરૂર છે. શું કરવું તે જોવા માટે એક પસંદ"
" કરો."

msgid "They open in Chrome."
msgstr "તેઓ Chromeમાં ખૂલે છે."

msgid "They open in your usual browser. Choose to be asked about Chrome again."
msgstr ""
"તેઓ તમારા સામાન્ય બ્રાઉઝરમાં ખૂલે છે. Chrome વિશે ફરીથી પૂછવામાં આવે તેવું "
"પસંદ કરો."

msgid "This account can't share folders."
msgstr "આ એકાઉન્ટ ફોલ્ડર્સ શેર કરી શકતું નથી."

msgid ""
"This computer asks for the disk password every time it starts. The computer's security chip can unlock the disk instead.\n"
"\n"
"This needs the disk password, so it's one for your helper.\n"
"\n"
"Recommended: Set it up. Or Skip: it's in Wheelhouse any time."
msgstr ""
"આ કમ્પ્યુટર શરૂ થાય ત્યારે દર વખતે ડિસ્ક પાસવર્ડ માંગે છે. તેના બદલે કમ્પ્યુટરની સુરક્ષા ચિપ ડિસ્ક અનલૉક કરી શકે છે.\n"
"\n"
"આ માટે ડિસ્ક પાસવર્ડ જોઈએ છે, તેથી આ કામ તમારા મદદગાર માટે છે.\n"
"\n"
"ભલામણ: તેને સેટ કરો. અથવા છોડો: તે ગમે ત્યારે Wheelhouseમાં છે."

msgid ""
"This computer can't go back by itself: it was installed before automatic "
"rollback was added, or automatic rollback was switched off. Computers "
"installed from a newer USB have it."
msgstr ""
"આ કમ્પ્યુટર પોતે જ પાછું જઈ શકતું નથી: તે સ્વચાલિત રોલબેક ઉમેરાયું તે પહેલાં "
"ઇન્સ્ટોલ થયું હતું, અથવા સ્વચાલિત રોલબેક બંધ કરવામાં આવ્યું હતું. નવી "
"USBમાંથી ઇન્સ્ટોલ કરેલાં કમ્પ્યુટર્સમાં તે હોય છે."

msgid ""
"This computer can't open its BIOS settings from here. Press the BIOS key "
"while it starts (often F2, F10, F12 or Delete)."
msgstr ""
"આ કમ્પ્યુટર અહીંથી તેની BIOS સેટિંગ્સ ખોલી શકતું નથી. જ્યારે તે શરૂ થતું હોય "
"ત્યારે BIOS કી દબાવો (ઘણી વાર F2, F10, F12 અથવા Delete)."

msgid ""
"This computer has no security chip (TPM) that can do this, so the disk "
"password stays."
msgstr ""
"આ કમ્પ્યુટરમાં આ કામ કરી શકે તેવી કોઈ સુરક્ષા ચિપ (TPM) નથી, તેથી ડિસ્ક "
"પાસવર્ડ રહે છે."

#, python-brace-format
msgid ""
"This computer is running a test copy ({name}) as its normal version, so a new test can't start from it.\n"
"\n"
"Recommended: Remove the test marker. The version without it starts at your next restart. Needs your password."
msgstr ""
"આ કમ્પ્યુટર તેના સામાન્ય વર્ઝન તરીકે ટેસ્ટ કૉપિ ({name}) ચલાવી રહ્યું છે, તેથી તેમાંથી નવો ટેસ્ટ શરૂ થઈ શકતો નથી.\n"
"\n"
"ભલામણ: ટેસ્ટ માર્કર દૂર કરો. તેના વિનાનું વર્ઝન તમારા આગામી રીસ્ટાર્ટ વખતે શરૂ થશે. તમારો પાસવર્ડ જરૂરી છે."

msgid ""
"This computer is running a test copy. Open Test automatic rollback again to "
"remove its marker."
msgstr ""
"આ કમ્પ્યુટર ટેસ્ટ કૉપિ ચલાવી રહ્યું છે. તેનો માર્કર દૂર કરવા માટે \"સ્વચાલિત "
"રોલબેક ટેસ્ટ કરો\" ફરીથી ખોલો."

msgid "This computer started the USB stick in old BIOS (legacy) mode."
msgstr "આ કમ્પ્યુટરે USB સ્ટિકને જૂના BIOS (legacy) મોડમાં શરૂ કરી છે."

#, python-brace-format
msgid ""
"This desktop uses {now}.\n"
"\n"
"Switch to {new}? It takes effect after you log out and back in.\n"
"\n"
"Or Keep it."
msgstr ""
"આ ડેસ્કટૉપ {now} વાપરે છે.\n"
"\n"
"{new} પર બદલવું છે? તમે લૉગ આઉટ કરીને ફરીથી લૉગ ઇન કરો પછી તે લાગુ થાય છે.\n"
"\n"
"અથવા તેને રાખો."

#, python-brace-format
msgid ""
"This file can't be installed. It may be damaged or not fully downloaded. Download it again and retry.\n"
"\n"
"(Details: {details})"
msgstr ""
"આ ફાઇલ ઇન્સ્ટોલ કરી શકાતી નથી. તે કદાચ ખરાબ થયેલી હોય અથવા પૂરી ડાઉનલોડ ન થઈ હોય. તેને ફરીથી ડાઉનલોડ કરો અને ફરી પ્રયાસ કરો.\n"
"\n"
"(વિગતો: {details})"

#, python-brace-format
msgid ""
"This file is an older version of {title} than the one you have.\n"
"\n"
"Install the older version: replaces yours. Only do this if the newer one has a problem."
msgstr ""
"આ ફાઇલ તમારી પાસેના {title} કરતાં જૂનું વર્ઝન છે.\n"
"\n"
"જૂનું વર્ઝન ઇન્સ્ટોલ કરો: તમારા વર્ઝનને બદલે છે. નવા વર્ઝનમાં સમસ્યા હોય તો જ આ કરો."

msgid ""
"This is a live session: it runs from the USB stick, nothing here is saved, "
"and the computer's disk isn't touched."
msgstr ""
"આ લાઇવ સત્ર છે: તે USB સ્ટિક પરથી ચાલે છે, અહીં કંઈ સચવાતું નથી, અને "
"કમ્પ્યુટરની ડિસ્કને કંઈ થતું નથી."

msgid ""
"This is how the computer shows up on your network. Keep the suggestion, or "
"type a new one."
msgstr ""
"તમારું કમ્પ્યુટર તમારા નેટવર્ક પર આ નામે દેખાય છે. સૂચન રાખો, અથવા નવું લખો."

#, python-brace-format
msgid ""
"This is the 32-bit version of {title}, for older computers. Download the "
"64-bit version instead (often called amd64 or x86_64)."
msgstr ""
"આ {title}નું 32-બીટ વર્ઝન છે, જે જૂના કમ્પ્યુટર્સ માટે છે. તેના બદલે 64-બીટ "
"વર્ઝન ડાઉનલોડ કરો (જેને ઘણી વાર amd64 અથવા x86_64 કહેવામાં આવે છે)."

msgid "This network"
msgstr "આ નેટવર્ક"

msgid ""
"This removes things the computer no longer needs: unused app parts, old "
"system update files, and unused container images. Your files and your apps "
"aren't touched."
msgstr ""
"આ એવી વસ્તુઓ દૂર કરે છે જેની કમ્પ્યુટરને હવે જરૂર નથી: ન વપરાતા ઍપના ભાગો, "
"જૂની સિસ્ટમ અપડેટ ફાઇલો, અને ન વપરાતી કન્ટેનર ઇમેજો. તમારી ફાઇલો અને તમારી "
"ઍપ્સને કંઈ થતું નથી."

#, python-brace-format
msgid ""
"This saves the computer's recent error messages, its system version and the list of your apps to one file, {name}, in your Documents folder. What your apps showed or opened isn't in it.\n"
"\n"
"Then email that file to your helper. They can see what went wrong without being here.\n"
"\n"
"Nothing is sent anywhere by itself."
msgstr ""
"આ કમ્પ્યુટરના તાજેતરના ભૂલ સંદેશા, તેનું સિસ્ટમ વર્ઝન અને તમારી ઍપ્સની યાદી એક ફાઇલ, {name}, માં તમારા દસ્તાવેજો ફોલ્ડરમાં સાચવે છે. તમારી ઍપ્સે જે બતાવ્યું કે ખોલ્યું તે તેમાં નથી.\n"
"\n"
"પછી તે ફાઇલ તમારા મદદગારને ઇમેઇલ કરો. તેઓ અહીં આવ્યા વિના જોઈ શકે છે કે શું ખોટું થયું.\n"
"\n"
"કંઈ પણ પોતાની જાતે ક્યાંય મોકલવામાં આવતું નથી."

msgid ""
"This sets what other devices on this network can reach. Pick Public place "
"anywhere you're not sure. You can change it later in Wheelhouse, Network "
"safety."
msgstr ""
"આ નક્કી કરે છે કે આ નેટવર્ક પરનાં અન્ય ઉપકરણો શેના સુધી પહોંચી શકે. જ્યાં "
"ખાતરી ન હોય ત્યાં જાહેર સ્થળ પસંદ કરો. તમે તેને પછીથી Wheelhouse, નેટવર્ક "
"સુરક્ષામાં બદલી શકો છો."

msgid ""
"This sets what you see at first. The next step suggests a desktop layout to "
"match, and the guide is in Wheelhouse, Get help, either way."
msgstr ""
"આ નક્કી કરે છે કે તમને શરૂઆતમાં શું દેખાય. આગલું પગલું તેને અનુરૂપ ડેસ્કટૉપ "
"લેઆઉટ સૂચવે છે, અને બંને કિસ્સામાં માર્ગદર્શિકા Wheelhouse, મદદ મેળવોમાં છે."

msgid "This setting is risky"
msgstr "આ સેટિંગ જોખમી છે"

msgid "This start found these broken, as the test expects:"
msgstr "ટેસ્ટની અપેક્ષા મુજબ, આ શરૂઆતમાં આ ખરાબ મળ્યાં:"

msgid "This start found these still broken, as the test expects:"
msgstr "ટેસ્ટની અપેક્ષા મુજબ, આ શરૂઆતમાં આ હજી પણ ખરાબ મળ્યાં:"

msgid "This system's EFI partition: %s (disk %s, partition %s)"
msgstr "આ સિસ્ટમનું EFI પાર્ટીશન: %s (ડિસ્ક %s, પાર્ટીશન %s)"

msgid "This takes a while."
msgstr "આમાં થોડો સમય લાગશે."

#, python-brace-format
msgid "This version is from {when}."
msgstr "આ વર્ઝન {when}નું છે."

#, python-brace-format
msgid ""
"This {title} file is for a different kind of computer. Download the version "
"for this one (often called {names})."
msgstr ""
"આ {title} ફાઇલ અલગ પ્રકારના કમ્પ્યુટર માટે છે. આ કમ્પ્યુટર માટેનું વર્ઝન "
"ડાઉનલોડ કરો (જેને ઘણી વાર {names} કહેવાય છે)."

msgid ""
"Those are file sharing ports: folders are shared only on Home networks, in "
"Shared folders."
msgstr ""
"આ ફાઇલ શેરિંગ પોર્ટ્સ છે: ફોલ્ડર્સ ફક્ત ઘર નેટવર્ક્સ પર, \"શેર કરેલાં "
"ફોલ્ડર્સ\"માં જ શેર થાય છે."

msgid "Thunderbolt or USB4 ports"
msgstr "Thunderbolt અથવા USB4 પોર્ટ્સ"

msgid "Time server name"
msgstr "સમય સર્વરનું નામ"

msgid "Time servers"
msgstr "સમય સર્વરો"

msgid ""
"Time servers to use instead of Fedora's. Type a name and click Add. Click a "
"server to take it off. Click Back when done."
msgstr ""
"Fedoraના બદલે વાપરવાના સમય સર્વરો. નામ લખો અને \"ઉમેરો\" પર ક્લિક કરો. સર્વર "
"કાઢવા માટે તેના પર ક્લિક કરો. પૂરું થાય ત્યારે \"પાછળ\" પર ક્લિક કરો."

msgid "Time zone"
msgstr "સમય ઝોન"

msgid "To be asked again: Wheelhouse, Apps, Zoom meetings."
msgstr "ફરીથી પૂછાય તે માટે: Wheelhouse, ઍપ્સ, Zoom મીટિંગ્સ."

msgid "To change your password, click Password."
msgstr "તમારો પાસવર્ડ બદલવા માટે, \"પાસવર્ડ\" પર ક્લિક કરો."

msgid "To check that this works on your computer, see Getting help."
msgstr "આ તમારા કમ્પ્યુટર પર કામ કરે છે કે કેમ તે તપાસવા માટે, \"મદદ મેળવવી\" જુઓ."

msgid "To choose which apps can notify you: Settings, Notifications."
msgstr "કઈ ઍપ્સ તમને સૂચનાઓ મોકલી શકે તે પસંદ કરવા માટે: સુયોજનો, સૂચનાઓ."

msgid "To free the space for good: open Trash and click Empty."
msgstr "જગ્યા કાયમ માટે ખાલી કરવા: કચરાપેટી ખોલો અને \"ખાલી\" પર ક્લિક કરો."

msgid ""
"To get it back: open Trash in the left side of Files, right-click the file, "
"and choose Restore From Trash."
msgstr ""
"તેને પાછી મેળવવા: ફાઇલોની ડાબી બાજુએ કચરાપેટી ખોલો, ફાઇલ પર જમણું ક્લિક કરો, "
"અને \"Restore From Trash\" પસંદ કરો."

msgid ""
"To give someone their own account, click Add User. Leave Administrator off "
"for children and guests."
msgstr ""
"કોઈને પોતાનું એકાઉન્ટ આપવા માટે, \"Add User\" (વપરાશકર્તાને ઉમેરો) પર ક્લિક "
"કરો. બાળકો અને મહેમાનો માટે \"Administrator\" (વહીવટકર્તા) બંધ રાખો."

msgid "To go on, click Erase and install. To pick another disk, click Back."
msgstr ""
"આગળ વધવા માટે, \"ભૂંસી નાખો અને ઇન્સ્ટોલ કરો\" પર ક્લિક કરો. બીજી ડિસ્ક પસંદ "
"કરવા માટે, \"પાછળ\" પર ક્લિક કરો."

msgid ""
"To make one: select the files, right-click, choose Compress, give it a name, "
"and click Create."
msgstr ""
"બનાવવા માટે: ફાઇલો પસંદ કરો, જમણું ક્લિક કરો, \"Compress…\" પસંદ કરો, તેને "
"નામ આપો, અને \"Create\" પર ક્લિક કરો."

msgid ""
"To open one: right-click it and choose Extract. The files go in a folder next"
" to it."
msgstr ""
"ખોલવા માટે: તેના પર જમણું ક્લિક કરો અને \"Extract\" પસંદ કરો. ફાઇલો તેની "
"બાજુના ફોલ્ડરમાં જાય છે."

msgid "To print, press Ctrl+P in any app."
msgstr "પ્રિન્ટ કરવા માટે, કોઈપણ ઍપમાં Ctrl+P દબાવો."

msgid ""
"To record a video instead, click the video camera icon in the same tool "
"before you start. Recordings go to Videos, Screencasts."
msgstr ""
"તેના બદલે વિડિયો રેકોર્ડ કરવા માટે, શરૂ કરતાં પહેલાં તે જ સાધનમાં વિડિયો "
"કેમેરાના આઇકન પર ક્લિક કરો. રેકોર્ડિંગ્સ વિડિયો, Screencastsમાં જાય છે."

msgid "To update now: open Wheelhouse, Updates, System Update."
msgstr "હમણાં અપડેટ કરવા માટે: Wheelhouse, અપડેટ્સ, સિસ્ટમ અપડેટ ખોલો."

msgid ""
"Told to add a setting by a helper? Type it under Your own settings. Risky "
"ones are explained first."
msgstr ""
"મદદગારે કોઈ સેટિંગ ઉમેરવાનું કહ્યું છે? તેને \"તમારી પોતાની સેટિંગ્સ\" હેઠળ "
"લખો. જોખમી સેટિંગ્સ પહેલાં સમજાવવામાં આવે છે."

msgid "Too weak"
msgstr "ખૂબ નબળું"

msgid "Tool"
msgstr "સાધન"

msgid "Top bar, apps from the bottom dock"
msgstr "ટોચનો બાર, નીચેના ડૉકમાંથી ઍપ્સ"

msgid "Touchpad"
msgstr "ટચપેડ"

msgid "Touchpad found."
msgstr "ટચપેડ મળ્યું."

