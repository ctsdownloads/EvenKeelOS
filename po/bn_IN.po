msgstr "Zoom মিটিং Chrome-এ খুলুন, Zoom-এর ওয়েব সংস্করণে"

#. Translators: a change in an update, listed under What is new
msgid "Stop ArtCraft installs from breaking Flathub installs"
msgstr "ArtCraft ইনস্টলকে Flathub ইনস্টল নষ্ট করা থেকে আটকান"

#. Translators: a change in an update, listed under What is new
msgid "Recognize installers by their usual file name"
msgstr "প্রচলিত ফাইলের নাম দেখে ইনস্টলার শনাক্ত করুন"

#. Translators: a change in an update, listed under What is new
msgid "Offer Linux replacements for Windows programs"
msgstr "Windows প্রোগ্রামের বদলে Linux বিকল্প দেখান"

#. Translators: a change in an update, listed under What is new
msgid "Fix box setup: distrobox mounts read-only folders wrong"
msgstr "বক্স সেটআপ ঠিক করুন: distrobox শুধু-পঠনযোগ্য ফোল্ডার ভুলভাবে মাউন্ট করে"

#. Translators: a change in an update, listed under What is new
msgid "Offer Fedora or Ubuntu versions of Windows programs"
msgstr "Windows প্রোগ্রামের Fedora বা Ubuntu সংস্করণ দেখান"

#. Translators: a change in an update, listed under What is new
msgid "Offer the Linux version when a Windows program is opened"
msgstr "Windows প্রোগ্রাম খোলা হলে Linux সংস্করণ দেখান"

#. Translators: a change in an update, listed under What is new
msgid "Ship one shim, so firmware adds no extra Fedora entry"
msgstr "একটিমাত্র shim দিন, যাতে ফার্মওয়্যার বাড়তি Fedora এন্ট্রি যোগ না করে"

#. Translators: a change in an update, listed under What is new
msgid "Put Fedora's firewall zone back"
msgstr "Fedora-র ফায়ারওয়াল জোন ফিরিয়ে আনুন"

#. Translators: a change in an update, listed under What is new
msgid "Harden root helpers, firewall and no-password updates"
msgstr "root সহায়ক, ফায়ারওয়াল এবং পাসওয়ার্ড ছাড়া আপডেট আরও সুরক্ষিত করুন"

#. Translators: a change in an update, listed under What is new
msgid "New defaults: wallpapers, accent folders, lock screen"
msgstr "নতুন ডিফল্ট: ওয়ালপেপার, অ্যাকসেন্ট ফোল্ডার, লক স্ক্রিন"

#. Translators: a change in an update, listed under What is new
msgid "New default: teal accent color, also on the login screen"
msgstr "নতুন ডিফল্ট: টিল অ্যাকসেন্ট রং, লগইন স্ক্রিনেও"

#. Translators: a change in an update, listed under What is new
msgid "Fix rollback note, login-loop and stuck tests"
msgstr "রোলব্যাকের নোট, লগইন লুপ এবং আটকে থাকা পরীক্ষা ঠিক করুন"

#. Translators: a change in an update, listed under What is new
msgid "Fix freeze rollback and cut retries to 2"
msgstr "ফ্রিজের সময় রোলব্যাক ঠিক করুন এবং পুনরায় চেষ্টা ২-এ কমান"

#. Translators: a change in an update, listed under What is new
msgid "Fix the automatic rollback tests"
msgstr "স্বয়ংক্রিয় রোলব্যাকের পরীক্ষা ঠিক করুন"

#. Translators: a change in an update, listed under What is new
msgid "Real failure tests for automatic rollback"
msgstr "স্বয়ংক্রিয় রোলব্যাকের জন্য আসল ব্যর্থতার পরীক্ষা"

#. Translators: a change in an update, listed under What is new
msgid "Add automatic rollback with greenboot"
msgstr "greenboot দিয়ে স্বয়ংক্রিয় রোলব্যাক যোগ করুন"

#. Translators: a change in an update, listed under What is new
msgid "Start the Windows layout on the desktop, plus small fixes"
msgstr "ডেস্কটপে Windows লেআউট চালু করুন, সঙ্গে ছোট সমাধান"

#. Translators: a change in an update, listed under What is new
msgid "Pause automatic updates for 3 days after an undo"
msgstr "পূর্বাবস্থায় ফেরানোর পর ৩ দিন স্বয়ংক্রিয় আপডেট বিরতিতে রাখুন"

#. Translators: a change in an update, listed under What is new
msgid "Add a Desktop layout step to the installer"
msgstr "ইনস্টলারে ডেস্কটপ লেআউট ধাপ যোগ করুন"

#. Translators: a change in an update, listed under What is new
msgid "Add Desktop layout to System Tools"
msgstr "সিস্টেম টুলসে ডেস্কটপ লেআউট যোগ করুন"

#. Translators: a change in an update, listed under What is new
msgid "Keep power-mode switches from waiting on updates"
msgstr "পাওয়ার মোড বদলানো যাতে আপডেটের জন্য অপেক্ষা না করে তা নিশ্চিত করুন"

#. Translators: a change in an update, listed under What is new
msgid "Add an optional Windows-style layout"
msgstr "ঐচ্ছিক Windows-ধাঁচের লেআউট যোগ করুন"

#. Translators: a change in an update, listed under What is new
msgid "Fix Fedora 45 presets and container policy paths"
msgstr "Fedora 45-এর প্রিসেট এবং কনটেইনার নীতির পাথ ঠিক করুন"

#. Translators: a change in an update, listed under What is new
msgid "Read download sources in Fedora 45's new folder"
msgstr "Fedora 45-এর নতুন ফোল্ডারে ডাউনলোড সোর্স পড়ুন"

#. Translators: a change in an update, listed under What is new
msgid "Move to Fedora 45"
msgstr "Fedora 45-এ যান"

msgid "Fonts and text size are back to EvenKeelOS's own."
msgstr "ফন্ট এবং টেক্সটের সাইজ EvenKeelOS-এর নিজস্ব অবস্থায় ফিরে এসেছে।"

#, python-brace-format
msgid "Recommended: Delete the box. It comes back by itself the next time you install {apps}. Anything added to the box another way is deleted too. Your files are not touched."
msgstr "পরামর্শ: বক্সটি মুছে ফেলুন। পরের বার আপনি {apps} ইনস্টল করলে এটি নিজে থেকেই ফিরে আসে। অন্যভাবে বক্সে যোগ করা যে কোনও কিছুও মুছে যাবে। আপনার ফাইলগুলিতে হাত দেওয়া হয় না।"

#, python-brace-format
msgid "Deleting it frees about {size}."
msgstr "এটি মুছলে প্রায় {size} জায়গা খালি হয়।"

msgid "Asks once whether a password Wi-Fi network is Home, Work or a Public place"
msgstr "একবার জিজ্ঞেস করে যে পাসওয়ার্ডযুক্ত Wi-Fi নেটওয়ার্কটি বাড়ি, কর্মস্থল নাকি পাবলিক স্থান"

#, python-brace-format
msgid "EvenKeelOS needs at least {gb} GB."
msgstr "EvenKeelOS-এর জন্য অন্তত {gb} GB প্রয়োজন।"

#, python-brace-format
msgid "EvenKeelOS works best with {gb} GB or more, so it may be slow."
msgstr "EvenKeelOS {gb} GB বা তার বেশি মেমরিতে সবচেয়ে ভালো চলে, তাই এটি ধীর হতে পারে।"

msgid "organizing and developing photos"
msgstr "ফটো সাজানো এবং উন্নত করা"

#, python-brace-format
msgid "{title} has no signing key for Fedora {version} yet."
msgstr "Fedora {version}-এর জন্য {title}-এর এখনও কোনো সাইনিং কী নেই।"

#, python-brace-format
msgid "{title} was not added, so its download source was taken out again."
msgstr "{title} যোগ করা হয়নি, তাই এর ডাউনলোড সোর্স আবার সরিয়ে দেওয়া হয়েছে।"

#, python-brace-format
msgid "{title} was not removed."
msgstr "{title} সরানো হয়নি।"
