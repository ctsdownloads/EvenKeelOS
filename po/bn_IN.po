msgstr ""
"{title} আগেই Fedora থেকে ইনস্টল করা আছে এবং আপ টু ডেট থাকে। আপনার এই ফাইলটি "
"দরকার নেই।"

#, python-brace-format
msgid "{title} is already installed from a .deb file."
msgstr "{title} ইতিমধ্যেই একটি .deb ফাইল থেকে ইনস্টল করা আছে।"

#, python-brace-format
msgid "{title} is already installed from an .rpm file."
msgstr "{title} ইতিমধ্যেই একটি .rpm ফাইল থেকে ইনস্টল করা আছে।"

#, python-brace-format
msgid ""
"{title} is already installed.\n"
"\n"
"Recommended: Open it.\n"
"\n"
"Or Reinstall: installs it again from this file. Only needed if it isn't working."
msgstr ""
"{title} আগেই ইনস্টল করা আছে।\n"
"\n"
