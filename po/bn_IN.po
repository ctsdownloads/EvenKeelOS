msgid "Close {name} again"
msgstr "{name} আবার বন্ধ করুন"

msgid "Code and terminal"
msgstr "কোড এবং টার্মিনাল"

msgid "Collecting the problem details."
msgstr "সমস্যার বিবরণ সংগ্রহ করা হচ্ছে।"

msgid "Colors and wallpaper"
msgstr "রঙ এবং ওয়ালপেপার"

msgid "Comes with the system"
msgstr "সিস্টেমের সঙ্গে দেওয়া থাকে"

msgid "Coming from Windows"
msgstr "Windows থেকে আসছেন"

msgid "Coming from Windows: where things are, and what's different"
msgstr "Windows থেকে আসছেন: জিনিসগুলি কোথায় থাকে, এবং কী কী আলাদা"

msgid "Coming from Windows?"
msgstr "Windows থেকে আসছেন?"

msgid "Common fixes"
msgstr "সাধারণ সমাধান"

msgid "Computer name"
msgstr "কম্পিউটারের নাম"

#, python-brace-format
msgid "Computer name: {name}."
msgstr "কম্পিউটারের নাম: {name}।"

msgid "Connect"
msgstr "সংযোগ করুন"

msgid "Connect a Bluetooth device"
msgstr "একটি ব্লুটুথ ডিভাইস কানেক্ট করুন"

#, python-brace-format
msgid "Connected to {network}."
msgstr "{network}-এর সাথে সংযুক্ত।"

#, python-brace-format
msgid "Connecting to {network}..."
msgstr "{network}-এর সঙ্গে কানেক্ট করা হচ্ছে..."

msgid ""
"Control Panel: Settings, for Wi-Fi, screens, sound, printers and accounts. "
"Wheelhouse, for updates, apps and fixes. A ship is steered from its "
"wheelhouse; this is where you steer your computer."
msgstr ""
"কন্ট্রোল প্যানেল: সেটিংস, Wi-Fi, স্ক্রিন, সাউন্ড, প্রিন্টার এবং অ্যাকাউন্টের "
"জন্য। Wheelhouse, আপডেট, অ্যাপ এবং সমাধানের জন্য। জাহাজ চালানো হয় তার "
"হুইলহাউস (চালকের কেবিন) থেকে; এখান থেকেই আপনি আপনার কম্পিউটার চালান।"

#, python-brace-format
msgid "Copied: {command}"
msgstr "কপি করা হয়েছে: {command}"

msgid "Copy files by dragging them onto it, or with Ctrl+C and Ctrl+V."
msgstr "ফাইলগুলি এটির উপর টেনে এনে, অথবা Ctrl+C ও Ctrl+V দিয়ে কপি করুন।"

msgid "Copy the command"
msgstr "কমান্ডটি কপি করুন"

#, python-brace-format
msgid "Copy {command}"
msgstr "{command} কপি করুন"

msgid "Copying EvenKeelOS to the disk"
msgstr "EvenKeelOS ডিস্কে কপি করা হচ্ছে"

msgid "Copying EvenKeelOS to the disk failed."
msgstr "EvenKeelOS ডিস্কে কপি করা যায়নি।"

#, python-brace-format
msgid "Could not connect to {network}. Check the password."
msgstr ""
"{network}-এর সঙ্গে সংযোগ করা যায়নি। পাসওয়ার্ডটি ঠিক আছে কি না দেখে নিন।"

msgid ""
"Couldn't check for firmware updates. Check your internet connection and try "
"again."
msgstr ""
"ফার্মওয়্যার আপডেট আছে কি না তা দেখা যায়নি। আপনার ইন্টারনেট সংযোগটি পরীক্ষা "
