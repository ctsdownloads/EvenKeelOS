msgid "Nothing updates until you run System Update."
msgstr "Ništa se ne ažurira dok ne pokrenete „Ažuriranje sistema“."

msgid "Notifications"
msgstr "Obaveštenja"

msgid "November"
msgstr "novembar"

msgid "OK"
msgstr "U redu"

