msgstr ""
"Otvorite Podešavanja, Ekrani, Noćno svetlo i uključite ga. Prati zalazak i "
"izlazak sunca, ili podesite svoja vremena."

msgid "Open Settings, Displays."
msgstr "Otvorite Podešavanja, Ekrani."

msgid "Open Settings, Printers, and click Add Printer."
msgstr "Otvorite Podešavanja, Štampači i kliknite na „Dodaj štampač“."

