msgstr "Otvori port na mestu „Kuća“"

msgid "Open a port on Work"
msgstr "Otvori port na mestu „Posao“"

msgid "Open a port on a Public place"
msgstr "Otvori port na javnom mestu"

msgid "Open an app"
msgstr "Otvori aplikaciju"

msgid "Open it"
msgstr "Otvori"

msgid "Open the computer's BIOS settings screen"
msgstr "Otvori ekran sa podešavanjima BIOS-a računara"

msgid "Open the computer's own settings screen"
msgstr "Otvori ekran sa sopstvenim podešavanjima računara"

msgid "Open the file again to install it."
msgstr "Ponovo otvorite datoteku da biste je instalirali."

msgid "Open the file, or drop it on Wheelhouse, Apps."
msgstr "Otvorite datoteku ili je ispustite na Wheelhouse, Aplikacije."

msgid "Open the file, or use Install a package file in Wheelhouse, Apps."
msgstr ""
"Otvorite datoteku ili upotrebite „Instaliraj datoteku paketa“ u Wheelhouse-u,"
" Aplikacije."

msgid ""
"Open this computer, type your user name and the sharing password, and the "
"folders are there."
msgstr ""
"Otvorite ovaj računar, unesite svoje korisničko ime i lozinku za deljenje, i "
"fascikle su tu."

