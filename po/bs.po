msgid "Install {name}"
msgstr "Instaliraj {name}"

#, python-brace-format
msgid "Install {title}"
msgstr "Instaliraj {title}"

#, python-brace-format
msgid ""
"Install {title}\n"
"\n"
"In a box, these parts of {title} won't work:\n"
"{notes}\n"
"A .deb file can't go on the system. For everything to work, look for {title} as an .rpm file or in Bazaar, the app store.\n"
"\n"
"{setup}: puts it in a box anyway, without those parts."
msgstr ""
"Instaliraj {title}\n"
"\n"
"U kutiji ovi dijelovi aplikacije {title} neće raditi:\n"
"{notes}\n"
"Datoteka .deb ne može ići na sistem. Da bi sve radilo, potražite {title} kao .rpm datoteku ili u Bazaaru, trgovini aplikacijama.\n"
"\n"
"{setup}: ipak je stavlja u kutiju, bez tih dijelova."

#, python-brace-format
msgid ""
"Install {title}\n"
"\n"
"It comes from {maker}'s own download source, which is added to the system so {title} keeps updating. Needs your password and a restart.\n"
"\n"
"To connect, you need a {maker} account."
msgstr ""
"Instaliraj {title}\n"
"\n"
"Dolazi iz vlastitog izvora za preuzimanje kompanije {maker}, koji se dodaje u sistem kako bi se {title} nastavio ažurirati. Potrebni su vaša lozinka i ponovno pokretanje.\n"
"\n"
"Za povezivanje vam je potreban račun kod {maker}."

#, python-brace-format
msgid ""
"Install {title}\n"
"\n"
"Recommended: Add to the system. In a box, these parts of {title} won't work:\n"
"{notes}\n"
"On the system, everything works. Needs your password and a restart.\n"
"\n"
"Or {setup}: puts it in a separate box. It's easier to remove, but those parts won't work."
msgstr ""
"Instaliraj {title}\n"
"\n"
"Preporučeno: Dodaj u sistem. U kutiji ovi dijelovi aplikacije {title} neće raditi:\n"
"{notes}\n"
"Na sistemu sve radi. Potrebni su vaša lozinka i ponovno pokretanje.\n"
"\n"
"Ili {setup}: stavlja je u zasebnu kutiju. Lakše se uklanja, ali ti dijelovi neće raditi."

#, python-brace-format
msgid ""
"Install {title}\n"
"\n"
"{setup}: puts it in a separate box. Your system isn't changed, and Remove Apps takes it out cleanly."
msgstr ""
"Instaliraj {title}\n"
"\n"
"{setup}: stavlja je u zasebnu kutiju. Vaš sistem se ne mijenja, a Ukloni aplikacije je uredno uklanja."

