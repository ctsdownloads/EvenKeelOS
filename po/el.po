msgstr ""
"Γίνεται ενημέρωση του {title} στο σύστημα. Αυτό μπορεί να διαρκέσει μερικά "
"λεπτά."

#, python-brace-format
msgid "Updating {title}: {description}"
msgstr "Ενημέρωση του {title}: {description}"

#, python-brace-format
msgid ""
"Use 1 to {max} ports from 1 to 65535, each as 8096/tcp or 2456-2458/udp."
msgstr ""
"Χρησιμοποιήστε 1 έως {max} θύρες από το 1 έως το 65535, καθεμία ως 8096/tcp ή"
