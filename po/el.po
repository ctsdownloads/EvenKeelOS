msgstr "Εγκατάσταση της παλαιότερης έκδοσης του {title}"

#, python-brace-format
msgid "Installing the older version of {title} in the {label}."
msgstr "Εγκατάσταση της παλαιότερης έκδοσης του {title} στο «{label}»."

