msgid "Turn it on from a Home network."
msgstr "Ενεργοποιήστε την από ένα δίκτυο Σπίτι."

msgid "Turn off"
msgstr "Απενεργοποίηση"

msgid "Turn on"
msgstr "Ενεργοποίηση"

msgid "Turn on anyway"
msgstr "Ενεργοποίηση παρ' όλα αυτά"

msgid ""
"Turn on automatic updates or automatic disk unlock, or free up disk space"
msgstr ""
"Ενεργοποίηση των αυτόματων ενημερώσεων ή του αυτόματου ξεκλειδώματος δίσκου, "
"ή απελευθέρωση χώρου στον δίσκο"

msgid ""
"Turn sharing off and on again. If this stays, use Save problem details in Get"
