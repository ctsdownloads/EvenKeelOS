msgstr "Θα λειτουργήσει αυτός ο υπολογιστής;"

msgid "Windows Program"
msgstr "Πρόγραμμα Windows"

msgid "Windows Program is open"
msgstr "Το «Πρόγραμμα Windows» είναι ανοιχτό"

