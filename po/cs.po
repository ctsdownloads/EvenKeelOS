msgstr "Znovu zavřít {name}"

msgid "Code and terminal"
msgstr "Kód a terminál"

msgid "Collecting the problem details."
msgstr "Shromažďujeme podrobnosti o problému."

msgid "Colors and wallpaper"
msgstr "Barvy a tapeta"

msgid "Comes with the system"
msgstr "Je součástí systému"

msgid "Coming from Windows"
msgstr "Přechod z Windows"

msgid "Coming from Windows: where things are, and what's different"
msgstr "Přechod z Windows: kde co najdete a co je jinak"

msgid "Coming from Windows?"
msgstr "Přecházíte z Windows?"

msgid "Common fixes"
msgstr "Běžné opravy"

msgid "Computer name"
msgstr "Název počítače"

#, python-brace-format
msgid "Computer name: {name}."
msgstr "Název počítače: {name}."

msgid "Connect"
msgstr "Připojit"

msgid "Connect a Bluetooth device"
msgstr "Připojit zařízení Bluetooth"

#, python-brace-format
msgid "Connected to {network}."
msgstr "Připojeno k {network}."

#, python-brace-format
msgid "Connecting to {network}..."
msgstr "Probíhá připojování k {network}…"

msgid ""
