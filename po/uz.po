msgstr "{title} oʻchirilmoqda"

#, python-brace-format
msgid "Removing {title} from the system."
msgstr "{title} tizimdan olib tashlanmoqda."

#, python-brace-format
msgid "Removing {title}."
msgstr "{title} oʻchirilmoqda."

