#, python-brace-format
msgid "Repair: rebuilds it and puts back its apps: {names}."
msgstr "Taʼmirlash: uni qayta quradi va ilovalarini qaytaradi: {names}."

msgid "Report on GitHub"
msgstr "GitHub-da xabar berish"

msgid "Restart"
msgstr "Qayta ishga tushirish"

