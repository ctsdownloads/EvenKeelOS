msgstr "Eguneratze automatikoak berriro aktibatzen."

msgid "Turning off automatic disk unlock."
msgstr "Diskoaren desblokeo automatikoa desaktibatzen."

msgid "Turning off automatic updates."
msgstr "Eguneratze automatikoak desaktibatzen."

msgid "Turning on automatic disk unlock."
msgstr "Diskoaren desblokeo automatikoa aktibatzen."

msgid "Turning on automatic updates."
msgstr "Eguneratze automatikoak aktibatzen."

