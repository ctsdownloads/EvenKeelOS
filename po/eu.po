msgstr "Honek denbora pixka bat behar du."

#, python-brace-format
msgid "This version is from {when}."
msgstr "Bertsio hau {when}(e)koa da."

#, python-brace-format
msgid ""
"This {title} file is for a different kind of computer. Download the version "
