msgstr ""
"បើគ្មានចម្លើយក្នុងរយៈពេល 2 នាទី៖ វាចាប់ផ្ដើមឡើងវិញដោយខ្លួនឯង "
"ព្រោះការសាកល្បងនេះអាចធ្វើឱ្យអេក្រង់ខ្មៅ។"

msgid "No answer in 2 minutes: it restarts by itself."
msgstr "បើគ្មានចម្លើយក្នុងរយៈពេល 2 នាទី៖ វាចាប់ផ្ដើមឡើងវិញដោយខ្លួនឯង។"

msgid "No boot options added"
msgstr "មិនបានបន្ថែមជម្រើសចាប់ផ្ដើមទេ"

msgid "No camera found."
msgstr "រកមិនឃើញកាមេរ៉ាទេ។"

msgid "No disk chosen yet."
msgstr "មិនទាន់បានជ្រើសរើសថាសណាមួយទេ។"

msgid "No disk inside the computer was found."
msgstr "រកមិនឃើញថាសណាមួយនៅក្នុងកុំព្យូទ័រទេ។"

msgid "No disk was found. Connect one and click Refresh."
msgstr "រកមិនឃើញថាសទេ។ ភ្ជាប់មួយ ហើយចុច «ផ្ទុកឡើងវិញ»។"

msgid ""
"No downloaded apps that can start at login are installed. Apps from Bazaar, "
"the app store, have this setting inside the app."
msgstr ""
"មិនមានកម្មវិធីដែលបានទាញយកដែលអាចចាប់ផ្ដើមនៅពេលចូល ត្រូវបានដំឡើងទេ។ កម្មវិធីពី "
"Bazaar ដែលជាហាងកម្មវិធី មានការកំណត់នេះនៅក្នុងកម្មវិធី។"

msgid "No folders shared yet"
msgstr "មិនទាន់មានថតដែលបានចែករំលែកនៅឡើយទេ"

msgid "No graphics chip found."
msgstr "រកមិនឃើញបន្ទះឈីបក្រាហ្វិកទេ។"

#, python-brace-format
msgid "No group {group}, or no user to add to it."
msgstr "គ្មានក្រុម {group} ឬគ្មានអ្នកប្រើដើម្បីបន្ថែមទៅក្នុងក្រុមនោះទេ។"

msgid "No guide at login, with the Standard desktop"
msgstr "គ្មានមគ្គុទ្ទេសក៍នៅពេលចូល ជាមួយផ្ទៃតុស្ដង់ដារ"

msgid "No login screen"
msgstr "គ្មានអេក្រង់ចូល"

msgid "No networking"
msgstr "គ្មានបណ្ដាញទេ"

msgid "No ports of its own"
msgstr "គ្មានច្រកផ្ទាល់ខ្លួនទេ"

msgid "No rule files given."
msgstr "មិនបានផ្ដល់ឯកសារច្បាប់ទេ។"

msgid "No saved networks yet"
msgstr "មិនទាន់មានបណ្ដាញដែលបានរក្សាទុកនៅឡើយទេ"

msgid "No sound"
msgstr "គ្មានសំឡេង"

msgid "No sound found."
msgstr "រកមិនឃើញសំឡេងទេ។"

msgid "No tool matches. Try another word."
msgstr "រកមិនឃើញឧបករណ៍ដែលត្រូវគ្នាទេ។ សូមសាកល្បងពាក្យផ្សេងទៀត។"

msgid "No touchpad found."
msgstr "រកមិនឃើញបន្ទះប៉ះទេ។"

msgid "None picked yet."
msgstr "មិនទាន់បានជ្រើសរើសមួយណាទេ។"

#, python-brace-format
msgid "Not a rule file name: {name}"
msgstr "មិនមែនជាឈ្មោះឯកសារវិធានទេ៖ {name}"

msgid "Not chosen"
msgstr "មិនទាន់បានជ្រើសរើស"

msgid "Not connected"
msgstr "មិនបានភ្ជាប់ទេ"

msgid "Not connected."
msgstr "មិនបានភ្ជាប់ទេ។"

msgid "Not encrypted"
msgstr "មិនបានអ៊ិនគ្រីបទេ"

#, python-brace-format
msgid ""
"Not enough free space. This needs about {needed}, and {free} is free.\n"
"\n"
"Recommended: Cancel, then empty the Trash or remove apps you don't use, and try again.\n"
"\n"
"Or Try anyway: if space runs out, it stops safely and nothing is lost."
msgstr ""
"ទំហំទំនេរមិនគ្រប់គ្រាន់ទេ។ ការនេះត្រូវការប្រហែល {needed} ហើយទំនេរ {free}។\n"
"\n"
"ណែនាំ៖ បោះបង់ រួចសម្អាត Trash (ធុងសំរាម) ឬលុបកម្មវិធីដែលអ្នកមិនប្រើ ហើយព្យាយាមម្ដងទៀត។\n"
"\n"
"ឬ នៅតែព្យាយាម៖ បើអស់ទំហំ វានឹងឈប់ដោយសុវត្ថិភាព ហើយគ្មានអ្វីបាត់ទេ។"

msgid ""
"Not in the list? Click Open a port and type the number the app's own "
"instructions give."
msgstr ""
"មិនមាននៅក្នុងបញ្ជីទេ? ចុច «បើកច្រកមួយ» "
"ហើយវាយលេខដែលការណែនាំផ្ទាល់របស់កម្មវិធីផ្ដល់ឱ្យ។"

msgid "Not now"
msgstr "មិនមែនពេលនេះទេ"

msgid "Not on Work or a Public place. Each change asks for your password."
msgstr ""
"មិននៅកន្លែងធ្វើការ ឬកន្លែងសាធារណៈទេ។ "
"ការផ្លាស់ប្ដូរនីមួយៗសុំពាក្យសម្ងាត់របស់អ្នក។"

#, python-brace-format
msgid "Not put back (open their files again to install them): {apps}."
msgstr "មិនបានដាក់ត្រឡប់មកវិញ (បើកឯកសាររបស់វាម្ដងទៀត ដើម្បីដំឡើងវា)៖ {apps}។"

#, python-brace-format
msgid "Not saved: {problem}"
msgstr "មិនបានរក្សាទុក៖ {problem}"

msgid "Not set yet."
msgstr "មិនទាន់បានកំណត់ទេ។"

msgid "Not yet"
msgstr "មិនទាន់ទេ"

msgid ""
"Not yet: nothing restarts until you click Restart now, so you can save your "
"work first."
msgstr ""
"មិនទាន់ទេ៖ គ្មានអ្វីចាប់ផ្ដើមឡើងវិញទេ រហូតដល់អ្នកចុច «ចាប់ផ្ដើមឡើងវិញឥឡូវនេះ»"
" ដូច្នេះអ្នកអាចរក្សាទុកការងាររបស់អ្នកជាមុនសិន។"

msgid ""
"Notepad: Text Editor. Photos: Image Viewer. Videos: Celluloid. Music: "
"Lollypop. PDFs: Papers."
msgstr ""
"Notepad៖ Text Editor។ Photos៖ Image Viewer។ Videos៖ Celluloid។ Music៖ "
"Lollypop។ PDF៖ Papers។"

msgid ""
"Nothing can reach this computer from the network, and your folders aren't "
"shared. Office shared drives and printers still work."
msgstr ""
"គ្មានអ្វីអាចចូលមកកាន់កុំព្យូទ័រនេះពីបណ្ដាញបានទេ "
"ហើយថតរបស់អ្នកក៏មិនត្រូវបានចែករំលែកដែរ។ ដ្រាយរួម "
"និងម៉ាស៊ីនបោះពុម្ពរបស់ការិយាល័យនៅតែដំណើរការធម្មតា។"

msgid ""
"Nothing can reach this computer from the network. Finding printers still "
"works."
msgstr ""
"គ្មានអ្វីអាចចូលមកកាន់កុំព្យូទ័រនេះពីបណ្ដាញបានទេ។ "
"ការស្វែងរកម៉ាស៊ីនបោះពុម្ពនៅតែដំណើរការ។"

msgid "Nothing changed."
msgstr "គ្មានអ្វីផ្លាស់ប្ដូរទេ។"

msgid "Nothing extra on Home"
msgstr "គ្មានអ្វីបន្ថែមនៅផ្ទះទេ"

msgid "Nothing extra on Work"
msgstr "គ្មានអ្វីបន្ថែមនៅកន្លែងធ្វើការទេ"

msgid "Nothing extra on a Public place"
msgstr "គ្មានអ្វីបន្ថែមនៅកន្លែងសាធារណៈទេ"

msgid "Nothing has been installed with Install Package File yet."
msgstr "មិនទាន់មានអ្វីត្រូវបានដំឡើងដោយ «ដំឡើងឯកសារកញ្ចប់» នៅឡើយទេ។"

msgid "Nothing is shared yet"
msgstr "មិនទាន់មានអ្វីដែលបានចែករំលែកនៅឡើយទេ"

msgid "Nothing matches"
msgstr "គ្មានអ្វីត្រូវគ្នាទេ"

msgid ""
"Nothing more was changed on the disk. Save the log puts the details on a USB "
"stick for your helper; no account is needed. Show a QR code sends a report "
"from your phone, and Report on GitHub sends it from Firefox; both need a free"
" GitHub account. Or click Restart."
msgstr ""
"គ្មានអ្វីផ្សេងទៀតត្រូវបានផ្លាស់ប្ដូរនៅលើថាសទេ។ «រក្សាទុកកំណត់ហេតុ» "
"ដាក់ព័ត៌មានលម្អិតលើថាស USB សម្រាប់អ្នកជំនួយរបស់អ្នក ដោយមិនត្រូវការគណនីទេ។ "
"«បង្ហាញកូដ QR» ផ្ញើរបាយការណ៍ពីទូរសព្ទរបស់អ្នក ហើយ «រាយការណ៍នៅលើ GitHub» "
"ផ្ញើវាពី Firefox ទាំងពីរត្រូវការគណនី GitHub ឥតគិតថ្លៃ។ ឬចុច "
"«ចាប់ផ្ដើមឡើងវិញ»។"

msgid "Nothing to change: Zoom meetings open in Chrome, or the first one asks."
msgstr ""
"គ្មានអ្វីត្រូវផ្លាស់ប្ដូរទេ៖ កិច្ចប្រជុំ Zoom បើកនៅក្នុង Chrome "
"ឬកិច្ចប្រជុំដំបូងនឹងសួរ។"

msgid "Nothing updates until you run System Update."
msgstr ""
"គ្មានអ្វីធ្វើបច្ចុប្បន្នភាពទេ រហូតដល់អ្នកដំណើរការ "
"«ការធ្វើបច្ចុប្បន្នភាពប្រព័ន្ធ»។"

msgid "Notifications"
msgstr "ការជូនដំណឹង"

msgid "November"
msgstr "ខែវិច្ឆិកា"

msgid "OK"
msgstr "យល់ព្រម"

msgid "October"
msgstr "ខែតុលា"

msgid "Off"
msgstr "បិទ"

#, python-brace-format
msgid "Off here: {name} is {place}."
msgstr "បិទនៅទីនេះ៖ {name} ជា {place}។"

msgid "Off unless you need it"
msgstr "បិទ លុះត្រាតែអ្នកត្រូវការវា"

msgid "Off. Skip the disk password at startup."
msgstr "បិទ។ រំលងពាក្យសម្ងាត់ថាសនៅពេលចាប់ផ្ដើម។"

msgid "Off. Turn them on or off."
msgstr "បិទ។ បើក ឬបិទវា។"

msgid "On Home, use the switch for it above."
msgstr "នៅផ្ទះ សូមប្រើកុងតាក់សម្រាប់វានៅខាងលើ។"

msgid "On a Mac: Finder, Network. On another Linux computer: Files, Network."
msgstr ""
"នៅលើ Mac៖ Finder ផ្នែក Network។ នៅលើកុំព្យូទ័រ Linux ផ្សេងទៀត៖ Files ផ្នែក "
"«Network»។"

msgid ""
"On a Public place it asks first, because strangers could reach it too. The "
"bin next to it closes it again."
msgstr ""
"នៅកន្លែងសាធារណៈ វាសួរជាមុនសិន ព្រោះមនុស្សចម្លែកក៏អាចចូលដល់វាបានដែរ។ "
"ធុងសំរាមដែលនៅជាប់វា បិទវាវិញ។"

msgid ""
"On a Windows PC: File Explorer, Network. The Windows PC's own network must be"
" set to Private."
msgstr ""
"នៅលើកុំព្យូទ័រ Windows៖ File Explorer ផ្នែក Network។ បណ្ដាញរបស់កុំព្យូទ័រ "
"Windows នោះត្រូវតែកំណត់ជា Private។"

msgid ""
"On top of what the place itself lets in. Each change asks for your password."
msgstr ""
"បន្ថែមលើអ្វីដែលកន្លែងនោះអនុញ្ញាតឱ្យចូលស្រាប់។ "
"ការផ្លាស់ប្ដូរនីមួយៗសុំពាក្យសម្ងាត់របស់អ្នក។"

msgid "On. Skip the disk password at startup."
msgstr "បើក។ រំលងពាក្យសម្ងាត់ថាសនៅពេលចាប់ផ្ដើម។"

msgid "On. Turn them on or off."
msgstr "បើក។ បើក ឬបិទវា។"

msgid "One file at a time: the first one is opening."
msgstr "ម្ដងមួយឯកសារ៖ ឯកសារទីមួយកំពុងបើក។"

msgid "Open"
msgstr "បើក"

msgid "Open Bazaar"
msgstr "បើក Bazaar"

msgid "Open Bazaar, the app store, from the start menu or the dock."
msgstr "បើក Bazaar ដែលជាហាងកម្មវិធី ពីម៉ឺនុយចាប់ផ្ដើម ឬពីដុក។"

msgid ""
"Open Files from the start menu or the dock. It opens on your home folder."
msgstr ""
"បើក Files (កម្មវិធីគ្រប់គ្រងឯកសារ) ពីម៉ឺនុយចាប់ផ្ដើម ឬពីដុក។ "
"វាបើកនៅថតផ្ទះរបស់អ្នក។"

msgid "Open Install Package File"
msgstr "បើក «ដំឡើងឯកសារកញ្ចប់»"

msgid "Open Printers"
msgstr "បើក ម៉ាស៊ីនបោះពុម្ព"

msgid "Open Settings, Appearance."
msgstr "បើក ការកំណត់ ផ្នែក Appearance (រូបរាង)។"

msgid "Open Settings, Apps, Default Apps."
msgstr "បើក ការកំណត់ ផ្នែក Apps (កម្មវិធី) «Default Apps» (កម្មវិធីលំនាំដើម)។"

msgid "Open Settings, Bluetooth, and turn on the switch at the top."
msgstr "បើក ការកំណត់ ផ្នែក ប៊្លូធូស ហើយបើកកុងតាក់នៅខាងលើ។"

msgid ""
"Open Settings, Displays, Night Light, and turn it on. It follows sunset and "
"sunrise, or set your own times."
msgstr ""
"បើក ការកំណត់ ផ្នែក ទិដ្ឋភាព «Night Light» (ពន្លឺពេលយប់) ហើយបើកវា។ "
"វាធ្វើតាមពេលថ្ងៃលិច និងថ្ងៃរះ ឬកំណត់ម៉ោងដោយខ្លួនអ្នក។"

msgid "Open Settings, Displays."
msgstr "បើក ការកំណត់ ផ្នែក ទិដ្ឋភាព។"

msgid "Open Settings, Printers, and click Add Printer."
msgstr "បើក ការកំណត់ ផ្នែក ម៉ាស៊ីនបោះពុម្ព ហើយចុច «បន្ថែមម៉ាស៊ីនបោះពុម្ព»។"

msgid "Open Settings, Sound."
msgstr "បើក ការកំណត់ ផ្នែក សំឡេង។"

msgid "Open Settings, System, Users."
msgstr "បើក ការកំណត់ ផ្នែក ប្រព័ន្ធ «Users» (អ្នកប្រើ)។"

msgid "Open Wheelhouse"
msgstr "បើក Wheelhouse"

msgid "Open Wheelhouse on its Updates page"
msgstr "បើក Wheelhouse នៅទំព័រ ការធ្វើបច្ចុប្បន្នភាព របស់វា"

msgid "Open Wheelhouse, Apps, Get a VPN."
msgstr "បើក Wheelhouse ផ្នែក កម្មវិធី «ទាញយក VPN»។"

msgid "Open Wheelhouse, Apps, Media codecs."
msgstr "បើក Wheelhouse ផ្នែក កម្មវិធី «កូដិកមេឌៀ»។"

msgid "Open Wheelhouse, Disk and startup, Restart into BIOS settings."
msgstr ""
"បើក Wheelhouse ផ្នែក «ថាស និងការចាប់ផ្ដើម» «ចាប់ផ្ដើមឡើងវិញទៅការកំណត់ BIOS»។"

msgid "Open Wheelhouse, Disk and startup, Unlock disk automatically."
msgstr "បើក Wheelhouse ផ្នែក «ថាស និងការចាប់ផ្ដើម» «ដោះសោថាសដោយស្វ័យប្រវត្តិ»។"

msgid "Open Wheelhouse, Disk and startup. The bar shows how much is free."
msgstr "បើក Wheelhouse ផ្នែក «ថាស និងការចាប់ផ្ដើម»។ របារបង្ហាញថាទំនេរប៉ុន្មាន។"

msgid ""
"Open Wheelhouse, Disk and startup. Under Common fixes, turn on the one that "
"matches the problem."
msgstr ""
"បើក Wheelhouse ផ្នែក «ថាស និងការចាប់ផ្ដើម»។ នៅក្រោម «ដំណោះស្រាយទូទៅ» "
"បើកមួយដែលត្រូវនឹងបញ្ហា។"

msgid "Open Wheelhouse, Get help, Certificate alerts to see them."
msgstr ""
"បើក Wheelhouse ផ្នែក «ទទួលជំនួយ» «ការជូនដំណឹងអំពីវិញ្ញាបនបត្រ» ដើម្បីមើលវា។"

msgid "Open Wheelhouse, Get help, Save problem details."
msgstr "បើក Wheelhouse ផ្នែក «ទទួលជំនួយ» «រក្សាទុកព័ត៌មានលម្អិតអំពីបញ្ហា»។"

msgid ""
"Open Wheelhouse, Get help, Test automatic rollback. Save your work first."
msgstr ""
"បើក Wheelhouse ផ្នែក «ទទួលជំនួយ» «សាកល្បងការត្រឡប់ក្រោយស្វ័យប្រវត្តិ»។ "
"សូមរក្សាទុកការងាររបស់អ្នកជាមុនសិន។"

msgid ""
"Open Wheelhouse, Get help, and scroll to the end. Every tool has its command "
"there."
msgstr ""
"បើក Wheelhouse ផ្នែក «ទទួលជំនួយ» ហើយរំកិលទៅខាងចុង។ "
"ឧបករណ៍នីមួយៗមានពាក្យបញ្ជារបស់វានៅទីនោះ។"

msgid "Open Wheelhouse, Make it yours, Desktop layout."
msgstr "បើក Wheelhouse ផ្នែក «កែតាមចិត្តអ្នក» «ប្លង់ផ្ទៃតុ»។"

msgid "Open Wheelhouse, Make it yours, Fonts and text."
msgstr "បើក Wheelhouse ផ្នែក «កែតាមចិត្តអ្នក» «ពុម្ពអក្សរ និងអត្ថបទ»។"

msgid "Open Wheelhouse, Make it yours, Light and dark."
msgstr "បើក Wheelhouse ផ្នែក «កែតាមចិត្តអ្នក» «ភ្លឺ និងងងឹត»។"

msgid "Open Wheelhouse, Make it yours, Wallpaper slideshow, and click Choose."
msgstr ""
"បើក Wheelhouse ផ្នែក «កែតាមចិត្តអ្នក» «ស្លាយរូបផ្ទៃខាងក្រោយ» ហើយចុច "
"«ជ្រើសរើស»។"

msgid "Open Wheelhouse, Make it yours."
msgstr "បើក Wheelhouse ផ្នែក «កែតាមចិត្តអ្នក»។"

msgid ""
"Open Wheelhouse, Network safety. Under Also let in, on Home, there are two "
"switches."
msgstr ""
"បើក Wheelhouse ផ្នែក សុវត្ថិភាពបណ្ដាញ។ នៅក្រោម «អនុញ្ញាតឱ្យចូលផងដែរ នៅផ្ទះ» "
"មានកុងតាក់ពីរ។"

msgid ""
"Open Wheelhouse, Network safety. Under Apps and ports let in, pick the place."
msgstr ""
"បើក Wheelhouse ផ្នែក «សុវត្ថិភាពបណ្ដាញ»។ នៅក្រោម «កម្មវិធី "
"និងច្រកដែលបានអនុញ្ញាតឱ្យចូល» ជ្រើសរើសកន្លែង។"

msgid ""
"Open Wheelhouse, Network safety. Your networks lists every network this "
"computer has joined."
msgstr ""
"បើក Wheelhouse ផ្នែក «សុវត្ថិភាពបណ្ដាញ»។ «បណ្ដាញរបស់អ្នក» "
"រាយបណ្ដាញទាំងអស់ដែលកុំព្យូទ័រនេះធ្លាប់ភ្ជាប់។"

msgid "Open Wheelhouse, Shared folders."
msgstr "បើក Wheelhouse ផ្នែក «ថតដែលបានចែករំលែក»។"

msgid "Open Wheelhouse, Updates, Automatic updates. On is recommended."
msgstr ""
"បើក Wheelhouse ផ្នែក ការធ្វើបច្ចុប្បន្នភាព "
"«ការធ្វើបច្ចុប្បន្នភាពដោយស្វ័យប្រវត្តិ»។ ណែនាំឱ្យបើក។"

msgid ""
"Open Wi-Fi, with no password, is always a Public place, because anyone can "
"make one with the same name."
msgstr ""
"Wi-Fi បើកចំហដែលគ្មានពាក្យសម្ងាត់ តែងតែជាកន្លែងសាធារណៈ ពីព្រោះនរណាក៏អាចបង្កើត "
"Wi-Fi ដែលមានឈ្មោះដូចគ្នានេះបានដែរ។"

msgid "Open a port"
msgstr "បើកច្រកមួយ"

msgid "Open a port on Home"
msgstr "បើកច្រកមួយនៅផ្ទះ"

msgid "Open a port on Work"
msgstr "បើកច្រកមួយនៅកន្លែងធ្វើការ"

msgid "Open a port on a Public place"
msgstr "បើកច្រកមួយនៅកន្លែងសាធារណៈ"

msgid "Open an app"
msgstr "បើកកម្មវិធីមួយ"

msgid "Open it"
msgstr "បើកវា"

msgid "Open the computer's BIOS settings screen"
msgstr "បើកអេក្រង់ការកំណត់ BIOS របស់កុំព្យូទ័រ"

msgid "Open the computer's own settings screen"
msgstr "បើកអេក្រង់ការកំណត់ផ្ទាល់របស់កុំព្យូទ័រ"

msgid "Open the file again to install it."
msgstr "បើកឯកសារនេះម្ដងទៀត ដើម្បីដំឡើងវា។"

msgid "Open the file, or drop it on Wheelhouse, Apps."
msgstr "បើកឯកសារ ឬទម្លាក់វាលើ Wheelhouse ផ្នែក កម្មវិធី។"

msgid "Open the file, or use Install a package file in Wheelhouse, Apps."
msgstr "បើកឯកសារ ឬប្រើ «ដំឡើងឯកសារកញ្ចប់» នៅក្នុង Wheelhouse ផ្នែក កម្មវិធី។"

msgid ""
"Open this computer, type your user name and the sharing password, and the "
"folders are there."
msgstr ""
"បើកកុំព្យូទ័រនេះ វាយឈ្មោះអ្នកប្រើរបស់អ្នក និងពាក្យសម្ងាត់ចែករំលែក "
"ហើយថតនឹងនៅទីនោះ។"

msgid "Open your folders from another computer at home"
msgstr "បើកថតរបស់អ្នកពីកុំព្យូទ័រផ្សេងទៀតនៅផ្ទះ"

#, python-brace-format
msgid "Open {name}"
msgstr "បើក {name}"

msgid ""
"Opens New to EvenKeelOS at login, after the setup checklist, until its Don't "
"show this again box is ticked"
msgstr ""
"បើក «ទើបស្គាល់ EvenKeelOS មែនទេ?» នៅពេលចូល បន្ទាប់ពីបញ្ជីរៀបចំដំបូង "
"រហូតដល់ប្រអប់ «កុំបង្ហាញសារនេះម្ដងទៀតនៅពេលចូល» របស់វាត្រូវបានធីក"

msgid "Opens a Zoom meeting in Zoom's web version, in Chrome"
msgstr "បើកកិច្ចប្រជុំ Zoom នៅក្នុងកំណែវេបរបស់ Zoom ក្នុង Chrome"

msgid "Opens the setup checklist once, the first time a user logs in"
msgstr "បើកបញ្ជីរៀបចំដំបូងម្ដង នៅពេលអ្នកប្រើម្នាក់ចូលលើកដំបូង"

msgid "Optional formats left out for legal reasons"
msgstr "ទ្រង់ទ្រាយស្រេចចិត្ត ដែលត្រូវបានទុកចោលដោយហេតុផលផ្លូវច្បាប់"

msgid "Optional: add the media codecs that are left out for legal reasons"
msgstr "ស្រេចចិត្ត៖ បន្ថែមកូដិកមេឌៀដែលត្រូវបានទុកចោលដោយហេតុផលផ្លូវច្បាប់"

msgid "Or Cancel."
msgstr "ឬ បោះបង់។"

msgid "Or Keep it."
msgstr "ឬ រក្សាទុកវា។"

#, python-brace-format
msgid "Or Keep it: saves setup time if you'll install another {kind} app soon."
msgstr ""
"ឬ រក្សាទុកវា៖ សន្សំពេលរៀបចំ បើអ្នកនឹងដំឡើងកម្មវិធី {kind} ផ្សេងទៀតឆាប់ៗនេះ។"

msgid ""
"Or use the keyboard: Windows key + Up fills the screen, Windows key + Left or"
" Right fills a half, and Windows key + H minimizes."
msgstr ""
"ឬប្រើក្ដារចុច៖ គ្រាប់ចុច Windows + ព្រួញឡើង ធ្វើឱ្យពេញអេក្រង់ គ្រាប់ចុច "
"Windows + ព្រួញឆ្វេង ឬស្ដាំ ធ្វើឱ្យពេញពាក់កណ្ដាល ហើយគ្រាប់ចុច Windows + H "
"បង្រួមវា។"

#, python-brace-format
msgid ""
"Or {button}: adds a second copy. {note} You would have two of the same app."
msgstr ""
"ឬ {button}៖ បន្ថែមច្បាប់ចម្លងទីពីរ។ {note} អ្នកនឹងមានកម្មវិធីដូចគ្នាពីរ។"

#, python-brace-format
msgid "Other ({zone})"
msgstr "ផ្សេងទៀត ({zone})"

#, python-brace-format
msgid ""
"Other computers ask for your user name, {user}, and this password. It isn't "
"your login password."
msgstr ""
"កុំព្យូទ័រផ្សេងទៀតសុំឈ្មោះអ្នកប្រើរបស់អ្នក {user} និងពាក្យសម្ងាត់នេះ។ "
"វាមិនមែនជាពាក្យសម្ងាត់ចូលរបស់អ្នកទេ។"

#, python-brace-format
msgid ""
"Other computers ask for your user name, {user}, and this password. Use at "
"least {n} character. Your login password doesn't change."
msgid_plural ""
"Other computers ask for your user name, {user}, and this password. Use at "
"least {n} characters. Your login password doesn't change."
msgstr[0] ""
"កុំព្យូទ័រផ្សេងទៀតសុំឈ្មោះអ្នកប្រើរបស់អ្នក {user} និងពាក្យសម្ងាត់នេះ។ "
"ប្រើយ៉ាងហោចណាស់ {n} តួអក្សរ។ ពាក្យសម្ងាត់ចូលរបស់អ្នកមិនផ្លាស់ប្ដូរទេ។"

#, python-brace-format
msgid ""
"Other computers find this one as {host}: in Files under Network on Linux, in "
"Finder under Network on a Mac, and under Network in File Explorer on Windows."
msgstr ""
"កុំព្យូទ័រផ្សេងទៀតរកឃើញកុំព្យូទ័រនេះជា {host}៖ នៅក្នុង Files ក្រោម «Network» "
"លើ Linux នៅក្នុង Finder ក្រោម Network លើ Mac និងក្រោម Network ក្នុង File "
"Explorer លើ Windows។"

msgid ""
"Other computers open these as you, so whatever they save belongs to you."
msgstr ""
"កុំព្យូទ័រផ្សេងទៀតបើកថតទាំងនេះក្នុងនាមអ្នក "
"ដូច្នេះអ្វីដែលពួកគេរក្សាទុកជារបស់អ្នក។"

msgid "Other computers print to a printer plugged into this one"
msgstr ""
"កុំព្យូទ័រផ្សេងទៀតបោះពុម្ពទៅម៉ាស៊ីនបោះពុម្ពដែលបានភ្ជាប់ទៅនឹងកុំព្យូទ័រនេះ"

msgid "Overview"
msgstr "ទិដ្ឋភាពទូទៅ"

msgid "Packages (.rpm, .deb)"
msgstr "កញ្ចប់ (.rpm, .deb)"

msgid "Password"
msgstr "ពាក្យសម្ងាត់"

msgid "Paused. Turn them on or off."
msgstr "បានផ្អាក។ បើក ឬបិទវា។"

msgid "Pausing automatic updates."
msgstr "កំពុងផ្អាកការធ្វើបច្ចុប្បន្នភាពដោយស្វ័យប្រវត្តិ។"

msgid ""
"Phones, file sharing and apps you run can reach this computer. System "
"services stay closed unless switched on below."
msgstr ""
"ទូរសព្ទ ការចែករំលែកឯកសារ និងកម្មវិធីដែលអ្នកដំណើរការ អាចចូលដល់កុំព្យូទ័រនេះ។ "
"សេវាកម្មប្រព័ន្ធនៅតែបិទ លុះត្រាតែបើកនៅខាងក្រោម។"

msgid "Pick Home, Work or Public place for it below."
msgstr "ជ្រើសរើស ផ្ទះ កន្លែងធ្វើការ ឬកន្លែងសាធារណៈ សម្រាប់វានៅខាងក្រោម។"

msgid ""
"Pick Mullvad, Proton, IVPN or NordVPN. It's added from that company's own "
"download source, and kept up to date."
msgstr ""
"ជ្រើសរើស Mullvad, Proton, IVPN ឬ NordVPN។ "
"វាត្រូវបានបន្ថែមពីប្រភពទាញយកផ្ទាល់របស់ក្រុមហ៊ុននោះ ហើយរក្សាឱ្យទាន់សម័យ។"

msgid ""
"Pick Sunset to sunrise, or Custom times and pick when dark starts and ends."
msgstr ""
"ជ្រើសរើស «ពីពេលថ្ងៃលិចដល់ពេលថ្ងៃរះ» ឬ «ពេលវេលាកំណត់ផ្ទាល់ខ្លួន» "
"ហើយជ្រើសរើសពេលដែលងងឹតចាប់ផ្ដើម និងបញ្ចប់។"

msgid ""
"Pick Windows-style (a bar at the bottom and a start menu) or Standard (a bar "
"at the top and a dock)."
msgstr ""
"ជ្រើសរើស បែប Windows (របារនៅខាងក្រោម និងម៉ឺនុយចាប់ផ្ដើម) ឬ ស្ដង់ដារ "
"(របារនៅខាងលើ និងដុក)។"

msgid "Pick Windows-style or Standard, click Switch, then log out and back in."
msgstr "ជ្រើសរើស បែប Windows ឬ ស្ដង់ដារ ចុច «ប្ដូរ» រួចចេញ ហើយចូលវិញ។"

msgid "Pick a Windows program"
msgstr "ជ្រើសរើសកម្មវិធី Windows មួយ"

msgid "Pick a file"
msgstr "ជ្រើសរើសឯកសារមួយ"

msgid "Pick a folder inside your home folder."
msgstr "ជ្រើសរើសថតមួយនៅក្នុងថតផ្ទះរបស់អ្នក។"

msgid "Pick a folder of pictures"
msgstr "ជ្រើសរើសថតរូបភាពមួយ"

msgid "Pick a folder to share"
msgstr "ជ្រើសរើសថតមួយដើម្បីចែករំលែក"

msgid "Pick a folder, not a file."
msgstr "ជ្រើសរើសថតមួយ មិនមែនឯកសារទេ។"

msgid "Pick a problem to test. Your computer should fix it by itself."
msgstr ""
"ជ្រើសរើសបញ្ហាមួយដើម្បីសាកល្បង។ កុំព្យូទ័ររបស់អ្នកគួរតែជួសជុលវាដោយខ្លួនឯង។"

msgid "Pick a test, click Start the test, and type your password."
msgstr ""
"ជ្រើសរើសការសាកល្បងមួយ ចុច «ចាប់ផ្ដើមការសាកល្បង» ហើយវាយពាក្យសម្ងាត់របស់អ្នក។"

msgid "Pick an .exe or .msi to get its Linux version"
msgstr "ជ្រើសរើសឯកសារ .exe ឬ .msi ដើម្បីទទួលបានកំណែ Linux របស់វា"

msgid "Pick an .rpm or .deb file from Downloads"
msgstr "ជ្រើសរើសឯកសារ .rpm ឬ .deb ពីថត Downloads"

msgid "Pick an app or game so other computers can reach it"
msgstr "ជ្រើសរើសកម្មវិធី ឬហ្គេមមួយ ដើម្បីឱ្យកុំព្យូទ័រផ្សេងទៀតអាចចូលដល់វា"

msgid "Pick it again in Get a VPN."
msgstr "ជ្រើសរើសវាម្ដងទៀតនៅក្នុង «ទាញយក VPN»។"

msgid "Pick one."
msgstr "ជ្រើសរើសមួយ។"

msgid "Pick the app for the web, mail, calendar, music, videos and photos."
msgstr "ជ្រើសរើសកម្មវិធីសម្រាប់វេប សំបុត្រ ប្រតិទិន តន្ត្រី វីដេអូ និងរូបថត។"

msgid ""
"Pick the app. To use it every time for that kind of file, turn on Always use "
"for this file type first."
msgstr ""
"ជ្រើសរើសកម្មវិធី។ ដើម្បីប្រើវាជារៀងរាល់ពេលសម្រាប់ប្រភេទឯកសារនោះ សូមបើកជម្រើស "
"«Always use for this file type» (ប្រើជានិច្ចសម្រាប់ប្រភេទឯកសារនេះ) ជាមុនសិន។"

msgid ""
"Pick the box. It's set up again, with its apps. Your files aren't touched."
msgstr ""
"ជ្រើសរើសប្រអប់។ វាត្រូវបានរៀបចំឡើងវិញ ជាមួយកម្មវិធីរបស់វា។ "
"ឯកសាររបស់អ្នកមិនត្រូវបានប៉ះពាល់ទេ។"

msgid "Pick the day. Back keeps it as it is."
msgstr "ជ្រើសរើសថ្ងៃ។ «ថយក្រោយ» ទុកវាដដែល។"

msgid ""
"Pick the folder, then how often it changes: every hour, every day or at each "
"login."
msgstr ""
"ជ្រើសរើសថត រួចថាវាប្ដូរញឹកញាប់ប៉ុណ្ណា៖ រៀងរាល់ម៉ោង រៀងរាល់ថ្ងៃ ឬរាល់ពេលចូល។"

msgid "Pick the fonts for menus, documents and code"
msgstr "ជ្រើសរើសពុម្ពអក្សរសម្រាប់ម៉ឺនុយ ឯកសារ និងកូដ"

msgid "Pick the hour. Back keeps it as it is."
msgstr "ជ្រើសរើសម៉ោង។ «ថយក្រោយ» ទុកវាដដែល។"

msgid "Pick the minute. Back keeps it as it is."
msgstr "ជ្រើសរើសនាទី។ «ថយក្រោយ» ទុកវាដដែល។"

msgid "Pick the month. Back keeps it as it is."
msgstr "ជ្រើសរើសខែ។ «ថយក្រោយ» ទុកវាដដែល។"

msgid "Pick the place next to a network. It changes at once."
msgstr "ជ្រើសរើសកន្លែងនៅជាប់បណ្ដាញមួយ។ វាប្ដូរភ្លាម។"

msgid ""
"Pick the speakers or headphones under Output Device, and the microphone under"
" Input Device."
msgstr ""
"ជ្រើសរើសអូប៉ាល័រ ឬកាសនៅក្រោម «Output Device» (ឧបករណ៍បញ្ចេញ) "
"និងមីក្រូហ្វូននៅក្រោម «Input Device» (ឧបករណ៍បញ្ចូល)។"

msgid "Pick the year. Back keeps it as it is."
msgstr "ជ្រើសរើសឆ្នាំ។ «ថយក្រោយ» ទុកវាដដែល។"

msgid "Pick what you need. It explains each choice."
msgstr "ជ្រើសរើសអ្វីដែលអ្នកត្រូវការ។ វាពន្យល់អំពីជម្រើសនីមួយៗ។"

msgid "Pick which ones open when you log in"
msgstr "ជ្រើសរើសកម្មវិធីណាដែលបើកនៅពេលអ្នកចូល"

msgid "Place"
msgstr "កន្លែង"

msgid ""
"Plug in a USB stick, then click it to save the log on it. Click Refresh if it"
" isn't listed, or Back."
msgstr ""
"ដោតថាស USB មួយ រួចចុចលើវាដើម្បីរក្សាទុកកំណត់ហេតុនៅលើវា។ ចុច «ផ្ទុកឡើងវិញ» "
"បើវាមិនមានក្នុងបញ្ជី ឬ «ថយក្រោយ»។"

msgid "Plug in a second USB stick, then click Save the results again."
msgstr "ដោតថាស USB ទីពីរ រួចចុច «រក្សាទុកលទ្ធផល» ម្ដងទៀត។"

msgid ""
"Plug in a second USB stick, then click it to save the log on it. Or click "
"Back."
msgstr ""
"ដោតថាស USB ទីពីរ រួចចុចលើវាដើម្បីរក្សាទុកកំណត់ហេតុនៅលើវា។ ឬចុច «ថយក្រោយ»។"

msgid "Plug it in. It shows in the left side of Files."
msgstr "ដោតវាចូល។ វាបង្ហាញនៅផ្នែកខាងឆ្វេងនៃ Files។"

msgid "Plug the computer in. Open Wheelhouse, Updates, Update firmware."
msgstr ""
"ដោតខ្សែភ្លើងកុំព្យូទ័រ។ បើក Wheelhouse ផ្នែក ការធ្វើបច្ចុប្បន្នភាព "
"«ធ្វើបច្ចុប្បន្នភាពហ្វឺមវែរ»។"

msgid ""
"Point your phone's camera at the code. It opens the report on GitHub with the"
" details filled in. To send it, sign in to GitHub, or make a free account if "
"you don't have one. It carries the end of the log; the whole log can go on a "
"USB stick. Click Back when done."
msgstr ""
"តម្រង់កាមេរ៉ាទូរសព្ទរបស់អ្នកទៅកូដ។ វាបើករបាយការណ៍នៅលើ GitHub "
"ដោយមានព័ត៌មានលម្អិតបំពេញរួច។ ដើម្បីផ្ញើវា សូមចូល GitHub ឬបង្កើតគណនីឥតគិតថ្លៃ "
"បើអ្នកមិនទាន់មាន។ វាមានផ្នែកចុងក្រោយនៃកំណត់ហេតុ កំណត់ហេតុទាំងមូលអាចដាក់លើថាស "
"USB។ ចុច «ថយក្រោយ» នៅពេលរួចរាល់។"

msgid "Port, like 8080, or a range, like 2456-2458"
msgstr "ច្រក ដូចជា 8080 ឬចន្លោះ ដូចជា 2456-2458"

msgid "Power modes"
msgstr "របៀបថាមពល"

msgid "Prefer the terminal?"
msgstr "ចូលចិត្តប្រើ​កម្មវិធី​ស្ថានីយ​ជាង​ឬ?"

#, python-brace-format
msgid "Preparing the {label}."
msgstr "កំពុងរៀបចំ {label}។"

msgid ""
"Press Print Screen. Pick the whole screen, a window, or drag over an area, "
"then click the round button."
msgstr ""
"ចុច Print Screen។ ជ្រើសរើសអេក្រង់ទាំងមូល វីនដូមួយ ឬអូសលើតំបន់មួយ "
"រួចចុចប៊ូតុងមូល។"

msgid "Printers didn't open. Open Settings, then Printers."
msgstr "«ម៉ាស៊ីនបោះពុម្ព» មិនបានបើកទេ។ បើក ការកំណត់ រួច ម៉ាស៊ីនបោះពុម្ព។"

msgid ""
"Printers is open. Choose Add Printer.\n"
"\n"
"If your printer isn't there or doesn't print right, open this file again and choose Install the driver."
msgstr ""
"«ម៉ាស៊ីនបោះពុម្ព» បានបើកហើយ។ ជ្រើសរើស «បន្ថែមម៉ាស៊ីនបោះពុម្ព»។\n"
"\n"
"បើម៉ាស៊ីនបោះពុម្ពរបស់អ្នកមិនមាននៅទីនោះ ឬបោះពុម្ពមិនត្រឹមត្រូវ សូមបើកឯកសារនេះម្ដងទៀត ហើយជ្រើសរើស «ដំឡើងដ្រាយវឺ»។"

msgid ""
"Printers is open. Choose Add Printer.\n"
"\n"
"If your printer isn't there or doesn't print right, open this file again to see how to get the driver."
msgstr ""
"«ម៉ាស៊ីនបោះពុម្ព» បានបើកហើយ។ ជ្រើសរើស «បន្ថែមម៉ាស៊ីនបោះពុម្ព»។\n"
"\n"
"បើម៉ាស៊ីនបោះពុម្ពរបស់អ្នកមិនមាននៅទីនោះ ឬបោះពុម្ពមិនត្រឹមត្រូវ សូមបើកឯកសារនេះម្ដងទៀត ដើម្បីមើលពីរបៀបយកដ្រាយវឺ។"

msgid "Printing"
msgstr "ការបោះពុម្ព"

msgid "Printing doesn't start"
msgstr "ការបោះពុម្ពមិនចាប់ផ្ដើម"

msgid "Printing service off"
msgstr "សេវាកម្មបោះពុម្ពបិទ"

msgid "Problem"
msgstr "បញ្ហា"

msgid "Protocol"
msgstr "ពិធីសារ"

msgid "Public place"
msgstr "កន្លែងសាធារណៈ"

msgid ""
"Public place: nothing on the network can reach your computer. Pick it for "
"cafes, hotels and airports."
msgstr ""
"កន្លែងសាធារណៈ៖ គ្មានអ្វីនៅលើបណ្ដាញអាចចូលទៅកាន់កុំព្យូទ័ររបស់អ្នកបានទេ។ "
"ជ្រើសរើសវាសម្រាប់ហាងកាហ្វេ សណ្ឋាគារ និងព្រលានយន្តហោះ។"

msgid "Put EvenKeelOS on this computer"
msgstr "ដាក់ EvenKeelOS នៅលើកុំព្យូទ័រនេះ"

#, python-brace-format
msgid "Put back: {apps}."
msgstr "បានដាក់ត្រឡប់មកវិញ៖ {apps}។"

msgid ""
"Put the device in pairing mode. Its instructions say how, often by holding "
"its power button."
msgstr ""
"ដាក់ឧបករណ៍ក្នុងរបៀបផ្គូផ្គង។ ការណែនាំរបស់វាប្រាប់ពីរបៀប "
"ជាញឹកញាប់ដោយសង្កត់ប៊ូតុងថាមពលរបស់វាឱ្យជាប់។"

msgid "Put the pictures in one folder, for example in Pictures."
msgstr "ដាក់រូបភាពទាំងអស់ក្នុងថតតែមួយ ឧទាហរណ៍ ក្នុងថត Pictures។"

msgid "Quick fixes"
