msgid "{title} has no signing key for Fedora {version} yet."
msgstr "Lietotnei {title} vēl nav Fedora {version} paraksta atslēgas."

#, python-brace-format
msgid "{title} was not added, so its download source was taken out again."
msgstr "{title} netika pievienots, tāpēc tā lejupielādes avots atkal tika noņemts."

