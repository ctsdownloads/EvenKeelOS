msgid "The new system could not be set to take signed updates."
msgstr "Jauno sistēmu nevarēja iestatīt parakstītu atjauninājumu saņemšanai."

#, python-brace-format
msgid "The new system has no {name} group."
msgstr "Jaunajā sistēmā nav {name} grupas."

msgid "The new system's desktop layouts could not be found."
msgstr "Neizdevās atrast jaunās sistēmas darbvirsmas izkārtojumus."

