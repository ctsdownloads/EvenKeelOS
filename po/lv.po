msgstr "Disku paslēpj BIOS iestatījums."

#, python-brace-format
msgid "The disk {disk} was not found, or can't be written to."
msgstr "Disks {disk} nav atrasts vai uz tā nevar veikt ierakstu."

#, python-brace-format
msgid ""
"The download source stays. Open {filename} again to pick an app, or remove it"
