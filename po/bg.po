msgid "Settings with quotes or spaces in their value can't be added here."
msgstr ""
"Тук не могат да се добавят настройки, чиято стойност съдържа кавички или "
"интервали."

msgid "Setup checklist"
msgstr "Контролен списък за настройка"

msgid "Setup checklist at first login"
msgstr "Контролен списък за настройка при първо влизане"

msgid "Setup is done."
msgstr "Настройката е завършена."

msgid "Share folders on Home networks"
msgstr "Споделяне на папки в мрежи „Дом“"

msgid "Share my printer"
msgstr "Споделяне на моя принтер"

msgid ""
"Share my printer: lets other computers use a printer plugged into this one."
msgstr ""
"Споделяне на моя принтер: позволява на други компютри да използват принтер, "
"свързан към този компютър."

msgid "Shared folders"
msgstr "Споделени папки"

