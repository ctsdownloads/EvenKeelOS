msgstr "Паролата за споделяне е запазена."

msgid "Sharing starts by itself on a Home network."
msgstr "Споделянето започва само в мрежа „Дом“."

msgid "Sharing waits for a Home network"
msgstr "Споделянето изчаква мрежа „Дом“"

msgid "Shift+Print Screen takes a picture of the whole screen straight away."
msgstr "Shift+Print Screen веднага прави снимка на целия екран."

msgid "Show"
msgstr "Показване"

msgid "Show a QR code"
msgstr "Показване на QR код"

