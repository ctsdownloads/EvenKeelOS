msgstr "撤銷更新"

msgid "Unknown"
msgstr "未知"

#, python-brace-format
msgid "Unknown desktop layout {layout}."
msgstr "未知的桌面佈局 {layout}。"

#, python-brace-format
msgid "Unknown experience {experience}."
msgstr "未知的起點 {experience}。"

