msgid "Install Chrome"
msgstr "ติดตั้ง Chrome"

msgid "Install EvenKeelOS"
msgstr "ติดตั้ง EvenKeelOS"

msgid "Install EvenKeelOS on this computer"
msgstr "ติดตั้ง EvenKeelOS บนคอมพิวเตอร์เครื่องนี้"

