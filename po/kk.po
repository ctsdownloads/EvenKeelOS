msgstr "%s қолданбасынан шығуда"

msgid "Read and write"
msgstr "Оқу және жазу"

msgid "Read only"
msgstr "Тек оқу"

msgid "Reading the disk"
msgstr "Диск оқылуда"

#, python-brace-format
