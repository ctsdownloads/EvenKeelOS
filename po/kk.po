msgstr "Жою және қайта іске қосу"

msgid "Delete important settings to test the settings repair"
msgstr "Баптауларды қалпына келтіруді сынау үшін маңызды баптауларды жою"

msgid "Delete the box"
msgstr "Қорапты жою"

msgid "Deleting the settings."
msgstr "Баптауларды жоюда."

#, python-brace-format
