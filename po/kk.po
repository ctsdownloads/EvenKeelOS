msgstr "Қолданбаны жою"

msgid "Remove apps"
msgstr "Қолданбаларды жою"

msgid "Remove apps installed from .rpm or .deb files"
msgstr ".rpm немесе .deb файлдарынан орнатылған қолданбаларды жою"

