msgstr "Оны жою"

msgid "Remove media codecs"
msgstr "Медиа кодектерін жою"

msgid "Remove old system versions and unused app parts"
msgstr "Жүйенің ескі нұсқаларын және пайдаланылмайтын қолданба бөліктерін жою"

msgid "Remove the media codecs?"
msgstr "Медиа кодектерін жою керек пе?"

msgid "Remove the test marker"
msgstr "Сынақ белгісін жою"

msgid ""
"Remove them first: run  codecs remove , restart, then choose Everything "
