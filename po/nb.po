msgstr "Kunne ikke skrive filen: {error}."

msgid "The fingerprint reader"
msgstr "Fingeravtrykksleseren"

msgid "The firewall"
msgstr "Brannmuren"

msgid "The firewall didn't reload."
msgstr "Brannmuren ble ikke lastet inn på nytt."

#, python-brace-format
msgid "The firewall didn't take the change: {reason}"
msgstr "Brannmuren tok ikke endringen: {reason}"

msgid "The firewall doesn't start"
msgstr "Brannmuren starter ikke"

msgid ""
"The firewall fails to start, so during the test the computer has no firewall."
msgstr ""
"Brannmuren starter ikke, så under testen har datamaskinen ingen brannmur."

