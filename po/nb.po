msgstr "Systemkjernen krasjet (en beskyttelsesfeil)"

msgid "The system core crashed (an oops)"
msgstr "Systemkjernen krasjet (en oops)"

msgid "The system core reported a bug"
msgstr "Systemkjernen rapporterte en feil"

msgid ""
"The system itself can't be changed by apps or by mistake. Each update "
"replaces it whole."
msgstr ""
"Selve systemet kan ikke endres av apper eller ved et uhell. Hver oppdatering "
"erstatter det i sin helhet."

#, python-brace-format
msgid "The test copy ({name}) is ready. It starts at your next restart."
msgstr "Testkopien ({name}) er klar. Den starter ved neste omstart."

msgid ""
"The test marker is removed. The version without it starts at your next "
