msgstr "Neste oppstart bruker: {settings}"

msgid "The one-time setup window is already closed."
msgstr "Vinduet for engangsoppsett er allerede lukket."

msgid "The password is typed and matches."
msgstr "Passordet er skrevet inn og stemmer overens."

#, python-brace-format
