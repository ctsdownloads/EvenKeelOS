msgid ""
"  codecs web   Web video in Firefox only. Replaces Fedora's empty OpenH264 stand-in with\n"
"               Cisco's OpenH264 from Fedora's Cisco repository, under Cisco's own H.264\n"
"               patent license.\n"
"  codecs full  Everything. Replaces Fedora's free ffmpeg libraries with the full ffmpeg,\n"
"               x264 and x265 from RPM Fusion, the source standard Fedora uses."
msgstr ""
"  codecs web   ვებ-ვიდეო მხოლოდ Firefox-ში. Fedora-ს ცარიელ OpenH264 შემცვლელს ანაცვლებს\n"
"               Cisco-ს OpenH264-ით Fedora-ს Cisco-ს რეპოზიტორიიდან, Cisco-ს საკუთარი H.264\n"
"               პატენტის ლიცენზიით.\n"
"  codecs full  ყველაფერი. Fedora-ს თავისუფალ ffmpeg ბიბლიოთეკებს ანაცვლებს სრული ffmpeg-ით,\n"
"               x264-ითა და x265-ით RPM Fusion-დან, წყაროდან, რომელსაც ჩვეულებრივი Fedora იყენებს."

msgid ""
"  evenkeel-os-packages install [FILE]   install an .rpm or .deb (no FILE: pick one from Downloads)\n"
"  evenkeel-os-packages remove           remove an app installed this way\n"
"  evenkeel-os-packages check FILE       say what a package needs, without installing anything\n"
"  evenkeel-os-packages repair           set a broken app box up again (--if-broken: only if one does not work)\n"
"  evenkeel-os-packages login            choose box apps that start when you log in\n"
"  evenkeel-os-packages windows FILE     a Windows .exe or .msi: offer a Linux app that does its job\n"
"  evenkeel-os-packages check-windows FILE  say what a Windows file is and what would be offered, without any window\n"
"  evenkeel-os-packages zoom LINK        a Zoom \"open the app\" link: open the meeting in Zoom's web version, in Chrome\n"
"  evenkeel-os-packages vpn [NAME]       add a VPN from its company's own download source (mullvad, proton, ivpn,\n"
"                                        nordvpn; no NAME: pick one)"
msgstr ""
"  evenkeel-os-packages install [FILE]   .rpm ან .deb ფაილის დაყენება (FILE-ის გარეშე: აირჩიეთ ერთ-ერთი ჩამოტვირთვებიდან)\n"
"  evenkeel-os-packages remove           ამ გზით დაყენებული აპის წაშლა\n"
"  evenkeel-os-packages check FILE       იმის ჩვენება, რა სჭირდება პაკეტს, არაფრის დაყენების გარეშე\n"
"  evenkeel-os-packages repair           დაზიანებული აპის ყუთის ხელახლა მომზადება (--if-broken: მხოლოდ თუ რომელიმე არ მუშაობს)\n"
"  evenkeel-os-packages login            ყუთის აპების არჩევა, რომლებიც შესვლისას ეშვება\n"
"  evenkeel-os-packages windows FILE     Windows-ის .exe ან .msi: Linux-ის აპის შეთავაზება, რომელიც იმავე საქმეს აკეთებს\n"
"  evenkeel-os-packages check-windows FILE  იმის ჩვენება, რა არის Windows-ის ფაილი და რას შემოგთავაზებთ, ფანჯრის გარეშე\n"
"  evenkeel-os-packages zoom LINK        Zoom-ის „აპის გახსნის“ ბმული: შეხვედრის გახსნა Zoom-ის ვებვერსიაში, Chrome-ში\n"
"  evenkeel-os-packages vpn [NAME]       VPN-ის დამატება მისი კომპანიის საკუთარი ჩამოტვირთვის წყაროდან (mullvad, proton, ivpn,\n"
"                                        nordvpn; NAME-ის გარეშე: აირჩიეთ ერთ-ერთი)"

#, python-brace-format
msgid ""
"\"{name}\" comes with Fedora. The trusted list is rebuilt from Fedora's "
"current list at every start, so an update replaces or drops it; keep "
"automatic updates on. If this alert stays after updating and restarting, tell"
" your helper."
msgstr ""
"„{name}“ Fedora-სთან ერთად მოდის. ნდობით აღჭურვილთა სია ყოველ გაშვებაზე "
"ხელახლა იქმნება Fedora-ს მიმდინარე სიის საფუძველზე, ამიტომ განახლება მას ან "
"ცვლის, ან შლის; დატოვეთ ავტომატური განახლებები ჩართული. თუ ეს გაფრთხილება "
"განახლებისა და გადატვირთვის შემდეგაც დარჩება, აცნობეთ თქვენს დამხმარეს."

#, python-brace-format
msgid ""
"\"{name}\" has expired, but its file ({file}) holds {n} certificate, and "
"removing it would remove them all, the good ones too. Tell your helper."
msgid_plural ""
"\"{name}\" has expired, but its file ({file}) holds {n} certificates, and "
"removing it would remove them all, the good ones too. Tell your helper."
msgstr[0] ""
"„{name}“ ვადაგასულია, მაგრამ მის ფაილში ({file}) {n} სერტიფიკატია, და მისი "
"წაშლა ყველა სერტიფიკატს წაშლის, მათ შორის კარგებსაც. აცნობეთ თქვენს "
"დამხმარეს."

#, python-brace-format
msgid ""
"\"{name}\" has expired. It was added in a way Wheelhouse can't remove; tell "
"your helper."
msgstr ""
"„{name}“ ვადაგასულია. ის ისე დაემატა, რომ Wheelhouse-ს მისი წაშლა არ შეუძლია;"
" შეატყობინეთ თქვენს დამხმარეს."

#, python-brace-format
msgid "\"{name}\" is removed and no longer trusted."
msgstr "„{name}“ წაშლილია და აღარ არის სანდო."

#, python-brace-format
msgid ""
"\"{name}\" was added to this computer and expired on {date}. An expired "
"certificate shouldn't be relied on. Remove it if you no longer need it; if "
"you do, ask whoever gave it to you for a new one. Removing it needs your "
"password."
msgstr ""
"„{name}“ დაემატა ამ კომპიუტერს და ვადა გაუვიდა {date}-ს. ვადაგასულ "
"სერტიფიკატს არ უნდა ენდობოდეთ. წაშალეთ, თუ აღარ გჭირდებათ; თუ გჭირდებათ, "
"სთხოვეთ ახალი იმას, ვინც მოგცათ. მის წასაშლელად თქვენი პაროლია საჭირო."

#, python-brace-format
msgid ""
"\"{name}\" was added to this computer and expires on {date}. Ask whoever gave"
" it to you for a new one before then."
msgstr ""
"„{name}“ დაემატა ამ კომპიუტერს და მისი ვადა იწურება {date}-ს. მანამდე სთხოვეთ"
" ახალი იმას, ვინც ის მოგცათ."

#. Translators: a weekday and date ("Thursday, November 26"). Uses strftime codes.
msgid "%A, %B %-d"
msgstr "%A, %-d %B"

#. Translators: a date: month and day ("November 26"). Uses strftime codes.
msgid "%B %-d"
msgstr "%-d %B"

#. Translators: a date and a 12-hour time ("November 26, 7:02 PM"). Uses strftime codes.
msgid "%B %-d, %-I:%M %p"
msgstr "%-d %B, %-I:%M %p"

#. Translators: a date and a 24-hour time ("November 26, 19:02"). Uses strftime codes.
msgid "%B %-d, %H:%M"
msgstr "%-d %B, %H:%M"

msgid "(nothing was printed)"
msgstr "(არაფერი გამოტანილა)"

#, python-brace-format
msgid "- and {n} more"
msgid_plural "- and {n} more"
msgstr[0] "- და კიდევ {n}"

msgid ""
"1.00 is the normal size. Large text in Settings, Accessibility sets 1.25."
msgstr ""
"1,00 ნორმალური ზომაა. „დიდი ტექსტი“ („მორგება“, „დამხმარე საშუალებები“) "
"აყენებს 1,25-ს."

msgid "12 hour"
msgstr "12-საათიანი"

msgid "24 hour"
msgstr "24-საათიანი"

msgid ""
"A .deb driver can't be installed. The window says how to get the .rpm from "
"the maker."
msgstr ""
".deb დრაივერის დაყენება შეუძლებელია. ფანჯარაში წერია, როგორ მიიღოთ .rpm ფაილი"
" მწარმოებლისგან."

msgid "A USB mouse works."
msgstr "USB თაგუნა მუშაობს."

msgid "A USB webcam works."
msgstr "USB-ვებკამერა მუშაობს."

msgid "A VPN"
msgstr "VPN"

msgid "A Windows program you downloaded (.exe or .msi)"
msgstr "თქვენ მიერ ჩამოტვირთული Windows-ის პროგრამა (.exe ან .msi)"

msgid "A background service fails"
msgstr "ფონური სერვისი ვერ მუშაობს"

msgid ""
"A background service that runs on this computer fails to start (the mobile "
"broadband service, or the graphics switching service)."
msgstr ""
"ამ კომპიუტერზე მომუშავე ფონური სერვისის გაშვება ვერ ხერხდება (მობილური "
"ინტერნეტ-კავშირის სერვისი ან გრაფიკული რეჟიმების გადართვის სერვისი)."

msgid "A bottom bar, with a start menu on the logo"
msgstr "ქვედა ზოლი, ლოგოზე განთავსებული საწყისი მენიუთი"

msgid "A broken app box"
msgstr "დაზიანებული აპის ყუთი"

msgid "A built-in camera of the newer laptop kind was found."
msgstr "აღმოჩენილია ახალი ტიპის ლეპტოპის ჩაშენებული კამერა."

msgid "A café, hotel, airport, or anywhere else. Nothing gets in."
msgstr "კაფე, სასტუმრო, აეროპორტი ან ნებისმიერი სხვა ადგილი. არაფერი შემოვა."

#, python-brace-format
msgid "A certificate needs attention"
msgid_plural "{n} certificates need attention"
msgstr[0] "{n} სერტიფიკატს ყურადღება სჭირდება"

msgid ""
"A change to the boot options is waiting. It starts at your next restart. It isn't an update.\n"
"\n"
"If you don't want it: Don't use it. The computer starts with the boot options it has now, and automatic updates aren't paused.\n"
"\n"
"Or Keep it."
msgstr ""
"ჩატვირთვის პარამეტრების ცვლილება მოლოდინშია. ის მომდევნო გადატვირთვისას ამოქმედდება. ეს განახლება არ არის.\n"
"\n"
"თუ არ გსურთ: „ნუ გამოიყენებთ“. კომპიუტერი ჩაირთვება ახლანდელი ჩატვირთვის პარამეტრებით, ავტომატური განახლებები კი არ შეჩერდება.\n"
"\n"
"ან „დატოვება“."

msgid "A device"
msgstr "მოწყობილობა"

#, python-brace-format
msgid "A device lost its driver ({driver})"
msgstr "მოწყობილობამ დაკარგა თავისი დრაივერი ({driver})"

msgid "A disk is hidden."
msgstr "დისკი დამალულია."

msgid "A driver file from the maker"
msgstr "მწარმოებლის მიერ მოწოდებული დრაივერის ფაილი"

msgid "A file of recent errors to email to your helper"
msgstr ""
"ბოლო შეცდომების ფაილი, რომელიც თქვენს დამხმარეს უნდა გაუგზავნოთ ელფოსტით"

msgid "A full name can't have : or , in it."
msgstr "სრულ სახელს არ შეიძლება ჰქონდეს : ან , სიმბოლოები."

msgid "A graphics chip has no driver."
msgstr "გრაფიკულ ჩიპს არ აქვს დრაივერი."

msgid ""
"A network is only needed for automatic time and time zone. To use Wi-Fi, "
"click a network. Or click Next to go on without it."
msgstr ""
"ქსელი მხოლოდ ავტომატური დროისა და დროის სარტყლისთვის არის საჭირო. Wi-Fi-ის "
"გამოსაყენებლად დააწკაპუნეთ ქსელზე. ან დააწკაპუნეთ ღილაკზე „შემდეგი“, რომ "
"გააგრძელოთ ამის გარეშე."

msgid ""
"A new layout shows after you log out and back in. It changes only your own "
"desktop."
msgstr ""
"ახალი განლაგება გამოჩნდება, როცა გამოხვალთ და კვლავ შეხვალთ. ეს მხოლოდ თქვენს"
" სამუშაო მაგიდას ცვლის."

msgid "A new system is ready."
msgstr "ახალი სისტემა მზად არის."

msgid "A new system is ready. Restart to use it."
msgstr "ახალი სისტემა მზად არის. გამოყენებისთვის გადატვირთეთ."

msgid ""
"A new system version is used from the next restart. Keep working, and restart"
" when it suits you."
msgstr ""
"ახალი სისტემის ვერსია მომდევნო გადატვირთვის შემდეგ იქნება გამოყენებული. "
"გააგრძელეთ მუშაობა და გადატვირთეთ, როცა თქვენთვის მოსახერხებელი იქნება."

msgid ""
"A new version also goes back if something that worked before is broken after "
"you log in, like sound, Wi-Fi, Bluetooth, the camera or printing. Unplugged "
"or switched-off things don't count."
msgstr ""
"კომპიუტერი წინა ვერსიაზე მაშინაც ბრუნდება, თუ შესვლის შემდეგ რამე, რაც ადრე "
"მუშაობდა, აღარ მუშაობს, მაგალითად ხმა, Wi-Fi, Bluetooth, კამერა ან ბეჭდვა. "
"გამოერთებული ან გამორთული მოწყობილობები არ ითვლება."

msgid "A new version is ready"
msgstr "ახალი ვერსია მზად არის"

msgid ""
"A note at the next login says so and names what broke, and automatic updates "
"pause for 3 days."
msgstr ""
"ამის შესახებ შეტყობინება გამოჩნდება მომდევნო შესვლისას, მიეთითება, რა "
"გაფუჭდა, და ავტომატური განახლებები 3 დღით შეჩერდება."

msgid ""
"A rollback test copy is running. Restart first, so the computer goes back to "
"the usual version."
msgstr ""
"გაშვებულია დაბრუნების სატესტო ასლი. ჯერ გადატვირთეთ, რომ კომპიუტერი "
"ჩვეულებრივ ვერსიას დაუბრუნდეს."

msgid "A security certificate expired, expires within 30 days, or was removed."
msgstr ""
"უსაფრთხოების სერტიფიკატს ვადა გაუვიდა, ვადა 30 დღის განმავლობაში გასდის, ან "
"ის წაშლილია."

msgid "A slideshow of your own pictures"
msgstr "თქვენი სურათების სლაიდშოუ"

msgid "A sound chip was found, but it didn't start."
msgstr "ხმის ჩიპი აღმოჩენილია, მაგრამ ის არ ჩაირთო."

msgid "A start-up check fails"
msgstr "ჩართვისას შემოწმება ვერ შესრულდა"

msgid ""
"A start-up check fails on purpose. The computer restarts by itself within "
"seconds, twice, and the third start is back on this version."
msgstr ""
"ჩართვისას შემოწმება განზრახ ვერ სრულდება. კომპიუტერი რამდენიმე წამში თავისით "
"ორჯერ გადაიტვირთება, მესამე ჩართვისას კი ისევ ამ ვერსიაზე იქნება."

msgid "A system service fails"
msgstr "სისტემური სერვისი ვერ მუშაობს"

msgid "A system update is also waiting for a restart."
msgstr "სისტემის განახლებაც გადატვირთვას ელის."

msgid "A tool"
msgstr "ხელსაწყო"

msgid "A top bar, with the logo menu at the top left"
msgstr "ზედა ზოლი, ზედა მარცხენა კუთხეში განთავსებული ლოგოს მენიუთი"

msgid ""
"A user name uses small letters, digits, - and _, and starts with a letter."
msgstr ""
"მომხმარებლის სახელი შედგება პატარა ასოებისგან, ციფრებისგან, სიმბოლოებისგან "
"„-“ და „_“, და იწყება ასოთი."

msgid ""
"A wired network is set to Home, so this happens on any cable you plug in."
msgstr ""
"სადენიანი ქსელი დაყენებულია რეჟიმზე „სახლი“, ამიტომ ეს მოხდება ნებისმიერ "
"კაბელზე, რომელსაც შეაერთებთ."

msgid "A wireless chip was found, but it didn't start."
msgstr "აღმოჩენილია უსადენო ჩიპი, მაგრამ ის არ ჩაირთო."

msgid "A wireless chip was found, with no driver for it."
msgstr "აღმოჩენილია უსადენო ჩიპი, მაგრამ მისთვის არ არის დრაივერი."

msgid "AMD: flicker, turn off Panel Replay"
msgstr "AMD: ციმციმი, გამორთეთ Panel Replay"

msgid "AMD: flicker, turn off Panel Self Refresh"
msgstr "AMD: ციმციმი, გამორთეთ პანელის თვითგანახლება (Panel Self Refresh)"

msgid "AMD: flicker, turn off both"
msgstr "AMD: ციმციმი, გამორთეთ ორივე"

