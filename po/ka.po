msgstr "აქცენტის ფერი და ფონი"

msgid "Account"
msgstr "ანგარიში"

msgid "Add"
msgstr "დამატება"

msgid "Add a folder"
msgstr "საქაღალდის დამატება"

msgid "Add a folder and set the sharing password below."
msgstr "დაამატეთ საქაღალდე და ქვემოთ დააყენეთ გაზიარების პაროლი."

msgid "Add a folder from your home folder."
msgstr "დაამატეთ საქაღალდე თქვენი საწყისი საქაღალდიდან."

msgid "Add a printer"
msgstr "პრინტერის დამატება"

msgid "Add a setting, like amdgpu.abmlevel=0"
msgstr "დაამატეთ პარამეტრი, მაგალითად, amdgpu.abmlevel=0"

msgid "Add anyway"
msgstr "მაინც დამატება"

msgid "Add it"
msgstr "დაამატეთ"

msgid ""
"Add it only if you know you need it. If the computer then won't start, "
"automatic rollback goes back to the version before."
msgstr ""
"დაამატეთ მხოლოდ იმ შემთხვევაში, თუ იცით, რომ გჭირდებათ. თუ კომპიუტერი ამის "
"შემდეგ არ ჩაირთვება, ავტომატური დაბრუნება მოქმედებს და სისტემა ბრუნდება წინა "
"ვერსიაზე."

msgid "Add or remove an app's hardware rules"
msgstr "აპის აპარატურული წესების დამატება ან წაშლა"

