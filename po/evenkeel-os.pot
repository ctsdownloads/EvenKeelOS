msgid ""
"  codecs web   Web video in Firefox only. Replaces Fedora's empty OpenH264 "
"stand-in with\n"
"               Cisco's OpenH264 from Fedora's Cisco repository, under "
"Cisco's own H.264\n"
"               patent license.\n"
"  codecs full  Everything. Replaces Fedora's free ffmpeg libraries with the "
"full ffmpeg,\n"
"               x264 and x265 from RPM Fusion, the source standard Fedora "
"uses."
msgstr ""

msgid ""
"  evenkeel-os-packages install [FILE]   install an .rpm or .deb (no FILE: "
"pick one from Downloads)\n"
"  evenkeel-os-packages remove           remove an app installed this way\n"
"  evenkeel-os-packages check FILE       say what a package needs, without "
"installing anything\n"
"  evenkeel-os-packages repair           set a broken app box up again (--if-"
"broken: only if one does not work)\n"
"  evenkeel-os-packages login            choose box apps that start when you "
"log in\n"
"  evenkeel-os-packages windows FILE     a Windows .exe or .msi: offer a "
"Linux app that does its job\n"
"  evenkeel-os-packages check-windows FILE  say what a Windows file is and "
"what would be offered, without any window\n"
"  evenkeel-os-packages zoom LINK        a Zoom \"open the app\" link: open "
"the meeting in Zoom's web version, in Chrome\n"
"  evenkeel-os-packages vpn [NAME]       add a VPN from its company's own "
"download source (mullvad, proton, ivpn,\n"
"                                        nordvpn; no NAME: pick one)"
msgstr ""

