<?xml version="1.0"?>
<!-- Which parts of a polkit .policy file people read: each action's description and message. -->
<its:rules xmlns:its="http://www.w3.org/2005/11/its" version="2.0">
  <its:translateRule selector="/policyconfig" translate="no"/>
  <its:translateRule selector="//action/description | //action/message" translate="yes"/>
</its:rules>
