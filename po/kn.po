msgstr "ಕಂಪ್ಯೂಟರ್‌ನ ಸ್ಥಳದಿಂದ (ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ)"

msgid "From time servers on the internet (recommended)"
msgstr "ಇಂಟರ್ನೆಟ್‌ನಲ್ಲಿರುವ ಸಮಯ ಸರ್ವರ್‌ಗಳಿಂದ (ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ)"

msgid "From your next restart, the disk unlocks by itself."
msgstr "ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಿಂದ, ಡಿಸ್ಕ್ ತನ್ನಷ್ಟಕ್ಕೇ ಅನ್‌ಲಾಕ್ ಆಗುತ್ತದೆ."

msgid "Full name"
msgstr "ಪೂರ್ಣ ಹೆಸರು"

#, python-brace-format
msgid "Full name: {name}. User name: {username}."
msgstr "ಪೂರ್ಣ ಹೆಸರು: {name}. ಬಳಕೆದಾರ ಹೆಸರು: {username}."

msgid "Get a VPN"
msgstr "VPN ಪಡೆಯಿರಿ"

msgid "Get a VPN is open"
msgstr "VPN ಪಡೆಯಿರಿ ತೆರೆದಿದೆ"

msgid "Get an app"
msgstr "ಆ್ಯಪ್ ಪಡೆಯಿರಿ"

msgid "Get apps"
msgstr "ಆ್ಯಪ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ"

msgid "Get help"
msgstr "ಸಹಾಯ ಪಡೆಯಿರಿ"

msgid "Getting Ubuntu's list of packages"
msgstr "Ubuntu ನ ಪ್ಯಾಕೇಜ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು ಪಡೆಯಲಾಗುತ್ತಿದೆ"

msgid ""
"Getting apps, Windows programs, package files, removing apps, default apps, "
"Zoom, VPNs and codecs"
msgstr ""
"ಆ್ಯಪ್‌ಗಳನ್ನು ಪಡೆಯುವುದು, Windows ಪ್ರೋಗ್ರಾಂಗಳು, ಪ್ಯಾಕೇಜ್ ಫೈಲ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳನ್ನು"
" ತೆಗೆದುಹಾಕುವುದು, ಡೀಫಾಲ್ಟ್ ಆ್ಯಪ್‌ಗಳು, Zoom, VPN‌ಗಳು ಮತ್ತು ಕೋಡೆಕ್‌ಗಳು"

msgid ""
"Getting apps:\n"
"\n"
"- Most apps: Bazaar, the app store. Find the app there and install it.\n"
"- An app that comes as a file (.rpm or .deb): open the file, or open Install Package File, which lists the files in your Downloads folder. It's in Wheelhouse, Apps.\n"
"- Removing those apps: Wheelhouse, Apps, Remove apps.\n"
"\n"
"Wheelhouse has the rest: updates, disk space, undoing an update, and saving problem details for your helper.\n"
"\n"
"Recommended: Open Bazaar, to see it. Or Open Install Package File. Or Next."
msgstr ""
"ಆ್ಯಪ್‌ಗಳನ್ನು ಪಡೆಯುವುದು:\n"
"\n"
"- ಹೆಚ್ಚಿನ ಆ್ಯಪ್‌ಗಳು: Bazaar, ಆ್ಯಪ್ ಸ್ಟೋರ್. ಅಲ್ಲಿ ಆ್ಯಪ್ ಅನ್ನು ಹುಡುಕಿ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ.\n"
"- ಫೈಲ್ ಆಗಿ ಬರುವ ಆ್ಯಪ್ (.rpm ಅಥವಾ .deb): ಫೈಲ್ ಅನ್ನು ತೆರೆಯಿರಿ, ಅಥವಾ \"ಪ್ಯಾಕೇಜ್ ಫೈಲ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ತೆರೆಯಿರಿ, ಅದು ನಿಮ್ಮ ಡೌನ್‌ಲೋಡ್‌ಗಳು ಫೋಲ್ಡರ್‌ನಲ್ಲಿರುವ ಫೈಲ್‌ಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡುತ್ತದೆ. ಅದು Wheelhouse, ಆ್ಯಪ್‌ಗಳು ಇಲ್ಲಿದೆ.\n"
"- ಆ ಆ್ಯಪ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕುವುದು: Wheelhouse, ಆ್ಯಪ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿ.\n"
"\n"
"ಉಳಿದವು Wheelhouse ನಲ್ಲಿವೆ: ಅಪ್‌ಡೇಟ್‌ಗಳು, ಡಿಸ್ಕ್ ಸ್ಥಳ, ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸುವುದು, ಮತ್ತು ನಿಮ್ಮ ಸಹಾಯಕರಿಗಾಗಿ ಸಮಸ್ಯೆಯ ವಿವರಗಳನ್ನು ಉಳಿಸುವುದು.\n"
"\n"
"ಶಿಫಾರಸು: ಅದನ್ನು ನೋಡಲು Bazaar ತೆರೆಯಿರಿ. ಅಥವಾ \"ಪ್ಯಾಕೇಜ್ ಫೈಲ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ತೆರೆಯಿರಿ. ಅಥವಾ ಮುಂದೆ."

msgid "Getting help"
msgstr "ಸಹಾಯ ಪಡೆಯುವುದು"

msgid "Getting ready"
msgstr "ಸಿದ್ಧಪಡಿಸಲಾಗುತ್ತಿದೆ"

msgid "Getting started"
msgstr "ಪ್ರಾರಂಭಿಸುವುದು"

msgid "Getting the list of apps from the new download source."
msgstr "ಹೊಸ ಡೌನ್‌ಲೋಡ್ ಮೂಲದಿಂದ ಆ್ಯಪ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು ಪಡೆಯಲಾಗುತ್ತಿದೆ."

#, python-brace-format
msgid "Getting the {label} ready. The first time takes a few minutes."
msgstr ""
"{label} ಅನ್ನು ಸಿದ್ಧಪಡಿಸಲಾಗುತ್ತಿದೆ. ಮೊದಲ ಬಾರಿಗೆ ಇದು ಕೆಲವು ನಿಮಿಷಗಳನ್ನು "
"ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ."

msgid "Getting what it runs on from Flathub"
msgstr "ಇದು ಚಲಿಸಲು ಬೇಕಾದುದನ್ನು Flathub ನಿಂದ ಪಡೆಯಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Give it a name of 1 to {max} characters."
msgstr "ಅದಕ್ಕೆ 1 ರಿಂದ {max} ಅಕ್ಷರಗಳ ಹೆಸರನ್ನು ಇಡಿ."

msgid "Glitches on newer AMD chips"
msgstr "ಹೊಸ AMD ಚಿಪ್‌ಗಳಲ್ಲಿನ ತೊಂದರೆಗಳು"

msgid "Go back now"
msgstr "ಈಗಲೇ ಹಿಂತಿರುಗಿ"

msgid "Go back to the version from before the last update"
msgstr "ಕೊನೆಯ ಅಪ್‌ಡೇಟ್‌ಗೆ ಮುಂಚಿನ ಆವೃತ್ತಿಗೆ ಹಿಂತಿರುಗಿ"

msgid ""
"Go back to the version from before the last update. Automatic updates then "
"pause for 3 days."
msgstr ""
"ಕೊನೆಯ ಅಪ್‌ಡೇಟ್‌ಗೆ ಮುಂಚಿನ ಆವೃತ್ತಿಗೆ ಹಿಂತಿರುಗಿ. ನಂತರ ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು 3 "
"ದಿನಗಳ ಕಾಲ ವಿರಾಮಗೊಳ್ಳುತ್ತವೆ."

msgid "Good"
msgstr "ಉತ್ತಮ"

msgid "Graphics"
msgstr "ಗ್ರಾಫಿಕ್ಸ್"

#, python-brace-format
msgid "Graphics ({driver})"
msgstr "ಗ್ರಾಫಿಕ್ಸ್ ({driver})"

msgid "Graphics driver blocked"
msgstr "ಗ್ರಾಫಿಕ್ಸ್ ಡ್ರೈವರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ"

msgid "Hardware rule"
msgstr "ಹಾರ್ಡ್‌ವೇರ್ ನಿಯಮ"

msgid "Hidden folders hold settings and keys. They can't be shared."
msgstr ""
"ಗುಪ್ತ ಫೋಲ್ಡರ್‌ಗಳು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮತ್ತು ಕೀಗಳನ್ನು ಒಳಗೊಂಡಿರುತ್ತವೆ. ಅವುಗಳನ್ನು "
"ಹಂಚಿಕೊಳ್ಳಲು ಆಗುವುದಿಲ್ಲ."

msgid "Home"
msgstr "ಮನೆ"

msgid ""
"Home lets in phones, file sharing and apps you run. Work and a Public place "
"let nothing in."
msgstr ""
"ಮನೆ ನೆಟ್‌ವರ್ಕ್ ಫೋನ್‌ಗಳು, ಫೈಲ್ ಹಂಚಿಕೆ ಮತ್ತು ನೀವು ಚಲಾಯಿಸುವ ಆ್ಯಪ್‌ಗಳನ್ನು ಒಳಗೆ "
"ಬಿಡುತ್ತದೆ. ಕೆಲಸದ ಸ್ಥಳ ಮತ್ತು ಸಾರ್ವಜನಿಕ ಸ್ಥಳ ಏನನ್ನೂ ಒಳಗೆ ಬಿಡುವುದಿಲ್ಲ."

msgid "Home, Work or Public place"
msgstr "ಮನೆ, ಕೆಲಸದ ಸ್ಥಳ ಅಥವಾ ಸಾರ್ವಜನಿಕ ಸ್ಥಳ"

msgid "Home, Work or Public place, and what each lets in"
msgstr ""
"ಮನೆ, ಕೆಲಸದ ಸ್ಥಳ ಅಥವಾ ಸಾರ್ವಜನಿಕ ಸ್ಥಳ, ಮತ್ತು ಪ್ರತಿಯೊಂದೂ ಏನನ್ನು ಒಳಗೆ ಬಿಡುತ್ತದೆ"

msgid ""
"Home: your phone and other computers can reach apps that ask for it, like "
"file sharing."
msgstr ""
"ಮನೆ: ನಿಮ್ಮ ಫೋನ್ ಮತ್ತು ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳು, ಫೈಲ್ ಹಂಚಿಕೆಯಂತಹ, ಇದನ್ನು ಕೇಳುವ "
"ಆ್ಯಪ್‌ಗಳನ್ನು ತಲುಪಬಹುದು."

msgid "Hour"
msgstr "ಗಂಟೆ"

msgid "How should the clock show the time?"
msgstr "ಗಡಿಯಾರವು ಸಮಯವನ್ನು ಹೇಗೆ ತೋರಿಸಬೇಕು?"

msgid ""
"How should the desktop look? Click one. You can switch later in Wheelhouse."
msgstr ""
"ಡೆಸ್ಕ್‌ಟಾಪ್ ಹೇಗೆ ಕಾಣಿಸಬೇಕು? ಒಂದನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ. ನೀವು ನಂತರ Wheelhouse ನಲ್ಲಿ "
"ಬದಲಾಯಿಸಬಹುದು."

msgid "How to do things"
msgstr "ಕಾರ್ಯಗಳನ್ನು ಹೇಗೆ ಮಾಡುವುದು"

msgid "How to do things on EvenKeelOS, step by step."
msgstr "EvenKeelOS ನಲ್ಲಿ ಕೆಲಸಗಳನ್ನು ಹೇಗೆ ಮಾಡುವುದು, ಹಂತ ಹಂತವಾಗಿ."

msgid "How to do things, step by step"
msgstr "ಕಾರ್ಯಗಳನ್ನು ಹೇಗೆ ಮಾಡುವುದು, ಹಂತ ಹಂತವಾಗಿ"

msgid "How to do things, step by step: the desktop, files, apps and more"
msgstr ""
"ಕಾರ್ಯಗಳನ್ನು ಹೇಗೆ ಮಾಡುವುದು, ಹಂತ ಹಂತವಾಗಿ: ಡೆಸ್ಕ್‌ಟಾಪ್, ಫೈಲ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳು "
"ಮತ್ತು ಇನ್ನಷ್ಟು"

msgid "I already use Linux"
msgstr "ನಾನು ಈಗಾಗಲೇ Linux ಬಳಸುತ್ತಿದ್ದೇನೆ"

msgid "IANA port list"
msgstr "IANA ಪೋರ್ಟ್‌ಗಳ ಪಟ್ಟಿ"

msgid ""
"If it happens again, tell your helper. Save problem details in Wheelhouse "
"makes a file to send them."
msgstr ""
"ಇದು ಮತ್ತೆ ಆದರೆ, ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ. Wheelhouse ನಲ್ಲಿರುವ \"ಸಮಸ್ಯೆಯ "
"ವಿವರಗಳನ್ನು ಉಳಿಸಿ\" ಅವುಗಳನ್ನು ಕಳುಹಿಸಲು ಒಂದು ಫೈಲ್ ರಚಿಸುತ್ತದೆ."

msgid "If it started after an update, go back to the version from before it"
msgstr ""
"ಇದು ಅಪ್‌ಡೇಟ್‌ನ ನಂತರ ಪ್ರಾರಂಭವಾದಲ್ಲಿ, ಅದಕ್ಕಿಂತ ಹಿಂದಿನ ಆವೃತ್ತಿಗೆ ಹಿಂತಿರುಗಿ"

msgid ""
"If something stopped working after an update, open Wheelhouse, Updates, Undo "
"the last update."
msgstr ""
"ಅಪ್‌ಡೇಟ್‌ನ ನಂತರ ಏನಾದರೂ ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿದಲ್ಲಿ, Wheelhouse ತೆರೆಯಿರಿ, "
"ಅಪ್‌ಡೇಟ್‌ಗಳು, ಕೊನೆಯ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಿ."

msgid "If something went wrong"
msgstr "ಏನಾದರೂ ತಪ್ಪಾದಲ್ಲಿ"

msgid "If the computer won't start properly"
msgstr "ಕಂಪ್ಯೂಟರ್ ಸರಿಯಾಗಿ ಪ್ರಾರಂಭವಾಗದಿದ್ದರೆ"

msgid ""
"If the disk is encrypted, its password is typed when the computer starts, "
"before EvenKeelOS loads. Which keyboard layout is used then?"
msgstr ""
"ಡಿಸ್ಕ್ ಅನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ್ದರೆ, ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾದಾಗ, EvenKeelOS ಲೋಡ್ "
"ಆಗುವ ಮೊದಲು ಅದರ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಟೈಪ್ ಮಾಡಲಾಗುತ್ತದೆ. ಆಗ ಯಾವ ಕೀಬೋರ್ಡ್ ಲೇಔಟ್ "
"ಅನ್ನು ಬಳಸಲಾಗುತ್ತದೆ?"

msgid ""
"If updates are listed, click Update and type your password. Some finish while"
" the computer restarts."
msgstr ""
"ಅಪ್‌ಡೇಟ್‌ಗಳು ಪಟ್ಟಿಯಲ್ಲಿದ್ದರೆ, \"ಅಪ್‌ಡೇಟ್ ಮಾಡಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ "
"ಪಾಸ್‌ವರ್ಡ್ ಟೈಪ್ ಮಾಡಿ. ಕೆಲವು ಅಪ್‌ಡೇಟ್‌ಗಳು ಕಂಪ್ಯೂಟರ್ ಮರುಪ್ರಾರಂಭವಾಗುವಾಗ "
"ಮುಗಿಯುತ್ತವೆ."

msgid ""
"If you type a disk password every time the computer starts, it can unlock by "
"itself with the computer's security chip."
msgstr ""
"ನೀವು ಕಂಪ್ಯೂಟರ್ ಪ್ರತಿ ಬಾರಿ ಪ್ರಾರಂಭವಾದಾಗ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಟೈಪ್ "
"ಮಾಡುತ್ತಿದ್ದರೆ, ಕಂಪ್ಯೂಟರ್‌ನ ಸೆಕ್ಯುರಿಟಿ ಚಿಪ್‌ನಿಂದ ಅದು ತನ್ನಷ್ಟಕ್ಕೇ ಅನ್‌ಲಾಕ್ "
"ಆಗಬಹುದು."

msgid ""
"If yours does, download the maker's .rpm file and open it from Downloads. "
"Wheelhouse sees that it's a printer driver."
msgstr ""
"ನಿಮ್ಮ ಪ್ರಿಂಟರ್‌ಗೆ ಅದು ಬೇಕಿದ್ದರೆ, ತಯಾರಕರ .rpm ಫೈಲ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು "
"ಅದನ್ನು ಡೌನ್‌ಲೋಡ್‌ಗಳಿಂದ ತೆರೆಯಿರಿ. Wheelhouse ಅದು ಪ್ರಿಂಟರ್ ಡ್ರೈವರ್ ಎಂದು "
"ಗುರುತಿಸುತ್ತದೆ."

msgid "Important settings deleted"
msgstr "ಪ್ರಮುಖ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅಳಿಸಲಾಗಿದೆ"

msgid ""
"Important system settings are really deleted, and the computer restarts right"
" away. The next start finds them missing, puts them back from the copy it "
"saved, and restarts once more by itself. A message at login then lists what "
"was put back."
msgstr ""
"ಪ್ರಮುಖ ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ನಿಜವಾಗಿಯೂ ಅಳಿಸಲಾಗುತ್ತದೆ, ಮತ್ತು ಕಂಪ್ಯೂಟರ್ "
"ತಕ್ಷಣವೇ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ಮುಂದಿನ ಬಾರಿಗೆ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಪ್ರಾರಂಭಿಸಿದಾಗ ಅವು "
"ಕಾಣೆಯಾಗಿರುವುದನ್ನು ಅದು ಗುರುತಿಸುತ್ತದೆ, ತಾನು ಸೇವ್ ಮಾಡಿರುವ ನಕಲಿನಿಂದ ಅವುಗಳನ್ನು "
"ಮರಳಿ ಇರಿಸುತ್ತದೆ ಮತ್ತು ಸ್ವತಃ ಮತ್ತೊಮ್ಮೆ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ನಂತರ ಲಾಗಿನ್ "
"ಮಾಡುವಾಗ ಒಂದು ಸಂದೇಶವು ಯಾವವುಗಳನ್ನು ಮರಳಿ ಇರಿಸಲಾಗಿದೆ ಎಂಬುದನ್ನು ಪಟ್ಟಿ ಮಾಡುತ್ತದೆ."

msgid ""
"In a box it updates with System Update; added to the system it never updates."
msgstr ""
"ಒಂದು ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಅದು ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್‌ನೊಂದಿಗೆ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ; ಸಿಸ್ಟಂಗೆ "
"ಸೇರಿಸಿದಾಗ ಅದು ಎಂದಿಗೂ ಅಪ್‌ಡೇಟ್ ಆಗುವುದಿಲ್ಲ."

msgid "In the box, these won't work:"
msgstr "ಈ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಇವು ಕೆಲಸ ಮಾಡುವುದಿಲ್ಲ:"

msgid "In use"
