msgid "{path} already exists and belongs to something else."
msgstr "{path} ಈಗಾಗಲೇ ಇದೆ ಮತ್ತು ಅದು ಬೇರೊಂದು ವಿಷಯಕ್ಕೆ ಸೇರಿದೆ."

#, python-brace-format
msgid "{path} doesn't belong to an installed package."
msgstr "{path} ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿರುವ ಯಾವುದೇ ಪ್ಯಾಕೇಜ್‌ಗೆ ಸೇರಿಲ್ಲ."

#, python-brace-format
msgid "{path} is in use and could not be closed."
msgstr "{path} ಬಳಕೆಯಲ್ಲಿದೆ ಮತ್ತು ಅದನ್ನು ಮುಚ್ಚಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#, python-brace-format
msgid "{path} is in use and could not be stopped."
msgstr "{path} ಬಳಕೆಯಲ್ಲಿದೆ ಮತ್ತು ಅದನ್ನು ನಿಲ್ಲಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#, python-brace-format
msgid "{path} is in use as swap and could not be freed."
msgstr ""
"{path} ಅನ್ನು ಸ್ವಾಪ್ ಆಗಿ ಬಳಸಲಾಗುತ್ತಿದೆ ಮತ್ತು ಅದನ್ನು ಮುಕ್ತಗೊಳಿಸಲು "
"ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#, python-brace-format
msgid "{path} is open and could not be closed."
msgstr "{path} ತೆರೆದಿದೆ ಮತ್ತು ಅದನ್ನು ಮುಚ್ಚಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#, python-brace-format
msgid "{path} on this disk is in use and could not be freed."
msgstr ""
"ಈ ಡಿಸ್ಕ್‌ನಲ್ಲಿರುವ {path} ಬಳಕೆಯಲ್ಲಿದೆ ಮತ್ತು ಅದನ್ನು ಮುಕ್ತಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#, python-brace-format
msgid ""
"{path} was changed on this computer and no longer reads the shared folders "
"list."
msgstr ""
"{path} ಅನ್ನು ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಬದಲಾಯಿಸಲಾಗಿದೆ ಮತ್ತು ಅದು ಇನ್ನು ಹಂಚಿದ ಫೋಲ್ಡರ್‌ಗಳ"
" ಪಟ್ಟಿಯನ್ನು ಓದುವುದಿಲ್ಲ."

#, python-brace-format
msgid ""
"{path} was changed on this computer. Put back the EvenKeelOS version to use "
"Shared folders."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ {path} ಅನ್ನು ಬದಲಾಯಿಸಲಾಗಿದೆ. ಹಂಚಿದ ಫೋಲ್ಡರ್‌ಗಳು ಬಳಸಲು "
"EvenKeelOS ಆವೃತ್ತಿಯನ್ನು ಮರಳಿ ಇರಿಸಿ."

#, python-brace-format
msgid "{path}, has encrypted data"
msgstr "{path}, ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಡೇಟಾವನ್ನು ಹೊಂದಿದೆ"

#, python-brace-format
msgid "{path}. Folder not found: it was moved or deleted."
msgstr "{path}. ಫೋಲ್ಡರ್ ಕಂಡುಬಂದಿಲ್ಲ: ಅದನ್ನು ಸ್ಥಳಾಂತರಿಸಲಾಗಿದೆ ಅಥವಾ ಅಳಿಸಲಾಗಿದೆ."

#, no-python-format, python-brace-format
msgid "{percent}% done. {step}..."
msgstr "{percent}% ಪೂರ್ಣಗೊಂಡಿದೆ. {step}..."

#, python-brace-format
msgid "{ports}. {source}"
msgstr "{ports}. {source}"

#, python-brace-format
msgid "{service} is always let in here."
msgstr "{service} ಅನ್ನು ಇಲ್ಲಿ ಯಾವಾಗಲೂ ಒಳಗೆ ಬಿಡಲಾಗುತ್ತದೆ."

#, python-brace-format
msgid "{service} isn't an app on this computer's list."
msgstr "{service} ಈ ಕಂಪ್ಯೂಟರ್‌ನ ಪಟ್ಟಿಯಲ್ಲಿರುವ ಆ್ಯಪ್ ಅಲ್ಲ."

#, python-brace-format
msgid "{settings} is added from the next restart."
msgstr "ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಿಂದ {settings} ಅನ್ನು ಸೇರಿಸಲಾಗುತ್ತದೆ."

#, python-brace-format
msgid "{setting} is for Wheelhouse's own tests (Test automatic rollback)."
msgstr ""
"{setting} ಎಂಬುದು Wheelhouse ನ ಸ್ವಂತ ಪರೀಕ್ಷೆಗಳಿಗಾಗಿ (ಸ್ವಯಂಚಾಲಿತ ರೋಲ್‌ಬ್ಯಾಕ್ "
"ಅನ್ನು ಪರೀಕ್ಷಿಸಿ)."

#, python-brace-format
msgid ""
"{setting} is set by the system itself. Changing it would stop the computer "
"starting."
msgstr ""
"{setting} ಅನ್ನು ಸಿಸ್ಟಂ ಸ್ವತಃ ಹೊಂದಿಸುತ್ತದೆ. ಇದನ್ನು ಬದಲಾಯಿಸಿದರೆ ಕಂಪ್ಯೂಟರ್ "
"ಪ್ರಾರಂಭವಾಗುವುದಿಲ್ಲ."

#, python-brace-format
msgid "{setting} is taken out from the next restart."
msgstr "ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಿಂದ {setting} ಅನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."

#, python-brace-format
msgid ""
"{setting} isn't a kernel setting. Use letters, numbers and . _ - like "
"amdgpu.abmlevel=0."
msgstr ""
"{setting} ಕರ್ನಲ್ ಸೆಟ್ಟಿಂಗ್ ಅಲ್ಲ. ಅಕ್ಷರಗಳು, ಅಂಕೆಗಳು ಮತ್ತು . _ - ಅನ್ನು ಬಳಸಿ, "
"ಉದಾಹರಣೆಗೆ amdgpu.abmlevel=0."

#, python-brace-format
msgid ""
"{setting} runs a program with full control while the computer starts, so it "
"can't be added here."
msgstr ""
"{setting} ಕಂಪ್ಯೂಟರ್ ಆರಂಭವಾಗುವಾಗ ಸಂಪೂರ್ಣ ನಿಯಂತ್ರಣದೊಂದಿಗೆ ಒಂದು ಪ್ರೋಗ್ರಾಂ ಅನ್ನು "
"ಚಲಾಯಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಅದನ್ನು ಇಲ್ಲಿ ಸೇರಿಸಲು ಆಗುವುದಿಲ್ಲ."

#, python-brace-format
msgid "{size} free"
msgstr "{size} ಖಾಲಿ"

#, python-brace-format
msgid "{size} is free now."
msgstr "ಈಗ {size} ಖಾಲಿ ಇದೆ."

#, python-brace-format
msgid "{step}  (still working, {n} min so far)"
msgstr "{step}  (ಇನ್ನೂ ನಡೆಯುತ್ತಿದೆ, ಇದುವರೆಗೆ {n} ನಿಮಿಷ)"

#, python-brace-format
msgid "{step}. This is the longest step..."
msgstr "{step}. ಇದು ಅತ್ಯಂತ ಉದ್ದವಾದ ಹಂತವಾಗಿದೆ..."

#, python-brace-format
msgid "{summary}."
msgstr "{summary}."

#, python-brace-format
msgid "{test}: the test is working."
msgstr "{test}: ಪರೀಕ್ಷೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಿದೆ."

#, python-brace-format
msgid ""
"{title} can't be installed from this file. It has:\n"
"{reasons}\n"
"\n"
"These have to go on the system, and the system only takes .rpm files. Look for {title} as an .rpm for Fedora {version}, or in Bazaar, the app store."
msgstr ""
"{title} ಅನ್ನು ಈ ಫೈಲ್‌ನಿಂದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಆಗುವುದಿಲ್ಲ. ಇದರಲ್ಲಿರುವುದು:\n"
"{reasons}\n"
"\n"
"ಇವುಗಳನ್ನು ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಬೇಕು, ಮತ್ತು ಸಿಸ್ಟಂ .rpm ಫೈಲ್‌ಗಳನ್ನು ಮಾತ್ರ ಸ್ವೀಕರಿಸುತ್ತದೆ. Fedora {version} ಗಾಗಿ {title} ಅನ್ನು .rpm ರೂಪದಲ್ಲಿ ಹುಡುಕಿ, ಅಥವಾ ಆ್ಯಪ್ ಸ್ಟೋರ್ ಆಗಿರುವ Bazaar ನಲ್ಲಿ ಹುಡುಕಿ."

#, python-brace-format
msgid ""
"{title} can't be installed. It needs full control of the system to run, which downloaded apps don't get here.\n"
"\n"
"Nothing was installed."
msgstr ""
"{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ಇದು ಚಲಿಸಲು ಸಿಸ್ಟಂನ ಸಂಪೂರ್ಣ ನಿಯಂತ್ರಣ ಬೇಕು, ಆದರೆ ಇಲ್ಲಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಆ್ಯಪ್‌ಗಳಿಗೆ ಅದು ಸಿಗುವುದಿಲ್ಲ.\n"
"\n"
"ಏನನ್ನೂ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿಲ್ಲ."

#, python-brace-format
msgid "{title} did not get installed."
msgstr "{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿಲ್ಲ."

#, python-brace-format
msgid ""
"{title} did not get installed. The computer may have started an older version"
" of the system."
msgstr ""
"{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿಲ್ಲ. ಕಂಪ್ಯೂಟರ್ ಸಿಸ್ಟಂನ ಹಳೆಯ ಆವೃತ್ತಿಯನ್ನು "
"ಪ್ರಾರಂಭಿಸಿರಬಹುದು."

#, python-brace-format
msgid "{title} didn't open."
msgstr "{title} ತೆರೆಯಲಿಲ್ಲ."

#, python-brace-format
msgid "{title} has no window to open. It is a tool other apps use."
msgstr "{title} ತೆರೆಯಲು ಯಾವುದೇ ವಿಂಡೋ ಇಲ್ಲ. ಇದು ಇತರ ಆ್ಯಪ್‌ಗಳು ಬಳಸುವ ಒಂದು ಪರಿಕರ."

#, python-brace-format
msgid ""
"{title} has to go on the system. It has:\n"
"{reasons}\n"
"These can't work in a box.\n"
"\n"
"Add to the system: everything works. Needs your password and a restart. You can remove it any time in Wheelhouse, Apps, Remove apps."
msgstr ""
"{title} ಅನ್ನು ಸಿಸ್ಟಂನಲ್ಲಿ ಇರಿಸಬೇಕಾಗಿದೆ. ಅದರಲ್ಲಿ ಇವು ಇವೆ:\n"
"{reasons}\n"
"ಇವು ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಕೆಲಸ ಮಾಡಲು ಆಗುವುದಿಲ್ಲ.\n"
"\n"
"ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಿ: ಎಲ್ಲವೂ ಕೆಲಸ ಮಾಡುತ್ತದೆ. ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು ಮರುಪ್ರಾರಂಭ ಅಗತ್ಯವಿದೆ. ನೀವು ಇದನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ Wheelhouse, ಆ್ಯಪ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿ ಇಲ್ಲಿ ತೆಗೆದುಹಾಕಬಹುದು."

#, python-brace-format
msgid ""
"{title} is a printer driver made for Ubuntu and Debian (.deb). This system takes printer drivers only as .rpm files.\n"
"\n"
"What to do:\n"
"  1. Go to {site} and find the driver for your printer.\n"
"  2. When it asks for your system, choose the .rpm version (it may be called Fedora, Red Hat or RPM).\n"
"  3. Open that .rpm file here.\n"
"\n"
"Or try your printer without a driver first."
msgstr ""
"{title} ಎಂಬುದು Ubuntu ಮತ್ತು Debian (.deb) ಗಾಗಿ ತಯಾರಿಸಲಾದ ಪ್ರಿಂಟರ್ ಡ್ರೈವರ್ ಆಗಿದೆ. ಈ ಸಿಸ್ಟಂ ಪ್ರಿಂಟರ್ ಡ್ರೈವರ್‌ಗಳನ್ನು .rpm ಫೈಲ್‌ಗಳ ರೂಪದಲ್ಲಿ ಮಾತ್ರ ಸ್ವೀಕರಿಸುತ್ತದೆ.\n"
"\n"
"ಏನು ಮಾಡಬೇಕು:\n"
"  1. {site} ಗೆ ಹೋಗಿ ಮತ್ತು ನಿಮ್ಮ ಪ್ರಿಂಟರ್‌ಗೆ ಬೇಕಾದ ಡ್ರೈವರ್ ಅನ್ನು ಹುಡುಕಿ.\n"
"  2. ನಿಮ್ಮ ಸಿಸ್ಟಂ ಅನ್ನು ಕೇಳಿದಾಗ, .rpm ಆವೃತ್ತಿಯನ್ನು ಆಯ್ಕೆಮಾಡಿ (ಅದನ್ನು Fedora, Red Hat ಅಥವಾ RPM ಎಂದು ಕರೆಯಬಹುದು).\n"
"  3. ಆ .rpm ಫೈಲ್ ಅನ್ನು ಇಲ್ಲಿ ತೆರೆಯಿರಿ.\n"
"\n"
"ಅಥವಾ ಮೊದಲು ಡ್ರೈವರ್ ಇಲ್ಲದೆ ನಿಮ್ಮ ಪ್ರಿಂಟರ್ ಅನ್ನು ಪ್ರಯತ್ನಿಸಿ."

#, python-brace-format
msgid ""
"{title} is a printer driver. Most printers work without one.\n"
"\n"
"Recommended: Open Printers, and add your printer there first.\n"
"\n"
"Or {extra}: only if your printer doesn't work without it."
msgstr ""
"{title} ಒಂದು ಪ್ರಿಂಟರ್ ಡ್ರೈವರ್. ಹೆಚ್ಚಿನ ಪ್ರಿಂಟರ್‌ಗಳು ಅದು ಇಲ್ಲದೆಯೂ ಕೆಲಸ ಮಾಡುತ್ತವೆ.\n"
"\n"
"ಶಿಫಾರಸು: ಮುದ್ರಕಗಳು ತೆರೆಯಿರಿ, ಮತ್ತು ಮೊದಲು ಅಲ್ಲಿ ನಿಮ್ಮ ಪ್ರಿಂಟರ್ ಸೇರಿಸಿ.\n"
"\n"
"ಅಥವಾ {extra}: ನಿಮ್ಮ ಪ್ರಿಂಟರ್ ಅದು ಇಲ್ಲದೆ ಕೆಲಸ ಮಾಡದಿದ್ದರೆ ಮಾತ್ರ."

#, python-brace-format
msgid ""
"{title} is already installed from Bazaar, the app store.\n"
"\n"
"Recommended: Open it."
msgstr ""
"{title} ಅನ್ನು ಈಗಾಗಲೇ ಆ್ಯಪ್ ಸ್ಟೋರ್ ಆದ Bazaar ನಿಂದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ.\n"
"\n"
"ಶಿಫಾರಸು: ಅದನ್ನು ತೆರೆಯಿರಿ."

#, python-brace-format
msgid ""
"{title} is already installed from Fedora and stays up to date. You don't need"
" this file."
msgstr ""
"{title} ಅನ್ನು ಈಗಾಗಲೇ Fedora ದಿಂದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ ಮತ್ತು ಅದು ಅಪ್‌ಡೇಟ್ "
"ಆಗಿಯೇ ಇರುತ್ತದೆ. ನಿಮಗೆ ಈ ಫೈಲ್ ಬೇಕಾಗಿಲ್ಲ."

#, python-brace-format
msgid "{title} is already installed from a .deb file."
msgstr "{title} ಅನ್ನು ಈಗಾಗಲೇ .deb ಫೈಲ್‌ನಿಂದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ."

#, python-brace-format
msgid "{title} is already installed from an .rpm file."
msgstr "{title} ಅನ್ನು ಈಗಾಗಲೇ .rpm ಫೈಲ್‌ನಿಂದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ."

#, python-brace-format
msgid ""
"{title} is already installed.\n"
"\n"
"Recommended: Open it.\n"
"\n"
"Or Reinstall: installs it again from this file. Only needed if it isn't working."
msgstr ""
"{title} ಈಗಾಗಲೇ ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿದೆ.\n"
"\n"
"ಶಿಫಾರಸು: ಅದನ್ನು ತೆರೆಯಿರಿ.\n"
"\n"
"ಅಥವಾ ಮತ್ತೆ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ: ಈ ಫೈಲ್‌ನಿಂದ ಅದನ್ನು ಮತ್ತೆ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುತ್ತದೆ. ಅದು ಕೆಲಸ ಮಾಡದಿದ್ದರೆ ಮಾತ್ರ ಬೇಕು."

#, python-brace-format
msgid "{title} is already installed. Find it in Show Apps."
msgstr "{title} ಈಗಾಗಲೇ ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿದೆ. ಇದನ್ನು Show Apps ನಲ್ಲಿ ಹುಡುಕಿ."

#, python-brace-format
msgid ""
"{title} is already installed. This file is older than the one installed."
msgstr ""
"{title} ಈಗಾಗಲೇ ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿದೆ. ಈ ಫೈಲ್ ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿರುವ ಆವೃತ್ತಿಗಿಂತ ಹಳೆಯದು."

