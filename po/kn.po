msgid ""
"  codecs web   Web video in Firefox only. Replaces Fedora's empty OpenH264 stand-in with\n"
"               Cisco's OpenH264 from Fedora's Cisco repository, under Cisco's own H.264\n"
"               patent license.\n"
"  codecs full  Everything. Replaces Fedora's free ffmpeg libraries with the full ffmpeg,\n"
"               x264 and x265 from RPM Fusion, the source standard Fedora uses."
msgstr ""
"  codecs web   Firefox ನಲ್ಲಿ ಮಾತ್ರ ವೆಬ್ ವೀಡಿಯೊ. Fedora ದ ಖಾಲಿ OpenH264 ಬದಲಿಯನ್ನು, Fedora ದ Cisco ರೆಪೊಸಿಟರಿಯಲ್ಲಿರುವ\n"
"               Cisco ನ OpenH264 ನಿಂದ ಬದಲಾಯಿಸುತ್ತದೆ. ಇದು Cisco ನ ಸ್ವಂತ H.264 ಪೇಟೆಂಟ್ ಪರವಾನಗಿಯ\n"
"               ಅಡಿಯಲ್ಲಿ ಬರುತ್ತದೆ.\n"
"  codecs full  ಎಲ್ಲವೂ. Fedora ದ ಉಚಿತ ffmpeg ಲೈಬ್ರರಿಗಳನ್ನು ಪೂರ್ಣ ffmpeg, x264 ಮತ್ತು x265 ನಿಂದ ಬದಲಾಯಿಸುತ್ತದೆ.\n"
"               ಇವು ಸಾಮಾನ್ಯ Fedora ಬಳಸುವ ಮೂಲವಾದ RPM Fusion ನಿಂದ ಬರುತ್ತವೆ."

msgid ""
"  evenkeel-os-packages install [FILE]   install an .rpm or .deb (no FILE: pick one from Downloads)\n"
"  evenkeel-os-packages remove           remove an app installed this way\n"
"  evenkeel-os-packages check FILE       say what a package needs, without installing anything\n"
"  evenkeel-os-packages repair           set a broken app box up again (--if-broken: only if one does not work)\n"
"  evenkeel-os-packages login            choose box apps that start when you log in\n"
"  evenkeel-os-packages windows FILE     a Windows .exe or .msi: offer a Linux app that does its job\n"
"  evenkeel-os-packages check-windows FILE  say what a Windows file is and what would be offered, without any window\n"
"  evenkeel-os-packages zoom LINK        a Zoom \"open the app\" link: open the meeting in Zoom's web version, in Chrome\n"
"  evenkeel-os-packages vpn [NAME]       add a VPN from its company's own download source (mullvad, proton, ivpn,\n"
"                                        nordvpn; no NAME: pick one)"
msgstr ""
"  evenkeel-os-packages install [FILE]   .rpm ಅಥವಾ .deb ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುತ್ತದೆ (FILE ಇಲ್ಲದಿದ್ದರೆ: ಡೌನ್‌ಲೋಡ್‌ಗಳಿಂದ ಒಂದನ್ನು ಆಯ್ಕೆಮಾಡಿ)\n"
"  evenkeel-os-packages remove           ಈ ರೀತಿ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದ ಆ್ಯಪ್ ಅನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ\n"
"  evenkeel-os-packages check FILE       ಏನನ್ನೂ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡದೆ, ಪ್ಯಾಕೇಜ್‌ಗೆ ಏನು ಬೇಕು ಎಂದು ತಿಳಿಸುತ್ತದೆ\n"
"  evenkeel-os-packages repair           ಕೆಟ್ಟುಹೋದ ಆ್ಯಪ್ ಬಾಕ್ಸ್ ಅನ್ನು ಮತ್ತೆ ಸಿದ್ಧಪಡಿಸುತ್ತದೆ (--if-broken: ಯಾವುದಾದರೂ ಒಂದು ಕೆಲಸ ಮಾಡದಿದ್ದರೆ ಮಾತ್ರ)\n"
"  evenkeel-os-packages login            ನೀವು ಲಾಗ್ ಇನ್ ಮಾಡಿದಾಗ ಪ್ರಾರಂಭವಾಗುವ ಬಾಕ್ಸ್ ಆ್ಯಪ್‌ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ\n"
"  evenkeel-os-packages windows FILE     Windows .exe ಅಥವಾ .msi: ಅದರ ಕೆಲಸವನ್ನು ಮಾಡುವ Linux ಆ್ಯಪ್ ಅನ್ನು ಸೂಚಿಸುತ್ತದೆ\n"
"  evenkeel-os-packages check-windows FILE  ಯಾವುದೇ ವಿಂಡೋ ತೆರೆಯದೆ, Windows ಫೈಲ್ ಏನು ಮತ್ತು ಏನನ್ನು ಸೂಚಿಸಲಾಗುತ್ತದೆ ಎಂದು ತಿಳಿಸುತ್ತದೆ\n"
"  evenkeel-os-packages zoom LINK        Zoom ನ \"ಆ್ಯಪ್ ತೆರೆಯಿರಿ\" ಲಿಂಕ್: ಮೀಟಿಂಗ್ ಅನ್ನು Zoom ನ ವೆಬ್ ಆವೃತ್ತಿಯಲ್ಲಿ, Chrome ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ\n"
"  evenkeel-os-packages vpn [NAME]       VPN ಅನ್ನು ಅದರ ಕಂಪನಿಯ ಸ್ವಂತ ಡೌನ್‌ಲೋಡ್ ಮೂಲದಿಂದ ಸೇರಿಸುತ್ತದೆ (mullvad, proton, ivpn,\n"
"                                        nordvpn; NAME ಇಲ್ಲದಿದ್ದರೆ: ಒಂದನ್ನು ಆಯ್ಕೆಮಾಡಿ)"

#, python-brace-format
msgid ""
"\"{name}\" comes with Fedora. The trusted list is rebuilt from Fedora's "
"current list at every start, so an update replaces or drops it; keep "
"automatic updates on. If this alert stays after updating and restarting, tell"
" your helper."
msgstr ""
"\"{name}\" Fedora ಜೊತೆಗೆ ಬರುತ್ತದೆ. ಪ್ರತಿ ಪ್ರಾರಂಭದಲ್ಲಿ ವಿಶ್ವಾಸಾರ್ಹ ಪಟ್ಟಿಯನ್ನು "
"Fedora ದ ಪ್ರಸ್ತುತ ಪಟ್ಟಿಯಿಂದ ಮತ್ತೆ ರಚಿಸಲಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಅಪ್‌ಡೇಟ್ ಒಂದು "
"ಇದನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ ಅಥವಾ ತೆಗೆದುಹಾಕುತ್ತದೆ; ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಆನ್ "
"ಆಗಿಯೇ ಇರಿಸಿ. ಅಪ್‌ಡೇಟ್ ಮಾಡಿ ಮರುಪ್ರಾರಂಭಿಸಿದ ನಂತರವೂ ಈ ಎಚ್ಚರಿಕೆ ಉಳಿದರೆ, ನಿಮ್ಮ "
"ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ."

#, python-brace-format
msgid ""
"\"{name}\" has expired, but its file ({file}) holds {n} certificate, and "
"removing it would remove them all, the good ones too. Tell your helper."
msgid_plural ""
"\"{name}\" has expired, but its file ({file}) holds {n} certificates, and "
"removing it would remove them all, the good ones too. Tell your helper."
msgstr[0] ""
"\"{name}\" ಅವಧಿ ಮೀರಿದೆ, ಆದರೆ ಅದರ ಫೈಲ್ ({file}) {n} ಪ್ರಮಾಣಪತ್ರವನ್ನು ಹೊಂದಿದೆ, "
"ಮತ್ತು ಅದನ್ನು ತೆಗೆದುಹಾಕಿದರೆ ಎಲ್ಲವೂ, ಸರಿಯಾಗಿರುವವೂ ಸಹ, ತೆಗೆದುಹೋಗುತ್ತವೆ. ನಿಮ್ಮ "
"ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ."
msgstr[1] ""
"\"{name}\" ಅವಧಿ ಮೀರಿದೆ, ಆದರೆ ಅದರ ಫೈಲ್ ({file}) {n} ಪ್ರಮಾಣಪತ್ರಗಳನ್ನು ಹೊಂದಿದೆ, "
"ಮತ್ತು ಅದನ್ನು ತೆಗೆದುಹಾಕಿದರೆ ಎಲ್ಲವೂ, ಸರಿಯಾಗಿರುವವೂ ಸಹ, ತೆಗೆದುಹೋಗುತ್ತವೆ. ನಿಮ್ಮ "
"ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ."

#, python-brace-format
msgid ""
"\"{name}\" has expired. It was added in a way Wheelhouse can't remove; tell "
"your helper."
msgstr ""
"\"{name}\" ಅವಧಿ ಮೀರಿದೆ. Wheelhouse ತೆಗೆದುಹಾಕಲು ಸಾಧ್ಯವಾಗದ ರೀತಿಯಲ್ಲಿ ಇದನ್ನು "
"ಸೇರಿಸಲಾಗಿದೆ; ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ."

#, python-brace-format
msgid "\"{name}\" is removed and no longer trusted."
msgstr "\"{name}\" ಅನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ ಮತ್ತು ಅದು ಇನ್ನು ಮುಂದೆ ವಿಶ್ವಾಸಾರ್ಹವಾಗಿಲ್ಲ."

#, python-brace-format
msgid ""
"\"{name}\" was added to this computer and expired on {date}. An expired "
"certificate shouldn't be relied on. Remove it if you no longer need it; if "
"you do, ask whoever gave it to you for a new one. Removing it needs your "
"password."
msgstr ""
"\"{name}\" ಅನ್ನು ಈ ಕಂಪ್ಯೂಟರ್‌ಗೆ ಸೇರಿಸಲಾಗಿತ್ತು ಮತ್ತು ಅದರ ಅವಧಿ {date} ರಂದು "
"ಮುಗಿದಿದೆ. ಅವಧಿ ಮೀರಿದ ಪ್ರಮಾಣಪತ್ರವನ್ನು ನಂಬಬಾರದು. ನಿಮಗೆ ಇನ್ನು ಇದರ "
"ಅಗತ್ಯವಿಲ್ಲದಿದ್ದರೆ ಇದನ್ನು ತೆಗೆದುಹಾಕಿ; ಅಗತ್ಯವಿದ್ದರೆ, ಇದನ್ನು ನಿಮಗೆ ನೀಡಿದವರಿಂದ "
"ಹೊಸದನ್ನು ಕೇಳಿ ಪಡೆಯಿರಿ. ಇದನ್ನು ತೆಗೆದುಹಾಕಲು ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಬೇಕು."

#, python-brace-format
msgid ""
"\"{name}\" was added to this computer and expires on {date}. Ask whoever gave"
" it to you for a new one before then."
msgstr ""
"\"{name}\" ಅನ್ನು ಈ ಕಂಪ್ಯೂಟರ್‌ಗೆ ಸೇರಿಸಲಾಗಿದೆ ಮತ್ತು ಅದರ ಅವಧಿ {date} ರಂದು "
"ಮುಗಿಯುತ್ತದೆ. ಅದಕ್ಕೂ ಮೊದಲೇ, ಇದನ್ನು ನಿಮಗೆ ನೀಡಿದವರಿಂದ ಹೊಸದನ್ನು ಕೇಳಿ ಪಡೆಯಿರಿ."

#. Translators: a weekday and date ("Thursday, November 26"). Uses strftime codes.
msgid "%A, %B %-d"
msgstr "%A, %-d %B"

#. Translators: a date: month and day ("November 26"). Uses strftime codes.
msgid "%B %-d"
msgstr "%-d %B"

#. Translators: a date and a 12-hour time ("November 26, 7:02 PM"). Uses strftime codes.
msgid "%B %-d, %-I:%M %p"
msgstr "%-d %B %-I:%M %p"

#. Translators: a date and a 24-hour time ("November 26, 19:02"). Uses strftime codes.
msgid "%B %-d, %H:%M"
msgstr "%-d %B %H:%M"

msgid "(nothing was printed)"
msgstr "(ಯಾವುದೇ ಔಟ್‌ಪುಟ್ ಬರಲಿಲ್ಲ)"

#, python-brace-format
msgid "- and {n} more"
msgid_plural "- and {n} more"
msgstr[0] "- ಮತ್ತು ಇನ್ನೂ {n}"
msgstr[1] "- ಮತ್ತು ಇನ್ನೂ {n}"

msgid ""
"1.00 is the normal size. Large text in Settings, Accessibility sets 1.25."
msgstr ""
"1.00 ಸಾಮಾನ್ಯ ಗಾತ್ರ. ಸಿದ್ಧತೆಗಳು, ನಿಲುಕಣೆ ಇಲ್ಲಿರುವ ದೊಡ್ಡ ಪಠ್ಯ ಆಯ್ಕೆಯು 1.25 "
"ಅನ್ನು ಹೊಂದಿಸುತ್ತದೆ."

msgid "12 hour"
msgstr "12 ಗಂಟೆ"

msgid "24 hour"
msgstr "24 ಗಂಟೆ"

msgid ""
"A .deb driver can't be installed. The window says how to get the .rpm from "
"the maker."
msgstr ""
".deb ಡ್ರೈವರ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ತಯಾರಕರಿಂದ .rpm ಅನ್ನು ಹೇಗೆ "
"ಪಡೆಯುವುದು ಎಂದು ವಿಂಡೋ ತಿಳಿಸುತ್ತದೆ."

msgid "A USB mouse works."
msgstr "USB ಮೌಸ್ ಕೆಲಸ ಮಾಡುತ್ತದೆ."

msgid "A USB webcam works."
msgstr "USB ವೆಬ್‌ಕ್ಯಾಮ್ ಕೆಲಸ ಮಾಡುತ್ತದೆ."

msgid "A VPN"
msgstr "VPN"

msgid "A Windows program you downloaded (.exe or .msi)"
msgstr "ನೀವು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ Windows ಪ್ರೋಗ್ರಾಂ (.exe ಅಥವಾ .msi)"

msgid "A background service fails"
msgstr "ಹಿನ್ನೆಲೆ ಸೇವೆಯೊಂದು ವಿಫಲವಾಗುತ್ತದೆ"

msgid ""
"A background service that runs on this computer fails to start (the mobile "
"broadband service, or the graphics switching service)."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಚಾಲನೆಯಾಗುವ ಹಿನ್ನೆಲೆ ಸೇವೆಯು (ಮೊಬೈಲ್ ಬ್ರಾಡ್‌ಬ್ಯಾಂಡ್ ಸೇವೆ ಅಥವಾ"
" ಗ್ರಾಫಿಕ್ಸ್ ಸ್ವಿಚಿಂಗ್ ಸೇವೆ) ಪ್ರಾರಂಭವಾಗುತ್ತಿಲ್ಲ."

msgid "A bottom bar, with a start menu on the logo"
msgstr "ಕೆಳಗಿನ ಪಟ್ಟಿ, ಲೋಗೋದಲ್ಲಿ ಸ್ಟಾರ್ಟ್ ಮೆನು"

msgid "A broken app box"
msgstr "ಕೆಟ್ಟುಹೋದ ಆ್ಯಪ್ ಬಾಕ್ಸ್"

msgid "A built-in camera of the newer laptop kind was found."
msgstr "ಹೊಸ ಮಾದರಿಯ ಲ್ಯಾಪ್‌ಟಾಪ್‌ನಲ್ಲಿರುವಂತಹ ಅಂತರ್ನಿರ್ಮಿತ ಕ್ಯಾಮೆರಾ ಕಂಡುಬಂದಿದೆ."

msgid "A café, hotel, airport, or anywhere else. Nothing gets in."
msgstr ""
"ಕೆಫೆ, ಹೋಟೆಲ್, ವಿಮಾನ ನಿಲ್ದಾಣ ಅಥವಾ ಬೇರೆ ಯಾವುದೇ ಸ್ಥಳ. ಏನೂ ಒಳಗೆ ಬರುವುದಿಲ್ಲ."

#, python-brace-format
msgid "A certificate needs attention"
msgid_plural "{n} certificates need attention"
msgstr[0] "{n} ಪ್ರಮಾಣಪತ್ರದ ಬಗ್ಗೆ ಗಮನ ಹರಿಸಬೇಕಿದೆ"
msgstr[1] "{n} ಪ್ರಮಾಣಪತ್ರಗಳ ಬಗ್ಗೆ ಗಮನ ಹರಿಸಬೇಕಿದೆ"

msgid ""
"A change to the boot options is waiting. It starts at your next restart. It isn't an update.\n"
"\n"
"If you don't want it: Don't use it. The computer starts with the boot options it has now, and automatic updates aren't paused.\n"
"\n"
"Or Keep it."
msgstr ""
"ಬೂಟ್ ಆಯ್ಕೆಗಳಲ್ಲಿ ಒಂದು ಬದಲಾವಣೆ ಕಾಯುತ್ತಿದೆ. ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಅದು ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ಇದು ಅಪ್‌ಡೇಟ್ ಅಲ್ಲ.\n"
"\n"
"ನಿಮಗೆ ಅದು ಬೇಡವಾದರೆ: ಇದನ್ನು ಬಳಸಬೇಡಿ. ಕಂಪ್ಯೂಟರ್ ಈಗ ಇರುವ ಬೂಟ್ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಮತ್ತು ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ವಿರಾಮಗೊಳ್ಳುವುದಿಲ್ಲ.\n"
"\n"
"ಅಥವಾ ಇದನ್ನು ಉಳಿಸಿಕೊಳ್ಳಿ."

msgid "A device"
msgstr "ಒಂದು ಸಾಧನ"

#, python-brace-format
msgid "A device lost its driver ({driver})"
msgstr "ಒಂದು ಸಾಧನವು ತನ್ನ ಡ್ರೈವರ್ ಅನ್ನು ಕಳೆದುಕೊಂಡಿದೆ ({driver})"

msgid "A disk is hidden."
msgstr "ಒಂದು ಡಿಸ್ಕ್ ಅನ್ನು ಮರೆಮಾಡಲಾಗಿದೆ."

msgid "A driver file from the maker"
msgstr "ತಯಾರಕರಿಂದ ಬಂದ ಡ್ರೈವರ್ ಫೈಲ್"

msgid "A file of recent errors to email to your helper"
msgstr "ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ಇಮೇಲ್ ಮಾಡಲು ಇತ್ತೀಚಿನ ದೋಷಗಳ ಫೈಲ್"

msgid "A full name can't have : or , in it."
msgstr "ಪೂರ್ಣ ಹೆಸರಿನಲ್ಲಿ : ಅಥವಾ , ಇರಬಾರದು."

msgid "A graphics chip has no driver."
msgstr "ಗ್ರಾಫಿಕ್ಸ್ ಚಿಪ್‌ಗೆ ಡ್ರೈವರ್ ಇಲ್ಲ."

msgid ""
"A network is only needed for automatic time and time zone. To use Wi-Fi, "
"click a network. Or click Next to go on without it."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಸಮಯ ಮತ್ತು ಕಾಲ ವಲಯಕ್ಕಾಗಿ ಮಾತ್ರ ನೆಟ್‌ವರ್ಕ್ ಅಗತ್ಯವಿದೆ. Wi-Fi ಬಳಸಲು, "
"ನೆಟ್‌ವರ್ಕ್ ಒಂದನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ. ಅಥವಾ ಅದು ಇಲ್ಲದೆ ಮುಂದುವರಿಯಲು \"ಮುಂದೆ\" ಕ್ಲಿಕ್ "
"ಮಾಡಿ."

msgid ""
"A new layout shows after you log out and back in. It changes only your own "
"desktop."
msgstr ""
"ನೀವು ಲಾಗ್ ಔಟ್ ಮಾಡಿ ಮತ್ತೆ ಲಾಗ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಹೊಸ ಲೇಔಟ್ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ. ಇದು"
" ನಿಮ್ಮ ಸ್ವಂತ ಡೆಸ್ಕ್‌ಟಾಪ್ ಅನ್ನು ಮಾತ್ರ ಬದಲಾಯಿಸುತ್ತದೆ."

msgid "A new system is ready."
msgstr "ಹೊಸ ಸಿಸ್ಟಂ ಸಿದ್ಧವಾಗಿದೆ."

msgid "A new system is ready. Restart to use it."
msgstr "ಹೊಸ ಸಿಸ್ಟಂ ಸಿದ್ಧವಾಗಿದೆ. ಅದನ್ನು ಬಳಸಲು ಮರುಪ್ರಾರಂಭಿಸಿ."

msgid ""
"A new system version is used from the next restart. Keep working, and restart"
" when it suits you."
msgstr ""
"ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಿಂದ ಹೊಸ ಸಿಸ್ಟಂ ಆವೃತ್ತಿಯನ್ನು ಬಳಸಲಾಗುತ್ತದೆ. ಕೆಲಸ ಮುಂದುವರಿಸಿ, "
"ನಿಮಗೆ ಅನುಕೂಲವಾದಾಗ ಮರುಪ್ರಾರಂಭಿಸಿ."

msgid ""
"A new version also goes back if something that worked before is broken after "
"you log in, like sound, Wi-Fi, Bluetooth, the camera or printing. Unplugged "
"or switched-off things don't count."
msgstr ""
"ನೀವು ಲಾಗ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಮೊದಲು ಕೆಲಸ ಮಾಡುತ್ತಿದ್ದ ಏನಾದರೂ (ಉದಾಹರಣೆಗೆ ಧ್ವನಿ, Wi-"
"Fi, ಬ್ಲೂಟೂತ್, ಕ್ಯಾಮೆರಾ ಅಥವಾ ಪ್ರಿಂಟಿಂಗ್) ಕೆಲಸ ಮಾಡದಿದ್ದರೆ, ಹೊಸ ಆವೃತ್ತಿಯು "
"ಹಿಂದಿನದಕ್ಕೆ ಹಿಂತಿರುಗುತ್ತದೆ. ಪ್ಲಗ್ ತೆಗೆದ ಅಥವಾ ಸ್ವಿಚ್ ಆಫ್ ಮಾಡಿದ ವಸ್ತುಗಳು "
"ಪರಿಗಣನೆಗೆ ಬರುವುದಿಲ್ಲ."

msgid "A new version is ready"
msgstr "ಹೊಸ ಆವೃತ್ತಿ ಸಿದ್ಧವಾಗಿದೆ"

msgid ""
"A note at the next login says so and names what broke, and automatic updates "
"pause for 3 days."
msgstr ""
"ಮುಂದಿನ ಲಾಗಿನ್‌ನಲ್ಲಿ ಒಂದು ಟಿಪ್ಪಣಿ ಇದನ್ನು ತಿಳಿಸುತ್ತದೆ ಮತ್ತು ಯಾವುದು ಕೆಟ್ಟುಹೋಯಿತು"
" ಎಂಬುದನ್ನು ಹೆಸರಿಸುತ್ತದೆ. ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು 3 ದಿನಗಳವರೆಗೆ "
"ವಿರಾಮಗೊಳ್ಳುತ್ತವೆ."

msgid ""
"A rollback test copy is running. Restart first, so the computer goes back to "
"the usual version."
msgstr ""
"ರೋಲ್‌ಬ್ಯಾಕ್ ಪರೀಕ್ಷಾ ನಕಲು ಚಾಲನೆಯಲ್ಲಿದೆ. ಮೊದಲು ಮರುಪ್ರಾರಂಭಿಸಿ, ಆಗ ಕಂಪ್ಯೂಟರ್ "
"ಸಾಮಾನ್ಯ ಆವೃತ್ತಿಗೆ ಹಿಂತಿರುಗುತ್ತದೆ."

msgid "A security certificate expired, expires within 30 days, or was removed."
msgstr ""
"ಭದ್ರತಾ ಪ್ರಮಾಣಪತ್ರದ ಅವಧಿ ಮುಗಿದಿದೆ, 30 ದಿನಗಳೊಳಗೆ ಅವಧಿ ಮುಗಿಯುತ್ತದೆ ಅಥವಾ ಅದನ್ನು "
"ತೆಗೆದುಹಾಕಲಾಗಿದೆ."

msgid "A slideshow of your own pictures"
msgstr "ನಿಮ್ಮ ಸ್ವಂತ ಚಿತ್ರಗಳ ಸ್ಲೈಡ್‌ಶೋ"

msgid "A sound chip was found, but it didn't start."
msgstr "ಧ್ವನಿ ಚಿಪ್ ಕಂಡುಬಂದಿದೆ, ಆದರೆ ಅದು ಪ್ರಾರಂಭವಾಗಲಿಲ್ಲ."

msgid "A start-up check fails"
msgstr "ಪ್ರಾರಂಭದ ಪರಿಶೀಲನೆಯೊಂದು ವಿಫಲವಾಗುತ್ತದೆ"

msgid ""
"A start-up check fails on purpose. The computer restarts by itself within "
"seconds, twice, and the third start is back on this version."
msgstr ""
"ಪ್ರಾರಂಭದ ಪರಿಶೀಲನೆಯೊಂದು ಉದ್ದೇಶಪೂರ್ವಕವಾಗಿ ವಿಫಲವಾಗುತ್ತದೆ. ಕಂಪ್ಯೂಟರ್ ಕೆಲವೇ "
"ಸೆಕೆಂಡುಗಳಲ್ಲಿ ತಾನಾಗಿಯೇ ಎರಡು ಬಾರಿ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಮತ್ತು ಮೂರನೇ ಪ್ರಾರಂಭವು "
"ಮತ್ತೆ ಈ ಆವೃತ್ತಿಯಲ್ಲಿ ಆಗುತ್ತದೆ."

msgid "A system service fails"
msgstr "ಸಿಸ್ಟಂ ಸೇವೆಯೊಂದು ವಿಫಲವಾಗುತ್ತದೆ"

msgid "A system update is also waiting for a restart."
msgstr "ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್ ಕೂಡ ಮರುಪ್ರಾರಂಭಕ್ಕಾಗಿ ಕಾಯುತ್ತಿದೆ."

msgid "A tool"
msgstr "ಒಂದು ಪರಿಕರ"

msgid "A top bar, with the logo menu at the top left"
msgstr "ಮೇಲಿನ ಪಟ್ಟಿ, ಮೇಲಿನ ಎಡ ಮೂಲೆಯಲ್ಲಿ ಲೋಗೋ ಮೆನು"

msgid ""
"A user name uses small letters, digits, - and _, and starts with a letter."
msgstr ""
"ಬಳಕೆದಾರ ಹೆಸರು ಸಣ್ಣ ಅಕ್ಷರಗಳು, ಅಂಕೆಗಳು, - ಮತ್ತು _ ಅನ್ನು ಬಳಸುತ್ತದೆ ಮತ್ತು ಅದು "
"ಅಕ್ಷರದೊಂದಿಗೆ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

msgid ""
"A wired network is set to Home, so this happens on any cable you plug in."
msgstr ""
"ವೈರ್ಡ್ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಮನೆ ಎಂದು ಹೊಂದಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ ನೀವು ಪ್ಲಗ್ ಇನ್ ಮಾಡುವ "
"ಯಾವುದೇ ಕೇಬಲ್‌ನಲ್ಲಿ ಇದು ಆಗುತ್ತದೆ."

msgid "A wireless chip was found, but it didn't start."
msgstr "ವೈರ್‌ಲೆಸ್ ಚಿಪ್ ಕಂಡುಬಂದಿದೆ, ಆದರೆ ಅದು ಪ್ರಾರಂಭವಾಗಲಿಲ್ಲ."

msgid "A wireless chip was found, with no driver for it."
msgstr "ವೈರ್‌ಲೆಸ್ ಚಿಪ್ ಕಂಡುಬಂದಿದೆ, ಆದರೆ ಅದಕ್ಕೆ ಡ್ರೈವರ್ ಇಲ್ಲ."

msgid "AMD: flicker, turn off Panel Replay"
msgstr "AMD: ಮಿನುಗುವಿಕೆ, Panel Replay ಆಫ್ ಮಾಡಿ"

msgid "AMD: flicker, turn off Panel Self Refresh"
msgstr "AMD: ಮಿನುಗುವಿಕೆ, Panel Self Refresh ಆಫ್ ಮಾಡಿ"

msgid "AMD: flicker, turn off both"
msgstr "AMD: ಮಿನುಗುವಿಕೆ, ಎರಡನ್ನೂ ಆಫ್ ಮಾಡಿ"

msgid "AMD: screen dims or shifts colors on its own"
msgstr "AMD: ಪರದೆ ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಮಸುಕಾಗುತ್ತದೆ ಅಥವಾ ಬಣ್ಣಗಳು ಬದಲಾಗುತ್ತವೆ"

msgid "AMD: white flickering"
msgstr "AMD: ಬಿಳಿಯ ಮಿನುಗುವಿಕೆ"

msgid ""
"About 20 seconds after the login screen shows, the computer locks up. Hold "
"the power button until it turns off, then turn it on. After the second "
"freeze, the next start is back on this version."
msgstr ""
"ಲಾಗಿನ್ ಪರದೆ ಕಾಣಿಸಿಕೊಂಡ ಸುಮಾರು 20 ಸೆಕೆಂಡುಗಳ ನಂತರ, ಕಂಪ್ಯೂಟರ್ ಫ್ರೀಜ್ ಆಗುತ್ತದೆ "
"(ಸ್ತಬ್ಧವಾಗುತ್ತದೆ). ಕಂಪ್ಯೂಟರ್ ಆಫ್ ಆಗುವವರೆಗೆ ಪವರ್ ಬಟನ್ ಅನ್ನು ಒತ್ತಿ ಹಿಡಿಯಿರಿ, "
"ನಂತರ ಅದನ್ನು ಆನ್ ಮಾಡಿ. ಎರಡನೇ ಫ್ರೀಜ್ ನಂತರ, ಮುಂದಿನ ಪ್ರಾರಂಭವು ಮತ್ತೆ ಈ "
"ಆವೃತ್ತಿಯಲ್ಲಿ ಆಗುತ್ತದೆ."

msgid "About it"
msgstr "ಇದರ ಬಗ್ಗೆ"

msgid "About this driver"
msgstr "ಈ ಡ್ರೈವರ್ ಕುರಿತು"

msgid "Accent color and wallpaper"
msgstr "ಆಕ್ಸೆಂಟ್ ಬಣ್ಣ ಮತ್ತು ವಾಲ್‌ಪೇಪರ್"

msgid "Account"
msgstr "ಖಾತೆ"

msgid "Add"
msgstr "ಸೇರಿಸಿ"

msgid "Add a folder"
msgstr "ಫೋಲ್ಡರ್ ಸೇರಿಸಿ"

msgid "Add a folder and set the sharing password below."
msgstr "ಫೋಲ್ಡರ್ ಅನ್ನು ಸೇರಿಸಿ ಮತ್ತು ಕೆಳಗೆ ಹಂಚಿಕೆ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಹೊಂದಿಸಿ."

msgid "Add a folder from your home folder."
msgstr "ನಿಮ್ಮ ಹೋಮ್ ಫೋಲ್ಡರ್‌ನಿಂದ ಫೋಲ್ಡರ್ ಅನ್ನು ಸೇರಿಸಿ."

msgid "Add a printer"
msgstr "ಪ್ರಿಂಟರ್ ಸೇರಿಸಿ"

msgid "Add a setting, like amdgpu.abmlevel=0"
msgstr "amdgpu.abmlevel=0 ನಂತಹ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಸೇರಿಸಿ"

msgid "Add anyway"
msgstr "ಆದರೂ ಸೇರಿಸಿ"

msgid "Add it"
msgstr "ಅದನ್ನು ಸೇರಿಸಿ"

msgid ""
"Add it only if you know you need it. If the computer then won't start, "
"automatic rollback goes back to the version before."
msgstr ""
"ನಿಮಗೆ ಅದರ ಅಗತ್ಯವಿದೆ ಎಂದು ನಿಮಗೆ ಖಚಿತವಾಗಿದ್ದರೆ ಮಾತ್ರ ಅದನ್ನು ಸೇರಿಸಿ. ಆ ನಂತರ "
"ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾಗದಿದ್ದರೆ, ಸ್ವಯಂಚಾಲಿತ ರೋಲ್‌ಬ್ಯಾಕ್ ಹಿಂದಿನ ಆವೃತ್ತಿಗೆ "
"ಹಿಂತಿರುಗಿಸುತ್ತದೆ."

msgid "Add or remove an app's hardware rules"
msgstr "ಆ್ಯಪ್‌ನ ಹಾರ್ಡ್‌ವೇರ್ ನಿಯಮಗಳನ್ನು ಸೇರಿಸಿ ಅಥವಾ ತೆಗೆದುಹಾಕಿ"

msgid "Add or remove media codecs"
msgstr "ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳನ್ನು ಸೇರಿಸಿ ಅಥವಾ ತೆಗೆದುಹಾಕಿ"

msgid "Add the media codecs"
msgstr "ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳನ್ನು ಸೇರಿಸಿ"

msgid "Add to the system"
msgstr "ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಿ"

msgid "Add video and audio codecs"
msgstr "ವೀಡಿಯೊ ಮತ್ತು ಆಡಿಯೊ ಕೋಡೆಕ್‌ಗಳನ್ನು ಸೇರಿಸಿ"

msgid "Add, turn on or remove a VPN or an app's background service"
msgstr "VPN ಅಥವಾ ಆ್ಯಪ್‌ನ ಹಿನ್ನೆಲೆ ಸೇವೆಯನ್ನು ಸೇರಿಸಿ, ಆನ್ ಮಾಡಿ ಅಥವಾ ತೆಗೆದುಹಾಕಿ"

msgid "Added by you"
msgstr "ನೀವು ಸೇರಿಸಿದ್ದು"

msgid "Added to this computer"
msgstr "ಈ ಕಂಪ್ಯೂಟರ್‌ಗೆ ಸೇರಿಸಲಾಗಿದೆ"

msgid "Adding a printer, and printer driver files from the maker"
msgstr "ಪ್ರಿಂಟರ್ ಸೇರಿಸುವುದು, ಮತ್ತು ತಯಾರಕರಿಂದ ಬಂದ ಪ್ರಿಂಟರ್ ಡ್ರೈವರ್ ಫೈಲ್‌ಗಳು"

msgid ""
"Adding the desktop parts apps expect (progress windows and notifications)"
msgstr ""
"ಆ್ಯಪ್‌ಗಳು ನಿರೀಕ್ಷಿಸುವ ಡೆಸ್ಕ್‌ಟಾಪ್ ಭಾಗಗಳನ್ನು ಸೇರಿಸಲಾಗುತ್ತಿದೆ (ಪ್ರಗತಿ ವಿಂಡೋಗಳು "
"ಮತ್ತು ಅಧಿಸೂಚನೆಗಳು)"

#, python-brace-format
msgid "Adding the download source {name}"
msgstr "ಡೌನ್‌ಲೋಡ್ ಮೂಲ {name} ಅನ್ನು ಸೇರಿಸಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Adding {title} to the system"
msgstr "{title} ಅನ್ನು ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Adding {title} to the system from Fedora. A progress window shows it."
msgstr ""
"Fedora ನಿಂದ {title} ಅನ್ನು ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಲಾಗುತ್ತಿದೆ. ಪ್ರಗತಿ ವಿಂಡೋ ಅದನ್ನು "
"ತೋರಿಸುತ್ತದೆ."

#, python-brace-format
msgid "Adding {title} to the system from Fedora. This can take a few minutes."
msgstr ""
"Fedora ನಿಂದ {title} ಅನ್ನು ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಲಾಗುತ್ತಿದೆ. ಇದಕ್ಕೆ ಕೆಲವು ನಿಮಿಷಗಳು "
"ಬೇಕಾಗಬಹುದು."

#, python-brace-format
msgid "Adding {title} to the system. A progress window shows it."
msgstr ""
"{title} ಅನ್ನು ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಲಾಗುತ್ತಿದೆ. ಪ್ರಗತಿ ವಿಂಡೋ ಅದನ್ನು ತೋರಿಸುತ್ತದೆ."

#, python-brace-format
msgid "Adding {title} to the system. This can take a few minutes."
msgstr ""
"{title} ಅನ್ನು ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಲಾಗುತ್ತಿದೆ. ಇದಕ್ಕೆ ಕೆಲವು ನಿಮಿಷಗಳು ಬೇಕಾಗಬಹುದು."

msgid "Administrator"
msgstr "ನಿರ್ವಾಹಕರು"

msgid "Administrator account (root)"
msgstr "ನಿರ್ವಾಹಕ ಖಾತೆ (root)"

msgid "Administrator: no."
msgstr "ನಿರ್ವಾಹಕರು: ಇಲ್ಲ."

msgid "Administrator: yes."
msgstr "ನಿರ್ವಾಹಕರು: ಹೌದು."

msgid ""
"After a BIOS update, it may ask for the disk password again. Turn it on again"
" here."
msgstr ""
"BIOS ಅಪ್‌ಡೇಟ್ ಆದ ನಂತರ, ಅದು ಮತ್ತೆ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಕೇಳಬಹುದು. ಇದನ್ನು ಇಲ್ಲಿ "
"ಮತ್ತೆ ಆನ್ ಮಾಡಿ."

msgid ""
"After an undo, so the same update doesn't come straight back. They turn back "
"on by themselves."
msgstr ""
"ರದ್ದುಗೊಳಿಸಿದ ನಂತರ, ಅದೇ ಅಪ್‌ಡೇಟ್ ತಕ್ಷಣ ಮತ್ತೆ ಬರದಂತೆ. ಅವು ತಾವಾಗಿಯೇ ಮತ್ತೆ ಆನ್ "
"ಆಗುತ್ತವೆ."

msgid "After the restart, you will be asked to add your printer."
msgstr ""
"ಮರುಪ್ರಾರಂಭಿಸಿದ ನಂತರ, ನಿಮ್ಮ ಪ್ರಿಂಟರ್ ಅನ್ನು ಸೇರಿಸುವಂತೆ ನಿಮ್ಮನ್ನು ಕೇಳಲಾಗುತ್ತದೆ."

msgid ""
"After the restart, you'll be asked for your password once, to turn it on."
msgstr ""
"ಮರುಪ್ರಾರಂಭಿಸಿದ ನಂತರ, ಅದನ್ನು ಆನ್ ಮಾಡಲು ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಒಮ್ಮೆ "
"ಕೇಳಲಾಗುತ್ತದೆ."

msgid "After the restart, you'll get a message when it's ready."
msgstr "ಮರುಪ್ರಾರಂಭಿಸಿದ ನಂತರ, ಅದು ಸಿದ್ಧವಾದಾಗ ನಿಮಗೆ ಸಂದೇಶ ಬರುತ್ತದೆ."

msgid "Alpha"
msgstr "ಆಲ್ಫಾ"

msgid "Also let in, on Home"
msgstr "ಮನೆಯಲ್ಲಿ ಇವನ್ನೂ ಒಳಗೆ ಬಿಡಿ"

msgid ""
"Alt+Tab switches between apps. Alt and the key above Tab switches between "
"windows of the same app."
msgstr ""
"Alt+Tab ಒತ್ತುವುದರಿಂದ ಆ್ಯಪ್‌ಗಳ ನಡುವೆ ಬದಲಾಯಿಸಬಹುದು. Alt ಮತ್ತು Tab ಕೀಲಿಯ ಮೇಲಿರುವ"
" ಕೀಲಿಯನ್ನು ಒಟ್ಟಿಗೆ ಒತ್ತಿದರೆ ಅದೇ ಆ್ಯಪ್‌ನ ವಿಂಡೋಗಳ ನಡುವೆ ಬದಲಾಯಿಸಬಹುದು."

msgid ""
"An .rpm or .deb installs the app. An .exe or .msi gets its Linux version."
msgstr ""
".rpm ಅಥವಾ .deb ಫೈಲ್ ಆ್ಯಪ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುತ್ತದೆ. .exe ಅಥವಾ .msi ಫೈಲ್‌ಗೆ "
"ಅದರ Linux ಆವೃತ್ತಿ ದೊರೆಯುತ್ತದೆ."

msgid "An app that comes as a .rpm or .deb file"
msgstr ".rpm ಅಥವಾ .deb ಫೈಲ್ ರೂಪದಲ್ಲಿ ಬರುವ ಆ್ಯಪ್"

msgid "An office. Nothing gets in, and your folders aren't shared."
msgstr ""
"ಒಂದು ಆಫೀಸ್. ಏನೂ ಒಳಗೆ ಬರುವುದಿಲ್ಲ, ಮತ್ತು ನಿಮ್ಮ ಫೋಲ್ಡರ್‌ಗಳನ್ನು "
"ಹಂಚಿಕೊಳ್ಳಲಾಗುವುದಿಲ್ಲ."

#, python-brace-format
msgid ""
"An update from {staged} is waiting. It starts at your next restart. The version you're using now is from {booted}.\n"
"\n"
"If you don't want it: Don't use it. Your computer keeps the version it has now. A boot options change made since the update came is dropped with it."
msgstr ""
"ಒಂದು ಅಪ್‌ಡೇಟ್ ಕಾಯುತ್ತಿದೆ ({staged}). ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಅದು ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ನೀವು ಈಗ ಬಳಸುತ್ತಿರುವ ಆವೃತ್ತಿ: {booted}.\n"
"\n"
"ನಿಮಗೆ ಅದು ಬೇಡವಾದರೆ: ಇದನ್ನು ಬಳಸಬೇಡಿ. ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಈಗ ಇರುವ ಆವೃತ್ತಿಯನ್ನೇ ಉಳಿಸಿಕೊಳ್ಳುತ್ತದೆ. ಅಪ್‌ಡೇಟ್ ಬಂದ ನಂತರ ಮಾಡಿದ ಬೂಟ್ ಆಯ್ಕೆಗಳ ಬದಲಾವಣೆಯೂ ಅದರೊಂದಿಗೆ ಕೈಬಿಡಲ್ಪಡುತ್ತದೆ."

msgid "An update is waiting for a restart. Restart first, then run the test."
msgstr ""
"ಒಂದು ಅಪ್‌ಡೇಟ್ ಮರುಪ್ರಾರಂಭಕ್ಕಾಗಿ ಕಾಯುತ್ತಿದೆ. ಮೊದಲು ಮರುಪ್ರಾರಂಭಿಸಿ, ನಂತರ "
"ಪರೀಕ್ಷೆಯನ್ನು ಚಲಾಯಿಸಿ."

msgid "Another disk is hidden by a BIOS setting."
msgstr "BIOS ಸೆಟ್ಟಿಂಗ್‌ನಿಂದ ಇನ್ನೊಂದು ಡಿಸ್ಕ್ ಅನ್ನು ಮರೆಮಾಡಲಾಗಿದೆ."

#, python-brace-format
msgid ""
"Another install or removal is running ({doing}). This waits for it to finish,"
" then goes on."
msgstr ""
"ಮತ್ತೊಂದು ಇನ್‌ಸ್ಟಾಲ್ ಅಥವಾ ತೆಗೆದುಹಾಕುವಿಕೆ ನಡೆಯುತ್ತಿದೆ ({doing}). ಅದು "
"ಮುಗಿಯುವವರೆಗೆ ಇದು ಕಾಯುತ್ತದೆ, ನಂತರ ಮುಂದುವರಿಯುತ್ತದೆ."

msgid ""
"Another version is set to start at your next restart (after Undo the last "
"update, or picking a version in the boot menu), so the test wouldn't test "
"anything. Restart first, then run the test."
msgstr ""
"ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಬೇರೊಂದು ಆವೃತ್ತಿ ಪ್ರಾರಂಭವಾಗುವಂತೆ ಹೊಂದಿಸಲಾಗಿದೆ "
"(ಕೊನೆಯ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಿ ಬಳಸಿದ ನಂತರ, ಅಥವಾ ಬೂಟ್ ಮೆನುವಿನಲ್ಲಿ "
"ಆವೃತ್ತಿಯನ್ನು ಆಯ್ಕೆಮಾಡಿದ ನಂತರ), ಆದ್ದರಿಂದ ಈ ಪರೀಕ್ಷೆ ಏನನ್ನೂ ಪರೀಕ್ಷಿಸುವುದಿಲ್ಲ. "
"ಮೊದಲು ಮರುಪ್ರಾರಂಭಿಸಿ, ನಂತರ ಪರೀಕ್ಷೆಯನ್ನು ಚಲಾಯಿಸಿ."

msgid "App"
msgstr "ಆ್ಯಪ್"

msgid "App, game or port number"
msgstr "ಆ್ಯಪ್, ಗೇಮ್ ಅಥವಾ ಪೋರ್ಟ್ ಸಂಖ್ಯೆ"

msgid ""
"Applies them at login: the next slide for \"at each login\", and dark or "
"light for the time of day"
msgstr ""
"ಲಾಗಿನ್‌ನಲ್ಲಿ ಅವುಗಳನ್ನು ಅನ್ವಯಿಸುತ್ತದೆ: \"ಪ್ರತಿ ಲಾಗಿನ್‌ನಲ್ಲಿ\" ಎಂಬುದಕ್ಕಾಗಿ "
"ಮುಂದಿನ ಸ್ಲೈಡ್, ಮತ್ತು ದಿನದ ಸಮಯಕ್ಕೆ ಅನುಗುಣವಾಗಿ ಡಾರ್ಕ್ ಅಥವಾ ಲೈಟ್"

msgid "Apps"
msgstr "ಆ್ಯಪ್‌ಗಳು"

msgid "Apps and ports let in"
msgstr "ಅನುಮತಿಸಲಾದ ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಪೋರ್ಟ್‌ಗಳು"

msgid "Apps from Bazaar have this setting inside the app."
msgstr "Bazaar ನಿಂದ ಬಂದ ಆ್ಯಪ್‌ಗಳಲ್ಲಿ ಈ ಸೆಟ್ಟಿಂಗ್ ಆ್ಯಪ್‌ನಲ್ಲೇ ಇರುತ್ತದೆ."

msgid "Apps from Bazaar update on their own. Remove them in Bazaar too."
msgstr ""
"Bazaar ನಿಂದ ಬಂದ ಆ್ಯಪ್‌ಗಳು ತಾವಾಗಿಯೇ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತವೆ. ಅವುಗಳನ್ನು Bazaar "
"ನಲ್ಲಿಯೂ ತೆಗೆದುಹಾಕಿ."

msgid "Apps from Bazaar: open Bazaar and remove it there."
msgstr ""
"Bazaar ನಿಂದ ಬಂದ ಆ್ಯಪ್‌ಗಳು: Bazaar ತೆರೆಯಿರಿ ಮತ್ತು ಅಲ್ಲಿ ಅದನ್ನು ತೆಗೆದುಹಾಕಿ."

msgid ""
"Apps from a file, Get a VPN or a Windows program: Wheelhouse, Apps, Remove "
"apps."
msgstr ""
"ಫೈಲ್‌ನಿಂದ ಬಂದ ಆ್ಯಪ್‌ಗಳು, VPN ಪಡೆಯಿರಿ ಮೂಲಕ ಬಂದವು ಅಥವಾ Windows ಪ್ರೋಗ್ರಾಂಗಾಗಿ "
"ಬಂದವು: Wheelhouse, ಆ್ಯಪ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿ."

msgid ""
"Apps from a file: open Wheelhouse, Apps, Start apps at login, and pick the "
"app. Picking it again stops it."
msgstr ""
"ಫೈಲ್‌ನಿಂದ ಬಂದ ಆ್ಯಪ್‌ಗಳು: Wheelhouse ತೆರೆಯಿರಿ, ಆ್ಯಪ್‌ಗಳು, ಲಾಗಿನ್‌ನಲ್ಲಿ "
"ಆ್ಯಪ್‌ಗಳನ್ನು ಪ್ರಾರಂಭಿಸಿ, ನಂತರ ಆ್ಯಪ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಅದನ್ನು ಮತ್ತೆ "
"ಆಯ್ಕೆಮಾಡಿದರೆ ಅದು ನಿಲ್ಲುತ್ತದೆ."

msgid "Apps from package files"
msgstr "ಪ್ಯಾಕೇಜ್ ಫೈಲ್‌ಗಳಿಂದ ಬಂದ ಆ್ಯಪ್‌ಗಳು"

msgid "Apps from their own download sources"
msgstr "ತಮ್ಮದೇ ಆದ ಡೌನ್‌ಲೋಡ್ ಮೂಲಗಳಿಂದ ಬಂದ ಆ್ಯಪ್‌ಗಳು"

msgid "Apps you added from files, Get a VPN or Windows programs"
msgstr ""
"ನೀವು ಫೈಲ್‌ಗಳಿಂದ, VPN ಪಡೆಯಿರಿ ಮೂಲಕ ಅಥವಾ Windows ಪ್ರೋಗ್ರಾಂಗಳಿಗಾಗಿ ಸೇರಿಸಿದ "
"ಆ್ಯಪ್‌ಗಳು"

msgid "April"
msgstr "ಏಪ್ರಿಲ್"

msgid ""
"ArtCraft's downloads can't be reached right now. Check the internet "
"connection and try again."
msgstr ""
"ArtCraft ನ ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಇದೀಗ ತಲುಪಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ಇಂಟರ್ನೆಟ್ "
"ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ."

msgid "ArtCraft's signature is checked first, and it updates once a day."
msgstr ""
"ಮೊದಲು ArtCraft ನ ಸಹಿಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ, ಮತ್ತು ಅದು ದಿನಕ್ಕೊಮ್ಮೆ ಅಪ್‌ಡೇಟ್ "
"ಆಗುತ್ತದೆ."

msgid ""
"Asks once whether a password Wi-Fi or wired network is Home, Work or a Public"
" place"
msgstr ""
"ಪಾಸ್‌ವರ್ಡ್ ಇರುವ Wi-Fi ಅಥವಾ ವೈರ್ಡ್ ನೆಟ್‌ವರ್ಕ್ ಮನೆಯೇ, ಕೆಲಸದ ಸ್ಥಳವೇ ಅಥವಾ "
"ಸಾರ್ವಜನಿಕ ಸ್ಥಳವೇ ಎಂದು ಒಮ್ಮೆ ಕೇಳುತ್ತದೆ"

msgid "At each login"
msgstr "ಪ್ರತಿ ಲಾಗಿನ್‌ನಲ್ಲಿ"

msgid "August"
msgstr "ಆಗಸ್ಟ್"

msgid "Authentication is required to add or remove an app's hardware rules"
msgstr ""
"ಆ್ಯಪ್‌ನ ಹಾರ್ಡ್‌ವೇರ್ ನಿಯಮಗಳನ್ನು ಸೇರಿಸಲು ಅಥವಾ ತೆಗೆದುಹಾಕಲು ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ"

msgid "Authentication is required to add or remove media codecs"
msgstr "ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳನ್ನು ಸೇರಿಸಲು ಅಥವಾ ತೆಗೆದುಹಾಕಲು ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ"

msgid ""
"Authentication is required to add, turn on or remove a VPN or an app's "
"background service"
msgstr ""
"VPN ಅಥವಾ ಆ್ಯಪ್‌ನ ಹಿನ್ನೆಲೆ ಸೇವೆಯನ್ನು ಸೇರಿಸಲು, ಆನ್ ಮಾಡಲು ಅಥವಾ ತೆಗೆದುಹಾಕಲು "
"ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ"

msgid "Authentication is required to change a Wheelhouse setting"
msgstr "Wheelhouse ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಲು ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ"

msgid "Authentication is required to change the boot options"
msgstr "ಬೂಟ್ ಆಯ್ಕೆಗಳನ್ನು ಬದಲಾಯಿಸಲು ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ"

msgid ""
"Authentication is required to delete important settings for the repair test"
msgstr "ದುರಸ್ತಿ ಪರೀಕ್ಷೆಗಾಗಿನ ಪ್ರಮುಖ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅಳಿಸಲು ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ"

msgid "Authentication is required to install EvenKeelOS"
msgstr "EvenKeelOS ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ"

msgid "Authentication is required to remove a trusted certificate"
msgstr "ವಿಶ್ವಾಸಾರ್ಹ ಪ್ರಮಾಣಪತ್ರವನ್ನು ತೆಗೆದುಹಾಕಲು ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ"

msgid "Automatic"
msgstr "ಸ್ವಯಂಚಾಲಿತ"

msgid "Automatic disk unlock"
msgstr "ಡಿಸ್ಕ್‌ನ ಸ್ವಯಂಚಾಲಿತ ಅನ್‌ಲಾಕ್"

msgid "Automatic rollback"
msgstr "ಸ್ವಯಂಚಾಲಿತ ರೋಲ್‌ಬ್ಯಾಕ್"

msgid "Automatic rollback note"
msgstr "ಸ್ವಯಂಚಾಲಿತ ರೋಲ್‌ಬ್ಯಾಕ್ ಕುರಿತ ಟಿಪ್ಪಣಿ"

msgid "Automatic updates"
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು"

msgid "Automatic updates are back on."
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಮತ್ತೆ ಆನ್ ಮಾಡಲಾಗಿದೆ."

msgid "Automatic updates are back on. The next daily update runs as normal."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಮತ್ತೆ ಆನ್ ಮಾಡಲಾಗಿದೆ. ಮುಂದಿನ ದೈನಂದಿನ ಅಪ್‌ಡೇಟ್ "
"ಎಂದಿನಂತೆ ನಡೆಯುತ್ತದೆ."

msgid "Automatic updates are off"
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ಆಫ್ ಆಗಿವೆ"

msgid "Automatic updates are off. Run System Update yourself to update."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ಆಫ್ ಆಗಿವೆ. ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ನೀವೇ ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್ ಅನ್ನು "
"ಚಲಾಯಿಸಿ."

msgid ""
"Automatic updates are off: nothing updates until you run System Update yourself.\n"
"\n"
"Recommended: Turn on. Everything then updates by itself every day at 4 am, and updates fix security problems."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ಆಫ್ ಆಗಿವೆ: ನೀವು ಸ್ವತಃ ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಚಲಾಯಿಸುವವರೆಗೆ ಏನೂ ಅಪ್‌ಡೇಟ್ ಆಗುವುದಿಲ್ಲ.\n"
"\n"
"ಶಿಫಾರಸು: ಆನ್ ಮಾಡಿ. ನಂತರ ಎಲ್ಲವೂ ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ 4 ಗಂಟೆಗೆ ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ, ಮತ್ತು ಅಪ್‌ಡೇಟ್‌ಗಳು ಭದ್ರತಾ ಸಮಸ್ಯೆಗಳನ್ನು ಸರಿಪಡಿಸುತ್ತವೆ."

msgid "Automatic updates are on."
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ಆನ್ ಆಗಿವೆ."

msgid ""
"Automatic updates are on: everything updates by itself every day at 4 am.\n"
"\n"
"Recommended: Keep them on. Updates fix security problems.\n"
"\n"
"Or Turn off: nothing updates until you run System Update yourself."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ಆನ್ ಆಗಿವೆ: ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ 4 ಗಂಟೆಗೆ ಎಲ್ಲವೂ ತಾನಾಗಿಯೇ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ.\n"
"\n"
"ಶಿಫಾರಸು: ಅವುಗಳನ್ನು ಆನ್ ಆಗಿಯೇ ಇರಿಸಿ. ಅಪ್‌ಡೇಟ್‌ಗಳು ಭದ್ರತಾ ಸಮಸ್ಯೆಗಳನ್ನು ಸರಿಪಡಿಸುತ್ತವೆ.\n"
"\n"
"ಅಥವಾ ಆಫ್ ಮಾಡಿ: ನೀವೇ ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್ ಚಲಾಯಿಸುವವರೆಗೆ ಏನೂ ಅಪ್‌ಡೇಟ್ ಆಗುವುದಿಲ್ಲ."

#, python-brace-format
msgid "Automatic updates are paused until {day}"
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು {day} ರವರೆಗೆ ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ"

#, python-brace-format
msgid ""
"Automatic updates are paused until {day}, after an undo, so the bad update doesn't come back. They turn back on by themselves.\n"
"\n"
"Recommended: Keep the pause.\n"
"\n"
"Or Resume now: the next daily update runs as normal. Or Turn off: nothing updates until you run System Update yourself."
msgstr ""
"ಕೆಟ್ಟ ಅಪ್‌ಡೇಟ್ ಮತ್ತೆ ಬರದಂತೆ, ರದ್ದುಗೊಳಿಸಿದ ನಂತರ ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು {day} ರವರೆಗೆ ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ. ಅವು ತಾವಾಗಿಯೇ ಮತ್ತೆ ಆನ್ ಆಗುತ್ತವೆ.\n"
"\n"
"ಶಿಫಾರಸು: ವಿರಾಮವನ್ನು ಹಾಗೆಯೇ ಇರಿಸಿ.\n"
"\n"
"ಅಥವಾ ಈಗ ಪುನರಾರಂಭಿಸಿ: ಮುಂದಿನ ದೈನಂದಿನ ಅಪ್‌ಡೇಟ್ ಎಂದಿನಂತೆ ನಡೆಯುತ್ತದೆ. ಅಥವಾ ಆಫ್ ಮಾಡಿ: ನೀವು ಸ್ವತಃ ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಚಲಾಯಿಸುವವರೆಗೆ ಏನೂ ಅಪ್‌ಡೇಟ್ ಆಗುವುದಿಲ್ಲ."

#, python-brace-format
msgid ""
"Automatic updates are paused until {day}, so the bad update doesn't come "
"back. They turn back on by themselves."
msgstr ""
"ಕೆಟ್ಟ ಅಪ್‌ಡೇಟ್ ಮತ್ತೆ ಬರದಂತೆ, ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು {day} ರವರೆಗೆ "
"ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ. ಅವು ತಾವಾಗಿಯೇ ಮತ್ತೆ ಆನ್ ಆಗುತ್ತವೆ."

#, python-brace-format
msgid ""
"Automatic updates are paused until {day}, so the same update doesn't come "
"straight back. They turn back on by themselves."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು {day} ರವರೆಗೆ ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಅದೇ "
"ಅಪ್‌ಡೇಟ್ ತಕ್ಷಣವೇ ಮತ್ತೆ ಬರುವುದಿಲ್ಲ. ಅವು ತಾವಾಗಿಯೇ ಮತ್ತೆ ಆನ್ ಆಗುತ್ತವೆ."

msgid ""
"Automatic updates are still paused after the undo. Resume them in Automatic "
"updates."
msgstr ""
"ರದ್ದುಗೊಳಿಸಿದ ನಂತರವೂ ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ಇನ್ನೂ ವಿರಾಮದಲ್ಲಿವೆ. ಅವುಗಳನ್ನು "
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ವಿಭಾಗದಲ್ಲಿ ಪುನರಾರಂಭಿಸಿ."

msgid ""
"Automatic updates could not be paused, so the next one may bring the update "
"back. If it does, turn off Automatic updates in Wheelhouse and tell your "
"helper."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಆದ್ದರಿಂದ ಮುಂದಿನ "
"ಅಪ್‌ಡೇಟ್ ಅದೇ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಮತ್ತೆ ತರಬಹುದು. ಹಾಗಾದರೆ, Wheelhouse ನಲ್ಲಿ "
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಆಫ್ ಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ."

msgid ""
"Automatic updates pause for 3 days, so the same update doesn't come straight "
"back. They turn back on by themselves."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು 3 ದಿನಗಳವರೆಗೆ ವಿರಾಮಗೊಳಿಸಲಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಅದೇ "
"ಅಪ್‌ಡೇಟ್ ತಕ್ಷಣವೇ ಮತ್ತೆ ಬರುವುದಿಲ್ಲ. ಅವು ತಾವಾಗಿಯೇ ಮತ್ತೆ ಆನ್ ಆಗುತ್ತವೆ."

msgid ""
"Automatic updates then pause for 3 days, so the bad update doesn't come "
"straight back. If the problem returns after that, turn off Automatic updates "
"in Wheelhouse and tell your helper."
msgstr ""
"ನಂತರ ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು 3 ದಿನಗಳ ಕಾಲ ವಿರಾಮಗೊಳ್ಳುತ್ತವೆ, ಇದರಿಂದ ಕೆಟ್ಟ "
"ಅಪ್‌ಡೇಟ್ ತಕ್ಷಣ ಮತ್ತೆ ಬರುವುದಿಲ್ಲ. ಅದರ ನಂತರವೂ ಸಮಸ್ಯೆ ಮತ್ತೆ ಕಾಣಿಸಿಕೊಂಡರೆ, "
"Wheelhouse ನಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಆಫ್ ಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ "
"ತಿಳಿಸಿ."

msgid "Automatic updates, undoing an update, firmware and certificate alerts"
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು, ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸುವುದು, ಫರ್ಮ್‌ವೇರ್ ಮತ್ತು "
"ಪ್ರಮಾಣಪತ್ರ ಎಚ್ಚರಿಕೆಗಳು"

msgid ""
"Away from home, the switch shows off: sharing only runs on a Home network, "
"and comes back by itself there."
msgstr ""
"ಮನೆಯಿಂದ ಹೊರಗಿರುವಾಗ ಸ್ವಿಚ್ ಆಫ್ ಎಂದು ತೋರಿಸುತ್ತದೆ: ಹಂಚಿಕೆ ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿ "
"ಮಾತ್ರ ನಡೆಯುತ್ತದೆ, ಮತ್ತು ಅಲ್ಲಿ ತಾನಾಗಿಯೇ ಮತ್ತೆ ಆರಂಭವಾಗುತ್ತದೆ."

msgid "BIOS settings"
msgstr "BIOS ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "Back"
msgstr "ಹಿಂದೆ"

msgid "Back to the original"
msgstr "ಮೂಲಕ್ಕೆ ಹಿಂತಿರುಗಿ"

msgid "Background: click a picture. To use your own photo, click Add Picture."
msgstr ""
"ಹಿನ್ನೆಲೆ: ಒಂದು ಚಿತ್ರವನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ. ನಿಮ್ಮ ಸ್ವಂತ ಫೋಟೋ ಬಳಸಲು, \"Add "
"Picture\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Basic graphics only"
msgstr "ಮೂಲ ಗ್ರಾಫಿಕ್ಸ್ ಮಾತ್ರ"

msgid "Battery status"
msgstr "ಬ್ಯಾಟರಿ ಸ್ಥಿತಿ"

msgid "Bazaar is open. Close it when you're done looking."
msgstr "Bazaar ತೆರೆದಿದೆ. ನೋಡಿ ಮುಗಿದ ನಂತರ ಅದನ್ನು ಮುಚ್ಚಿ."

msgid "Bazaar, the app store (Flathub)"
msgstr "Bazaar, ಆ್ಯಪ್ ಸ್ಟೋರ್ (Flathub)"

msgid ""
"Before you unplug it, click the eject button next to its name, and wait until"
" it's gone from the list."
msgstr ""
"ನೀವು ಅದನ್ನು ತೆಗೆಯುವ ಮೊದಲು, ಅದರ ಹೆಸರಿನ ಪಕ್ಕದಲ್ಲಿರುವ ಈಜೆಕ್ಟ್ ಬಟನ್ ಕ್ಲಿಕ್ ಮಾಡಿ "
"ಮತ್ತು ಅದು ಪಟ್ಟಿಯಿಂದ ಕಣ್ಮರೆಯಾಗುವವರೆಗೆ ಕಾಯಿರಿ."

msgid "Bluetooth"
msgstr "ಬ್ಲೂಟೂತ್"

msgid "Bluetooth driver blocked"
msgstr "ಬ್ಲೂಟೂತ್ ಡ್ರೈವರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ"

msgid "Bluetooth found."
msgstr "ಬ್ಲೂಟೂತ್ ಕಂಡುಬಂದಿದೆ."

msgid "Boot entries that will be renamed to \"%s\":"
msgstr "\"%s\" ಎಂದು ಮರುಹೆಸರಿಸಲಾಗುವ ಬೂಟ್ ನಮೂದುಗಳು:"

msgid "Boot options"
msgstr "ಬೂಟ್ ಆಯ್ಕೆಗಳು"

msgid "Boot options in Wheelhouse can change them back later."
msgstr ""
"Wheelhouse ನಲ್ಲಿರುವ ಬೂಟ್ ಆಯ್ಕೆಗಳ ಮೂಲಕ ನಂತರ ಅವುಗಳನ್ನು ಮತ್ತೆ ಬದಲಾಯಿಸಬಹುದು."

msgid "Both"
msgstr "ಎರಡೂ"

msgid "Both ask for your password, and work only on Home."
msgstr ""
"ಎರಡೂ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಕೇಳುತ್ತವೆ, ಮತ್ತು ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿ ಮಾತ್ರ ಕೆಲಸ "
"ಮಾಡುತ್ತವೆ."

msgid "Bottom bar and a start menu"
msgstr "ಕೆಳಗಿನ ಪಟ್ಟಿ ಮತ್ತು ಸ್ಟಾರ್ಟ್ ಮೆನು"

msgid "Box"
msgstr "ಬಾಕ್ಸ್"

msgid "Broadcom Wi-Fi chip found. Its driver or firmware can't be included."
msgstr ""
"Broadcom Wi-Fi ಚಿಪ್ ಕಂಡುಬಂದಿದೆ. ಅದರ ಡ್ರೈವರ್ ಅಥವಾ ಫರ್ಮ್‌ವೇರ್ ಅನ್ನು ಸೇರಿಸಲು "
"ಸಾಧ್ಯವಿಲ್ಲ."

msgid "Browse and install apps in Bazaar. They update on their own."
msgstr ""
"Bazaar ನಲ್ಲಿ ಆ್ಯಪ್‌ಗಳನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ ಮತ್ತು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ. ಅವು ತಾವಾಗಿಯೇ "
"ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತವೆ."

msgid "Camera"
msgstr "ಕ್ಯಾಮೆರಾ"

msgid "Camera found."
msgstr "ಕ್ಯಾಮೆರಾ ಕಂಡುಬಂದಿದೆ."

msgid "Can install software and change system settings. Click to turn it off."
msgstr ""
"ಸಾಫ್ಟ್‌ವೇರ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಬಹುದು ಮತ್ತು ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು "
"ಬದಲಾಯಿಸಬಹುದು. ಅದನ್ನು ಆಫ್ ಮಾಡಲು ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Can install software and change system settings. Click to turn it on."
msgstr ""
"ಸಾಫ್ಟ್‌ವೇರ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಬಹುದು ಮತ್ತು ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು "
"ಬದಲಾಯಿಸಬಹುದು. ಇದನ್ನು ಆನ್ ಮಾಡಲು ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Cancel"
msgstr "ರದ್ದುಗೊಳಿಸಿ"

msgid "Certificate"
msgstr "ಪ್ರಮಾಣಪತ್ರ"

msgid "Certificate alert"
msgstr "ಪ್ರಮಾಣಪತ್ರದ ಎಚ್ಚರಿಕೆ"

msgid "Certificate alerts"
msgstr "ಪ್ರಮಾಣಪತ್ರ ಎಚ್ಚರಿಕೆಗಳು"

msgid ""
"Certificates are how the computer knows a secure website is real. An alert "
"shows when one has expired, expires soon, or was removed."
msgstr ""
"ಸುರಕ್ಷಿತ ವೆಬ್‌ಸೈಟ್ ನಿಜವಾದುದೆಂದು ಕಂಪ್ಯೂಟರ್‌ಗೆ ತಿಳಿಯಲು ಪ್ರಮಾಣಪತ್ರಗಳು "
"ನೆರವಾಗುತ್ತವೆ. ಒಂದು ಪ್ರಮಾಣಪತ್ರವು ಅವಧಿ ಮೀರಿದಾಗ, ಶೀಘ್ರದಲ್ಲೇ ಅವಧಿ ಮುಗಿಯುವಾಗ ಅಥವಾ "
"ಅದನ್ನು ತೆಗೆದುಹಾಕಿದಾಗ ಎಚ್ಚರಿಕೆಯೊಂದು ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ."

msgid "Change"
msgstr "ಬದಲಾಯಿಸಿ"

msgid "Change Scale. A bigger number makes everything bigger."
msgstr ""
"\"ಗಾತ್ರ ಬದಲಾವಣೆ\" ಮೌಲ್ಯವನ್ನು ಬದಲಾಯಿಸಿ. ದೊಡ್ಡ ಸಂಖ್ಯೆ ಎಲ್ಲವನ್ನೂ "
"ದೊಡ್ಡದಾಗಿಸುತ್ತದೆ."

msgid "Change a Wheelhouse setting"
msgstr "Wheelhouse ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಿ"

msgid "Change it"
msgstr "ಅದನ್ನು ಬದಲಾಯಿಸಿ"

msgid "Change the kernel settings the computer starts with"
msgstr "ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾಗುವಾಗ ಬಳಸುವ ಕರ್ನಲ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಿ"

msgid "Change the layout"
msgstr "ಲೇಔಟ್ ಬದಲಾಯಿಸಿ"

msgid "Change the wallpaper to the next picture in a folder"
msgstr "ವಾಲ್‌ಪೇಪರ್ ಅನ್ನು ಫೋಲ್ಡರ್‌ನಲ್ಲಿರುವ ಮುಂದಿನ ಚಿತ್ರಕ್ಕೆ ಬದಲಾಯಿಸಿ"

msgid ""
"Changed your mind? Open Undo the last update again and click Use the newer "
"version."
msgstr ""
"ನಿಮ್ಮ ಮನಸ್ಸು ಬದಲಾಯಿತೇ? ಮತ್ತೆ \"ಕೊನೆಯ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಿ\" ತೆರೆಯಿರಿ "
"ಮತ್ತು \"ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಬಳಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

#, python-brace-format
msgid "Changing {title}"
msgstr "{title} ಅನ್ನು ಬದಲಾಯಿಸಲಾಗುತ್ತಿದೆ"

msgid ""
"Check everything. Click a line to change it, or click Install to put "
"EvenKeelOS on the disk."
msgstr ""
"ಎಲ್ಲವನ್ನೂ ಪರಿಶೀಲಿಸಿ. ಬದಲಾಯಿಸಲು ಒಂದು ಸಾಲಿನ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ, ಅಥವಾ EvenKeelOS "
"ಅನ್ನು ಡಿಸ್ಕ್‌ನಲ್ಲಿ ಇರಿಸಲು \"ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Check that automatic rollback works"
msgstr "ಸ್ವಯಂಚಾಲಿತ ರೋಲ್‌ಬ್ಯಾಕ್ ಸರಿಯಾಗಿ ಕೆಲಸ ಮಾಡುತ್ತಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ"

msgid "Check that it can't break"
msgstr "ಅದು ಹಾಳಾಗುವುದಿಲ್ಲ ಎಂದು ಪರಿಶೀಲಿಸಿ"

msgid ""
"Check that the computer goes back by itself when a new version won't start, "
"and puts back deleted settings"
msgstr ""
"ಹೊಸ ಆವೃತ್ತಿಯು ಪ್ರಾರಂಭವಾಗದಿದ್ದಾಗ ಕಂಪ್ಯೂಟರ್ ಸ್ವತಃ ಹಿಂದಿರುಗುತ್ತದೆಯೇ ಮತ್ತು "
"ಅಳಿಸಲಾದ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರಳಿ ಇಡುತ್ತದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ"

msgid "Check the BIOS's storage settings."
msgstr "BIOS ನ ಸಂಗ್ರಹಣೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."

msgid "Check the boxes"
msgstr "ಬಾಕ್ಸ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ"

msgid "Checked against its own docs"
msgstr "ಅದರ ಸ್ವಂತ ದಾಖಲೆಗಳೊಂದಿಗೆ ಹೋಲಿಸಿ ಪರಿಶೀಲಿಸಲಾಗಿದೆ"

msgid "Checked every day too"
msgstr "ಪ್ರತಿದಿನವೂ ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ"

msgid "Checking for firmware updates."
msgstr "ಫರ್ಮ್‌ವೇರ್ ಅಪ್‌ಡೇಟ್‌ಗಳಿಗಾಗಿ ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ."

msgid "Checking sharing…"
msgstr "ಹಂಚಿಕೆಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ…"

msgid "Checking the network…"
msgstr "ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ…"

msgid "Checking this computer's parts..."
msgstr "ಈ ಕಂಪ್ಯೂಟರ್‌ನ ಭಾಗಗಳನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ..."

#, python-brace-format
msgid "Checking whether Fedora has {name}."
msgstr "Fedora ನಲ್ಲಿ {name} ಇದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ."

msgid "Checking…"
msgstr "ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ…"

msgid "Choose"
msgstr "ಆರಿಸಿ"

msgid "Choose apps from .rpm or .deb files that start when you log in"
msgstr ""
".rpm ಅಥವಾ .deb ಫೈಲ್‌ಗಳಿಂದ ಬಂದ ಆ್ಯಪ್‌ಗಳಲ್ಲಿ, ನೀವು ಲಾಗ್ ಇನ್ ಮಾಡಿದಾಗ "
"ಪ್ರಾರಂಭವಾಗಬೇಕಾದವುಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ"

msgid "Choose which app opens a file"
msgstr "ಫೈಲ್ ಅನ್ನು ಯಾವ ಆ್ಯಪ್ ತೆರೆಯಬೇಕು ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ"

#, python-brace-format
msgid "Chosen: automatic, from {servers}."
msgstr "ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ: ಸ್ವಯಂಚಾಲಿತ, {servers} ನಿಂದ."

msgid "Chosen: don't encrypt."
msgstr "ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ: ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಬೇಡಿ."

msgid "Chosen: enabled."
msgstr "ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ: ಸಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ."

msgid "Chosen: encrypt."
msgstr "ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ: ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿ."

msgid "Chosen: locked."
msgstr "ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ: ಲಾಕ್ ಮಾಡಲಾಗಿದೆ."

#, python-brace-format
msgid "Chosen: {disk}."
msgstr "ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ: {disk}."

#, python-brace-format
msgid "Chosen: {names}."
msgstr "ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ: {names}."

#, python-brace-format
msgid "Chosen: {name}."
msgstr "ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ: {name}."

#, python-brace-format
msgid "Chosen: {time}."
msgstr "ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ: {time}."

msgid ""
"Click Add a folder and pick it. It starts as Read only: change it to Read and"
" write if the other computer should save there too."
msgstr ""
"\"ಫೋಲ್ಡರ್ ಸೇರಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು ಅದನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಇದು ಆರಂಭದಲ್ಲಿ ಓದಲು "
"ಮಾತ್ರ ಆಗಿರುತ್ತದೆ: ಇನ್ನೊಂದು ಕಂಪ್ಯೂಟರ್ ಕೂಡ ಅಲ್ಲಿ ಸೇವ್ ಮಾಡಬೇಕಿದ್ದರೆ, ಅದನ್ನು ಓದಲು"
" ಮತ್ತು ಬರೆಯಲು ಎಂದು ಬದಲಾಯಿಸಿ."

msgid "Click Apply, then Keep Changes if it looks right."
msgstr ""
"\"ಅನ್ವಯಿಸು\" ಕ್ಲಿಕ್ ಮಾಡಿ, ನಂತರ ಅದು ಸರಿಯಾಗಿ ಕಾಣಿಸಿದರೆ \"ಬದಲಾವಣೆಗಳನ್ನು ಉಳಿಸು\" "
"ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Click Back to the original to undo all of it."
msgstr "ಎಲ್ಲವನ್ನೂ ರದ್ದುಗೊಳಿಸಲು \"ಮೂಲಕ್ಕೆ ಹಿಂತಿರುಗಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid ""
"Click Free up disk space, then Free up space. Your files and apps aren't "
"touched."
msgstr ""
"\"ಡಿಸ್ಕ್ ಸ್ಥಳವನ್ನು ಮುಕ್ತಗೊಳಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ, ನಂತರ \"ಸ್ಥಳವನ್ನು ಮುಕ್ತಗೊಳಿಸಿ\" "
"ಕ್ಲಿಕ್ ಮಾಡಿ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳಿಗೆ ಏನೂ ಆಗುವುದಿಲ್ಲ."

msgid ""
"Click Install the driver, type your password, and restart. Then add the "
"printer."
msgstr ""
"\"ಡ್ರೈವರ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ, ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಟೈಪ್ "
"ಮಾಡಿ ಮತ್ತು ಮರುಪ್ರಾರಂಭಿಸಿ. ನಂತರ ಪ್ರಿಂಟರ್ ಅನ್ನು ಸೇರಿಸಿ."

msgid "Click Install, and it installs that instead."
msgstr ""
"\"ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ, ಆಗ ಅದು ಅದರ ಬದಲಿಗೆ ಅದನ್ನು ಇನ್‌ಸ್ಟಾಲ್ "
"ಮಾಡುತ್ತದೆ."

msgid ""
"Click Let an app in, type its name, like Minecraft or Jellyfin, and click it."
msgstr ""
"\"ಆ್ಯಪ್‌ಗೆ ಅನುಮತಿ ನೀಡಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ, ಅದರ ಹೆಸರನ್ನು ಟೈಪ್ ಮಾಡಿ (ಉದಾಹರಣೆಗೆ "
"Minecraft ಅಥವಾ Jellyfin), ಮತ್ತು ಅದನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid ""
"Click Restart to start EvenKeelOS. Click Save the log to put the details of "
"this install on a second USB stick."
msgstr ""
"EvenKeelOS ಅನ್ನು ಪ್ರಾರಂಭಿಸಲು \"ಮರುಪ್ರಾರಂಭಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ. ಈ ಇನ್‌ಸ್ಟಾಲ್‌ನ "
"ವಿವರಗಳನ್ನು ಎರಡನೇ USB ಸ್ಟಿಕ್‌ನಲ್ಲಿ ಇರಿಸಲು \"ಲಾಗ್ ಅನ್ನು ಉಳಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid ""
"Click Save details. It makes one file of recent errors, in Documents. Nothing"
" is sent anywhere."
msgstr ""
"\"ವಿವರಗಳನ್ನು ಉಳಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ. ಇದು ಇತ್ತೀಚಿನ ದೋಷಗಳ ಒಂದು ಫೈಲ್ ಅನ್ನು "
"ದಸ್ತಾವೇಜುಗಳು ಫೋಲ್ಡರ್‌ನಲ್ಲಿ ರಚಿಸುತ್ತದೆ. ಯಾವುದನ್ನೂ ಎಲ್ಲಿಗೂ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ."

msgid "Click Show the file, then attach it to an email to your helper."
msgstr ""
"\"ಫೈಲ್ ಅನ್ನು ತೋರಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ, ನಂತರ ಅದನ್ನು ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ಕಳುಹಿಸುವ "
"ಇಮೇಲ್‌ಗೆ ಲಗತ್ತಿಸಿ."

msgid "Click Test to hear each speaker."
msgstr "ಪ್ರತಿ ಸ್ಪೀಕರ್ ಅನ್ನು ಕೇಳಲು \"ಪರೀಕ್ಷೆ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Click Turn off or Turn on. Turning them off asks for your password."
msgstr ""
"\"ಆಫ್ ಮಾಡಿ\" ಅಥವಾ \"ಆನ್ ಮಾಡಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ. ಅವುಗಳನ್ನು ಆಫ್ ಮಾಡಿದಾಗ ನಿಮ್ಮ "
"ಪಾಸ್‌ವರ್ಡ್ ಕೇಳುತ್ತದೆ."

msgid "Click Turn on, type the disk password once, and restart."
msgstr ""
"\"ಆನ್ ಮಾಡಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ, ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಒಮ್ಮೆ ಟೈಪ್ ಮಾಡಿ ಮತ್ತು "
"ಮರುಪ್ರಾರಂಭಿಸಿ."

msgid ""
"Click Undo the update, type your password, and restart. Your files and apps "
"aren't touched."
msgstr ""
"\"ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ, ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಟೈಪ್ ಮಾಡಿ ಮತ್ತು "
"ಮರುಪ್ರಾರಂಭಿಸಿ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳಿಗೆ ಏನೂ ಆಗುವುದಿಲ್ಲ."

msgid ""
"Click a font to pick another, or change Text size. 1.00 is the normal size."
msgstr ""
"ಬೇರೊಂದು ಫಾಂಟ್ ಆಯ್ಕೆಮಾಡಲು ಫಾಂಟ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ ಅಥವಾ ಪಠ್ಯ ಗಾತ್ರವನ್ನು "
"ಬದಲಾಯಿಸಿ. 1.00 ಸಾಮಾನ್ಯ ಗಾತ್ರವಾಗಿದೆ."

msgid "Click the USB stick to save them on."
msgstr "ಅವುಗಳನ್ನು ಸೇವ್ ಮಾಡಲು USB ಸ್ಟಿಕ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid ""
"Click the clock to see your notifications and the calendar. Or press Windows "
"key + V."
msgstr ""
"ನಿಮ್ಮ ಅಧಿಸೂಚನೆಗಳು ಮತ್ತು ಕ್ಯಾಲೆಂಡರ್ ನೋಡಲು ಗಡಿಯಾರದ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ. ಅಥವಾ "
"Windows ಕೀ + V ಒತ್ತಿರಿ."

msgid "Click the copy button next to a command, then paste it in Terminal."
msgstr ""
"ಆಜ್ಞೆಯ ಪಕ್ಕದಲ್ಲಿರುವ ನಕಲಿಸಿ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ, ನಂತರ ಅದನ್ನು ಟರ್ಮಿನಲ್‌ನಲ್ಲಿ"
" ಅಂಟಿಸಿ."

msgid "Click the device's name when it shows in the list."
msgstr "ಪಟ್ಟಿಯಲ್ಲಿ ಕಾಣಿಸಿಕೊಂಡಾಗ ಸಾಧನದ ಹೆಸರನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid ""
"Click the icons at the end of the bar, then the arrow next to Wi-Fi. Or open "
"Settings, Wi-Fi."
msgstr ""
"ಪಟ್ಟಿಯ ಕೊನೆಯಲ್ಲಿರುವ ಐಕಾನ್‌ಗಳನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ, ನಂತರ Wi-Fi ಪಕ್ಕದಲ್ಲಿರುವ "
"ಬಾಣವನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ. ಅಥವಾ ಸಿದ್ಧತೆಗಳು, ವೈ-ಫೈ ತೆರೆಯಿರಿ."

msgid ""
"Click the icons at the end of the bar: the bottom right with the Windows-"
"style layout, the top right with the standard one. Or press Windows key + S."
msgstr ""
"ಪಟ್ಟಿಯ ಕೊನೆಯಲ್ಲಿರುವ ಐಕಾನ್‌ಗಳನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ: Windows ಶೈಲಿಯ ಲೇಔಟ್‌ನಲ್ಲಿ "
"ಕೆಳಗಿನ ಬಲ ಮೂಲೆಯಲ್ಲಿ, ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಲೇಔಟ್‌ನಲ್ಲಿ ಮೇಲಿನ ಬಲ ಮೂಲೆಯಲ್ಲಿ. ಅಥವಾ "
"Windows ಕೀ + S ಒತ್ತಿರಿ."

msgid ""
"Click the magnifying glass, or press Ctrl+F, and type to search this folder "
"and the folders in it."
msgstr ""
"ಭೂತಗನ್ನಡಿಯನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ, ಅಥವಾ Ctrl+F ಒತ್ತಿ, ಮತ್ತು ಈ ಫೋಲ್ಡರ್ ಹಾಗೂ ಅದರೊಳಗಿನ "
"ಫೋಲ್ಡರ್‌ಗಳಲ್ಲಿ ಹುಡುಕಲು ಟೈಪ್ ಮಾಡಿ."

msgid "Click the meeting link you were sent."
msgstr "ನಿಮಗೆ ಕಳುಹಿಸಲಾದ ಮೀಟಿಂಗ್ ಲಿಂಕ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Click the network's name, type its password, and press Enter."
msgstr ""
"ನೆಟ್‌ವರ್ಕ್‌ನ ಹೆಸರನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ, ಅದರ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ ಮತ್ತು Enter"
" ಅನ್ನು ಒತ್ತಿರಿ."

msgid ""
"Click the printer when it shows, then Add. Most printers need nothing else."
msgstr ""
"ಪ್ರಿಂಟರ್ ಕಾಣಿಸಿಕೊಂಡಾಗ ಅದರ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ, ನಂತರ \"ಸೇರಿಸು\" ಕ್ಲಿಕ್ ಮಾಡಿ. "
"ಹೆಚ್ಚಿನ ಪ್ರಿಂಟರ್‌ಗಳಿಗೆ ಬೇರೆ ಏನೂ ಬೇಕಾಗಿರುವುದಿಲ್ಲ."

msgid "Clock"
msgstr "ಗಡಿಯಾರ"

msgid "Clock sync"
msgstr "ಗಡಿಯಾರ ಸಿಂಕ್"

msgid "Close"
msgstr "ಮುಚ್ಚಿ"

msgid "Close it again"
msgstr "ಇದನ್ನು ಮತ್ತೆ ಮುಚ್ಚಿ"

#, python-brace-format
msgid "Close {name} again"
msgstr "{name} ಅನ್ನು ಮತ್ತೆ ಮುಚ್ಚಿ"

msgid "Code and terminal"
msgstr "ಕೋಡ್ ಮತ್ತು ಟರ್ಮಿನಲ್"

msgid "Collecting the problem details."
msgstr "ಸಮಸ್ಯೆಯ ವಿವರಗಳನ್ನು ಸಂಗ್ರಹಿಸಲಾಗುತ್ತಿದೆ."

msgid "Colors and wallpaper"
msgstr "ಬಣ್ಣಗಳು ಮತ್ತು ವಾಲ್‌ಪೇಪರ್"

msgid "Comes with the system"
msgstr "ಸಿಸ್ಟಂನೊಂದಿಗೆ ಬರುತ್ತದೆ"

msgid "Coming from Windows"
msgstr "Windows ನಿಂದ ಬರುತ್ತಿರುವವರು"

msgid "Coming from Windows: where things are, and what's different"
msgstr "Windows ನಿಂದ ಬರುತ್ತಿರುವಿರಾ: ವಿಷಯಗಳು ಎಲ್ಲಿವೆ, ಮತ್ತು ಯಾವುದು ಭಿನ್ನವಾಗಿದೆ"

msgid "Coming from Windows?"
msgstr "Windows ನಿಂದ ಬರುತ್ತಿದ್ದೀರಾ?"

msgid "Common fixes"
msgstr "ಸಾಮಾನ್ಯ ಪರಿಹಾರಗಳು"

msgid "Computer name"
msgstr "ಕಂಪ್ಯೂಟರ್ ಹೆಸರು"

#, python-brace-format
msgid "Computer name: {name}."
msgstr "ಕಂಪ್ಯೂಟರ್ ಹೆಸರು: {name}."

msgid "Connect"
msgstr "ಸಂಪರ್ಕಿಸಿ"

msgid "Connect a Bluetooth device"
msgstr "ಬ್ಲೂಟೂತ್ ಸಾಧನವನ್ನು ಸಂಪರ್ಕಿಸಿ"

#, python-brace-format
msgid "Connected to {network}."
msgstr "{network} ಗೆ ಸಂಪರ್ಕಗೊಂಡಿದೆ."

#, python-brace-format
msgid "Connecting to {network}..."
msgstr "{network} ಗೆ ಸಂಪರ್ಕಿಸಲಾಗುತ್ತಿದೆ..."

msgid ""
"Control Panel: Settings, for Wi-Fi, screens, sound, printers and accounts. "
"Wheelhouse, for updates, apps and fixes. A ship is steered from its "
"wheelhouse; this is where you steer your computer."
msgstr ""
"ನಿಯಂತ್ರಣ ಫಲಕ: Wi-Fi, ಪರದೆಗಳು, ಧ್ವನಿ, ಪ್ರಿಂಟರ್‌ಗಳು ಮತ್ತು ಖಾತೆಗಳಿಗಾಗಿ "
"ಸಿದ್ಧತೆಗಳು. ಅಪ್‌ಡೇಟ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಪರಿಹಾರಗಳಿಗಾಗಿ Wheelhouse. ಹಡಗನ್ನು "
"ಅದರ ಚುಕ್ಕಾಣಿ ಕೊಠಡಿಯಿಂದ (wheelhouse) ನಡೆಸಲಾಗುತ್ತದೆ; ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ನೀವು"
