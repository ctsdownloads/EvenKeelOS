msgstr ""
"ಗಡಿಯಾರವನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸರಿಯಾಗಿ ಇರಿಸಿ ಅಥವಾ ದಿನಾಂಕ ಮತ್ತು ಸಮಯವನ್ನು ನೀವೇ "
"ಹೊಂದಿಸಿ."

msgid "Keep the pause"
msgstr "ವಿರಾಮವನ್ನು ಹಾಗೆಯೇ ಇರಿಸಿ"

msgid "Keep them off"
msgstr "ಅವುಗಳನ್ನು ಆಫ್ ಆಗಿಯೇ ಇರಿಸಿ"

msgid "Keep them on"
msgstr "ಅವುಗಳನ್ನು ಆನ್ ಆಗಿಯೇ ಇರಿಸಿ"

msgid "Keep these options"
msgstr "ಈ ಆಯ್ಕೆಗಳನ್ನು ಉಳಿಸಿಕೊಳ್ಳಿ"

msgid "Keep this update"
msgstr "ಈ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಉಳಿಸಿಕೊಳ್ಳಿ"

msgid "Keeping it in its sandbox"
msgstr "ಇದನ್ನು ಅದರ ಸ್ಯಾಂಡ್‌ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಇರಿಸುವುದು"

msgid "Keeps the drive out of its deepest power saving"
msgstr "ಡ್ರೈವ್ ಅನ್ನು ಅದರ ಅತ್ಯಂತ ಆಳವಾದ ವಿದ್ಯುತ್ ಉಳಿತಾಯ ಸ್ಥಿತಿಯಿಂದ ಹೊರಗಿಡುತ್ತದೆ"

msgid ""
"Keeps the folder icons in the accent color picked in Settings, Appearance"
msgstr ""
"ಸಿದ್ಧತೆಗಳು, Appearance ಇಲ್ಲಿ ಆಯ್ಕೆಮಾಡಿದ ಆಕ್ಸೆಂಟ್ ಬಣ್ಣದಲ್ಲಿ ಫೋಲ್ಡರ್ "
"ಐಕಾನ್‌ಗಳನ್ನು ಇರಿಸುತ್ತದೆ"

msgid "Keyboard"
msgstr "ಕೀಬೋರ್ಡ್"

msgid "Keyboard at start"
msgstr "ಪ್ರಾರಂಭದಲ್ಲಿ ಕೀಬೋರ್ಡ್"

msgid "Keyboard for the disk password"
msgstr "ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್‌ಗಾಗಿ ಕೀಬೋರ್ಡ್"

msgid "Keyboard layout"
msgstr "ಕೀಬೋರ್ಡ್ ಲೇಔಟ್"

msgid "Language"
msgstr "ಭಾಷೆ"

msgid "Later"
msgstr "ನಂತರ"

msgid "Layout"
msgstr "ಡೆಸ್ಕ್‌ಟಾಪ್ ಲೇಔಟ್"

#, python-brace-format
msgid "Layout set to {layout}. Log out and back in to finish."
msgstr ""
"ಲೇಔಟ್ ಅನ್ನು {layout} ಗೆ ಹೊಂದಿಸಲಾಗಿದೆ. ಪೂರ್ಣಗೊಳಿಸಲು ಲಾಗ್ ಔಟ್ ಮಾಡಿ ಮತ್ತು ಮತ್ತೆ "
"ಲಾಗ್ ಇನ್ ಮಾಡಿ."

msgid "Let an app in"
msgstr "ಆ್ಯಪ್‌ಗೆ ಅನುಮತಿ ನೀಡಿ"

msgid "Let an app in on Home"
msgstr "ಮನೆಯಲ್ಲಿ ಆ್ಯಪ್‌ಗೆ ಅನುಮತಿ ನೀಡಿ"

msgid "Let an app in on Work"
msgstr "ಕೆಲಸದ ಸ್ಥಳದಲ್ಲಿ ಆ್ಯಪ್‌ಗೆ ಅನುಮತಿ ನೀಡಿ"

msgid "Let an app in on a Public place"
msgstr "ಸಾರ್ವಜನಿಕ ಸ್ಥಳದಲ್ಲಿ ಆ್ಯಪ್‌ಗೆ ಅನುಮತಿ ನೀಡಿ"

msgid "Let an app or game in"
msgstr "ಆ್ಯಪ್ ಅಥವಾ ಗೇಮ್‌ಗೆ ಅನುಮತಿ ನೀಡಿ"

msgid ""
"Let computers on your Home network open folders you pick, with a password"
msgstr ""
"ನಿಮ್ಮ ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವ ಕಂಪ್ಯೂಟರ್‌ಗಳಿಗೆ ನೀವು ಆಯ್ಕೆಮಾಡಿದ ಫೋಲ್ಡರ್‌ಗಳನ್ನು "
"ಪಾಸ್‌ವರ್ಡ್‌ನೊಂದಿಗೆ ತೆರೆಯಲು ಅನುಮತಿಸಿ"

msgid "Let in a port by its number, with a name for it"
msgstr "ಪೋರ್ಟ್ ಅನ್ನು ಅದರ ಸಂಖ್ಯೆಯ ಮೂಲಕ, ಅದಕ್ಕೆ ಹೆಸರಿಟ್ಟು ಒಳಗೆ ಬಿಡಿ"

msgid "Let it in"
msgstr "ಅದನ್ನು ಒಳಗೆ ಬಿಡಿ"

msgid "Let other computers in"
msgstr "ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳನ್ನು ಒಳಗೆ ಬಿಡಿ"

#, python-brace-format
msgid "Let {name} in on a Public place?"
msgstr "ಸಾರ್ವಜನಿಕ ಸ್ಥಳದಲ್ಲಿ {name} ಅನ್ನು ಒಳಗೆ ಬಿಡಬೇಕೇ?"

msgid "Light and dark"
msgstr "ಲೈಟ್ ಮತ್ತು ಡಾರ್ಕ್"

msgid "Light and dark schedule and wallpaper slideshow"
msgstr "ಲೈಟ್ ಮತ್ತು ಡಾರ್ಕ್ ವೇಳಾಪಟ್ಟಿ ಮತ್ತು ವಾಲ್‌ಪೇಪರ್ ಸ್ಲೈಡ್‌ಶೋ"

msgid "Light from"
msgstr "ಲೈಟ್ ಆರಂಭ"

msgid "Locked"
msgstr "ಲಾಕ್ ಮಾಡಲಾಗಿದೆ"

msgid "Log in from another computer (SSH)"
msgstr "ಮತ್ತೊಂದು ಕಂಪ್ಯೂಟರ್‌ನಿಂದ ಲಾಗ್ ಇನ್ ಮಾಡಿ (SSH)"

msgid ""
"Log in from another computer (SSH): for people who use a terminal. Leave it "
"off if you don't know it."
msgstr ""
"ಮತ್ತೊಂದು ಕಂಪ್ಯೂಟರ್‌ನಿಂದ ಲಾಗ್ ಇನ್ ಮಾಡಿ (SSH): ಟರ್ಮಿನಲ್ ಬಳಸುವ ಜನರಿಗೆ. ನಿಮಗೆ ಅದು"
" ಗೊತ್ತಿಲ್ಲದಿದ್ದರೆ ಅದನ್ನು ಆಫ್ ಆಗಿಯೇ ಬಿಡಿ."

msgid ""
"Log in when the login screen shows. About 3 minutes after you log in, a "
"window asks before the computer restarts. That happens on 2 starts, and the "
"third start is back on this version. If nobody logs in, each start waits 15 "
"minutes first, then restarts by itself."
msgstr ""
"ಲಾಗಿನ್ ಪರದೆ ಕಾಣಿಸಿಕೊಂಡಾಗ ಲಾಗ್ ಇನ್ ಮಾಡಿ. ನೀವು ಲಾಗ್ ಇನ್ ಮಾಡಿದ ಸುಮಾರು 3 ನಿಮಿಷಗಳ "
"ನಂತರ, ಕಂಪ್ಯೂಟರ್ ಮರುಪ್ರಾರಂಭವಾಗುವ ಮೊದಲು ಒಂದು ವಿಂಡೋ ಕೇಳುತ್ತದೆ. ಇದು 2 "
"ಪ್ರಾರಂಭಗಳಲ್ಲಿ ಆಗುತ್ತದೆ, ಮತ್ತು ಮೂರನೇ ಪ್ರಾರಂಭವು ಮತ್ತೆ ಈ ಆವೃತ್ತಿಯಲ್ಲಿ ಆಗುತ್ತದೆ. "
"ಯಾರೂ ಲಾಗ್ ಇನ್ ಮಾಡದಿದ್ದರೆ, ಪ್ರತಿ ಪ್ರಾರಂಭವೂ ಮೊದಲು 15 ನಿಮಿಷ ಕಾಯುತ್ತದೆ, ನಂತರ "
"ತಾನಾಗಿಯೇ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

#, python-brace-format
msgid "Log out and back in once, so {title} lets your account use it."
msgstr ""
"ಒಮ್ಮೆ ಲಾಗ್ ಔಟ್ ಮಾಡಿ, ನಂತರ ಮತ್ತೆ ಲಾಗ್ ಇನ್ ಮಾಡಿ. ಆಗ {title} ನಿಮ್ಮ ಖಾತೆಗೆ ಅದನ್ನು"
" ಬಳಸಲು ಅನುಮತಿಸುತ್ತದೆ."

msgid "Log out and back in to see it."
msgstr "ಅದನ್ನು ನೋಡಲು ಲಾಗ್ ಔಟ್ ಮಾಡಿ ಮತ್ತು ಮತ್ತೆ ಲಾಗ್ ಇನ್ ಮಾಡಿ."

msgid "Log out and back in to see the new layout."
msgstr "ಹೊಸ ಲೇಔಟ್ ನೋಡಲು ಲಾಗ್ ಔಟ್ ಮಾಡಿ ಮತ್ತೆ ಲಾಗ್ ಇನ್ ಮಾಡಿ."

msgid "Logging in drops you back"
msgstr "ಲಾಗ್ ಇನ್ ಮಾಡಿದರೆ ಮತ್ತೆ ಲಾಗಿನ್ ಪರದೆಗೆ ಹಿಂತಿರುಗುತ್ತೀರಿ"

msgid "Login loop"
msgstr "ಲಾಗಿನ್ ಲೂಪ್"

msgid "Looking up website names (DNS)"
msgstr "ವೆಬ್‌ಸೈಟ್ ಹೆಸರುಗಳನ್ನು ಹುಡುಕಲಾಗುತ್ತಿದೆ (DNS)"

msgid "Make everything bigger or smaller"
msgstr "ಎಲ್ಲವನ್ನೂ ದೊಡ್ಡದಾಗಿಸಿ ಅಥವಾ ಚಿಕ್ಕದಾಗಿಸಿ"

msgid "Make it a Public place"
msgstr "ಇದನ್ನು ಸಾರ್ವಜನಿಕ ಸ್ಥಳವನ್ನಾಗಿ ಮಾಡಿ"

msgid "Make it yours"
msgstr "ಇದನ್ನು ನಿಮ್ಮದಾಗಿಸಿಕೊಳ್ಳಿ"

msgid "Makes one file of recent errors. Email it to your helper."
msgstr ""
"ಇತ್ತೀಚಿನ ದೋಷಗಳ ಒಂದು ಫೈಲ್ ಅನ್ನು ರಚಿಸುತ್ತದೆ. ಇದನ್ನು ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ಇಮೇಲ್ ಮಾಡಿ."

msgid "Making it yours"
