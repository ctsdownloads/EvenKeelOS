"Updating the system: downloading the new version, {size} in {n} parts."
msgstr[0] ""
"ಸಿಸ್ಟಂ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ: ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಡೌನ್‌ಲೋಡ್ "
"ಮಾಡಲಾಗುತ್ತಿದೆ, {size}, {n} ಭಾಗದಲ್ಲಿ."
msgstr[1] ""
"ಸಿಸ್ಟಂ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ: ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಡೌನ್‌ಲೋಡ್ "
"ಮಾಡಲಾಗುತ್ತಿದೆ, {size}, {n} ಭಾಗಗಳಲ್ಲಿ."

msgid "Updating the system: it is already up to date."
msgstr "ಸಿಸ್ಟಂ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ: ಇದು ಈಗಾಗಲೇ ಅಪ್‌ಡೇಟ್ ಆಗಿದೆ."

#, python-brace-format
msgid "Updating the system: step {step} of {total}, {stage} ({elapsed})."
