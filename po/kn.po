msgid "Install"
msgstr "ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install Chrome"
msgstr "Chrome ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install EvenKeelOS"
msgstr "EvenKeelOS ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install EvenKeelOS on this computer"
msgstr "ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ EvenKeelOS ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid ""
"Install EvenKeelOS puts it on this computer. Or Try it first: Install "
