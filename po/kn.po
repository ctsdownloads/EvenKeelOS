"ಸಿಸ್ಟಂ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ: ಹಂತ {step} / {total}, {stage} "
"({elapsed})."

#, python-brace-format
msgid "Updating the system: step {step} of {total}, {stage}."
msgstr "ಸಿಸ್ಟಂ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ: ಹಂತ {step} / {total}, {stage}."

msgid ""
"Updating the system: the new version is installed. It starts at your next "
