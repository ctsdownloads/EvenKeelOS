msgid ""
"Open Wheelhouse, Network safety. Your networks lists every network this "
"computer has joined."
msgstr ""
"Wheelhouse ತೆರೆಯಿರಿ, ನೆಟ್‌ವರ್ಕ್ ಸುರಕ್ಷತೆ. \"ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್‌ಗಳು\" ಈ "
"ಕಂಪ್ಯೂಟರ್ ಸೇರಿರುವ ಪ್ರತಿಯೊಂದು ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಪಟ್ಟಿ ಮಾಡುತ್ತದೆ."

msgid "Open Wheelhouse, Shared folders."
msgstr "Wheelhouse ತೆರೆಯಿರಿ, ಹಂಚಿದ ಫೋಲ್ಡರ್‌ಗಳು."

msgid "Open Wheelhouse, Updates, Automatic updates. On is recommended."
msgstr ""
"Wheelhouse ತೆರೆಯಿರಿ, ಅಪ್‌ಡೇಟ್‌ಗಳು, ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು. ಆನ್ ಆಗಿರಿಸುವುದು "
"ಶಿಫಾರಸು."

msgid ""
"Open Wi-Fi, with no password, is always a Public place, because anyone can "
"make one with the same name."
msgstr ""
"ಪಾಸ್‌ವರ್ಡ್ ಇಲ್ಲದ ಓಪನ್ Wi-Fi ಯಾವಾಗಲೂ ಸಾರ್ವಜನಿಕ ಸ್ಥಳವಾಗಿರುತ್ತದೆ, ಏಕೆಂದರೆ ಅದೇ "
"ಹೆಸರಿನಲ್ಲಿ ಯಾರಾದರೂ ಒಂದು ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ರಚಿಸಬಹುದು."

msgid "Open a port"
msgstr "ಪೋರ್ಟ್ ತೆರೆಯಿರಿ"

msgid "Open a port on Home"
msgstr "ಮನೆಯಲ್ಲಿ ಪೋರ್ಟ್ ತೆರೆಯಿರಿ"

msgid "Open a port on Work"
msgstr "ಕೆಲಸದ ಸ್ಥಳದಲ್ಲಿ ಪೋರ್ಟ್ ತೆರೆಯಿರಿ"

msgid "Open a port on a Public place"
msgstr "ಸಾರ್ವಜನಿಕ ಸ್ಥಳದಲ್ಲಿ ಪೋರ್ಟ್ ತೆರೆಯಿರಿ"

msgid "Open an app"
msgstr "ಆ್ಯಪ್ ತೆರೆಯಿರಿ"

msgid "Open it"
msgstr "ಅದನ್ನು ತೆರೆಯಿರಿ"

msgid "Open the computer's BIOS settings screen"
msgstr "ಕಂಪ್ಯೂಟರ್‌ನ BIOS ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಪರದೆಯನ್ನು ತೆರೆಯಿರಿ"

msgid "Open the computer's own settings screen"
msgstr "ಕಂಪ್ಯೂಟರ್‌ನ ಸ್ವಂತ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಪರದೆಯನ್ನು ತೆರೆಯಿರಿ"

msgid "Open the file again to install it."
msgstr "ಅದನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಫೈಲ್ ಅನ್ನು ಮತ್ತೆ ತೆರೆಯಿರಿ."

msgid "Open the file, or drop it on Wheelhouse, Apps."
msgstr ""
"ಫೈಲ್ ಅನ್ನು ತೆರೆಯಿರಿ, ಅಥವಾ ಅದನ್ನು Wheelhouse, ಆ್ಯಪ್‌ಗಳು ಮೇಲೆ ಎಳೆದು ಬಿಡಿ."

msgid "Open the file, or use Install a package file in Wheelhouse, Apps."
msgstr ""
"ಫೈಲ್ ಅನ್ನು ತೆರೆಯಿರಿ, ಅಥವಾ Wheelhouse, ಆ್ಯಪ್‌ಗಳಲ್ಲಿ \"ಪ್ಯಾಕೇಜ್ ಫೈಲ್ ಅನ್ನು "
"ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ಆಯ್ಕೆಯನ್ನು ಬಳಸಿ."

msgid ""
"Open this computer, type your user name and the sharing password, and the "
"folders are there."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ತೆರೆಯಿರಿ, ನಿಮ್ಮ ಬಳಕೆದಾರ ಹೆಸರು ಮತ್ತು ಹಂಚಿಕೆ ಪಾಸ್‌ವರ್ಡ್ ಟೈಪ್ "
"ಮಾಡಿ, ಆಗ ಫೋಲ್ಡರ್‌ಗಳು ಅಲ್ಲಿರುತ್ತವೆ."

msgid "Open your folders from another computer at home"
msgstr "ಮನೆಯಲ್ಲಿರುವ ಇನ್ನೊಂದು ಕಂಪ್ಯೂಟರ್‌ನಿಂದ ನಿಮ್ಮ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ"

#, python-brace-format
msgid "Open {name}"
msgstr "{name} ತೆರೆಯಿರಿ"

msgid ""
"Opens New to EvenKeelOS at login, after the setup checklist, until its Don't "
"show this again box is ticked"
msgstr ""
"ಲಾಗಿನ್‌ನಲ್ಲಿ, ಸೆಟಪ್ ಚೆಕ್‌ಲಿಸ್ಟ್‌ನ ನಂತರ, \"EvenKeelOS ಗೆ ಹೊಸಬರೇ?\" ಅನ್ನು "
"ತೆರೆಯುತ್ತದೆ, ಅದರ \"ಇದನ್ನು ಮತ್ತೆ ತೋರಿಸಬೇಡಿ\" ಚೌಕವನ್ನು ಗುರುತಿಸುವವರೆಗೆ"

msgid "Opens a Zoom meeting in Zoom's web version, in Chrome"
msgstr "Zoom ನ ವೆಬ್ ಆವೃತ್ತಿಯಲ್ಲಿ, Chrome ನಲ್ಲಿ Zoom ಮೀಟಿಂಗ್ ಅನ್ನು ತೆರೆಯುತ್ತದೆ"

msgid "Opens the setup checklist once, the first time a user logs in"
msgstr ""
"ಬಳಕೆದಾರರು ಮೊದಲ ಬಾರಿಗೆ ಲಾಗ್ ಇನ್ ಮಾಡಿದಾಗ, ಸೆಟಪ್ ಚೆಕ್‌ಲಿಸ್ಟ್ ಅನ್ನು ಒಮ್ಮೆ "
"ತೆರೆಯುತ್ತದೆ"

msgid "Optional formats left out for legal reasons"
msgstr "ಕಾನೂನು ಕಾರಣಗಳಿಗಾಗಿ ಬಿಟ್ಟುಬಿಡಲಾದ ಐಚ್ಛಿಕ ಫಾರ್ಮ್ಯಾಟ್‌ಗಳು"

msgid "Optional: add the media codecs that are left out for legal reasons"
msgstr "ಐಚ್ಛಿಕ: ಕಾನೂನು ಕಾರಣಗಳಿಗಾಗಿ ಬಿಟ್ಟುಬಿಡಲಾದ ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳನ್ನು ಸೇರಿಸಿ"

msgid "Or Cancel."
msgstr "ಅಥವಾ ರದ್ದುಗೊಳಿಸಿ."

msgid "Or Keep it."
msgstr "ಅಥವಾ ಇದನ್ನು ಉಳಿಸಿಕೊಳ್ಳಿ."

#, python-brace-format
msgid "Or Keep it: saves setup time if you'll install another {kind} app soon."
msgstr ""
"ಅಥವಾ ಇದನ್ನು ಉಳಿಸಿಕೊಳ್ಳಿ: ನೀವು ಶೀಘ್ರದಲ್ಲೇ ಇನ್ನೊಂದು {kind} ಆ್ಯಪ್ ಅನ್ನು "
"ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಿದ್ದರೆ, ಇದು ಸೆಟಪ್ ಸಮಯವನ್ನು ಉಳಿಸುತ್ತದೆ."

msgid ""
"Or use the keyboard: Windows key + Up fills the screen, Windows key + Left or"
" Right fills a half, and Windows key + H minimizes."
msgstr ""
"ಅಥವಾ ಕೀಬೋರ್ಡ್ ಬಳಸಿ: Windows ಕೀ + ಮೇಲಿನ ಬಾಣ ಪರದೆಯನ್ನು ತುಂಬುತ್ತದೆ, Windows ಕೀ +"
" ಎಡ ಅಥವಾ ಬಲ ಬಾಣ ಅರ್ಧ ಭಾಗವನ್ನು ತುಂಬುತ್ತದೆ, ಮತ್ತು Windows ಕೀ + H ವಿಂಡೋವನ್ನು "
"ಚಿಕ್ಕದಾಗಿಸುತ್ತದೆ."

#, python-brace-format
msgid ""
"Or {button}: adds a second copy. {note} You would have two of the same app."
msgstr ""
"ಅಥವಾ {button}: ಎರಡನೇ ನಕಲನ್ನು ಸೇರಿಸುತ್ತದೆ. {note} ನಿಮಗೆ ಒಂದೇ ಆ್ಯಪ್‌ನ ಎರಡು "
"ಪ್ರತಿಗಳು ಇರುತ್ತವೆ."

#, python-brace-format
msgid "Other ({zone})"
msgstr "ಇತರ ({zone})"

#, python-brace-format
msgid ""
"Other computers ask for your user name, {user}, and this password. It isn't "
"your login password."
msgstr ""
"ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳು ನಿಮ್ಮ ಬಳಕೆದಾರ ಹೆಸರನ್ನು, {user}, ಮತ್ತು ಈ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು "
"ಕೇಳುತ್ತವೆ. ಇದು ನಿಮ್ಮ ಲಾಗಿನ್ ಪಾಸ್‌ವರ್ಡ್ ಅಲ್ಲ."

#, python-brace-format
msgid ""
"Other computers ask for your user name, {user}, and this password. Use at "
"least {n} character. Your login password doesn't change."
msgid_plural ""
"Other computers ask for your user name, {user}, and this password. Use at "
"least {n} characters. Your login password doesn't change."
msgstr[0] ""
"ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳು ನಿಮ್ಮ ಬಳಕೆದಾರ ಹೆಸರನ್ನು, {user}, ಮತ್ತು ಈ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು "
"ಕೇಳುತ್ತವೆ. ಕನಿಷ್ಠ {n} ಅಕ್ಷರವನ್ನು ಬಳಸಿ. ನಿಮ್ಮ ಲಾಗಿನ್ ಪಾಸ್‌ವರ್ಡ್ ಬದಲಾಗುವುದಿಲ್ಲ."
msgstr[1] ""
"ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳು ನಿಮ್ಮ ಬಳಕೆದಾರ ಹೆಸರನ್ನು, {user}, ಮತ್ತು ಈ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು "
"ಕೇಳುತ್ತವೆ. ಕನಿಷ್ಠ {n} ಅಕ್ಷರಗಳನ್ನು ಬಳಸಿ. ನಿಮ್ಮ ಲಾಗಿನ್ ಪಾಸ್‌ವರ್ಡ್ "
"ಬದಲಾಗುವುದಿಲ್ಲ."

#, python-brace-format
msgid ""
"Other computers find this one as {host}: in Files under Network on Linux, in "
"Finder under Network on a Mac, and under Network in File Explorer on Windows."
msgstr ""
"ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳು ಇದನ್ನು {host} ಎಂದು ಕಾಣುತ್ತವೆ: Linux ನಲ್ಲಿ ಕಡತಗಳು ಆ್ಯಪ್‌ನ "
"Network ಅಡಿಯಲ್ಲಿ, Mac ನಲ್ಲಿ Finder ನ Network ಅಡಿಯಲ್ಲಿ, ಮತ್ತು Windows ನಲ್ಲಿ "
"ಫೈಲ್ ಎಕ್ಸ್‌ಪ್ಲೋರರ್‌ನ ನೆಟ್‌ವರ್ಕ್ ಅಡಿಯಲ್ಲಿ."

msgid ""
"Other computers open these as you, so whatever they save belongs to you."
msgstr ""
"ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳು ಇವುಗಳನ್ನು ನಿಮ್ಮಂತೆ ತೆರೆಯುತ್ತವೆ, ಆದ್ದರಿಂದ ಅವು ಏನನ್ನು ಸೇವ್ "
"ಮಾಡಿದರೂ ಅದು ನಿಮಗೆ ಸೇರುತ್ತದೆ."

msgid "Other computers print to a printer plugged into this one"
msgstr ""
"ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳು ಈ ಕಂಪ್ಯೂಟರ್‌ಗೆ ಸಂಪರ್ಕಿಸಲಾದ ಪ್ರಿಂಟರ್‌ಗೆ ಪ್ರಿಂಟ್ ಮಾಡುತ್ತವೆ"

msgid "Overview"
msgstr "ಅವಲೋಕನ"

msgid "Packages (.rpm, .deb)"
msgstr "ಪ್ಯಾಕೇಜ್‌ಗಳು (.rpm, .deb)"

msgid "Password"
msgstr "ಪಾಸ್‌ವರ್ಡ್"

msgid "Paused. Turn them on or off."
msgstr "ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ. ಅವುಗಳನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡಿ."

msgid "Pausing automatic updates."
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲಾಗುತ್ತಿದೆ."

msgid ""
"Phones, file sharing and apps you run can reach this computer. System "
"services stay closed unless switched on below."
msgstr ""
"ಫೋನ್‌ಗಳು, ಫೈಲ್ ಹಂಚಿಕೆ ಮತ್ತು ನೀವು ಚಲಾಯಿಸುವ ಆ್ಯಪ್‌ಗಳು ಈ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು "
"ತಲುಪಬಹುದು. ಕೆಳಗೆ ಆನ್ ಮಾಡದ ಹೊರತು ಸಿಸ್ಟಂ ಸೇವೆಗಳು ಮುಚ್ಚಿಯೇ ಇರುತ್ತವೆ."

msgid "Pick Home, Work or Public place for it below."
msgstr "ಕೆಳಗೆ ಅದಕ್ಕಾಗಿ ಮನೆ, ಕೆಲಸದ ಸ್ಥಳ ಅಥವಾ ಸಾರ್ವಜನಿಕ ಸ್ಥಳ ಆಯ್ಕೆಮಾಡಿ."

msgid ""
"Pick Mullvad, Proton, IVPN or NordVPN. It's added from that company's own "
"download source, and kept up to date."
msgstr ""
"Mullvad, Proton, IVPN ಅಥವಾ NordVPN ಆಯ್ಕೆಮಾಡಿ. ಇದನ್ನು ಆ ಕಂಪನಿಯ ಸ್ವಂತ ಡೌನ್‌ಲೋಡ್"
" ಮೂಲದಿಂದ ಸೇರಿಸಲಾಗುತ್ತದೆ, ಮತ್ತು ಅಪ್‌ಡೇಟ್ ಆಗಿಯೇ ಇರಿಸಲಾಗುತ್ತದೆ."

msgid ""
"Pick Sunset to sunrise, or Custom times and pick when dark starts and ends."
msgstr ""
"\"ಸೂರ್ಯಾಸ್ತದಿಂದ ಸೂರ್ಯೋದಯದವರೆಗೆ\" ಆಯ್ಕೆಮಾಡಿ, ಅಥವಾ \"ಕಸ್ಟಮ್ ಸಮಯಗಳು\" ಆಯ್ಕೆಮಾಡಿ "
"ಮತ್ತು ಡಾರ್ಕ್ ಯಾವಾಗ ಆರಂಭವಾಗಿ ಯಾವಾಗ ಮುಗಿಯುತ್ತದೆ ಎಂದು ಆರಿಸಿ."

msgid ""
"Pick Windows-style (a bar at the bottom and a start menu) or Standard (a bar "
"at the top and a dock)."
msgstr ""
"Windows ಶೈಲಿ (ಕೆಳಭಾಗದಲ್ಲಿ ಪಟ್ಟಿ ಮತ್ತು ಸ್ಟಾರ್ಟ್ ಮೆನು) ಅಥವಾ ಸ್ಟ್ಯಾಂಡರ್ಡ್ "
"(ಮೇಲ್ಭಾಗದಲ್ಲಿ ಪಟ್ಟಿ ಮತ್ತು ಡಾಕ್) ಆಯ್ಕೆಮಾಡಿ."

msgid "Pick Windows-style or Standard, click Switch, then log out and back in."
msgstr ""
"Windows ಶೈಲಿ ಅಥವಾ ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಆಯ್ಕೆಮಾಡಿ, \"ಬದಲಾಯಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ, ನಂತರ ಲಾಗ್"
" ಔಟ್ ಮಾಡಿ ಮತ್ತು ಮತ್ತೆ ಲಾಗ್ ಇನ್ ಮಾಡಿ."

msgid "Pick a Windows program"
msgstr "Windows ಪ್ರೋಗ್ರಾಂ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ"

msgid "Pick a file"
msgstr "ಒಂದು ಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ"

msgid "Pick a folder inside your home folder."
msgstr "ನಿಮ್ಮ ಹೋಮ್ ಫೋಲ್ಡರ್‌ನ ಒಳಗಿನ ಒಂದು ಫೋಲ್ಡರ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ."

msgid "Pick a folder of pictures"
msgstr "ಚಿತ್ರಗಳಿರುವ ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ"

msgid "Pick a folder to share"
msgstr "ಹಂಚಿಕೊಳ್ಳಲು ಒಂದು ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ"

msgid "Pick a folder, not a file."
msgstr "ಫೈಲ್ ಅಲ್ಲ, ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ."

msgid "Pick a problem to test. Your computer should fix it by itself."
msgstr ""
"ಪರೀಕ್ಷಿಸಲು ಒಂದು ಸಮಸ್ಯೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ. ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಇದನ್ನು ತಾನಾಗಿಯೇ "
"ಸರಿಪಡಿಸಬೇಕು."

msgid "Pick a test, click Start the test, and type your password."
msgstr ""
"ಒಂದು ಪರೀಕ್ಷೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ, \"ಪರೀಕ್ಷೆಯನ್ನು ಪ್ರಾರಂಭಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು "
"ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ."

msgid "Pick an .exe or .msi to get its Linux version"
msgstr "ಅದರ Linux ಆವೃತ್ತಿಯನ್ನು ಪಡೆಯಲು .exe ಅಥವಾ .msi ಫೈಲ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ"

msgid "Pick an .rpm or .deb file from Downloads"
msgstr "ಡೌನ್‌ಲೋಡ್‌ಗಳಿಂದ .rpm ಅಥವಾ .deb ಫೈಲ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ"

msgid "Pick an app or game so other computers can reach it"
msgstr ""
"ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳು ಅದನ್ನು ಪ್ರವೇಶಿಸಬಲ್ಲಂತೆ ಒಂದು ಆ್ಯಪ್ ಅಥವಾ ಗೇಮ್ ಆಯ್ಕೆಮಾಡಿ"

msgid "Pick it again in Get a VPN."
msgstr "\"VPN ಪಡೆಯಿರಿ\" ನಲ್ಲಿ ಅದನ್ನು ಮತ್ತೆ ಆಯ್ಕೆಮಾಡಿ."

msgid "Pick one."
msgstr "ಒಂದನ್ನು ಆಯ್ಕೆಮಾಡಿ."

msgid "Pick the app for the web, mail, calendar, music, videos and photos."
msgstr ""
"ವೆಬ್, ಮೇಲ್, ಕ್ಯಾಲೆಂಡರ್, ಸಂಗೀತ, ವೀಡಿಯೊಗಳು ಮತ್ತು ಫೋಟೋಗಳಿಗಾಗಿ ಆ್ಯಪ್ ಅನ್ನು "
"ಆಯ್ಕೆಮಾಡಿ."

msgid ""
"Pick the app. To use it every time for that kind of file, turn on Always use "
"for this file type first."
msgstr ""
"ಆ್ಯಪ್ ಆಯ್ಕೆಮಾಡಿ. ಆ ರೀತಿಯ ಫೈಲ್‌ಗೆ ಪ್ರತಿ ಬಾರಿಯೂ ಅದನ್ನೇ ಬಳಸಲು, ಮೊದಲು \"Always "
"use for this file type\" ಆನ್ ಮಾಡಿ."

msgid ""
"Pick the box. It's set up again, with its apps. Your files aren't touched."
msgstr ""
"ಬಾಕ್ಸ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಅದನ್ನು ಅದರ ಆ್ಯಪ್‌ಗಳೊಂದಿಗೆ ಮತ್ತೆ ಸಿದ್ಧಪಡಿಸಲಾಗುತ್ತದೆ. "
"ನಿಮ್ಮ ಫೈಲ್‌ಗಳಿಗೆ ಏನೂ ಆಗುವುದಿಲ್ಲ."

msgid "Pick the day. Back keeps it as it is."
msgstr "ದಿನವನ್ನು ಆಯ್ಕೆಮಾಡಿ. \"ಹಿಂದೆ\" ಅದನ್ನು ಹಾಗೆಯೇ ಇರಿಸುತ್ತದೆ."

msgid ""
"Pick the folder, then how often it changes: every hour, every day or at each "
"login."
msgstr ""
"ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ, ನಂತರ ಅದು ಎಷ್ಟು ಬಾರಿ ಬದಲಾಗಬೇಕು ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ: ಪ್ರತಿ "
"ಗಂಟೆಗೆ, ಪ್ರತಿದಿನ ಅಥವಾ ಪ್ರತಿ ಲಾಗಿನ್‌ನಲ್ಲಿ."

msgid "Pick the fonts for menus, documents and code"
msgstr "ಮೆನುಗಳು, ದಾಖಲೆಗಳು ಮತ್ತು ಕೋಡ್‌ಗಾಗಿ ಫಾಂಟ್‌ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ"

msgid "Pick the hour. Back keeps it as it is."
msgstr "ಗಂಟೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ. \"ಹಿಂದೆ\" ಅದನ್ನು ಹಾಗೆಯೇ ಇರಿಸುತ್ತದೆ."

msgid "Pick the minute. Back keeps it as it is."
msgstr "ನಿಮಿಷವನ್ನು ಆಯ್ಕೆಮಾಡಿ. \"ಹಿಂದೆ\" ಅದನ್ನು ಹಾಗೆಯೇ ಇರಿಸುತ್ತದೆ."

msgid "Pick the month. Back keeps it as it is."
msgstr "ತಿಂಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ. \"ಹಿಂದೆ\" ಅದನ್ನು ಹಾಗೆಯೇ ಇರಿಸುತ್ತದೆ."

msgid "Pick the place next to a network. It changes at once."
msgstr "ನೆಟ್‌ವರ್ಕ್‌ನ ಪಕ್ಕದ ಸ್ಥಳವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಅದು ತಕ್ಷಣವೇ ಬದಲಾಗುತ್ತದೆ."

msgid ""
"Pick the speakers or headphones under Output Device, and the microphone under"
" Input Device."
msgstr ""
"ಔಟ್‌ಪುಟ್ ಸಾಧನ ಅಡಿಯಲ್ಲಿ ಸ್ಪೀಕರ್‌ಗಳನ್ನು ಅಥವಾ ಹೆಡ್‌ಫೋನ್‌ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ, ಮತ್ತು "
"ಇನ್‌ಪುಟ್ ಸಾಧನ ಅಡಿಯಲ್ಲಿ ಮೈಕ್ರೋಫೋನನ್ನು ಆಯ್ಕೆಮಾಡಿ."

msgid "Pick the year. Back keeps it as it is."
msgstr "ವರ್ಷವನ್ನು ಆಯ್ಕೆಮಾಡಿ. \"ಹಿಂದೆ\" ಅದನ್ನು ಹಾಗೆಯೇ ಇರಿಸುತ್ತದೆ."

msgid "Pick what you need. It explains each choice."
msgstr "ನಿಮಗೆ ಬೇಕಾದುದನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಇದು ಪ್ರತಿ ಆಯ್ಕೆಯನ್ನು ವಿವರಿಸುತ್ತದೆ."

msgid "Pick which ones open when you log in"
msgstr "ನೀವು ಲಾಗ್ ಇನ್ ಮಾಡಿದಾಗ ಯಾವುವು ತೆರೆಯಬೇಕು ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ"

msgid "Place"
msgstr "ಸ್ಥಳ"

msgid ""
"Plug in a USB stick, then click it to save the log on it. Click Refresh if it"
" isn't listed, or Back."
msgstr ""
"USB ಸ್ಟಿಕ್ ಅನ್ನು ಪ್ಲಗ್ ಇನ್ ಮಾಡಿ, ನಂತರ ಲಾಗ್ ಅನ್ನು ಅದರಲ್ಲಿ ಉಳಿಸಲು ಅದನ್ನು ಕ್ಲಿಕ್"
" ಮಾಡಿ. ಅದು ಪಟ್ಟಿಯಲ್ಲಿ ಇಲ್ಲದಿದ್ದರೆ \"ರಿಫ್ರೆಶ್ ಮಾಡಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ, ಅಥವಾ "
"\"ಹಿಂದೆ\"."

msgid "Plug in a second USB stick, then click Save the results again."
msgstr ""
"ಎರಡನೇ USB ಸ್ಟಿಕ್ ಅನ್ನು ಪ್ಲಗ್ ಇನ್ ಮಾಡಿ, ನಂತರ ಮತ್ತೆ \"ಫಲಿತಾಂಶಗಳನ್ನು ಉಳಿಸಿ\" "
"ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid ""
"Plug in a second USB stick, then click it to save the log on it. Or click "
"Back."
msgstr ""
"ಎರಡನೇ USB ಸ್ಟಿಕ್ ಅನ್ನು ಪ್ಲಗ್ ಇನ್ ಮಾಡಿ, ನಂತರ ಲಾಗ್ ಅನ್ನು ಅದರಲ್ಲಿ ಉಳಿಸಲು ಅದನ್ನು "
"ಕ್ಲಿಕ್ ಮಾಡಿ. ಅಥವಾ \"ಹಿಂದೆ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Plug it in. It shows in the left side of Files."
msgstr "ಅದನ್ನು ಪ್ಲಗ್ ಇನ್ ಮಾಡಿ. ಅದು ಕಡತಗಳು ವಿಂಡೋದ ಎಡಭಾಗದಲ್ಲಿ ಕಾಣಿಸುತ್ತದೆ."

msgid "Plug the computer in. Open Wheelhouse, Updates, Update firmware."
msgstr ""
"ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ವಿದ್ಯುತ್‌ಗೆ ಸಂಪರ್ಕಿಸಿ. Wheelhouse ತೆರೆಯಿರಿ, ಅಪ್‌ಡೇಟ್‌ಗಳು, "
"ಫರ್ಮ್‌ವೇರ್ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ."

msgid ""
"Point your phone's camera at the code. It opens the report on GitHub with the"
" details filled in. To send it, sign in to GitHub, or make a free account if "
"you don't have one. It carries the end of the log; the whole log can go on a "
"USB stick. Click Back when done."
msgstr ""
"ನಿಮ್ಮ ಫೋನಿನ ಕ್ಯಾಮೆರಾವನ್ನು ಕೋಡ್‌ನತ್ತ ಹಿಡಿಯಿರಿ. ಇದು ವಿವರಗಳು ತುಂಬಿದ ವರದಿಯನ್ನು "
"GitHub ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ. ಅದನ್ನು ಕಳುಹಿಸಲು, GitHub ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ, ಅಥವಾ ಖಾತೆ"
" ಇಲ್ಲದಿದ್ದರೆ ಉಚಿತ ಖಾತೆಯನ್ನು ರಚಿಸಿ. ಇದು ಲಾಗ್‌ನ ಕೊನೆಯ ಭಾಗವನ್ನು ಒಳಗೊಂಡಿರುತ್ತದೆ; "
"ಸಂಪೂರ್ಣ ಲಾಗ್ ಅನ್ನು USB ಸ್ಟಿಕ್‌ನಲ್ಲಿ ಉಳಿಸಬಹುದು. ಮುಗಿದ ನಂತರ \"ಹಿಂದೆ\" ಕ್ಲಿಕ್ "
"ಮಾಡಿ."

msgid "Port, like 8080, or a range, like 2456-2458"
msgstr "ಪೋರ್ಟ್, ಉದಾಹರಣೆಗೆ 8080, ಅಥವಾ ಶ್ರೇಣಿ, ಉದಾಹರಣೆಗೆ 2456-2458"

msgid "Power modes"
msgstr "ಪವರ್ ಮೋಡ್‌ಗಳು"

msgid "Prefer the terminal?"
msgstr "ಟರ್ಮಿನಲ್ ಬಳಸಲು ಇಷ್ಟಪಡುತ್ತೀರಾ?"

#, python-brace-format
msgid "Preparing the {label}."
msgstr "{label} ಅನ್ನು ಸಿದ್ಧಪಡಿಸಲಾಗುತ್ತಿದೆ."

msgid ""
"Press Print Screen. Pick the whole screen, a window, or drag over an area, "
"then click the round button."
msgstr ""
"Print Screen ಕೀ ಒತ್ತಿರಿ. ಸಂಪೂರ್ಣ ಪರದೆಯನ್ನು, ಒಂದು ವಿಂಡೋವನ್ನು ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ "
"ಒಂದು ಪ್ರದೇಶದ ಮೇಲೆ ಡ್ರ್ಯಾಗ್ ಮಾಡಿ, ನಂತರ ದುಂಡಗಿರುವ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Printers didn't open. Open Settings, then Printers."
msgstr "ಮುದ್ರಕಗಳು ತೆರೆಯಲಿಲ್ಲ. ಸಿದ್ಧತೆಗಳು ತೆರೆಯಿರಿ, ನಂತರ ಮುದ್ರಕಗಳು."

msgid ""
"Printers is open. Choose Add Printer.\n"
"\n"
"If your printer isn't there or doesn't print right, open this file again and choose Install the driver."
msgstr ""
"ಮುದ್ರಕಗಳು ತೆರೆದಿದೆ. \"ಮುದ್ರಕವನ್ನು ಸೇರಿಸಿ\" ಆಯ್ಕೆಮಾಡಿ.\n"
"\n"
"ನಿಮ್ಮ ಪ್ರಿಂಟರ್ ಅಲ್ಲಿ ಇಲ್ಲದಿದ್ದರೆ ಅಥವಾ ಸರಿಯಾಗಿ ಮುದ್ರಿಸದಿದ್ದರೆ, ಈ ಫೈಲ್ ಅನ್ನು ಮತ್ತೆ ತೆರೆಯಿರಿ ಮತ್ತು \"ಡ್ರೈವರ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ಆಯ್ಕೆಮಾಡಿ."

msgid ""
"Printers is open. Choose Add Printer.\n"
"\n"
"If your printer isn't there or doesn't print right, open this file again to see how to get the driver."
msgstr ""
"ಮುದ್ರಕಗಳು ತೆರೆದಿದೆ. \"ಮುದ್ರಕವನ್ನು ಸೇರಿಸಿ\" ಆಯ್ಕೆಮಾಡಿ.\n"
"\n"
"ನಿಮ್ಮ ಪ್ರಿಂಟರ್ ಅಲ್ಲಿ ಇಲ್ಲದಿದ್ದರೆ ಅಥವಾ ಸರಿಯಾಗಿ ಮುದ್ರಿಸದಿದ್ದರೆ, ಡ್ರೈವರ್ ಅನ್ನು ಹೇಗೆ ಪಡೆಯುವುದು ಎಂದು ನೋಡಲು ಈ ಫೈಲ್ ಅನ್ನು ಮತ್ತೆ ತೆರೆಯಿರಿ."

msgid "Printing"
msgstr "ಪ್ರಿಂಟಿಂಗ್"

msgid "Printing doesn't start"
msgstr "ಪ್ರಿಂಟಿಂಗ್ ಪ್ರಾರಂಭವಾಗುತ್ತಿಲ್ಲ"

msgid "Printing service off"
msgstr "ಪ್ರಿಂಟಿಂಗ್ ಸೇವೆ ಆಫ್ ಆಗಿದೆ"

msgid "Problem"
msgstr "ಸಮಸ್ಯೆ"

msgid "Protocol"
msgstr "ಪ್ರೋಟೋಕಾಲ್"

msgid "Public place"
msgstr "ಸಾರ್ವಜನಿಕ ಸ್ಥಳ"

msgid ""
"Public place: nothing on the network can reach your computer. Pick it for "
"cafes, hotels and airports."
msgstr ""
"ಸಾರ್ವಜನಿಕ ಸ್ಥಳ: ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವ ಯಾವುದೂ ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ತಲುಪಲು "
"ಸಾಧ್ಯವಿಲ್ಲ. ಇದನ್ನು ಕೆಫೆಗಳು, ಹೋಟೆಲ್‌ಗಳು ಮತ್ತು ವಿಮಾನ ನಿಲ್ದಾಣಗಳಿಗಾಗಿ ಆಯ್ಕೆಮಾಡಿ."

msgid "Put EvenKeelOS on this computer"
msgstr "EvenKeelOS ಅನ್ನು ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಇರಿಸಿ"

#, python-brace-format
msgid "Put back: {apps}."
msgstr "ಮರಳಿ ಇರಿಸಲಾಗಿದೆ: {apps}."

msgid ""
"Put the device in pairing mode. Its instructions say how, often by holding "
"its power button."
msgstr ""
"ಸಾಧನವನ್ನು ಪೇರಿಂಗ್ ಮೋಡ್‌ಗೆ ಇರಿಸಿ. ಅದರ ಸೂಚನೆಗಳು ಹೇಗೆ ಮಾಡಬೇಕೆಂದು ಹೇಳುತ್ತವೆ, "
"ಸಾಮಾನ್ಯವಾಗಿ ಅದರ ಪವರ್ ಬಟನ್ ಅನ್ನು ಒತ್ತಿಹಿಡಿದು."

msgid "Put the pictures in one folder, for example in Pictures."
msgstr ""
"ಚಿತ್ರಗಳನ್ನು ಒಂದೇ ಫೋಲ್ಡರ್‌ನಲ್ಲಿ ಇರಿಸಿ, ಉದಾಹರಣೆಗೆ ಚಿತ್ರಗಳು ಫೋಲ್ಡರ್‌ನಲ್ಲಿ."

msgid "Quick fixes"
msgstr "ತ್ವರಿತ ಪರಿಹಾರಗಳು"

msgid "Quick test"
msgstr "ತ್ವರಿತ ಪರೀಕ್ಷೆ"

#, python-brace-format
msgid "Quit {app}"
msgstr "{app} ನಿಂದ ನಿರ್ಗಮಿಸಿ"

msgid "Quitting %s"
msgstr "%s ನಿಂದ ನಿರ್ಗಮಿಸಲಾಗುತ್ತಿದೆ"

msgid "Read and write"
msgstr "ಓದಲು ಮತ್ತು ಬರೆಯಲು"

msgid "Read only"
msgstr "ಓದಲು ಮಾತ್ರ"

msgid "Reading the disk"
msgstr "ಡಿಸ್ಕ್ ಅನ್ನು ಓದಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Reading the download source {name}"
msgstr "ಡೌನ್‌ಲೋಡ್ ಮೂಲ {name} ಅನ್ನು ಓದಲಾಗುತ್ತಿದೆ"

msgid "Reading the list of apps from the new download source"
msgstr "ಹೊಸ ಡೌನ್‌ಲೋಡ್ ಮೂಲದಿಂದ ಆ್ಯಪ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು ಓದಲಾಗುತ್ತಿದೆ"

msgid "Recommended"
msgstr "ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ"

#, python-brace-format
msgid ""
"Recommended: Delete the box. It frees about {size}, and comes back by itself "
"the next time you install {apps}. Anything added to the box another way is "
"deleted too. Your files are not touched."
msgstr ""
"ಶಿಫಾರಸು: ಬಾಕ್ಸ್ ಅನ್ನು ಅಳಿಸಿ. ಇದು ಸುಮಾರು {size} ಮುಕ್ತಗೊಳಿಸುತ್ತದೆ, ಮತ್ತು ಮುಂದಿನ"
" ಬಾರಿ ನೀವು {apps} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಾಗ ತಾನಾಗಿಯೇ ಮತ್ತೆ ಬರುತ್ತದೆ. ಬಾಕ್ಸ್‌ಗೆ"
" ಬೇರೆ ರೀತಿಯಲ್ಲಿ ಸೇರಿಸಿದ ಯಾವುದೂ ಸಹ ಅಳಿಸಲ್ಪಡುತ್ತದೆ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳಿಗೆ ಏನೂ "
"ಆಗುವುದಿಲ್ಲ."

#, python-brace-format
msgid ""
"Recommended: Delete the box. It frees its disk space, and comes back by "
"itself the next time you install {apps}. Anything added to the box another "
"way is deleted too. Your files are not touched."
msgstr ""
"ಶಿಫಾರಸು: ಬಾಕ್ಸ್ ಅನ್ನು ಅಳಿಸಿ. ಇದು ಅದರ ಡಿಸ್ಕ್ ಸ್ಥಳವನ್ನು ಮುಕ್ತಗೊಳಿಸುತ್ತದೆ, ಮತ್ತು"
" ಮುಂದಿನ ಬಾರಿ ನೀವು {apps} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಾಗ ತಾನಾಗಿಯೇ ಮತ್ತೆ ಬರುತ್ತದೆ. "
"ಬಾಕ್ಸ್‌ಗೆ ಬೇರೆ ರೀತಿಯಲ್ಲಿ ಸೇರಿಸಿದ ಯಾವುದೂ ಸಹ ಅಳಿಸಲ್ಪಡುತ್ತದೆ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳಿಗೆ "
"ಏನೂ ಆಗುವುದಿಲ್ಲ."

msgid ""
"Recommended: Go back now. The computer restarts on the version that worked "
"before. Your files and apps aren't touched. If automatic updates are on, they"
" pause for 3 days, so the same update doesn't come straight back."
msgstr ""
"ಶಿಫಾರಸು: ಈಗಲೇ ಹಿಂತಿರುಗಿ. ಮೊದಲು ಕೆಲಸ ಮಾಡುತ್ತಿದ್ದ ಆವೃತ್ತಿಯಲ್ಲಿ ಕಂಪ್ಯೂಟರ್ "
"ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳಿಗೆ ಏನೂ ಆಗುವುದಿಲ್ಲ. "
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ಆನ್ ಆಗಿದ್ದರೆ, ಅವು 3 ದಿನಗಳ ಕಾಲ ವಿರಾಮಗೊಳ್ಳುತ್ತವೆ, "
"ಇದರಿಂದ ಅದೇ ಅಪ್‌ಡೇಟ್ ತಕ್ಷಣ ಮತ್ತೆ ಬರುವುದಿಲ್ಲ."

msgid ""
"Recommended: Go back now. The computer restarts with the boot options you had"
" before."
msgstr ""
"ಶಿಫಾರಸು: ಈಗಲೇ ಹಿಂತಿರುಗಿ. ನೀವು ಮೊದಲು ಹೊಂದಿದ್ದ ಬೂಟ್ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಕಂಪ್ಯೂಟರ್ "
"ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

#, python-brace-format
msgid "Recommended: Install {name}."
msgstr "ಶಿಫಾರಸು: {name} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ."

msgid "Recommended: Open it."
msgstr "ಶಿಫಾರಸು: ಅದನ್ನು ತೆರೆಯಿರಿ."

msgid ""
"Recommended: Restart now to start using it. Or Later, if you're in the middle"
" of something."
msgstr ""
"ಶಿಫಾರಸು: ಇದನ್ನು ಬಳಸಲು ಆರಂಭಿಸಲು ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ. ಅಥವಾ ನೀವು ಏನಾದರೂ ಕೆಲಸದ "
"ಮಧ್ಯದಲ್ಲಿದ್ದರೆ, ನಂತರ."

msgid ""
"Recommended: Restart now. Or Later, if you're in the middle of something."
msgstr ""
"ಶಿಫಾರಸು: ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ. ಅಥವಾ ನೀವು ಏನಾದರೂ ಕೆಲಸದ ಮಧ್ಯದಲ್ಲಿದ್ದರೆ, ನಂತರ."

msgid ""
"Recommended: Restart now. The computer restarts and tries once more. If it's "
"still broken, this window asks once more about 3 minutes after you log in, "
"and then it can go back."
msgstr ""
"ಶಿಫಾರಸು: ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ. ಕಂಪ್ಯೂಟರ್ ಮರುಪ್ರಾರಂಭವಾಗಿ ಮತ್ತೊಮ್ಮೆ "
"ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ಇನ್ನೂ ಸರಿಯಾಗದಿದ್ದರೆ, ನೀವು ಲಾಗ್ ಇನ್ ಮಾಡಿದ ಸುಮಾರು 3 ನಿಮಿಷಗಳ "
"ನಂತರ ಈ ವಿಂಡೋ ಮತ್ತೊಮ್ಮೆ ಕೇಳುತ್ತದೆ, ಮತ್ತು ಆಗ ಅದು ಹಿಂತಿರುಗಬಹುದು."

msgid ""
"Recommended: Update. Keep the computer plugged in. Some updates finish while "
"the computer restarts."
msgstr ""
"ಶಿಫಾರಸು: ಅಪ್‌ಡೇಟ್ ಮಾಡಿ. ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ವಿದ್ಯುತ್‌ಗೆ ಸಂಪರ್ಕಿಸಿಯೇ ಇರಿಸಿ. ಕೆಲವು "
"ಅಪ್‌ಡೇಟ್‌ಗಳು ಕಂಪ್ಯೂಟರ್ ಮರುಪ್ರಾರಂಭವಾಗುವಾಗ ಮುಗಿಯುತ್ತವೆ."

