#, python-brace-format
msgid ""
"{other}: no more automatic restarts, and what broke stays broken. Needs an "
"administrator to approve it."
msgstr ""
"{other}: ಇನ್ನು ಸ್ವಯಂಚಾಲಿತ ಮರುಪ್ರಾರಂಭಗಳಿಲ್ಲ, ಮತ್ತು ಕೆಟ್ಟುಹೋದದ್ದು ಕೆಟ್ಟೇ "
"ಉಳಿಯುತ್ತದೆ. ಇದನ್ನು ಅನುಮೋದಿಸಲು ನಿರ್ವಾಹಕರು ಬೇಕು."

#, python-brace-format
msgid "{package} wasn't added to the system."
msgstr "{package} ಅನ್ನು ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಲಾಗಿಲ್ಲ."

#, python-brace-format
msgid "{package}'s background service didn't turn on."
msgstr "{package} ನ ಹಿನ್ನೆಲೆ ಸೇವೆಯು ಆನ್ ಆಗಲಿಲ್ಲ."

#, python-brace-format
msgid "{password}, again"
msgstr "{password}, ಮತ್ತೆ"

