#, python-brace-format
msgid ""
"Use 1 to {max} ports from 1 to 65535, each as 8096/tcp or 2456-2458/udp."
msgstr ""
"1 ರಿಂದ 65535 ರವರೆಗಿನ 1 ರಿಂದ {max} ಪೋರ್ಟ್‌ಗಳನ್ನು ಬಳಸಿ, ಪ್ರತಿಯೊಂದೂ 8096/tcp "
"ಅಥವಾ 2456-2458/udp ರೂಪದಲ್ಲಿ."

msgid "Use Flathub"
msgstr "Flathub ಬಳಸಿ"

msgid "Use Open a port with its number."
msgstr "\"ಪೋರ್ಟ್ ತೆರೆಯಿರಿ\" ಅನ್ನು ಅದರ ಸಂಖ್ಯೆಯೊಂದಿಗೆ ಬಳಸಿ."

msgid "Use a network cable, or a USB Wi-Fi adapter that works with Linux."
msgstr ""
"ನೆಟ್‌ವರ್ಕ್ ಕೇಬಲ್ ಬಳಸಿ, ಅಥವಾ Linux ನೊಂದಿಗೆ ಕೆಲಸ ಮಾಡುವ USB Wi-Fi ಅಡಾಪ್ಟರ್ ಬಳಸಿ."

msgid "Use a network cable."
msgstr "ನೆಟ್‌ವರ್ಕ್ ಕೇಬಲ್ ಬಳಸಿ."

msgid "Use letters, digits and -, not at the start or end."
msgstr "ಅಕ್ಷರಗಳು, ಅಂಕೆಗಳು ಮತ್ತು - ಬಳಸಿ; - ಆರಂಭದಲ್ಲಿ ಅಥವಾ ಕೊನೆಯಲ್ಲಿ ಇರಬಾರದು."

msgid "Use the file"
msgstr "ಫೈಲ್ ಬಳಸಿ"

msgid "Use the newer version"
msgstr "ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಬಳಸಿ"

msgid "Use the number the app's own instructions give."
msgstr "ಆ್ಯಪ್‌ನ ಸ್ವಂತ ಸೂಚನೆಗಳಲ್ಲಿ ನೀಡಲಾದ ಸಂಖ್ಯೆಯನ್ನು ಬಳಸಿ."

msgid "Use the usual browser"
msgstr "ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ಬಳಸುವ ಬ್ರೌಸರ್ ಬಳಸಿ"

#, python-brace-format
msgid "Use {min} to 127 characters, on one line."
msgstr "{min} ರಿಂದ 127 ಅಕ್ಷರಗಳನ್ನು ಬಳಸಿ, ಒಂದೇ ಸಾಲಿನಲ್ಲಿ."

msgid "User name"
msgstr "ಬಳಕೆದಾರ ಹೆಸರು"

msgid "VPN"
msgstr "VPN"

msgid ""
"VPNs, codecs and apps added to the system, while automatic updates are on. "
"New versions start at the next restart."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ಆನ್ ಆಗಿರುವಾಗ, ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಿದ VPN ಗಳು, ಕೋಡೆಕ್‌ಗಳು "
"ಮತ್ತು ಆ್ಯಪ್‌ಗಳು. ಹೊಸ ಆವೃತ್ತಿಗಳು ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಆರಂಭವಾಗುತ್ತವೆ."

msgid ""
"Video and audio that need them stop playing. Needs your password and a "
"restart."
msgstr ""
"ಅವುಗಳ ಅಗತ್ಯವಿರುವ ವೀಡಿಯೊ ಮತ್ತು ಆಡಿಯೋ ಪ್ಲೇ ಆಗುವುದು ನಿಲ್ಲುತ್ತದೆ. ನಿಮ್ಮ "
"ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು ಒಂದು ಮರುಪ್ರಾರಂಭ ಬೇಕು."

#, python-brace-format
msgid "Waiting for the other install or removal to finish ({doing})."
msgstr ""
"ಇನ್ನೊಂದು ಇನ್‌ಸ್ಟಾಲ್ ಅಥವಾ ತೆಗೆದುಹಾಕುವಿಕೆ ಪೂರ್ಣಗೊಳ್ಳುವವರೆಗೆ ಕಾಯಲಾಗುತ್ತಿದೆ "
"({doing})."

msgid "Wallpaper slideshow"
msgstr "ವಾಲ್‌ಪೇಪರ್ ಸ್ಲೈಡ್‌ಶೋ"

msgid "Weak"
msgstr "ದುರ್ಬಲ"

msgid "Web video is already installed. Restart if you have not yet."
msgstr ""
"ವೆಬ್ ವೀಡಿಯೊ ಈಗಾಗಲೇ ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿದೆ. ನೀವು ಇನ್ನೂ ಮರುಪ್ರಾರಂಭಿಸಿಲ್ಲದಿದ್ದರೆ, "
"ಮರುಪ್ರಾರಂಭಿಸಿ."

msgid "Web video only"
msgstr "ವೆಬ್ ವೀಡಿಯೊ ಮಾತ್ರ"

msgid "Welcome to EvenKeelOS"
msgstr "EvenKeelOS ಗೆ ಸ್ವಾಗತ"

msgid ""
"Welcome. A few things to set up, one at a time.\n"
"\n"
"1. Media codecs, for web video\n"
"2. Skip the disk password at startup\n"
"3. How to get apps\n"
"\n"
"Each can be skipped.\n"
"\n"
"Recommended: Start. Or Later: this opens again at the next login. Or Don't show again: it's in Wheelhouse any time."
msgstr ""
"ಸ್ವಾಗತ. ಒಂದೊಂದಾಗಿ ಹೊಂದಿಸಬೇಕಾದ ಕೆಲವು ವಿಷಯಗಳು.\n"
"\n"
"1. ವೆಬ್ ವೀಡಿಯೊಗಾಗಿ ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳು\n"
"2. ಪ್ರಾರಂಭಿಸುವಾಗ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಬಿಟ್ಟುಬಿಡಿ\n"
"3. ಆ್ಯಪ್‌ಗಳನ್ನು ಪಡೆಯುವುದು ಹೇಗೆ\n"
"\n"
"ಪ್ರತಿಯೊಂದನ್ನೂ ಬಿಟ್ಟುಬಿಡಬಹುದು.\n"
"\n"
"ಶಿಫಾರಸು: ಪ್ರಾರಂಭಿಸಿ. ಅಥವಾ ನಂತರ: ಮುಂದಿನ ಲಾಗಿನ್‌ನಲ್ಲಿ ಇದು ಮತ್ತೆ ತೆರೆಯುತ್ತದೆ. ಅಥವಾ ಮತ್ತೆ ತೋರಿಸಬೇಡಿ: ಇದು ಯಾವಾಗ ಬೇಕಾದರೂ Wheelhouse ನಲ್ಲಿ ಇರುತ್ತದೆ."

msgid "What happens"
msgstr "ಏನು ಸಂಭವಿಸುತ್ತದೆ"

msgid "What is new:"
msgstr "ಹೊಸದೇನಿದೆ:"

msgid "What it does"
msgstr "ಇದು ಏನು ಮಾಡುತ್ತದೆ"

msgid "What stopped working with them:"
msgstr "ಅವುಗಳೊಂದಿಗೆ ಯಾವುದು ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿತು:"

msgid "What the test copy found broken:"
msgstr "ಪರೀಕ್ಷಾ ನಕಲಿನಲ್ಲಿ ಯಾವುದು ಕೆಟ್ಟುಹೋಗಿದೆ ಎಂದು ಕಂಡುಬಂದಿದೆ:"

msgid "What's different"
msgstr "ಏನು ಭಿನ್ನವಾಗಿದೆ"

msgid "Wheelhouse"
msgstr "Wheelhouse"

msgid "When neither of the two above is enough"
msgstr "ಮೇಲಿನ ಎರಡೂ ಸಾಕಾಗದಿದ್ದಾಗ"

#, python-brace-format
msgid "Where is {name}?"
msgstr "{name} ಎಲ್ಲಿದೆ?"

#, python-brace-format
msgid ""
"Where is {network}? This sets what other devices on it can reach once "
"EvenKeelOS is installed. Pick Public place anywhere you're not sure."
msgstr ""
"{network} ಎಲ್ಲಿದೆ? EvenKeelOS ಇನ್‌ಸ್ಟಾಲ್ ಆದ ನಂತರ ಅದರಲ್ಲಿರುವ ಇತರ ಸಾಧನಗಳು "
"ಏನನ್ನು ತಲುಪಬಹುದು ಎಂಬುದನ್ನು ಇದು ನಿರ್ಧರಿಸುತ್ತದೆ. ಖಚಿತವಿಲ್ಲದ ಯಾವುದೇ ಸ್ಥಳದಲ್ಲಿ "
"ಸಾರ್ವಜನಿಕ ಸ್ಥಳ ಆಯ್ಕೆಮಾಡಿ."

msgid "Where it's from"
msgstr "ಇದು ಎಲ್ಲಿಂದ ಬಂದಿದೆ"

msgid "Where things are"
msgstr "ವಿಷಯಗಳು ಎಲ್ಲಿವೆ"

msgid ""
"Which VPN do you want? Each one comes from its company's own download source "
"and keeps updating. To connect, you need an account with that company."
msgstr ""
"ನಿಮಗೆ ಯಾವ VPN ಬೇಕು? ಪ್ರತಿಯೊಂದೂ ತನ್ನ ಕಂಪನಿಯ ಸ್ವಂತ ಡೌನ್‌ಲೋಡ್ ಮೂಲದಿಂದ ಬರುತ್ತದೆ "
"ಮತ್ತು ನಿರಂತರವಾಗಿ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತಿರುತ್ತದೆ. ಸಂಪರ್ಕಿಸಲು, ನಿಮಗೆ ಆ ಕಂಪನಿಯೊಂದಿಗಿನ "
"ಖಾತೆ ಬೇಕು."

msgid "Which app do you want to remove?"
msgstr "ನೀವು ಯಾವ ಆ್ಯಪ್ ಅನ್ನು ತೆಗೆದುಹಾಕಲು ಬಯಸುತ್ತೀರಿ?"

msgid "Which app do you want? Start typing its name."
msgstr "ನಿಮಗೆ ಯಾವ ಆ್ಯಪ್ ಬೇಕು? ಅದರ ಹೆಸರನ್ನು ಟೈಪ್ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಿ."

msgid "Which app should start, or stop starting, when you log in?"
msgstr ""
"ನೀವು ಲಾಗ್ ಇನ್ ಮಾಡಿದಾಗ ಯಾವ ಆ್ಯಪ್ ಪ್ರಾರಂಭವಾಗಬೇಕು ಅಥವಾ ಪ್ರಾರಂಭವಾಗುವುದನ್ನು "
"ನಿಲ್ಲಿಸಬೇಕು?"

msgid "Which box do you want to repair?"
msgstr "ನೀವು ಯಾವ ಬಾಕ್ಸ್ ಅನ್ನು ದುರಸ್ತಿ ಮಾಡಲು ಬಯಸುತ್ತೀರಿ?"

#, python-brace-format
msgid "Which city in {region} has your time? Back goes to the regions."
msgstr ""
"{region} ನಲ್ಲಿ ಯಾವ ನಗರ ನಿಮ್ಮ ಸಮಯವನ್ನು ಹೊಂದಿದೆ? \"ಹಿಂದೆ\" ಪ್ರದೇಶಗಳಿಗೆ "
"ಹಿಂತಿರುಗಿಸುತ್ತದೆ."

msgid ""
"Which disk should EvenKeelOS go on? Everything on it will be erased. The USB "
"stick this runs from is not listed."
msgstr ""
"EvenKeelOS ಯಾವ ಡಿಸ್ಕ್‌ನಲ್ಲಿ ಇರಬೇಕು? ಅದರಲ್ಲಿರುವ ಎಲ್ಲವನ್ನೂ ಅಳಿಸಲಾಗುತ್ತದೆ. ಇದು "
"ಚಾಲನೆಯಾಗುತ್ತಿರುವ USB ಸ್ಟಿಕ್ ಪಟ್ಟಿಯಲ್ಲಿ ಇಲ್ಲ."

msgid "Which file do you want to install?"
msgstr "ನೀವು ಯಾವ ಫೈಲ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಬಯಸುತ್ತೀರಿ?"

msgid ""
"Which keyboard layouts do you use? Click one to add it, or click it again to "
"take it off. The first one is used unless you switch."
msgstr ""
"ನೀವು ಯಾವ ಕೀಬೋರ್ಡ್ ಲೇಔಟ್‌ಗಳನ್ನು ಬಳಸುತ್ತೀರಿ? ಅದನ್ನು ಸೇರಿಸಲು ಒಂದನ್ನು ಕ್ಲಿಕ್ "
"ಮಾಡಿ, ಅಥವಾ ಅದನ್ನು ತೆಗೆದುಹಾಕಲು ಮತ್ತೆ ಕ್ಲಿಕ್ ಮಾಡಿ. ನೀವು ಬದಲಾಯಿಸದ ಹೊರತು "
"ಮೊದಲನೆಯದನ್ನು ಬಳಸಲಾಗುತ್ತದೆ."

msgid "Which language should EvenKeelOS use?"
msgstr "EvenKeelOS ಯಾವ ಭಾಷೆಯನ್ನು ಬಳಸಬೇಕು?"

msgid "Which one? Back goes to the list of languages."
msgstr "ಯಾವುದು? \"ಹಿಂದೆ\" ಭಾಷೆಗಳ ಪಟ್ಟಿಗೆ ಹಿಂತಿರುಗಿಸುತ್ತದೆ."

msgid "Which tool do you want?"
msgstr "ನಿಮಗೆ ಯಾವ ಪರಿಕರ ಬೇಕು?"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Wi-Fi driver blocked"
msgstr "Wi-Fi ಡ್ರೈವರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ"

msgid "Wi-Fi found."
msgstr "Wi-Fi ಕಂಡುಬಂದಿದೆ."

msgid "Wi-Fi password"
msgstr "Wi-Fi ಪಾಸ್‌ವರ್ಡ್"

msgid "Wi-Fi, how safe each network is, and Bluetooth"
msgstr "Wi-Fi, ಪ್ರತಿ ನೆಟ್‌ವರ್ಕ್ ಎಷ್ಟು ಸುರಕ್ಷಿತ, ಮತ್ತು ಬ್ಲೂಟೂತ್"

msgid "Wi-Fi, sound, brightness and power"
msgstr "Wi-Fi, ಧ್ವನಿ, ಪ್ರಕಾಶ ಮತ್ತು ವಿದ್ಯುತ್"

msgid "Will this computer work?"
msgstr "ಈ ಕಂಪ್ಯೂಟರ್ ಕೆಲಸ ಮಾಡುತ್ತದೆಯೇ?"

msgid "Windows Program"
msgstr "Windows ಪ್ರೋಗ್ರಾಂ"

msgid "Windows Program is open"
msgstr "Windows ಪ್ರೋಗ್ರಾಂ ತೆರೆದಿದೆ"

msgid "Windows key + L locks the screen."
msgstr "Windows ಕೀ + L ಪರದೆಯನ್ನು ಲಾಕ್ ಮಾಡುತ್ತದೆ."

msgid "Windows programs"
msgstr "Windows ಪ್ರೋಗ್ರಾಂಗಳು"

msgid ""
"Windows programs (.exe and .msi) don't run here. Open one anyway: Wheelhouse "
"tells you the version for EvenKeelOS, or a replacement when there is one, and"
" installs it."
msgstr ""
"Windows ಪ್ರೋಗ್ರಾಂಗಳು (.exe ಮತ್ತು .msi) ಇಲ್ಲಿ ಚಲಿಸುವುದಿಲ್ಲ. ಆದರೂ ಒಂದನ್ನು "
"ತೆರೆಯಿರಿ: Wheelhouse ನಿಮಗೆ EvenKeelOS ಗಾಗಿರುವ ಆವೃತ್ತಿಯನ್ನು, ಅಥವಾ ಇದ್ದರೆ "
"ಬದಲಿಯನ್ನು ತಿಳಿಸಿ, ಅದನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುತ್ತದೆ."

msgid "Windows programs (.exe, .msi)"
msgstr "Windows ಪ್ರೋಗ್ರಾಂಗಳು (.exe, .msi)"

msgid "Windows-style"
msgstr "Windows ಶೈಲಿ"

msgid "Windows-style bottom bar or the standard top bar"
msgstr "Windows ಶೈಲಿಯ ಕೆಳಗಿನ ಪಟ್ಟಿ ಅಥವಾ ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಮೇಲಿನ ಪಟ್ಟಿ"

msgid "Wired"
msgstr "ವೈರ್ಡ್"

msgid "Wired network"
msgstr "ವೈರ್ಡ್ ನೆಟ್‌ವರ್ಕ್"

msgid "Wired network: connected."
msgstr "ವೈರ್ಡ್ ನೆಟ್‌ವರ್ಕ್: ಸಂಪರ್ಕಗೊಂಡಿದೆ."

msgid "Wired network: not connected."
msgstr "ವೈರ್ಡ್ ನೆಟ್‌ವರ್ಕ್: ಸಂಪರ್ಕಗೊಂಡಿಲ್ಲ."

msgid ""
"With the Windows-style layout: click the sailboat button at the bottom left, "
"then Wheelhouse."
msgstr ""
"Windows ಶೈಲಿಯ ಲೇಔಟ್‌ನಲ್ಲಿ: ಕೆಳಗಿನ ಎಡ ಮೂಲೆಯಲ್ಲಿರುವ ಹಾಯಿದೋಣಿ ಬಟನ್ ಕ್ಲಿಕ್ ಮಾಡಿ, "
"ನಂತರ Wheelhouse."

msgid ""
"With the Windows-style layout: click the sailboat button at the bottom left, "
"then click the app, or start typing its name and press Enter."
msgstr ""
"Windows ಶೈಲಿಯ ಲೇಔಟ್‌ನಲ್ಲಿ: ಕೆಳಗಿನ ಎಡ ಮೂಲೆಯಲ್ಲಿರುವ ಹಾಯಿದೋಣಿ ಬಟನ್ ಕ್ಲಿಕ್ ಮಾಡಿ, "
"ನಂತರ ಆ್ಯಪ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ, ಅಥವಾ ಅದರ ಹೆಸರನ್ನು ಟೈಪ್ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಿ Enter "
"ಒತ್ತಿರಿ."

msgid ""
"With the standard layout: click the logo at the top left, then Wheelhouse."
msgstr ""
"ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಲೇಔಟ್‌ನಲ್ಲಿ: ಮೇಲಿನ ಎಡ ಮೂಲೆಯಲ್ಲಿರುವ ಲೋಗೋವನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ, ನಂತರ "
"Wheelhouse."

msgid ""
"With the standard layout: press the Windows key, start typing the app's name,"
" and press Enter. Or press Windows key + A to see every app."
msgstr ""
"ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಲೇಔಟ್‌ನಲ್ಲಿ: Windows ಕೀಲಿಯನ್ನು ಒತ್ತಿ, ಆ್ಯಪ್‌ನ ಹೆಸರನ್ನು ಟೈಪ್ "
"ಮಾಡಲು ಪ್ರಾರಂಭಿಸಿ, ನಂತರ Enter ಒತ್ತಿ. ಅಥವಾ ಎಲ್ಲಾ ಆ್ಯಪ್‌ಗಳನ್ನು ನೋಡಲು Windows ಕೀ "
"+ A ಒತ್ತಿರಿ."

msgid ""
"Word, Excel and PowerPoint: LibreOffice Writer, Calc and Impress. They open "
"and save Office files."
msgstr ""
"Word, Excel ಮತ್ತು PowerPoint: LibreOffice Writer, Calc ಮತ್ತು Impress. ಅವು "
"Office ಫೈಲ್‌ಗಳನ್ನು ತೆರೆಯುತ್ತವೆ ಮತ್ತು ಸೇವ್ ಮಾಡುತ್ತವೆ."

msgid "Work"
msgstr "ಕೆಲಸದ ಸ್ಥಳ"

msgid ""
"Work: like a Public place, nothing gets in and your folders aren't shared. "
"The office's own shared drives still open."
msgstr ""
"ಕೆಲಸದ ಸ್ಥಳ: ಸಾರ್ವಜನಿಕ ಸ್ಥಳದಂತೆಯೇ, ಏನೂ ಒಳಗೆ ಬರುವುದಿಲ್ಲ ಮತ್ತು ನಿಮ್ಮ "
"ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಲಾಗುವುದಿಲ್ಲ. ಕಚೇರಿಯ ಸ್ವಂತ ಹಂಚಿದ ಡ್ರೈವ್‌ಗಳು ಈಗಲೂ "
"ತೆರೆಯುತ್ತವೆ."

msgid "Working…"
msgstr "ಕೆಲಸ ಮಾಡುತ್ತಿದೆ…"

msgid "Year"
msgstr "ವರ್ಷ"

msgid "Yes"
msgstr "ಹೌದು"

msgid ""
"You can still switch it yourself. It stays that way until the next change."
msgstr ""
"ನೀವು ಇದನ್ನು ಇನ್ನೂ ನೀವೇ ಬದಲಾಯಿಸಬಹುದು. ಮುಂದಿನ ಬದಲಾವಣೆಯಾಗುವವರೆಗೆ ಅದು ಹಾಗೆಯೇ "
"ಇರುತ್ತದೆ."

msgid ""
"You don't need to do anything. If a new version fails to start twice in a "
"row, the computer goes back to the version before by itself."
msgstr ""
"ನೀವು ಏನನ್ನೂ ಮಾಡುವ ಅಗತ್ಯವಿಲ್ಲ. ಹೊಸ ಆವೃತ್ತಿಯು ಸತತವಾಗಿ ಎರಡು ಬಾರಿ "
"ಪ್ರಾರಂಭವಾಗದಿದ್ದಲ್ಲಿ, ಕಂಪ್ಯೂಟರ್ ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಹಿಂದಿನ ಆವೃತ್ತಿಗೆ "
"ಹಿಂತಿರುಗುತ್ತದೆ."

#, python-brace-format
msgid ""
"You're using an earlier version, from {current}, after an undo. The newer one, from {newer}, is still on this computer.\n"
"\n"
"If the problem is fixed or you want it back: Use the newer version. It starts at your next restart.\n"
"\n"
"Or Cancel: the newer version comes back with the next update after the pause."
msgstr ""
"ರದ್ದುಗೊಳಿಸಿದ ನಂತರ ನೀವು ಹಿಂದಿನ ಆವೃತ್ತಿಯನ್ನು ({current}) ಬಳಸುತ್ತಿದ್ದೀರಿ. ಹೊಸ ಆವೃತ್ತಿ ({newer}) ಇನ್ನೂ ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿದೆ.\n"
"\n"
"ಸಮಸ್ಯೆ ಬಗೆಹರಿದಿದ್ದರೆ ಅಥವಾ ನಿಮಗೆ ಅದು ಮತ್ತೆ ಬೇಕಿದ್ದರೆ: ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಬಳಸಿ. ಅದು ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ.\n"
"\n"
"ಅಥವಾ ರದ್ದುಗೊಳಿಸಿ: ವಿರಾಮದ ನಂತರದ ಮುಂದಿನ ಅಪ್‌ಡೇಟ್‌ನೊಂದಿಗೆ ಹೊಸ ಆವೃತ್ತಿ ಮತ್ತೆ ಬರುತ್ತದೆ."

#, python-brace-format
msgid ""
"You're using the version from {current}, picked when the computer started. At your next restart the newer version, from {newer}, starts again.\n"
"\n"
"To stay on this one, pick it again when the computer starts, and tell your helper."
msgstr ""
