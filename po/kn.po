msgstr ""
"\"EvenKeelOS ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ಇದನ್ನು ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಇರಿಸುತ್ತದೆ. "
"ಅಥವಾ \"ಮೊದಲು ಇದನ್ನು ಪ್ರಯತ್ನಿಸಿ\": \"EvenKeelOS ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" "
"ಡಾಕ್‌ನಲ್ಲಿಯೂ ಇದೆ."

msgid "Install EvenKeelOS, or try it first"
msgstr "EvenKeelOS ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ, ಅಥವಾ ಮೊದಲು ಅದನ್ನು ಪ್ರಯತ್ನಿಸಿ"

msgid "Install Media Codecs"
msgstr "ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install Package File"
msgstr "ಪ್ಯಾಕೇಜ್ ಫೈಲ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install Package File is open"
msgstr "ಪ್ಯಾಕೇಜ್ ಫೈಲ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ ಎಂಬ ವಿಂಡೋ ತೆರೆದಿದೆ"

msgid "Install Package File is open. Cancel it when you're done looking."
msgstr ""
"ಪ್ಯಾಕೇಜ್ ಫೈಲ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ ಎಂಬ ವಿಂಡೋ ತೆರೆದಿದೆ. ನೀವು ನೋಡುವುದು ಮುಗಿದ "
"ನಂತರ ಅದನ್ನು ರದ್ದುಗೊಳಿಸಿ."

msgid "Install Package File: after restart"
msgstr "ಪ್ಯಾಕೇಜ್ ಫೈಲ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ: ಮರುಪ್ರಾರಂಭಿಸಿದ ನಂತರ"

msgid "Install a package file"
msgstr "ಪ್ಯಾಕೇಜ್ ಫೈಲ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install an app from an .rpm or .deb file"
msgstr ".rpm ಅಥವಾ .deb ಫೈಲ್‌ನಿಂದ ಆ್ಯಪ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install from Fedora"
msgstr "Fedora ದಿಂದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install it here too"
msgstr "ಇದನ್ನು ಇಲ್ಲಿಯೂ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install the driver"
msgstr "ಡ್ರೈವರ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install the file too"
msgstr "ಈ ಫೈಲ್ ಅನ್ನು ಕೂಡ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Install the older version"
msgstr "ಹಳೆಯ ಆವೃತ್ತಿಯನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

#, python-brace-format
msgid "Install {name}"
msgstr "{name} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

#, python-brace-format
msgid "Install {title}"
msgstr "{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

#, python-brace-format
msgid ""
"Install {title}\n"
"\n"
"In a box, these parts of {title} won't work:\n"
"{notes}\n"
"A .deb file can't go on the system. For everything to work, look for {title} as an .rpm file or in Bazaar, the app store.\n"
"\n"
"{setup}: puts it in a box anyway, without those parts."
msgstr ""
"{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\n"
"\n"
"ಬಾಕ್ಸ್‌ನಲ್ಲಿ, {title} ನ ಈ ಭಾಗಗಳು ಕೆಲಸ ಮಾಡುವುದಿಲ್ಲ:\n"
"{notes}\n"
".deb ಫೈಲ್ ಸಿಸ್ಟಂಗೆ ಸೇರಲು ಸಾಧ್ಯವಿಲ್ಲ. ಎಲ್ಲವೂ ಕೆಲಸ ಮಾಡಬೇಕಾದರೆ, {title} ಅನ್ನು .rpm ಫೈಲ್ ಆಗಿ ಅಥವಾ ಆ್ಯಪ್ ಸ್ಟೋರ್ ಆದ Bazaar ನಲ್ಲಿ ಹುಡುಕಿ.\n"
"\n"
"{setup}: ಆ ಭಾಗಗಳಿಲ್ಲದೆ, ಆದರೂ ಅದನ್ನು ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಇರಿಸುತ್ತದೆ."

#, python-brace-format
msgid ""
"Install {title}\n"
"\n"
"It comes from {maker}'s own download source, which is added to the system so {title} keeps updating. Needs your password and a restart.\n"
"\n"
"To connect, you need a {maker} account."
msgstr ""
"{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\n"
"\n"
"ಇದು {maker} ನ ಸ್ವಂತ ಡೌನ್‌ಲೋಡ್ ಮೂಲದಿಂದ ಬರುತ್ತದೆ; {title} ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತಲೇ ಇರಲು ಆ ಮೂಲವನ್ನು ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು ಒಂದು ಮರುಪ್ರಾರಂಭ ಬೇಕು.\n"
"\n"
"ಸಂಪರ್ಕಿಸಲು, ನಿಮಗೆ {maker} ಖಾತೆ ಬೇಕು."

#, python-brace-format
msgid ""
"Install {title}\n"
"\n"
"Recommended: Add to the system. In a box, these parts of {title} won't work:\n"
"{notes}\n"
"On the system, everything works. Needs your password and a restart.\n"
"\n"
"Or {setup}: puts it in a separate box. It's easier to remove, but those parts won't work."
msgstr ""
"{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\n"
"\n"
"ಶಿಫಾರಸು: ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಿ. ಬಾಕ್ಸ್‌ನಲ್ಲಿ, {title} ನ ಈ ಭಾಗಗಳು ಕೆಲಸ ಮಾಡುವುದಿಲ್ಲ:\n"
"{notes}\n"
"ಸಿಸ್ಟಂನಲ್ಲಿ ಎಲ್ಲವೂ ಕೆಲಸ ಮಾಡುತ್ತದೆ. ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು ಒಂದು ಮರುಪ್ರಾರಂಭ ಬೇಕು.\n"
"\n"
"ಅಥವಾ {setup}: ಅದನ್ನು ಪ್ರತ್ಯೇಕ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಇರಿಸುತ್ತದೆ. ಅದನ್ನು ತೆಗೆದುಹಾಕುವುದು ಸುಲಭ, ಆದರೆ ಆ ಭಾಗಗಳು ಕೆಲಸ ಮಾಡುವುದಿಲ್ಲ."

#, python-brace-format
msgid ""
"Install {title}\n"
"\n"
"{setup}: puts it in a separate box. Your system isn't changed, and Remove Apps takes it out cleanly."
msgstr ""
"{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\n"
"\n"
"{setup}: ಅದನ್ನು ಪ್ರತ್ಯೇಕ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಇರಿಸುತ್ತದೆ. ನಿಮ್ಮ ಸಿಸ್ಟಂ ಬದಲಾಗುವುದಿಲ್ಲ, ಮತ್ತು \"ಆ್ಯಪ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿ\" ಅದನ್ನು ಸ್ವಚ್ಛವಾಗಿ ತೆಗೆದುಹಾಕುತ್ತದೆ."

msgid "Installed"
msgstr "ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ"

msgid "Installed in"
msgstr "ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿರುವ ಸ್ಥಳ"

msgid "Installing EvenKeelOS"
msgstr "EvenKeelOS ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

msgid "Installing the codecs. This can take a few minutes."
msgstr ""
"ಕೋಡೆಕ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ. ಇದಕ್ಕೆ ಕೆಲವು ನಿಮಿಷಗಳು ಬೇಕಾಗಬಹುದು."

#, python-brace-format
msgid "Installing the older version of {title}"
msgstr "{title} ನ ಹಳೆಯ ಆವೃತ್ತಿಯನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Installing the older version of {title} in the {label}."
msgstr "{label} ನಲ್ಲಿ {title} ನ ಹಳೆಯ ಆವೃತ್ತಿಯನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

#, python-brace-format
msgid "Installing {name}"
msgstr "{name} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Installing {name} from Flathub."
msgstr "Flathub ನಿಂದ {name} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

#, python-brace-format
msgid "Installing {title}"
msgstr "{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Installing {title} in the {label}."
msgstr "{label} ನಲ್ಲಿ {title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

#, python-brace-format
msgid "Installing {title}."
msgstr "{title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

msgid "Intel (newest chips): flicker or black flashes"
msgstr "Intel (ಹೊಸ ಚಿಪ್‌ಗಳು): ಮಿನುಗುವಿಕೆ ಅಥವಾ ಕಪ್ಪು ಹೊಳಪುಗಳು"

msgid "Intel (older chips): flicker or freezes"
msgstr "Intel (ಹಳೆಯ ಚಿಪ್‌ಗಳು): ಮಿನುಗುವಿಕೆ ಅಥವಾ ಫ್ರೀಜ್ ಆಗುವುದು"

msgid "Internet and networks"
msgstr "ಇಂಟರ್ನೆಟ್ ಮತ್ತು ನೆಟ್‌ವರ್ಕ್‌ಗಳು"

msgid "It adds its maker's download source, so it updates with System Update."
msgstr ""
"ಇದು ತನ್ನ ತಯಾರಕರ ಡೌನ್‌ಲೋಡ್ ಮೂಲವನ್ನು ಸೇರಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಇದು ಸಿಸ್ಟಂ "
"ಅಪ್‌ಡೇಟ್‌ನೊಂದಿಗೆ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ."

msgid ""
"It also has a device rule. That goes on the system, so you will be asked for "
"your password."
msgstr ""
"ಅದರಲ್ಲಿ ಸಾಧನ ನಿಯಮವೂ ಇದೆ. ಅದು ಸಿಸ್ಟಂಗೆ ಸೇರುತ್ತದೆ, ಆದ್ದರಿಂದ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ "
"ಅನ್ನು ಕೇಳಲಾಗುತ್ತದೆ."

msgid "It comes back on by itself on a Home network."
msgstr "ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿ ಇದು ತಾನಾಗಿಯೇ ಮತ್ತೆ ಆನ್ ಆಗುತ್ತದೆ."

msgid "It could not reach the internet. Check the connection, then try again."
msgstr ""
"ಅದಕ್ಕೆ ಇಂಟರ್ನೆಟ್ ಅನ್ನು ತಲುಪಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ, ನಂತರ ಪುನಃ"
" ಪ್ರಯತ್ನಿಸಿ."

msgid "It didn't work, and nothing was changed."
msgstr "ಅದು ಕೆಲಸ ಮಾಡಲಿಲ್ಲ, ಮತ್ತು ಏನೂ ಬದಲಾಗಿಲ್ಲ."

#, python-brace-format
msgid ""
"It didn't work, and nothing was changed.\n"
"\n"
"The details are in {log}"
msgstr ""
"ಅದು ಕೆಲಸ ಮಾಡಲಿಲ್ಲ, ಮತ್ತು ಏನೂ ಬದಲಾಗಿಲ್ಲ.\n"
"\n"
"ವಿವರಗಳು ಇಲ್ಲಿವೆ: {log}"

#, python-brace-format
msgid ""
"It didn't work, and nothing was changed. Try again later.\n"
"\n"
"The details are in {log}"
msgstr ""
"ಅದು ಕೆಲಸ ಮಾಡಲಿಲ್ಲ, ಮತ್ತು ಏನೂ ಬದಲಾಗಿಲ್ಲ. ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.\n"
"\n"
"ವಿವರಗಳು ಇಲ್ಲಿವೆ: {log}"

#, python-brace-format
msgid ""
"It didn't work.\n"
"\n"
"The details are in {log}"
msgstr ""
"ಅದು ಕೆಲಸ ಮಾಡಲಿಲ್ಲ.\n"
"\n"
"ವಿವರಗಳು ಇಲ್ಲಿವೆ: {log}"

msgid ""
"It gives anyone at the keyboard a shell with full control, with no password."
msgstr ""
"ಇದು ಕೀಬೋರ್ಡ್ ಬಳಿಯಿರುವ ಯಾರಿಗಾದರೂ ಪಾಸ್‌ವರ್ಡ್ ಇಲ್ಲದೆ ಸಂಪೂರ್ಣ ನಿಯಂತ್ರಣದೊಂದಿಗೆ "
"ಶೆಲ್ ಅನ್ನು ನೀಡುತ್ತದೆ."

#, python-brace-format
msgid "It goes in the {label} and updates with System Update."
msgstr ""
"ಇದು {label} ಗೆ ಹೋಗುತ್ತದೆ ಮತ್ತು ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್‌ನೊಂದಿಗೆ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ."

msgid "It has no app of its own; other apps in the box use it."
msgstr ""
"ಇದಕ್ಕೆ ತನ್ನದೇ ಆದ ಆ್ಯಪ್ ಇಲ್ಲ; ಬಾಕ್ಸ್‌ನಲ್ಲಿರುವ ಇತರ ಆ್ಯಪ್‌ಗಳು ಇದನ್ನು ಬಳಸುತ್ತವೆ."

msgid "It has no window of its own in Show Apps."
msgstr "Show Apps ನಲ್ಲಿ ಇದಕ್ಕೆ ತನ್ನದೇ ಆದ ವಿಂಡೋ ಇಲ್ಲ."

msgid "It is a command-line tool, so it has no window in Show Apps."
msgstr ""
"ಇದು ಕಮಾಂಡ್-ಲೈನ್ ಪರಿಕರ, ಆದ್ದರಿಂದ ಇದಕ್ಕೆ Show Apps ನಲ್ಲಿ ಯಾವುದೇ ವಿಂಡೋ "
"ಇರುವುದಿಲ್ಲ."

msgid "It is made for a different kind of processor than this computer has."
msgstr ""
"ಇದು ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿರುವ ಪ್ರೊಸೆಸರ್‌ಗಿಂತ ಬೇರೆ ರೀತಿಯ ಪ್ರೊಸೆಸರ್‌ಗಾಗಿ "
"ತಯಾರಿಸಲಾಗಿದೆ."

msgid ""
"It may not work yet. When it does, it works in Firefox and the Camera app, "
"not every app."
msgstr ""
"ಇದು ಇನ್ನೂ ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು. ಅದು ಕೆಲಸ ಮಾಡಿದಾಗ, ಅದು Firefox ಮತ್ತು "
"ಕ್ಯಾಮೆರಾ ಆ್ಯಪ್‌ನಲ್ಲಿ ಕೆಲಸ ಮಾಡುತ್ತದೆ, ಆದರೆ ಎಲ್ಲ ಆ್ಯಪ್‌ಗಳಲ್ಲೂ ಅಲ್ಲ."

msgid ""
"It needs parts that the Ubuntu box (Ubuntu 24.04) does not have. It may be "
"made for a newer or older Ubuntu."
msgstr ""
"ಇದಕ್ಕೆ Ubuntu ಬಾಕ್ಸ್‌ನಲ್ಲಿ (Ubuntu 24.04) ಇಲ್ಲದ ಕೆಲವು ಭಾಗಗಳ ಅಗತ್ಯವಿದೆ. ಇದು "
"ಹೊಸ ಅಥವಾ ಹಳೆಯ Ubuntu ಆವೃತ್ತಿಗಾಗಿ ಮಾಡಲ್ಪಟ್ಟಿರಬಹುದು."

#, python-brace-format
msgid ""
"It needs {name}, which Fedora {version} does not have. It may be made for a "
"different Fedora version."
msgstr ""
"ಇದಕ್ಕೆ {name} ಬೇಕು, ಆದರೆ Fedora {version} ನಲ್ಲಿ ಅದು ಇಲ್ಲ. ಇದು ಬೇರೆ Fedora "
"ಆವೃತ್ತಿಗಾಗಿ ಮಾಡಲ್ಪಟ್ಟಿರಬಹುದು."

#, python-brace-format
msgid ""
"It needs {name}, which the Ubuntu box (Ubuntu 24.04) does not have. It may be"
" made for a newer or older Ubuntu."
msgstr ""
"ಇದಕ್ಕೆ {name} ಬೇಕು, ಆದರೆ Ubuntu ಬಾಕ್ಸ್‌ನಲ್ಲಿ (Ubuntu 24.04) ಅದು ಇಲ್ಲ. ಇದನ್ನು "
"ಹೊಸ ಅಥವಾ ಹಳೆಯ Ubuntu ಆವೃತ್ತಿಗಾಗಿ ಮಾಡಿರಬಹುದು."

msgid "It never updates."
msgstr "ಇದು ಎಂದಿಗೂ ಅಪ್‌ಡೇಟ್ ಆಗುವುದಿಲ್ಲ."

msgid ""
"It opens file sharing ports: folders are shared only on Home networks, in "
"Shared folders."
msgstr ""
"ಇದು ಫೈಲ್ ಹಂಚಿಕೆ ಪೋರ್ಟ್‌ಗಳನ್ನು ತೆರೆಯುತ್ತದೆ: ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಮನೆ "
"ನೆಟ್‌ವರ್ಕ್‌ಗಳಲ್ಲಿ ಮಾತ್ರ, ಹಂಚಿದ ಫೋಲ್ಡರ್‌ಗಳು ವಿಭಾಗದಲ್ಲಿ ಹಂಚಲಾಗುತ್ತದೆ."

msgid "It says first whether the app keeps itself updated, then installs it."
msgstr ""
"ಇದು ಮೊದಲು ಆ್ಯಪ್ ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆಯೇ ಎಂದು ಹೇಳುತ್ತದೆ, ನಂತರ "
"ಅದನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುತ್ತದೆ."

msgid "It starts when you restart the computer."
msgstr "ನೀವು ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ಅದು ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

msgid ""
"It stops a driver from loading. If it's the drive's or the screen's driver, "
"the computer won't start."
msgstr ""
"ಇದು ಡ್ರೈವರ್ ಲೋಡ್ ಆಗದಂತೆ ತಡೆಯುತ್ತದೆ. ಅದು ಡ್ರೈವ್‌ನ ಅಥವಾ ಪರದೆಯ ಡ್ರೈವರ್ ಆಗಿದ್ದರೆ,"
" ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾಗುವುದಿಲ್ಲ."

msgid ""
"It tells you whether there's a version for EvenKeelOS, or a replacement that "
"does the same job."
msgstr ""
"EvenKeelOS ಗಾಗಿ ಆವೃತ್ತಿ ಇದೆಯೇ ಅಥವಾ ಅದೇ ಕೆಲಸವನ್ನು ಮಾಡುವ ಬದಲಿ ಇದೆಯೇ ಎಂದು ಅದು "
"ನಿಮಗೆ ತಿಳಿಸುತ್ತದೆ."

msgid ""
"It turns off SELinux, which keeps apps and services from reaching what they "
"shouldn't."
msgstr ""
"ಇದು SELinux ಅನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ. SELinux ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳು ಅವು ತಲುಪಬಾರದ"
" ಸ್ಥಳಗಳನ್ನು ತಲುಪದಂತೆ ತಡೆಯುತ್ತದೆ."

msgid "It turns off or weakens a security protection."
msgstr "ಇದು ಭದ್ರತಾ ರಕ್ಷಣೆಯನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ ಅಥವಾ ದುರ್ಬಲಗೊಳಿಸುತ್ತದೆ."

msgid "It turns off protection against processor security flaws."
msgstr "ಇದು ಪ್ರೊಸೆಸರ್‌ನ ಭದ್ರತಾ ದೋಷಗಳ ವಿರುದ್ಧದ ರಕ್ಷಣೆಯನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ."

msgid ""
"It turns off the graphics driver: low resolution, no outside screens, and "
"sleep may not work."
msgstr ""
"ಇದು ಗ್ರಾಫಿಕ್ಸ್ ಡ್ರೈವರ್ ಅನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ: ರೆಸಲ್ಯೂಶನ್ ಕಡಿಮೆಯಾಗುತ್ತದೆ, ಬಾಹ್ಯ "
"ಪರದೆಗಳು ಕಾರ್ಯನಿರ್ವಹಿಸುವುದಿಲ್ಲ ಮತ್ತು ಸ್ಲೀಪ್ ಕೂಡ ಕೆಲಸ ಮಾಡದಿರಬಹುದು."

msgid "It updates by itself."
msgstr "ಇದು ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ."

msgid ""
"It would replace a file that belongs to the system, so it was not added."
msgstr ""
"ಇದು ಸಿಸ್ಟಂಗೆ ಸೇರಿದ ಫೈಲ್ ಅನ್ನು ಬದಲಾಯಿಸುತ್ತಿತ್ತು, ಆದ್ದರಿಂದ ಅದನ್ನು ಸೇರಿಸಲಾಗಿಲ್ಲ."

#, python-brace-format
msgid "It's already set: the version from {date} starts at your next restart."
msgstr ""
"ಇದು ಈಗಾಗಲೇ ಹೊಂದಿಸಲಾಗಿದೆ: {date} ರ ಆವೃತ್ತಿ ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ "
"ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

msgid "It's in Wheelhouse if you want it again."
msgstr "ನಿಮಗೆ ಅದು ಮತ್ತೆ ಬೇಕಿದ್ದರೆ, ಅದು Wheelhouse ನಲ್ಲಿದೆ."

msgid "It's on. From your next restart, the disk unlocks by itself."
msgstr ""
"ಇದು ಆನ್ ಆಗಿದೆ. ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಿಂದ, ಡಿಸ್ಕ್ ತನ್ನಷ್ಟಕ್ಕೇ ಅನ್‌ಲಾಕ್ "
"ಆಗುತ್ತದೆ."

msgid ""
"Its file changed or holds more than one certificate, so nothing was removed. "
"Tell your helper."
msgstr ""
"ಅದರ ಫೈಲ್ ಬದಲಾಗಿದೆ ಅಥವಾ ಅದರಲ್ಲಿ ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ಪ್ರಮಾಣಪತ್ರಗಳಿವೆ, ಆದ್ದರಿಂದ "
"ಏನನ್ನೂ ತೆಗೆದುಹಾಕಲಾಗಿಲ್ಲ. ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ."

#, python-brace-format
msgid ""
"Its file is removed, but \"{name}\" is still trusted: it was added somewhere "
"else too. Tell your helper."
msgstr ""
"ಅದರ ಫೈಲ್ ಅನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ, ಆದರೆ \"{name}\" ಅನ್ನು ಇನ್ನೂ ವಿಶ್ವಾಸಾರ್ಹವೆಂದು "
"ಪರಿಗಣಿಸಲಾಗಿದೆ: ಅದನ್ನು ಬೇರೆಡೆಯೂ ಸೇರಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ."

msgid "January"
msgstr "ಜನವರಿ"

msgid "Join a Wi-Fi network"
msgstr "Wi-Fi ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಸೇರಿ"

msgid "July"
msgstr "ಜುಲೈ"

msgid "June"
msgstr "ಜೂನ್"

msgid "Keep it"
msgstr "ಇದನ್ನು ಉಳಿಸಿಕೊಳ್ಳಿ"

msgid "Keep it on"
msgstr "ಇದನ್ನು ಆನ್ ಆಗಿಯೇ ಇಡಿ"

