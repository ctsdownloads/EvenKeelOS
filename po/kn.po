msgstr "ಸಿದ್ಧತೆಗಳು, ಪ್ರದರ್ಶಕಗಳು ತೆರೆಯಿರಿ."

msgid "Open Settings, Printers, and click Add Printer."
msgstr "ಸಿದ್ಧತೆಗಳು, ಮುದ್ರಕಗಳು ತೆರೆಯಿರಿ, ಮತ್ತು \"ಮುದ್ರಕವನ್ನು ಸೇರಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

