"{names}."

msgid "Report on GitHub"
msgstr "GitHub ನಲ್ಲಿ ವರದಿ ಮಾಡಿ"

msgid "Restart"
msgstr "ಮರುಪ್ರಾರಂಭಿಸಿ"

msgid "Restart into BIOS settings"
msgstr "BIOS ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಮರುಪ್ರಾರಂಭಿಸಿ"

msgid "Restart now"
msgstr "ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ"

msgid "Restart now is waiting: click it once your work is saved."
msgstr ""
"\"ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ\" ಕಾಯುತ್ತಿದೆ: ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಸೇವ್ ಮಾಡಿದ ನಂತರ ಅದನ್ನು "
"ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid ""
"Restart now: the computer restarts and tries the test copy once more. About 3"
" minutes after you log in, this window shows once more, and the start after "
"that is back on this version, with the test copy removed."
msgstr ""
"ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ: ಕಂಪ್ಯೂಟರ್ ಮರುಪ್ರಾರಂಭವಾಗಿ ಪರೀಕ್ಷಾ ನಕಲನ್ನು ಮತ್ತೊಮ್ಮೆ "
"ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ನೀವು ಲಾಗ್ ಇನ್ ಮಾಡಿದ ಸುಮಾರು 3 ನಿಮಿಷಗಳ ನಂತರ ಈ ವಿಂಡೋ ಮತ್ತೊಮ್ಮೆ "
"ಕಾಣಿಸುತ್ತದೆ, ಮತ್ತು ಅದರ ನಂತರದ ಪ್ರಾರಂಭವು ಮತ್ತೆ ಈ ಆವೃತ್ತಿಯಲ್ಲಿ ಆಗುತ್ತದೆ, ಪರೀಕ್ಷಾ"
" ನಕಲನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."

msgid ""
"Restart now: the computer restarts back on this version, and the test copy is"
" removed. At login, a note says the test worked."
msgstr ""
"ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ: ಕಂಪ್ಯೂಟರ್ ಮತ್ತೆ ಈ ಆವೃತ್ತಿಯಲ್ಲಿ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಮತ್ತು"
" ಪರೀಕ್ಷಾ ನಕಲನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. ಲಾಗಿನ್‌ನಲ್ಲಿ, ಪರೀಕ್ಷೆ ಯಶಸ್ವಿಯಾಯಿತು ಎಂದು "
"ಒಂದು ಟಿಪ್ಪಣಿ ತಿಳಿಸುತ್ತದೆ."

msgid "Restart to use the changes"
msgstr "ಬದಲಾವಣೆಗಳನ್ನು ಬಳಸಲು ಮರುಪ್ರಾರಂಭಿಸಿ"

msgid "Restart, then sign in with your account from that company."
msgstr "ಮರುಪ್ರಾರಂಭಿಸಿ, ನಂತರ ಆ ಕಂಪನಿಯ ನಿಮ್ಮ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."

msgid "Resume now"
msgstr "ಈಗ ಪುನರಾರಂಭಿಸಿ"

msgid "Review"
msgstr "ಪರಿಶೀಲನೆ"

msgid ""
"Right now you type the disk password every time the computer starts.\n"
"\n"
"Recommended: Turn on. The computer's security chip unlocks the disk for you. If the disk is ever taken out of this computer, or its startup settings change, it asks for the password as before.\n"
"\n"
"Needs the disk password one last time, then a restart."
msgstr ""
"ಈಗ ನೀವು ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾದ ಪ್ರತಿ ಬಾರಿಯೂ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಟೈಪ್ ಮಾಡುತ್ತೀರಿ.\n"
"\n"
"ಶಿಫಾರಸು: ಆನ್ ಮಾಡಿ. ಕಂಪ್ಯೂಟರ್‌ನ ಭದ್ರತಾ ಚಿಪ್ ನಿಮಗಾಗಿ ಡಿಸ್ಕ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡುತ್ತದೆ. ಎಂದಾದರೂ ಡಿಸ್ಕ್ ಅನ್ನು ಈ ಕಂಪ್ಯೂಟರ್‌ನಿಂದ ಹೊರತೆಗೆದರೆ, ಅಥವಾ ಅದರ ಪ್ರಾರಂಭದ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಬದಲಾದರೆ, ಅದು ಮೊದಲಿನಂತೆ ಪಾಸ್‌ವರ್ಡ್ ಕೇಳುತ್ತದೆ.\n"
"\n"
"ಕೊನೆಯ ಬಾರಿಗೆ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಬೇಕು, ನಂತರ ಒಂದು ಮರುಪ್ರಾರಂಭ."

msgid ""
"Right now you type the disk password every time the computer starts.\n"
"\n"
"Secure Boot is off on this computer, so this would be less safe: someone could change how the computer starts and still get the disk unlocked.\n"
"\n"
"Recommended: Cancel, then turn Secure Boot on in the BIOS settings first (Restart into BIOS settings, in Wheelhouse).\n"
"\n"
"Or Turn on anyway."
msgstr ""
"ಈಗ ನೀವು ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾದ ಪ್ರತಿ ಬಾರಿಯೂ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಟೈಪ್ ಮಾಡುತ್ತೀರಿ.\n"
"\n"
"ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ Secure Boot ಆಫ್ ಆಗಿದೆ, ಆದ್ದರಿಂದ ಇದು ಕಡಿಮೆ ಸುರಕ್ಷಿತವಾಗಿರುತ್ತದೆ: ಯಾರಾದರೂ ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾಗುವ ರೀತಿಯನ್ನು ಬದಲಾಯಿಸಿಯೂ ಡಿಸ್ಕ್ ಅನ್‌ಲಾಕ್ ಆಗುವಂತೆ ಮಾಡಬಹುದು.\n"
"\n"
"ಶಿಫಾರಸು: ರದ್ದುಗೊಳಿಸಿ, ನಂತರ ಮೊದಲು BIOS ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Secure Boot ಅನ್ನು ಆನ್ ಮಾಡಿ (Wheelhouse ನಲ್ಲಿರುವ BIOS ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಮರುಪ್ರಾರಂಭಿಸಿ).\n"
"\n"
"ಅಥವಾ ಆದರೂ ಆನ್ ಮಾಡಿ."

msgid "Right-click the file and choose Open With."
msgstr "ಫೈಲ್ ಮೇಲೆ ರೈಟ್-ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು \"ಇದರಿಂದ ತೆರೆ\" ಆಯ್ಕೆಮಾಡಿ."

msgid "Root"
msgstr "ರೂಟ್"

msgid "Root password"
msgstr "ರೂಟ್ ಪಾಸ್‌ವರ್ಡ್"

msgid "SELinux security"
msgstr "SELinux ಭದ್ರತೆ"

msgid "SELinux would stop blocking anything."
msgstr "SELinux ಏನನ್ನೂ ನಿರ್ಬಂಧಿಸುವುದನ್ನು ನಿಲ್ಲಿಸುತ್ತದೆ."

msgid "Same as above"
msgstr "ಮೇಲಿನಂತೆಯೇ"

msgid "Save"
msgstr "ಉಳಿಸಿ"

msgid "Save details"
msgstr "ವಿವರಗಳನ್ನು ಉಳಿಸಿ"

msgid "Save problem details"
msgstr "ಸಮಸ್ಯೆಯ ವಿವರಗಳನ್ನು ಉಳಿಸಿ"

msgid "Save the file to your computer first, then drop it here."
msgstr ""
"ಮೊದಲು ಫೈಲ್ ಅನ್ನು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ಗೆ ಸೇವ್ ಮಾಡಿ, ನಂತರ ಅದನ್ನು ಇಲ್ಲಿ ಡ್ರಾಪ್ ಮಾಡಿ."

msgid "Save the log"
msgstr "ಲಾಗ್ ಅನ್ನು ಉಳಿಸಿ"

msgid "Save the results"
msgstr "ಫಲಿತಾಂಶಗಳನ್ನು ಉಳಿಸಿ"

msgid "Save the results for your helper."
msgstr "ನಿಮ್ಮ ಸಹಾಯಕರಿಗಾಗಿ ಫಲಿತಾಂಶಗಳನ್ನು ಉಳಿಸಿ."

msgid "Save your work first."
msgstr "ಮೊದಲು ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಸೇವ್ ಮಾಡಿ."

msgid ""
"Save your work first: once it starts, it can't be stopped. It breaks the "
"start before there's a desktop to ask on, so it restarts without asking and "
"ends by itself."
msgstr ""
"ಮೊದಲು ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಸೇವ್ ಮಾಡಿ: ಇದು ಆರಂಭವಾದ ನಂತರ ನಿಲ್ಲಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಕೇಳಲು"
" ಡೆಸ್ಕ್‌ಟಾಪ್ ಬರುವ ಮೊದಲೇ ಇದು ಪ್ರಾರಂಭವನ್ನು ಕೆಡಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಇದು ಕೇಳದೆಯೇ "
"ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ ಮತ್ತು ತಾನಾಗಿಯೇ ಮುಗಿಯುತ್ತದೆ."

msgid "Save your work, then click Restart now."
msgstr "ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಸೇವ್ ಮಾಡಿ, ನಂತರ \"ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

#, python-brace-format
msgid "Saved on {stick} as {name}."
msgstr "{stick} ನಲ್ಲಿ {name} ಎಂದು ಉಳಿಸಲಾಗಿದೆ."

#, python-brace-format
msgid "Saved on {stick} as {name}. You can take the stick out now."
msgstr ""
"{stick} ನಲ್ಲಿ {name} ಎಂದು ಉಳಿಸಲಾಗಿದೆ. ನೀವು ಈಗ USB ಸ್ಟಿಕ್ ಅನ್ನು ತೆಗೆಯಬಹುದು."

#, python-brace-format
msgid ""
"Saved: {name}, in your Documents folder.\n"
"\n"
"Email it to your helper: attach it like any other file.\n"
"\n"
"Recommended: Show the file, to see where it is. Or Close."
msgstr ""
"ಉಳಿಸಲಾಗಿದೆ: {name}, ನಿಮ್ಮ ದಸ್ತಾವೇಜುಗಳು ಫೋಲ್ಡರ್‌ನಲ್ಲಿ.\n"
"\n"
"ಇದನ್ನು ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ಇಮೇಲ್ ಮಾಡಿ: ಬೇರೆ ಯಾವುದೇ ಫೈಲ್‌ನಂತೆ ಲಗತ್ತಿಸಿ.\n"
"\n"
"ಶಿಫಾರಸು: ಅದು ಎಲ್ಲಿದೆ ಎಂದು ನೋಡಲು ಫೈಲ್ ಅನ್ನು ತೋರಿಸಿ. ಅಥವಾ ಮುಚ್ಚಿ."

msgid ""
"Says once at login that the computer went back to the previous version or put"
" back settings by itself"
msgstr ""
"ಕಂಪ್ಯೂಟರ್ ತಾನಾಗಿಯೇ ಹಿಂದಿನ ಆವೃತ್ತಿಗೆ ಮರಳಿದರೆ ಅಥವಾ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರಳಿ "
"ಇರಿಸಿದರೆ, ಲಾಗಿನ್‌ನಲ್ಲಿ ಒಮ್ಮೆ ತಿಳಿಸುತ್ತದೆ"

msgid ""
"Says once whether a package added to the system is ready, offers to add a "
"printer, and updates ArtCraft apps"
msgstr ""
"ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಲಾದ ಪ್ಯಾಕೇಜ್ ಸಿದ್ಧವಾಗಿದೆಯೇ ಎಂದು ಒಮ್ಮೆ ತಿಳಿಸುತ್ತದೆ, ಪ್ರಿಂಟರ್ "
"ಸೇರಿಸಲು ಸೂಚಿಸುತ್ತದೆ, ಮತ್ತು ArtCraft ಆ್ಯಪ್‌ಗಳನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡುತ್ತದೆ"

msgid "Screen brightness control"
msgstr "ಪರದೆಯ ಪ್ರಕಾಶ ನಿಯಂತ್ರಣ"

msgid "Search"
msgstr "ಹುಡುಕಿ"

msgid "Search for the app, open it, and click Install."
msgstr "ಆ್ಯಪ್ ಅನ್ನು ಹುಡುಕಿ, ಅದನ್ನು ತೆರೆಯಿರಿ ಮತ್ತು \"ಇನ್‌ಸ್ಟಾಲ್\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Search tools"
msgstr "ಪರಿಕರಗಳನ್ನು ಹುಡುಕಿ"

msgid "Secure Boot"
msgstr "Secure Boot"

msgid "Secure Boot is off."
msgstr "Secure Boot ಆಫ್ ಆಗಿದೆ."

msgid "Secure Boot is on."
msgstr "Secure Boot ಆನ್ ಆಗಿದೆ."

msgid "Secure Boot on or off is fine."
msgstr "Secure Boot ಆನ್ ಆಗಿರಲಿ ಅಥವಾ ಆಫ್ ಆಗಿರಲಿ, ಎರಡೂ ಸರಿ."

msgid "Security certificates that expired, expire soon or were removed"
msgstr ""
"ಅವಧಿ ಮುಗಿದ, ಶೀಘ್ರದಲ್ಲೇ ಅವಧಿ ಮುಗಿಯಲಿರುವ ಅಥವಾ ತೆಗೆದುಹಾಕಲ್ಪಟ್ಟ ಭದ್ರತಾ "
"ಪ್ರಮಾಣಪತ್ರಗಳು"

msgid ""
"Security certificates that expired, expire within 30 days or were removed"
msgstr ""
"ಅವಧಿ ಮೀರಿದ, 30 ದಿನಗಳೊಳಗೆ ಅವಧಿ ಮುಗಿಯಲಿರುವ ಅಥವಾ ತೆಗೆದುಹಾಕಲ್ಪಟ್ಟಿರುವ ಭದ್ರತಾ "
"ಪ್ರಮಾಣಪತ್ರಗಳು"

msgid "Select it and press Delete. It goes to the Trash."
msgstr "ಅದನ್ನು ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು Delete ಒತ್ತಿರಿ. ಅದು ಕಸಬುಟ್ಟಿಗೆ ಹೋಗುತ್ತದೆ."

msgid "Send details to your helper"
msgstr "ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ವಿವರಗಳನ್ನು ಕಳುಹಿಸಿ"

msgid ""
"Sending details to your helper, checking rollback, and terminal commands"
msgstr ""
"ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ವಿವರಗಳನ್ನು ಕಳುಹಿಸುವುದು, ರೋಲ್‌ಬ್ಯಾಕ್ ಪರಿಶೀಲಿಸುವುದು, ಮತ್ತು "
"ಟರ್ಮಿನಲ್ ಆಜ್ಞೆಗಳು"

msgid "September"
msgstr "ಸೆಪ್ಟೆಂಬರ್"

msgid "Set"
msgstr "ಹೊಂದಿಸಿ"

msgid "Set a broken box up again. Your files aren't touched."
msgstr ""
"ಕೆಟ್ಟುಹೋದ ಬಾಕ್ಸ್ ಅನ್ನು ಮತ್ತೆ ಸಿದ್ಧಪಡಿಸಿ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳಿಗೆ ಏನೂ ಆಗುವುದಿಲ್ಲ."

msgid "Set a sharing password first."
msgstr "ಮೊದಲು ಹಂಚಿಕೆ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಹೊಂದಿಸಿ."

msgid "Set a sharing password, then turn on Share folders on Home networks."
msgstr ""
"ಹಂಚಿಕೆ ಪಾಸ್‌ವರ್ಡ್ ಹೊಂದಿಸಿ, ನಂತರ \"ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ಗಳಲ್ಲಿ ಫೋಲ್ಡರ್‌ಗಳನ್ನು "
"ಹಂಚಿಕೊಳ್ಳಿ\" ಆನ್ ಮಾಡಿ."

msgid "Set it myself"
msgstr "ನಾನೇ ಹೊಂದಿಸುತ್ತೇನೆ"

msgid "Set it up"
msgstr "ಇದನ್ನು ಸೆಟಪ್ ಮಾಡಿ"

msgid "Set the time zone automatically, or pick a region, then a city."
msgstr ""
"ಕಾಲ ವಲಯವನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಹೊಂದಿಸಿ, ಅಥವಾ ಮೊದಲು ಪ್ರದೇಶವನ್ನು, ನಂತರ ನಗರವನ್ನು "
"ಆಯ್ಕೆಮಾಡಿ."

msgid "Set up a broken app box again and put its apps back"
msgstr ""
"ಕೆಟ್ಟುಹೋದ ಆ್ಯಪ್ ಬಾಕ್ಸ್ ಅನ್ನು ಮತ್ತೆ ಸಿದ್ಧಪಡಿಸಿ ಮತ್ತು ಅದರ ಆ್ಯಪ್‌ಗಳನ್ನು ಮರಳಿ "
"ಇರಿಸಿ"

msgid "Set up and add it"
msgstr "ಅದನ್ನು ಸೆಟಪ್ ಮಾಡಿ ಮತ್ತು ಸೇರಿಸಿ"

msgid "Set up and install"
msgstr "ಸೆಟಪ್ ಮಾಡಿ ಮತ್ತು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "Setting the earlier boot options to start next time."
msgstr "ಮುಂದಿನ ಬಾರಿ ಪ್ರಾರಂಭಿಸಲು ಹಿಂದಿನ ಬೂಟ್ ಆಯ್ಕೆಗಳನ್ನು ಹೊಂದಿಸಲಾಗುತ್ತಿದೆ."

msgid "Setting the earlier version to start next time."
msgstr "ಮುಂದಿನ ಬಾರಿ ಪ್ರಾರಂಭವಾಗುವಂತೆ ಹಿಂದಿನ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿಸಲಾಗುತ್ತಿದೆ."

msgid "Setting the newer version to start next time."
msgstr "ಮುಂದಿನ ಬಾರಿ ಹೊಸ ಆವೃತ್ತಿ ಪ್ರಾರಂಭವಾಗುವಂತೆ ಹೊಂದಿಸಲಾಗುತ್ತಿದೆ."

msgid "Setting up the new system"
msgstr "ಹೊಸ ಸಿಸ್ಟಂ ಅನ್ನು ಸೆಟಪ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Setting up the {label}"
msgstr "{label} ಅನ್ನು ಸೆಟಪ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Setting up the {label} again."
msgstr "{label} ಅನ್ನು ಮತ್ತೆ ಸೆಟಪ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

#, python-brace-format
msgid "Setting up the {label} was stopped. Nothing was installed."
msgstr ""
"{label} ಅನ್ನು ಸೆಟಪ್ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಲಾಗಿದೆ. ಏನನ್ನೂ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿಲ್ಲ."

#, python-brace-format
msgid "Setting up the {label}. This happens only once."
msgstr "{label} ಅನ್ನು ಸೆಟಪ್ ಮಾಡಲಾಗುತ್ತಿದೆ. ಇದು ಕೇವಲ ಒಮ್ಮೆ ಮಾತ್ರ ಆಗುತ್ತದೆ."

msgid "Settings"
msgstr "ಸಿದ್ಧತೆಗಳು"

msgid "Settings are really deleted"
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ನಿಜವಾಗಿಯೂ ಅಳಿಸಲಾಗಿದೆ"

msgid "Settings didn't open."
msgstr "ಸಿದ್ಧತೆಗಳು ತೆರೆಯಲಿಲ್ಲ."

msgid "Settings put back"
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರಳಿ ಇರಿಸಲಾಗಿದೆ"

msgid ""
"Settings the computer starts with. Each change makes a new version, and the "
"one before stays as the fallback. Changes ask for an administrator password "
"and start at the next restart."
msgstr ""
"ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾಗುವಾಗ ಇರುವ ಸೆಟ್ಟಿಂಗ್‌ಗಳು. ಪ್ರತಿ ಬದಲಾವಣೆಯೂ ಹೊಸ ಆವೃತ್ತಿಯನ್ನು"
" ರಚಿಸುತ್ತದೆ, ಮತ್ತು ಹಿಂದಿನ ಆವೃತ್ತಿಯು ಬ್ಯಾಕ್‌ಅಪ್ ಆಗಿ ಉಳಿಯುತ್ತದೆ. ಬದಲಾವಣೆಗಳಿಗೆ "
"ನಿರ್ವಾಹಕರ ಪಾಸ್‌ವರ್ಡ್ ಬೇಕಾಗುತ್ತದೆ ಮತ್ತು ಅವು ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಜಾರಿಗೆ "
"ಬರುತ್ತವೆ."

msgid "Settings with quotes or spaces in their value can't be added here."
msgstr ""
"ತಮ್ಮ ಮೌಲ್ಯದಲ್ಲಿ ಉಲ್ಲೇಖ ಚಿಹ್ನೆಗಳು ಅಥವಾ ಖಾಲಿ ಸ್ಥಳಗಳನ್ನು ಹೊಂದಿರುವ "
"ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಇಲ್ಲಿ ಸೇರಿಸಲು ಆಗುವುದಿಲ್ಲ."

msgid "Setup checklist"
msgstr "ಸೆಟಪ್ ಚೆಕ್‌ಲಿಸ್ಟ್"

msgid "Setup checklist at first login"
msgstr "ಮೊದಲ ಲಾಗಿನ್‌ನಲ್ಲಿ ಸೆಟಪ್ ಚೆಕ್‌ಲಿಸ್ಟ್"

msgid "Setup is done."
msgstr "ಸೆಟಪ್ ಪೂರ್ಣಗೊಂಡಿದೆ."

msgid "Share folders on Home networks"
msgstr "ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ಗಳಲ್ಲಿ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಿ"

msgid "Share my printer"
msgstr "ನನ್ನ ಪ್ರಿಂಟರ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಿ"

msgid ""
"Share my printer: lets other computers use a printer plugged into this one."
msgstr ""
"ನನ್ನ ಪ್ರಿಂಟರ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಿ: ಈ ಕಂಪ್ಯೂಟರ್‌ಗೆ ಸಂಪರ್ಕಿಸಲಾದ ಪ್ರಿಂಟರ್ ಅನ್ನು ಇತರ"
" ಕಂಪ್ಯೂಟರ್‌ಗಳು ಬಳಸಲು ಅನುಮತಿಸುತ್ತದೆ."

msgid "Shared folders"
msgstr "ಹಂಚಿದ ಫೋಲ್ಡರ್‌ಗಳು"

msgid "Shared folders can't start"
msgstr "ಹಂಚಿದ ಫೋಲ್ಡರ್‌ಗಳು ಪ್ರಾರಂಭವಾಗಲು ಸಾಧ್ಯವಿಲ್ಲ"

msgid "Sharing"
msgstr "ಹಂಚಿಕೆ"

msgid "Sharing didn't start"
msgstr "ಹಂಚಿಕೆ ಪ್ರಾರಂಭವಾಗಲಿಲ್ಲ"

msgid "Sharing is off"
msgstr "ಹಂಚಿಕೆ ಆಫ್ ಆಗಿದೆ"

msgid "Sharing is off."
msgstr "ಹಂಚಿಕೆ ಆಫ್ ಆಗಿದೆ."

msgid "Sharing is on."
msgstr "ಹಂಚಿಕೆ ಆನ್ ಆಗಿದೆ."

#, python-brace-format
msgid "Sharing on {networks}"
msgstr "{networks} ನಲ್ಲಿ ಹಂಚಿಕೆ"

msgid "Sharing password"
msgstr "ಹಂಚಿಕೆ ಪಾಸ್‌ವರ್ಡ್"

msgid "Sharing password saved."
msgstr "ಹಂಚಿಕೆ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಸೇವ್ ಮಾಡಲಾಗಿದೆ."

msgid "Sharing starts by itself on a Home network."
msgstr "ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿ ಹಂಚಿಕೆ ತಾನಾಗಿಯೇ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

msgid "Sharing waits for a Home network"
msgstr "ಹಂಚಿಕೆ ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ಗಾಗಿ ಕಾಯುತ್ತಿದೆ"

msgid "Shift+Print Screen takes a picture of the whole screen straight away."
msgstr ""
"Shift+Print Screen ಅನ್ನು ಒತ್ತುವುದರಿಂದ ಇಡೀ ಪರದೆಯ ಚಿತ್ರವನ್ನು ತಕ್ಷಣವೇ "
"ತೆಗೆದುಕೊಳ್ಳಲಾಗುತ್ತದೆ."

msgid "Show"
msgstr "ತೋರಿಸಿ"

msgid "Show a QR code"
msgstr "QR ಕೋಡ್ ತೋರಿಸಿ"

msgid "Show me"
msgstr "ನನಗೆ ತೋರಿಸಿ"

#, python-brace-format
msgid "Show me: {target}"
msgstr "ನನಗೆ ತೋರಿಸಿ: {target}"

msgid "Show the file"
msgstr "ಫೈಲ್ ಅನ್ನು ತೋರಿಸಿ"

#, python-brace-format
msgid "Signal {percent}%"
msgstr "ಸಿಗ್ನಲ್ {percent}%"

#, python-brace-format
msgid "Signal {percent}%, password needed"
msgstr "ಸಿಗ್ನಲ್ {percent}%, ಪಾಸ್‌ವರ್ಡ್ ಅಗತ್ಯವಿದೆ"

msgid "Skip"
msgstr "ಬಿಟ್ಟುಬಿಡಿ"

msgid "Skip the disk password at startup"
msgstr "ಪ್ರಾರಂಭಿಸುವಾಗ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಬಿಟ್ಟುಬಿಡಿ"

msgid "Skip the disk password at startup. Uses the computer's security chip."
msgstr ""
"ಪ್ರಾರಂಭಿಸುವಾಗ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಬಿಟ್ಟುಬಿಡಿ. ಕಂಪ್ಯೂಟರ್‌ನ ಭದ್ರತಾ ಚಿಪ್ "
"ಅನ್ನು ಬಳಸುತ್ತದೆ."

msgid "Slideshow"
msgstr "ಸ್ಲೈಡ್‌ಶೋ"

msgid ""
"Some app boxes didn't update.\\n\\nRecommended: Check the boxes. It checks "
"them and repairs one that's broken. Your files aren't touched.\\n\\nOr Not "
"now."
msgstr ""
"ಕೆಲವು ಆ್ಯಪ್ ಬಾಕ್ಸ್‌ಗಳು ಅಪ್‌ಡೇಟ್ ಆಗಲಿಲ್ಲ.\\n\\nಶಿಫಾರಸು: ಬಾಕ್ಸ್‌ಗಳನ್ನು "
"ಪರಿಶೀಲಿಸಿ. ಇದು ಅವುಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ಕೆಟ್ಟುಹೋದ ಒಂದನ್ನು ದುರಸ್ತಿ ಮಾಡುತ್ತದೆ. ನಿಮ್ಮ"
" ಫೈಲ್‌ಗಳಿಗೆ ಏನೂ ಆಗುವುದಿಲ್ಲ.\\n\\nಅಥವಾ ಈಗ ಬೇಡ."

msgid ""
"Some apps from .rpm or .deb files run in an app box. If one stops starting, "
"open Wheelhouse, Apps, Repair app boxes."
msgstr ""
".rpm ಅಥವಾ .deb ಫೈಲ್‌ಗಳಿಂದ ಬಂದ ಕೆಲವು ಆ್ಯಪ್‌ಗಳು ಆ್ಯಪ್ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಚಲಿಸುತ್ತವೆ. "
"ಅವುಗಳಲ್ಲಿ ಒಂದು ಪ್ರಾರಂಭವಾಗದಿದ್ದರೆ, Wheelhouse ತೆರೆಯಿರಿ, ಆ್ಯಪ್‌ಗಳು, ಆ್ಯಪ್ "
"ಬಾಕ್ಸ್‌ಗಳನ್ನು ದುರಸ್ತಿ ಮಾಡಿ."

msgid ""
"Some audio and video formats are covered by patents in some countries.\n"
"Fedora, and this image, leave them out. Installing them is your choice and your\n"
"responsibility."
msgstr ""
"ಕೆಲವು ಆಡಿಯೋ ಮತ್ತು ವೀಡಿಯೊ ಫಾರ್ಮ್ಯಾಟ್‌ಗಳು ಕೆಲವು ದೇಶಗಳಲ್ಲಿ ಪೇಟೆಂಟ್‌ಗಳಿಗೆ ಒಳಪಟ್ಟಿವೆ.\n"
"Fedora ಮತ್ತು ಈ ಇಮೇಜ್ ಅವುಗಳನ್ನು ಸೇರಿಸುವುದಿಲ್ಲ. ಅವುಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವುದು ನಿಮ್ಮ ಆಯ್ಕೆ ಮತ್ತು ನಿಮ್ಮ\n"
"ಜವಾಬ್ದಾರಿ."

#, python-brace-format
msgid ""
"Some important system settings were broken, and putting them back didn't fix the start, so your computer went back to the version from {since}, which has its own settings. Your files and apps aren't touched, and automatic updates aren't paused.\n"
"\n"
"Tell your helper. Save problem details in Wheelhouse makes a file to send them."
msgstr ""
"ಕೆಲವು ಪ್ರಮುಖ ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಕೆಟ್ಟುಹೋಗಿದ್ದವು, ಮತ್ತು ಅವುಗಳನ್ನು ಮರಳಿ ಇರಿಸಿದರೂ ಪ್ರಾರಂಭ ಸರಿಯಾಗಲಿಲ್ಲ, ಆದ್ದರಿಂದ ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಹಿಂದಿನ ಆವೃತ್ತಿಗೆ ({since}) ಹಿಂತಿರುಗಿದೆ, ಅದಕ್ಕೆ ತನ್ನದೇ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿವೆ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳಿಗೆ ಏನೂ ಆಗಿಲ್ಲ, ಮತ್ತು ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ವಿರಾಮಗೊಂಡಿಲ್ಲ.\n"
"\n"
"ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ. Wheelhouse ನಲ್ಲಿರುವ \"ಸಮಸ್ಯೆಯ ವಿವರಗಳನ್ನು ಉಳಿಸಿ\" ಅವುಗಳನ್ನು ಕಳುಹಿಸಲು ಒಂದು ಫೈಲ್ ರಚಿಸುತ್ತದೆ."

msgid ""
"Some video formats (like most web video) need extra codecs that Fedora, and "
"this system, leave out because of patents in some countries. Installing them "
"is your choice and your responsibility.\\n\\nWeb video only: lets Firefox "
"play most web video. A small addition to the system.\\n\\nEverything: plays "
"all common video and audio, in every app. It replaces some parts of the "
"system, so system updates take a little longer.\\n\\nNot now: they're in "
"Wheelhouse, Apps, Media codecs, any time.\\n\\nPick by what you need. If you "
"only watch video in Firefox, Web video only is enough."
msgstr ""
"ಕೆಲವು ವೀಡಿಯೊ ಫಾರ್ಮ್ಯಾಟ್‌ಗಳಿಗೆ (ಹೆಚ್ಚಿನ ವೆಬ್ ವೀಡಿಯೊಗಳಂತೆ) ಹೆಚ್ಚುವರಿ ಕೋಡೆಕ್‌ಗಳು"
" ಬೇಕು, ಕೆಲವು ದೇಶಗಳಲ್ಲಿನ ಪೇಟೆಂಟ್‌ಗಳ ಕಾರಣದಿಂದ Fedora ಮತ್ತು ಈ ಸಿಸ್ಟಂ ಅವುಗಳನ್ನು "
"ಸೇರಿಸುವುದಿಲ್ಲ. ಅವುಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವುದು ನಿಮ್ಮ ಆಯ್ಕೆ ಮತ್ತು ನಿಮ್ಮ "
"ಜವಾಬ್ದಾರಿ.\\n\\nವೆಬ್ ವೀಡಿಯೊ ಮಾತ್ರ: Firefox ಹೆಚ್ಚಿನ ವೆಬ್ ವೀಡಿಯೊಗಳನ್ನು ಪ್ಲೇ "
"ಮಾಡುವಂತೆ ಮಾಡುತ್ತದೆ. ಸಿಸ್ಟಂಗೆ ಒಂದು ಸಣ್ಣ ಸೇರ್ಪಡೆ.\\n\\nಎಲ್ಲವೂ: ಪ್ರತಿ "
"ಆ್ಯಪ್‌ನಲ್ಲಿಯೂ ಎಲ್ಲಾ ಸಾಮಾನ್ಯ ವೀಡಿಯೊ ಮತ್ತು ಆಡಿಯೋಗಳನ್ನು ಪ್ಲೇ ಮಾಡುತ್ತದೆ. ಇದು "
"ಸಿಸ್ಟಂನ ಕೆಲವು ಭಾಗಗಳನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್‌ಗಳಿಗೆ ಸ್ವಲ್ಪ "
"ಹೆಚ್ಚು ಸಮಯ ಬೇಕಾಗುತ್ತದೆ.\\n\\nಈಗ ಬೇಡ: ಅವು ಯಾವಾಗ ಬೇಕಾದರೂ Wheelhouse, ಆ್ಯಪ್‌ಗಳು,"
" ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳು ಇಲ್ಲಿರುತ್ತವೆ.\\n\\nನಿಮಗೆ ಬೇಕಾದುದನ್ನು ನೋಡಿ ಆರಿಸಿ. ನೀವು "
"Firefox ನಲ್ಲಿ ಮಾತ್ರ ವೀಡಿಯೊ ನೋಡುತ್ತಿದ್ದರೆ, ವೆಬ್ ವೀಡಿಯೊ ಮಾತ್ರ ಸಾಕು."

msgid ""
"Some video formats, like most web video, need media codecs that aren't part of the system. The next window explains the choices.\n"
"\n"
"Recommended: Next. Or Skip: they're in Wheelhouse, Apps, Media codecs, any time."
msgstr ""
"ಹೆಚ್ಚಿನ ವೆಬ್ ವೀಡಿಯೊಗಳಂತಹ ಕೆಲವು ವೀಡಿಯೊ ಫಾರ್ಮ್ಯಾಟ್‌ಗಳಿಗೆ, ಸಿಸ್ಟಂನ ಭಾಗವಲ್ಲದ ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳು ಬೇಕು. ಮುಂದಿನ ವಿಂಡೋ ಆಯ್ಕೆಗಳನ್ನು ವಿವರಿಸುತ್ತದೆ.\n"
"\n"
"ಶಿಫಾರಸು: ಮುಂದೆ. ಅಥವಾ ಬಿಟ್ಟುಬಿಡಿ: ಅವು ಯಾವಾಗ ಬೇಕಾದರೂ Wheelhouse, ಆ್ಯಪ್‌ಗಳು, ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳು ಇಲ್ಲಿರುತ್ತವೆ."

msgid ""
"Some, like printer drivers, are added to the system: they're ready after the "
"next restart."
msgstr ""
"ಪ್ರಿಂಟರ್ ಡ್ರೈವರ್‌ಗಳಂತಹ ಕೆಲವು ಅಂಶಗಳನ್ನು ಸಿಸ್ಟಂಗೆ ಸೇರಿಸಲಾಗುತ್ತದೆ: ಮುಂದಿನ "
"ಮರುಪ್ರಾರಂಭದ ನಂತರ ಅವು ಸಿದ್ಧವಾಗಿರುತ್ತವೆ."

msgid "Something here won't work. Read it before installing."
msgstr "ಇಲ್ಲಿ ಏನೋ ಕೆಲಸ ಮಾಡುವುದಿಲ್ಲ. ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವ ಮೊದಲು ಇದನ್ನು ಓದಿ."

msgid "Something not right?"
msgstr "ಏನೋ ಸರಿಯಿಲ್ಲವೇ?"

msgid "Something stopped working after an update"
msgstr "ಅಪ್‌ಡೇಟ್‌ನ ನಂತರ ಏನೋ ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿತು"

#, python-brace-format
msgid ""
"Something stopped working after the Boot options change.\n"
"\n"
"These worked before the Boot options change and don't now:\n"
"{broke}"
msgstr ""
"ಬೂಟ್ ಆಯ್ಕೆಗಳನ್ನು ಬದಲಾಯಿಸಿದ ನಂತರ ಏನೋ ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿತು.\n"
"\n"
"ಬೂಟ್ ಆಯ್ಕೆಗಳನ್ನು ಬದಲಾಯಿಸುವ ಮೊದಲು ಇವು ಕೆಲಸ ಮಾಡುತ್ತಿದ್ದವು, ಆದರೆ ಈಗ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ:\n"
"{broke}"

#, python-brace-format
msgid ""
"Something stopped working after the update.\n"
"\n"
"These worked before the update and don't now:\n"
"{broke}"
msgstr ""
"ಅಪ್‌ಡೇಟ್ ಆದ ನಂತರ ಏನೋ ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿತು.\n"
"\n"
"ಇವುಗಳು ಅಪ್‌ಡೇಟ್‌ಗೆ ಮೊದಲು ಕೆಲಸ ಮಾಡುತ್ತಿದ್ದವು, ಆದರೆ ಈಗ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ:\n"
"{broke}"

#, python-brace-format
msgid "Something unexpected went wrong: {error}"
msgstr "ಅನಿರೀಕ್ಷಿತವಾಗಿ ಏನೋ ತಪ್ಪಾಗಿದೆ: {error}"

msgid "Sound"
msgstr "ಧ್ವನಿ"

msgid "Sound driver blocked"
msgstr "ಧ್ವನಿ ಡ್ರೈವರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ"

msgid "Sound found."
msgstr "ಧ್ವನಿ ಕಂಡುಬಂದಿದೆ."

#, python-brace-format
msgid "Space used: {sizes}."
msgstr "ಬಳಸಿದ ಸ್ಥಳ: {sizes}."

msgid "Standard"
msgstr "ಸ್ಟ್ಯಾಂಡರ್ಡ್"

msgid "Standard top bar, or Windows-style bottom bar and start menu"
msgstr ""
"ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಮೇಲಿನ ಪಟ್ಟಿ, ಅಥವಾ Windows ಶೈಲಿಯ ಕೆಳಗಿನ ಪಟ್ಟಿ ಮತ್ತು ಸ್ಟಾರ್ಟ್ ಮೆನು"

msgid "Start"
msgstr "ಪ್ರಾರಂಭಿಸಿ"

msgid "Start Apps at Login"
msgstr "ಲಾಗಿನ್‌ನಲ್ಲಿ ಆ್ಯಪ್‌ಗಳನ್ನು ಪ್ರಾರಂಭಿಸಿ"

msgid "Start Apps at Login is open"
msgstr "\"ಲಾಗಿನ್‌ನಲ್ಲಿ ಆ್ಯಪ್‌ಗಳನ್ನು ಪ್ರಾರಂಭಿಸಿ\" ತೆರೆದಿದೆ"

msgid "Start an app when you log in"
msgstr "ನೀವು ಲಾಗ್ ಇನ್ ಮಾಡಿದಾಗ ಆ್ಯಪ್ ಅನ್ನು ಪ್ರಾರಂಭಿಸಿ"

msgid "Start apps at login"
msgstr "ಲಾಗಿನ್‌ನಲ್ಲಿ ಆ್ಯಪ್‌ಗಳನ್ನು ಪ್ರಾರಂಭಿಸಿ"

msgid ""
"Start menu: with the Windows-style layout, the sailboat button at the bottom "
"left. With the standard layout, press the Windows key."
msgstr ""
"ಸ್ಟಾರ್ಟ್ ಮೆನು: Windows ಶೈಲಿಯ ಲೇಔಟ್‌ನಲ್ಲಿ, ಕೆಳಗಿನ ಎಡ ಮೂಲೆಯಲ್ಲಿರುವ ಹಾಯಿದೋಣಿ "
"ಬಟನ್. ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಲೇಔಟ್‌ನಲ್ಲಿ, Windows ಕೀ ಒತ್ತಿರಿ."

msgid "Start mode"
msgstr "ಪ್ರಾರಂಭದ ಮೋಡ್"

msgid "Start the USB stick again with the first entry, EvenKeelOS Live."
msgstr "ಮೊದಲ ನಮೂದು, EvenKeelOS Live, ಬಳಸಿ USB ಸ್ಟಿಕ್‌ನಿಂದ ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಿ."

msgid "Start the test"
msgstr "ಪರೀಕ್ಷೆಯನ್ನು ಪ್ರಾರಂಭಿಸಿ"

msgid "Started in UEFI mode."
msgstr "UEFI ಮೋಡ್‌ನಲ್ಲಿ ಪ್ರಾರಂಭಿಸಲಾಗಿದೆ."

msgid "Started in basic graphics mode, so graphics can't be checked."
msgstr ""
"ಮೂಲ ಗ್ರಾಫಿಕ್ಸ್ ಮೋಡ್‌ನಲ್ಲಿ ಪ್ರಾರಂಭಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಗ್ರಾಫಿಕ್ಸ್ ಅನ್ನು "
"ಪರಿಶೀಲಿಸಲು ಆಗುವುದಿಲ್ಲ."

msgid "Starting"
msgstr "ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ"

msgid "Starting hangs (about 7 minutes)"
msgstr "ಪ್ರಾರಂಭವಾಗುವಾಗ ಸಿಲುಕಿಕೊಳ್ಳುತ್ತದೆ (ಸುಮಾರು 7 ನಿಮಿಷ)"

msgid ""
"Starting hangs on the startup screen and the login screen never shows. After "
"3 minutes the computer restarts by itself. That happens twice (about 7 "
"minutes), and the third start is back on this version."
msgstr ""
"ಪ್ರಾರಂಭವು ಸ್ಟಾರ್ಟ್‌ಅಪ್ ಪರದೆಯಲ್ಲಿ ಸಿಲುಕಿಕೊಳ್ಳುತ್ತದೆ ಮತ್ತು ಲಾಗಿನ್ ಪರದೆ "
"ಕಾಣಿಸುವುದೇ ಇಲ್ಲ. 3 ನಿಮಿಷಗಳ ನಂತರ ಕಂಪ್ಯೂಟರ್ ತಾನಾಗಿಯೇ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ಇದು "
"ಎರಡು ಬಾರಿ ಆಗುತ್ತದೆ (ಸುಮಾರು 7 ನಿಮಿಷ), ಮತ್ತು ಮೂರನೇ ಪ್ರಾರಂಭವು ಮತ್ತೆ ಈ "
"ಆವೃತ್ತಿಯಲ್ಲಿ ಆಗುತ್ತದೆ."

msgid "Starting the computer"
msgstr "ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ"

msgid "Starts at login"
msgstr "ಲಾಗಿನ್ ಮಾಡಿದಾಗ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ"

msgid "Status"
msgstr "ಸ್ಥಿತಿ"

#, python-brace-format
msgid "Step {number} of {total}: {name}"
msgstr "ಹಂತ {number} / {total}: {name}"

#, python-brace-format
msgid ""
"Still not working after a restart.\n"
"\n"
"These still don't work since the Boot options change:\n"
"{broke}"
msgstr ""
"ಮರುಪ್ರಾರಂಭಿಸಿದ ಮೇಲೂ ಇನ್ನೂ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ.\n"
"\n"
"ಬೂಟ್ ಆಯ್ಕೆಗಳು ಬದಲಾದ ನಂತರವೂ ಇವು ಇನ್ನೂ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಿಲ್ಲ:\n"
"{broke}"

#, python-brace-format
msgid ""
"Still not working after a restart.\n"
"\n"
"These still don't work since the update:\n"
"{broke}"
msgstr ""
"ಮರುಪ್ರಾರಂಭಿಸಿದ ಮೇಲೂ ಇನ್ನೂ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ.\n"
"\n"
"ಅಪ್‌ಡೇಟ್ ಆದ ನಂತರವೂ ಇವು ಇನ್ನೂ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ:\n"
"{broke}"

msgid "Stop sharing it"
msgstr "ಇದನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದನ್ನು ನಿಲ್ಲಿಸಿ"

#, python-brace-format
msgid "Stop sharing {name}"
msgstr "{name} ಅನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದನ್ನು ನಿಲ್ಲಿಸಿ"

msgid ""
"Stopping %s in its box. This takes a few seconds. If GNOME shows a Force Quit"
" / Wait window, you do not need to press anything: %s closes on its own."
msgstr ""
"%s ಅನ್ನು ಅದರ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ನಿಲ್ಲಿಸಲಾಗುತ್ತಿದೆ. ಇದಕ್ಕೆ ಕೆಲವು ಸೆಕೆಂಡುಗಳು ಬೇಕು. "
"GNOME \"Force Quit / Wait\" ವಿಂಡೋ ತೋರಿಸಿದರೆ, ನೀವು ಏನನ್ನೂ ಒತ್ತಬೇಕಾಗಿಲ್ಲ: %s "
"ತಾನಾಗಿಯೇ ಮುಚ್ಚಿಕೊಳ್ಳುತ್ತದೆ."

msgid ""
"Strangers on the same network, in a café, hotel or airport, could reach it "
"too. Only do this if you need it here, and close it again when you're done."
msgstr ""
"ಅದೇ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವ ಅಪರಿಚಿತರು, ಕೆಫೆ, ಹೋಟೆಲ್ ಅಥವಾ ವಿಮಾನ ನಿಲ್ದಾಣದಲ್ಲಿ, "
"ಇದನ್ನು ತಲುಪಬಹುದು. ನಿಮಗೆ ಇಲ್ಲಿ ಇದು ಬೇಕಿದ್ದರೆ ಮಾತ್ರ ಇದನ್ನು ಮಾಡಿ, ಮತ್ತು ಮುಗಿದ "
"ನಂತರ ಇದನ್ನು ಮತ್ತೆ ಮುಚ್ಚಿ."

#, python-brace-format
msgid "Strength: {strength}."
msgstr "ಬಲ: {strength}."

msgid "Strong"
msgstr "ಪ್ರಬಲ"

msgid "Stuck while starting"
msgstr "ಪ್ರಾರಂಭವಾಗುವಾಗ ಸಿಲುಕಿಕೊಳ್ಳುತ್ತದೆ"

msgid ""
"Style: Default (light) or Dark. Accent Color: the color of buttons and folder"
" icons."
msgstr ""
"Style: Default (ಲೈಟ್) ಅಥವಾ Dark. Accent Color: ಬಟನ್‌ಗಳು ಮತ್ತು ಫೋಲ್ಡರ್ "
"ಐಕಾನ್‌ಗಳ ಬಣ್ಣ."

msgid "Suggested"
msgstr "ಸೂಚಿಸಲಾಗಿದೆ"

msgid ""
"Sunset and sunrise can't be worked out for this time zone. Use Custom times."
msgstr ""
"ಈ ಕಾಲ ವಲಯಕ್ಕೆ ಸೂರ್ಯಾಸ್ತ ಮತ್ತು ಸೂರ್ಯೋದಯವನ್ನು ಲೆಕ್ಕ ಹಾಕಲು ಸಾಧ್ಯವಿಲ್ಲ. \"ಕಸ್ಟಮ್ "
"ಸಮಯಗಳು\" ಬಳಸಿ."

msgid "Sunset to sunrise"
msgstr "ಸೂರ್ಯಾಸ್ತದಿಂದ ಸೂರ್ಯೋದಯದವರೆಗೆ"

msgid "Switch"
msgstr "ಬದಲಾಯಿಸಿ"

msgid ""
"Switch between light and dark yourself, in Settings or the quick settings "
"menu."
msgstr ""
"ಸಿದ್ಧತೆಗಳು ಅಥವಾ ತ್ವರಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಮೆನುವಿನಲ್ಲಿ ನೀವೇ ಲೈಟ್ ಮತ್ತು ಡಾರ್ಕ್ ನಡುವೆ "
"ಬದಲಾಯಿಸಬಹುದು."

msgid "Switch to the dark style at sunset, or at times you pick"
msgstr ""
"ಸೂರ್ಯಾಸ್ತದಲ್ಲಿ, ಅಥವಾ ನೀವು ಆರಿಸುವ ಸಮಯಗಳಲ್ಲಿ, ಡಾರ್ಕ್ ಶೈಲಿಗೆ ಬದಲಾಯಿಸುತ್ತದೆ"

msgid ""
"Switches the dark style for you. Night Light in Settings only warms the "
"colors. You can still switch it yourself any time."
msgstr ""
"ನಿಮಗಾಗಿ ಡಾರ್ಕ್ ಶೈಲಿಯನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ. ಸಿದ್ಧತೆಗಳು ನಲ್ಲಿರುವ Night Light "
"ಬಣ್ಣಗಳನ್ನು ಬೆಚ್ಚಗಾಗಿಸುತ್ತದೆ ಅಷ್ಟೇ. ನೀವು ಯಾವಾಗ ಬೇಕಾದರೂ ಅದನ್ನು ನೀವೇ "
"ಬದಲಾಯಿಸಬಹುದು."

msgid "Switching the desktop layout."
msgstr "ಡೆಸ್ಕ್‌ಟಾಪ್ ಲೇಔಟ್ ಅನ್ನು ಬದಲಾಯಿಸಲಾಗುತ್ತಿದೆ."

msgid "System"
msgstr "ಸಿಸ್ಟಂ"

msgid "System Update"
msgstr "ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್"

msgid "Take a screenshot or record the screen"
msgstr "ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ತೆಗೆದುಕೊಳ್ಳಿ ಅಥವಾ ಪರದೆಯನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಿ"

msgid "Take it out"
msgstr "ಅದನ್ನು ಹೊರತೆಗೆಯಿರಿ"

#, python-brace-format
msgid "Take out {setting}"
msgstr "{setting} ಅನ್ನು ಹೊರತೆಗೆಯಿರಿ"

msgid "Take the extra formats out again"
msgstr "ಹೆಚ್ಚುವರಿ ಫಾರ್ಮ್ಯಾಟ್‌ಗಳನ್ನು ಮತ್ತೆ ತೆಗೆದುಹಾಕಿ"

msgid "Task Manager: Resources. Find it in the start menu."
msgstr "ಟಾಸ್ಕ್ ಮ್ಯಾನೇಜರ್: Resources. ಇದನ್ನು ಸ್ಟಾರ್ಟ್ ಮೆನುವಿನಲ್ಲಿ ಹುಡುಕಿ."

msgid "Teal to start. Folder icons follow whatever color you pick."
msgstr ""
"ಆರಂಭದಲ್ಲಿ ಟೀಲ್. ನೀವು ಯಾವ ಬಣ್ಣವನ್ನು ಆರಿಸಿದರೂ ಫೋಲ್ಡರ್ ಐಕಾನ್‌ಗಳು ಅದನ್ನು "
"ಅನುಸರಿಸುತ್ತವೆ."

msgid "Test automatic rollback"
msgstr "ಸ್ವಯಂಚಾಲಿತ ರೋಲ್‌ಬ್ಯಾಕ್ ಅನ್ನು ಪರೀಕ್ಷಿಸಿ"

msgid "Text size"
msgstr "ಪಠ್ಯ ಗಾತ್ರ"

msgid "That couldn't be saved."
msgstr "ಅದನ್ನು ಸೇವ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "That didn't save. Try again in Wheelhouse, Network safety."
msgstr ""
"ಅದು ಸೇವ್ ಆಗಲಿಲ್ಲ. Wheelhouse, ನೆಟ್‌ವರ್ಕ್ ಸುರಕ್ಷತೆ ವಿಭಾಗದಲ್ಲಿ ಮತ್ತೆ "
"ಪ್ರಯತ್ನಿಸಿ."

msgid "That folder belongs to someone else."
msgstr "ಆ ಫೋಲ್ಡರ್ ಬೇರೊಬ್ಬರಿಗೆ ಸೇರಿದೆ."

msgid "That folder has no pictures in it (JPEG, PNG or WebP)."
msgstr "ಆ ಫೋಲ್ಡರ್‌ನಲ್ಲಿ ಯಾವುದೇ ಚಿತ್ರಗಳಿಲ್ಲ (JPEG, PNG ಅಥವಾ WebP)."

#, python-brace-format
msgid "That folder is already shared, as {name}."
msgstr "ಆ ಫೋಲ್ಡರ್ ಅನ್ನು ಈಗಾಗಲೇ {name} ಆಗಿ ಹಂಚಲಾಗಿದೆ."

msgid "That folder isn't shared."
msgstr "ಆ ಫೋಲ್ಡರ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲಾಗಿಲ್ಲ."

msgid "That folder wasn't found."
msgstr "ಆ ಫೋಲ್ಡರ್ ಸಿಗಲಿಲ್ಲ."

msgid "That folder's name can't be shared. Rename it or pick another."
msgstr ""
"ಆ ಫೋಲ್ಡರ್‌ನ ಹೆಸರನ್ನು ಹಂಚಿಕೊಳ್ಳಲು ಆಗುವುದಿಲ್ಲ. ಅದಕ್ಕೆ ಹೊಸ ಹೆಸರು ಇಡಿ ಅಥವಾ "
"ಬೇರೊಂದನ್ನು ಆಯ್ಕೆಮಾಡಿ."

msgid "That isn't let in here."
msgstr "ಅದನ್ನು ಇಲ್ಲಿ ಒಳಗೆ ಬಿಡಲಾಗಿಲ್ಲ."

msgid "That isn't the disk password, so nothing was changed. Try again."
msgstr "ಅದು ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅಲ್ಲ, ಆದ್ದರಿಂದ ಏನೂ ಬದಲಾಗಿಲ್ಲ. ಪುನಃ ಪ್ರಯತ್ನಿಸಿ."

msgid ""
"That was the wrong disk password too many times, so it's locked for an hour. "
"Nothing was changed. Try again after that."
msgstr ""
"ಅನೇಕ ಬಾರಿ ತಪ್ಪು ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಮೂದಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಅದನ್ನು ಒಂದು "
"ಗಂಟೆಯವರೆಗೆ ಲಾಕ್ ಮಾಡಲಾಗಿದೆ. ಏನೂ ಬದಲಾಗಿಲ್ಲ. ಅದರ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

msgid ""
"The BIOS screen uses the keyboard. When you're done, choose Save and Exit, or"
" Exit."
msgstr ""
"BIOS ಪರದೆಯನ್ನು ಕೀಬೋರ್ಡ್ ಮೂಲಕ ಬಳಸಲಾಗುತ್ತದೆ. ನೀವು ಮುಗಿಸಿದಾಗ, \"Save and Exit\" "
"ಅಥವಾ \"Exit\" ಆಯ್ಕೆಮಾಡಿ."

msgid ""
"The BIOS's RAID setting (Intel RST) hides the disk. Restart into the BIOS and"
" set the storage mode (often called SATA mode or SATA operation) to AHCI. "
"Windows on this disk won't start after that change, but installing EvenKeelOS"
" erases it anyway."
msgstr ""
"BIOS ನ RAID ಸೆಟ್ಟಿಂಗ್ (Intel RST) ಡಿಸ್ಕ್ ಅನ್ನು ಮರೆಮಾಡುತ್ತದೆ. BIOS ಗೆ "
"ಮರುಪ್ರಾರಂಭಿಸಿ ಮತ್ತು ಸಂಗ್ರಹಣಾ ಮೋಡ್ ಅನ್ನು (ಇದನ್ನು ಸಾಮಾನ್ಯವಾಗಿ SATA ಮೋಡ್ ಅಥವಾ "
"SATA ಕಾರ್ಯಾಚರಣೆ ಎಂದು ಕರೆಯಲಾಗುತ್ತದೆ) AHCI ಗೆ ಹೊಂದಿಸಿ. ಆ ಬದಲಾವಣೆಯ ನಂತರ ಈ "
"ಡಿಸ್ಕ್‌ನಲ್ಲಿರುವ Windows ಆರಂಭವಾಗುವುದಿಲ್ಲ, ಆದರೆ EvenKeelOS ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ "
"ಮಾಡಿದರೆ ಅದು ಹೇಗಿದ್ದರೂ ಅಳಿಸಿಹೋಗುತ್ತದೆ."

msgid "The Bluetooth driver is blocked, so there's no Bluetooth."
msgstr "ಬ್ಲೂಟೂತ್ ಡ್ರೈವರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಬ್ಲೂಟೂತ್ ಇಲ್ಲ."

msgid ""
"The NVIDIA card runs on the open-source driver built into EvenKeelOS. The "
"proprietary NVIDIA driver isn't used: it breaks too often to keep the promise"
" that EvenKeelOS just works. If you need it, use Bazzite or Bluefin's NVIDIA "
"editions instead."
msgstr ""
"NVIDIA ಕಾರ್ಡ್ EvenKeelOS ನಲ್ಲಿ ಅಂತರ್ಗತವಾಗಿರುವ ಓಪನ್-ಸೋರ್ಸ್ ಡ್ರೈವರ್‌ನಲ್ಲಿ ಕೆಲಸ "
"ಮಾಡುತ್ತದೆ. ಪ್ರೊಪ್ರೈಟರಿ NVIDIA ಡ್ರೈವರ್ ಅನ್ನು ಬಳಸಲಾಗುವುದಿಲ್ಲ: ಅದು ಆಗಾಗ್ಗೆ "
"ಕೆಟ್ಟುಹೋಗುವುದರಿಂದ, EvenKeelOS ಸರಾಗವಾಗಿ ಕೆಲಸ ಮಾಡುತ್ತದೆ ಎಂಬ ಭರವಸೆಯನ್ನು "
"ಉಳಿಸಿಕೊಳ್ಳಲು ಆಗುವುದಿಲ್ಲ. ನಿಮಗೆ ಅದು ಬೇಕಿದ್ದರೆ, ಬದಲಿಗೆ Bazzite ಅಥವಾ Bluefin ನ "
"NVIDIA ಆವೃತ್ತಿಗಳನ್ನು ಬಳಸಿ."

msgid "The QR code could not be made. Save the log to a stick instead."
msgstr "QR ಕೋಡ್ ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಬದಲಿಗೆ ಲಾಗ್ ಅನ್ನು USB ಸ್ಟಿಕ್‌ಗೆ ಉಳಿಸಿ."

msgid "The USB stick could not be opened."
msgstr "USB ಸ್ಟಿಕ್ ಅನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "The VPN list is missing."
msgstr "VPN ಪಟ್ಟಿ ಇಲ್ಲ."

msgid "The Wi-Fi card's driver is blocked, so there's no Wi-Fi."
msgstr "Wi-Fi ಕಾರ್ಡ್‌ನ ಡ್ರೈವರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ Wi-Fi ಇಲ್ಲ."

msgid "The administrator password was not given, so nothing was changed."
msgstr "ನಿರ್ವಾಹಕರ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನೀಡಲಾಗಿಲ್ಲ, ಆದ್ದರಿಂದ ಏನನ್ನೂ ಬದಲಾಯಿಸಲಾಗಿಲ್ಲ."

msgid "The administrator password wasn't given, so nothing was changed."
msgstr "ನಿರ್ವಾಹಕರ ಪಾಸ್‌ವರ್ಡ್ ನೀಡಲಾಗಿಲ್ಲ, ಆದ್ದರಿಂದ ಏನೂ ಬದಲಾಗಿಲ್ಲ."

msgid "The app system (Flatpak)"
msgstr "ಆ್ಯಪ್ ಸಿಸ್ಟಂ (Flatpak)"

msgid "The app's instructions say TCP, UDP or both"
msgstr "ಆ್ಯಪ್‌ನ ಸೂಚನೆಗಳು TCP, UDP ಅಥವಾ ಎರಡನ್ನೂ ಹೇಳುತ್ತವೆ"

msgid "The automatic rollback test worked."
msgstr "ಸ್ವಯಂಚಾಲಿತ ರೋಲ್‌ಬ್ಯಾಕ್ ಪರೀಕ್ಷೆ ಯಶಸ್ವಿಯಾಯಿತು."

msgid ""
"The automatic update is already running, so this window follows it until it's"
" done. You can keep working."
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್ ಈಗಾಗಲೇ ಚಾಲನೆಯಲ್ಲಿದೆ, ಆದ್ದರಿಂದ ಈ ವಿಂಡೋ ಅದು "
"ಪೂರ್ಣಗೊಳ್ಳುವವರೆಗೆ ಅದನ್ನು ಅನುಸರಿಸುತ್ತದೆ. ನೀವು ಕೆಲಸವನ್ನು ಮುಂದುವರಿಸಬಹುದು."

msgid ""
"The battery is at %s%% and the computer isn't plugged in. If the battery runs"
" out during the update, the update is lost and has to start "
"again.\\n\\nRecommended: Not now. Plug the computer in, then start System "
"Update again.\\n\\nOr Update anyway."
msgstr ""
"ಬ್ಯಾಟರಿ %s%% ನಲ್ಲಿದೆ ಮತ್ತು ಕಂಪ್ಯೂಟರ್ ವಿದ್ಯುತ್‌ಗೆ ಸಂಪರ್ಕಗೊಂಡಿಲ್ಲ. ಅಪ್‌ಡೇಟ್ "
"ನಡೆಯುತ್ತಿರುವಾಗ ಬ್ಯಾಟರಿ ಖಾಲಿಯಾದರೆ, ಅಪ್‌ಡೇಟ್ ವ್ಯರ್ಥವಾಗುತ್ತದೆ ಮತ್ತು ಮತ್ತೆ "
"ಮೊದಲಿನಿಂದ ಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.\\n\\nಶಿಫಾರಸು: ಈಗ ಬೇಡ. ಕಂಪ್ಯೂಟರ್ ಅನ್ನು "
"ವಿದ್ಯುತ್‌ಗೆ ಸಂಪರ್ಕಿಸಿ, ನಂತರ ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಿ.\\n\\nಅಥವಾ"
" ಆದರೂ ಅಪ್‌ಡೇಟ್ ಮಾಡಿ."

msgid ""
"The battery is at %s%%. Plug the computer in: if it runs out during the "
"update, the update is lost."
msgstr ""
"ಬ್ಯಾಟರಿ %s%% ನಲ್ಲಿದೆ. ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ವಿದ್ಯುತ್‌ಗೆ ಸಂಪರ್ಕಿಸಿ: ಅಪ್‌ಡೇಟ್ "
"ನಡೆಯುತ್ತಿರುವಾಗ ಬ್ಯಾಟರಿ ಖಾಲಿಯಾದರೆ, ಅಪ್‌ಡೇಟ್ ವ್ಯರ್ಥವಾಗುತ್ತದೆ."

#, python-brace-format
msgid "The biggest disk holds {gb} GB."
msgstr "ಅತಿ ದೊಡ್ಡ ಡಿಸ್ಕ್ {gb} GB ಸಂಗ್ರಹ ಸಾಮರ್ಥ್ಯವನ್ನು ಹೊಂದಿದೆ."

msgid "The boot entry is already named %s. Nothing to do."
msgstr "ಬೂಟ್ ನಮೂದಿಗೆ ಈಗಾಗಲೇ %s ಎಂದು ಹೆಸರಿಡಲಾಗಿದೆ. ಏನೂ ಮಾಡುವ ಅಗತ್ಯವಿಲ್ಲ."

msgid "The boot options can't be read right now"
msgstr "ಬೂಟ್ ಆಯ್ಕೆಗಳನ್ನು ಈಗ ಓದಲು ಆಗುತ್ತಿಲ್ಲ"

#, python-brace-format
msgid "The boot options didn't change: {reason}"
msgstr "ಬೂಟ್ ಆಯ್ಕೆಗಳು ಬದಲಾಗಿಲ್ಲ: {reason}"

msgid "The boot options the computer starts with couldn't be read."
msgstr "ಕಂಪ್ಯೂಟರ್ ಆರಂಭವಾಗುವಾಗ ಬಳಸುವ ಬೂಟ್ ಆಯ್ಕೆಗಳನ್ನು ಓದಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "The box is missing or broken."
msgstr "ಬಾಕ್ಸ್ ಕಾಣೆಯಾಗಿದೆ ಅಥವಾ ಕೆಟ್ಟುಹೋಗಿದೆ."

msgid ""
"The buttons at a window's top right minimize, maximize and close it, as on "
"Windows."
msgstr ""
"Windows ನಂತೆ, ವಿಂಡೋದ ಮೇಲಿನ ಬಲಭಾಗದಲ್ಲಿರುವ ಬಟನ್‌ಗಳು ಅದನ್ನು ಚಿಕ್ಕದಾಗಿಸುತ್ತವೆ, "
"ದೊಡ್ಡದಾಗಿಸುತ್ತವೆ ಮತ್ತು ಮುಚ್ಚುತ್ತವೆ."

#, python-brace-format
msgid "The camera ({device})"
msgstr "ಕ್ಯಾಮೆರಾ ({device})"

#, python-brace-format
msgid ""
"The certificate \"{name}\" was added to this computer and has been removed, "
"so it's no longer trusted. If you didn't remove it, tell your helper."
msgstr ""
"\"{name}\" ಪ್ರಮಾಣಪತ್ರವನ್ನು ಈ ಕಂಪ್ಯೂಟರ್‌ಗೆ ಸೇರಿಸಲಾಗಿತ್ತು ಮತ್ತು ಅದನ್ನು "
"ತೆಗೆದುಹಾಕಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಅದು ಇನ್ನು ಮುಂದೆ ವಿಶ್ವಾಸಾರ್ಹವಾಗಿಲ್ಲ. ನೀವು ಅದನ್ನು "
"ತೆಗೆದುಹಾಕದಿದ್ದರೆ, ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ."

msgid "The certificates couldn't be checked."
msgstr "ಪ್ರಮಾಣಪತ್ರಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "The change was not made, and nothing was left behind."
msgstr "ಬದಲಾವಣೆಯನ್ನು ಮಾಡಲಾಗಿಲ್ಲ, ಮತ್ತು ಏನೂ ಉಳಿದಿಲ್ಲ."

msgid "The check couldn't finish."
msgstr "ಪರಿಶೀಲನೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "The clock and time zone settings could not be saved."
msgstr "ಗಡಿಯಾರ ಮತ್ತು ಕಾಲ ವಲಯದ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid ""
"The codecs are installed. They start working after a restart, which the setup"
" checklist offers at its end."
msgstr ""
"ಕೋಡೆಕ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ. ಮರುಪ್ರಾರಂಭದ ನಂತರ ಅವು ಕೆಲಸ ಮಾಡಲು "
"ಆರಂಭಿಸುತ್ತವೆ; ಸೆಟಪ್ ಚೆಕ್‌ಲಿಸ್ಟ್ ತನ್ನ ಕೊನೆಯಲ್ಲಿ ಮರುಪ್ರಾರಂಭವನ್ನು ನೀಡುತ್ತದೆ."

msgid ""
"The codecs are installed.\\n\\nRecommended: Restart now to start using them. "
"Or Later."
msgstr ""
"ಕೋಡೆಕ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ.\\n\\nಶಿಫಾರಸು: ಅವುಗಳನ್ನು ಬಳಸಲು ಆರಂಭಿಸಲು "
"ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ. ಅಥವಾ ನಂತರ."

msgid "The codecs are removed. Restart to finish."
msgstr "ಕೋಡೆಕ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ. ಪೂರ್ಣಗೊಳಿಸಲು ಮರುಪ್ರಾರಂಭಿಸಿ."

msgid "The codecs weren't removed."
msgstr "ಕೋಡೆಕ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿಲ್ಲ."

#, python-brace-format
msgid ""
"The computer didn't start properly with the boot options changed in "
"Wheelhouse, so it went back to the version from {since}, with the boot "
"options it had before."
msgstr ""
"Wheelhouse ನಲ್ಲಿ ಬದಲಾಯಿಸಿದ ಬೂಟ್ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಕಂಪ್ಯೂಟರ್ ಸರಿಯಾಗಿ "
"ಪ್ರಾರಂಭವಾಗಲಿಲ್ಲ, ಆದ್ದರಿಂದ ಅದು ಮೊದಲಿದ್ದ ಬೂಟ್ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಹಿಂದಿನ ಆವೃತ್ತಿಗೆ "
"({since}) ಹಿಂತಿರುಗಿತು."

msgid ""
"The computer hasn't saved a copy of its settings since this start yet. Wait a"
" few minutes and try again. If it keeps saying this, tell your helper: the "
"copy isn't being saved."
msgstr ""
"ಈ ಪ್ರಾರಂಭದ ನಂತರ ಕಂಪ್ಯೂಟರ್ ಇನ್ನೂ ತನ್ನ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ನಕಲನ್ನು ಉಳಿಸಿಲ್ಲ. ಕೆಲವು "
"ನಿಮಿಷ ಕಾಯಿರಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ. ಇದು ಹೀಗೆಯೇ ಹೇಳುತ್ತಿದ್ದರೆ, ನಿಮ್ಮ "
"ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ: ನಕಲನ್ನು ಉಳಿಸಲಾಗುತ್ತಿಲ್ಲ."

msgid "The computer locks up"
msgstr "ಕಂಪ್ಯೂಟರ್ ಫ್ರೀಜ್ ಆಗುತ್ತದೆ"

msgid ""
"The computer may not start, or may lose its drive, memory or processors."
msgstr ""
"ಕಂಪ್ಯೂಟರ್ ಸರಿಯಾಗಿ ಆರಂಭವಾಗದೇ ಇರಬಹುದು, ಅಥವಾ ಅದು ತನ್ನ ಡ್ರೈವ್, ಮೆಮೊರಿ ಅಥವಾ "
"ಪ್ರೊಸೆಸರ್‌ಗಳನ್ನು ಕಳೆದುಕೊಳ್ಳಬಹುದು."

msgid ""
"The computer restarts and opens its BIOS settings screen. Save your work first.\n"
"\n"
"The BIOS settings are used with the keyboard. When you're done, choose Save and Exit, or Exit, to start the computer again."
msgstr ""
"ಕಂಪ್ಯೂಟರ್ ಮರುಪ್ರಾರಂಭವಾಗಿ ಅದರ BIOS ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಪರದೆಯನ್ನು ತೆರೆಯುತ್ತದೆ. ಮೊದಲು ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಸೇವ್ ಮಾಡಿ.\n"
"\n"
"BIOS ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಕೀಬೋರ್ಡ್ ಮೂಲಕ ಬಳಸಲಾಗುತ್ತದೆ. ನೀವು ಮುಗಿಸಿದಾಗ, ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಲು \"Save and Exit\" ಅಥವಾ \"Exit\" ಆಯ್ಕೆಮಾಡಿ."

msgid ""
"The computer restarts, fails on purpose, then goes back by itself. A note at "
"login says the test worked and what the test copy found broken."
msgstr ""
"ಕಂಪ್ಯೂಟರ್ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಉದ್ದೇಶಪೂರ್ವಕವಾಗಿ ವಿಫಲವಾಗುತ್ತದೆ, ನಂತರ ತಾನಾಗಿಯೇ "
"ಹಿಂತಿರುಗುತ್ತದೆ. ಪರೀಕ್ಷೆ ಯಶಸ್ವಿಯಾಯಿತು ಮತ್ತು ಪರೀಕ್ಷಾ ನಕಲಿನಲ್ಲಿ ಏನು ಕೆಟ್ಟಿತ್ತು "
"ಎಂದು ಲಾಗಿನ್‌ನಲ್ಲಿ ಒಂದು ಟಿಪ್ಪಣಿ ತಿಳಿಸುತ್ತದೆ."

msgid "The computer starts with the usual settings."
msgstr "ಕಂಪ್ಯೂಟರ್ ಸಾಮಾನ್ಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳೊಂದಿಗೆ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

msgid ""
"The computer would start without the desktop: a text screen or a rescue "
"shell."
msgstr ""
"ಕಂಪ್ಯೂಟರ್ ಡೆಸ್ಕ್‌ಟಾಪ್ ಇಲ್ಲದೆ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ: ಪಠ್ಯ ಪರದೆ ಅಥವಾ ರೆಸ್ಕ್ಯೂ ಶೆಲ್."

msgid "The desktop"
msgstr "ಡೆಸ್ಕ್‌ಟಾಪ್"

#, python-brace-format
msgid ""
"The device rule wasn't added, so the device may not work.\n"
"\n"
"{details}"
msgstr ""
"ಸಾಧನದ ನಿಯಮವನ್ನು ಸೇರಿಸಲಾಗಿಲ್ಲ, ಆದ್ದರಿಂದ ಸಾಧನವು ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು.\n"
"\n"
"{details}"

#, python-brace-format
msgid ""
"The device rule wasn't added, so the device may not work.\n"
"{details}"
msgstr ""
"ಸಾಧನದ ನಿಯಮವನ್ನು ಸೇರಿಸಲಾಗಿಲ್ಲ, ಆದ್ದರಿಂದ ಸಾಧನವು ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು.\n"
"{details}"

msgid "The disk is full. Free some space, then try again."
msgstr "ಡಿಸ್ಕ್ ತುಂಬಿದೆ. ಸ್ವಲ್ಪ ಸ್ಥಳಾವಕಾಶ ಮಾಡಿಕೊಳ್ಳಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

msgid "The disk is hidden by a BIOS setting."
msgstr "BIOS ಸೆಟ್ಟಿಂಗ್‌ನಿಂದ ಡಿಸ್ಕ್ ಅನ್ನು ಮರೆಮಾಡಲಾಗಿದೆ."

#, python-brace-format
msgid "The disk {disk} was not found, or can't be written to."
msgstr "ಡಿಸ್ಕ್ {disk} ಕಂಡುಬಂದಿಲ್ಲ, ಅಥವಾ ಅದಕ್ಕೆ ಬರೆಯಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ."

#, python-brace-format
msgid ""
"The download source stays. Open {filename} again to pick an app, or remove it"
" in Wheelhouse, Apps, Remove apps."
msgstr ""
"ಡೌನ್‌ಲೋಡ್ ಮೂಲವು ಹಾಗೆಯೇ ಉಳಿಯುತ್ತದೆ. ಆ್ಯಪ್ ಆಯ್ಕೆಮಾಡಲು {filename} ಅನ್ನು ಮತ್ತೆ "
"ತೆರೆಯಿರಿ, ಅಥವಾ ಅದನ್ನು Wheelhouse, ಆ್ಯಪ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿ ಎಂಬಲ್ಲಿ "
"ತೆಗೆದುಹಾಕಿ."

#, python-brace-format
msgid ""
"The download source was added, but it has no apps to show right now. Check "
"your internet connection, then open {filename} again."
msgstr ""
"ಡೌನ್‌ಲೋಡ್ ಮೂಲವನ್ನು ಸೇರಿಸಲಾಗಿದೆ, ಆದರೆ ಇದೀಗ ತೋರಿಸಲು ಯಾವುದೇ ಆ್ಯಪ್‌ಗಳಿಲ್ಲ. ನಿಮ್ಮ "
"ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ, ನಂತರ {filename} ಅನ್ನು ಮತ್ತೆ ತೆರೆಯಿರಿ."

msgid ""
"The earlier version doesn't have the settings repair yet, so if the repair "
"didn't work, going back to it would give a wrong message. Run the test after "
"the next update."
msgstr ""
"ಹಿಂದಿನ ಆವೃತ್ತಿಯಲ್ಲಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ದುರಸ್ತಿ ಇನ್ನೂ ಇಲ್ಲ. ಆದ್ದರಿಂದ, ದುರಸ್ತಿ ಕೆಲಸ "
"ಮಾಡದಿದ್ದರೆ, ಅದಕ್ಕೆ ಹಿಂತಿರುಗಿದಲ್ಲಿ ತಪ್ಪಾದ ಸಂದೇಶವು ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ. ಮುಂದಿನ "
"ಅಪ್‌ಡೇಟ್‌ನ ನಂತರ ಪರೀಕ್ಷೆಯನ್ನು ನಡೆಸಿ."

#, python-brace-format
msgid "The file could not be written: {error}."
msgstr "ಫೈಲ್ ಅನ್ನು ಬರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: {error}."

msgid "The fingerprint reader"
msgstr "ಫಿಂಗರ್‌ಪ್ರಿಂಟ್ ರೀಡರ್"

msgid "The firewall"
msgstr "ಫೈರ್‌ವಾಲ್"

msgid "The firewall didn't reload."
msgstr "ಫೈರ್‌ವಾಲ್ ಮರುಲೋಡ್ ಆಗಲಿಲ್ಲ."

#, python-brace-format
msgid "The firewall didn't take the change: {reason}"
msgstr "ಫೈರ್‌ವಾಲ್ ಬದಲಾವಣೆಯನ್ನು ಸ್ವೀಕರಿಸಲಿಲ್ಲ: {reason}"

msgid "The firewall doesn't start"
msgstr "ಫೈರ್‌ವಾಲ್ ಆರಂಭವಾಗುತ್ತಿಲ್ಲ"

msgid ""
"The firewall fails to start, so during the test the computer has no firewall."
msgstr ""
"ಫೈರ್‌ವಾಲ್ ಪ್ರಾರಂಭವಾಗುತ್ತಿಲ್ಲ, ಆದ್ದರಿಂದ ಪರೀಕ್ಷೆಯ ಸಮಯದಲ್ಲಿ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ "
"ಫೈರ್‌ವಾಲ್ ಇಲ್ಲ."

msgid "The firewall isn't answering"
msgstr "ಫೈರ್‌ವಾಲ್ ಪ್ರತಿಕ್ರಿಯಿಸುತ್ತಿಲ್ಲ"

msgid "The firmware update didn't finish. Try again later."
msgstr ""
"ಫರ್ಮ್‌ವೇರ್ ಅಪ್‌ಡೇಟ್ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ. ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

msgid "The firmware updater"
msgstr "ಫರ್ಮ್‌ವೇರ್ ಅಪ್‌ಡೇಟರ್"

msgid ""
"The first meeting asks whether to install Chrome or use your usual browser."
msgstr ""
"ಮೊದಲ ಮೀಟಿಂಗ್, Chrome ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಬೇಕೇ ಅಥವಾ ನಿಮ್ಮ ಸಾಮಾನ್ಯ ಬ್ರೌಸರ್ "
"ಬಳಸಬೇಕೇ ಎಂದು ಕೇಳುತ್ತದೆ."

msgid ""
"The first time, choose Install Chrome or Use the usual browser. The meeting "
"opens in Zoom's web version."
msgstr ""
"ಮೊದಲ ಬಾರಿಗೆ, \"Chrome ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ಅಥವಾ \"ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ಬಳಸುವ "
"ಬ್ರೌಸರ್ ಬಳಸಿ\" ಆಯ್ಕೆಮಾಡಿ. ಮೀಟಿಂಗ್ Zoom ನ ವೆಬ್ ಆವೃತ್ತಿಯಲ್ಲಿ ತೆರೆಯುತ್ತದೆ."

msgid "The full codecs are already installed. Restart if you have not yet."
msgstr ""
"ಪೂರ್ಣ ಕೋಡೆಕ್‌ಗಳನ್ನು ಈಗಾಗಲೇ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ. ನೀವು ಇನ್ನೂ "
"ಮರುಪ್ರಾರಂಭಿಸಿಲ್ಲದಿದ್ದರೆ, ಮರುಪ್ರಾರಂಭಿಸಿ."

msgid "The full guide"
msgstr "ಸಂಪೂರ್ಣ ಮಾರ್ಗದರ್ಶಿ"

msgid "The full name is empty."
msgstr "ಪೂರ್ಣ ಹೆಸರು ಖಾಲಿಯಾಗಿದೆ."

msgid ""
"The graphics driver is blocked, so the screen runs in a basic mode: it may "
"look blurry or slow, or stay black (then just wait)."
msgstr ""
"ಗ್ರಾಫಿಕ್ಸ್ ಡ್ರೈವರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಪರದೆಯು ಮೂಲಭೂತ ಮೋಡ್‌ನಲ್ಲಿ "
"ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ: ಅದು ಮಸುಕಾಗಿ ಅಥವಾ ನಿಧಾನವಾಗಿ ಕಾಣಿಸಬಹುದು, ಅಥವಾ ಕಪ್ಪು "
"ಬಣ್ಣದಲ್ಲಿಯೇ ಉಳಿಯಬಹುದು (ಅಂತಹ ಸಂದರ್ಭದಲ್ಲಿ, ಸ್ವಲ್ಪ ಸಮಯ ಕಾಯಿರಿ)."

msgid "The install could not be finished."
msgstr "ಇನ್‌ಸ್ಟಾಲ್ ಅನ್ನು ಪೂರ್ಣಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "The install stopped"
msgstr "ಇನ್‌ಸ್ಟಾಲ್ ನಿಂತುಹೋಯಿತು"

#, python-brace-format
msgid "The installer could not start: {error}"
msgstr "ಇನ್‌ಸ್ಟಾಲರ್ ಅನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: {error}"

msgid "The installer couldn't open. Use Install EvenKeelOS in the dock."
msgstr ""
"ಇನ್‌ಸ್ಟಾಲರ್ ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಡಾಕ್‌ನಲ್ಲಿರುವ \"EvenKeelOS ಅನ್ನು "
"ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ಬಳಸಿ."

msgid "The installer stopped unexpectedly."
msgstr "ಇನ್‌ಸ್ಟಾಲರ್ ಅನಿರೀಕ್ಷಿತವಾಗಿ ನಿಂತುಹೋಯಿತು."

#, python-brace-format
msgid "The keyboard ({device})"
msgstr "ಕೀಬೋರ್ಡ್ ({device})"

msgid "The last lines of the log:"
msgstr "ಲಾಗ್‌ನ ಕೊನೆಯ ಸಾಲುಗಳು:"

#, python-brace-format
msgid ""
"The last start failed its start-up checks, and some system settings were missing or replaced. Your computer put back {n} from the copy it saved {saved}, then restarted. Your files and apps aren't touched.\n"
"\n"
"Put back: {what}.\n"
"\n"
"If it happens again, tell your helper. Save problem details in Wheelhouse makes a file to send them."
msgid_plural ""
"The last start failed its start-up checks, and some system settings were missing or replaced. Your computer put back {n} from the copy it saved {saved}, then restarted. Your files and apps aren't touched.\n"
"\n"
"Put back: {what}.\n"
"\n"
"If it happens again, tell your helper. Save problem details in Wheelhouse makes a file to send them."
msgstr[0] ""
"ಕೊನೆಯ ಪ್ರಾರಂಭವು ತನ್ನ ಪ್ರಾರಂಭದ ಪರಿಶೀಲನೆಗಳಲ್ಲಿ ವಿಫಲವಾಯಿತು, ಮತ್ತು ಕೆಲವು ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಕಾಣೆಯಾಗಿದ್ದವು ಅಥವಾ ಬದಲಾಗಿದ್ದವು. ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ {saved} ಉಳಿಸಿದ್ದ ನಕಲಿನಿಂದ {n} ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಮರಳಿ ಇರಿಸಿ, ನಂತರ ಮರುಪ್ರಾರಂಭವಾಯಿತು. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳಿಗೆ ಏನೂ ಆಗಿಲ್ಲ.\n"
"\n"
"ಮರಳಿ ಇರಿಸಿದವು: {what}.\n"
"\n"
"ಇದು ಮತ್ತೆ ಆದರೆ, ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ. Wheelhouse ನಲ್ಲಿರುವ \"ಸಮಸ್ಯೆಯ ವಿವರಗಳನ್ನು ಉಳಿಸಿ\" ಅವುಗಳನ್ನು ಕಳುಹಿಸಲು ಒಂದು ಫೈಲ್ ರಚಿಸುತ್ತದೆ."
msgstr[1] ""
"ಕೊನೆಯ ಪ್ರಾರಂಭವು ತನ್ನ ಪ್ರಾರಂಭದ ಪರಿಶೀಲನೆಗಳಲ್ಲಿ ವಿಫಲವಾಯಿತು, ಮತ್ತು ಕೆಲವು ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಕಾಣೆಯಾಗಿದ್ದವು ಅಥವಾ ಬದಲಾಗಿದ್ದವು. ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ {saved} ಉಳಿಸಿದ್ದ ನಕಲಿನಿಂದ {n} ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರಳಿ ಇರಿಸಿ, ನಂತರ ಮರುಪ್ರಾರಂಭವಾಯಿತು. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳಿಗೆ ಏನೂ ಆಗಿಲ್ಲ.\n"
"\n"
"ಮರಳಿ ಇರಿಸಿದವು: {what}.\n"
"\n"
"ಇದು ಮತ್ತೆ ಆದರೆ, ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ. Wheelhouse ನಲ್ಲಿರುವ \"ಸಮಸ್ಯೆಯ ವಿವರಗಳನ್ನು ಉಳಿಸಿ\" ಅವುಗಳನ್ನು ಕಳುಹಿಸಲು ಒಂದು ಫೈಲ್ ರಚಿಸುತ್ತದೆ."

msgid "The layout didn't change."
msgstr "ಲೇಔಟ್ ಬದಲಾಗಿಲ್ಲ."

msgid ""
"The layout, colors, wallpaper, dark at night, fonts, screen size, night "
"light, sound and accounts"
msgstr ""
"ಲೇಔಟ್, ಬಣ್ಣಗಳು, ವಾಲ್‌ಪೇಪರ್, ರಾತ್ರಿಯಲ್ಲಿ ಡಾರ್ಕ್, ಫಾಂಟ್‌ಗಳು, ಪರದೆಯ ಗಾತ್ರ, Night"
" Light, ಧ್ವನಿ ಮತ್ತು ಖಾತೆಗಳು"

msgid "The login screen doesn't start"
msgstr "ಲಾಗಿನ್ ಪರದೆ ಪ್ರಾರಂಭವಾಗುವುದಿಲ್ಲ"

msgid ""
"The login screen fails to start, so you never see it. The computer restarts "
"by itself within seconds, twice, and the third start is back on this version."
msgstr ""
"ಲಾಗಿನ್ ಪರದೆ ಪ್ರಾರಂಭವಾಗುವುದಿಲ್ಲ, ಆದ್ದರಿಂದ ಅದು ನಿಮಗೆ ಕಾಣಿಸುವುದೇ ಇಲ್ಲ. ಕಂಪ್ಯೂಟರ್"
" ಕೆಲವೇ ಸೆಕೆಂಡುಗಳಲ್ಲಿ ತಾನಾಗಿಯೇ ಎರಡು ಬಾರಿ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಮತ್ತು ಮೂರನೇ "
"ಪ್ರಾರಂಭವು ಮತ್ತೆ ಈ ಆವೃತ್ತಿಯಲ್ಲಿ ಆಗುತ್ತದೆ."

msgid ""
"The login screen works, but logging in drops you back to it. Log in a second "
"time; after the second drop the computer restarts by itself. Do that on 2 "
"starts, and the third start is back on this version."
msgstr ""
"ಲಾಗಿನ್ ಪರದೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ, ಆದರೆ ಲಾಗ್ ಇನ್ ಮಾಡಿದಾಗ ನಿಮ್ಮನ್ನು ಮತ್ತೆ ಅದಕ್ಕೇ "
"ಹಿಂತಿರುಗಿಸುತ್ತದೆ. ಎರಡನೇ ಬಾರಿ ಲಾಗ್ ಇನ್ ಮಾಡಿ; ಎರಡನೇ ಬಾರಿ ಹಿಂತಿರುಗಿದ ನಂತರ "
"ಕಂಪ್ಯೂಟರ್ ತಾನಾಗಿಯೇ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ಇದನ್ನು 2 ಪ್ರಾರಂಭಗಳಲ್ಲಿ ಮಾಡಿ, ಮತ್ತು "
"ಮೂರನೇ ಪ್ರಾರಂಭವು ಮತ್ತೆ ಈ ಆವೃತ್ತಿಯಲ್ಲಿ ಆಗುತ್ತದೆ."

msgid "The media codecs start working after a restart."
msgstr "ಮರುಪ್ರಾರಂಭಿಸಿದ ನಂತರ ಮೀಡಿಯಾ ಕೋಡೆಕ್‌ಗಳು ಕೆಲಸ ಮಾಡಲು ಪ್ರಾರಂಭಿಸುತ್ತವೆ."

msgid ""
"The menu that opens has Wi-Fi, Bluetooth, the sound volume, the screen "
"brightness, the power mode, dark style and night light."
msgstr ""
"ತೆರೆಯುವ ಮೆನುವಿನಲ್ಲಿ Wi-Fi, ಬ್ಲೂಟೂತ್, ಧ್ವನಿ ಪ್ರಮಾಣ, ಪರದೆಯ ಪ್ರಕಾಶ, ಪವರ್ ಮೋಡ್, "
"ಡಾರ್ಕ್ ಶೈಲಿ ಮತ್ತು Night Light ಇರುತ್ತವೆ."

msgid "The new files could not be labelled."
msgstr "ಹೊಸ ಫೈಲ್‌ಗಳಿಗೆ ಲೇಬಲ್ ಹಾಕಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "The new partitions did not show up."
msgstr "ಹೊಸ ಪಾರ್ಟಿಷನ್‌ಗಳು ಕಾಣಿಸಲಿಲ್ಲ."

msgid "The new system could not be set to take signed updates."
msgstr ""
"ಹೊಸ ಸಿಸ್ಟಂ ಅನ್ನು ಸಹಿ ಮಾಡಲಾದ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಸ್ವೀಕರಿಸುವಂತೆ ಹೊಂದಿಸಲು "
"ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#, python-brace-format
msgid "The new system has no {name} group."
msgstr "ಹೊಸ ಸಿಸ್ಟಂನಲ್ಲಿ {name} ಗುಂಪು ಇಲ್ಲ."

msgid "The new system's desktop layouts could not be found."
msgstr "ಹೊಸ ಸಿಸ್ಟಂನ ಡೆಸ್ಕ್‌ಟಾಪ್ ಲೇಔಟ್‌ಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲಾಗಲಿಲ್ಲ."

msgid "The new system's settings database could not be found."
msgstr "ಹೊಸ ಸಿಸ್ಟಂನ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಡೇಟಾಬೇಸ್ ಕಂಡುಬರಲಿಲ್ಲ."

msgid "The next network you join starts as a Public place."
msgstr "ನೀವು ಸೇರುವ ಮುಂದಿನ ನೆಟ್‌ವರ್ಕ್ ಸಾರ್ವಜನಿಕ ಸ್ಥಳವಾಗಿ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

#, python-brace-format
msgid "The next start uses: {settings}"
msgstr "ಮುಂದಿನ ಪ್ರಾರಂಭವು ಇದನ್ನು ಬಳಸುತ್ತದೆ: {settings}"

msgid "The one-time setup window is already closed."
msgstr "ಒಂದು-ಬಾರಿ ಸೆಟಪ್ ವಿಂಡೋ ಈಗಾಗಲೇ ಮುಚ್ಚಲಾಗಿದೆ."

msgid "The password is typed and matches."
msgstr "ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಟೈಪ್ ಮಾಡಲಾಗಿದೆ ಮತ್ತು ಅದು ಹೊಂದಿಕೆಯಾಗುತ್ತದೆ."

#, python-brace-format
msgid "The password wasn't saved: {reason}"
msgstr "ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ: {reason}"

msgid ""
"The picture is copied, ready to paste, and saved in Pictures, Screenshots."
msgstr ""
"ಚಿತ್ರವನ್ನು ನಕಲಿಸಲಾಗಿದೆ, ಅಂಟಿಸಲು ಸಿದ್ಧವಾಗಿದೆ, ಮತ್ತು ಚಿತ್ರಗಳು, ತೆರೆಚಿತ್ರಗಳು "
"ಇಲ್ಲಿ ಉಳಿಸಲಾಗಿದೆ."

msgid ""
"The power button in that menu has Suspend, Restart, Power Off and Log Out."
msgstr ""
"ಆ ಮೆನುವಿನಲ್ಲಿರುವ ಪವರ್ ಬಟನ್‌ನಲ್ಲಿ ಅಮಾನತ್ತಿನಲ್ಲಿಡು, ಮರಳಿ ಆರಂಭಿಸು, ಸ್ಥಗಿತಗೊಳಿಸು "
"ಮತ್ತು ನಿರ್ಗಮಿಸು ಇವೆ."

#, python-brace-format
msgid "The printer driver {title} is ready."
msgstr "ಪ್ರಿಂಟರ್ ಡ್ರೈವರ್ {title} ಸಿದ್ಧವಾಗಿದೆ."

#, python-brace-format
msgid ""
"The printer driver {title} is ready.\n"
"\n"
"Open Printers: choose Add Printer, then your printer."
msgstr ""
"ಪ್ರಿಂಟರ್ ಡ್ರೈವರ್ {title} ಸಿದ್ಧವಾಗಿದೆ.\n"
"\n"
"ಮುದ್ರಕಗಳು ತೆರೆಯಿರಿ: \"ಮುದ್ರಕವನ್ನು ಸೇರಿಸಿ\" ಆಯ್ಕೆಮಾಡಿ, ನಂತರ ನಿಮ್ಮ ಪ್ರಿಂಟರ್."

msgid "The printing service fails to start."
msgstr "ಪ್ರಿಂಟಿಂಗ್ ಸೇವೆಯು ಪ್ರಾರಂಭವಾಗುತ್ತಿಲ್ಲ."

msgid "The restart didn't start"
msgstr "ಮರುಪ್ರಾರಂಭವು ಆರಂಭವಾಗಲಿಲ್ಲ"

#, python-brace-format
msgid ""
"The restart said:\n"
"\n"
"{message}\n"
"\n"
"Exit code: {code}"
msgstr ""
"ಮರುಪ್ರಾರಂಭವು ಹೀಗೆ ಹೇಳಿತು:\n"
"\n"
"{message}\n"
"\n"
"ನಿರ್ಗಮನ ಕೋಡ್: {code}"

msgid ""
"The root account is the system's own administrator. Most people never need "
"it: your own account can be an administrator instead."
msgstr ""
"ರೂಟ್ ಖಾತೆ ಸಿಸ್ಟಂನ ಸ್ವಂತ ನಿರ್ವಾಹಕ ಖಾತೆ. ಹೆಚ್ಚಿನವರಿಗೆ ಇದು ಎಂದಿಗೂ ಬೇಕಾಗುವುದಿಲ್ಲ:"
" ಬದಲಿಗೆ ನಿಮ್ಮ ಸ್ವಂತ ಖಾತೆಯೇ ನಿರ್ವಾಹಕ ಆಗಿರಬಹುದು."

msgid "The root password could not be set."
msgstr "ರೂಟ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಹೊಂದಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "The screen flashes white, often with an outside display"
msgstr "ಪರದೆ ಬಿಳಿಯಾಗಿ ಮಿನುಗುತ್ತದೆ, ಹೆಚ್ಚಾಗಿ ಬಾಹ್ಯ ಡಿಸ್‌ಪ್ಲೇ ಸಂಪರ್ಕಿಸಿದಾಗ"

msgid ""
"The settings are deleted, but the computer didn't restart. Restart it now: "
"the next start puts them back."
msgstr ""
"ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅಳಿಸಲಾಗಿದೆ, ಆದರೆ ಕಂಪ್ಯೂಟರ್ ಮರುಪ್ರಾರಂಭವಾಗಲಿಲ್ಲ. ಇದನ್ನು ಈಗ "
"ಮರುಪ್ರಾರಂಭಿಸಿ: ಮುಂದಿನ ಪ್ರಾರಂಭದಲ್ಲಿ ಅವುಗಳನ್ನು ಮರಳಿ ಇರಿಸಲಾಗುತ್ತದೆ."

msgid "The settings repair test didn't work."
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳ ದುರಸ್ತಿ ಪರೀಕ್ಷೆ ಕೆಲಸ ಮಾಡಲಿಲ್ಲ."

#, python-brace-format
msgid ""
"The settings repair test didn't work: your computer couldn't put the deleted settings back, so it went back to the version from {since}, which has its own settings. Your files and apps aren't touched, and automatic updates aren't paused.\n"
"\n"
"Tell your helper. Save problem details in Wheelhouse makes a file to send them."
msgstr ""
"ಸೆಟ್ಟಿಂಗ್‌ಗಳ ದುರಸ್ತಿ ಪರೀಕ್ಷೆ ಕೆಲಸ ಮಾಡಲಿಲ್ಲ: ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಅಳಿಸಿದ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರಳಿ ಇರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಆದ್ದರಿಂದ ಅದು ಹಿಂದಿನ ಆವೃತ್ತಿಗೆ ({since}) ಹಿಂತಿರುಗಿತು, ಅದಕ್ಕೆ ತನ್ನದೇ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿವೆ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳಿಗೆ ಏನೂ ಆಗಿಲ್ಲ, ಮತ್ತು ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ವಿರಾಮಗೊಂಡಿಲ್ಲ.\n"
"\n"
"ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ತಿಳಿಸಿ. Wheelhouse ನಲ್ಲಿರುವ \"ಸಮಸ್ಯೆಯ ವಿವರಗಳನ್ನು ಉಳಿಸಿ\" ಅವುಗಳನ್ನು ಕಳುಹಿಸಲು ಒಂದು ಫೈಲ್ ರಚಿಸುತ್ತದೆ."

msgid "The settings repair test worked."
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳ ದುರಸ್ತಿ ಪರೀಕ್ಷೆ ಯಶಸ್ವಿಯಾಗಿದೆ."

msgid "The sound chip's driver is blocked, so there's no sound."
msgstr "ಧ್ವನಿ ಚಿಪ್‌ನ ಡ್ರೈವರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಧ್ವನಿ ಇಲ್ಲ."

msgid ""
"The start menu, windows, the menu at the end of the bar, notifications, "
"screenshots and shortcuts"
msgstr ""
"ಸ್ಟಾರ್ಟ್ ಮೆನು, ವಿಂಡೋಗಳು, ಪಟ್ಟಿಯ ಕೊನೆಯಲ್ಲಿರುವ ಮೆನು, ಅಧಿಸೂಚನೆಗಳು, "
"ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳು ಮತ್ತು ಶಾರ್ಟ್‌ಕಟ್‌ಗಳು"

msgid "The sun doesn't set or rise here today, so it's dark until it rises."
msgstr ""
"ಇಂದು ಇಲ್ಲಿ ಸೂರ್ಯ ಮುಳುಗುವುದೂ ಇಲ್ಲ, ಉದಯಿಸುವುದೂ ಇಲ್ಲ, ಆದ್ದರಿಂದ ಉದಯಿಸುವವರೆಗೆ "
"ಡಾರ್ಕ್ ಇರುತ್ತದೆ."

msgid "The sun doesn't set or rise here today, so it's light until it sets."
msgstr ""
"ಇಂದು ಇಲ್ಲಿ ಸೂರ್ಯ ಮುಳುಗುವುದೂ ಇಲ್ಲ, ಉದಯಿಸುವುದೂ ಇಲ್ಲ, ಆದ್ದರಿಂದ ಮುಳುಗುವವರೆಗೆ ಲೈಟ್"
" ಇರುತ್ತದೆ."

msgid "The system core crashed (a protection fault)"
msgstr "ಸಿಸ್ಟಂ ಕೋರ್ ಕ್ರ್ಯಾಶ್ ಆಯಿತು (ರಕ್ಷಣಾ ದೋಷ)"

msgid "The system core crashed (an oops)"
msgstr "ಸಿಸ್ಟಂ ಕೋರ್ ಕ್ರ್ಯಾಶ್ ಆಯಿತು (ಒಂದು oops)"

msgid "The system core reported a bug"
msgstr "ಸಿಸ್ಟಂ ಕೋರ್ ಒಂದು ದೋಷವನ್ನು ವರದಿ ಮಾಡಿದೆ"

msgid ""
"The system itself can't be changed by apps or by mistake. Each update "
"replaces it whole."
msgstr ""
"ಸಿಸ್ಟಂ ಅನ್ನು ಸ್ವತಃ ಆ್ಯಪ್‌ಗಳು ಅಥವಾ ತಪ್ಪಿನಿಂದ ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಪ್ರತಿ "
"ಅಪ್‌ಡೇಟ್ ಅದನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಬದಲಾಯಿಸುತ್ತದೆ."

#, python-brace-format
msgid "The test copy ({name}) is ready. It starts at your next restart."
msgstr ""
"ಪರೀಕ್ಷಾ ನಕಲು ({name}) ಸಿದ್ಧವಾಗಿದೆ. ನೀವು ಮುಂದಿನ ಬಾರಿ ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ಅದು "
"ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

msgid ""
"The test marker is removed. The version without it starts at your next "
"restart."
msgstr ""
"ಪರೀಕ್ಷಾ ಗುರುತು ತೆಗೆದುಹಾಕಲಾಗಿದೆ. ಅದು ಇಲ್ಲದ ಆವೃತ್ತಿಯು ನಿಮ್ಮ ಮುಂದಿನ "
"ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

#, python-brace-format
msgid ""
"The test worked. At the next start your computer found important settings missing, put back {n} setting from the copy it saved {saved}, and restarted by itself.\n"
"\n"
"Put back: {what}."
msgid_plural ""
"The test worked. At the next start your computer found important settings missing, put back {n} settings from the copy it saved {saved}, and restarted by itself.\n"
"\n"
"Put back: {what}."
msgstr[0] ""
"ಪರೀಕ್ಷೆ ಯಶಸ್ವಿಯಾಯಿತು. ಮುಂದಿನ ಪ್ರಾರಂಭದಲ್ಲಿ ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಪ್ರಮುಖ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಕಾಣೆಯಾಗಿರುವುದನ್ನು ಕಂಡು, {saved} ಉಳಿಸಿದ್ದ ನಕಲಿನಿಂದ {n} ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಮರಳಿ ಇರಿಸಿ, ತಾನಾಗಿಯೇ ಮರುಪ್ರಾರಂಭವಾಯಿತು.\n"
"\n"
"ಮರಳಿ ಇರಿಸಿದವು: {what}."
msgstr[1] ""
"ಪರೀಕ್ಷೆ ಯಶಸ್ವಿಯಾಯಿತು. ಮುಂದಿನ ಪ್ರಾರಂಭದಲ್ಲಿ ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಪ್ರಮುಖ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಕಾಣೆಯಾಗಿರುವುದನ್ನು ಕಂಡು, {saved} ಉಳಿಸಿದ್ದ ನಕಲಿನಿಂದ {n} ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರಳಿ ಇರಿಸಿ, ತಾನಾಗಿಯೇ ಮರುಪ್ರಾರಂಭವಾಯಿತು.\n"
"\n"
"ಮರಳಿ ಇರಿಸಿದವು: {what}."

#, python-brace-format
msgid ""
"The test worked. Your computer went back by itself to the version from "
"{since}, and the test copy is removed."
msgstr ""
"ಪರೀಕ್ಷೆ ಯಶಸ್ವಿಯಾಯಿತು. ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ತಾನಾಗಿಯೇ ಹಿಂದಿನ ಆವೃತ್ತಿಗೆ ({since}) "
"ಹಿಂತಿರುಗಿತು, ಮತ್ತು ಪರೀಕ್ಷಾ ನಕಲನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ."

#, python-brace-format
msgid "The touchpad ({device})"
msgstr "ಟಚ್‌ಪ್ಯಾಡ್ ({device})"

msgid "The two don't match yet."
msgstr "ಈ ಎರಡೂ ಇನ್ನೂ ಹೊಂದಿಕೆಯಾಗಿಲ್ಲ."

msgid "The update did not finish. Details: journalctl -u %s"
msgstr "ಅಪ್‌ಡೇಟ್ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ. ವಿವರಗಳು: journalctl -u %s"

msgid "The update didn't finish."
msgstr "ಅಪ್‌ಡೇಟ್ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ."

msgid ""
"The update didn't finish. Nothing is broken: your computer keeps running the "
"version it has.\\n\\nTry again later."
msgstr ""
"ಅಪ್‌ಡೇಟ್ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ. ಏನೂ ಕೆಟ್ಟುಹೋಗಿಲ್ಲ: ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ತನ್ನಲ್ಲಿರುವ "
"ಆವೃತ್ತಿಯಲ್ಲೇ ನಡೆಯುತ್ತಿರುತ್ತದೆ.\\n\\nನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

msgid "The update program"
msgstr "ಅಪ್‌ಡೇಟ್ ಪ್ರೋಗ್ರಾಂ"

msgid ""
"The update program is swapped for one that always fails (until the next "
"restart; nothing on the disk changes)."
msgstr ""
"ಅಪ್‌ಡೇಟ್ ಪ್ರೋಗ್ರಾಂ ಅನ್ನು ಯಾವಾಗಲೂ ವಿಫಲಗೊಳ್ಳುವ ಇನ್ನೊಂದು ಪ್ರೋಗ್ರಾಂನೊಂದಿಗೆ "
"ಬದಲಾಯಿಸಲಾಗುತ್ತದೆ (ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದವರೆಗೆ; ಡಿಸ್ಕ್‌ನಲ್ಲಿ ಏನೂ ಬದಲಾಗುವುದಿಲ್ಲ)."

msgid "The user name is empty."
msgstr "ಬಳಕೆದಾರ ಹೆಸರು ಖಾಲಿ ಇದೆ."

#, python-brace-format
msgid ""
"The version you're using now is from {current}. The one from before it, from {older}, is still on this computer.\n"
"\n"
"If something stopped working after the last update: Undo the update. The version from {older} starts at your next restart. Your files and your apps aren't touched."
msgstr ""
"ನೀವು ಈಗ ಬಳಸುತ್ತಿರುವ ಆವೃತ್ತಿ: {current}. ಅದಕ್ಕಿಂತ ಹಿಂದಿನ ಆವೃತ್ತಿ ({older}) ಇನ್ನೂ ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿದೆ.\n"
"\n"
"ಕೊನೆಯ ಅಪ್‌ಡೇಟ್‌ನ ನಂತರ ಏನಾದರೂ ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿದ್ದರೆ: ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಿ. ಆ ಆವೃತ್ತಿ ({older}) ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳಿಗೆ ಏನೂ ಆಗುವುದಿಲ್ಲ."

msgid ""
"The version you're using now is the one before it with boot options changed in Wheelhouse.\n"
"\n"
"Undo the change: the computer starts with the boot options it had before, at your next restart. Automatic updates aren't paused.\n"
"\n"
"Or Cancel."
msgstr ""
"ನೀವು ಈಗ ಬಳಸುತ್ತಿರುವ ಆವೃತ್ತಿ, Wheelhouse ನಲ್ಲಿ ಬೂಟ್ ಆಯ್ಕೆಗಳನ್ನು ಬದಲಾಯಿಸಿದ ಹಿಂದಿನ ಆವೃತ್ತಿಯೇ ಆಗಿದೆ.\n"
"\n"
"ಬದಲಾವಣೆಯನ್ನು ರದ್ದುಗೊಳಿಸಿ: ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಕಂಪ್ಯೂಟರ್ ಮೊದಲಿದ್ದ ಬೂಟ್ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ವಿರಾಮಗೊಳ್ಳುವುದಿಲ್ಲ.\n"
"\n"
"ಅಥವಾ ರದ್ದುಗೊಳಿಸಿ."

msgid "The wallpaper changes to the next picture in a folder of yours."
msgstr "ವಾಲ್‌ಪೇಪರ್ ನಿಮ್ಮ ಫೋಲ್ಡರ್‌ನಲ್ಲಿರುವ ಮುಂದಿನ ಚಿತ್ರಕ್ಕೆ ಬದಲಾಗುತ್ತದೆ."

#, python-brace-format
msgid ""
"The {fs} file system could not be loaded, so the disk can't be prepared."
msgstr ""
"{fs} ಫೈಲ್ ಸಿಸ್ಟಂ ಅನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಆದ್ದರಿಂದ ಡಿಸ್ಕ್ ಅನ್ನು "
"ಸಿದ್ಧಪಡಿಸಲು ಆಗುತ್ತಿಲ್ಲ."

#, python-brace-format
msgid "The {label} is deleted."
msgstr "{label} ಅನ್ನು ಅಳಿಸಲಾಗಿದೆ."

#, python-brace-format
msgid "The {label} is not working."
msgstr "{label} ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಿಲ್ಲ."

#, python-brace-format
msgid "The {label} is repaired."
msgstr "{label} ಅನ್ನು ದುರಸ್ತಿ ಮಾಡಲಾಗಿದೆ."

#, python-brace-format
msgid ""
"The {label} isn't working.\n"
"\n"
"Recommended: Repair the box. It rebuilds the box, puts your apps back, then installs {title}. Your files aren't touched."
msgstr ""
"{label} ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ.\n"
"\n"
"ಶಿಫಾರಸು: ಬಾಕ್ಸ್ ಅನ್ನು ದುರಸ್ತಿ ಮಾಡಿ. ಇದು ಬಾಕ್ಸ್ ಅನ್ನು ಮರುನಿರ್ಮಿಸಿ, ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳನ್ನು ಮರಳಿ ಇರಿಸಿ, ನಂತರ {title} ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುತ್ತದೆ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳಿಗೆ ಏನೂ ಆಗುವುದಿಲ್ಲ."

#, python-brace-format
msgid "The {name} ({unit})"
msgstr "{name} ({unit})"

#, python-brace-format
msgid "The {name} graphics drive the screen."
msgstr "{name} ಗ್ರಾಫಿಕ್ಸ್ ಪರದೆಯನ್ನು ನಿಯಂತ್ರಿಸುತ್ತದೆ."

#, python-brace-format
msgid "The {name} service ({unit})"
msgstr "{name} ಸೇವೆ ({unit})"

#, python-brace-format
msgid "The {title} download isn't signed by ArtCraft, so it was not installed."
msgstr ""
"{title} ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ArtCraft ಸಹಿ ಮಾಡಿಲ್ಲ, ಆದ್ದರಿಂದ ಅದನ್ನು ಇನ್‌ಸ್ಟಾಲ್ "
"ಮಾಡಲಾಗಿಲ್ಲ."

msgid "There are no app boxes to repair."
msgstr "ದುರಸ್ತಿ ಮಾಡಬೇಕಾದ ಯಾವುದೇ ಆ್ಯಪ್ ಬಾಕ್ಸ್‌ಗಳಿಲ್ಲ."

#, python-brace-format
msgid "There is no start-up keyboard layout for {layout}."
msgstr "{layout} ಗಾಗಿ ಯಾವುದೇ ಆರಂಭಿಕ ಕೀಬೋರ್ಡ್ ಲೇಔಟ್ ಇಲ್ಲ."

msgid ""
"There's no earlier version on this computer to go back to. Only the version "
"you're using now is kept."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಹಿಂದಿನ ಯಾವುದೇ ಆವೃತ್ತಿ ಇಲ್ಲ, ಆದ್ದರಿಂದ ಅದಕ್ಕೆ ಹಿಂತಿರುಗಲು "
"ಸಾಧ್ಯವಿಲ್ಲ. ನೀವು ಈಗ ಬಳಸುತ್ತಿರುವ ಆವೃತ್ತಿಯನ್ನು ಮಾತ್ರ ಉಳಿಸಿಕೊಳ್ಳಲಾಗುತ್ತದೆ."

msgid ""
"There's no earlier version to fall back to if putting the settings back "
"doesn't work, so the test doesn't run. Try it after the next update."
msgstr ""
"ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರಳಿ ಇರಿಸುವುದು ಕೆಲಸ ಮಾಡದಿದ್ದಲ್ಲಿ ಹಿಂತಿರುಗಲು ಹಿಂದಿನ ಆವೃತ್ತಿ "
"ಇಲ್ಲ, ಆದ್ದರಿಂದ ಪರೀಕ್ಷೆ ನಡೆಯುವುದಿಲ್ಲ. ಮುಂದಿನ ಅಪ್‌ಡೇಟ್‌ನ ನಂತರ ಇದನ್ನು "
"ಪ್ರಯತ್ನಿಸಿ."

msgid "These security certificates need attention. Pick one to see what to do."
msgstr ""
"ಈ ಭದ್ರತಾ ಪ್ರಮಾಣಪತ್ರಗಳಿಗೆ ಗಮನ ನೀಡುವ ಅಗತ್ಯವಿದೆ. ಏನು ಮಾಡಬೇಕೆಂದು ನೋಡಲು ಒಂದನ್ನು "
"ಆಯ್ಕೆಮಾಡಿ."

msgid "They open in Chrome."
msgstr "ಅವು Chrome ನಲ್ಲಿ ತೆರೆಯುತ್ತವೆ."

msgid "They open in your usual browser. Choose to be asked about Chrome again."
msgstr ""
"ಅವುಗಳು ನಿಮ್ಮ ಸಾಮಾನ್ಯ ಬ್ರೌಸರ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತವೆ. Chrome ಕುರಿತು ಮತ್ತೆ ಕೇಳುವಂತೆ "
"ಆಯ್ಕೆಮಾಡಿ."

msgid "This account can't share folders."
msgstr "ಈ ಖಾತೆಯು ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ."

msgid ""
"This computer asks for the disk password every time it starts. The computer's security chip can unlock the disk instead.\n"
"\n"
"This needs the disk password, so it's one for your helper.\n"
"\n"
"Recommended: Set it up. Or Skip: it's in Wheelhouse any time."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾದ ಪ್ರತಿ ಬಾರಿಯೂ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಕೇಳುತ್ತದೆ. ಬದಲಿಗೆ ಕಂಪ್ಯೂಟರ್‌ನ ಭದ್ರತಾ ಚಿಪ್ ಡಿಸ್ಕ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಬಹುದು.\n"
"\n"
"ಇದಕ್ಕೆ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಬೇಕು, ಆದ್ದರಿಂದ ಇದು ನಿಮ್ಮ ಸಹಾಯಕರು ಮಾಡಬೇಕಾದ ಕೆಲಸ.\n"
"\n"
"ಶಿಫಾರಸು: ಇದನ್ನು ಸೆಟಪ್ ಮಾಡಿ. ಅಥವಾ ಬಿಟ್ಟುಬಿಡಿ: ಇದು ಯಾವಾಗ ಬೇಕಾದರೂ Wheelhouse ನಲ್ಲಿ ಇರುತ್ತದೆ."

msgid ""
"This computer can't go back by itself: it was installed before automatic "
"rollback was added, or automatic rollback was switched off. Computers "
"installed from a newer USB have it."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್ ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಹಿಂದಿರುಗಲು ಸಾಧ್ಯವಿಲ್ಲ: ಸ್ವಯಂಚಾಲಿತ ರೋಲ್‌ಬ್ಯಾಕ್ "
"ಅನ್ನು ಸೇರಿಸುವ ಮೊದಲು ಇದನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿತ್ತು, ಅಥವಾ ಸ್ವಯಂಚಾಲಿತ "
"ರೋಲ್‌ಬ್ಯಾಕ್ ಅನ್ನು ಆಫ್ ಮಾಡಲಾಗಿತ್ತು. ಹೊಸ USB ಯಿಂದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದ "
"ಕಂಪ್ಯೂಟರ್‌ಗಳಲ್ಲಿ ಅದು ಇರುತ್ತದೆ."

msgid ""
"This computer can't open its BIOS settings from here. Press the BIOS key "
"while it starts (often F2, F10, F12 or Delete)."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್ ಇಲ್ಲಿಂದ ತನ್ನ BIOS ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ. ಕಂಪ್ಯೂಟರ್ "
"ಪ್ರಾರಂಭವಾಗುತ್ತಿರುವಾಗ BIOS ಕೀಲಿಯನ್ನು ಒತ್ತಿರಿ (ಸಾಮಾನ್ಯವಾಗಿ F2, F10, F12 ಅಥವಾ "
"Delete)."

msgid ""
"This computer has no security chip (TPM) that can do this, so the disk "
"password stays."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಇದನ್ನು ಮಾಡಲು ಸಾಧ್ಯವಾಗುವಂತಹ ಭದ್ರತಾ ಚಿಪ್ (TPM) ಇಲ್ಲ, ಆದ್ದರಿಂದ"
" ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಹಾಗೆಯೇ ಉಳಿಯುತ್ತದೆ."

#, python-brace-format
msgid ""
"This computer is running a test copy ({name}) as its normal version, so a new test can't start from it.\n"
"\n"
"Recommended: Remove the test marker. The version without it starts at your next restart. Needs your password."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್ ತನ್ನ ಸಾಮಾನ್ಯ ಆವೃತ್ತಿಯಾಗಿ ಪರೀಕ್ಷಾ ನಕಲನ್ನು ({name}) ಚಲಾಯಿಸುತ್ತಿದೆ, ಆದ್ದರಿಂದ ಇದರಿಂದ ಹೊಸ ಪರೀಕ್ಷೆಯನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.\n"
"\n"
"ಶಿಫಾರಸು: ಪರೀಕ್ಷಾ ಗುರುತು ತೆಗೆದುಹಾಕಿ. ಅದು ಇಲ್ಲದ ಆವೃತ್ತಿಯು ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ನ ಅಗತ್ಯವಿದೆ."

msgid ""
"This computer is running a test copy. Open Test automatic rollback again to "
"remove its marker."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್ ಪರೀಕ್ಷಾ ನಕಲನ್ನು ಚಲಾಯಿಸುತ್ತಿದೆ. ಅದರ ಗುರುತನ್ನು ತೆಗೆದುಹಾಕಲು "
"\"ಸ್ವಯಂಚಾಲಿತ ರೋಲ್‌ಬ್ಯಾಕ್ ಅನ್ನು ಪರೀಕ್ಷಿಸಿ\" ಅನ್ನು ಮತ್ತೆ ತೆರೆಯಿರಿ."

msgid "This computer started the USB stick in old BIOS (legacy) mode."
msgstr ""
"ಈ ಕಂಪ್ಯೂಟರ್ USB ಸ್ಟಿಕ್ ಅನ್ನು ಹಳೆಯ BIOS (ಲೆಗಸಿ) ಮೋಡ್‌ನಲ್ಲಿ ಪ್ರಾರಂಭಿಸಿದೆ."

#, python-brace-format
msgid ""
"This desktop uses {now}.\n"
"\n"
"Switch to {new}? It takes effect after you log out and back in.\n"
"\n"
"Or Keep it."
msgstr ""
"ಈ ಡೆಸ್ಕ್‌ಟಾಪ್ {now} ಅನ್ನು ಬಳಸುತ್ತದೆ.\n"
"\n"
"{new} ಗೆ ಬದಲಾಯಿಸಬೇಕೇ? ನೀವು ಲಾಗ್ ಔಟ್ ಮಾಡಿ ಮತ್ತೆ ಲಾಗ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಇದು ಜಾರಿಗೆ ಬರುತ್ತದೆ.\n"
"\n"
"ಅಥವಾ ಇದನ್ನು ಉಳಿಸಿಕೊಳ್ಳಿ."

#, python-brace-format
msgid ""
"This file can't be installed. It may be damaged or not fully downloaded. Download it again and retry.\n"
"\n"
"(Details: {details})"
msgstr ""
"ಈ ಫೈಲ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಆಗುತ್ತಿಲ್ಲ. ಇದು ಹಾನಿಗೊಳಗಾಗಿರಬಹುದು ಅಥವಾ ಸಂಪೂರ್ಣವಾಗಿ ಡೌನ್‌ಲೋಡ್ ಆಗಿರದೇ ಇರಬಹುದು. ಇದನ್ನು ಮತ್ತೆ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.\n"
"\n"
"(ವಿವರಗಳು: {details})"

#, python-brace-format
msgid ""
"This file is an older version of {title} than the one you have.\n"
"\n"
"Install the older version: replaces yours. Only do this if the newer one has a problem."
msgstr ""
"ಈ ಫೈಲ್ ನೀವು ಹೊಂದಿರುವ {title} ಆವೃತ್ತಿಗಿಂತ ಹಳೆಯದು.\n"
"\n"
"ಹಳೆಯ ಆವೃತ್ತಿಯನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ: ಅದು ನಿಮ್ಮದನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ. ಹೊಸ ಆವೃತ್ತಿಯಲ್ಲಿ ಸಮಸ್ಯೆ ಇದ್ದರೆ ಮಾತ್ರ ಇದನ್ನು ಮಾಡಿ."

msgid ""
"This is a live session: it runs from the USB stick, nothing here is saved, "
"and the computer's disk isn't touched."
msgstr ""
"ಇದು ಲೈವ್ ಸೆಷನ್ ಆಗಿದೆ: ಇದು USB ಸ್ಟಿಕ್‌ನಿಂದ ಚಲಿಸುತ್ತದೆ, ಇಲ್ಲಿ ಏನೂ ಸೇವ್ "
"ಆಗುವುದಿಲ್ಲ ಮತ್ತು ಕಂಪ್ಯೂಟರ್‌ನ ಡಿಸ್ಕ್ ಅನ್ನು ಮುಟ್ಟಲಾಗುವುದಿಲ್ಲ."

msgid ""
"This is how the computer shows up on your network. Keep the suggestion, or "
"type a new one."
msgstr ""
"ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿ ಕಂಪ್ಯೂಟರ್ ಹೀಗೆ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ. ಸೂಚನೆಯನ್ನು ಹಾಗೆಯೇ "
"ಇರಿಸಿ ಅಥವಾ ಹೊಸದನ್ನು ಟೈಪ್ ಮಾಡಿ."

#, python-brace-format
msgid ""
"This is the 32-bit version of {title}, for older computers. Download the "
"64-bit version instead (often called amd64 or x86_64)."
msgstr ""
"ಇದು ಹಳೆಯ ಕಂಪ್ಯೂಟರ್‌ಗಳಿಗಾಗಿ ಇರುವ {title} ನ 32-ಬಿಟ್ ಆವೃತ್ತಿಯಾಗಿದೆ. ಬದಲಿಗೆ "
"64-ಬಿಟ್ ಆವೃತ್ತಿಯನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ (ಇದನ್ನು ಸಾಮಾನ್ಯವಾಗಿ amd64 ಅಥವಾ x86_64 "
"ಎಂದು ಕರೆಯಲಾಗುತ್ತದೆ)."

msgid "This network"
msgstr "ಈ ನೆಟ್‌ವರ್ಕ್"

msgid ""
"This removes things the computer no longer needs: unused app parts, old "
"system update files, and unused container images. Your files and your apps "
"aren't touched."
msgstr ""
"ಇದು ಕಂಪ್ಯೂಟರ್‌ಗೆ ಇನ್ನು ಅಗತ್ಯವಿಲ್ಲದವುಗಳನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ: ಬಳಕೆಯಾಗದ ಆ್ಯಪ್ "
"ಭಾಗಗಳು, ಹಳೆಯ ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್ ಫೈಲ್‌ಗಳು, ಮತ್ತು ಬಳಕೆಯಾಗದ ಕಂಟೇನರ್ ಇಮೇಜ್‌ಗಳು. "
"ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳಿಗೆ ಏನೂ ಆಗುವುದಿಲ್ಲ."

#, python-brace-format
msgid ""
"This saves the computer's recent error messages, its system version and the list of your apps to one file, {name}, in your Documents folder. What your apps showed or opened isn't in it.\n"
"\n"
"Then email that file to your helper. They can see what went wrong without being here.\n"
"\n"
"Nothing is sent anywhere by itself."
msgstr ""
"ಇದು ಕಂಪ್ಯೂಟರ್‌ನ ಇತ್ತೀಚಿನ ದೋಷ ಸಂದೇಶಗಳು, ಅದರ ಸಿಸ್ಟಂ ಆವೃತ್ತಿ ಮತ್ತು ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು, ನಿಮ್ಮ ದಸ್ತಾವೇಜುಗಳು ಫೋಲ್ಡರ್‌ನಲ್ಲಿರುವ {name} ಎಂಬ ಒಂದೇ ಫೈಲ್‌ಗೆ ಉಳಿಸುತ್ತದೆ. ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು ತೋರಿಸಿದ ಅಥವಾ ತೆರೆದ ವಿಷಯಗಳು ಅದರಲ್ಲಿ ಇರುವುದಿಲ್ಲ.\n"
"\n"
"ನಂತರ ಆ ಫೈಲ್ ಅನ್ನು ನಿಮ್ಮ ಸಹಾಯಕರಿಗೆ ಇಮೇಲ್ ಮಾಡಿ. ಅವರು ಇಲ್ಲಿ ಇಲ್ಲದೆಯೇ ಏನು ತಪ್ಪಾಯಿತು ಎಂದು ನೋಡಬಹುದು.\n"
"\n"
"ಯಾವುದನ್ನೂ ತಾನಾಗಿಯೇ ಎಲ್ಲಿಗೂ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ."

msgid ""
"This sets what other devices on this network can reach. Pick Public place "
"anywhere you're not sure. You can change it later in Wheelhouse, Network "
"safety."
msgstr ""
"ಈ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವ ಇತರ ಸಾಧನಗಳು ಏನನ್ನು ತಲುಪಬಹುದು ಎಂಬುದನ್ನು ಇದು "
"ನಿರ್ಧರಿಸುತ್ತದೆ. ಖಚಿತವಿಲ್ಲದ ಯಾವುದೇ ಸ್ಥಳದಲ್ಲಿ ಸಾರ್ವಜನಿಕ ಸ್ಥಳ ಆಯ್ಕೆಮಾಡಿ. ನಂತರ "
"Wheelhouse, ನೆಟ್‌ವರ್ಕ್ ಸುರಕ್ಷತೆ ಇಲ್ಲಿ ಇದನ್ನು ಬದಲಾಯಿಸಬಹುದು."

msgid ""
"This sets what you see at first. The next step suggests a desktop layout to "
"match, and the guide is in Wheelhouse, Get help, either way."
msgstr ""
"ನೀವು ಮೊದಲು ಏನನ್ನು ನೋಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ಇದು ನಿರ್ಧರಿಸುತ್ತದೆ. ಮುಂದಿನ ಹಂತ ಇದಕ್ಕೆ "
"ಹೊಂದುವ ಡೆಸ್ಕ್‌ಟಾಪ್ ಲೇಔಟ್ ಅನ್ನು ಸೂಚಿಸುತ್ತದೆ, ಮತ್ತು ಯಾವುದನ್ನು ಆರಿಸಿದರೂ "
"ಮಾರ್ಗದರ್ಶಿ Wheelhouse, ಸಹಾಯ ಪಡೆಯಿರಿ ಇಲ್ಲಿ ಇರುತ್ತದೆ."

msgid "This setting is risky"
msgstr "ಈ ಸೆಟ್ಟಿಂಗ್ ಅಪಾಯಕಾರಿಯಾಗಿದೆ"

msgid "This start found these broken, as the test expects:"
msgstr ""
"ಈ ಪ್ರಾರಂಭವು ಇವುಗಳನ್ನು ಕೆಟ್ಟುಹೋಗಿವೆ ಎಂದು ಕಂಡುಕೊಂಡಿದೆ, ಪರೀಕ್ಷೆಯು "
"ನಿರೀಕ್ಷಿಸಿದಂತೆಯೇ:"

msgid "This start found these still broken, as the test expects:"
msgstr ""
"ಈ ಪ್ರಾರಂಭವು ಇವುಗಳನ್ನು ಇನ್ನೂ ಕೆಟ್ಟುಹೋಗಿರುವುದನ್ನು ಕಂಡುಕೊಂಡಿದೆ, ಪರೀಕ್ಷೆಯು "
"ನಿರೀಕ್ಷಿಸಿದಂತೆಯೇ:"

msgid "This system's EFI partition: %s (disk %s, partition %s)"
msgstr "ಈ ಸಿಸ್ಟಂನ EFI ಪಾರ್ಟಿಷನ್: %s (ಡಿಸ್ಕ್ %s, ಪಾರ್ಟಿಷನ್ %s)"

msgid "This takes a while."
msgstr "ಇದಕ್ಕೆ ಸ್ವಲ್ಪ ಸಮಯ ಬೇಕಾಗುತ್ತದೆ."

#, python-brace-format
msgid "This version is from {when}."
msgstr "ಈ ಆವೃತ್ತಿ {when} ರದ್ದು."

#, python-brace-format
msgid ""
"This {title} file is for a different kind of computer. Download the version "
"for this one (often called {names})."
msgstr ""
"ಈ {title} ಫೈಲ್ ಬೇರೆ ರೀತಿಯ ಕಂಪ್ಯೂಟರ್‌ಗಾಗಿ ಇದೆ. ಈ ಕಂಪ್ಯೂಟರ್‌ಗಾಗಿನ ಆವೃತ್ತಿಯನ್ನು "
"ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ (ಸಾಮಾನ್ಯವಾಗಿ ಅದನ್ನು {names} ಎಂದು ಕರೆಯಲಾಗುತ್ತದೆ)."

msgid ""
"Those are file sharing ports: folders are shared only on Home networks, in "
"Shared folders."
msgstr ""
"ಅವು ಫೈಲ್ ಹಂಚಿಕೆ ಪೋರ್ಟ್‌ಗಳು: ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ಗಳಲ್ಲಿ ಮಾತ್ರ, ಹಂಚಿದ"
" ಫೋಲ್ಡರ್‌ಗಳು ವಿಭಾಗದಲ್ಲಿ ಹಂಚಲಾಗುತ್ತದೆ."

msgid "Thunderbolt or USB4 ports"
msgstr "ಥಂಡರ್‌ಬೋಲ್ಟ್ ಅಥವಾ USB4 ಪೋರ್ಟ್‌ಗಳು"

msgid "Time server name"
msgstr "ಸಮಯ ಸರ್ವರ್‌ನ ಹೆಸರು"

msgid "Time servers"
msgstr "ಸಮಯ ಸರ್ವರ್‌ಗಳು"

msgid ""
"Time servers to use instead of Fedora's. Type a name and click Add. Click a "
"server to take it off. Click Back when done."
msgstr ""
"Fedora ದ ಬದಲು ಬಳಸಬೇಕಾದ ಸಮಯ ಸರ್ವರ್‌ಗಳು. ಹೆಸರನ್ನು ಟೈಪ್ ಮಾಡಿ \"ಸೇರಿಸಿ\" ಕ್ಲಿಕ್ "
"ಮಾಡಿ. ಸರ್ವರ್ ಅನ್ನು ತೆಗೆದುಹಾಕಲು ಅದರ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ. ಮುಗಿದ ನಂತರ \"ಹಿಂದೆ\" "
"ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "Time zone"
msgstr "ಕಾಲ ವಲಯ"

msgid "To be asked again: Wheelhouse, Apps, Zoom meetings."
msgstr "ಮತ್ತೆ ಕೇಳುವಂತೆ ಮಾಡಲು: Wheelhouse, ಆ್ಯಪ್‌ಗಳು, Zoom ಮೀಟಿಂಗ್‌ಗಳು."

msgid "To change your password, click Password."
msgstr "ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಬದಲಾಯಿಸಲು, \"ಗುಪ್ತಪದ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid "To check that this works on your computer, see Getting help."
msgstr ""
"ಇದು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಲು, \"ಸಹಾಯ "
"ಪಡೆಯುವುದು\" ವಿಭಾಗವನ್ನು ನೋಡಿ."

msgid "To choose which apps can notify you: Settings, Notifications."
msgstr ""
"ಯಾವ ಆ್ಯಪ್‌ಗಳು ನಿಮಗೆ ಸೂಚನೆ ಕಳುಹಿಸಬಹುದು ಎಂದು ಆಯ್ಕೆಮಾಡಲು: ಸಿದ್ಧತೆಗಳು, ಸೂಚನೆಗಳು."

msgid "To free the space for good: open Trash and click Empty."
msgstr ""
"ಸ್ಥಳವನ್ನು ಶಾಶ್ವತವಾಗಿ ಮುಕ್ತಗೊಳಿಸಲು: ಕಸಬುಟ್ಟಿ ತೆರೆಯಿರಿ ಮತ್ತು \"ಖಾಲಿ\" ಕ್ಲಿಕ್ "
"ಮಾಡಿ."

msgid ""
"To get it back: open Trash in the left side of Files, right-click the file, "
"and choose Restore From Trash."
msgstr ""
"ಅದನ್ನು ಮರಳಿ ಪಡೆಯಲು: ಕಡತಗಳು ಆ್ಯಪ್‌ನ ಎಡಭಾಗದಲ್ಲಿರುವ ಕಸಬುಟ್ಟಿ ತೆರೆಯಿರಿ, ಫೈಲ್ ಮೇಲೆ"
" ರೈಟ್-ಕ್ಲಿಕ್ ಮಾಡಿ, ಮತ್ತು \"Restore From Trash\" ಆಯ್ಕೆಮಾಡಿ."

msgid ""
"To give someone their own account, click Add User. Leave Administrator off "
"for children and guests."
msgstr ""
"ಯಾರಿಗಾದರೂ ಅವರದೇ ಖಾತೆ ನೀಡಲು, \"ಬಳಕೆದಾರರನ್ನು ಸೇರಿಸು\" ಕ್ಲಿಕ್ ಮಾಡಿ. ಮಕ್ಕಳು ಮತ್ತು"
" ಅತಿಥಿಗಳಿಗೆ \"ವ್ಯವಸ್ಥಾಪಕ\" ಆಫ್ ಆಗಿಯೇ ಇರಲಿ."

msgid "To go on, click Erase and install. To pick another disk, click Back."
msgstr ""
"ಮುಂದುವರಿಯಲು, \"ಅಳಿಸಿ ಮತ್ತು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ. ಬೇರೆ ಡಿಸ್ಕ್ "
"ಆಯ್ಕೆಮಾಡಲು, \"ಹಿಂದೆ\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid ""
"To make one: select the files, right-click, choose Compress, give it a name, "
"and click Create."
msgstr ""
"ಒಂದನ್ನು ರಚಿಸಲು: ಫೈಲ್‌ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ, ರೈಟ್-ಕ್ಲಿಕ್ ಮಾಡಿ, \"Compress\" "
"ಆಯ್ಕೆಮಾಡಿ, ಅದಕ್ಕೆ ಹೆಸರು ನೀಡಿ, ಮತ್ತು \"Create\" ಕ್ಲಿಕ್ ಮಾಡಿ."

msgid ""
"To open one: right-click it and choose Extract. The files go in a folder next"
" to it."
msgstr ""
"ಒಂದನ್ನು ತೆರೆಯಲು: ಅದರ ಮೇಲೆ ರೈಟ್-ಕ್ಲಿಕ್ ಮಾಡಿ \"Extract\" ಆಯ್ಕೆಮಾಡಿ. ಫೈಲ್‌ಗಳು "
"ಅದರ ಪಕ್ಕದ ಒಂದು ಫೋಲ್ಡರ್‌ಗೆ ಹೋಗುತ್ತವೆ."

msgid "To print, press Ctrl+P in any app."
msgstr "ಮುದ್ರಿಸಲು, ಯಾವುದೇ ಆ್ಯಪ್‌ನಲ್ಲಿ Ctrl+P ಒತ್ತಿರಿ."

msgid ""
"To record a video instead, click the video camera icon in the same tool "
"before you start. Recordings go to Videos, Screencasts."
msgstr ""
"ಬದಲಿಗೆ ವೀಡಿಯೊ ರೆಕಾರ್ಡ್ ಮಾಡಲು, ನೀವು ಆರಂಭಿಸುವ ಮೊದಲು ಅದೇ ಪರಿಕರದಲ್ಲಿರುವ ವೀಡಿಯೊ "
"ಕ್ಯಾಮೆರಾ ಐಕಾನ್ ಕ್ಲಿಕ್ ಮಾಡಿ. ರೆಕಾರ್ಡಿಂಗ್‌ಗಳು ವೀಡಿಯೊಗಳು, Screencasts ಗೆ "
"ಹೋಗುತ್ತವೆ."

msgid "To update now: open Wheelhouse, Updates, System Update."
msgstr ""
"ಈಗಲೇ ಅಪ್‌ಡೇಟ್ ಮಾಡಲು: Wheelhouse ತೆರೆಯಿರಿ, ಅಪ್‌ಡೇಟ್‌ಗಳು, ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್."

msgid ""
"Told to add a setting by a helper? Type it under Your own settings. Risky "
"ones are explained first."
msgstr ""
"ಸಹಾಯಕರು ಒಂದು ಸೆಟ್ಟಿಂಗ್ ಸೇರಿಸಲು ಹೇಳಿದ್ದಾರೆಯೇ? ಅದನ್ನು \"ನಿಮ್ಮ ಸ್ವಂತ "
"ಸೆಟ್ಟಿಂಗ್‌ಗಳು\" ಅಡಿಯಲ್ಲಿ ಟೈಪ್ ಮಾಡಿ. ಅಪಾಯಕಾರಿಯಾದವುಗಳನ್ನು ಮೊದಲು "
"ವಿವರಿಸಲಾಗುತ್ತದೆ."

msgid "Too weak"
msgstr "ತುಂಬಾ ದುರ್ಬಲವಾಗಿದೆ"

msgid "Tool"
msgstr "ಪರಿಕರ"

msgid "Top bar, apps from the bottom dock"
msgstr "ಮೇಲಿನ ಪಟ್ಟಿ, ಕೆಳಗಿನ ಡಾಕ್‌ನಿಂದ ಆ್ಯಪ್‌ಗಳು"

msgid "Touchpad"
msgstr "ಟಚ್‌ಪ್ಯಾಡ್"

msgid "Touchpad found."
msgstr "ಟಚ್‌ಪ್ಯಾಡ್ ಕಂಡುಬಂದಿದೆ."

msgid ""
"Try again in a minute. If this stays, use Save problem details in Get help."
msgstr ""
"ಒಂದು ನಿಮಿಷದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ. ಇದು ಹಾಗೆಯೇ ಇದ್ದರೆ, \"ಸಹಾಯ ಪಡೆಯಿರಿ\" ಯಲ್ಲಿ "
"\"ಸಮಸ್ಯೆಯ ವಿವರಗಳನ್ನು ಉಳಿಸಿ\" ಬಳಸಿ."

msgid "Try again later."
msgstr "ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

msgid "Try anyway"
msgstr "ಆದರೂ ಪ್ರಯತ್ನಿಸಿ"

msgid "Try it first"
msgstr "ಮೊದಲು ಇದನ್ನು ಪ್ರಯತ್ನಿಸಿ"

msgid "Turn automatic updates off or on"
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಆಫ್ ಅಥವಾ ಆನ್ ಮಾಡಿ"

msgid "Turn it on"
msgstr "ಅದನ್ನು ಆನ್ ಮಾಡಿ"

msgid ""
"Turn it on below, and computers on your Home network can open the folders you"
" pick."
msgstr ""
"ಕೆಳಗೆ ಇದನ್ನು ಆನ್ ಮಾಡಿ, ಆಗ ನಿಮ್ಮ ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವ ಕಂಪ್ಯೂಟರ್‌ಗಳು ನೀವು "
"ಆಯ್ಕೆಮಾಡಿದ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ತೆರೆಯಬಹುದು."

msgid "Turn it on from a Home network."
msgstr "ಮನೆ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವಾಗ ಇದನ್ನು ಆನ್ ಮಾಡಿ."

msgid "Turn off"
msgstr "ಆಫ್ ಮಾಡಿ"

msgid "Turn on"
msgstr "ಆನ್ ಮಾಡಿ"

msgid "Turn on anyway"
msgstr "ಆದರೂ ಆನ್ ಮಾಡಿ"

msgid ""
"Turn on automatic updates or automatic disk unlock, or free up disk space"
msgstr ""
"ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳು ಅಥವಾ ಡಿಸ್ಕ್‌ನ ಸ್ವಯಂಚಾಲಿತ ಅನ್‌ಲಾಕ್ ಅನ್ನು ಆನ್ ಮಾಡಿ, "
"ಅಥವಾ ಡಿಸ್ಕ್ ಸ್ಥಳವನ್ನು ಮುಕ್ತಗೊಳಿಸಿ"

msgid ""
"Turn sharing off and on again. If this stays, use Save problem details in Get"
" help."
msgstr ""
"ಹಂಚಿಕೆಯನ್ನು ಆಫ್ ಮಾಡಿ ಮತ್ತೆ ಆನ್ ಮಾಡಿ. ಇದು ಹಾಗೆಯೇ ಇದ್ದರೆ, \"ಸಹಾಯ ಪಡೆಯಿರಿ\" "
"ಯಲ್ಲಿ \"ಸಮಸ್ಯೆಯ ವಿವರಗಳನ್ನು ಉಳಿಸಿ\" ಬಳಸಿ."

msgid ""
"Turn the printer on. Plug it in with its cable, or join it to the same Wi-Fi."
msgstr ""
"ಪ್ರಿಂಟರ್ ಅನ್ನು ಆನ್ ಮಾಡಿ. ಅದರ ಕೇಬಲ್‌ನಿಂದ ಅದನ್ನು ಪ್ಲಗ್ ಇನ್ ಮಾಡಿ ಅಥವಾ ಅದೇ Wi-Fi "
"ಗೆ ಅದನ್ನು ಸಂಪರ್ಕಿಸಿ."

msgid "Turn them on or off"
msgstr "ಅವುಗಳನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡಿ"

msgid "Turning automatic updates back on."
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಮತ್ತೆ ಆನ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

msgid "Turning off automatic disk unlock."
msgstr "ಸ್ವಯಂಚಾಲಿತ ಡಿಸ್ಕ್ ಅನ್‌ಲಾಕ್ ಅನ್ನು ಆಫ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

msgid "Turning off automatic updates."
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಆಫ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

msgid "Turning on automatic disk unlock."
msgstr "ಸ್ವಯಂಚಾಲಿತ ಡಿಸ್ಕ್ ಅನ್‌ಲಾಕ್ ಅನ್ನು ಆನ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

msgid "Turning on automatic updates."
msgstr "ಸ್ವಯಂಚಾಲಿತ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಆನ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

msgid "Turns off Panel Self Refresh"
msgstr "Panel Self Refresh ಅನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ"

msgid "Turns off Panel Self Refresh and Panel Replay"
msgstr "Panel Self Refresh ಮತ್ತು Panel Replay ಅನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ"

msgid "Turns off adaptive backlight"
msgstr "ಅಡಾಪ್ಟಿವ್ ಬ್ಯಾಕ್‌ಲೈಟ್ ಅನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ"

msgid "Two choices:"
msgstr "ಎರಡು ಆಯ್ಕೆಗಳು:"

msgid "Type a setting first."
msgstr "ಮೊದಲು ಒಂದು ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ."

msgid "Type it again"
msgstr "ಅದನ್ನು ಮತ್ತೆ ಟೈಪ್ ಮಾಡಿ"

msgid "Type it, then type it again below."
msgstr "ಅದನ್ನು ಟೈಪ್ ಮಾಡಿ, ನಂತರ ಅದನ್ನು ಕೆಳಗೆ ಮತ್ತೊಮ್ಮೆ ಟೈಪ್ ಮಾಡಿ."

msgid "Type the disk password (the one you type when the computer starts):"
msgstr ""
"ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ (ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾದಾಗ ನೀವು ಟೈಪ್ ಮಾಡುವ "
"ಪಾಸ್‌ವರ್ಡ್):"

msgid "Type the disk password twice."
msgstr "ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಎರಡು ಬಾರಿ ಟೈಪ್ ಮಾಡಿ."

#, python-brace-format
msgid ""
"Type the password for {network}, then click Connect. Back goes to the list."
msgstr ""
"{network} ಗಾಗಿ ಪಾಸ್‌ವರ್ಡ್ ಟೈಪ್ ಮಾಡಿ, ನಂತರ \"ಸಂಪರ್ಕಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ. "
"\"ಹಿಂದೆ\" ಪಟ್ಟಿಗೆ ಹಿಂತಿರುಗಿಸುತ್ತದೆ."

msgid "Type the password twice."
msgstr "ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಎರಡು ಬಾರಿ ಟೈಪ್ ಮಾಡಿ."

msgid ""
"Type your full name. Your user name is made from it; type over it to change "
"it."
msgstr ""
"ನಿಮ್ಮ ಪೂರ್ಣ ಹೆಸರನ್ನು ಟೈಪ್ ಮಾಡಿ. ನಿಮ್ಮ ಬಳಕೆದಾರ ಹೆಸರು ಇದರಿಂದ ರಚನೆಯಾಗುತ್ತದೆ; "
"ಅದನ್ನು ಬದಲಾಯಿಸಲು ಅದರ ಮೇಲೆ ಬೇರೆ ಟೈಪ್ ಮಾಡಿ."

msgid "Type your password, then restart. The fix starts at the restart."
msgstr ""
"ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಟೈಪ್ ಮಾಡಿ, ನಂತರ ಮರುಪ್ರಾರಂಭಿಸಿ. ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಪರಿಹಾರ "
"ಆರಂಭವಾಗುತ್ತದೆ."

msgid "USB drives and memory cards"
msgstr "USB ಡ್ರೈವ್‌ಗಳು ಮತ್ತು ಮೆಮೊರಿ ಕಾರ್ಡ್‌ಗಳು"

msgid "USB or Bluetooth headphones may still work."
msgstr "USB ಅಥವಾ ಬ್ಲೂಟೂತ್ ಹೆಡ್‌ಫೋನ್‌ಗಳು ಇನ್ನೂ ಕೆಲಸ ಮಾಡಬಹುದು."

msgid "USB stick"
msgstr "USB ಸ್ಟಿಕ್"

msgid "Ubuntu box"
msgstr "Ubuntu ಬಾಕ್ಸ್"

msgid "Undo it. See Updates and safety."
msgstr "ಅದನ್ನು ರದ್ದುಗೊಳಿಸಿ. \"ಅಪ್‌ಡೇಟ್‌ಗಳು ಮತ್ತು ಸುರಕ್ಷತೆ\" ನೋಡಿ."

msgid "Undo the change"
msgstr "ಬದಲಾವಣೆಯನ್ನು ರದ್ದುಗೊಳಿಸಿ"

msgid "Undo the last update"
msgstr "ಕೊನೆಯ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಿ"

msgid "Undo the last update in Wheelhouse can still take you back later."
msgstr ""
"Wheelhouse ನಲ್ಲಿರುವ \"ಕೊನೆಯ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಿ\" ನಂತರವೂ ನಿಮ್ಮನ್ನು "
"ಹಿಂದಿನ ಆವೃತ್ತಿಗೆ ಕೊಂಡೊಯ್ಯಬಹುದು."

msgid "Undo the update"
msgstr "ಅಪ್‌ಡೇಟ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಿ"

msgid "Unknown"
msgstr "ಅಜ್ಞಾತ"

#, python-brace-format
msgid "Unknown desktop layout {layout}."
msgstr "ಅಜ್ಞಾತ ಡೆಸ್ಕ್‌ಟಾಪ್ ಲೇಔಟ್ {layout}."

#, python-brace-format
msgid "Unknown experience {experience}."
msgstr "ಅಜ್ಞಾತ ಆರಂಭದ ನೋಟ {experience}."

msgid "Unknown option: %s. Run  codecs  to see the choices."
msgstr "ಅಜ್ಞಾತ ಆಯ್ಕೆ: %s. ಆಯ್ಕೆಗಳನ್ನು ನೋಡಲು  codecs  ಅನ್ನು ಚಲಾಯಿಸಿ."

#, python-brace-format
msgid "Unknown time zone {timezone}."
msgstr "ಅಜ್ಞಾತ ಕಾಲ ವಲಯ {timezone}."

msgid "Unlock disk automatically"
msgstr "ಡಿಸ್ಕ್ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅನ್‌ಲಾಕ್ ಮಾಡಿ"

msgid ""
"Unlock disk automatically is off. From your next start, the computer asks for"
" the disk password again."
msgstr ""
"\"ಡಿಸ್ಕ್ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅನ್‌ಲಾಕ್ ಮಾಡಿ\" ಆಫ್ ಆಗಿದೆ. ನಿಮ್ಮ ಮುಂದಿನ "
"ಪ್ರಾರಂಭದಿಂದ, ಕಂಪ್ಯೂಟರ್ ಮತ್ತೆ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಕೇಳುತ್ತದೆ."

msgid ""
"Unlock disk automatically is on. After some firmware updates, the computer "
"asks for the disk password once. Then turn Unlock disk automatically on again"
" in Wheelhouse."
msgstr ""
"ಡಿಸ್ಕ್ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅನ್‌ಲಾಕ್ ಮಾಡುವ ಆಯ್ಕೆ ಆನ್ ಆಗಿದೆ. ಕೆಲವು ಫರ್ಮ್‌ವೇರ್ "
"ಅಪ್‌ಡೇಟ್‌ಗಳ ನಂತರ, ಕಂಪ್ಯೂಟರ್ ಒಮ್ಮೆ ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಕೇಳುತ್ತದೆ. ನಂತರ "
"Wheelhouse ನಲ್ಲಿ \"ಡಿಸ್ಕ್ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅನ್‌ಲಾಕ್ ಮಾಡಿ\" ಅನ್ನು ಮತ್ತೆ "
"ಆನ್ ಮಾಡಿ."

msgid ""
"Unlock disk automatically is on: the disk unlocks by itself when the computer starts.\n"
"\n"
"Turn off: you type the disk password at every start again."
msgstr ""
"\"ಡಿಸ್ಕ್ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅನ್‌ಲಾಕ್ ಮಾಡಿ\" ಆನ್ ಆಗಿದೆ: ಕಂಪ್ಯೂಟರ್ ಪ್ರಾರಂಭವಾದಾಗ ಡಿಸ್ಕ್ ತನ್ನಷ್ಟಕ್ಕೇ ಅನ್‌ಲಾಕ್ ಆಗುತ್ತದೆ.\n"
"\n"
"ಆಫ್ ಮಾಡಿ: ಪ್ರತಿ ಬಾರಿಯೂ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಪ್ರಾರಂಭಿಸುವಾಗ ನೀವು ಡಿಸ್ಕ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಮತ್ತೆ ಟೈಪ್ ಮಾಡಬೇಕಾಗುತ್ತದೆ."

msgid "Unplug the device and plug it back in so it works."
msgstr "ಸಾಧನವು ಕಾರ್ಯನಿರ್ವಹಿಸುವಂತೆ ಮಾಡಲು ಅದನ್ನು ತೆಗೆದು ಮತ್ತೆ ಪ್ಲಗ್ ಮಾಡಿ."

msgid "Unsigned kernel drivers could load."
msgstr "ಸಹಿ ಮಾಡದ ಕರ್ನಲ್ ಡ್ರೈವರ್‌ಗಳು ಲೋಡ್ ಆಗಬಹುದು."

#, python-brace-format
msgid "Up to {max} settings, each name once."
msgstr "ಗರಿಷ್ಠ {max} ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ಪ್ರತಿ ಹೆಸರು ಒಮ್ಮೆ ಮಾತ್ರ."

msgid "Update"
msgstr "ಅಪ್‌ಡೇಟ್ ಮಾಡಿ"

msgid "Update anyway"
msgstr "ಆದರೂ ಅಪ್‌ಡೇಟ್ ಮಾಡಿ"

msgid "Update firmware"
msgstr "ಫರ್ಮ್‌ವೇರ್ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ"

msgid "Update now"
msgstr "ಈಗಲೇ ಅಪ್‌ಡೇಟ್ ಮಾಡಿ"

msgid "Update program broken"
msgstr "ಅಪ್‌ಡೇಟ್ ಪ್ರೋಗ್ರಾಂ ಕೆಟ್ಟುಹೋಗಿದೆ"

msgid "Update the system, apps, app boxes and Homebrew now"
msgstr ""
"ಈಗಲೇ ಸಿಸ್ಟಂ, ಆ್ಯಪ್‌ಗಳು, ಆ್ಯಪ್ ಬಾಕ್ಸ್‌ಗಳು ಮತ್ತು Homebrew ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ"

#, python-brace-format
msgid "Update {title} to the newer version in this file?"
msgstr "ಈ ಫೈಲ್‌ನಲ್ಲಿರುವ ಹೊಸ ಆವೃತ್ತಿಗೆ {title} ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಬೇಕೇ?"

#, python-brace-format
msgid ""
"Update {title} to the newer version in this file?\n"
"\n"
"Needs your password and a restart."
msgstr ""
"ಈ ಫೈಲ್‌ನಲ್ಲಿರುವ ಹೊಸ ಆವೃತ್ತಿಗೆ {title} ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಬೇಕೇ?\n"
"\n"
"ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು ಮರುಪ್ರಾರಂಭ ಅಗತ್ಯವಿದೆ."

msgid "Updated, except: %s"
msgstr "ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗಿದೆ, ಆದರೆ ಇವುಗಳನ್ನು ಹೊರತುಪಡಿಸಿ: %s"

msgid "Updates"
msgstr "ಅಪ್‌ಡೇಟ್‌ಗಳು"

msgid "Updates and safety"
msgstr "ಅಪ್‌ಡೇಟ್‌ಗಳು ಮತ್ತು ಸುರಕ್ಷತೆ"

msgid "Updates can't run"
msgstr "ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಚಲಾಯಿಸಲು ಆಗುತ್ತಿಲ್ಲ"

msgid "Updates for the computer's own parts, like the BIOS"
msgstr "ಕಂಪ್ಯೂಟರ್‌ನ ಸ್ವಂತ ಭಾಗಗಳಿಗಾಗಿನ ಅಪ್‌ಡೇಟ್‌ಗಳು, ಉದಾಹರಣೆಗೆ BIOS"

msgid "Updates happen on their own"
msgstr "ಅಪ್‌ಡೇಟ್‌ಗಳು ತಾವಾಗಿಯೇ ಆಗುತ್ತವೆ"

msgid ""
"Updates install on their own. If one stops the computer starting properly, it"
