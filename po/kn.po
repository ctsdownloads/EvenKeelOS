msgstr ""
"ಸಿಸ್ಟಂ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ: ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ. "
"ನಿಮ್ಮ ಮುಂದಿನ ಮರುಪ್ರಾರಂಭದಲ್ಲಿ ಅದು ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

#, python-brace-format
msgid "Updating {title}"
msgstr "{title} ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Updating {title} in the {label}."
msgstr "{label} ನಲ್ಲಿ {title} ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ."

#, python-brace-format
msgid "Updating {title} on the system"
msgstr "ಸಿಸ್ಟಂನಲ್ಲಿ {title} ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

#, python-brace-format
msgid "Updating {title} on the system. A progress window shows it."
msgstr ""
"ಸಿಸ್ಟಂನಲ್ಲಿ {title} ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ. ಪ್ರಗತಿ ವಿಂಡೋ ಅದನ್ನು "
"ತೋರಿಸುತ್ತದೆ."

#, python-brace-format
msgid "Updating {title} on the system. This can take a few minutes."
msgstr ""
"ಸಿಸ್ಟಂನಲ್ಲಿ {title} ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ. ಇದಕ್ಕೆ ಕೆಲವು ನಿಮಿಷಗಳು "
