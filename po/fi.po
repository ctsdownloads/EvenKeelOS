msgstr "Wheelhouse-asetuksen muuttaminen vaatii tunnistautumisen"

msgid "Authentication is required to change the boot options"
msgstr "Käynnistysvaihtoehtojen muuttaminen vaatii tunnistautumisen"

msgid ""
"Authentication is required to delete important settings for the repair test"
msgstr "Korjaustestin tärkeiden asetusten poistaminen vaatii tunnistautumisen"

msgid "Authentication is required to install EvenKeelOS"
msgstr "EvenKeelOS:n asentaminen vaatii tunnistautumisen"

