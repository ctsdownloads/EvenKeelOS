msgstr "Tlač sa nespustí"

msgid "Printing service off"
msgstr "Tlačová služba je vypnutá"

msgid "Problem"
msgstr "Problém"

msgid "Protocol"
msgstr "Protokol"

msgid "Public place"
msgstr "Verejné miesto"

msgid ""
"Public place: nothing on the network can reach your computer. Pick it for "
"cafes, hotels and airports."
msgstr ""
"Verejné miesto: nič v sieti sa k vášmu počítaču nedostane. Vyberte ho pre "
"kaviarne, hotely a letiská."

msgid "Put EvenKeelOS on this computer"
msgstr "Nainštalovať EvenKeelOS na tento počítač"

#, python-brace-format
