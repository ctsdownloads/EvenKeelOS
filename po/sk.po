msgstr ""
"Okno Nainštalovať súbor balíka je otvorené. Keď si ho prezriete, kliknite na "
"Zrušiť."

msgid "Install Package File: after restart"
msgstr "Nainštalovať súbor balíka: po reštarte"

msgid "Install a package file"
msgstr "Nainštalovať súbor balíka"

msgid "Install an app from an .rpm or .deb file"
msgstr "Nainštalovať aplikáciu zo súboru .rpm alebo .deb"

