msgstr "Zhromažďujú sa podrobnosti o probléme."

msgid "Colors and wallpaper"
msgstr "Farby a tapeta"

msgid "Comes with the system"
msgstr "Je súčasťou systému"

msgid "Coming from Windows"
msgstr "Prechádzam z Windows"

msgid "Coming from Windows: where things are, and what's different"
msgstr "Prechádzate z Windows: kde čo nájdete a čo je iné"

msgid "Coming from Windows?"
msgstr "Prechádzate z Windows?"

msgid "Common fixes"
msgstr "Bežné opravy"

msgid "Computer name"
msgstr "Názov počítača"

#, python-brace-format
msgid "Computer name: {name}."
msgstr "Názov počítača: {name}."

msgid "Connect"
msgstr "Pripojiť"

msgid "Connect a Bluetooth device"
msgstr "Pripojiť zariadenie Bluetooth"

#, python-brace-format
msgid "Connected to {network}."
msgstr "Pripojené k {network}."

