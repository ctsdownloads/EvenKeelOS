msgstr "Ďalšia sieť, ku ktorej sa pripojíte, bude na začiatku Verejné miesto."

#, python-brace-format
msgid "The next start uses: {settings}"
msgstr "Pri ďalšom spustení sa použije: {settings}"

msgid "The one-time setup window is already closed."
msgstr "Okno jednorazového nastavenia je už zatvorené."

msgid "The password is typed and matches."
msgstr "Heslo je zadané a zhoduje sa."

#, python-brace-format
msgid "The password wasn't saved: {reason}"
msgstr "Heslo sa neuložilo: {reason}"

