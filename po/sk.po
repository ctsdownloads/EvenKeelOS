msgid ""
"The restart said:\n"
"\n"
"{message}\n"
"\n"
"Exit code: {code}"
msgstr ""
"Pri reštarte sa zobrazilo:\n"
"\n"
"{message}\n"
"\n"
"Kód ukončenia: {code}"

