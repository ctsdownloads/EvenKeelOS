msgstr ""
"Úroveň nabitia batérie je %s%%. Pripojte počítač k napájaniu: ak sa počas "
"aktualizácie vybije batéria, aktualizácia sa stratí."

#, python-brace-format
msgid "The biggest disk holds {gb} GB."
msgstr "Najväčší disk má kapacitu {gb} GB."

