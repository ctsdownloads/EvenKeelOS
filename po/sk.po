msgstr "Možnosti spustenia vo Wheelhouse ich neskôr dokážu vrátiť späť."

msgid "Both"
msgstr "Obe"

msgid "Both ask for your password, and work only on Home."
msgstr "Obe sa pýtajú na vaše heslo a fungujú iba v sieti Domov."

msgid "Bottom bar and a start menu"
msgstr "Spodný panel a ponuka Štart"

msgid "Box"
msgstr "Kontajner"

msgid "Broadcom Wi-Fi chip found. Its driver or firmware can't be included."
msgstr ""
"Našiel sa čip Wi-Fi od spoločnosti Broadcom. Jeho ovládač alebo firmvér nie "
"je možné zahrnúť."

msgid "Browse and install apps in Bazaar. They update on their own."
msgstr ""
"Prehliadajte a inštalujte aplikácie v obchode Bazaar. Aktualizujú sa samy."

msgid "Camera"
msgstr "Kamera"

msgid "Camera found."
msgstr "Kamera sa našla."

msgid "Can install software and change system settings. Click to turn it off."
msgstr ""
"Môže inštalovať softvér a meniť nastavenia systému. Kliknutím to vypnete."

msgid "Can install software and change system settings. Click to turn it on."
msgstr ""
"Môže inštalovať softvér a meniť nastavenia systému. Kliknutím to zapnete."

msgid "Cancel"
msgstr "Zrušiť"

