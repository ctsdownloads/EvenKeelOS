msgid "Removing {title}"
msgstr "Odstraňuje sa {title}"

#, python-brace-format
msgid "Removing {title} from the system."
msgstr "Odstraňuje sa {title} zo systému."

#, python-brace-format
msgid "Removing {title}."
msgstr "Odstraňuje sa {title}."

msgid "Renamed Boot%s to Boot%s (\"%s\")."
msgstr "Položka Boot%s bola premenovaná na Boot%s („%s“)."

