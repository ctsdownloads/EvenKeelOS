msgstr "Lo pilòt d’imprimenta {title} es prèst."

#, python-brace-format
msgid ""
"The printer driver {title} is ready.\n"
"\n"
"Open Printers: choose Add Printer, then your printer."
msgstr ""
"Lo pilòt d’imprimenta {title} es prèst.\n"
"\n"
"Dobrissètz Imprimentas: causissètz Apondre una imprimenta, puèi vòstra imprimenta."

msgid "The printing service fails to start."
msgstr "Lo servici d’impression capita pas de s’aviar."

