#, python-brace-format
msgid "{path} doesn't belong to an installed package."
msgstr "{path} நிறுவப்பட்ட தொகுப்புக்கு உரியதல்ல."

#, python-brace-format
msgid "{path} is in use and could not be closed."
msgstr "{path} பயன்பாட்டில் உள்ளது, அதை மூட முடியவில்லை."

#, python-brace-format
msgid "{path} is in use and could not be stopped."
msgstr "{path} பயன்பாட்டில் உள்ளது, அதை நிறுத்த முடியவில்லை."

#, python-brace-format
