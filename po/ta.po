msgstr "கிராபிக்ஸ் சிப் எதுவும் கிடைக்கவில்லை."

#, python-brace-format
msgid "No group {group}, or no user to add to it."
msgstr "{group} என்ற குழு இல்லை, அல்லது அதில் சேர்க்கப் பயனரும் இல்லை."

msgid "No guide at login, with the Standard desktop"
msgstr "\"நிலையானது\" டெஸ்க்டாப்புடன், உள்நுழையும்போது வழிகாட்டி இல்லை"

msgid "No login screen"
msgstr "உள்நுழைவுத் திரை இல்லை"

msgid "No networking"
msgstr "நெட்வொர்க் இல்லை"

