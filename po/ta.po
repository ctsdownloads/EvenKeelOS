msgstr "மற்ற கணினிகளை உள்ளே அனுமதி"

#, python-brace-format
msgid "Let {name} in on a Public place?"
msgstr "பொது இடத்தில் {name}-ஐ உள்ளே அனுமதிக்கவா?"

msgid "Light and dark"
msgstr "ஒளி மற்றும் இருள்"

