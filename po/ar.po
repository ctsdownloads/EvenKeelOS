#, python-brace-format
msgid "Updating the system: downloading the new version, {size} in {n} parts."
msgid_plural ""
"Updating the system: downloading the new version, {size} in {n} parts."
msgstr[0] "جارٍ تحديث النظام: تنزيل الإصدار الجديد، {size} على {n} جزء."
msgstr[1] "جارٍ تحديث النظام: تنزيل الإصدار الجديد، {size} على {n} جزء."
msgstr[2] "جارٍ تحديث النظام: تنزيل الإصدار الجديد، {size} على {n} جزأين."
msgstr[3] "جارٍ تحديث النظام: تنزيل الإصدار الجديد، {size} على {n} أجزاء."
msgstr[4] "جارٍ تحديث النظام: تنزيل الإصدار الجديد، {size} على {n} جزءًا."
msgstr[5] "جارٍ تحديث النظام: تنزيل الإصدار الجديد، {size} على {n} جزء."

msgid "Updating the system: it is already up to date."
msgstr "تحديث النظام: النظام محدّث بالفعل."

#, python-brace-format
msgid "Updating the system: step {step} of {total}, {stage} ({elapsed})."
msgstr "جارٍ تحديث النظام: الخطوة {step} من {total}، {stage} ({elapsed})."

#, python-brace-format
msgid "Updating the system: step {step} of {total}, {stage}."
msgstr "جارٍ تحديث النظام: الخطوة {step} من {total}، {stage}."

msgid ""
"Updating the system: the new version is installed. It starts at your next "
"restart."
msgstr ""
"تحديث النظام: تم تثبيت الإصدار الجديد. سيبدأ عند إعادة التشغيل التالية."

#, python-brace-format
msgid "Updating {title}"
msgstr "جارٍ تحديث {title}"

#, python-brace-format
msgid "Updating {title} in the {label}."
msgstr "جارٍ تحديث {title} في {label}."

#, python-brace-format
msgid "Updating {title} on the system"
msgstr "جارٍ تحديث {title} على النظام"

#, python-brace-format
