msgstr "W stylu Windows"

msgid "Windows-style bottom bar or the standard top bar"
msgstr "Pasek na dole w stylu Windows lub standardowy pasek na górze"

msgid "Wired"
msgstr "Przewodowa"

msgid "Wired network"
msgstr "Sieć przewodowa"

