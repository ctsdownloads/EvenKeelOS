msgstr "Zezwolić aplikacji {name} na dostęp w sieci typu Miejsce publiczne?"

msgid "Light and dark"
msgstr "Jasny i ciemny"

msgid "Light and dark schedule and wallpaper slideshow"
msgstr "Harmonogram stylu jasnego i ciemnego oraz pokaz slajdów tapet"

msgid "Light from"
msgstr "Jasny od"

