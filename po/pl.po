msgstr "Okno „Zainstaluj plik pakietu” jest otwarte"

msgid "Install Package File is open. Cancel it when you're done looking."
msgstr ""
"Okno „Zainstaluj plik pakietu” jest otwarte. Zamknij, kiedy skończysz "
"oglądać."

msgid "Install Package File: after restart"
msgstr "Zainstaluj plik pakietu: po ponownym uruchomieniu"

msgid "Install a package file"
msgstr "Zainstaluj plik pakietu"

msgid "Install an app from an .rpm or .deb file"
msgstr "Zainstaluj aplikację z pliku .rpm lub .deb"

msgid "Install from Fedora"
msgstr "Zainstaluj z Fedory"

msgid "Install it here too"
msgstr "Zainstaluj to też tutaj"

msgid "Install the driver"
msgstr "Zainstaluj sterownik"

msgid "Install the file too"
msgstr "Zainstaluj też ten plik"

