msgstr "Абагульванне не запусцілася"

msgid "Sharing is off"
msgstr "Абагульванне выключана"

msgid "Sharing is off."
msgstr "Абагульванне выключана."

msgid "Sharing is on."
msgstr "Абагульванне ўключана."

#, python-brace-format
msgid "Sharing on {networks}"
msgstr "Абагульванне ў {networks}"

msgid "Sharing password"
msgstr "Пароль абагульвання"

msgid "Sharing password saved."
msgstr "Пароль абагульвання захаваны."

msgid "Sharing starts by itself on a Home network."
msgstr "Абагульванне запускаецца само ў сетцы «Дом»."

msgid "Sharing waits for a Home network"
msgstr "Абагульванне чакае сеткі «Дом»"

msgid "Shift+Print Screen takes a picture of the whole screen straight away."
msgstr "Shift+Print Screen адразу робіць здымак усяго экрана."

