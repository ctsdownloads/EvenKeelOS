"Updating the system: downloading the new version, {size} in {n} parts."
msgstr[0] "Uppdaterar systemet: hämtar den nya versionen, {size} i {n} del."
msgstr[1] "Uppdaterar systemet: hämtar den nya versionen, {size} i {n} delar."

