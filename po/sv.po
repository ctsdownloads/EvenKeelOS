msgstr "Skriv disklösenordet två gånger."

#, python-brace-format
msgid ""
"Type the password for {network}, then click Connect. Back goes to the list."
msgstr ""
"Skriv lösenordet för {network} och klicka sedan på Anslut. Bakåt går tillbaka"
" till listan."

msgid "Type the password twice."
msgstr "Skriv lösenordet två gånger."

msgid ""
"Type your full name. Your user name is made from it; type over it to change "
"it."
msgstr ""
"Skriv ditt fullständiga namn. Ditt användarnamn skapas av det; skriv över det"
" för att ändra det."

msgid "Type your password, then restart. The fix starts at the restart."
msgstr ""
"Skriv ditt lösenord och starta sedan om. Lösningen börjar gälla vid "
"omstarten."

msgid "USB drives and memory cards"
msgstr "USB-enheter och minneskort"

msgid "USB or Bluetooth headphones may still work."
msgstr "USB- eller Bluetooth-hörlurar kanske fortfarande fungerar."

msgid "USB stick"
msgstr "USB-minne"

msgid "Ubuntu box"
msgstr "Ubuntu-låda"

msgid "Undo it. See Updates and safety."
msgstr "Ångra den. Se Uppdateringar och säkerhet."

