msgstr "Uppdaterar fast programvara. Låt datorn vara ansluten till ström."

msgid "Updating the system, apps and containers. This can take a while."
msgstr "Uppdaterar systemet, program och behållare. Det här kan ta en stund."

msgid "Updating the system: checking for a new version."
msgstr "Uppdaterar systemet: söker efter en ny version."

#, python-brace-format
msgid "Updating the system: downloaded part {done} of {total}."
msgstr "Uppdaterar systemet: del {done} av {total} hämtad."

#, python-brace-format
msgid ""
"Updating the system: downloading part {part} of {total}, about {got} of "
"{size} so far."
msgstr ""
"Uppdaterar systemet: hämtar del {part} av {total}, ungefär {got} av {size} "
"hittills."

#, python-brace-format
msgid "Updating the system: downloading the new version, {size} in {n} parts."
