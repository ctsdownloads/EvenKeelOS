msgstr ""
"Lås upp disken automatiskt är på. Efter vissa uppdateringar av fast "
"programvara frågar datorn efter disklösenordet en gång. Slå då på Lås upp "
"disken automatiskt igen i Wheelhouse."

msgid ""
"Unlock disk automatically is on: the disk unlocks by itself when the computer starts.\n"
"\n"
"Turn off: you type the disk password at every start again."
msgstr ""
"Lås upp disken automatiskt är på: disken låses upp av sig själv när datorn startar.\n"
"\n"
"Stäng av: du skriver disklösenordet vid varje start igen."

msgid "Unplug the device and plug it back in so it works."
msgstr "Koppla ur enheten och anslut den igen så att den fungerar."

msgid "Unsigned kernel drivers could load."
msgstr "Osignerade kärndrivrutiner skulle kunna läsas in."

#, python-brace-format
