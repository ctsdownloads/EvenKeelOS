msgstr "Slår på automatiska uppdateringar."

msgid "Turns off Panel Self Refresh"
msgstr "Stänger av Panel Self Refresh"

msgid "Turns off Panel Self Refresh and Panel Replay"
msgstr "Stänger av Panel Self Refresh och Panel Replay"

msgid "Turns off adaptive backlight"
msgstr "Stänger av adaptiv bakgrundsbelysning"

