msgstr "Vill du uppdatera {title} till den nyare versionen i den här filen?"

#, python-brace-format
msgid ""
"Update {title} to the newer version in this file?\n"
"\n"
"Needs your password and a restart."
msgstr ""
"Vill du uppdatera {title} till den nyare versionen i den här filen?\n"
"\n"
"Kräver ditt lösenord och en omstart."

msgid "Updated, except: %s"
msgstr "Uppdaterat, förutom: %s"

msgid "Updates"
msgstr "Uppdateringar"

msgid "Updates and safety"
msgstr "Uppdateringar och säkerhet"

msgid "Updates can't run"
msgstr "Uppdateringar kan inte köras"

msgid "Updates for the computer's own parts, like the BIOS"
msgstr "Uppdateringar för datorns egna delar, till exempel BIOS"

msgid "Updates happen on their own"
msgstr "Uppdateringar sker av sig själva"

msgid ""
"Updates install on their own. If one stops the computer starting properly, it"
" goes back to the version before by itself and tells you."
msgstr ""
"Uppdateringar installeras av sig själva. Om en uppdatering hindrar datorn "
