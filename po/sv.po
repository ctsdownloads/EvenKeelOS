#, python-brace-format
msgid ""
"Updates: automatic, from {maker}'s own download source. A daily check finds "
"new versions, which start at the next restart."
msgstr ""
"Uppdateringar: automatiska, från {maker}s egen hämtningskälla. En daglig "
"kontroll hittar nya versioner, som börjar gälla vid nästa omstart."

msgid "Updates: automatic, with System Update."
msgstr "Uppdateringar: automatiska, med Systemuppdatering."

msgid "Updates: automatic."
msgstr "Uppdateringar: automatiska."

msgid ""
"Updates: none, because it came from a file. To update, install a newer file. "
