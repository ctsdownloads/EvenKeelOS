msgstr "Det här tar en stund."

#, python-brace-format
msgid "This version is from {when}."
msgstr "Den här versionen är från {when}."

#, python-brace-format
msgid ""
"This {title} file is for a different kind of computer. Download the version "
"for this one (often called {names})."
msgstr ""
"Den här filen för {title} är för en annan sorts dator. Hämta versionen för "
"den här (kallas ofta {names})."

