msgstr "Đã khởi động ở chế độ đồ họa cơ bản, nên không thể kiểm tra đồ họa."

msgid "Starting"
msgstr "Đang khởi động"

msgid "Starting hangs (about 7 minutes)"
msgstr "Quá trình khởi động bị treo (khoảng 7 phút)"

msgid ""
"Starting hangs on the startup screen and the login screen never shows. After "
"3 minutes the computer restarts by itself. That happens twice (about 7 "
"minutes), and the third start is back on this version."
msgstr ""
"Quá trình khởi động bị treo ở màn hình khởi động và màn hình đăng nhập không "
"bao giờ xuất hiện. Sau 3 phút, máy tính tự khởi động lại. Tình trạng đó xảy "
"ra hai lần (khoảng 7 phút), và lần khởi động thứ ba lại quay về phiên bản "
"này."

msgid "Starting the computer"
msgstr "Khởi động máy tính"

msgid "Starts at login"
msgstr "Khởi chạy khi đăng nhập"

msgid "Status"
msgstr "Trạng thái"

#, python-brace-format
