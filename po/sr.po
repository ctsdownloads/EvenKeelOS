msgid "Where is {name}?"
msgstr "Где је {name}?"

#, python-brace-format
msgid ""
"Where is {network}? This sets what other devices on it can reach once "
"EvenKeelOS is installed. Pick Public place anywhere you're not sure."
msgstr ""
"Где је {network}? Ово одређује до чега други уређаји на њој могу да дођу када"
