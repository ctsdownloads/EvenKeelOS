msgstr "Sett aftur inn: {apps}."

msgid ""
"Put the device in pairing mode. Its instructions say how, often by holding "
"its power button."
msgstr ""
"Settu tækið í pörunarham. Leiðbeiningar þess segja hvernig, oft með því að "
"halda inni aflhnappi þess."

msgid "Put the pictures in one folder, for example in Pictures."
msgstr "Settu myndirnar í eina möppu, til dæmis í Myndir."

msgid "Quick fixes"
msgstr "Fljótlegar lagfæringar"

msgid "Quick test"
msgstr "Fljótlegt próf"

