msgstr ""
"Niðurhalsstaðurinn verður áfram. Opnaðu {filename} aftur til að velja forrit,"
" eða fjarlægðu hann í Wheelhouse, Forrit, Fjarlægja forrit."

#, python-brace-format
msgid ""
"The download source was added, but it has no apps to show right now. Check "
"your internet connection, then open {filename} again."
msgstr ""
"Niðurhalsstaðnum var bætt við, en hann hefur engin forrit að sýna eins og er."
" Athugaðu nettenginguna og opnaðu svo {filename} aftur."

msgid ""
"The earlier version doesn't have the settings repair yet, so if the repair "
"didn't work, going back to it would give a wrong message. Run the test after "
"the next update."
msgstr ""
"Fyrri útgáfan er ekki enn með viðgerð stillinga, svo ef viðgerðin virkaði "
"ekki myndi það gefa röng skilaboð að fara aftur í hana. Keyrðu prófið eftir "
"næstu uppfærslu."

#, python-brace-format
msgid "The file could not be written: {error}."
msgstr "Ekki tókst að skrifa skrána: {error}."

msgid "The fingerprint reader"
msgstr "Fingrafaralesarinn"

msgid "The firewall"
msgstr "Eldveggurinn"

msgid "The firewall didn't reload."
msgstr "Eldveggurinn endurhlóðst ekki."

#, python-brace-format
msgid "The firewall didn't take the change: {reason}"
msgstr "Eldveggurinn tók ekki breytinguna: {reason}"

msgid "The firewall doesn't start"
msgstr "Eldveggurinn ræsist ekki"

msgid ""
"The firewall fails to start, so during the test the computer has no firewall."
msgstr ""
"Eldveggurinn ræsist ekki, svo tölvan er án eldveggs meðan á prófinu stendur."

msgid "The firewall isn't answering"
msgstr "Eldveggurinn svarar ekki"

msgid "The firmware update didn't finish. Try again later."
msgstr "Fastbúnaðaruppfærslunni lauk ekki. Reyndu aftur síðar."

msgid "The firmware updater"
msgstr "Uppfærslutól fastbúnaðar"

msgid ""
"The first meeting asks whether to install Chrome or use your usual browser."
msgstr ""
"Á fyrsta fundinum er spurt hvort setja eigi upp Chrome eða nota venjulega "
"vafrann þinn."

msgid ""
"The first time, choose Install Chrome or Use the usual browser. The meeting "
"opens in Zoom's web version."
msgstr ""
"Í fyrsta skiptið skaltu velja „Setja upp Chrome“ eða „Nota venjulega "
"vafrann“. Fundurinn opnast í vefútgáfu Zoom."

msgid "The full codecs are already installed. Restart if you have not yet."
msgstr ""
"Allir kóðararnir eru þegar uppsettir. Endurræstu ef þú hefur ekki gert það "
"enn."

msgid "The full guide"
msgstr "Heildarhandbókin"

msgid "The full name is empty."
msgstr "Fullt nafn er tómt."

msgid ""
"The graphics driver is blocked, so the screen runs in a basic mode: it may "
"look blurry or slow, or stay black (then just wait)."
msgstr ""
"Skjákortsrekillinn er útilokaður, svo skjárinn keyrir í einföldum ham: hann "
"gæti virst óskýr eða hægur, eða haldist svartur (bíddu þá bara)."

msgid "The install could not be finished."
msgstr "Ekki tókst að ljúka uppsetningunni."

msgid "The install stopped"
msgstr "Uppsetningin stöðvaðist"

#, python-brace-format
msgid "The installer could not start: {error}"
msgstr "Ekki tókst að ræsa uppsetningarforritið: {error}"

