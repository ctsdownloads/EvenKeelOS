msgid "Computer name: {name}."
msgstr "Naziv računala: {name}."

msgid "Connect"
msgstr "Poveži"

msgid "Connect a Bluetooth device"
msgstr "Povežite Bluetooth uređaj"

#, python-brace-format
msgid "Connected to {network}."
msgstr "Povezano s mrežom {network}."

#, python-brace-format
msgid "Connecting to {network}..."
msgstr "Povezivanje s mrežom {network}…"

msgid ""
"Control Panel: Settings, for Wi-Fi, screens, sound, printers and accounts. "
"Wheelhouse, for updates, apps and fixes. A ship is steered from its "
"wheelhouse; this is where you steer your computer."
msgstr ""
"Upravljačka ploča: Postavke, za Wi-Fi, zaslone, zvuk, pisače i račune. "
"Wheelhouse, za ažuriranja, aplikacije i popravke. Brodom se upravlja iz "
"kormilarnice (engl. wheelhouse); ovdje upravljate svojim računalom."

#, python-brace-format
msgid "Copied: {command}"
msgstr "Kopirano: {command}"

msgid "Copy files by dragging them onto it, or with Ctrl+C and Ctrl+V."
msgstr ""
"Kopirajte datoteke tako da ih povučete na ovo mjesto ili pomoću tipki Ctrl+C "
"i Ctrl+V."

msgid "Copy the command"
msgstr "Kopiraj naredbu"

