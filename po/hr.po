msgid "Close {name} again"
msgstr "Ponovno zatvori {name}"

msgid "Code and terminal"
msgstr "Kod i terminal"

msgid "Collecting the problem details."
msgstr "Prikupljanje pojedinosti o problemu."

msgid "Colors and wallpaper"
msgstr "Boje i pozadina"

msgid "Comes with the system"
msgstr "Dolazi sa sustavom"

msgid "Coming from Windows"
msgstr "Prelazak s Windowsa"

msgid "Coming from Windows: where things are, and what's different"
msgstr "Prelazak s Windowsa: gdje se što nalazi i što je drugačije"

msgid "Coming from Windows?"
msgstr "Dolazite s Windowsa?"

msgid "Common fixes"
msgstr "Uobičajena rješenja"

msgid "Computer name"
msgstr "Naziv računala"

