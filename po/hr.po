msgid "Copy {command}"
msgstr "Kopiraj {command}"

msgid "Copying EvenKeelOS to the disk"
msgstr "Kopiranje EvenKeelOS-a na disk"

msgid "Copying EvenKeelOS to the disk failed."
msgstr "Kopiranje EvenKeelOS-a na disk nije uspjelo."

#, python-brace-format
msgid "Could not connect to {network}. Check the password."
msgstr "Povezivanje s mrežom {network} nije uspjelo. Provjerite lozinku."

msgid ""
"Couldn't check for firmware updates. Check your internet connection and try "
"again."
msgstr ""
