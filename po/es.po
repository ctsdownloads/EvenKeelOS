msgstr "Su equipo ha vuelto a la versión anterior."

#, python-brace-format
msgid ""
"Your computer went back to the version from {since}, because the newer "
"version didn't start properly. Your files and your apps aren't touched."
msgstr ""
"Su equipo ha vuelto a la versión de {since}, porque la versión más reciente "
