msgid "Pick a folder inside your home folder."
msgstr "ਆਪਣੇ ਘਰ ਫੋਲਡਰ ਦੇ ਅੰਦਰ ਕੋਈ ਫੋਲਡਰ ਚੁਣੋ।"

msgid "Pick a folder of pictures"
msgstr "ਤਸਵੀਰਾਂ ਵਾਲਾ ਕੋਈ ਫੋਲਡਰ ਚੁਣੋ"

msgid "Pick a folder to share"
msgstr "ਸਾਂਝਾ ਕਰਨ ਲਈ ਇੱਕ ਫੋਲਡਰ ਚੁਣੋ"

msgid "Pick a folder, not a file."
msgstr "ਇੱਕ ਫੋਲਡਰ ਚੁਣੋ, ਫ਼ਾਈਲ ਨਹੀਂ।"

msgid "Pick a problem to test. Your computer should fix it by itself."
msgstr ""
"ਟੈਸਟ ਕਰਨ ਲਈ ਕੋਈ ਸਮੱਸਿਆ ਚੁਣੋ। ਤੁਹਾਡੇ ਕੰਪਿਊਟਰ ਨੂੰ ਇਹ ਆਪਣੇ ਆਪ ਠੀਕ ਕਰ ਲੈਣੀ ਚਾਹੀਦੀ"
" ਹੈ।"

msgid "Pick a test, click Start the test, and type your password."
msgstr "ਇੱਕ ਟੈਸਟ ਚੁਣੋ, \"ਟੈਸਟ ਸ਼ੁਰੂ ਕਰੋ\" 'ਤੇ ਕਲਿੱਕ ਕਰੋ, ਅਤੇ ਆਪਣਾ ਪਾਸਵਰਡ ਟਾਈਪ ਕਰੋ।"

msgid "Pick an .exe or .msi to get its Linux version"
msgstr "ਇਸ ਦਾ Linux ਵਰਜ਼ਨ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ ਇੱਕ .exe ਜਾਂ .msi ਚੁਣੋ"

msgid "Pick an .rpm or .deb file from Downloads"
msgstr "ਡਾਊਨਲੋਡ ਵਿੱਚੋਂ ਕੋਈ .rpm ਜਾਂ .deb ਫ਼ਾਈਲ ਚੁਣੋ"

msgid "Pick an app or game so other computers can reach it"
msgstr "ਕੋਈ ਐਪ ਜਾਂ ਗੇਮ ਚੁਣੋ ਤਾਂ ਜੋ ਦੂਜੇ ਕੰਪਿਊਟਰ ਇਸ ਤੱਕ ਪਹੁੰਚ ਸਕਣ"

msgid "Pick it again in Get a VPN."
msgstr "ਇਸ ਨੂੰ \"VPN ਪ੍ਰਾਪਤ ਕਰੋ\" ਵਿੱਚ ਦੁਬਾਰਾ ਚੁਣੋ।"

msgid "Pick one."
msgstr "ਇੱਕ ਚੁਣੋ।"

msgid "Pick the app for the web, mail, calendar, music, videos and photos."
msgstr "ਵੈੱਬ, ਮੇਲ, ਕੈਲੰਡਰ, ਸੰਗੀਤ, ਵੀਡੀਓ ਅਤੇ ਫ਼ੋਟੋਆਂ ਲਈ ਐਪ ਚੁਣੋ।"

msgid ""
"Pick the app. To use it every time for that kind of file, turn on Always use "
"for this file type first."
msgstr ""
"ਐਪ ਚੁਣੋ। ਇਸ ਕਿਸਮ ਦੀ ਫ਼ਾਈਲ ਲਈ ਇਸ ਨੂੰ ਹਰ ਵਾਰ ਵਰਤਣ ਲਈ, ਪਹਿਲਾਂ \"ਇਸ ਫ਼ਾਇਲ ਕਿਸਮ ਲਈ"
" ਹਮੇਸ਼ਾਂ ਵਰਤੋਂ\" ਚਾਲੂ ਕਰੋ।"

msgid ""
"Pick the box. It's set up again, with its apps. Your files aren't touched."
msgstr ""
"ਬਾਕਸ ਚੁਣੋ। ਇਸ ਨੂੰ ਇਸ ਦੀਆਂ ਐਪਾਂ ਸਮੇਤ ਦੁਬਾਰਾ ਸੈੱਟ ਅੱਪ ਕੀਤਾ ਜਾਂਦਾ ਹੈ। ਤੁਹਾਡੀਆਂ "
"ਫ਼ਾਈਲਾਂ ਨੂੰ ਛੂਹਿਆ ਨਹੀਂ ਜਾਂਦਾ।"

msgid "Pick the day. Back keeps it as it is."
msgstr "ਦਿਨ ਚੁਣੋ। \"ਪਿੱਛੇ\" ਇਸ ਨੂੰ ਜਿਵੇਂ ਹੈ ਉਵੇਂ ਰੱਖਦਾ ਹੈ।"

msgid ""
"Pick the folder, then how often it changes: every hour, every day or at each "
"login."
msgstr ""
"ਫੋਲਡਰ ਚੁਣੋ, ਫਿਰ ਇਹ ਕਿ ਇਹ ਕਿੰਨੀ ਵਾਰ ਬਦਲੇ: ਹਰ ਘੰਟੇ, ਹਰ ਰੋਜ਼ ਜਾਂ ਹਰ ਵਾਰ ਲੌਗਇਨ "
"ਕਰਨ 'ਤੇ।"

msgid "Pick the fonts for menus, documents and code"
msgstr "ਮੀਨੂਆਂ, ਦਸਤਾਵੇਜ਼ਾਂ ਅਤੇ ਕੋਡ ਲਈ ਫ਼ੌਂਟ ਚੁਣੋ"

msgid "Pick the hour. Back keeps it as it is."
msgstr "ਘੰਟਾ ਚੁਣੋ। \"ਪਿੱਛੇ\" ਇਸ ਨੂੰ ਜਿਵੇਂ ਹੈ ਉਵੇਂ ਰੱਖਦਾ ਹੈ।"

msgid "Pick the minute. Back keeps it as it is."
msgstr "ਮਿੰਟ ਚੁਣੋ। \"ਪਿੱਛੇ\" ਇਸ ਨੂੰ ਜਿਵੇਂ ਹੈ ਉਵੇਂ ਰੱਖਦਾ ਹੈ।"

msgid "Pick the month. Back keeps it as it is."
msgstr "ਮਹੀਨਾ ਚੁਣੋ। \"ਪਿੱਛੇ\" ਇਸ ਨੂੰ ਜਿਵੇਂ ਹੈ ਉਵੇਂ ਰੱਖਦਾ ਹੈ।"

msgid "Pick the place next to a network. It changes at once."
msgstr "ਕਿਸੇ ਨੈੱਟਵਰਕ ਦੇ ਕੋਲ ਵਾਲੀ ਥਾਂ ਚੁਣੋ। ਇਹ ਤੁਰੰਤ ਬਦਲ ਜਾਂਦੀ ਹੈ।"

msgid ""
"Pick the speakers or headphones under Output Device, and the microphone under"
" Input Device."
msgstr ""
"ਆਉਟਪੁੱਟ ਡਿਵਾਈਸ ਦੇ ਹੇਠਾਂ ਸਪੀਕਰ ਜਾਂ ਹੈੱਡਫੋਨ ਚੁਣੋ, ਅਤੇ ਇਨਪੁੱਟ ਡਿਵਾਈਸ ਦੇ ਹੇਠਾਂ "
"ਮਾਈਕ੍ਰੋਫੋਨ ਚੁਣੋ।"

msgid "Pick the year. Back keeps it as it is."
msgstr "ਸਾਲ ਚੁਣੋ। \"ਪਿੱਛੇ\" ਇਸ ਨੂੰ ਜਿਵੇਂ ਹੈ ਉਵੇਂ ਰੱਖਦਾ ਹੈ।"

msgid "Pick what you need. It explains each choice."
msgstr "ਉਹ ਚੁਣੋ ਜਿਸਦੀ ਤੁਹਾਨੂੰ ਲੋੜ ਹੈ। ਇਹ ਹਰ ਵਿਕਲਪ ਦੀ ਵਿਆਖਿਆ ਕਰਦਾ ਹੈ।"

msgid "Pick which ones open when you log in"
msgstr "ਚੁਣੋ ਕਿ ਲੌਗ ਇਨ ਕਰਨ 'ਤੇ ਕਿਹੜੇ ਖੁੱਲ੍ਹਣੇ ਹਨ"

msgid "Place"
msgstr "ਸਥਾਨ"

msgid ""
"Plug in a USB stick, then click it to save the log on it. Click Refresh if it"
" isn't listed, or Back."
msgstr ""
"ਇੱਕ USB ਸਟਿੱਕ ਲਗਾਓ, ਫਿਰ ਲੌਗ ਉਸ 'ਤੇ ਸੇਵ ਕਰਨ ਲਈ ਉਸ 'ਤੇ ਕਲਿੱਕ ਕਰੋ। ਜੇ ਇਹ ਸੂਚੀ "
"ਵਿੱਚ ਨਹੀਂ ਹੈ ਤਾਂ \"ਰੀਫ੍ਰੈਸ਼ ਕਰੋ\" 'ਤੇ ਕਲਿੱਕ ਕਰੋ, ਜਾਂ \"ਪਿੱਛੇ\" 'ਤੇ।"

msgid "Plug in a second USB stick, then click Save the results again."
msgstr "ਦੂਜੀ USB ਸਟਿੱਕ ਲਗਾਓ, ਫਿਰ ਦੁਬਾਰਾ \"ਨਤੀਜੇ ਸੇਵ ਕਰੋ\" 'ਤੇ ਕਲਿੱਕ ਕਰੋ।"

msgid ""
"Plug in a second USB stick, then click it to save the log on it. Or click "
"Back."
msgstr ""
"ਦੂਜੀ USB ਸਟਿੱਕ ਲਗਾਓ, ਫਿਰ ਲੌਗ ਉਸ 'ਤੇ ਸੇਵ ਕਰਨ ਲਈ ਉਸ 'ਤੇ ਕਲਿੱਕ ਕਰੋ। ਜਾਂ "
"\"ਪਿੱਛੇ\" 'ਤੇ ਕਲਿੱਕ ਕਰੋ।"

msgid "Plug it in. It shows in the left side of Files."
msgstr "ਇਸ ਨੂੰ ਲਗਾਓ। ਇਹ ਫ਼ਾਇਲਾਂ ਦੇ ਖੱਬੇ ਪਾਸੇ ਦਿਖਾਈ ਦਿੰਦੀ ਹੈ।"

msgid "Plug the computer in. Open Wheelhouse, Updates, Update firmware."
msgstr ""
"ਕੰਪਿਊਟਰ ਨੂੰ ਚਾਰਜਰ ਨਾਲ ਲਗਾਓ। Wheelhouse ਖੋਲ੍ਹੋ, ਅੱਪਡੇਟ, ਫਰਮਵੇਅਰ ਅੱਪਡੇਟ ਕਰੋ।"

msgid ""
"Point your phone's camera at the code. It opens the report on GitHub with the"
" details filled in. To send it, sign in to GitHub, or make a free account if "
"you don't have one. It carries the end of the log; the whole log can go on a "
"USB stick. Click Back when done."
msgstr ""
"ਆਪਣੇ ਫ਼ੋਨ ਦਾ ਕੈਮਰਾ ਕੋਡ ਵੱਲ ਕਰੋ। ਇਹ GitHub 'ਤੇ ਰਿਪੋਰਟ ਖੋਲ੍ਹਦਾ ਹੈ, ਜਿਸ ਵਿੱਚ "
"ਵੇਰਵੇ ਭਰੇ ਹੁੰਦੇ ਹਨ। ਇਸ ਨੂੰ ਭੇਜਣ ਲਈ, GitHub ਵਿੱਚ ਸਾਈਨ ਇਨ ਕਰੋ, ਜਾਂ ਜੇ ਤੁਹਾਡਾ "
"ਖਾਤਾ ਨਹੀਂ ਹੈ ਤਾਂ ਇੱਕ ਮੁਫ਼ਤ ਖਾਤਾ ਬਣਾਓ। ਇਸ ਵਿੱਚ ਲੌਗ ਦਾ ਅਖੀਰਲਾ ਹਿੱਸਾ ਹੁੰਦਾ ਹੈ; "
"ਪੂਰਾ ਲੌਗ USB ਸਟਿੱਕ 'ਤੇ ਰੱਖਿਆ ਜਾ ਸਕਦਾ ਹੈ। ਹੋ ਜਾਣ 'ਤੇ \"ਪਿੱਛੇ\" 'ਤੇ ਕਲਿੱਕ ਕਰੋ।"

msgid "Port, like 8080, or a range, like 2456-2458"
msgstr "ਪੋਰਟ, ਜਿਵੇਂ 8080, ਜਾਂ ਪੋਰਟਾਂ ਦੀ ਰੇਂਜ, ਜਿਵੇਂ 2456-2458"

msgid "Power modes"
msgstr "ਪਾਵਰ ਢੰਗ"

msgid "Prefer the terminal?"
msgstr "ਕੀ ਤੁਸੀਂ ਟਰਮੀਨਲ ਨੂੰ ਤਰਜੀਹ ਦਿੰਦੇ ਹੋ?"

#, python-brace-format
msgid "Preparing the {label}."
msgstr "{label} ਨੂੰ ਤਿਆਰ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ।"

msgid ""
"Press Print Screen. Pick the whole screen, a window, or drag over an area, "
"then click the round button."
msgstr ""
"ਪ੍ਰਿੰਟ ਸਕ੍ਰੀਨ ਦਬਾਓ। ਪੂਰੀ ਸਕ੍ਰੀਨ, ਕੋਈ ਵਿੰਡੋ ਚੁਣੋ ਜਾਂ ਕਿਸੇ ਖੇਤਰ ਉੱਤੇ ਡ੍ਰੈਗ ਕਰੋ,"
" ਫਿਰ ਗੋਲ ਬਟਨ 'ਤੇ ਕਲਿੱਕ ਕਰੋ।"

msgid "Printers didn't open. Open Settings, then Printers."
msgstr "ਪਰਿੰਟਰ ਨਹੀਂ ਖੁੱਲ੍ਹਿਆ। ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ, ਫਿਰ ਪਰਿੰਟਰ।"

msgid ""
"Printers is open. Choose Add Printer.\n"
"\n"
"If your printer isn't there or doesn't print right, open this file again and choose Install the driver."
msgstr ""
"ਪਰਿੰਟਰ ਖੁੱਲ੍ਹਿਆ ਹੈ। \"ਪਰਿੰਟਰ ਨੂੰ ਜੋੜੋ\" ਚੁਣੋ।\n"
"\n"
"ਜੇ ਤੁਹਾਡਾ ਪ੍ਰਿੰਟਰ ਉੱਥੇ ਨਹੀਂ ਹੈ ਜਾਂ ਸਹੀ ਤਰ੍ਹਾਂ ਪ੍ਰਿੰਟ ਨਹੀਂ ਕਰਦਾ, ਤਾਂ ਇਸ ਫ਼ਾਈਲ ਨੂੰ ਦੁਬਾਰਾ ਖੋਲ੍ਹੋ ਅਤੇ \"ਡਰਾਈਵਰ ਇੰਸਟਾਲ ਕਰੋ\" ਚੁਣੋ।"

msgid ""
"Printers is open. Choose Add Printer.\n"
"\n"
"If your printer isn't there or doesn't print right, open this file again to see how to get the driver."
msgstr ""
"ਪਰਿੰਟਰ ਖੁੱਲ੍ਹਿਆ ਹੈ। \"ਪਰਿੰਟਰ ਨੂੰ ਜੋੜੋ\" ਚੁਣੋ।\n"
"\n"
"ਜੇ ਤੁਹਾਡਾ ਪ੍ਰਿੰਟਰ ਉੱਥੇ ਨਹੀਂ ਹੈ ਜਾਂ ਸਹੀ ਤਰ੍ਹਾਂ ਪ੍ਰਿੰਟ ਨਹੀਂ ਕਰਦਾ, ਤਾਂ ਡਰਾਈਵਰ ਕਿਵੇਂ ਪ੍ਰਾਪਤ ਕਰਨਾ ਹੈ ਇਹ ਦੇਖਣ ਲਈ ਇਸ ਫ਼ਾਈਲ ਨੂੰ ਦੁਬਾਰਾ ਖੋਲ੍ਹੋ।"

msgid "Printing"
msgstr "ਪ੍ਰਿੰਟਿੰਗ"

msgid "Printing doesn't start"
msgstr "ਪ੍ਰਿੰਟਿੰਗ ਸ਼ੁਰੂ ਨਹੀਂ ਹੁੰਦੀ"

msgid "Printing service off"
msgstr "ਪ੍ਰਿੰਟਿੰਗ ਸਰਵਿਸ ਬੰਦ ਹੈ"

msgid "Problem"
msgstr "ਸਮੱਸਿਆ"

msgid "Protocol"
msgstr "ਪ੍ਰੋਟੋਕੋਲ"

msgid "Public place"
msgstr "ਜਨਤਕ ਸਥਾਨ"

msgid ""
"Public place: nothing on the network can reach your computer. Pick it for "
"cafes, hotels and airports."
msgstr ""
"ਜਨਤਕ ਸਥਾਨ: ਨੈੱਟਵਰਕ 'ਤੇ ਕੋਈ ਵੀ ਚੀਜ਼ ਤੁਹਾਡੇ ਕੰਪਿਊਟਰ ਤੱਕ ਨਹੀਂ ਪਹੁੰਚ ਸਕਦੀ। ਇਸ ਨੂੰ"
" ਕੈਫੇ, ਹੋਟਲਾਂ ਅਤੇ ਹਵਾਈ ਅੱਡਿਆਂ ਲਈ ਚੁਣੋ।"

msgid "Put EvenKeelOS on this computer"
msgstr "EvenKeelOS ਨੂੰ ਇਸ ਕੰਪਿਊਟਰ 'ਤੇ ਰੱਖੋ"

#, python-brace-format
msgid "Put back: {apps}."
msgstr "ਵਾਪਸ ਰੱਖੀਆਂ ਗਈਆਂ: {apps}।"

msgid ""
"Put the device in pairing mode. Its instructions say how, often by holding "
"its power button."
msgstr ""
"ਡਿਵਾਈਸ ਨੂੰ ਪੇਅਰਿੰਗ ਮੋਡ ਵਿੱਚ ਪਾਓ। ਇਸ ਦੀਆਂ ਹਦਾਇਤਾਂ ਦੱਸਦੀਆਂ ਹਨ ਕਿ ਇਹ ਕਿਵੇਂ ਕਰਨਾ "
"ਹੈ, ਅਕਸਰ ਇਸ ਦੇ ਪਾਵਰ ਬਟਨ ਨੂੰ ਦਬਾ ਕੇ ਰੱਖ ਕੇ।"

msgid "Put the pictures in one folder, for example in Pictures."
msgstr "ਤਸਵੀਰਾਂ ਨੂੰ ਇੱਕ ਫੋਲਡਰ ਵਿੱਚ ਰੱਖੋ, ਉਦਾਹਰਨ ਲਈ \"ਤਸਵੀਰਾਂ\" ਵਿੱਚ।"

msgid "Quick fixes"
msgstr "ਤੁਰੰਤ ਹੱਲ"

msgid "Quick test"
msgstr "ਛੋਟਾ ਟੈਸਟ"

#, python-brace-format
msgid "Quit {app}"
msgstr "{app} ਬੰਦ ਕਰੋ"

msgid "Quitting %s"
msgstr "%s ਨੂੰ ਬੰਦ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ"

msgid "Read and write"
msgstr "ਪੜ੍ਹਨਾ ਅਤੇ ਲਿਖਣਾ"

msgid "Read only"
msgstr "ਸਿਰਫ਼ ਪੜ੍ਹਨ ਲਈ"

msgid "Reading the disk"
msgstr "ਡਿਸਕ ਪੜ੍ਹੀ ਜਾ ਰਹੀ ਹੈ"

#, python-brace-format
msgid "Reading the download source {name}"
msgstr "ਡਾਊਨਲੋਡ ਸਰੋਤ {name} ਨੂੰ ਪੜ੍ਹਿਆ ਜਾ ਰਿਹਾ ਹੈ"

msgid "Reading the list of apps from the new download source"
msgstr "ਨਵੇਂ ਡਾਊਨਲੋਡ ਸਰੋਤ ਤੋਂ ਐਪਾਂ ਦੀ ਸੂਚੀ ਪੜ੍ਹੀ ਜਾ ਰਹੀ ਹੈ"

msgid "Recommended"
msgstr "ਸਿਫ਼ਾਰਸ਼ੀ"

#, python-brace-format
msgid ""
"Recommended: Delete the box. It frees about {size}, and comes back by itself "
"the next time you install {apps}. Anything added to the box another way is "
"deleted too. Your files are not touched."
msgstr ""
"ਸਿਫ਼ਾਰਸ਼: ਬਾਕਸ ਮਿਟਾਓ। ਇਹ ਲਗਭਗ {size} ਥਾਂ ਖਾਲੀ ਕਰਦਾ ਹੈ, ਅਤੇ ਅਗਲੀ ਵਾਰ ਜਦੋਂ "
"ਤੁਸੀਂ {apps} ਇੰਸਟਾਲ ਕਰਦੇ ਹੋ ਤਾਂ ਇਹ ਆਪਣੇ ਆਪ ਵਾਪਸ ਆ ਜਾਂਦਾ ਹੈ। ਜੋ ਕੁਝ ਵੀ ਬਾਕਸ "
"ਵਿੱਚ ਕਿਸੇ ਹੋਰ ਤਰੀਕੇ ਨਾਲ ਜੋੜਿਆ ਗਿਆ ਹੈ, ਉਹ ਵੀ ਮਿਟਾ ਦਿੱਤਾ ਜਾਂਦਾ ਹੈ। ਤੁਹਾਡੀਆਂ "
"ਫ਼ਾਈਲਾਂ ਨੂੰ ਛੂਹਿਆ ਨਹੀਂ ਜਾਂਦਾ।"

#, python-brace-format
msgid ""
"Recommended: Delete the box. It frees its disk space, and comes back by "
"itself the next time you install {apps}. Anything added to the box another "
"way is deleted too. Your files are not touched."
msgstr ""
"ਸਿਫ਼ਾਰਸ਼: ਬਾਕਸ ਮਿਟਾਓ। ਇਹ ਇਸ ਦੀ ਡਿਸਕ ਸਪੇਸ ਖਾਲੀ ਕਰਦਾ ਹੈ, ਅਤੇ ਅਗਲੀ ਵਾਰ ਜਦੋਂ "
"ਤੁਸੀਂ {apps} ਇੰਸਟਾਲ ਕਰਦੇ ਹੋ ਤਾਂ ਇਹ ਆਪਣੇ ਆਪ ਵਾਪਸ ਆ ਜਾਂਦਾ ਹੈ। ਜੋ ਕੁਝ ਵੀ ਬਾਕਸ "
"ਵਿੱਚ ਕਿਸੇ ਹੋਰ ਤਰੀਕੇ ਨਾਲ ਜੋੜਿਆ ਗਿਆ ਹੈ, ਉਹ ਵੀ ਮਿਟਾ ਦਿੱਤਾ ਜਾਂਦਾ ਹੈ। ਤੁਹਾਡੀਆਂ "
"ਫ਼ਾਈਲਾਂ ਨੂੰ ਛੂਹਿਆ ਨਹੀਂ ਜਾਂਦਾ।"

msgid ""
"Recommended: Go back now. The computer restarts on the version that worked "
"before. Your files and apps aren't touched. If automatic updates are on, they"
" pause for 3 days, so the same update doesn't come straight back."
