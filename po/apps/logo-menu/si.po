msgid "Symbolic Icons"
msgstr "සංකේතාත්මක නිරූපක"

msgid "Coloured Icons"
msgstr "වර්ණවත් නිරූපක"

msgid "Icon Settings"
msgstr "නිරූපක සැකසුම්"

msgid "Icon Size"
msgstr "නිරූපකයේ ප්‍රමාණය"

msgid "Use Custom Icon"
msgstr "අභිරුචි නිරූපකයක් භාවිතා කරන්න"

msgid "Selected Icon"
msgstr "තෝරාගත් නිරූපකය"

msgid "Select a Custom Icon"
msgstr "අභිරුචි නිරූපකයක් තෝරන්න"

msgid "Change Defaults"
msgstr "පෙරනිමි වෙනස් කරන්න"

msgid "Show/Hide Options"
msgstr "පෙන්වීම/සැඟවීම් විකල්ප"

msgid "Top Panel Options"
msgstr "ඉහළ මඬල විකල්ප"

msgid "Icon Click Type to open Activities"
msgstr "ක්‍රියාකාරකම් විවෘත කිරීමට නිරූපකය ඔබන ආකාරය"

msgid "Left Click "
msgstr "වම් ඔබන්න "

msgid "Middle Click "
msgstr "මැද ඔබන්න "

msgid "Right Click "
msgstr "දකුණු ඔබන්න "

msgid "Preferred Extensions Application"
msgstr "කැමති දිගු යෙදුම"

msgid "GNOME Extensions"
msgstr "ග්නෝම් දිගු"

msgid "Extensions Manager"
msgstr "දිගු කළමනාකරු"

msgid "Terminal"
msgstr "ටර්මිනලය"

msgid "Software Center"
msgstr "මෘදුකාංග මධ්‍යස්ථානය"

msgid "System Monitor"
msgstr "පද්ධති නිරීක්ෂකය"

msgid "Enable Power Options"
msgstr "බල විකල්ප සබල කරන්න"

msgid "Hide Force Quit option"
msgstr "බලහත්කාරයෙන් වසා දැමීමේ විකල්පය සඟවන්න"

msgid "Show Lock Screen option"
msgstr "අගුළු තිරයේ විකල්පය පෙන්වන්න"

msgid "Hide Software Centre option"
msgstr "මෘදුකාංග මධ්‍යස්ථාන විකල්පය සඟවන්න"

msgid "Show Activities Button"
msgstr "ක්‍රියාකාරකම් බොත්තම පෙන්වන්න"

msgid "Hide Icon Shadow"
msgstr "නිරූපකයේ සෙවණැල්ල සඟවන්න"

msgid "About"
msgstr "පිළිබඳව"

msgid "Logo Menu"
msgstr "Logo Menu"

msgid "Quick access menu for GNOME"
msgstr "ග්නෝම් සඳහා ඉක්මන් ප්‍රවේශ වට්ටෝරුව"

msgid "Logo Menu Version"
msgstr "Logo Menu අනුවාදය"

msgid "GNOME Version"
msgstr "ග්නෝම් අනුවාදය"

msgid "Created with love by"
msgstr "ආදරයෙන් නිර්මාණය කළේ"

msgid "Matrix/Element room"
msgstr "Matrix/Element කාමරය"

msgid "Contributors"
msgstr "දායකයින්"

msgid "This program comes with absolutely no warranty."
msgstr "මෙම වැඩසටහන කිසිදු වගකීමක් නොමැතිව පැමිණේ."

#, javascript-format
msgid "See the %sGNU General Public License, version 2 or later%s for details."
msgstr "විස්තර සඳහා %sGNU General Public License, version 2 or later%s බලන්න."

msgid "About My System"
msgstr "මගේ පද්ධතිය පිළිබඳව"

msgid "Activities"
msgstr "ක්‍රියාකාරකම්"

msgid "App Grid"
msgstr "යෙදුම් ජාලය"

msgid "Extensions"
msgstr "දිගු"

msgid "Force Quit App"
msgstr "යෙදුම බලහත්කාරයෙන් වසන්න"

msgid "Sleep"
msgstr "නිද්‍රාව"

msgid "Restart..."
msgstr "නැවත ආරම්භ කරන්න..."

msgid "Shut Down..."
msgstr "වසා දමන්න..."

msgid "Lock Screen"
msgstr "තිරය අගුළු දමන්න"

msgid "Log Out..."
msgstr "ඉවත් වන්න..."
