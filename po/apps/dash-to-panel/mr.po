msgstr "अपारदर्शकता बदलाच्या ॲनिमेशनचा कालावधी (ms)"

msgid "Font size (px) of the application titles (default is 14)"
msgstr "ॲप्लिकेशन शीर्षकांचा फॉन्ट आकार (px) (डिफॉल्ट 14 आहे)"

msgid "Font weight of application titles"
msgstr "ॲप्लिकेशन शीर्षकांची फॉन्ट जाडी"

msgid "inherit from theme"
msgstr "थीमकडून घ्या"

msgid "normal"
msgstr "सामान्य"

msgid "lighter"
msgstr "हलकी"

msgid "bold"
msgstr "ठळक"

msgid "bolder"
msgstr "अधिक ठळक"

msgid "Font color of the application titles"
msgstr "ॲप्लिकेशन शीर्षकांचा फॉन्ट रंग"

msgid "Font color of the minimized application titles"
msgstr "लहान केलेल्या ॲप्लिकेशन शीर्षकांचा फॉन्ट रंग"

msgid "Maximum width (px) of the application titles"
msgstr "ॲप्लिकेशन शीर्षकांची कमाल रुंदी (px)"

msgid "(default is 160)"
msgstr "(डिफॉल्ट 160 आहे)"

msgid "Use a fixed width for the application titles"
msgstr "ॲप्लिकेशन शीर्षकांसाठी निश्चित रुंदी वापरा"

msgid "The application titles all have the same width, even if their texts are shorter than the maximum width. The maximum width value is used as the fixed width."
msgstr "ॲप्लिकेशन शीर्षकांचा मजकूर कमाल रुंदीपेक्षा लहान असला तरीही सर्व शीर्षकांची रुंदी सारखीच असते. कमाल रुंदीचे मूल्य निश्चित रुंदी म्हणून वापरले जाते."

msgid "Display running indicators on unfocused applications"
msgstr "फोकस नसलेल्या ॲप्लिकेशन्सवर चालू असल्याचे दर्शक दाखवा"

msgid "Use the favorite icons as application launchers"
msgstr "आवडते आयकॉन ॲप्लिकेशन लाँचर म्हणून वापरा"

msgid "Highlight AppIcon color"
msgstr "AppIcon रंग हायलाइट करा"

msgid "Pressed AppIcon color"
msgstr "दाबलेला AppIcon रंग"

msgid "Highlight AppIcon border radius"
msgstr "AppIcon किनार त्रिज्या हायलाइट करा"

msgid "Overrides global border radius (default is 0)"
msgstr "ग्लोबल किनार त्रिज्या अधिलिखित करते (डिफॉल्ट 0 आहे)"

msgid "Only hide the panel from windows"
msgstr "पॅनेल फक्त विंडोंपासून लपवा"

msgid "Overlapping"
msgstr "एकमेकांवर येणाऱ्या"

msgid "On same monitor"
msgstr "त्याच मॉनिटरवर"

msgid "The panel hides from"
msgstr "पॅनेल यांपासून लपते"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "पॉइंटरने मॉनिटरच्या काठाला स्पर्श केल्यावर पॅनेल दिसते"

msgid "Limit to panel length"
msgstr "पॅनेलच्या लांबीपर्यंत मर्यादित करा"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "पॅनेलच्या क्षेत्रावर फिरवल्यास पॅनेल दिसत राहते"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "पॅनेल दाखवण्यासाठी मॉनिटरच्या काठावर दाब आवश्यक"

msgid "Required pressure threshold (px)"
msgstr "आवश्यक दाबाची मर्यादा (px)"

msgid "Required pressure timeout (ms)"
msgstr "आवश्यक दाबाची कालमर्यादा (ms)"

msgid "Allow the panel to be revealed while in fullscreen mode"
msgstr "पूर्ण स्क्रीन मोडमध्ये असतानाही पॅनेल दाखवण्याची परवानगी द्या"

msgid "(requires multi-monitors option)"
msgstr "(मल्टी-मॉनिटर पर्याय आवश्यक)"

msgid "Only hide secondary panels"
msgstr "फक्त दुय्यम पॅनेल लपवा"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "सिंटॅक्स: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Keyboard shortcut to reveal and hold the panel"
msgstr "पॅनेल दाखवण्यासाठी आणि धरून ठेवण्यासाठी कीबोर्ड शॉर्टकट"

msgid "e.g. <Super>i"
msgstr "उदा. <Super>i"

msgid "Persist state across restarts"
msgstr "रीस्टार्ट करूनही स्थिती कायम ठेवा"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(GNOME चे \"व्यत्यय आणू नका\" पाळते आणि सूचना काउंटर बॅज दाखवा हा पर्याय आवश्यक आहे)"

msgid "Reveal and hold the panel on notification"
msgstr "सूचना आल्यावर पॅनेल दाखवा आणि धरून ठेवा"

msgid "Hide and reveal animation duration (ms)"
msgstr "लपवणे आणि दाखवणे ॲनिमेशनचा कालावधी (ms)"

msgid "Delay before hiding the panel (ms)"
msgstr "पॅनेल लपवण्यापूर्वी विलंब (ms)"

msgid "Delay before revealing the panel (ms)"
msgstr "पॅनेल दाखवण्यापूर्वी विलंब (ms)"

msgid "Delay before enabling intellihide on start (ms)"
msgstr "सुरू होताना intellihide सक्षम करण्यापूर्वी विलंब (ms)"

msgid "Isolate monitors even when using a single panel"
msgstr "एकच पॅनेल वापरतानाही मॉनिटर वेगळे करा"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "gnome-shell ॲप्लिकेशन स्विचरमध्ये वर्कस्पेस वेगळे करा"

msgid "Shift+Click action"
msgstr "Shift+क्लिक क्रिया"

msgid "When set to minimize, double clicking minimizes all the windows of the application."
msgstr "लहान करा असे सेट केल्यावर, दोनदा क्लिक केल्यास ॲप्लिकेशनच्या सर्व विंडो लहान होतात."

msgid "Raise windows"
msgstr "विंडो वर आणा"

msgid "Minimize window"
msgstr "विंडो लहान करा"

msgid "Launch new instance"
msgstr "नवीन इन्स्टन्स सुरू करा"

msgid "Cycle through windows"
msgstr "विंडोमधून क्रमाने जा"

msgid "Cycle windows + minimize"
msgstr "विंडोमधून क्रमाने जा + लहान करा"

msgid "Toggle single / Preview multiple"
msgstr "एकल टॉगल करा / अनेक पूर्वावलोकन करा"

msgid "Toggle single / Cycle multiple"
msgstr "एकल टॉगल करा / अनेक क्रमाने फिरवा"

msgid "Toggle single / Spread multiple"
msgstr "एकल टॉगल करा / अनेक पसरवा"

msgid "Middle-Click action"
msgstr "मधल्या क्लिकची क्रिया"

msgid "Behavior for Middle-Click."
msgstr "मधल्या क्लिकचे वर्तन."

msgid "Shift+Middle-Click action"
msgstr "Shift+मधल्या क्लिकची क्रिया"

msgid "Behavior for Shift+Middle-Click."
msgstr "Shift+मधल्या क्लिकचे वर्तन."

msgid "Hotkeys will either be Super+Number or Super+Alt+Num"
msgstr "हॉटकी Super+क्रमांक किंवा Super+Alt+क्रमांक अशा असतील"

msgid "Hotkeys prefix"
msgstr "हॉटकी उपसर्ग"

msgid "Super"
msgstr "Super"

msgid "Super + Alt"
msgstr "Super + Alt"

msgid "Temporarily show the application numbers over the icons when using the hotkeys."
msgstr "हॉटकी वापरताना आयकॉनवर ॲप्लिकेशन क्रमांक तात्पुरते दाखवा."

msgid "Number overlay"
msgstr "क्रमांक ओव्हरले"

msgid "Never"
msgstr "कधीही नाही"

msgid "Show temporarily"
msgstr "तात्पुरते दाखवा"

msgid "Always visible"
msgstr "नेहमी दृश्यमान"

msgid "Hide timeout (ms)"
msgstr "लपवण्याची कालमर्यादा (ms)"

msgid "Shortcut to show the overlay for 2 seconds"
msgstr "ओव्हरले 2 सेकंद दाखवण्यासाठी शॉर्टकट"

msgid "e.g. <Super>q"
msgstr "उदा. <Super>q"

msgid "On secondary monitors, show the overlay on icons matching the primary monitor"
msgstr "दुय्यम मॉनिटरवर, प्राथमिक मॉनिटरशी जुळणाऱ्या आयकॉनवर ओव्हरले दाखवा"

msgid "Show the overlay on all monitors"
msgstr "सर्व मॉनिटरवर ओव्हरले दाखवा"

msgid "Show previews when the application have multiple instances"
msgstr "ॲप्लिकेशनचे अनेक इन्स्टन्स असताना पूर्वावलोकन दाखवा"

msgid "Show window previews on hotkey"
msgstr "हॉटकी दाबल्यावर विंडो पूर्वावलोकन दाखवा"

msgid "Select which keyboard number keys are used to activate the hotkeys"
msgstr "हॉटकी सक्रिय करण्यासाठी कोणत्या कीबोर्ड क्रमांक की वापरायच्या ते निवडा"

msgid "Hotkeys are activated with"
msgstr "हॉटकी यांनी सक्रिय होतात"

msgid "Number row"
msgstr "क्रमांक ओळ"

msgid "Numeric keypad"
msgstr "न्यूमेरिक कीपॅड"

msgid "Both"
msgstr "दोन्ही"

msgid "Delay between mouse scroll events (ms)"
msgstr "माउस स्क्रोल इव्हेंटमधील विलंब (ms)"

msgid "Use this value to limit the number of captured mouse scroll events."
msgstr "कॅप्चर केल्या जाणाऱ्या माउस स्क्रोल इव्हेंटची संख्या मर्यादित करण्यासाठी हे मूल्य वापरा."

msgid "Show popup when changing workspace"
msgstr "वर्कस्पेस बदलताना पॉपअप दाखवा"

msgid "This affects workspace popup when scrolling on the panel only."
msgstr "हे फक्त पॅनेलवर स्क्रोल करताना दिसणाऱ्या वर्कस्पेस पॉपअपवर परिणाम करते."

msgid "Integrate <i>AppMenu</i> items"
msgstr "<i>AppMenu</i> आयटम समाविष्ट करा"

msgid "<i>App Details</i> menu item"
msgstr "<i>ॲपचा तपशील</i> मेनू आयटम"

msgid "<i>App Details</i> is only available when Gnome Software is installed"
msgstr "<i>ॲपचा तपशील</i> फक्त GNOME Software इंस्टॉल केलेले असल्यासच उपलब्ध आहे"

msgid "Show Applications icon"
