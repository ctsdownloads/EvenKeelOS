msgstr "सर्व विंडो"

msgid "Focused windows"
msgstr "फोकस असलेल्या विंडो"

msgid "Maximized windows"
msgstr "मोठ्या केलेल्या विंडो"

msgid "Change opacity when a window gets closer than (px)"
msgstr "विंडो यापेक्षा जवळ आल्यावर अपारदर्शकता बदला (px)"

msgid "Change opacity to (%)"
msgstr "अपारदर्शकता यावर बदला (%)"

