msgid "The application titles all have the same width, even if their texts are shorter than the maximum width. The maximum width value is used as the fixed width."
msgstr "ਐਪਲੀਕੇਸ਼ਨ ਦੇ ਸਾਰੇ ਸਿਰਲੇਖਾਂ ਦੀ ਚੌੜਾਈ ਇੱਕੋ ਜਿਹੀ ਹੁੰਦੀ ਹੈ, ਭਾਵੇਂ ਉਹਨਾਂ ਦੇ ਟੈਕਸਟ ਵੱਧ ਤੋਂ ਵੱਧ ਚੌੜਾਈ ਤੋਂ ਛੋਟੇ ਹੋਣ। ਵੱਧ ਤੋਂ ਵੱਧ ਚੌੜਾਈ ਦਾ ਮੁੱਲ ਹੀ ਸਥਿਰ ਚੌੜਾਈ ਵਜੋਂ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ।"

msgid "Display running indicators on unfocused applications"
msgstr "ਫੋਕਸ ਤੋਂ ਬਿਨਾਂ ਐਪਲੀਕੇਸ਼ਨਾਂ 'ਤੇ ਚੱਲ ਰਹੇ ਦੇ ਸੂਚਕ ਵਿਖਾਓ"

msgid "Use the favorite icons as application launchers"
msgstr "ਪਸੰਦੀਦਾ ਆਈਕਾਨਾਂ ਨੂੰ ਐਪਲੀਕੇਸ਼ਨ ਲਾਂਚਰਾਂ ਵਜੋਂ ਵਰਤੋ"

msgid "Highlight AppIcon color"
msgstr "ਐਪ ਆਈਕਾਨ ਉਭਾਰ ਦਾ ਰੰਗ"

msgid "Pressed AppIcon color"
msgstr "ਦੱਬੇ ਹੋਏ ਐਪ ਆਈਕਾਨ ਦਾ ਰੰਗ"

msgid "Highlight AppIcon border radius"
msgstr "ਐਪ ਆਈਕਾਨ ਉਭਾਰ ਦੇ ਕੋਨਿਆਂ ਦਾ ਗੋਲਾਈ ਅਰਧ-ਵਿਆਸ"

