msgid "(requires multi-monitors option)"
msgstr "(ਬਹੁ-ਮਾਨੀਟਰ ਚੋਣ ਦੀ ਲੋੜ ਹੈ)"

msgid "Only hide secondary panels"
msgstr "ਸਿਰਫ਼ ਸੈਕੰਡਰੀ ਪੈਨਲ ਲੁਕਾਓ"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "ਸੰਟੈਕਸ: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Keyboard shortcut to reveal and hold the panel"
msgstr "ਪੈਨਲ ਨੂੰ ਪ੍ਰਗਟ ਕਰਨ ਅਤੇ ਟਿਕਾਈ ਰੱਖਣ ਲਈ ਕੀਬੋਰਡ ਸ਼ਾਰਟਕੱਟ"

