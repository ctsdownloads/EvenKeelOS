#, javascript-format
msgid "Quit %d Window"
msgid_plural "Quit %d Windows"
msgstr[0] "Kilépés: %d ablak"
msgstr[1] "Kilépés: %d ablak"

msgid "Gnome Settings"
msgstr "GNOME beállítások"

msgid "Dash to Panel has been updated!"
msgstr "A Dash to Panel frissítve lett!"

msgid "You are now running version"
msgstr "Most a következő verziót futtatja"

msgid "See what's new"
msgstr "Újdonságok megtekintése"

msgid "Top Bar"
msgstr "Felső sáv"

msgid "Isolate Workspaces options"
msgstr "Munkaterületek elkülönítésének beállításai"

msgid "Isolate monitors options"
msgstr "Kijelzők elszigetelésének beállításai"

msgid "Text"
msgstr "Szöveg"

msgid "Command"
msgstr "Parancs"

msgid "Remove"
msgstr "Eltávolítás"

msgid "App icon highlight options"
msgstr "Alkalmazásikon-kiemelés beállításai"

msgid "Move to current Workspace"
msgstr "Áthelyezés az aktuális munkaterületre"

msgid "Maximum width (px) of the application titles"
msgstr "Az alkalmazáscímek legnagyobb szélessége (képpont)"

msgid "(default is 160)"
msgstr "(alapértelmezetten 160)"

msgid "Highlight AppIcon color"
msgstr "Alkalmazásikon kiemelésének színe"

msgid "Pressed AppIcon color"
msgstr "Alkalmazásikon lenyomott színe"

msgid "Highlight AppIcon border radius"
msgstr "Alkalmazásikon kiemelésének sarokkerekítése"

msgid "Overrides global border radius (default is 0)"
msgstr "Felülbírálja a globális sarokkerekítést (alapértelmezetten 0)"

msgid "Only hide the panel from windows"
msgstr "A panel elrejtése csak az ablakok elől"

msgid "Overlapping"
msgstr "Átfedő"

msgid "On same monitor"
msgstr "Ugyanazon a kijelzőn"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "A kijelző szélének mutatóval való érintése előhozza a panelt"

msgid "Limit to panel length"
msgstr "Korlátozás a panel hosszára"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "A panel területe fölé mutatva a panel előhozva marad"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "Nyomás szükséges a kijelző szélénél a panel előhozásához"

msgid "(requires multi-monitors option)"
msgstr "(a többkijelzős beállítást igényli)"

msgid "Only hide secondary panels"
msgstr "Csak a másodlagos panelek elrejtése"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "Szintaxis: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Persist state across restarts"
msgstr "Állapot megőrzése újraindítások között"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(figyelembe veszi a GNOME „Ne zavarjanak” módját, és az értesítésszámláló jelvény megjelenítése beállítást igényli)"

msgid "Reveal and hold the panel on notification"
msgstr "A panel előhozása és megtartása értesítéskor"

msgid "Delay before revealing the panel (ms)"
msgstr "Késleltetés a panel előhozása előtt (ezredmásodperc)"

msgid "Isolate monitors even when using a single panel"
msgstr "Kijelzők elszigetelése egyetlen panel használatakor is"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "Munkaterületek elkülönítése a gnome-shell alkalmazásváltójában"

msgid "Toggle single / Spread multiple"
msgstr "Önálló átkapcsolása / több szétterítése"

msgid "On secondary monitors, show the overlay on icons matching the primary monitor"
msgstr "A másodlagos kijelzőkön a rátét megjelenítése az elsődleges kijelzővel egyező ikonokon"

msgid "Show the overlay on all monitors"
msgstr "A rátét megjelenítése az összes kijelzőn"

msgid "<i>App Details</i> menu item"
msgstr "<i>Alkalmazásadatok</i> menüpont"

msgid "<i>App Details</i> is only available when Gnome Software is installed"
msgstr "Az <i>Alkalmazásadatok</i> csak a GNOME Szoftverek telepítése esetén érhető el"

msgid "Show Applications icon"
msgstr "„Alkalmazások megjelenítése” ikon"

msgid "Time (ms) before showing"
msgstr "Megjelenítés előtti idő (ezredmásodperc)"

msgid "(400 is default)"
msgstr "(400 az alapértelmezett)"

msgid "Time (ms) before hiding"
msgstr "Elrejtés előtti idő (ezredmásodperc)"

msgid "(100 is default)"
msgstr "(100 az alapértelmezett)"

msgid "If disabled, the previews background have the same opacity as the panel."
msgstr "Ha le van tiltva, az előnézetek háttere ugyanolyan átlátszatlanságú, mint a panel."

