msgid "Behavior for Shift+Middle-Click."
msgstr "พฤติกรรมเมื่อกด Shift+คลิกกลาง"

msgid "Hotkeys will either be Super+Number or Super+Alt+Num"
msgstr "ปุ่มลัดจะเป็น Super+ตัวเลข หรือ Super+Alt+ตัวเลข"

msgid "Hotkeys prefix"
msgstr "คำนำหน้าปุ่มลัด"

msgid "Super"
msgstr "Super"

msgid "Super + Alt"
msgstr "Super + Alt"

msgid "Temporarily show the application numbers over the icons when using the hotkeys."
msgstr "แสดงหมายเลขแอปพลิเคชันบนไอคอนชั่วคราวเมื่อใช้ปุ่มลัด"

msgid "Number overlay"
msgstr "การซ้อนทับตัวเลข"

msgid "Never"
msgstr "ไม่เลย"

msgid "Show temporarily"
msgstr "แสดงชั่วคราว"

msgid "Always visible"
msgstr "แสดงตลอดเวลา"

msgid "Hide timeout (ms)"
