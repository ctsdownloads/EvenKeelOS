msgid "Top Bar"
msgstr "Barre supérieure"

msgid "Isolate Workspaces options"
msgstr "Options d’isolation des espaces de travail"

msgid "Isolate monitors options"
msgstr "Options d’isolation des écrans"

msgid "Move to current Workspace"
msgstr "Déplacer vers l’espace de travail actuel"

msgid "Only hide the panel from windows"
msgstr "Ne cacher le panneau que devant les fenêtres"

msgid "Overlapping"
msgstr "Chevauchement"

msgid "On same monitor"
msgstr "Sur le même écran"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "Toucher le bord de l’écran avec le pointeur affiche le panneau"

msgid "Limit to panel length"
msgstr "Limiter à la longueur du panneau"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "Survoler la zone du panneau le garde affiché"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "Exiger une pression sur le bord de l’écran pour afficher le panneau"

msgid "Delay before revealing the panel (ms)"
msgstr "Délai avant l’affichage du panneau (ms)"

msgid "Isolate monitors even when using a single panel"
msgstr "Isoler les écrans même avec un seul panneau"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "Isoler les espaces de travail dans le sélecteur d’applications de GNOME Shell"

msgid "Sponsored and originally developed by"
msgstr "Sponsorisé et développé à l’origine par"

msgid "Panel monitor position"
msgstr "Écran du panneau"

msgid "Panel border"
msgstr "Bordure du panneau"

msgid "Override border color"
msgstr "Remplacer la couleur de la bordure"

msgid "Border thickness"
msgstr "Épaisseur de la bordure"
