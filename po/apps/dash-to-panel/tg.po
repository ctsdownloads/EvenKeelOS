msgid "e.g. <Super>i"
msgstr "масалан <Super>i"

msgid "Persist state across restarts"
msgstr "Нигоҳ доштани ҳолат байни бозоғозиҳо"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
