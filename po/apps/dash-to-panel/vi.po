msgstr "Cú pháp: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Keyboard shortcut to reveal and hold the panel"
msgstr "Phím tắt để hiện và giữ bảng điều khiển"

msgid "e.g. <Super>i"
msgstr "vd. <Super>i"

msgid "Persist state across restarts"
msgstr "Giữ trạng thái sau khi khởi động lại"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
