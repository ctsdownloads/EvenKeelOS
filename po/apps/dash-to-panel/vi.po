msgstr "Thời lượng hoạt ảnh ẩn và hiện (ms)"

msgid "Delay before hiding the panel (ms)"
msgstr "Độ trễ trước khi ẩn bảng điều khiển (ms)"

msgid "Delay before revealing the panel (ms)"
msgstr "Độ trễ trước khi hiện bảng điều khiển (ms)"

msgid "Delay before enabling intellihide on start (ms)"
msgstr "Độ trễ trước khi bật intellihide khi khởi động (ms)"

