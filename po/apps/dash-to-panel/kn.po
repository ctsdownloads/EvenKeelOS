msgstr "ಆ್ಯಪ್ ಶೀರ್ಷಿಕೆಗಳ ಫಾಂಟ್ ಬಣ್ಣ"

msgid "Font color of the minimized application titles"
msgstr "ಕನಿಷ್ಠಗೊಳಿಸಿದ ಆ್ಯಪ್ ಶೀರ್ಷಿಕೆಗಳ ಫಾಂಟ್ ಬಣ್ಣ"

msgid "Maximum width (px) of the application titles"
msgstr "ಆ್ಯಪ್ ಶೀರ್ಷಿಕೆಗಳ ಗರಿಷ್ಠ ಅಗಲ (px)"

msgid "(default is 160)"
msgstr "(ಡೀಫಾಲ್ಟ್ 160)"

msgid "Use a fixed width for the application titles"
msgstr "ಆ್ಯಪ್ ಶೀರ್ಷಿಕೆಗಳಿಗೆ ಸ್ಥಿರ ಅಗಲವನ್ನು ಬಳಸಿ"

msgid "The application titles all have the same width, even if their texts are shorter than the maximum width. The maximum width value is used as the fixed width."
msgstr "ಆ್ಯಪ್ ಶೀರ್ಷಿಕೆಗಳ ಪಠ್ಯವು ಗರಿಷ್ಠ ಅಗಲಕ್ಕಿಂತ ಚಿಕ್ಕದಾಗಿದ್ದರೂ ಎಲ್ಲಾ ಶೀರ್ಷಿಕೆಗಳು ಒಂದೇ ಅಗಲವನ್ನು ಹೊಂದಿರುತ್ತವೆ. ಗರಿಷ್ಠ ಅಗಲದ ಮೌಲ್ಯವನ್ನೇ ಸ್ಥಿರ ಅಗಲವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ."

msgid "Display running indicators on unfocused applications"
msgstr "ಫೋಕಸ್ ಇಲ್ಲದ ಆ್ಯಪ್‌ಗಳಲ್ಲಿ ಚಾಲನೆ ಸೂಚಕಗಳನ್ನು ಪ್ರದರ್ಶಿಸಿ"

msgid "Use the favorite icons as application launchers"
msgstr "ಮೆಚ್ಚಿನ ಐಕಾನ್‌ಗಳನ್ನು ಆ್ಯಪ್ ಲಾಂಚರ್‌ಗಳಾಗಿ ಬಳಸಿ"

msgid "Highlight AppIcon color"
msgstr "ಆ್ಯಪ್ ಐಕಾನ್ ಬಣ್ಣವನ್ನು ಹೈಲೈಟ್ ಮಾಡಿ"

msgid "Pressed AppIcon color"
msgstr "ಒತ್ತಿದ ಆ್ಯಪ್ ಐಕಾನ್ ಬಣ್ಣ"

msgid "Highlight AppIcon border radius"
msgstr "ಆ್ಯಪ್ ಐಕಾನ್ ಹೈಲೈಟ್‌ನ ಅಂಚಿನ ತ್ರಿಜ್ಯ"

msgid "Overrides global border radius (default is 0)"
msgstr "ಜಾಗತಿಕ ಅಂಚಿನ ತ್ರಿಜ್ಯವನ್ನು ಮೀರಿಸುತ್ತದೆ (ಡೀಫಾಲ್ಟ್ 0)"

msgid "Only hide the panel from windows"
msgstr "ವಿಂಡೋಗಳಿಂದ ಮಾತ್ರ ಪ್ಯಾನೆಲ್ ಅನ್ನು ಮರೆಮಾಡಿ"

msgid "Overlapping"
msgstr "ಅತಿಕ್ರಮಿಸುವ"

msgid "On same monitor"
msgstr "ಒಂದೇ ಮಾನಿಟರ್‌ನಲ್ಲಿ"

msgid "The panel hides from"
msgstr "ಪ್ಯಾನೆಲ್ ಇದರಿಂದ ಮರೆಯಾಗುತ್ತದೆ"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "ಪಾಯಿಂಟರ್‌ನಿಂದ ಮಾನಿಟರ್‌ನ ಅಂಚನ್ನು ಸ್ಪರ್ಶಿಸಿದರೆ ಪ್ಯಾನೆಲ್ ಗೋಚರಿಸುತ್ತದೆ"

msgid "Limit to panel length"
msgstr "ಪ್ಯಾನೆಲ್ ಉದ್ದಕ್ಕೆ ಮಿತಿಗೊಳಿಸಿ"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "ಪ್ಯಾನೆಲ್ ಪ್ರದೇಶದ ಮೇಲೆ ಹೋವರ್ ಮಾಡಿದರೆ ಪ್ಯಾನೆಲ್ ಗೋಚರಿಸುತ್ತಲೇ ಇರುತ್ತದೆ"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "ಪ್ಯಾನೆಲ್ ಅನ್ನು ಗೋಚರಿಸಲು ಮಾನಿಟರ್‌ನ ಅಂಚಿನಲ್ಲಿ ಒತ್ತಡದ ಅಗತ್ಯವಿದೆ"

msgid "Required pressure threshold (px)"
msgstr "ಅಗತ್ಯವಿರುವ ಒತ್ತಡದ ಮಿತಿ (px)"

msgid "Required pressure timeout (ms)"
msgstr "ಅಗತ್ಯವಿರುವ ಒತ್ತಡದ ಸಮಯ ಮೀರುವಿಕೆ (ms)"

msgid "Allow the panel to be revealed while in fullscreen mode"
msgstr "ಪೂರ್ಣಪರದೆ ಮೋಡ್‌ನಲ್ಲಿರುವಾಗಲೂ ಪ್ಯಾನೆಲ್ ಗೋಚರಿಸಲು ಅನುಮತಿಸಿ"

msgid "(requires multi-monitors option)"
msgstr "(ಬಹು-ಮಾನಿಟರ್ ಆಯ್ಕೆಯ ಅಗತ್ಯವಿದೆ)"

msgid "Only hide secondary panels"
msgstr "ದ್ವಿತೀಯ ಪ್ಯಾನೆಲ್‌ಗಳನ್ನು ಮಾತ್ರ ಮರೆಮಾಡಿ"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "ಸಿಂಟ್ಯಾಕ್ಸ್: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Keyboard shortcut to reveal and hold the panel"
msgstr "ಪ್ಯಾನೆಲ್ ಅನ್ನು ಗೋಚರಿಸಲು ಮತ್ತು ಹಿಡಿದಿಡಲು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್"

msgid "e.g. <Super>i"
msgstr "ಉದಾ. <Super>i"

msgid "Persist state across restarts"
msgstr "ಮರುಪ್ರಾರಂಭಗಳಾದ್ಯಂತ ಸ್ಥಿತಿಯನ್ನು ಉಳಿಸಿಕೊಳ್ಳಿ"

