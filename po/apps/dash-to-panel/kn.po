msgstr "ಆ್ಯಪ್ ಶೀರ್ಷಿಕೆಗಳ ಫಾಂಟ್ ತೂಕ"

msgid "inherit from theme"
msgstr "ಥೀಮ್‌ನಿಂದ ಪಡೆಯಿರಿ"

msgid "normal"
msgstr "ಸಾಮಾನ್ಯ"

msgid "lighter"
msgstr "ತೆಳು"

msgid "bold"
msgstr "ದಪ್ಪ"

msgid "bolder"
msgstr "ಇನ್ನಷ್ಟು ದಪ್ಪ"

