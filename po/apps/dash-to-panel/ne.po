msgstr "0"

msgid "Opacity change animation duration (ms)"
msgstr "अपारदर्शिता परिवर्तन एनिमेसनको अवधि (ms)"

msgid "Font size (px) of the application titles (default is 14)"
msgstr "एप शीर्षकहरूको फन्ट आकार (px) (पूर्वनिर्धारित १४ हो)"

msgid "Font weight of application titles"
msgstr "एप शीर्षकहरूको फन्ट वजन"

msgid "inherit from theme"
msgstr "थिमबाट लिनुहोस्"

msgid "normal"
msgstr "सामान्य"

msgid "lighter"
msgstr "हल्का"

msgid "bold"
msgstr "बोल्ड"

msgid "bolder"
msgstr "अझ बोल्ड"

msgid "Font color of the application titles"
msgstr "एप शीर्षकहरूको फन्ट रङ"

msgid "Font color of the minimized application titles"
msgstr "सानो पारिएका एप शीर्षकहरूको फन्ट रङ"

msgid "Maximum width (px) of the application titles"
msgstr "एप शीर्षकहरूको अधिकतम चौडाइ (px)"

msgid "(default is 160)"
msgstr "(पूर्वनिर्धारित १६० हो)"

msgid "Use a fixed width for the application titles"
msgstr "एप शीर्षकहरूका लागि निश्चित चौडाइ प्रयोग गर्नुहोस्"

msgid "The application titles all have the same width, even if their texts are shorter than the maximum width. The maximum width value is used as the fixed width."
msgstr "एप शीर्षकहरूको पाठ अधिकतम चौडाइभन्दा छोटो भए पनि सबै शीर्षकको चौडाइ बराबर हुन्छ। अधिकतम चौडाइको मान नै निश्चित चौडाइका रूपमा प्रयोग गरिन्छ।"

msgid "Display running indicators on unfocused applications"
msgstr "फोकस नभएका एपहरूमा चलिरहेको सूचक देखाउनुहोस्"

msgid "Use the favorite icons as application launchers"
msgstr "मनपर्ने आइकनहरूलाई एप लन्चरका रूपमा प्रयोग गर्नुहोस्"

msgid "Highlight AppIcon color"
msgstr "एप आइकनको हाइलाइट रङ"

msgid "Pressed AppIcon color"
msgstr "एप आइकन थिच्दाको रङ"

msgid "Highlight AppIcon border radius"
msgstr "एप आइकनको हाइलाइट किनाराको गोलाइ"

msgid "Overrides global border radius (default is 0)"
msgstr "विश्वव्यापी किनाराको गोलाइलाई ओभरराइड गर्छ (पूर्वनिर्धारित ० हो)"

msgid "Only hide the panel from windows"
msgstr "विन्डोहरूबाट मात्र प्यानल लुकाउनुहोस्"

msgid "Overlapping"
msgstr "ओभरल्याप हुँदा"

msgid "On same monitor"
msgstr "उही मोनिटरमा"

msgid "The panel hides from"
msgstr "प्यानल यसबाट लुक्छ"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "मोनिटरको किनारामा पोइन्टर छुँदा प्यानल देखिन्छ"

msgid "Limit to panel length"
msgstr "प्यानलको लम्बाइमा सीमित गर्नुहोस्"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "प्यानल क्षेत्रमा होभर गर्दा प्यानल देखिइरहन्छ"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "प्यानल देखाउन मोनिटरको किनारामा दबाब आवश्यक पर्छ"

msgid "Required pressure threshold (px)"
msgstr "आवश्यक दबाबको सीमा (px)"

msgid "Required pressure timeout (ms)"
msgstr "आवश्यक दबाबको समयसीमा (ms)"

msgid "Allow the panel to be revealed while in fullscreen mode"
msgstr "पूर्ण स्क्रिन मोडमा प्यानल देखिन दिनुहोस्"

msgid "(requires multi-monitors option)"
msgstr "(बहु-मोनिटर विकल्प आवश्यक पर्छ)"

msgid "Only hide secondary panels"
msgstr "दोस्रो प्यानलहरू मात्र लुकाउनुहोस्"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "सिन्ट्याक्स: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Keyboard shortcut to reveal and hold the panel"
msgstr "प्यानल देखाउन र रोक्न किबोर्ड सर्टकट"

msgid "e.g. <Super>i"
msgstr "उदाहरण: <Super>i"

msgid "Persist state across restarts"
msgstr "रिस्टार्टपछि पनि अवस्था कायम राख्नुहोस्"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(GNOME को ‘बाधा नपुर्‍याउनुहोस्’ को सम्मान गर्छ र सूचना काउन्टर ब्याज देखाउने विकल्प आवश्यक पर्छ)"

msgid "Reveal and hold the panel on notification"
msgstr "सूचना आउँदा प्यानल देखाउनुहोस् र रोक्नुहोस्"

msgid "Hide and reveal animation duration (ms)"
msgstr "लुकाउने र देखाउने एनिमेसनको अवधि (ms)"

msgid "Delay before hiding the panel (ms)"
msgstr "प्यानल लुकाउनुअघिको ढिलाइ (ms)"

msgid "Delay before revealing the panel (ms)"
msgstr "प्यानल देखाउनुअघिको ढिलाइ (ms)"

msgid "Delay before enabling intellihide on start (ms)"
msgstr "सुरुमा intellihide सक्रिय गर्नुअघिको ढिलाइ (ms)"

msgid "Isolate monitors even when using a single panel"
msgstr "एउटै प्यानल प्रयोग गर्दा पनि मोनिटरहरू अलग गर्नुहोस्"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "gnome-shell एप स्विचरमा कार्यस्थानहरू अलग गर्नुहोस्"

msgid "Shift+Click action"
msgstr "Shift+क्लिक कार्य"

msgid "When set to minimize, double clicking minimizes all the windows of the application."
msgstr "सानो बनाउने भनी सेट गरिएको बेला डबल क्लिक गर्दा एपका सबै विन्डोहरू सानो हुन्छन्।"

msgid "Raise windows"
msgstr "विन्डोहरू माथि ल्याउनुहोस्"

msgid "Minimize window"
msgstr "विन्डो सानो बनाउनुहोस्"

msgid "Launch new instance"
msgstr "नयाँ इन्स्टेन्स सुरु गर्नुहोस्"

msgid "Cycle through windows"
msgstr "विन्डोहरू क्रमैसँग फेर्नुहोस्"

msgid "Cycle windows + minimize"
msgstr "विन्डोहरू क्रमैसँग फेर्नुहोस् + सानो बनाउनुहोस्"

msgid "Toggle single / Preview multiple"
msgstr "एउटा भए टगल / धेरै भए पूर्वावलोकन"

msgid "Toggle single / Cycle multiple"
msgstr "एउटा भए टगल / धेरै भए क्रमैसँग फेर्नुहोस्"

msgid "Toggle single / Spread multiple"
msgstr "एउटा भए टगल / धेरै भए फैलाउनुहोस्"

msgid "Middle-Click action"
msgstr "बिचको क्लिक कार्य"

msgid "Behavior for Middle-Click."
msgstr "बिचको क्लिकको व्यवहार।"

msgid "Shift+Middle-Click action"
msgstr "Shift+बिचको क्लिक कार्य"

msgid "Behavior for Shift+Middle-Click."
msgstr "Shift+बिचको क्लिकको व्यवहार।"

msgid "Hotkeys will either be Super+Number or Super+Alt+Num"
msgstr "हटकीहरू Super+नम्बर वा Super+Alt+नम्बर हुनेछन्"

msgid "Hotkeys prefix"
msgstr "हटकी उपसर्ग"

msgid "Super"
msgstr "Super"

msgid "Super + Alt"
msgstr "Super + Alt"

msgid "Temporarily show the application numbers over the icons when using the hotkeys."
msgstr "हटकी प्रयोग गर्दा एप नम्बरहरू आइकनमाथि केही समयका लागि देखाउनुहोस्।"

msgid "Number overlay"
msgstr "नम्बर ओभरले"

msgid "Never"
msgstr "कहिल्यै होइन"

msgid "Show temporarily"
msgstr "केही समय देखाउनुहोस्"

msgid "Always visible"
msgstr "सधैँ देखिने"

msgid "Hide timeout (ms)"
msgstr "लुकाउने समयसीमा (ms)"

msgid "Shortcut to show the overlay for 2 seconds"
msgstr "ओभरले २ सेकेन्डका लागि देखाउने सर्टकट"

msgid "e.g. <Super>q"
msgstr "उदाहरण: <Super>q"

msgid "On secondary monitors, show the overlay on icons matching the primary monitor"
msgstr "दोस्रो मोनिटरमा, प्राथमिक मोनिटरसँग मेल खाने आइकनहरूमा ओभरले देखाउनुहोस्"

msgid "Show the overlay on all monitors"
msgstr "सबै मोनिटरमा ओभरले देखाउनुहोस्"

msgid "Show previews when the application have multiple instances"
msgstr "एपका धेरै इन्स्टेन्सहरू हुँदा पूर्वावलोकन देखाउनुहोस्"

msgid "Show window previews on hotkey"
msgstr "हटकी थिच्दा विन्डो पूर्वावलोकन देखाउनुहोस्"

msgid "Select which keyboard number keys are used to activate the hotkeys"
msgstr "हटकी सक्रिय गर्न कुन किबोर्ड नम्बर कुञ्जीहरू प्रयोग गर्ने छान्नुहोस्"

msgid "Hotkeys are activated with"
msgstr "हटकीहरू यसबाट सक्रिय हुन्छन्"

msgid "Number row"
msgstr "नम्बर पङ्क्ति"

msgid "Numeric keypad"
msgstr "न्युमेरिक किप्याड"

msgid "Both"
msgstr "दुवै"

msgid "Delay between mouse scroll events (ms)"
msgstr "माउस स्क्रोल इभेन्टहरूबीचको ढिलाइ (ms)"

msgid "Use this value to limit the number of captured mouse scroll events."
msgstr "कैद गरिने माउस स्क्रोल इभेन्टहरूको सङ्ख्या सीमित गर्न यो मान प्रयोग गर्नुहोस्।"

msgid "Show popup when changing workspace"
