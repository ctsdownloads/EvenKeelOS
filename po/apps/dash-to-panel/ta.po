msgstr "பயன்பாட்டு ஐகான் சிறப்பொளிர்வு விருப்பங்கள்"

msgid "Export settings"
msgstr "அமைவுகளை ஏற்றுமதி செய்"

msgid "Import settings"
msgstr "அமைவுகளை இறக்குமதி செய்"

msgid "Move to current Workspace"
msgstr "தற்போதைய பணியிடத்துக்கு நகர்த்து"

msgid "Animation type"
msgstr "அசைவூட்ட வகை"

msgid "Simple"
msgstr "எளிமையானது"

msgid "Ripple"
msgstr "அலை"

msgid "Plank"
msgstr "Plank"

msgid "Duration"
msgstr "கால அளவு"

msgid "Rotation"
msgstr "சுழற்சி"

msgid "Travel"
msgstr "பயணம்"

msgid "Zoom"
msgstr "பெரிதாக்கம்"

msgid "Convexity"
msgstr "குவிவு"

msgid "Extent"
msgstr "அளவு"

msgid "Highlight focused application"
msgstr "கவனம் உள்ள பயன்பாட்டைச் சிறப்பொளிரச் செய்"

msgid "Icon dominant color"
msgstr "ஐகானின் முதன்மை நிறம்"

msgid "Custom color"
msgstr "தனிப்பயன் நிறம்"

msgid "Highlight opacity"
msgstr "சிறப்பொளிர்வு ஒளிபுகாமை"

msgid "Indicator size (px)"
msgstr "குறிகாட்டி அளவு (px)"

msgid "Indicator color - Icon Dominant"
msgstr "குறிகாட்டி நிறம் - ஐகானின் முதன்மை நிறம்"

msgid "Indicator color - Override Theme"
msgstr "குறிகாட்டி நிறம் - தீமை மேலெழுது"

msgid "1 window open (or ungrouped)"
msgstr "1 சாளரம் திறந்துள்ளது (அல்லது குழுவாக்கப்படவில்லை)"

msgid "Apply to all"
msgstr "அனைத்துக்கும் பொருத்து"

msgid "2 windows open"
msgstr "2 சாளரங்கள் திறந்துள்ளன"

msgid "3 windows open"
msgstr "3 சாளரங்கள் திறந்துள்ளன"

msgid "4+ windows open"
msgstr "4+ சாளரங்கள் திறந்துள்ளன"

msgid "Use different for unfocused"
msgstr "கவனம் இல்லாதவற்றுக்கு வேறுபடுத்திப் பயன்படுத்து"

msgid "The panel background opacity is affected by"
msgstr "பலகைப் பின்னணி ஒளிபுகாமையைப் பாதிப்பது"

msgid "All windows"
msgstr "அனைத்துச் சாளரங்கள்"

msgid "Focused windows"
msgstr "கவனம் உள்ள சாளரங்கள்"

msgid "Maximized windows"
msgstr "பெரிதாக்கிய சாளரங்கள்"

msgid "Change opacity when a window gets closer than (px)"
msgstr "சாளரம் இதைவிட நெருங்கும்போது ஒளிபுகாமையை மாற்று (px)"

msgid "Change opacity to (%)"
msgstr "ஒளிபுகாமையை இதற்கு மாற்று (%)"

msgid "0"
msgstr "0"

msgid "Opacity change animation duration (ms)"
msgstr "ஒளிபுகாமை மாற்ற அசைவூட்டக் கால அளவு (ms)"

msgid "Font size (px) of the application titles (default is 14)"
msgstr "பயன்பாட்டுத் தலைப்புகளின் எழுத்துரு அளவு (px) (முன்னிருப்பு 14)"

msgid "Font weight of application titles"
msgstr "பயன்பாட்டுத் தலைப்புகளின் எழுத்துரு எடை"

msgid "inherit from theme"
msgstr "தீமிலிருந்து பெறு"

msgid "normal"
msgstr "இயல்பு"

msgid "lighter"
msgstr "மெலிந்தது"

msgid "bold"
msgstr "தடித்தது"

msgid "bolder"
msgstr "மிகத் தடித்தது"

msgid "Font color of the application titles"
msgstr "பயன்பாட்டுத் தலைப்புகளின் எழுத்துரு நிறம்"

msgid "Font color of the minimized application titles"
msgstr "சிறிதாக்கிய பயன்பாட்டுத் தலைப்புகளின் எழுத்துரு நிறம்"

msgid "Maximum width (px) of the application titles"
msgstr "பயன்பாட்டுத் தலைப்புகளின் அதிகபட்ச அகலம் (px)"

msgid "(default is 160)"
msgstr "(முன்னிருப்பு 160)"

msgid "Use a fixed width for the application titles"
msgstr "பயன்பாட்டுத் தலைப்புகளுக்கு நிலையான அகலத்தைப் பயன்படுத்து"

msgid "The application titles all have the same width, even if their texts are shorter than the maximum width. The maximum width value is used as the fixed width."
msgstr "உரைகள் அதிகபட்ச அகலத்தைவிடக் குறைவாக இருந்தாலும், பயன்பாட்டுத் தலைப்புகள் அனைத்தும் ஒரே அகலத்தில் இருக்கும். அதிகபட்ச அகல மதிப்பே நிலையான அகலமாகப் பயன்படுத்தப்படும்."

msgid "Display running indicators on unfocused applications"
msgstr "கவனம் இல்லாத பயன்பாடுகளில் இயங்கும் குறிகாட்டிகளைக் காட்டு"

msgid "Use the favorite icons as application launchers"
msgstr "பிடித்த ஐகான்களைப் பயன்பாட்டு ஏவிகளாகப் பயன்படுத்து"

msgid "Highlight AppIcon color"
msgstr "AppIcon சிறப்பொளிர்வு நிறம்"

msgid "Pressed AppIcon color"
msgstr "AppIcon அழுத்திய நிறம்"

msgid "Highlight AppIcon border radius"
msgstr "AppIcon சிறப்பொளிர்வு விளிம்பு ஆரம்"

msgid "Overrides global border radius (default is 0)"
msgstr "உலகளாவிய விளிம்பு ஆரத்தை மேலெழுதும் (முன்னிருப்பு 0)"

msgid "Only hide the panel from windows"
msgstr "சாளரங்களிலிருந்து மட்டும் பலகையை மறை"

msgid "Overlapping"
msgstr "மேற்பொருந்துதல்"

msgid "On same monitor"
msgstr "அதே திரையில்"

msgid "The panel hides from"
msgstr "பலகை மறையும் இடம்"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "சுட்டியால் திரையின் விளிம்பைத் தொட்டால் பலகை தோன்றும்"

msgid "Limit to panel length"
msgstr "பலகையின் நீளத்துக்குக் கட்டுப்படுத்து"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "பலகைப் பகுதியின் மேல் சுட்டியை வைத்திருந்தால் பலகை தெரிந்தபடி இருக்கும்"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "பலகையைத் தோன்றச் செய்ய திரையின் விளிம்பில் அழுத்தம் தேவை"

msgid "Required pressure threshold (px)"
msgstr "தேவையான அழுத்த வரம்பு (px)"

msgid "Required pressure timeout (ms)"
msgstr "தேவையான அழுத்தக் காலக்கெடு (ms)"

msgid "Allow the panel to be revealed while in fullscreen mode"
msgstr "முழுத்திரைப் பயன்முறையில் இருக்கும்போதும் பலகை தோன்ற அனுமதி"

msgid "(requires multi-monitors option)"
msgstr "(பல திரை விருப்பம் தேவை)"

msgid "Only hide secondary panels"
msgstr "இரண்டாம்நிலைப் பலகைகளை மட்டும் மறை"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "தொடரியல்: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Keyboard shortcut to reveal and hold the panel"
msgstr "பலகையைத் தோன்றச் செய்து நிறுத்தி வைக்கும் விசைப்பலகைக் குறுக்குவழி"

msgid "e.g. <Super>i"
msgstr "எ.கா. <Super>i"

msgid "Persist state across restarts"
msgstr "மறுதொடக்கங்களுக்கு இடையிலும் நிலையைத் தக்கவை"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(GNOME-இன் \"தொந்தரவு செய்யாதே\" நிலையை மதிக்கும்; அறிவிப்பு எண்ணிக்கை பேட்ஜைக் காட்டு விருப்பம் தேவை)"

msgid "Reveal and hold the panel on notification"
msgstr "அறிவிப்பு வரும்போது பலகையைத் தோன்றச் செய்து நிறுத்தி வை"

msgid "Hide and reveal animation duration (ms)"
msgstr "மறைதல் மற்றும் தோன்றுதல் அசைவூட்டக் கால அளவு (ms)"

msgid "Delay before hiding the panel (ms)"
msgstr "பலகையை மறைப்பதற்கு முன் தாமதம் (ms)"

msgid "Delay before revealing the panel (ms)"
msgstr "பலகையைத் தோன்றச் செய்வதற்கு முன் தாமதம் (ms)"

msgid "Delay before enabling intellihide on start (ms)"
msgstr "தொடக்கத்தில் intellihide-ஐ இயக்குவதற்கு முன் தாமதம் (ms)"

msgid "Isolate monitors even when using a single panel"
msgstr "ஒரே பலகை இருந்தாலும் திரைகளைத் தனிமைப்படுத்து"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "gnome-shell பயன்பாட்டு மாற்றியில் பணியிடங்களைத் தனிமைப்படுத்து"

msgid "Shift+Click action"
msgstr "Shift+சொடுக்கு செயல்"

msgid "When set to minimize, double clicking minimizes all the windows of the application."
