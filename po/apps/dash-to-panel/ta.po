msgstr "இயங்கும் குறிகாட்டி விருப்பங்கள்"

msgid "Dynamic opacity options"
msgstr "இயக்கநிலை ஒளிபுகாமை விருப்பங்கள்"

msgid "Intellihide options"
msgstr "Intellihide விருப்பங்கள்"

msgid "Window preview options"
msgstr "சாளர முன்னோட்ட விருப்பங்கள்"

msgid "Isolate Workspaces options"
msgstr "பணியிடங்களைத் தனிமைப்படுத்தும் விருப்பங்கள்"

msgid "Isolate monitors options"
msgstr "திரைகளைத் தனிமைப்படுத்தும் விருப்பங்கள்"

msgid "Ungrouped application options"
msgstr "குழுவாக்காத பயன்பாட்டு விருப்பங்கள்"

msgid "Customize middle-click behavior"
msgstr "நடுச் சொடுக்கு நடத்தையைத் தனிப்பயனாக்கு"

msgid "Text"
msgstr "உரை"

msgid "Command"
msgstr "கட்டளை"

msgid "Remove"
msgstr "அகற்று"

msgid "Customize panel scroll behavior"
msgstr "பலகை உருள் நடத்தையைத் தனிப்பயனாக்கு"

msgid "Customize icon scroll behavior"
msgstr "ஐகான் உருள் நடத்தையைத் தனிப்பயனாக்கு"

msgid "Advanced hotkeys options"
msgstr "மேம்பட்ட ஹாட்கீ விருப்பங்கள்"

msgid "Secondary Menu Options"
msgstr "இரண்டாம்நிலைப் பட்டி விருப்பங்கள்"

