msgid "(requires multi-monitors option)"
msgstr "(teastaíonn an rogha ilmhonatóirí)"

msgid "Only hide secondary panels"
msgstr "Ná folaigh ach na painéil thánaisteacha"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "Comhréir: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Keyboard shortcut to reveal and hold the panel"
msgstr "Aicearra méarchlár chun an painéal a thaispeáint agus a choinneáil"

msgid "e.g. <Super>i"
msgstr "m.sh. <Super>i"

msgid "Persist state across restarts"
msgstr "Coinnigh an staid idir atosuithe"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(urramaíonn sé “Ná Cuir Isteach Orm” GNOME agus teastaíonn an rogha baitsí cuntair fógraí uaidh)"

