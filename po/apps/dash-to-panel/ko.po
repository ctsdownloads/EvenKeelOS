#, javascript-format
msgid "Quit %d Window"
msgid_plural "Quit %d Windows"
msgstr[0] "창 %d개 종료"

msgid "Gnome Settings"
msgstr "GNOME 설정"

msgid "Dash to Panel has been updated!"
msgstr "Dash to Panel이 업데이트되었습니다!"

msgid "You are now running version"
msgstr "현재 실행 중인 버전:"

msgid "See what's new"
msgstr "새로운 기능 보기"

msgid "Top Bar"
msgstr "상단 바"

msgid "Isolate Workspaces options"
msgstr "작업 공간 분리 옵션"

msgid "Isolate monitors options"
msgstr "모니터 분리 옵션"

msgid "Text"
msgstr "텍스트"

msgid "Command"
msgstr "명령"

msgid "Remove"
msgstr "제거"

msgid "App icon highlight options"
msgstr "앱 아이콘 강조 옵션"

msgid "Move to current Workspace"
msgstr "현재 작업 공간으로 이동"

msgid "Maximum width (px) of the application titles"
msgstr "앱 제목의 최대 너비(px)"

msgid "(default is 160)"
msgstr "(기본값은 160)"

msgid "Highlight AppIcon color"
msgstr "앱 아이콘 강조 색상"

msgid "Pressed AppIcon color"
msgstr "앱 아이콘 눌림 색상"

msgid "Highlight AppIcon border radius"
msgstr "앱 아이콘 강조 테두리 반지름"

msgid "Overrides global border radius (default is 0)"
msgstr "전역 테두리 반지름을 덮어씁니다 (기본값은 0)"

msgid "Only hide the panel from windows"
msgstr "창에서만 패널 숨기기"

msgid "Overlapping"
msgstr "겹침"

msgid "On same monitor"
msgstr "같은 모니터에서"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "포인터로 모니터 가장자리를 건드리면 패널이 나타납니다"

msgid "Limit to panel length"
msgstr "패널 길이로 제한"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "패널 영역에 마우스를 올리면 패널이 계속 표시됩니다"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "패널을 나타내려면 모니터 가장자리에 압력이 필요함"

msgid "(requires multi-monitors option)"
msgstr "(다중 모니터 옵션 필요)"

msgid "Only hide secondary panels"
msgstr "보조 패널만 숨기기"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "구문: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Persist state across restarts"
msgstr "다시 시작해도 상태 유지"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(GNOME의 \"방해 금지\" 설정을 따르며 알림 카운터 배지 표시 옵션이 필요합니다)"

msgid "Reveal and hold the panel on notification"
msgstr "알림이 오면 패널을 나타내고 유지"

msgid "Delay before revealing the panel (ms)"
msgstr "패널을 나타내기 전 지연 시간(ms)"

msgid "Isolate monitors even when using a single panel"
msgstr "패널이 하나일 때도 모니터 분리"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "gnome-shell 앱 전환기에서 작업 공간 분리"

msgid "Toggle single / Spread multiple"
msgstr "하나만 보기 / 여러 개 펼치기 전환"

msgid "On secondary monitors, show the overlay on icons matching the primary monitor"
msgstr "보조 모니터에서는 기본 모니터와 일치하는 아이콘에 오버레이 표시"

msgid "Show the overlay on all monitors"
msgstr "모든 모니터에 오버레이 표시"

msgid "<i>App Details</i> menu item"
msgstr "<i>앱 정보</i> 메뉴 항목"

msgid "<i>App Details</i> is only available when Gnome Software is installed"
msgstr "<i>앱 정보</i>는 GNOME 소프트웨어가 설치되어 있을 때만 사용할 수 있습니다"

msgid "Show Applications icon"
msgstr "앱 보기 아이콘"

msgid "Time (ms) before showing"
msgstr "표시 전 시간(ms)"

msgid "(400 is default)"
msgstr "(기본값은 400)"

msgid "Time (ms) before hiding"
msgstr "숨기기 전 시간(ms)"

msgid "(100 is default)"
msgstr "(기본값은 100)"

msgid "If disabled, the previews background have the same opacity as the panel."
msgstr "사용하지 않으면 미리보기 배경의 불투명도가 패널과 같아집니다."

