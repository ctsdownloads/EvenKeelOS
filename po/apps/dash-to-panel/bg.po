msgid "(requires multi-monitors option)"
msgstr "(изисква опцията за няколко монитора)"

msgid "Only hide secondary panels"
msgstr "Скриване само на второстепенните панели"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "Синтаксис: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Keyboard shortcut to reveal and hold the panel"
msgstr "Клавишна комбинация за показване и задържане на панела"

msgid "e.g. <Super>i"
msgstr "напр. <Super>i"

msgid "Persist state across restarts"
msgstr "Запомняне на състоянието между рестартиранията"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(съобразява се с режима „Не ме безпокойте“ на GNOME и изисква опцията за значка с брояч на известията)"

msgid "Reveal and hold the panel on notification"
