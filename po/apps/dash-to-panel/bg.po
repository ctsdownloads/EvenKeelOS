msgid "Overlapping"
msgstr "Припокриващи се"

msgid "On same monitor"
msgstr "На същия монитор"

msgid "The panel hides from"
msgstr "Панелът се скрива от"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "Докосването на ръба на монитора с показалеца показва панела"

msgid "Limit to panel length"
msgstr "Ограничаване до дължината на панела"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "Задържането на показалеца над панела го държи показан"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "Изискване на натиск при ръба на монитора за показване на панела"

msgid "Required pressure threshold (px)"
msgstr "Необходим праг на натиск (px)"

msgid "Required pressure timeout (ms)"
msgstr "Необходимо време за изчакване на натиска (ms)"

msgid "Allow the panel to be revealed while in fullscreen mode"
