#, javascript-format
msgid "Quit %d Window"
msgid_plural "Quit %d Windows"
msgstr[0] "خروج از %d پنجره"

msgid "Power options"
msgstr "گزینه‌های توان"

msgid "Event logs"
msgstr "گزارش رویدادها"

msgid "System"
msgstr "سامانه"

msgid "Device Management"
msgstr "مدیریت دستگاه"

msgid "Disk Management"
msgstr "مدیریت دیسک"

msgid "Gnome Settings"
msgstr "تنظیمات GNOME"

msgid "Dash to Panel has been updated!"
msgstr "Dash to Panel به‌روز شد!"

msgid "You are now running version"
msgstr "اکنون نسخهٔ زیر را اجرا می‌کنید"

msgid "See what's new"
msgstr "دیدن تازه‌ها"

msgid "Top Bar"
msgstr "نوار بالا"

msgid "Isolate Workspaces options"
msgstr "گزینه‌های جداسازی فضاهای کاری"

msgid "Isolate monitors options"
msgstr "گزینه‌های جداسازی نمایشگرها"

msgid "Text"
msgstr "متن"

msgid "Command"
msgstr "فرمان"

msgid "Remove"
msgstr "حذف"

msgid "App icon highlight options"
msgstr "گزینه‌های برجسته‌سازی نقشک برنامه"

msgid "Move to current Workspace"
msgstr "انتقال به فضای کاری کنونی"

msgid "The panel background opacity is affected by"
msgstr "کدری پس‌زمینهٔ تابلو تحت تأثیر این است"

msgid "Change opacity when a window gets closer than (px)"
msgstr "تغییر کدری وقتی پنجره نزدیک‌تر از این مقدار (پیکسل) شود"

msgid "Maximum width (px) of the application titles"
msgstr "بیشینهٔ عرض (پیکسل) عنوان برنامه‌ها"

msgid "(default is 160)"
msgstr "(پیش‌گزیده ۱۶۰ است)"

msgid "Highlight AppIcon color"
msgstr "رنگ برجستهٔ نقشک برنامه"

msgid "Pressed AppIcon color"
msgstr "رنگ نقشک برنامه هنگام فشردن"

msgid "Highlight AppIcon border radius"
msgstr "شعاع گوشهٔ برجستهٔ نقشک برنامه"

msgid "Overrides global border radius (default is 0)"
msgstr "شعاع گوشهٔ سراسری را نادیده می‌گیرد (پیش‌گزیده ۰ است)"

msgid "Only hide the panel from windows"
msgstr "فقط وقتی تابلو پنهان شود که پنجره‌ها روی آن باشند"

msgid "Overlapping"
msgstr "هم‌پوشان"

msgid "On same monitor"
msgstr "روی همان نمایشگر"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "رساندن اشاره‌گر به لبهٔ نمایشگر، تابلو را آشکار می‌کند"

msgid "Limit to panel length"
msgstr "محدود به طول تابلو"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "شناور بودن روی ناحیهٔ تابلو آن را آشکار نگه می‌دارد"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "برای آشکارشدن تابلو، فشار در لبهٔ نمایشگر لازم است"

msgid "Required pressure threshold (px)"
msgstr "آستانهٔ فشار لازم (پیکسل)"

msgid "Required pressure timeout (ms)"
msgstr "مهلت فشار لازم (میلی‌ثانیه)"

msgid "(requires multi-monitors option)"
msgstr "(نیازمند گزینهٔ چندنمایشگره است)"

msgid "Only hide secondary panels"
msgstr "فقط پنهان‌کردن تابلوهای ثانویه"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "نحو: &lt;Shift&gt;، &lt;Ctrl&gt;، &lt;Alt&gt;، &lt;Super&gt;"

msgid "e.g. <Super>i"
msgstr "مثلاً <Super>i"

msgid "Persist state across restarts"
msgstr "حفظ وضعیت میان راه‌اندازی‌های دوباره"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(از «مزاحم نشوید» در GNOME پیروی می‌کند و گزینهٔ نمایش نشان شمارندهٔ اعلان لازم است)"

msgid "Reveal and hold the panel on notification"
msgstr "آشکارکردن و نگه‌داشتن تابلو هنگام اعلان"

msgid "Delay before revealing the panel (ms)"
msgstr "تأخیر پیش از آشکارکردن تابلو (میلی‌ثانیه)"

msgid "Isolate monitors even when using a single panel"
msgstr "جداسازی نمایشگرها حتی هنگام استفاده از یک تابلو"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "جداسازی فضاهای کاری در جابه‌جاگر برنامه‌های gnome-shell"

msgid "Toggle single / Spread multiple"
msgstr "تغییر وضعیت یکی / پخش چندتا"

msgid "Hotkeys will either be Super+Number or Super+Alt+Num"
msgstr "کلیدهای میانبر یا Super+عدد خواهند بود یا Super+Alt+عدد"

msgid "Hotkeys prefix"
msgstr "پیشوند کلیدهای میانبر"

msgid "Temporarily show the application numbers over the icons when using the hotkeys."
msgstr "نمایش موقت شمارهٔ برنامه‌ها روی نقشک‌ها هنگام استفاده از کلیدهای میانبر."

msgid "Number overlay"
msgstr "پوشش شماره"

msgid "Shortcut to show the overlay for 2 seconds"
msgstr "میانبر برای نمایش پوشش به مدت ۲ ثانیه"

msgid "e.g. <Super>q"
msgstr "مثلاً <Super>q"

msgid "On secondary monitors, show the overlay on icons matching the primary monitor"
msgstr "در نمایشگرهای ثانویه، پوشش را روی نقشک‌های منطبق با نمایشگر اصلی نشان بده"

msgid "Show the overlay on all monitors"
msgstr "نمایش پوشش روی همهٔ نمایشگرها"

msgid "Show previews when the application have multiple instances"
msgstr "نمایش پیش‌نمایش‌ها وقتی برنامه چند نمونه دارد"

msgid "Show window previews on hotkey"
msgstr "نمایش پیش‌نمایش پنجره‌ها با کلید میانبر"

msgid "Select which keyboard number keys are used to activate the hotkeys"
msgstr "انتخاب کنید کدام کلیدهای عددی صفحه‌کلید برای فعال‌کردن کلیدهای میانبر به کار روند"

msgid "Hotkeys are activated with"
msgstr "کلیدهای میانبر فعال می‌شوند با"

msgid "Number row"
msgstr "ردیف اعداد"

msgid "Numeric keypad"
msgstr "صفحهٔ کلید عددی"

msgid "This affects workspace popup when scrolling on the panel only."
msgstr "این فقط بر پنجرهٔ بازشوی فضای کاری هنگام لغزاندن روی تابلو اثر می‌گذارد."

msgid "Integrate <i>AppMenu</i> items"
msgstr "یکپارچه‌سازی موارد <i>منوی برنامه</i>"

msgid "<i>App Details</i> menu item"
msgstr "مورد منوی <i>جزئیات برنامه</i>"

msgid "<i>App Details</i> is only available when Gnome Software is installed"
msgstr "<i>جزئیات برنامه</i> فقط وقتی در دسترس است که GNOME Software نصب باشد"

msgid "Show Applications icon"
msgstr "نمایش نقشک برنامه‌ها"

msgid "Reveal the desktop when hovering the Show Desktop button"
msgstr "آشکارکردن میزکار هنگام شناور شدن روی دکمهٔ نمایش میزکار"

msgid "Delay before revealing the desktop (ms)"
msgstr "تأخیر پیش از آشکارکردن میزکار (میلی‌ثانیه)"

msgid "Fade duration (ms)"
msgstr "مدت محوشدن (میلی‌ثانیه)"

msgid "Time (ms) before showing"
msgstr "زمان (میلی‌ثانیه) پیش از نمایش"

msgid "(400 is default)"
msgstr "(پیش‌گزیده ۴۰۰ است)"

msgid "Time (ms) before hiding"
msgstr "زمان (میلی‌ثانیه) پیش از پنهان‌شدن"

msgid "(100 is default)"
msgstr "(پیش‌گزیده ۱۰۰ است)"

msgid "Immediate on application icon click"
msgstr "بی‌درنگ با کلیک روی نقشک برنامه"

msgid "If disabled, the previews background have the same opacity as the panel."
msgstr "اگر غیرفعال باشد، پس‌زمینهٔ پیش‌نمایش‌ها همان کدری تابلو را دارد."

msgid "If disabled, the previews icon size will be based on headerbar size"
msgstr "اگر غیرفعال باشد، اندازهٔ نقشک پیش‌نمایش‌ها بر پایهٔ اندازهٔ نوار سرصفحه خواهد بود"

msgid "Time of inactivity while hovering over a window preview needed to enter the window peeking mode."
msgstr "مدت بی‌فعالیتی هنگام شناور بودن روی پیش‌نمایش پنجره که برای ورود به حالت نگاه زیرکانهٔ پنجره لازم است."

msgid "All windows except for the peeked one have their opacity set to the same value."
msgstr "کدری همهٔ پنجره‌ها به‌جز پنجرهٔ مورد نگاه روی یک مقدار تنظیم می‌شود."

