msgstr "सभी पर लागू करें"

msgid "2 windows open"
msgstr "2 विंडो खुली हैं"

msgid "3 windows open"
msgstr "3 विंडो खुली हैं"

msgid "4+ windows open"
msgstr "4+ विंडो खुली हैं"

msgid "Use different for unfocused"
msgstr "बिना फ़ोकस वाले के लिए अलग इस्तेमाल करें"

msgid "The panel background opacity is affected by"
msgstr "पैनल की पृष्ठभूमि की पारदर्शिता इससे प्रभावित होती है"

msgid "All windows"
msgstr "सभी विंडो"

msgid "Focused windows"
msgstr "फ़ोकस वाली विंडो"

msgid "Maximized windows"
msgstr "मैक्सिमाइज़ की गई विंडो"

msgid "Change opacity when a window gets closer than (px)"
msgstr "विंडो जब इतनी (px) से ज़्यादा नज़दीक आए तब पारदर्शिता बदलें"

msgid "Change opacity to (%)"
msgstr "पारदर्शिता को इतना (%) करें"

msgid "0"
msgstr "0"

msgid "Opacity change animation duration (ms)"
msgstr "पारदर्शिता बदलने के एनीमेशन की अवधि (ms)"

msgid "Font size (px) of the application titles (default is 14)"
msgstr "ऐप्लिकेशन शीर्षकों का फ़ॉन्ट आकार (px) (डिफ़ॉल्ट 14 है)"

msgid "Font weight of application titles"
msgstr "ऐप्लिकेशन शीर्षकों के फ़ॉन्ट की मोटाई"

msgid "inherit from theme"
msgstr "थीम से लें"

msgid "normal"
msgstr "सामान्य"

msgid "lighter"
msgstr "हल्का"

msgid "bold"
msgstr "बोल्ड"

msgid "bolder"
msgstr "ज़्यादा बोल्ड"

msgid "Font color of the application titles"
msgstr "ऐप्लिकेशन शीर्षकों के फ़ॉन्ट का रंग"

msgid "Font color of the minimized application titles"
msgstr "छोटी की गई ऐप्लिकेशन के शीर्षकों के फ़ॉन्ट का रंग"

msgid "Maximum width (px) of the application titles"
msgstr "ऐप्लिकेशन शीर्षकों की अधिकतम चौड़ाई (px)"

msgid "(default is 160)"
msgstr "(डिफ़ॉल्ट 160 है)"

msgid "Use a fixed width for the application titles"
msgstr "ऐप्लिकेशन शीर्षकों के लिए तय चौड़ाई इस्तेमाल करें"

msgid "The application titles all have the same width, even if their texts are shorter than the maximum width. The maximum width value is used as the fixed width."
msgstr "सभी ऐप्लिकेशन शीर्षकों की चौड़ाई एक जैसी होती है, भले ही उनका टेक्स्ट अधिकतम चौड़ाई से छोटा हो। अधिकतम चौड़ाई का मान ही तय चौड़ाई के रूप में इस्तेमाल होता है।"

msgid "Display running indicators on unfocused applications"
msgstr "बिना फ़ोकस वाले ऐप्लिकेशन पर चालू संकेतक दिखाएँ"

msgid "Use the favorite icons as application launchers"
msgstr "पसंदीदा आइकन को ऐप्लिकेशन लॉन्चर के रूप में इस्तेमाल करें"

msgid "Highlight AppIcon color"
msgstr "ऐप आइकन हाइलाइट का रंग"

msgid "Pressed AppIcon color"
msgstr "दबाए गए ऐप आइकन का रंग"

msgid "Highlight AppIcon border radius"
msgstr "ऐप आइकन हाइलाइट के बॉर्डर की गोलाई"

msgid "Overrides global border radius (default is 0)"
msgstr "वैश्विक बॉर्डर की गोलाई को ओवरराइड करता है (डिफ़ॉल्ट 0 है)"

msgid "Only hide the panel from windows"
msgstr "पैनल को सिर्फ़ विंडो से छिपाएँ"

msgid "Overlapping"
msgstr "ऊपर आने वाली"

msgid "On same monitor"
msgstr "उसी मॉनिटर पर"

msgid "The panel hides from"
msgstr "पैनल इनसे छिपता है"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "पॉइंटर से मॉनिटर के किनारे को छूने पर पैनल दिखाई देता है"

msgid "Limit to panel length"
msgstr "पैनल की लंबाई तक सीमित करें"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "पैनल के क्षेत्र पर होवर करने से पैनल दिखता रहता है"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "पैनल दिखाने के लिए मॉनिटर के किनारे पर दबाव ज़रूरी करें"

msgid "Required pressure threshold (px)"
msgstr "ज़रूरी दबाव की सीमा (px)"

msgid "Required pressure timeout (ms)"
msgstr "ज़रूरी दबाव का टाइमआउट (ms)"

msgid "Allow the panel to be revealed while in fullscreen mode"
msgstr "फ़ुलस्क्रीन मोड में भी पैनल को दिखने दें"

msgid "(requires multi-monitors option)"
msgstr "(मल्टी-मॉनिटर विकल्प ज़रूरी है)"

msgid "Only hide secondary panels"
msgstr "सिर्फ़ द्वितीयक पैनल छिपाएँ"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "सिंटैक्स: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Keyboard shortcut to reveal and hold the panel"
msgstr "पैनल को दिखाने और रोके रखने का कीबोर्ड शॉर्टकट"

msgid "e.g. <Super>i"
msgstr "जैसे <Super>i"

msgid "Persist state across restarts"
msgstr "रीस्टार्ट के बाद भी स्थिति बनाए रखें"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(GNOME के \"परेशान न करें\" का सम्मान करता है और नोटिफ़िकेशन काउंटर बैज दिखाने का विकल्प ज़रूरी है)"

msgid "Reveal and hold the panel on notification"
msgstr "नोटिफ़िकेशन आने पर पैनल दिखाएँ और रोके रखें"

msgid "Hide and reveal animation duration (ms)"
msgstr "छिपाने और दिखाने के एनीमेशन की अवधि (ms)"

msgid "Delay before hiding the panel (ms)"
msgstr "पैनल छिपाने से पहले की देरी (ms)"

msgid "Delay before revealing the panel (ms)"
msgstr "पैनल दिखाने से पहले की देरी (ms)"

msgid "Delay before enabling intellihide on start (ms)"
msgstr "शुरू होने पर Intellihide चालू करने से पहले की देरी (ms)"

msgid "Isolate monitors even when using a single panel"
msgstr "एक ही पैनल होने पर भी मॉनिटर अलग करें"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "gnome-shell के ऐप्लिकेशन स्विचर में वर्कस्पेस अलग करें"

msgid "Shift+Click action"
msgstr "Shift+क्लिक की कार्रवाई"

msgid "When set to minimize, double clicking minimizes all the windows of the application."
msgstr "छोटा करने पर सेट होने पर, डबल क्लिक करने से ऐप्लिकेशन की सभी विंडो छोटी हो जाती हैं।"

msgid "Raise windows"
msgstr "विंडो ऊपर लाएँ"

msgid "Minimize window"
msgstr "विंडो छोटी करें"

msgid "Launch new instance"
msgstr "नया इंस्टेंस लॉन्च करें"

msgid "Cycle through windows"
msgstr "विंडो में बारी-बारी से जाएँ"

msgid "Cycle windows + minimize"
msgstr "विंडो में बारी-बारी से जाएँ + छोटी करें"

msgid "Toggle single / Preview multiple"
msgstr "एक को टॉगल करें / कई का पूर्वावलोकन दिखाएँ"

msgid "Toggle single / Cycle multiple"
msgstr "एक को टॉगल करें / कई में बारी-बारी से जाएँ"

msgid "Toggle single / Spread multiple"
msgstr "एक को टॉगल करें / कई को फैलाएँ"

msgid "Middle-Click action"
msgstr "बीच के क्लिक की कार्रवाई"

msgid "Behavior for Middle-Click."
msgstr "बीच के क्लिक का व्यवहार।"

msgid "Shift+Middle-Click action"
msgstr "Shift+बीच के क्लिक की कार्रवाई"

msgid "Behavior for Shift+Middle-Click."
msgstr "Shift+बीच के क्लिक का व्यवहार।"

msgid "Hotkeys will either be Super+Number or Super+Alt+Num"
msgstr "हॉटकी या तो Super+नंबर होंगी या Super+Alt+नंबर"

msgid "Hotkeys prefix"
msgstr "हॉटकी का उपसर्ग"

msgid "Super"
msgstr "Super"

msgid "Super + Alt"
msgstr "Super + Alt"

msgid "Temporarily show the application numbers over the icons when using the hotkeys."
msgstr "हॉटकी इस्तेमाल करते समय आइकन के ऊपर ऐप्लिकेशन के नंबर कुछ देर के लिए दिखाएँ।"

msgid "Number overlay"
msgstr "नंबर ओवरले"

msgid "Never"
msgstr "कभी नहीं"

msgid "Show temporarily"
msgstr "कुछ देर के लिए दिखाएँ"

msgid "Always visible"
msgstr "हमेशा दिखाएँ"

msgid "Hide timeout (ms)"
msgstr "छिपाने का टाइमआउट (ms)"

msgid "Shortcut to show the overlay for 2 seconds"
msgstr "ओवरले को 2 सेकंड के लिए दिखाने का शॉर्टकट"

msgid "e.g. <Super>q"
msgstr "जैसे <Super>q"

msgid "On secondary monitors, show the overlay on icons matching the primary monitor"
msgstr "द्वितीयक मॉनिटर पर, मुख्य मॉनिटर से मेल खाने वाले आइकन पर ओवरले दिखाएँ"

msgid "Show the overlay on all monitors"
msgstr "सभी मॉनिटर पर ओवरले दिखाएँ"

msgid "Show previews when the application have multiple instances"
msgstr "ऐप्लिकेशन के कई इंस्टेंस होने पर पूर्वावलोकन दिखाएँ"

msgid "Show window previews on hotkey"
msgstr "हॉटकी दबाने पर विंडो पूर्वावलोकन दिखाएँ"

msgid "Select which keyboard number keys are used to activate the hotkeys"
msgstr "चुनें कि हॉटकी सक्रिय करने के लिए कीबोर्ड की कौन-सी नंबर कुंजियाँ इस्तेमाल हों"

msgid "Hotkeys are activated with"
msgstr "हॉटकी इनसे सक्रिय होती हैं"

msgid "Number row"
msgstr "नंबर पंक्ति"

msgid "Numeric keypad"
msgstr "न्यूमेरिक कीपैड"

msgid "Both"
msgstr "दोनों"

msgid "Delay between mouse scroll events (ms)"
msgstr "माउस स्क्रॉल इवेंट के बीच की देरी (ms)"

msgid "Use this value to limit the number of captured mouse scroll events."
msgstr "पकड़े जाने वाले माउस स्क्रॉल इवेंट की संख्या सीमित करने के लिए इस मान का इस्तेमाल करें।"

msgid "Show popup when changing workspace"
msgstr "वर्कस्पेस बदलते समय पॉपअप दिखाएँ"

msgid "This affects workspace popup when scrolling on the panel only."
msgstr "यह सिर्फ़ पैनल पर स्क्रॉल करते समय दिखने वाले वर्कस्पेस पॉपअप पर लागू होता है।"

msgid "Integrate <i>AppMenu</i> items"
msgstr "<i>AppMenu</i> आइटम एकीकृत करें"

msgid "<i>App Details</i> menu item"
msgstr "<i>ऐप का विवरण</i> मेन्यू आइटम"

msgid "<i>App Details</i> is only available when Gnome Software is installed"
