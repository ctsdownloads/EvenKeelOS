msgstr "Kontextová nabídka ikon aplikací"

msgid "Secondary menu"
msgstr "Sekundární nabídka"

msgid "Panel context menu entries"
msgstr "Položky kontextové nabídky panelu"

msgid "Add entry"
msgstr "Přidat položku"

msgid "Behavior"
msgstr "Chování"

msgid "Hover"
msgstr "Najetí"

msgid "Fine-Tune"
msgstr "Jemné ladění"

msgid "Position"
msgstr "Umístění"

msgid "Panel monitor position"
msgstr "Umístění panelu na monitoru"

msgid "Panel length"
msgstr "Délka panelu"

msgid "Dynamic"
msgstr "Dynamická"

msgid "Style"
msgstr "Styl"

msgid "Global style"
msgstr "Globální styl"

msgid "Border radius"
msgstr "Poloměr zaoblení rohů"

msgid "Highlight hovering app icons"
msgstr "Zvýraznit ikony aplikací při najetí"

msgid "Icon style"
msgstr "Styl ikon"

msgid "Normal"
msgstr "Normální"

msgid "Symbolic"
msgstr "Symbolické"

msgid "Grayscale"
msgstr "Odstíny šedi"

msgid "(default is 0)"
msgstr "(výchozí je 0)"

