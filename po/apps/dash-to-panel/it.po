msgid "App icon highlight options"
msgstr "Opzioni di evidenziazione dell'icona dell'app"

msgid "Move to current Workspace"
msgstr "Sposta nello spazio di lavoro corrente"

msgid "Highlight AppIcon color"
msgstr "Colore di evidenziazione dell'icona dell'app"

msgid "Pressed AppIcon color"
msgstr "Colore dell'icona dell'app premuta"

msgid "Highlight AppIcon border radius"
msgstr "Raggio del bordo dell'evidenziazione dell'icona dell'app"

msgid "Overrides global border radius (default is 0)"
msgstr "Sovrascrive il raggio del bordo globale (il valore predefinito è 0)"

msgid "Only hide the panel from windows"
msgstr "Nascondi il pannello solo dalle finestre"

msgid "Overlapping"
msgstr "Sovrapposte"

msgid "On same monitor"
msgstr "Sullo stesso monitor"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "Toccare il bordo del monitor con il puntatore rivela il pannello"

msgid "Limit to panel length"
msgstr "Limita alla lunghezza del pannello"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "Passare sull'area del pannello lo mantiene visibile"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "Richiedi pressione sul bordo del monitor per rivelare il pannello"

msgid "Syntax: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"
msgstr "Sintassi: &lt;Shift&gt;, &lt;Ctrl&gt;, &lt;Alt&gt;, &lt;Super&gt;"

msgid "Persist state across restarts"
msgstr "Mantieni lo stato dopo i riavvii"

msgid "(respects Gnome \"Do Not Disturb\" and requires show notification counter badge option)"
msgstr "(rispetta la modalità «Non disturbare» di GNOME e richiede l'opzione del badge contatore delle notifiche)"

msgid "Reveal and hold the panel on notification"
msgstr "Rivela e mantieni visibile il pannello alla notifica"

msgid "Delay before revealing the panel (ms)"
msgstr "Ritardo prima di rivelare il pannello (ms)"

msgid "Isolate monitors even when using a single panel"
msgstr "Isola i monitor anche con un solo pannello"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "Isola gli spazi di lavoro nel selettore di applicazioni di gnome-shell"

msgid "Toggle single / Spread multiple"
msgstr "Alterna singola / Distribuisci multiple"

msgid "On secondary monitors, show the overlay on icons matching the primary monitor"
msgstr "Sui monitor secondari, mostra la sovrapposizione sulle icone corrispondenti al monitor principale"

msgid "Show the overlay on all monitors"
msgstr "Mostra la sovrapposizione su tutti i monitor"

msgid "<i>App Details</i> menu item"
msgstr "Voce di menu <i>Dettagli app</i>"

msgid "<i>App Details</i> is only available when Gnome Software is installed"
msgstr "<i>Dettagli app</i> è disponibile solo se è installato GNOME Software"

