msgid "Top Bar"
msgstr "Верхня панель"

msgid "Isolate Workspaces options"
msgstr "Параметри ізоляції робочих просторів"

msgid "Isolate monitors options"
msgstr "Параметри ізоляції моніторів"

msgid "Move to current Workspace"
msgstr "Перемістити на поточний робочий простір"

msgid "Only hide the panel from windows"
msgstr "Ховати панель лише від вікон"

msgid "Overlapping"
msgstr "Перекриття"

msgid "On same monitor"
msgstr "На тому самому моніторі"

msgid "Touching the monitor's edge with the pointer reveals the panel"
msgstr "Доторк вказівником до краю монітора показує панель"

msgid "Limit to panel length"
msgstr "Обмежити довжиною панелі"

msgid "Hovering the panel area keeps the panel revealed"
msgstr "Наведення на область панелі утримує панель видимою"

msgid "Require pressure at the edge of the monitor to reveal the panel"
msgstr "Вимагати тиску на краю монітора, щоб показати панель"

msgid "Delay before revealing the panel (ms)"
msgstr "Затримка перед показом панелі (мс)"

msgid "Isolate monitors even when using a single panel"
msgstr "Ізолювати монітори, навіть якщо використовується одна панель"

msgid "Isolate workspaces in gnome-shell Application Switcher"
msgstr "Ізолювати робочі простори в перемикачі програм gnome-shell"

msgid "Sponsored and originally developed by"
msgstr "Спонсор і початковий розробник:"

msgid "Panel monitor position"
msgstr "Розташування панелі на моніторі"

msgid "Panel border"
msgstr "Рамка панелі"

msgid "Override border color"
msgstr "Перевизначити колір рамки"

msgid "Border thickness"
msgstr "Товщина рамки"
