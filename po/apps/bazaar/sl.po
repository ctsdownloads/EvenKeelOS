msgstr[2] "Spodnji programi so bili nameščeni s tega oddaljenega vira in bodo skupaj z njim odstranjeni z vašega računa."
msgstr[3] "Ti programi so bili nameščeni s tega oddaljenega vira in bodo skupaj z njim odstranjeni z vašega računa."

msgid "The app below was installed from this remote and will be removed for all users along with it."
msgid_plural "These apps were installed from this remote and will be removed for all users along with it."
msgstr[0] "Spodnji program je bil nameščen s tega oddaljenega vira in bo skupaj z njim odstranjen za vse uporabnike."
msgstr[1] "Spodnja programa sta bila nameščena s tega oddaljenega vira in bosta skupaj z njim odstranjena za vse uporabnike."
msgstr[2] "Spodnji programi so bili nameščeni s tega oddaljenega vira in bodo skupaj z njim odstranjeni za vse uporabnike."
msgstr[3] "Ti programi so bili nameščeni s tega oddaljenega vira in bodo skupaj z njim odstranjeni za vse uporabnike."

