msgid "Can read all data in your home directory"
msgstr "તમારી હોમ ડિરેક્ટરીમાંનો બધો ડેટા વાંચી શકે છે"

msgid "Download Folder Read/Write Access"
msgstr "ડાઉનલોડ ફોલ્ડર વાંચન/લેખન ઍક્સેસ"

msgid "Can read and write all data in your downloads directory"
msgstr "તમારી ડાઉનલોડ્સ ડિરેક્ટરીમાંનો બધો ડેટા વાંચી અને લખી શકે છે"

msgid "Download Folder Read Access"
msgstr "ડાઉનલોડ ફોલ્ડર વાંચન ઍક્સેસ"

msgid "Can read all data in your downloads directory"
msgstr "તમારી ડાઉનલોડ્સ ડિરેક્ટરીમાંનો બધો ડેટા વાંચી શકે છે"

msgid "Can read and write all data in the directory"
msgstr "ડિરેક્ટરીમાંનો બધો ડેટા વાંચી અને લખી શકે છે"

msgid "Can read all data in the directory"
msgstr "ડિરેક્ટરીમાંનો બધો ડેટા વાંચી શકે છે"

msgid "No File System Access"
msgstr "કોઈ ફાઇલ સિસ્ટમ ઍક્સેસ નથી"

msgid "Cannot access the file system at all"
msgstr "ફાઇલ સિસ્ટમ બિલકુલ ઍક્સેસ કરી શકતી નથી"

msgid "Uses System Services"
msgstr "સિસ્ટમ સેવાઓનો ઉપયોગ કરે છે"

msgid "Can request data from non-portal system services"
msgstr "પોર્ટલ સિવાયની સિસ્ટમ સેવાઓ પાસેથી ડેટા માંગી શકે છે"

msgid "Uses Session Services"
msgstr "સત્ર સેવાઓનો ઉપયોગ કરે છે"

msgid "Can request data from non-portal session services"
msgstr "પોર્ટલ સિવાયની સત્ર સેવાઓ પાસેથી ડેટા માંગી શકે છે"

msgid "No Service Access"
msgstr "કોઈ સેવા ઍક્સેસ નથી"

msgid "Cannot access non-portal session or system services at all"
msgstr "પોર્ટલ સિવાયની સત્ર અથવા સિસ્ટમ સેવાઓ બિલકુલ ઍક્સેસ કરી શકતી નથી"

msgid "Verified App Developer"
msgstr "ચકાસાયેલ ઍપ ડેવલપર"

msgid "The developer of this app has been verified to be who they say they are"
msgstr "આ ઍપના ડેવલપરની તેઓ જે હોવાનો દાવો કરે છે તે હોવા તરીકે ચકાસણી કરવામાં આવી છે"

msgid "Proprietary Code"
msgstr "માલિકીનો કોડ"

msgid "The source code is not public, so it cannot be independently audited and might be unsafe"
msgstr "સોર્સ કોડ સાર્વજનિક નથી, તેથી તેની સ્વતંત્ર રીતે ચકાસણી કરી શકાતી નથી અને તે અસુરક્ષિત હોઈ શકે છે"

msgid "Auditable Code"
msgstr "ચકાસી શકાય તેવો કોડ"

msgid "The source code is public and can be independently audited, which makes the app more likely to be safe"
msgstr "સોર્સ કોડ સાર્વજનિક છે અને તેની સ્વતંત્ર રીતે ચકાસણી કરી શકાય છે, જેનાથી ઍપ સુરક્ષિત હોવાની શક્યતા વધે છે"

#, c-format
msgid "Use the %s System Service"
msgstr "%s સિસ્ટમ સેવાનો ઉપયોગ કરો"

#, c-format
msgid "Use the %s Session Service"
msgstr "%s સત્ર સેવાનો ઉપયોગ કરો"

#, c-format
msgid "Use the %s Service"
msgstr "%s સેવાનો ઉપયોગ કરો"

msgid "Can see the non-portal service"
msgstr "પોર્ટલ સિવાયની સેવા જોઈ શકે છે"

msgid "Can talk to the non-portal service"
msgstr "પોર્ટલ સિવાયની સેવા સાથે વાત કરી શકે છે"

msgid "Can own the non-portal service"
msgstr "પોર્ટલ સિવાયની સેવાની માલિકી ધરાવી શકે છે"

msgid "Global Menu Integration"
msgstr "ગ્લોબલ મેનૂ એકીકરણ"

msgid "Can display its menus in a global menu bar"
msgstr "તેના મેનૂ ગ્લોબલ મેનૂ બારમાં બતાવી શકે છે"

msgid "KDE Settings Integration"
msgstr "KDE સુયોજનો એકીકરણ"

msgid "Can detect when KDE desktop settings change"
msgstr "KDE ડેસ્કટૉપ સુયોજનો બદલાય ત્યારે શોધી શકે છે"

msgid "KDE Global Settings"
msgstr "KDE ગ્લોબલ સુયોજનો"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "ફોન્ટ અને રંગ જેવી KDE ડેસ્કટૉપ પસંદગીઓ વાંચી શકે છે"

msgid "Secret Storage Service"
msgstr "ગુપ્ત સંગ્રહ સેવા"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "સિસ્ટમ કીરિંગનો ઉપયોગ કરીને પોતાના પાસવર્ડ સંગ્રહી અને પાછા મેળવી શકે છે"

msgid "Desktop Notifications Service"
msgstr "ડેસ્કટૉપ સૂચના સેવા"

msgid "Can send desktop notifications"
msgstr "ડેસ્કટૉપ સૂચનાઓ મોકલી શકે છે"

msgid "System Tray Integration"
msgstr "સિસ્ટમ ટ્રે એકીકરણ"

msgid "Can display an icon in the system tray"
msgstr "સિસ્ટમ ટ્રેમાં આઇકન બતાવી શકે છે"

msgid "KDE Connect Integration"
msgstr "KDE Connect એકીકરણ"

msgid "Can interact with devices paired via KDE Connect"
msgstr "KDE Connect દ્વારા જોડી બનાવેલા ઉપકરણો સાથે ક્રિયાપ્રતિક્રિયા કરી શકે છે"

