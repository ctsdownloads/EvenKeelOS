msgstr "গ্লোবাল মেনু সমন্বয়"

msgid "Can display its menus in a global menu bar"
msgstr "একটি গ্লোবাল মেনু বারে নিজের মেনু দেখাতে পারে"

msgid "KDE Settings Integration"
msgstr "KDE সেটিংস সমন্বয়"

msgid "Can detect when KDE desktop settings change"
msgstr "KDE ডেস্কটপ সেটিংস বদলালে তা শনাক্ত করতে পারে"

msgid "KDE Global Settings"
msgstr "KDE গ্লোবাল সেটিংস"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "ফন্ট ও রঙের মতো KDE ডেস্কটপ পছন্দ পড়তে পারে"

msgid "Secret Storage Service"
msgstr "গোপন তথ্য সংরক্ষণ সার্ভিস"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "সিস্টেম কিরিং ব্যবহার করে নিজের পাসওয়ার্ড সংরক্ষণ ও পুনরুদ্ধার করতে পারে"

msgid "Desktop Notifications Service"
msgstr "ডেস্কটপ বিজ্ঞপ্তি সার্ভিস"

msgid "Can send desktop notifications"
msgstr "ডেস্কটপ বিজ্ঞপ্তি পাঠাতে পারে"

msgid "System Tray Integration"
msgstr "সিস্টেম ট্রে সমন্বয়"

msgid "Can display an icon in the system tray"
msgstr "সিস্টেম ট্রেতে একটি আইকন দেখাতে পারে"

msgid "KDE Connect Integration"
msgstr "KDE Connect সমন্বয়"

msgid "Can interact with devices paired via KDE Connect"
msgstr "KDE Connect দিয়ে যুক্ত করা ডিভাইসের সঙ্গে যোগাযোগ করতে পারে"

