msgstr "फ़ाइल सिस्टम को बिल्कुल एक्सेस नहीं कर सकता"

msgid "Uses System Services"
msgstr "सिस्टम सेवाएँ इस्तेमाल करता है"

msgid "Can request data from non-portal system services"
msgstr "नॉन-पोर्टल सिस्टम सेवाओं से डेटा माँग सकता है"

msgid "Uses Session Services"
msgstr "सेशन सेवाएँ इस्तेमाल करता है"

msgid "Can request data from non-portal session services"
msgstr "नॉन-पोर्टल सेशन सेवाओं से डेटा माँग सकता है"

msgid "No Service Access"
msgstr "सेवाओं की पहुँच नहीं"

msgid "Cannot access non-portal session or system services at all"
msgstr "नॉन-पोर्टल सेशन या सिस्टम सेवाओं को बिल्कुल एक्सेस नहीं कर सकता"

msgid "Verified App Developer"
msgstr "सत्यापित ऐप डेवलपर"

msgid "The developer of this app has been verified to be who they say they are"
msgstr "इस ऐप के डेवलपर की पहचान सत्यापित की जा चुकी है"

msgid "Proprietary Code"
msgstr "प्रोप्राइटरी कोड"

msgid "The source code is not public, so it cannot be independently audited and might be unsafe"
msgstr "सोर्स कोड सार्वजनिक नहीं है, इसलिए उसकी स्वतंत्र रूप से जाँच नहीं की जा सकती और वह असुरक्षित हो सकता है"

msgid "Auditable Code"
msgstr "जाँचा जा सकने वाला कोड"

msgid "The source code is public and can be independently audited, which makes the app more likely to be safe"
msgstr "सोर्स कोड सार्वजनिक है और उसकी स्वतंत्र रूप से जाँच की जा सकती है, जिससे ऐप के सुरक्षित होने की संभावना बढ़ जाती है"

#, c-format
msgid "Use the %s System Service"
msgstr "%s सिस्टम सेवा इस्तेमाल करें"

#, c-format
msgid "Use the %s Session Service"
msgstr "%s सेशन सेवा इस्तेमाल करें"

#, c-format
msgid "Use the %s Service"
msgstr "%s सेवा इस्तेमाल करें"

msgid "Can see the non-portal service"
msgstr "नॉन-पोर्टल सेवा को देख सकता है"

msgid "Can talk to the non-portal service"
msgstr "नॉन-पोर्टल सेवा से बात कर सकता है"

msgid "Can own the non-portal service"
msgstr "नॉन-पोर्टल सेवा का स्वामी हो सकता है"

msgid "Global Menu Integration"
msgstr "ग्लोबल मेन्यू एकीकरण"

msgid "Can display its menus in a global menu bar"
msgstr "अपने मेन्यू ग्लोबल मेन्यू बार में दिखा सकता है"

msgid "KDE Settings Integration"
msgstr "KDE सेटिंग एकीकरण"

msgid "Can detect when KDE desktop settings change"
msgstr "KDE डेस्कटॉप सेटिंग बदलने का पता लगा सकता है"

msgid "KDE Global Settings"
msgstr "KDE ग्लोबल सेटिंग"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "फ़ॉन्ट और रंग जैसी KDE डेस्कटॉप प्राथमिकताएँ पढ़ सकता है"

msgid "Secret Storage Service"
msgstr "सीक्रेट स्टोरेज सेवा"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "सिस्टम कीरिंग का उपयोग करके अपने पासवर्ड सेव और पुनः प्राप्त कर सकता है"

msgid "Desktop Notifications Service"
msgstr "डेस्कटॉप नोटिफ़िकेशन सेवा"

msgid "Can send desktop notifications"
msgstr "डेस्कटॉप नोटिफ़िकेशन भेज सकता है"

msgid "System Tray Integration"
msgstr "सिस्टम ट्रे एकीकरण"

msgid "Can display an icon in the system tray"
msgstr "सिस्टम ट्रे में आइकन दिखा सकता है"

msgid "KDE Connect Integration"
msgstr "KDE Connect एकीकरण"

msgid "Can interact with devices paired via KDE Connect"
msgstr "KDE Connect से पेयर किए गए डिवाइस से इंटरैक्ट कर सकता है"

