msgstr "Μπορεί να ακούει μέσω μικροφώνων και να αναπαράγει ήχο χωρίς να ζητά άδεια"

msgid "System Device Access"
msgstr "Πρόσβαση σε συσκευές συστήματος"

msgid "Can access system devices which require elevated permissions"
msgstr "Έχει πρόσβαση σε συσκευές συστήματος που απαιτούν αυξημένα δικαιώματα"

msgid "Screen Contents Access"
msgstr "Πρόσβαση στο περιεχόμενο της οθόνης"

msgid "Can access the contents of the screen or other windows"
msgstr "Έχει πρόσβαση στο περιεχόμενο της οθόνης ή άλλων παραθύρων"

msgid "Legacy Windowing System"
msgstr "Παλαιού τύπου σύστημα παραθύρων"

msgid "Always uses a legacy windowing system (X11)"
msgstr "Χρησιμοποιεί πάντα παλαιού τύπου σύστημα παραθύρων (X11)"

msgid "Can acquire arbitrary permissions"
msgstr "Μπορεί να αποκτήσει αυθαίρετα δικαιώματα"

msgid "User Settings"
msgstr "Ρυθμίσεις χρήστη"

msgid "Can access and change user settings"
msgstr "Έχει πρόσβαση στις ρυθμίσεις χρήστη και μπορεί να τις αλλάξει"

msgid "Full File System Read/Write Access"
msgstr "Πλήρης πρόσβαση ανάγνωσης/εγγραφής στο σύστημα αρχείων"

msgid "Can read and write all data on the file system"
msgstr "Μπορεί να διαβάζει και να γράφει όλα τα δεδομένα στο σύστημα αρχείων"

msgid "Home Folder Read/Write Access"
msgstr "Πρόσβαση ανάγνωσης/εγγραφής στον προσωπικό φάκελο"

msgid "Can read and write all data in your home directory"
msgstr "Μπορεί να διαβάζει και να γράφει όλα τα δεδομένα στον προσωπικό σας φάκελο"

msgid "Full File System Read Access"
msgstr "Πλήρης πρόσβαση ανάγνωσης στο σύστημα αρχείων"

msgid "Can read all data on the file system"
msgstr "Μπορεί να διαβάζει όλα τα δεδομένα στο σύστημα αρχείων"

msgid "Home Folder Read Access"
msgstr "Πρόσβαση ανάγνωσης στον προσωπικό φάκελο"

msgid "Can read all data in your home directory"
msgstr "Μπορεί να διαβάζει όλα τα δεδομένα στον προσωπικό σας φάκελο"

msgid "Download Folder Read/Write Access"
msgstr "Πρόσβαση ανάγνωσης/εγγραφής στον φάκελο Λήψεις"

msgid "Can read and write all data in your downloads directory"
msgstr "Μπορεί να διαβάζει και να γράφει όλα τα δεδομένα στον φάκελο λήψεών σας"

msgid "Download Folder Read Access"
msgstr "Πρόσβαση ανάγνωσης στον φάκελο Λήψεις"

msgid "Can read all data in your downloads directory"
msgstr "Μπορεί να διαβάζει όλα τα δεδομένα στον φάκελο λήψεών σας"

msgid "Can read and write all data in the directory"
msgstr "Μπορεί να διαβάζει και να γράφει όλα τα δεδομένα στον φάκελο"

msgid "Can read all data in the directory"
msgstr "Μπορεί να διαβάζει όλα τα δεδομένα στον φάκελο"

msgid "No File System Access"
msgstr "Χωρίς πρόσβαση στο σύστημα αρχείων"

msgid "Cannot access the file system at all"
msgstr "Δεν έχει καθόλου πρόσβαση στο σύστημα αρχείων"

msgid "Uses System Services"
msgstr "Χρησιμοποιεί υπηρεσίες συστήματος"

msgid "Can request data from non-portal system services"
msgstr "Μπορεί να ζητά δεδομένα από υπηρεσίες συστήματος εκτός πυλών (portal)"

msgid "Uses Session Services"
msgstr "Χρησιμοποιεί υπηρεσίες συνεδρίας"

msgid "Can request data from non-portal session services"
msgstr "Μπορεί να ζητά δεδομένα από υπηρεσίες συνεδρίας εκτός πυλών (portal)"

msgid "No Service Access"
msgstr "Χωρίς πρόσβαση σε υπηρεσίες"

msgid "Cannot access non-portal session or system services at all"
msgstr "Δεν έχει καθόλου πρόσβαση σε υπηρεσίες συστήματος ή συνεδρίας εκτός πυλών (portal)"

msgid "Verified App Developer"
msgstr "Επαληθευμένος προγραμματιστής εφαρμογής"

msgid "The developer of this app has been verified to be who they say they are"
msgstr "Ο προγραμματιστής αυτής της εφαρμογής έχει επαληθευτεί ότι είναι αυτός που δηλώνει"

msgid "Proprietary Code"
msgstr "Ιδιόκτητος κώδικας"

msgid "The source code is not public, so it cannot be independently audited and might be unsafe"
msgstr "Ο πηγαίος κώδικας δεν είναι δημόσιος, επομένως δεν μπορεί να ελεγχθεί ανεξάρτητα και μπορεί να μην είναι ασφαλής"

msgid "Auditable Code"
msgstr "Ελέγξιμος κώδικας"

msgid "The source code is public and can be independently audited, which makes the app more likely to be safe"
msgstr "Ο πηγαίος κώδικας είναι δημόσιος και μπορεί να ελεγχθεί ανεξάρτητα, γεγονός που καθιστά την εφαρμογή πιο πιθανό να είναι ασφαλής"

#, c-format
msgid "Use the %s System Service"
msgstr "Χρήση της υπηρεσίας συστήματος %s"

#, c-format
msgid "Use the %s Session Service"
msgstr "Χρήση της υπηρεσίας συνεδρίας %s"

#, c-format
msgid "Use the %s Service"
msgstr "Χρήση της υπηρεσίας %s"

msgid "Can see the non-portal service"
msgstr "Μπορεί να βλέπει την υπηρεσία εκτός πυλών (portal)"

msgid "Can talk to the non-portal service"
msgstr "Μπορεί να επικοινωνεί με την υπηρεσία εκτός πυλών (portal)"

msgid "Can own the non-portal service"
msgstr "Μπορεί να κατέχει την υπηρεσία εκτός πυλών (portal)"

msgid "Global Menu Integration"
msgstr "Ενσωμάτωση καθολικού μενού"

msgid "Can display its menus in a global menu bar"
msgstr "Μπορεί να εμφανίζει τα μενού της σε καθολική γραμμή μενού"

msgid "KDE Settings Integration"
msgstr "Ενσωμάτωση ρυθμίσεων KDE"

msgid "Can detect when KDE desktop settings change"
msgstr "Μπορεί να εντοπίζει πότε αλλάζουν οι ρυθμίσεις του επιτραπέζιου περιβάλλοντος KDE"

msgid "KDE Global Settings"
msgstr "Καθολικές ρυθμίσεις KDE"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "Μπορεί να διαβάζει προτιμήσεις του επιτραπέζιου περιβάλλοντος KDE, όπως γραμματοσειρές και χρώματα"

msgid "Secret Storage Service"
msgstr "Υπηρεσία αποθήκευσης μυστικών"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "Μπορεί να αποθηκεύει και να ανακτά τους δικούς της κωδικούς πρόσβασης μέσω της κλειδοθήκης του συστήματος"

msgid "Desktop Notifications Service"
msgstr "Υπηρεσία ειδοποιήσεων επιφάνειας εργασίας"

msgid "Can send desktop notifications"
msgstr "Μπορεί να στέλνει ειδοποιήσεις επιφάνειας εργασίας"

msgid "System Tray Integration"
msgstr "Ενσωμάτωση περιοχής ειδοποιήσεων συστήματος"

msgid "Can display an icon in the system tray"
msgstr "Μπορεί να εμφανίζει εικονίδιο στην περιοχή ειδοποιήσεων του συστήματος"

msgid "KDE Connect Integration"
msgstr "Ενσωμάτωση KDE Connect"

msgid "Can interact with devices paired via KDE Connect"
msgstr "Μπορεί να αλληλεπιδρά με συσκευές που έχουν αντιστοιχιστεί μέσω του KDE Connect"

