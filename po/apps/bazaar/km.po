msgstr "បានឈប់ទទួលបច្ចុប្បន្នភាព"

msgctxt "Install Controls"
msgid "Uninstall"
msgstr "លុបការដំឡើង"

msgctxt "Install Controls"
msgid "Install"
msgstr "ដំឡើង"

