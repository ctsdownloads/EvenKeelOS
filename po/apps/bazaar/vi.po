msgid "Uses System Services"
msgstr "Dùng dịch vụ hệ thống"

msgid "Can request data from non-portal system services"
msgstr "Có thể yêu cầu dữ liệu từ các dịch vụ hệ thống không thuộc portal"

msgid "Uses Session Services"
msgstr "Dùng dịch vụ phiên làm việc"

msgid "Can request data from non-portal session services"
msgstr "Có thể yêu cầu dữ liệu từ các dịch vụ phiên làm việc không thuộc portal"

msgid "No Service Access"
msgstr "Không truy cập dịch vụ"

msgid "Cannot access non-portal session or system services at all"
msgstr "Hoàn toàn không thể truy cập các dịch vụ phiên làm việc hoặc hệ thống không thuộc portal"

msgid "Verified App Developer"
msgstr "Nhà phát triển ứng dụng đã xác minh"

msgid "The developer of this app has been verified to be who they say they are"
msgstr "Nhà phát triển của ứng dụng này đã được xác minh đúng như họ nói"

msgid "Proprietary Code"
msgstr "Mã độc quyền"

msgid "The source code is not public, so it cannot be independently audited and might be unsafe"
msgstr "Mã nguồn không công khai nên không thể được kiểm tra độc lập và có thể không an toàn"

msgid "Auditable Code"
msgstr "Mã có thể kiểm tra"

msgid "The source code is public and can be independently audited, which makes the app more likely to be safe"
msgstr "Mã nguồn công khai và có thể được kiểm tra độc lập, giúp ứng dụng có nhiều khả năng an toàn hơn"

