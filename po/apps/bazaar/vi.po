msgstr "Dùng dịch vụ phiên làm việc %s"

#, c-format
msgid "Use the %s Service"
msgstr "Dùng dịch vụ %s"

msgid "Can see the non-portal service"
msgstr "Có thể thấy dịch vụ không thuộc portal"

msgid "Can talk to the non-portal service"
msgstr "Có thể giao tiếp với dịch vụ không thuộc portal"

msgid "Can own the non-portal service"
msgstr "Có thể sở hữu dịch vụ không thuộc portal"

msgid "Global Menu Integration"
msgstr "Tích hợp menu toàn cục"

msgid "Can display its menus in a global menu bar"
msgstr "Có thể hiển thị menu của mình trong thanh menu toàn cục"

msgid "KDE Settings Integration"
msgstr "Tích hợp cài đặt KDE"

msgid "Can detect when KDE desktop settings change"
msgstr "Có thể phát hiện khi cài đặt máy tính để bàn KDE thay đổi"

msgid "KDE Global Settings"
msgstr "Cài đặt toàn cục KDE"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "Có thể đọc các tùy chọn máy tính để bàn KDE như phông chữ và màu sắc"

msgid "Secret Storage Service"
msgstr "Dịch vụ lưu trữ bí mật"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "Có thể lưu và truy xuất mật khẩu của chính nó bằng chùm khóa của hệ thống"

msgid "Desktop Notifications Service"
msgstr "Dịch vụ thông báo trên màn hình nền"

msgid "Can send desktop notifications"
msgstr "Có thể gửi thông báo trên màn hình nền"

msgid "System Tray Integration"
msgstr "Tích hợp khay hệ thống"

msgid "Can display an icon in the system tray"
msgstr "Có thể hiển thị biểu tượng trong khay hệ thống"

msgid "KDE Connect Integration"
msgstr "Tích hợp KDE Connect"

msgid "Can interact with devices paired via KDE Connect"
msgstr "Có thể tương tác với các thiết bị đã ghép nối qua KDE Connect"

