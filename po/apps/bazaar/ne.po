msgstr "स्क्रिनको सामग्री पहुँच"

msgid "Can access the contents of the screen or other windows"
msgstr "स्क्रिन वा अन्य विन्डोहरूको सामग्री पहुँच गर्न सक्छ"

msgid "Legacy Windowing System"
msgstr "पुरानो विन्डोइङ प्रणाली"

msgid "Always uses a legacy windowing system (X11)"
msgstr "सधैँ पुरानो विन्डोइङ प्रणाली (X11) प्रयोग गर्छ"

msgid "Can acquire arbitrary permissions"
msgstr "स्वेच्छाचारी अनुमतिहरू प्राप्त गर्न सक्छ"

msgid "User Settings"
msgstr "प्रयोगकर्ता सेटिङहरू"

msgid "Can access and change user settings"
msgstr "प्रयोगकर्ता सेटिङहरू पहुँच र परिवर्तन गर्न सक्छ"

msgid "Full File System Read/Write Access"
msgstr "पूर्ण फाइल सिस्टम पढ्ने/लेख्ने पहुँच"

msgid "Can read and write all data on the file system"
msgstr "फाइल सिस्टमको सबै डेटा पढ्न र लेख्न सक्छ"

msgid "Home Folder Read/Write Access"
msgstr "गृह फोल्डर पढ्ने/लेख्ने पहुँच"

msgid "Can read and write all data in your home directory"
msgstr "तपाईंको गृह डाइरेक्टरीको सबै डेटा पढ्न र लेख्न सक्छ"

msgid "Full File System Read Access"
msgstr "पूर्ण फाइल सिस्टम पढ्ने पहुँच"

msgid "Can read all data on the file system"
msgstr "फाइल सिस्टमको सबै डेटा पढ्न सक्छ"

msgid "Home Folder Read Access"
msgstr "गृह फोल्डर पढ्ने पहुँच"

msgid "Can read all data in your home directory"
msgstr "तपाईंको गृह डाइरेक्टरीको सबै डेटा पढ्न सक्छ"

msgid "Download Folder Read/Write Access"
msgstr "डाउनलोड फोल्डर पढ्ने/लेख्ने पहुँच"

msgid "Can read and write all data in your downloads directory"
msgstr "तपाईंको डाउनलोड डाइरेक्टरीको सबै डेटा पढ्न र लेख्न सक्छ"

msgid "Download Folder Read Access"
msgstr "डाउनलोड फोल्डर पढ्ने पहुँच"

msgid "Can read all data in your downloads directory"
msgstr "तपाईंको डाउनलोड डाइरेक्टरीको सबै डेटा पढ्न सक्छ"

msgid "Can read and write all data in the directory"
msgstr "डाइरेक्टरीको सबै डेटा पढ्न र लेख्न सक्छ"

msgid "Can read all data in the directory"
msgstr "डाइरेक्टरीको सबै डेटा पढ्न सक्छ"

msgid "No File System Access"
msgstr "फाइल सिस्टम पहुँच छैन"

msgid "Cannot access the file system at all"
msgstr "फाइल सिस्टम पहुँच गर्न सक्दै सक्दैन"

msgid "Uses System Services"
msgstr "सिस्टम सेवाहरू प्रयोग गर्छ"

msgid "Can request data from non-portal system services"
msgstr "गैर-पोर्टल सिस्टम सेवाहरूबाट डेटा अनुरोध गर्न सक्छ"

msgid "Uses Session Services"
msgstr "सत्र सेवाहरू प्रयोग गर्छ"

msgid "Can request data from non-portal session services"
msgstr "गैर-पोर्टल सत्र सेवाहरूबाट डेटा अनुरोध गर्न सक्छ"

msgid "No Service Access"
msgstr "सेवा पहुँच छैन"

msgid "Cannot access non-portal session or system services at all"
msgstr "गैर-पोर्टल सत्र वा सिस्टम सेवाहरू पहुँच गर्न सक्दै सक्दैन"

msgid "Verified App Developer"
msgstr "प्रमाणित एप विकासकर्ता"

msgid "The developer of this app has been verified to be who they say they are"
msgstr "यो एपका विकासकर्ता उनीहरूले भनेकै व्यक्ति हुन् भनी प्रमाणित गरिएको छ"

msgid "Proprietary Code"
msgstr "स्वामित्वयुक्त कोड"

msgid "The source code is not public, so it cannot be independently audited and might be unsafe"
msgstr "स्रोत कोड सार्वजनिक छैन, त्यसैले यसको स्वतन्त्र रूपमा लेखापरीक्षण गर्न सकिँदैन र यो असुरक्षित हुन सक्छ"

msgid "Auditable Code"
msgstr "लेखापरीक्षण गर्न सकिने कोड"

msgid "The source code is public and can be independently audited, which makes the app more likely to be safe"
msgstr "स्रोत कोड सार्वजनिक छ र स्वतन्त्र रूपमा लेखापरीक्षण गर्न सकिन्छ, जसले एप सुरक्षित हुने सम्भावना बढाउँछ"

#, c-format
msgid "Use the %s System Service"
msgstr "%s सिस्टम सेवा प्रयोग गर्नुहोस्"

#, c-format
msgid "Use the %s Session Service"
msgstr "%s सत्र सेवा प्रयोग गर्नुहोस्"

#, c-format
msgid "Use the %s Service"
msgstr "%s सेवा प्रयोग गर्नुहोस्"

msgid "Can see the non-portal service"
msgstr "गैर-पोर्टल सेवा देख्न सक्छ"

msgid "Can talk to the non-portal service"
msgstr "गैर-पोर्टल सेवासँग कुरा गर्न सक्छ"

msgid "Can own the non-portal service"
msgstr "गैर-पोर्टल सेवाको स्वामित्व लिन सक्छ"

msgid "Global Menu Integration"
msgstr "ग्लोबल मेनु एकीकरण"

msgid "Can display its menus in a global menu bar"
msgstr "आफ्ना मेनुहरू ग्लोबल मेनु पट्टीमा देखाउन सक्छ"

msgid "KDE Settings Integration"
msgstr "KDE सेटिङ एकीकरण"

msgid "Can detect when KDE desktop settings change"
msgstr "KDE डेस्कटप सेटिङहरू परिवर्तन हुँदा थाहा पाउन सक्छ"

msgid "KDE Global Settings"
msgstr "KDE ग्लोबल सेटिङहरू"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "फन्ट र रङ जस्ता KDE डेस्कटप प्राथमिकताहरू पढ्न सक्छ"

msgid "Secret Storage Service"
msgstr "गोप्य भण्डारण सेवा"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "सिस्टम किरिङ प्रयोग गरी आफ्नै पासवर्डहरू भण्डारण र पुनः प्राप्त गर्न सक्छ"

msgid "Desktop Notifications Service"
msgstr "डेस्कटप सूचना सेवा"

msgid "Can send desktop notifications"
msgstr "डेस्कटप सूचनाहरू पठाउन सक्छ"

msgid "System Tray Integration"
msgstr "सिस्टम ट्रे एकीकरण"

msgid "Can display an icon in the system tray"
msgstr "सिस्टम ट्रेमा आइकन देखाउन सक्छ"

msgid "KDE Connect Integration"
msgstr "KDE Connect एकीकरण"

msgid "Can interact with devices paired via KDE Connect"
msgstr "KDE Connect मार्फत जोडिएका उपकरणहरूसँग अन्तरक्रिया गर्न सक्छ"

