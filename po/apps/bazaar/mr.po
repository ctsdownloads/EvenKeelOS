msgid "Can read all data in your home directory"
msgstr "तुमच्या होम डिरेक्टरीतील सर्व डेटा वाचू शकते"

msgid "Download Folder Read/Write Access"
msgstr "डाउनलोड फोल्डर वाचन/लेखन प्रवेश"

msgid "Can read and write all data in your downloads directory"
msgstr "तुमच्या डाउनलोड डिरेक्टरीतील सर्व डेटा वाचू आणि लिहू शकते"

msgid "Download Folder Read Access"
msgstr "डाउनलोड फोल्डर वाचन प्रवेश"

msgid "Can read all data in your downloads directory"
msgstr "तुमच्या डाउनलोड डिरेक्टरीतील सर्व डेटा वाचू शकते"

msgid "Can read and write all data in the directory"
msgstr "डिरेक्टरीतील सर्व डेटा वाचू आणि लिहू शकते"

msgid "Can read all data in the directory"
msgstr "डिरेक्टरीतील सर्व डेटा वाचू शकते"

msgid "No File System Access"
msgstr "फाइल सिस्टम प्रवेश नाही"

msgid "Cannot access the file system at all"
msgstr "फाइल सिस्टमचा अजिबात वापर करू शकत नाही"

msgid "Uses System Services"
msgstr "सिस्टम सेवा वापरते"

msgid "Can request data from non-portal system services"
msgstr "पोर्टल नसलेल्या सिस्टम सेवांकडून डेटा मागवू शकते"

msgid "Uses Session Services"
msgstr "सत्र सेवा वापरते"

msgid "Can request data from non-portal session services"
msgstr "पोर्टल नसलेल्या सत्र सेवांकडून डेटा मागवू शकते"

msgid "No Service Access"
msgstr "सेवा प्रवेश नाही"

msgid "Cannot access non-portal session or system services at all"
msgstr "पोर्टल नसलेल्या सत्र किंवा सिस्टम सेवांचा अजिबात वापर करू शकत नाही"

msgid "Verified App Developer"
msgstr "सत्यापित ॲप डेव्हलपर"

msgid "The developer of this app has been verified to be who they say they are"
msgstr "या ॲपचा डेव्हलपर तो सांगतो तोच असल्याचे सत्यापित केले आहे"

msgid "Proprietary Code"
msgstr "मालकी हक्काचा कोड"

msgid "The source code is not public, so it cannot be independently audited and might be unsafe"
msgstr "सोर्स कोड सार्वजनिक नाही, त्यामुळे त्याची स्वतंत्रपणे तपासणी करता येत नाही आणि तो असुरक्षित असू शकतो"

msgid "Auditable Code"
msgstr "तपासता येण्याजोगा कोड"

msgid "The source code is public and can be independently audited, which makes the app more likely to be safe"
msgstr "सोर्स कोड सार्वजनिक आहे आणि त्याची स्वतंत्रपणे तपासणी करता येते, ज्यामुळे ॲप सुरक्षित असण्याची शक्यता वाढते"

#, c-format
msgid "Use the %s System Service"
msgstr "%s सिस्टम सेवा वापरा"

#, c-format
msgid "Use the %s Session Service"
msgstr "%s सत्र सेवा वापरा"

#, c-format
msgid "Use the %s Service"
msgstr "%s सेवा वापरा"

msgid "Can see the non-portal service"
msgstr "पोर्टल नसलेली सेवा पाहू शकते"

msgid "Can talk to the non-portal service"
msgstr "पोर्टल नसलेल्या सेवेशी बोलू शकते"

msgid "Can own the non-portal service"
msgstr "पोर्टल नसलेल्या सेवेची मालक होऊ शकते"

msgid "Global Menu Integration"
msgstr "ग्लोबल मेनू एकत्रीकरण"

msgid "Can display its menus in a global menu bar"
msgstr "आपले मेनू ग्लोबल मेनू बारमध्ये दाखवू शकते"

msgid "KDE Settings Integration"
msgstr "KDE सेटिंग्ज एकत्रीकरण"

msgid "Can detect when KDE desktop settings change"
msgstr "KDE डेस्कटॉप सेटिंग्ज बदलल्याचे ओळखू शकते"

msgid "KDE Global Settings"
msgstr "KDE ग्लोबल सेटिंग्ज"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "फॉन्ट आणि रंग यांसारख्या KDE डेस्कटॉप पसंती वाचू शकते"

msgid "Secret Storage Service"
msgstr "गुप्त संचयन सेवा"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "सिस्टम कीरिंग वापरून स्वतःचे पासवर्ड साठवू आणि मिळवू शकते"

msgid "Desktop Notifications Service"
msgstr "डेस्कटॉप सूचना सेवा"

msgid "Can send desktop notifications"
msgstr "डेस्कटॉप सूचना पाठवू शकते"

msgid "System Tray Integration"
msgstr "सिस्टम ट्रे एकत्रीकरण"

msgid "Can display an icon in the system tray"
msgstr "सिस्टम ट्रेमध्ये आयकॉन दाखवू शकते"

msgid "KDE Connect Integration"
msgstr "KDE Connect एकत्रीकरण"

msgid "Can interact with devices paired via KDE Connect"
msgstr "KDE Connect द्वारे जोडलेल्या डिव्हाइसशी संवाद साधू शकते"

