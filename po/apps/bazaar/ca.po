msgstr "L'aplicació està totalment aïllada"

msgid "Network Access"
msgstr "Accés a la xarxa"

msgid "Can access the internet"
msgstr "Pot accedir a internet"

msgid "No Network Access"
msgstr "Sense accés a la xarxa"

msgid "Cannot access the internet"
msgstr "No pot accedir a internet"

msgid "User Device Access"
msgstr "Accés als dispositius de l'usuari"

msgid "Can access devices such as webcams or gaming controllers"
msgstr "Pot accedir a dispositius com ara càmeres web o comandaments de jocs"

msgid "No User Device Access"
msgstr "Sense accés als dispositius de l'usuari"

msgid "Cannot access devices such as webcams or gaming controllers"
msgstr "No pot accedir a dispositius com ara càmeres web o comandaments de jocs"

msgid "Input Device Access"
msgstr "Accés als dispositius d'entrada"

msgid "Can access input devices"
msgstr "Pot accedir als dispositius d'entrada"

msgid "Microphone Access and Audio Playback"
msgstr "Accés al micròfon i reproducció d'àudio"

msgid "Can listen using microphones and play audio without asking permission"
msgstr "Pot escoltar amb micròfons i reproduir àudio sense demanar permís"

msgid "System Device Access"
msgstr "Accés als dispositius del sistema"

msgid "Can access system devices which require elevated permissions"
msgstr "Pot accedir a dispositius del sistema que requereixen permisos elevats"

msgid "Screen Contents Access"
msgstr "Accés al contingut de la pantalla"

msgid "Can access the contents of the screen or other windows"
msgstr "Pot accedir al contingut de la pantalla o d'altres finestres"

msgid "Legacy Windowing System"
msgstr "Sistema de finestres antic"

msgid "Always uses a legacy windowing system (X11)"
msgstr "Utilitza sempre un sistema de finestres antic (X11)"

msgid "Can acquire arbitrary permissions"
msgstr "Pot obtenir permisos arbitraris"

msgid "User Settings"
msgstr "Paràmetres de l'usuari"

msgid "Can access and change user settings"
msgstr "Pot accedir als paràmetres de l'usuari i canviar-los"

msgid "Full File System Read/Write Access"
msgstr "Accés complet de lectura i escriptura al sistema de fitxers"

msgid "Can read and write all data on the file system"
msgstr "Pot llegir i escriure totes les dades del sistema de fitxers"

msgid "Home Folder Read/Write Access"
msgstr "Accés de lectura i escriptura a la carpeta personal"

msgid "Can read and write all data in your home directory"
msgstr "Pot llegir i escriure totes les dades de la vostra carpeta personal"

msgid "Full File System Read Access"
msgstr "Accés complet de lectura al sistema de fitxers"

msgid "Can read all data on the file system"
msgstr "Pot llegir totes les dades del sistema de fitxers"

msgid "Home Folder Read Access"
msgstr "Accés de lectura a la carpeta personal"

msgid "Can read all data in your home directory"
msgstr "Pot llegir totes les dades de la vostra carpeta personal"

msgid "Download Folder Read/Write Access"
msgstr "Accés de lectura i escriptura a la carpeta de Baixades"

msgid "Can read and write all data in your downloads directory"
msgstr "Pot llegir i escriure totes les dades del vostre directori de baixades"

msgid "Download Folder Read Access"
msgstr "Accés de lectura a la carpeta de Baixades"

msgid "Can read all data in your downloads directory"
msgstr "Pot llegir totes les dades del vostre directori de baixades"

msgid "Can read and write all data in the directory"
msgstr "Pot llegir i escriure totes les dades del directori"

msgid "Can read all data in the directory"
msgstr "Pot llegir totes les dades del directori"

msgid "No File System Access"
msgstr "Sense accés al sistema de fitxers"

msgid "Cannot access the file system at all"
msgstr "No pot accedir de cap manera al sistema de fitxers"

msgid "Uses System Services"
msgstr "Utilitza serveis del sistema"

msgid "Can request data from non-portal system services"
msgstr "Pot sol·licitar dades a serveis del sistema que no són de portal"

msgid "Uses Session Services"
msgstr "Utilitza serveis de la sessió"

msgid "Can request data from non-portal session services"
msgstr "Pot sol·licitar dades a serveis de la sessió que no són de portal"

msgid "No Service Access"
msgstr "Sense accés a serveis"

msgid "Cannot access non-portal session or system services at all"
msgstr "No pot accedir de cap manera a serveis de la sessió ni del sistema que no siguin de portal"

msgid "Verified App Developer"
msgstr "Desenvolupador d'aplicacions verificat"

msgid "The developer of this app has been verified to be who they say they are"
msgstr "S'ha verificat que el desenvolupador d'aquesta aplicació és qui diu que és"

msgid "Proprietary Code"
msgstr "Codi privatiu"

msgid "The source code is not public, so it cannot be independently audited and might be unsafe"
msgstr "El codi font no és públic, de manera que no es pot auditar de manera independent i podria ser insegur"

msgid "Auditable Code"
msgstr "Codi auditable"

msgid "The source code is public and can be independently audited, which makes the app more likely to be safe"
msgstr "El codi font és públic i es pot auditar de manera independent, cosa que fa més probable que l'aplicació sigui segura"

#, c-format
msgid "Use the %s System Service"
msgstr "Utilitza el servei del sistema %s"

#, c-format
msgid "Use the %s Session Service"
msgstr "Utilitza el servei de la sessió %s"

#, c-format
msgid "Use the %s Service"
msgstr "Utilitza el servei %s"

msgid "Can see the non-portal service"
msgstr "Pot veure el servei que no és de portal"

msgid "Can talk to the non-portal service"
msgstr "Pot comunicar-se amb el servei que no és de portal"

msgid "Can own the non-portal service"
msgstr "Pot ser propietari del servei que no és de portal"

msgid "Global Menu Integration"
msgstr "Integració amb el menú global"

msgid "Can display its menus in a global menu bar"
msgstr "Pot mostrar els seus menús en una barra de menú global"

msgid "KDE Settings Integration"
msgstr "Integració amb els paràmetres del KDE"

msgid "Can detect when KDE desktop settings change"
msgstr "Pot detectar quan canvien els paràmetres de l'escriptori KDE"

msgid "KDE Global Settings"
msgstr "Paràmetres globals del KDE"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "Pot llegir les preferències de l'escriptori KDE, com ara tipus de lletra i colors"

msgid "Secret Storage Service"
msgstr "Servei d'emmagatzematge de secrets"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "Pot emmagatzemar i recuperar les seves pròpies contrasenyes amb el clauer del sistema"

msgid "Desktop Notifications Service"
msgstr "Servei de notificacions d'escriptori"

msgid "Can send desktop notifications"
msgstr "Pot enviar notificacions d'escriptori"

msgid "System Tray Integration"
msgstr "Integració amb la safata del sistema"

msgid "Can display an icon in the system tray"
msgstr "Pot mostrar una icona a la safata del sistema"

msgid "KDE Connect Integration"
msgstr "Integració amb el KDE Connect"

msgid "Can interact with devices paired via KDE Connect"
msgstr "Pot interactuar amb dispositius vinculats mitjançant el KDE Connect"

