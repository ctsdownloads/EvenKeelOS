msgstr "Ҳамгироӣ бо менюи умумӣ"

msgid "Can display its menus in a global menu bar"
msgstr "Метавонад менюҳои худро дар навори менюи умумӣ нишон диҳад"

msgid "KDE Settings Integration"
msgstr "Ҳамгироӣ бо танзимоти KDE"

msgid "Can detect when KDE desktop settings change"
msgstr "Метавонад тағйирёбии танзимоти мизи кории KDE-ро муайян кунад"

msgid "KDE Global Settings"
msgstr "Танзимоти умумии KDE"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "Метавонад афзалиятҳои мизи кории KDE-ро, мисли шрифтҳо ва рангҳо, бихонад"

msgid "Secret Storage Service"
msgstr "Хизматрасонии нигоҳдории махфӣ"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "Метавонад паролҳои худро бо истифода аз калидҳои система нигоҳ дорад ва гирад"

msgid "Desktop Notifications Service"
msgstr "Хизматрасонии огоҳиҳои мизи корӣ"

msgid "Can send desktop notifications"
msgstr "Метавонад огоҳиҳои мизи корӣ фиристад"

msgid "System Tray Integration"
msgstr "Ҳамгироӣ бо лотоки система"

msgid "Can display an icon in the system tray"
msgstr "Метавонад нишонаро дар лотоки система нишон диҳад"

msgid "KDE Connect Integration"
msgstr "Ҳамгироӣ бо KDE Connect"

msgid "Can interact with devices paired via KDE Connect"
msgstr "Метавонад бо дастгоҳҳое, ки тавассути KDE Connect пайваст шудаанд, ҳамкорӣ кунад"

