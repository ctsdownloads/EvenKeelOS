msgstr "%s до %s, най-много на %s със %s"

msgid "Remotes"
msgstr "Отдалечени хранилища"

msgid "System Installation"
msgstr "Системна инсталация"

msgid "Available to all users on this computer"
msgstr "Достъпно за всички потребители на този компютър"

msgid "User Installation"
msgstr "Потребителска инсталация"

msgid "Only available to you"
msgstr "Достъпно само за вас"

msgid "Remove Remote"
msgstr "Премахване на хранилището"

#, c-format
msgid "Remove %s"
msgstr "Премахване на %s"

msgid "Unused"
msgstr "Неизползвано"

#, c-format
msgid "%u app installed"
msgid_plural "%u apps installed"
msgstr[0] "%u инсталирана програма"
msgstr[1] "%u инсталирани програми"

#, c-format
msgid "Remove “%s”?"
msgstr "Премахване на „%s“?"

msgid "You will no longer be able to install apps from this user remote."
msgstr "Повече няма да можете да инсталирате програми от това потребителско хранилище."

msgid "You will no longer be able to install apps from this system remote."
msgstr "Повече няма да можете да инсталирате програми от това системно хранилище."

#, c-format
msgid "%u App to Remove"
msgid_plural "%u Apps to Remove"
msgstr[0] "%u програма за премахване"
msgstr[1] "%u програми за премахване"

msgid "The app below was installed from this remote and will be removed from your account along with it."
msgid_plural "These apps were installed from this remote and will be removed from your account along with it."
msgstr[0] "Програмата по-долу е инсталирана от това хранилище и ще бъде премахната от вашия акаунт заедно с него."
msgstr[1] "Програмите по-долу са инсталирани от това хранилище и ще бъдат премахнати от вашия акаунт заедно с него."

msgid "The app below was installed from this remote and will be removed for all users along with it."
msgid_plural "These apps were installed from this remote and will be removed for all users along with it."
msgstr[0] "Програмата по-долу е инсталирана от това хранилище и ще бъде премахната за всички потребители заедно с него."
msgstr[1] "Програмите по-долу са инсталирани от това хранилище и ще бъдат премахнати за всички потребители заедно с него."

msgid "Total"
msgstr "Общо"

