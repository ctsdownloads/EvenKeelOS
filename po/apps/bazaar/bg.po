msgid "Installs per day"
msgstr "Инсталации на ден"

msgid "Installs per country"
msgstr "Инсталации по държави"

msgid "Manage R_emotes"
msgstr "Управление на _хранилищата"

#, c-format
msgid "%s, %'u install"
msgid_plural "%s, %'u installs"
msgstr[0] "%s, %'u инсталация"
