msgid "Open Explore Page"
msgstr "ගවේෂණ පිටුව විවෘත කරන්න"

msgctxt "shortcut window"
msgid "Open Library Page"
msgstr "පුස්තකාල පිටුව විවෘත කරන්න"

msgctxt "shortcut window"
msgid "Open Search Page"
msgstr "සෙවුම් පිටුව විවෘත කරන්න"

msgctxt "shortcut window"
msgid "Remotes"
msgstr "දුරස්ථ මූලාශ්‍ර"

msgctxt "shortcut window"
msgid "Sync Remotes"
msgstr "දුරස්ථ මූලාශ්‍ර සමමුහුර්ත කරන්න"

msgctxt "shortcut window"
msgid "General"
msgstr "සාමාන්‍ය"

msgctxt "shortcut window"
msgid "Open Preferences"
msgstr "මනාප විවෘත කරන්න"

msgctxt "shortcut window"
msgid "Show Shortcuts"
msgstr "කෙටිමං පෙන්වන්න"

msgctxt "shortcut window"
msgid "Close Window"
msgstr "කවුළුව වසන්න"

msgctxt "shortcut window"
msgid "Quit Bazaar"
msgstr "Bazaar වෙතින් ඉවත් වන්න"

#, c-format
msgid "%s Installed"
msgstr "%s ස්ථාපිතයි"

msgid "The app is ready to be used"
msgstr "යෙදුම භාවිතයට සූදානම්"

msgid "Updates Are Out of Date"
msgstr "යාවත්කාලීන යල් පැන ගොසිනි"

msgid "Please check for available updates"
msgstr "කරුණාකර පවතින යාවත්කාලීන සඳහා පරීක්ෂා කරන්න"

#, c-format
msgid "%u App Updated"
msgid_plural "%u Apps Updated"
msgstr[0] "යෙදුම් %u යාවත්කාලීන කරන ලදී"
msgstr[1] "යෙදුම් %u යාවත්කාලීන කරන ලදී"

#, c-format
msgid "%s has been updated."
msgstr "%s යාවත්කාලීන කරන ලදී."

#, c-format
msgid "%s and %s have been updated."
msgstr "%s සහ %s යාවත්කාලීන කරන ලදී."

#, c-format
msgid "Includes %s, %s and %s."
msgstr "%s, %s සහ %s ඇතුළත් වේ."
