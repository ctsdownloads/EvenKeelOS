msgid "Legacy Windowing System"
msgstr "ಹಳೆಯ ವಿಂಡೋಯಿಂಗ್ ಸಿಸ್ಟಂ"

msgid "Always uses a legacy windowing system (X11)"
msgstr "ಯಾವಾಗಲೂ ಹಳೆಯ ವಿಂಡೋಯಿಂಗ್ ಸಿಸ್ಟಂ (X11) ಅನ್ನು ಬಳಸುತ್ತದೆ"

msgid "Can acquire arbitrary permissions"
msgstr "ಅನಿಯಂತ್ರಿತ ಅನುಮತಿಗಳನ್ನು ಪಡೆಯಬಹುದು"

msgid "User Settings"
msgstr "ಬಳಕೆದಾರ ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "Can access and change user settings"
msgstr "ಬಳಕೆದಾರ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪ್ರವೇಶಿಸಬಹುದು ಮತ್ತು ಬದಲಾಯಿಸಬಹುದು"

msgid "Full File System Read/Write Access"
msgstr "ಪೂರ್ಣ ಫೈಲ್ ಸಿಸ್ಟಂ ಓದು/ಬರೆ ಪ್ರವೇಶ"

msgid "Can read and write all data on the file system"
msgstr "ಫೈಲ್ ಸಿಸ್ಟಂನಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಓದಬಹುದು ಮತ್ತು ಬರೆಯಬಹುದು"

msgid "Home Folder Read/Write Access"
msgstr "ಹೋಮ್ ಫೋಲ್ಡರ್ ಓದು/ಬರೆ ಪ್ರವೇಶ"

msgid "Can read and write all data in your home directory"
msgstr "ನಿಮ್ಮ ಹೋಮ್ ಡೈರೆಕ್ಟರಿಯಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಓದಬಹುದು ಮತ್ತು ಬರೆಯಬಹುದು"

msgid "Full File System Read Access"
msgstr "ಪೂರ್ಣ ಫೈಲ್ ಸಿಸ್ಟಂ ಓದುವ ಪ್ರವೇಶ"

msgid "Can read all data on the file system"
msgstr "ಫೈಲ್ ಸಿಸ್ಟಂನಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಓದಬಹುದು"

msgid "Home Folder Read Access"
msgstr "ಹೋಮ್ ಫೋಲ್ಡರ್ ಓದುವ ಪ್ರವೇಶ"

msgid "Can read all data in your home directory"
msgstr "ನಿಮ್ಮ ಹೋಮ್ ಡೈರೆಕ್ಟರಿಯಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಓದಬಹುದು"

msgid "Download Folder Read/Write Access"
msgstr "ಡೌನ್‌ಲೋಡ್ ಫೋಲ್ಡರ್ ಓದು/ಬರೆ ಪ್ರವೇಶ"

msgid "Can read and write all data in your downloads directory"
msgstr "ನಿಮ್ಮ ಡೌನ್‌ಲೋಡ್‌ಗಳ ಡೈರೆಕ್ಟರಿಯಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಓದಬಹುದು ಮತ್ತು ಬರೆಯಬಹುದು"

msgid "Download Folder Read Access"
msgstr "ಡೌನ್‌ಲೋಡ್ ಫೋಲ್ಡರ್ ಓದುವ ಪ್ರವೇಶ"

msgid "Can read all data in your downloads directory"
msgstr "ನಿಮ್ಮ ಡೌನ್‌ಲೋಡ್‌ಗಳ ಡೈರೆಕ್ಟರಿಯಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಓದಬಹುದು"

msgid "Can read and write all data in the directory"
msgstr "ಡೈರೆಕ್ಟರಿಯಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಓದಬಹುದು ಮತ್ತು ಬರೆಯಬಹುದು"

msgid "Can read all data in the directory"
msgstr "ಡೈರೆಕ್ಟರಿಯಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಓದಬಹುದು"

msgid "No File System Access"
msgstr "ಫೈಲ್ ಸಿಸ್ಟಂ ಪ್ರವೇಶವಿಲ್ಲ"

msgid "Cannot access the file system at all"
msgstr "ಫೈಲ್ ಸಿಸ್ಟಂ ಅನ್ನು ಯಾವುದೇ ರೀತಿಯಲ್ಲಿ ಪ್ರವೇಶಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ"

msgid "Uses System Services"
msgstr "ಸಿಸ್ಟಂ ಸೇವೆಗಳನ್ನು ಬಳಸುತ್ತದೆ"

msgid "Can request data from non-portal system services"
msgstr "ಪೋರ್ಟಲ್ ಅಲ್ಲದ ಸಿಸ್ಟಂ ಸೇವೆಗಳಿಂದ ಡೇಟಾವನ್ನು ಕೋರಬಹುದು"

msgid "Uses Session Services"
msgstr "ಸೆಷನ್ ಸೇವೆಗಳನ್ನು ಬಳಸುತ್ತದೆ"

msgid "Can request data from non-portal session services"
msgstr "ಪೋರ್ಟಲ್ ಅಲ್ಲದ ಸೆಷನ್ ಸೇವೆಗಳಿಂದ ಡೇಟಾವನ್ನು ಕೋರಬಹುದು"

msgid "No Service Access"
msgstr "ಸೇವಾ ಪ್ರವೇಶವಿಲ್ಲ"

msgid "Cannot access non-portal session or system services at all"
msgstr "ಪೋರ್ಟಲ್ ಅಲ್ಲದ ಸೆಷನ್ ಅಥವಾ ಸಿಸ್ಟಂ ಸೇವೆಗಳನ್ನು ಯಾವುದೇ ರೀತಿಯಲ್ಲಿ ಪ್ರವೇಶಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ"

msgid "Verified App Developer"
msgstr "ಪರಿಶೀಲಿತ ಆ್ಯಪ್ ಡೆವಲಪರ್"

msgid "The developer of this app has been verified to be who they say they are"
msgstr "ಈ ಆ್ಯಪ್‌ನ ಡೆವಲಪರ್ ತಾವು ಹೇಳುವವರೇ ಎಂದು ಪರಿಶೀಲಿಸಲಾಗಿದೆ"

msgid "Proprietary Code"
msgstr "ಸ್ವಾಮ್ಯದ ಕೋಡ್"

msgid "The source code is not public, so it cannot be independently audited and might be unsafe"
msgstr "ಮೂಲ ಕೋಡ್ ಸಾರ್ವಜನಿಕವಾಗಿಲ್ಲ, ಆದ್ದರಿಂದ ಅದನ್ನು ಸ್ವತಂತ್ರವಾಗಿ ಪರಿಶೋಧಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ ಮತ್ತು ಅದು ಅಸುರಕ್ಷಿತವಾಗಿರಬಹುದು"

msgid "Auditable Code"
msgstr "ಪರಿಶೋಧಿಸಬಹುದಾದ ಕೋಡ್"

msgid "The source code is public and can be independently audited, which makes the app more likely to be safe"
msgstr "ಮೂಲ ಕೋಡ್ ಸಾರ್ವಜನಿಕವಾಗಿದೆ ಮತ್ತು ಸ್ವತಂತ್ರವಾಗಿ ಪರಿಶೋಧಿಸಬಹುದು, ಇದರಿಂದ ಆ್ಯಪ್ ಸುರಕ್ಷಿತವಾಗಿರುವ ಸಾಧ್ಯತೆ ಹೆಚ್ಚು"

#, c-format
msgid "Use the %s System Service"
msgstr "%s ಸಿಸ್ಟಂ ಸೇವೆಯನ್ನು ಬಳಸಿ"

#, c-format
msgid "Use the %s Session Service"
msgstr "%s ಸೆಷನ್ ಸೇವೆಯನ್ನು ಬಳಸಿ"

#, c-format
msgid "Use the %s Service"
msgstr "%s ಸೇವೆಯನ್ನು ಬಳಸಿ"

msgid "Can see the non-portal service"
msgstr "ಪೋರ್ಟಲ್ ಅಲ್ಲದ ಸೇವೆಯನ್ನು ನೋಡಬಹುದು"

msgid "Can talk to the non-portal service"
msgstr "ಪೋರ್ಟಲ್ ಅಲ್ಲದ ಸೇವೆಯೊಂದಿಗೆ ಮಾತನಾಡಬಹುದು"

msgid "Can own the non-portal service"
msgstr "ಪೋರ್ಟಲ್ ಅಲ್ಲದ ಸೇವೆಯನ್ನು ಹೊಂದಬಹುದು"

msgid "Global Menu Integration"
msgstr "ಗ್ಲೋಬಲ್ ಮೆನು ಏಕೀಕರಣ"

msgid "Can display its menus in a global menu bar"
msgstr "ತನ್ನ ಮೆನುಗಳನ್ನು ಗ್ಲೋಬಲ್ ಮೆನು ಬಾರ್‌ನಲ್ಲಿ ಪ್ರದರ್ಶಿಸಬಹುದು"

msgid "KDE Settings Integration"
msgstr "KDE ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಏಕೀಕರಣ"

msgid "Can detect when KDE desktop settings change"
msgstr "KDE ಡೆಸ್ಕ್‌ಟಾಪ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಬದಲಾದಾಗ ಪತ್ತೆಹಚ್ಚಬಹುದು"

msgid "KDE Global Settings"
msgstr "KDE ಜಾಗತಿಕ ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "Can read KDE desktop preferences like fonts and colors"
msgstr "ಫಾಂಟ್‌ಗಳು ಮತ್ತು ಬಣ್ಣಗಳಂತಹ KDE ಡೆಸ್ಕ್‌ಟಾಪ್ ಆದ್ಯತೆಗಳನ್ನು ಓದಬಹುದು"

msgid "Secret Storage Service"
msgstr "ರಹಸ್ಯ ಸಂಗ್ರಹಣೆ ಸೇವೆ"

msgid "Can store and retrieve its own passwords using the system keyring"
msgstr "ಸಿಸ್ಟಂ ಕೀರಿಂಗ್ ಬಳಸಿ ತನ್ನದೇ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸಂಗ್ರಹಿಸಬಹುದು ಮತ್ತು ಹಿಂಪಡೆಯಬಹುದು"

msgid "Desktop Notifications Service"
msgstr "ಡೆಸ್ಕ್‌ಟಾಪ್ ಅಧಿಸೂಚನೆ ಸೇವೆ"

msgid "Can send desktop notifications"
msgstr "ಡೆಸ್ಕ್‌ಟಾಪ್ ಅಧಿಸೂಚನೆಗಳನ್ನು ಕಳುಹಿಸಬಹುದು"

msgid "System Tray Integration"
msgstr "ಸಿಸ್ಟಂ ಟ್ರೇ ಏಕೀಕರಣ"

msgid "Can display an icon in the system tray"
msgstr "ಸಿಸ್ಟಂ ಟ್ರೇನಲ್ಲಿ ಐಕಾನ್ ಅನ್ನು ಪ್ರದರ್ಶಿಸಬಹುದು"

msgid "KDE Connect Integration"
msgstr "KDE Connect ಏಕೀಕರಣ"

msgid "Can interact with devices paired via KDE Connect"
msgstr "KDE Connect ಮೂಲಕ ಜೋಡಿಸಲಾದ ಸಾಧನಗಳೊಂದಿಗೆ ಸಂವಹನ ನಡೆಸಬಹುದು"

