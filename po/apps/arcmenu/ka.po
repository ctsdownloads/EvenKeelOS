msgid "Unpin from Folder"
msgstr "საქაღალდიდან მოხსნა"

#, javascript-format
msgid "%d more"
msgstr "კიდევ %d"

msgid "Keep ArcMenu Open on Ctrl+Click"
msgstr "ArcMenu-ის ღია დატოვება Ctrl+წკაპისას"

msgid "Prevents the menu from closing when activating items while holding Ctrl."
msgstr "ელემენტების გააქტიურებისას Ctrl-ის დაჭერილად ყოფნისას მენიუს დახურვას ხელს უშლის."

msgid "Category Icons"
msgstr "კატეგორიების ხატულები"

msgid "Shortcut Icons"
msgstr "მალსახმობების ხატულები"

msgid "Button Icons"
msgstr "ღილაკების ხატულები"

msgid "0 = unlimited"
msgstr "0 = შეუზღუდავი"

msgid "Display a category on the default menu view. Category must be enabled in ArcMenu Settings -> Menu -> Extra Categories section."
msgstr "კატეგორიის ჩვენება მენიუს ნაგულისხმევ ხედში. კატეგორია ჩართული უნდა იყოს ArcMenu-ის მორგება -> მენიუ -> დამატებითი კატეგორიების განყოფილებაში."

msgid "Override Menu Item Icon Sizes"
msgstr "მენიუს ელემენტების ხატულების ზომების გადაფარვა"

msgid "Small Wide"
msgstr "პატარა და განიერი"

msgid "Medium Wide"
msgstr "საშუალო და განიერი"

msgid "Large Wide"
msgstr "დიდი და განიერი"

msgid "Menu items displayed in grid style"
msgstr "მენიუს ელემენტები ბადის სტილში"

msgid "Presets"
msgstr "წინასწარ მითითებულები"

msgid "Grid Icon Size"
msgstr "ბადის ხატულების ზომა"

msgid "Width, Height, Icon Size"
msgstr "სიგანე, სიმაღლე, ხატულის ზომა"

msgid "Applications, pinned apps, and search results"
msgstr "აპლიკაციები, ამაგრებული აპები და ძებნის შედეგები"

msgid "Menu items found in side panels on various layouts"
msgstr "მენიუს ელემენტები სხვადასხვა განლაგების გვერდით პანელებში"

msgid "Buttons"
msgstr "ღილაკები"

msgid "Avatar, search icons, navigation icons"
msgstr "ავატარი, ძებნის ხატულები, ნავიგაციის ხატულები"

msgid "Hide Icon"
msgstr "ხატულის დამალვა"
