msgstr "જમણી બાજુની ટૅબ બંધ કરો"

msgid "Close all tabs to the right of the current one."
msgstr "હાલની ટૅબની જમણી બાજુની બધી ટૅબ બંધ કરો."

msgid "Close the current window."
msgstr "હાલની વિન્ડો બંધ કરો."

msgid "Close All Windows"
msgstr "બધી વિન્ડો બંધ કરો"

msgid "Close all windows."
msgstr "બધી વિન્ડો બંધ કરો."

msgid "Toggle Maximize"
msgstr "મોટું કરવાનું ટૉગલ કરો"

msgid "Toggle the maximized state of the current window."
msgstr "હાલની વિન્ડોની મોટી કરેલી સ્થિતિ ટૉગલ કરો."

msgid "Toggle Fullscreen"
msgstr "પૂર્ણસ્ક્રીન ટૉગલ કરો"

msgid "Toggle the fullscreen state of the current window."
msgstr "હાલની વિન્ડોની પૂર્ણસ્ક્રીન સ્થિતિ ટૉગલ કરો."

msgid "Toggle Window Decorations"
msgstr "વિન્ડો ડેકોરેશન ટૉગલ કરો"

msgid "Toggle the window decorations."
msgstr "વિન્ડો ડેકોરેશન ટૉગલ કરો."

msgid "Toggle Float on Top"
msgstr "ઉપર તરતું રાખવાનું ટૉગલ કરો"

msgid "Toggle the float on top state of the current window."
msgstr "હાલની વિન્ડોની ઉપર તરતું રાખવાની સ્થિતિ ટૉગલ કરો."

msgid "Toggle Secure Input"
msgstr "સુરક્ષિત ઇનપુટ ટૉગલ કરો"

msgid "Toggle secure input mode."
msgstr "સુરક્ષિત ઇનપુટ મોડ ટૉગલ કરો."

msgid "Toggle Mouse Reporting"
msgstr "માઉસ રિપોર્ટિંગ ટૉગલ કરો"

msgid "Toggle whether mouse events are reported to terminal applications."
msgstr "માઉસ ઇવેન્ટ્સ ટર્મિનલ ઍપ્લિકેશન્સને જણાવવામાં આવે કે નહીં તે ટૉગલ કરો."

msgid "Toggle Background Opacity"
msgstr "બૅકગ્રાઉન્ડ ઓપેસિટી ટૉગલ કરો"

msgid "Toggle the background opacity of a window that started transparent."
msgstr "પારદર્શક તરીકે શરૂ થયેલી વિન્ડોની બૅકગ્રાઉન્ડ ઓપેસિટી ટૉગલ કરો."

msgid "Check for Updates"
msgstr "અપડેટ્સ માટે તપાસો"

msgid "Check for updates to the application."
msgstr "ઍપ્લિકેશન માટે અપડેટ્સ તપાસો."

msgid "Undo"
msgstr "પૂર્વવત્ કરો"

msgid "Undo the last action."
msgstr "છેલ્લી ક્રિયા પૂર્વવત્ કરો."

msgid "Redo"
msgstr "ફરીથી કરો"

msgid "Redo the last undone action."
msgstr "છેલ્લે પૂર્વવત્ કરેલી ક્રિયા ફરીથી કરો."

msgid "Quit the application."
msgstr "ઍપ્લિકેશન બંધ કરો."

msgid "Ghostty"
msgstr "Ghostty"

msgid "Put a little Ghostty in your terminal."
msgstr "તમારા ટર્મિનલમાં થોડું Ghostty મૂકો."
