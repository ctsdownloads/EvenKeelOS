msgid "Open in Ghostty"
msgstr "Ghosttyમાં ખોલો"

msgid "Find…"
msgstr "શોધો…"

msgid "Previous Match"
msgstr "પાછલો મેળ"

msgid "Next Match"
msgstr "આગલો મેળ"

msgid "Close"
msgstr "બંધ કરો"

msgid "Oh, no."
msgstr "અરે, ના."

msgid "Unable to acquire an OpenGL context for rendering."
msgstr "રેન્ડરિંગ માટે OpenGL કૉન્ટેક્સ્ટ મેળવી શકાયો નથી."

msgid "This terminal is in read-only mode. You can still view, select, and scroll through the content, but no input events will be sent to the running application."
msgstr "આ ટર્મિનલ ફક્ત-વાંચવા માટેના મોડમાં છે. તમે હજી પણ સામગ્રી જોઈ, પસંદ કરી અને સ્ક્રોલ કરી શકો છો, પરંતુ ચાલી રહેલી ઍપ્લિકેશનને કોઈ ઇનપુટ ઇવેન્ટ મોકલવામાં આવશે નહીં."

msgid "Read-only"
msgstr "ફક્ત-વાંચવા માટે"

msgid "Copy"
msgstr "કૉપિ કરો"

msgid "Paste"
msgstr "પેસ્ટ કરો"

msgid "Notify on Next Command Finish"
msgstr "આગલો આદેશ પૂરો થાય ત્યારે સૂચિત કરો"

msgid "Clear"
msgstr "સાફ કરો"

msgid "Reset"
msgstr "રીસેટ કરો"

msgid "Split"
msgstr "વિભાજિત કરો"

msgid "Change Title…"
msgstr "શીર્ષક બદલો…"

msgid "Split Up"
msgstr "ઉપર વિભાજિત કરો"

msgid "Split Down"
msgstr "નીચે વિભાજિત કરો"

msgid "Split Left"
msgstr "ડાબે વિભાજિત કરો"

msgid "Split Right"
msgstr "જમણે વિભાજિત કરો"

msgid "Close Split"
msgstr "વિભાજન બંધ કરો"

msgid "Tab"
msgstr "ટૅબ"

msgid "Change Tab Title…"
msgstr "ટૅબનું શીર્ષક બદલો…"

msgid "New Tab"
msgstr "નવી ટૅબ"

msgid "Close Tab"
msgstr "ટૅબ બંધ કરો"

msgid "Window"
msgstr "વિન્ડો"

msgid "Change Window Title…"
msgstr "વિન્ડોનું શીર્ષક બદલો…"

msgid "New Window"
msgstr "નવી વિન્ડો"

msgid "Close Window"
msgstr "વિન્ડો બંધ કરો"

msgid "Config"
msgstr "રૂપરેખાંકન"

msgid "Open Configuration in OS Editor"
msgstr "OS એડિટરમાં રૂપરેખાંકન ખોલો"

msgid "Open Configuration in New Window"
msgstr "નવી વિન્ડોમાં રૂપરેખાંકન ખોલો"

msgid "Reload Configuration"
msgstr "રૂપરેખાંકન ફરીથી લોડ કરો"

msgid "⚠️ You're running a debug build of Ghostty! Performance will be degraded."
msgstr "⚠️ તમે Ghosttyનું ડીબગ બિલ્ડ ચલાવી રહ્યા છો! પર્ફોર્મન્સ ઘટશે."

msgid "Ghostty: Terminal Inspector"
msgstr "Ghostty: ટર્મિનલ ઇન્સ્પેક્ટર"

msgid "New Split"
msgstr "નવું વિભાજન"

msgid "View Open Tabs"
msgstr "ખુલ્લી ટૅબ જુઓ"

msgid "Main Menu"
msgstr "મુખ્ય મેનૂ"

msgid "Command Palette"
msgstr "કમાન્ડ પૅલેટ"

msgid "Terminal Inspector"
msgstr "ટર્મિનલ ઇન્સ્પેક્ટર"

msgid "About Ghostty"
msgstr "Ghostty વિશે"

msgid "Quit"
msgstr "બહાર નીકળો"

msgid "Authorize Clipboard Access"
msgstr "ક્લિપબોર્ડ ઍક્સેસને અધિકૃત કરો"

msgid "Deny"
msgstr "નકારો"

msgid "Allow"
msgstr "મંજૂરી આપો"

msgid "Remember choice for this split"
msgstr "આ વિભાજન માટે પસંદગી યાદ રાખો"

msgid "Reload configuration to show this prompt again"
msgstr "આ પ્રોમ્પ્ટ ફરીથી બતાવવા માટે રૂપરેખાંકન ફરીથી લોડ કરો"

msgid "Cancel"
msgstr "રદ કરો"

msgid "Execute a command…"
msgstr "આદેશ ચલાવો…"

msgid "Configuration Errors"
msgstr "રૂપરેખાંકનની ભૂલો"

msgid "One or more configuration errors were found. Please review the errors below, and either reload your configuration or ignore these errors."
msgstr "એક અથવા વધુ રૂપરેખાંકનની ભૂલો મળી આવી. કૃપા કરીને નીચેની ભૂલોની સમીક્ષા કરો, અને તમારું રૂપરેખાંકન ફરીથી લોડ કરો અથવા આ ભૂલોને અવગણો."

msgid "Ignore"
msgstr "અવગણો"

msgid "Leave blank to restore the default title."
msgstr "ડિફૉલ્ટ શીર્ષક પુનઃસ્થાપિત કરવા માટે ખાલી છોડો."

msgid "OK"
msgstr "ઠીક છે"

msgid "The keybind was revoked by the system."
msgstr "કીબાઇન્ડ સિસ્ટમ દ્વારા રદ કરવામાં આવ્યું."

msgid "The keybind was denied by the system."
msgstr "કીબાઇન્ડને સિસ્ટમ દ્વારા નકારવામાં આવ્યું."

msgid "Global keybind unavailable"
msgstr "ગ્લોબલ કીબાઇન્ડ ઉપલબ્ધ નથી"

msgid "Export Terminal IO Events"
msgstr "ટર્મિનલ IO ઇવેન્ટ્સ નિકાસ કરો"

msgid "Export"
msgstr "નિકાસ કરો"

msgid "Editing configuration file"
msgstr "રૂપરેખાંકન ફાઇલ સંપાદિત કરી રહ્યા છીએ"

msgid "An application is attempting to write to the clipboard. The current clipboard contents are shown below."
msgstr "એક ઍપ્લિકેશન ક્લિપબોર્ડ પર લખવાનો પ્રયાસ કરી રહી છે. હાલની ક્લિપબોર્ડ સામગ્રી નીચે બતાવવામાં આવી છે."

msgid "An application is attempting to read from the clipboard. The current clipboard contents are shown below."
msgstr "એક ઍપ્લિકેશન ક્લિપબોર્ડમાંથી વાંચવાનો પ્રયાસ કરી રહી છે. હાલની ક્લિપબોર્ડ સામગ્રી નીચે બતાવવામાં આવી છે."

msgid "Warning: Potentially Unsafe Paste"
msgstr "ચેતવણી: સંભવિત રીતે અસુરક્ષિત પેસ્ટ"

msgid "Pasting this text into the terminal may be dangerous as it looks like some commands may be executed."
msgstr "આ ટેક્સ્ટને ટર્મિનલમાં પેસ્ટ કરવું જોખમી હોઈ શકે છે, કારણ કે તેમાં કેટલાક આદેશો ચાલી જાય તેવું લાગે છે."

msgid "Quit Ghostty?"
msgstr "Ghostty બંધ કરવું છે?"

msgid "Close Tab?"
msgstr "ટૅબ બંધ કરવી છે?"

msgid "Close Window?"
msgstr "વિન્ડો બંધ કરવી છે?"

msgid "Close Split?"
msgstr "વિભાજન બંધ કરવું છે?"

msgid "All terminal sessions will be terminated."
msgstr "બધા ટર્મિનલ સત્રો સમાપ્ત કરવામાં આવશે."

msgid "All terminal sessions in this tab will be terminated."
msgstr "આ ટૅબના બધા ટર્મિનલ સત્રો સમાપ્ત કરવામાં આવશે."

msgid "All terminal sessions in this window will be terminated."
msgstr "આ વિન્ડોના બધા ટર્મિનલ સત્રો સમાપ્ત કરવામાં આવશે."

msgid "The currently running process in this split will be terminated."
msgstr "આ વિભાજનમાં હાલમાં ચાલતી પ્રક્રિયા સમાપ્ત કરવામાં આવશે."

msgid "Command Finished"
msgstr "આદેશ પૂરો થયો"

msgid "Command Succeeded"
msgstr "આદેશ સફળ થયો"

msgid "Command Failed"
msgstr "આદેશ નિષ્ફળ ગયો"

msgid "Change Terminal Title"
msgstr "ટર્મિનલનું શીર્ષક બદલો"

msgid "Change Tab Title"
msgstr "ટૅબનું શીર્ષક બદલો"

msgid "Change Window Title"
msgstr "વિન્ડોનું શીર્ષક બદલો"

msgid "Reloaded the configuration"
msgstr "રૂપરેખાંકન ફરીથી લોડ થયું"

msgid "Copied to clipboard"
msgstr "ક્લિપબોર્ડ પર કૉપિ થયું"

msgid "Cleared clipboard"
msgstr "ક્લિપબોર્ડ સાફ થયું"

msgid "Ghostty Developers"
msgstr "Ghostty ડેવલપર્સ"

msgid "Reset Terminal"
msgstr "ટર્મિનલ રીસેટ કરો"

msgid "Reset the terminal to a clean state."
msgstr "ટર્મિનલને સ્વચ્છ સ્થિતિમાં રીસેટ કરો."

msgid "Copy to Clipboard"
msgstr "ક્લિપબોર્ડ પર કૉપિ કરો"

msgid "Copy the selected text to the clipboard in both plain and styled formats."
msgstr "પસંદ કરેલ ટેક્સ્ટને સાદા અને શૈલીયુક્ત બંને ફોર્મેટમાં ક્લિપબોર્ડ પર કૉપિ કરો."

msgid "Copy Selection as Plain Text to Clipboard"
msgstr "પસંદગીને સાદા ટેક્સ્ટ તરીકે ક્લિપબોર્ડ પર કૉપિ કરો"

msgid "Copy the selected text as plain text to the clipboard."
msgstr "પસંદ કરેલ ટેક્સ્ટને સાદા ટેક્સ્ટ તરીકે ક્લિપબોર્ડ પર કૉપિ કરો."

msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "પસંદગીને ANSI સિક્વન્સ તરીકે ક્લિપબોર્ડ પર કૉપિ કરો"

msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr "પસંદ કરેલ ટેક્સ્ટને ANSI એસ્કેપ સિક્વન્સ તરીકે ક્લિપબોર્ડ પર કૉપિ કરો."

msgid "Copy Selection as HTML to Clipboard"
msgstr "પસંદગીને HTML તરીકે ક્લિપબોર્ડ પર કૉપિ કરો"

msgid "Copy the selected text as HTML to the clipboard."
msgstr "પસંદ કરેલ ટેક્સ્ટને HTML તરીકે ક્લિપબોર્ડ પર કૉપિ કરો."

msgid "Copy URL to Clipboard"
msgstr "URL ક્લિપબોર્ડ પર કૉપિ કરો"

msgid "Copy the URL under the cursor to the clipboard."
msgstr "કર્સર નીચેનું URL ક્લિપબોર્ડ પર કૉપિ કરો."

msgid "Copy Terminal Title to Clipboard"
msgstr "ટર્મિનલનું શીર્ષક ક્લિપબોર્ડ પર કૉપિ કરો"

msgid "Copy the terminal title to the clipboard. If the terminal title is not set this has no effect."
msgstr "ટર્મિનલનું શીર્ષક ક્લિપબોર્ડ પર કૉપિ કરો. જો ટર્મિનલનું શીર્ષક સેટ કરેલું ન હોય તો તેની કોઈ અસર થતી નથી."

msgid "Paste from Clipboard"
msgstr "ક્લિપબોર્ડમાંથી પેસ્ટ કરો"

msgid "Paste the contents of the main clipboard."
msgstr "મુખ્ય ક્લિપબોર્ડની સામગ્રી પેસ્ટ કરો."

msgid "Paste from Selection"
msgstr "પસંદગીમાંથી પેસ્ટ કરો"

msgid "Paste the contents of the selection clipboard."
msgstr "સિલેક્શન ક્લિપબોર્ડની સામગ્રી પેસ્ટ કરો."

msgid "Start Search"
msgstr "શોધ શરૂ કરો"

msgid "Start a search if one isn't already active."
msgstr "જો શોધ પહેલેથી સક્રિય ન હોય તો શોધ શરૂ કરો."

msgid "Search Selection"
msgstr "પસંદગી શોધો"

msgid "Start a search for the current text selection."
msgstr "હાલની ટેક્સ્ટ પસંદગી માટે શોધ શરૂ કરો."

msgid "End Search"
msgstr "શોધ સમાપ્ત કરો"

msgid "End the current search if any and hide any GUI elements."
msgstr "જો કોઈ ચાલુ શોધ હોય તો તેને સમાપ્ત કરો અને બધા GUI ઘટકો છુપાવો."

msgid "Next Search Result"
msgstr "આગલું શોધ પરિણામ"

msgid "Navigate to the next search result, if any."
msgstr "જો કોઈ હોય તો આગલા શોધ પરિણામ પર જાઓ."

msgid "Previous Search Result"
msgstr "પાછલું શોધ પરિણામ"

msgid "Navigate to the previous search result, if any."
msgstr "જો કોઈ હોય તો પાછલા શોધ પરિણામ પર જાઓ."

msgid "Increase Font Size"
msgstr "ફોન્ટનું કદ વધારો"

msgid "Increase the font size by 1 point."
msgstr "ફોન્ટનું કદ 1 પૉઇન્ટ વધારો."

msgid "Decrease Font Size"
msgstr "ફોન્ટનું કદ ઘટાડો"

msgid "Decrease the font size by 1 point."
msgstr "ફોન્ટનું કદ 1 પૉઇન્ટ ઘટાડો."

msgid "Reset Font Size"
msgstr "ફોન્ટનું કદ રીસેટ કરો"

msgid "Reset the font size to the default."
msgstr "ફોન્ટનું કદ ડિફૉલ્ટ પર રીસેટ કરો."

msgid "Clear Screen"
msgstr "સ્ક્રીન સાફ કરો"

msgid "Clear the screen and scrollback."
msgstr "સ્ક્રીન અને સ્ક્રોલબૅક સાફ કરો."

msgid "Select All"
msgstr "બધું પસંદ કરો"

msgid "Select all text on the screen."
msgstr "સ્ક્રીન પરનો બધો ટેક્સ્ટ પસંદ કરો."

msgid "Scroll to Top"
msgstr "ઉપર સુધી સ્ક્રોલ કરો"

msgid "Scroll to the top of the screen."
msgstr "સ્ક્રીનના ઉપરના ભાગ સુધી સ્ક્રોલ કરો."

msgid "Scroll to Bottom"
msgstr "નીચે સુધી સ્ક્રોલ કરો"

msgid "Scroll to the bottom of the screen."
msgstr "સ્ક્રીનના નીચેના ભાગ સુધી સ્ક્રોલ કરો."

msgid "Scroll to Selection"
msgstr "પસંદગી સુધી સ્ક્રોલ કરો"

msgid "Scroll to the selected text."
msgstr "પસંદ કરેલ ટેક્સ્ટ સુધી સ્ક્રોલ કરો."

msgid "Scroll Page Up"
msgstr "પેજ ઉપર સ્ક્રોલ કરો"

msgid "Scroll the screen up by a page."
msgstr "સ્ક્રીનને એક પેજ ઉપર સ્ક્રોલ કરો."

msgid "Scroll Page Down"
msgstr "પેજ નીચે સ્ક્રોલ કરો"

msgid "Scroll the screen down by a page."
