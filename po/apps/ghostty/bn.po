msgid "Open in Ghostty"
msgstr "Ghostty-তে খুলুন"

msgid "Find…"
msgstr "খুঁজুন…"

msgid "Previous Match"
msgstr "আগের মিল"

msgid "Next Match"
msgstr "পরের মিল"

msgid "Close"
msgstr "বন্ধ করুন"

msgid "Oh, no."
msgstr "ওহ, না।"

msgid "Unable to acquire an OpenGL context for rendering."
msgstr "রেন্ডারিংয়ের জন্য OpenGL কনটেক্সট পাওয়া যায়নি।"

msgid "This terminal is in read-only mode. You can still view, select, and scroll through the content, but no input events will be sent to the running application."
msgstr "এই টার্মিনাল কেবল-পাঠযোগ্য মোডে আছে। আপনি এখনও বিষয়বস্তু দেখতে, নির্বাচন করতে ও স্ক্রল করতে পারবেন, কিন্তু চলমান অ্যাপ্লিকেশনে কোনো ইনপুট ইভেন্ট পাঠানো হবে না।"

msgid "Read-only"
msgstr "কেবল-পাঠযোগ্য"

msgid "Copy"
msgstr "কপি করুন"

msgid "Paste"
msgstr "পেস্ট করুন"

msgid "Notify on Next Command Finish"
msgstr "পরের কমান্ড শেষ হলে জানান"

msgid "Clear"
msgstr "মুছে ফেলুন"

msgid "Reset"
msgstr "রিসেট করুন"

msgid "Split"
msgstr "স্প্লিট"

msgid "Change Title…"
msgstr "শিরোনাম পরিবর্তন করুন…"

msgid "Split Up"
msgstr "উপরে স্প্লিট করুন"

msgid "Split Down"
msgstr "নিচে স্প্লিট করুন"

msgid "Split Left"
msgstr "বাঁয়ে স্প্লিট করুন"

msgid "Split Right"
msgstr "ডানে স্প্লিট করুন"

msgid "Close Split"
msgstr "স্প্লিট বন্ধ করুন"

msgid "Tab"
msgstr "ট্যাব"

msgid "Change Tab Title…"
msgstr "ট্যাবের শিরোনাম পরিবর্তন করুন…"

msgid "New Tab"
msgstr "নতুন ট্যাব"

msgid "Close Tab"
msgstr "ট্যাব বন্ধ করুন"

msgid "Window"
msgstr "উইন্ডো"

msgid "Change Window Title…"
msgstr "উইন্ডোর শিরোনাম পরিবর্তন করুন…"

msgid "New Window"
msgstr "নতুন উইন্ডো"

msgid "Close Window"
msgstr "উইন্ডো বন্ধ করুন"

msgid "Config"
msgstr "কনফিগারেশন"

msgid "Open Configuration in OS Editor"
msgstr "অপারেটিং সিস্টেমের এডিটরে কনফিগারেশন খুলুন"

msgid "Open Configuration in New Window"
msgstr "নতুন উইন্ডোতে কনফিগারেশন খুলুন"

msgid "Reload Configuration"
msgstr "কনফিগারেশন পুনরায় লোড করুন"

msgid "⚠️ You're running a debug build of Ghostty! Performance will be degraded."
msgstr "⚠️ আপনি Ghostty-র একটি ডিবাগ বিল্ড চালাচ্ছেন! কর্মক্ষমতা কমে যাবে।"

msgid "Ghostty: Terminal Inspector"
msgstr "Ghostty: টার্মিনাল ইন্সপেক্টর"

msgid "New Split"
msgstr "নতুন স্প্লিট"

msgid "View Open Tabs"
msgstr "খোলা ট্যাবগুলি দেখুন"

msgid "Main Menu"
msgstr "প্রধান মেনু"

msgid "Command Palette"
msgstr "কমান্ড প্যালেট"

msgid "Terminal Inspector"
msgstr "টার্মিনাল ইন্সপেক্টর"

msgid "About Ghostty"
msgstr "Ghostty সম্পর্কে"

msgid "Quit"
msgstr "প্রস্থান করুন"

msgid "Authorize Clipboard Access"
msgstr "ক্লিপবোর্ডে অ্যাক্সেসের অনুমতি দিন"

msgid "Deny"
msgstr "প্রত্যাখ্যান করুন"

msgid "Allow"
msgstr "অনুমতি দিন"

msgid "Remember choice for this split"
msgstr "এই স্প্লিটের জন্য পছন্দটি মনে রাখুন"

msgid "Reload configuration to show this prompt again"
msgstr "এই প্রম্পটটি আবার দেখতে কনফিগারেশন পুনরায় লোড করুন"

msgid "Cancel"
msgstr "বাতিল করুন"

msgid "Execute a command…"
msgstr "একটি কমান্ড চালান…"

msgid "Configuration Errors"
msgstr "কনফিগারেশন ত্রুটি"

msgid "One or more configuration errors were found. Please review the errors below, and either reload your configuration or ignore these errors."
msgstr "এক বা একাধিক কনফিগারেশন ত্রুটি পাওয়া গেছে। অনুগ্রহ করে নিচের ত্রুটিগুলি দেখুন, এবং হয় আপনার কনফিগারেশন পুনরায় লোড করুন, নয়তো এই ত্রুটিগুলি উপেক্ষা করুন।"

msgid "Ignore"
msgstr "উপেক্ষা করুন"

msgid "Leave blank to restore the default title."
msgstr "ডিফল্ট শিরোনাম ফিরিয়ে আনতে ফাঁকা রাখুন।"

msgid "OK"
msgstr "ঠিক আছে"

msgid "The keybind was revoked by the system."
msgstr "সিস্টেম কিবাইন্ডটি প্রত্যাহার করেছে।"

msgid "The keybind was denied by the system."
msgstr "সিস্টেম কিবাইন্ডটি প্রত্যাখ্যান করেছে।"

msgid "Global keybind unavailable"
msgstr "গ্লোবাল কিবাইন্ড উপলব্ধ নেই"

msgid "Export Terminal IO Events"
msgstr "টার্মিনাল IO ইভেন্ট এক্সপোর্ট করুন"

msgid "Export"
msgstr "এক্সপোর্ট করুন"

msgid "Editing configuration file"
msgstr "কনফিগারেশন ফাইল সম্পাদনা করা হচ্ছে"

msgid "An application is attempting to write to the clipboard. The current clipboard contents are shown below."
msgstr "একটি অ্যাপ্লিকেশন ক্লিপবোর্ডে লেখার চেষ্টা করছে। ক্লিপবোর্ডের বর্তমান বিষয়বস্তু নিচে দেখানো হয়েছে।"

msgid "An application is attempting to read from the clipboard. The current clipboard contents are shown below."
msgstr "একটি অ্যাপ্লিকেশন ক্লিপবোর্ড থেকে পড়ার চেষ্টা করছে। ক্লিপবোর্ডের বর্তমান বিষয়বস্তু নিচে দেখানো হয়েছে।"

msgid "Warning: Potentially Unsafe Paste"
msgstr "সতর্কতা: সম্ভাব্য অনিরাপদ পেস্ট"

msgid "Pasting this text into the terminal may be dangerous as it looks like some commands may be executed."
msgstr "এই লেখা টার্মিনালে পেস্ট করা বিপজ্জনক হতে পারে, কারণ দেখে মনে হচ্ছে কিছু কমান্ড চালানো হতে পারে।"

msgid "Quit Ghostty?"
msgstr "Ghostty থেকে প্রস্থান করবেন?"

msgid "Close Tab?"
msgstr "ট্যাব বন্ধ করবেন?"

msgid "Close Window?"
msgstr "উইন্ডো বন্ধ করবেন?"

msgid "Close Split?"
msgstr "স্প্লিট বন্ধ করবেন?"

msgid "All terminal sessions will be terminated."
msgstr "সব টার্মিনাল সেশন বন্ধ করে দেওয়া হবে।"

msgid "All terminal sessions in this tab will be terminated."
msgstr "এই ট্যাবের সব টার্মিনাল সেশন বন্ধ করে দেওয়া হবে।"

msgid "All terminal sessions in this window will be terminated."
msgstr "এই উইন্ডোর সব টার্মিনাল সেশন বন্ধ করে দেওয়া হবে।"

msgid "The currently running process in this split will be terminated."
msgstr "এই স্প্লিটে বর্তমানে চলমান প্রক্রিয়াটি বন্ধ করে দেওয়া হবে।"

msgid "Command Finished"
msgstr "কমান্ড শেষ হয়েছে"

msgid "Command Succeeded"
msgstr "কমান্ড সফল হয়েছে"

msgid "Command Failed"
msgstr "কমান্ড ব্যর্থ হয়েছে"

msgid "Change Terminal Title"
msgstr "টার্মিনালের শিরোনাম পরিবর্তন করুন"

msgid "Change Tab Title"
msgstr "ট্যাবের শিরোনাম পরিবর্তন করুন"

msgid "Change Window Title"
msgstr "উইন্ডোর শিরোনাম পরিবর্তন করুন"

msgid "Reloaded the configuration"
msgstr "কনফিগারেশন পুনরায় লোড করা হয়েছে"

msgid "Copied to clipboard"
msgstr "ক্লিপবোর্ডে কপি করা হয়েছে"

msgid "Cleared clipboard"
msgstr "ক্লিপবোর্ড মুছে ফেলা হয়েছে"

msgid "Ghostty Developers"
msgstr "Ghostty ডেভেলপারগণ"

msgid "Reset Terminal"
msgstr "টার্মিনাল রিসেট করুন"

msgid "Reset the terminal to a clean state."
msgstr "টার্মিনালকে পরিষ্কার অবস্থায় রিসেট করুন।"

msgid "Copy to Clipboard"
msgstr "ক্লিপবোর্ডে কপি করুন"

msgid "Copy the selected text to the clipboard in both plain and styled formats."
msgstr "নির্বাচিত লেখা সাধারণ ও স্টাইলযুক্ত, উভয় ফরম্যাটে ক্লিপবোর্ডে কপি করুন।"

msgid "Copy Selection as Plain Text to Clipboard"
msgstr "নির্বাচিত অংশ সাধারণ লেখা হিসেবে ক্লিপবোর্ডে কপি করুন"

msgid "Copy the selected text as plain text to the clipboard."
msgstr "নির্বাচিত লেখা সাধারণ লেখা হিসেবে ক্লিপবোর্ডে কপি করুন।"

msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "নির্বাচিত অংশ ANSI সিকোয়েন্স হিসেবে ক্লিপবোর্ডে কপি করুন"

msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr "নির্বাচিত লেখা ANSI এস্কেপ সিকোয়েন্স হিসেবে ক্লিপবোর্ডে কপি করুন।"

msgid "Copy Selection as HTML to Clipboard"
msgstr "নির্বাচিত অংশ HTML হিসেবে ক্লিপবোর্ডে কপি করুন"

msgid "Copy the selected text as HTML to the clipboard."
msgstr "নির্বাচিত লেখা HTML হিসেবে ক্লিপবোর্ডে কপি করুন।"

msgid "Copy URL to Clipboard"
msgstr "URL ক্লিপবোর্ডে কপি করুন"

msgid "Copy the URL under the cursor to the clipboard."
msgstr "কার্সরের নিচের URL ক্লিপবোর্ডে কপি করুন।"

msgid "Copy Terminal Title to Clipboard"
msgstr "টার্মিনালের শিরোনাম ক্লিপবোর্ডে কপি করুন"

msgid "Copy the terminal title to the clipboard. If the terminal title is not set this has no effect."
msgstr "টার্মিনালের শিরোনাম ক্লিপবোর্ডে কপি করুন। টার্মিনালের শিরোনাম ঠিক করা না থাকলে এর কোনো প্রভাব পড়বে না।"

msgid "Paste from Clipboard"
msgstr "ক্লিপবোর্ড থেকে পেস্ট করুন"

msgid "Paste the contents of the main clipboard."
msgstr "প্রধান ক্লিপবোর্ডের বিষয়বস্তু পেস্ট করুন।"

msgid "Paste from Selection"
msgstr "নির্বাচন থেকে পেস্ট করুন"

msgid "Paste the contents of the selection clipboard."
msgstr "নির্বাচন ক্লিপবোর্ডের বিষয়বস্তু পেস্ট করুন।"

msgid "Start Search"
msgstr "অনুসন্ধান শুরু করুন"

msgid "Start a search if one isn't already active."
msgstr "আগে থেকে সক্রিয় না থাকলে একটি অনুসন্ধান শুরু করুন।"

msgid "Search Selection"
msgstr "নির্বাচিত অংশ অনুসন্ধান করুন"

msgid "Start a search for the current text selection."
msgstr "বর্তমানে নির্বাচিত লেখার জন্য অনুসন্ধান শুরু করুন।"

msgid "End Search"
msgstr "অনুসন্ধান শেষ করুন"

msgid "End the current search if any and hide any GUI elements."
msgstr "চলমান অনুসন্ধান থাকলে তা শেষ করুন এবং সব GUI উপাদান লুকিয়ে ফেলুন।"

msgid "Next Search Result"
msgstr "পরের অনুসন্ধান ফলাফল"

msgid "Navigate to the next search result, if any."
msgstr "পরের অনুসন্ধান ফলাফল থাকলে সেখানে যান।"

msgid "Previous Search Result"
msgstr "আগের অনুসন্ধান ফলাফল"

msgid "Navigate to the previous search result, if any."
msgstr "আগের অনুসন্ধান ফলাফল থাকলে সেখানে যান।"

msgid "Increase Font Size"
msgstr "ফন্টের আকার বাড়ান"

msgid "Increase the font size by 1 point."
msgstr "ফন্টের আকার ১ পয়েন্ট বাড়ান।"

msgid "Decrease Font Size"
msgstr "ফন্টের আকার কমান"

msgid "Decrease the font size by 1 point."
msgstr "ফন্টের আকার ১ পয়েন্ট কমান।"

msgid "Reset Font Size"
msgstr "ফন্টের আকার রিসেট করুন"

msgid "Reset the font size to the default."
msgstr "ফন্টের আকার ডিফল্টে ফিরিয়ে আনুন।"

msgid "Clear Screen"
msgstr "স্ক্রিন পরিষ্কার করুন"

msgid "Clear the screen and scrollback."
msgstr "স্ক্রিন ও স্ক্রলব্যাক পরিষ্কার করুন।"

msgid "Select All"
msgstr "সব নির্বাচন করুন"

msgid "Select all text on the screen."
msgstr "স্ক্রিনের সব লেখা নির্বাচন করুন।"

msgid "Scroll to Top"
msgstr "একদম উপরে স্ক্রল করুন"

msgid "Scroll to the top of the screen."
msgstr "স্ক্রিনের একদম উপরে স্ক্রল করুন।"

msgid "Scroll to Bottom"
msgstr "একদম নিচে স্ক্রল করুন"

msgid "Scroll to the bottom of the screen."
msgstr "স্ক্রিনের একদম নিচে স্ক্রল করুন।"

msgid "Scroll to Selection"
msgstr "নির্বাচিত অংশে স্ক্রল করুন"

msgid "Scroll to the selected text."
msgstr "নির্বাচিত লেখায় স্ক্রল করুন।"

msgid "Scroll Page Up"
msgstr "এক পাতা উপরে স্ক্রল করুন"

msgid "Scroll the screen up by a page."
msgstr "স্ক্রিন এক পাতা উপরে স্ক্রল করুন।"

msgid "Scroll Page Down"
msgstr "এক পাতা নিচে স্ক্রল করুন"

msgid "Scroll the screen down by a page."
msgstr "স্ক্রিন এক পাতা নিচে স্ক্রল করুন।"

msgid "Copy Screen to Temporary File and Copy Path"
msgstr "স্ক্রিন অস্থায়ী ফাইলে কপি করুন ও পাথ কপি করুন"

msgid "Copy the screen contents to a temporary file and copy the path to the clipboard."
msgstr "স্ক্রিনের বিষয়বস্তু একটি অস্থায়ী ফাইলে কপি করুন এবং পাথ ক্লিপবোর্ডে কপি করুন।"

msgid "Copy Screen to Temporary File and Paste Path"
msgstr "স্ক্রিন অস্থায়ী ফাইলে কপি করুন ও পাথ পেস্ট করুন"

msgid "Copy the screen contents to a temporary file and paste the path to the file."
