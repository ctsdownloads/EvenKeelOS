msgstr "বর্তমান উইন্ডোর বড় করা অবস্থা চালু বা বন্ধ করুন।"

msgid "Toggle Fullscreen"
msgstr "ফুলস্ক্রিন চালু/বন্ধ করুন"

msgid "Toggle the fullscreen state of the current window."
msgstr "বর্তমান উইন্ডোর ফুলস্ক্রিন অবস্থা চালু বা বন্ধ করুন।"

msgid "Toggle Window Decorations"
msgstr "উইন্ডো সাজসজ্জা চালু/বন্ধ করুন"

msgid "Toggle the window decorations."
msgstr "উইন্ডোর সাজসজ্জা চালু বা বন্ধ করুন।"

msgid "Toggle Float on Top"
msgstr "সবার উপরে ভাসা চালু/বন্ধ করুন"

msgid "Toggle the float on top state of the current window."
msgstr "বর্তমান উইন্ডোর সবার উপরে ভেসে থাকার অবস্থা চালু বা বন্ধ করুন।"

msgid "Toggle Secure Input"
msgstr "নিরাপদ ইনপুট চালু/বন্ধ করুন"

msgid "Toggle secure input mode."
msgstr "নিরাপদ ইনপুট মোড চালু বা বন্ধ করুন।"

msgid "Toggle Mouse Reporting"
msgstr "মাউস রিপোর্টিং চালু/বন্ধ করুন"

msgid "Toggle whether mouse events are reported to terminal applications."
msgstr "মাউস ইভেন্ট টার্মিনাল অ্যাপ্লিকেশনগুলিকে জানানো হবে কি না, তা চালু বা বন্ধ করুন।"

msgid "Toggle Background Opacity"
msgstr "পটভূমির অস্বচ্ছতা চালু/বন্ধ করুন"

msgid "Toggle the background opacity of a window that started transparent."
msgstr "স্বচ্ছ অবস্থায় শুরু হওয়া উইন্ডোর পটভূমির অস্বচ্ছতা চালু বা বন্ধ করুন।"

msgid "Check for Updates"
msgstr "আপডেট খুঁজুন"

msgid "Check for updates to the application."
msgstr "অ্যাপ্লিকেশনের আপডেট খুঁজুন।"

msgid "Undo"
msgstr "আগের অবস্থায় ফেরান"

msgid "Undo the last action."
msgstr "শেষ কাজটি আগের অবস্থায় ফেরান।"

msgid "Redo"
msgstr "আবার করুন"

msgid "Redo the last undone action."
msgstr "সর্বশেষ আগের অবস্থায় ফেরানো কাজটি আবার করুন।"

msgid "Quit the application."
msgstr "অ্যাপ্লিকেশন থেকে প্রস্থান করুন।"

msgid "Ghostty"
msgstr "Ghostty"

msgid "Put a little Ghostty in your terminal."
msgstr "আপনার টার্মিনালে একটু Ghostty রাখুন।"
