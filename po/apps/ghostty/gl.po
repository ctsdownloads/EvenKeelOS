msgid "Open a new window."
msgstr "Abre unha nova xanela."

msgid "Open a new tab."
msgstr "Abre unha nova lapela."

msgid "Move Tab Left"
msgstr "Mover a lapela á esquerda"

msgid "Move the current tab to the left."
msgstr "Move a lapela actual á esquerda."

msgid "Move Tab Right"
msgstr "Mover a lapela á dereita"

msgid "Move the current tab to the right."
msgstr "Move a lapela actual á dereita."

msgid "Move Tab to New Window"
msgstr "Mover a lapela a unha nova xanela"

msgid "Move the current tab to a new window."
msgstr "Move a lapela actual a unha nova xanela."

msgid "Toggle Tab Overview"
msgstr "Alternar a vista xeral de lapelas"

msgid "Toggle the tab overview."
msgstr "Alterna a vista xeral de lapelas."

msgid "Change Terminal Title…"
msgstr "Cambiar o título do terminal…"

msgid "Prompt for a new title for the current terminal."
msgstr "Pide un novo título para o terminal actual."

msgid "Prompt for a new title for the current tab."
msgstr "Pide un novo título para a lapela actual."

msgid "Split the terminal to the left."
msgstr "Divide o terminal cara á esquerda."

msgid "Split the terminal to the right."
msgstr "Divide o terminal cara á dereita."

msgid "Split the terminal up."
msgstr "Divide o terminal cara arriba."

msgid "Split the terminal down."
msgstr "Divide o terminal cara abaixo."

msgid "Focus Split: Previous"
msgstr "Foco na división: anterior"

msgid "Focus the previous split, if any."
msgstr "Dá o foco á división anterior, se hai algunha."

msgid "Focus Split: Next"
msgstr "Foco na división: seguinte"

msgid "Focus the next split, if any."
msgstr "Dá o foco á división seguinte, se hai algunha."

msgid "Focus Split: Left"
msgstr "Foco na división: esquerda"

msgid "Focus the split to the left, if it exists."
msgstr "Dá o foco á división da esquerda, se existe."

msgid "Focus Split: Right"
msgstr "Foco na división: dereita"

msgid "Focus the split to the right, if it exists."
msgstr "Dá o foco á división da dereita, se existe."

msgid "Focus Split: Up"
msgstr "Foco na división: arriba"

msgid "Focus the split above, if it exists."
msgstr "Dá o foco á división de enriba, se existe."

msgid "Focus Split: Down"
msgstr "Foco na división: abaixo"

msgid "Focus the split below, if it exists."
msgstr "Dá o foco á división de embaixo, se existe."

msgid "Focus Window: Previous"
msgstr "Foco na xanela: anterior"

msgid "Focus the previous window, if any."
msgstr "Dá o foco á xanela anterior, se hai algunha."

msgid "Focus Window: Next"
msgstr "Foco na xanela: seguinte"

msgid "Focus the next window, if any."
msgstr "Dá o foco á xanela seguinte, se hai algunha."

msgid "Toggle Split Zoom"
msgstr "Alternar o zoom da división"

msgid "Toggle the zoom state of the current split."
msgstr "Alterna o estado de zoom da división actual."

msgid "Toggle Read-Only Mode"
msgstr "Alternar o modo de só lectura"

msgid "Toggle read-only mode for the current surface."
msgstr "Alterna o modo de só lectura da superficie actual."

msgid "Equalize Splits"
msgstr "Igualar as divisións"

msgid "Equalize the size of all splits."
msgstr "Iguala o tamaño de todas as divisións."

msgid "Reset Window Size"
msgstr "Restablecer o tamaño da xanela"

msgid "Reset the window size to the default."
msgstr "Restablece o tamaño da xanela ao valor predeterminado."

msgid "Toggle Inspector"
msgstr "Alternar o inspector"

msgid "Toggle the inspector."
msgstr "Alterna o inspector."

msgid "Show the GTK Inspector"
msgstr "Mostrar o inspector de GTK"

msgid "Show the GTK inspector."
msgstr "Mostra o inspector de GTK."

msgid "Show On-Screen Keyboard"
msgstr "Mostrar o teclado en pantalla"

msgid "Show the on-screen keyboard if present."
msgstr "Mostra o teclado en pantalla, se está presente."

msgid "Open Config Using OS editor"
msgstr "Abrir a configuración co editor do sistema"

msgid "Open the config file with the OS's default editor."
msgstr "Abre o ficheiro de configuración co editor predeterminado do sistema."

msgid "Open Config in New Terminal Window"
msgstr "Abrir a configuración nunha nova xanela de terminal"

msgid "Open the config file in a new window using $EDITOR or $VISUAL."
msgstr "Abre o ficheiro de configuración nunha nova xanela usando $EDITOR ou $VISUAL."

msgid "Reload Config"
msgstr "Recargar a configuración"

msgid "Reload the config file."
msgstr "Recarga o ficheiro de configuración."

msgid "Close Terminal"
msgstr "Pechar o terminal"

msgid "Close the current terminal."
msgstr "Pecha o terminal actual."

msgid "Close the current tab."
msgstr "Pecha a lapela actual."

msgid "Close Other Tabs"
msgstr "Pechar as outras lapelas"

msgid "Close all tabs in this window except the current one."
msgstr "Pecha todas as lapelas desta xanela agás a actual."

msgid "Close Tabs to the Right"
msgstr "Pechar as lapelas da dereita"

msgid "Close all tabs to the right of the current one."
msgstr "Pecha todas as lapelas á dereita da actual."

msgid "Close the current window."
msgstr "Pecha a xanela actual."

msgid "Close All Windows"
msgstr "Pechar todas as xanelas"

msgid "Close all windows."
msgstr "Pecha todas as xanelas."

msgid "Toggle Maximize"
msgstr "Alternar a maximización"

msgid "Toggle the maximized state of the current window."
msgstr "Alterna o estado de maximización da xanela actual."

msgid "Toggle Fullscreen"
msgstr "Alternar a pantalla completa"

msgid "Toggle the fullscreen state of the current window."
msgstr "Alterna o estado de pantalla completa da xanela actual."

msgid "Toggle Window Decorations"
msgstr "Alternar as decoracións da xanela"

msgid "Toggle the window decorations."
msgstr "Alterna as decoracións da xanela."

msgid "Toggle Float on Top"
msgstr "Alternar manter por riba"

msgid "Toggle the float on top state of the current window."
msgstr "Alterna o estado de manter por riba da xanela actual."

msgid "Toggle Secure Input"
msgstr "Alternar a entrada segura"

msgid "Toggle secure input mode."
msgstr "Alterna o modo de entrada segura."

msgid "Toggle Mouse Reporting"
msgstr "Alternar o informe do rato"

msgid "Toggle whether mouse events are reported to terminal applications."
msgstr "Alterna se os eventos do rato se informan ás aplicacións de terminal."

msgid "Toggle Background Opacity"
msgstr "Alternar a opacidade do fondo"

msgid "Toggle the background opacity of a window that started transparent."
msgstr "Alterna a opacidade do fondo dunha xanela que comezou transparente."

msgid "Check for Updates"
msgstr "Buscar actualizacións"

msgid "Check for updates to the application."
msgstr "Busca actualizacións da aplicación."

msgid "Undo"
msgstr "Desfacer"

msgid "Undo the last action."
msgstr "Desfai a última acción."

msgid "Redo"
msgstr "Refacer"

msgid "Redo the last undone action."
msgstr "Refai a última acción desfeita."

msgid "Quit the application."
msgstr "Sae da aplicación."

msgid "Ghostty"
msgstr "Ghostty"

msgid "Put a little Ghostty in your terminal."
msgstr "Pon un pouco de Ghostty no seu terminal."
