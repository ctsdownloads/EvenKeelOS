msgid "Reset Terminal"
msgstr "Restablecer o terminal"

msgid "Reset the terminal to a clean state."
msgstr "Restablece o terminal a un estado limpo."

msgid "Copy to Clipboard"
msgstr "Copiar ao portapapeis"

msgid "Copy the selected text to the clipboard in both plain and styled formats."
msgstr "Copia o texto seleccionado ao portapapeis en formato simple e con estilo."

msgid "Copy Selection as Plain Text to Clipboard"
msgstr "Copiar a selección como texto simple ao portapapeis"

msgid "Copy the selected text as plain text to the clipboard."
msgstr "Copia o texto seleccionado como texto simple ao portapapeis."

msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "Copiar a selección como secuencias ANSI ao portapapeis"

msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr "Copia o texto seleccionado como secuencias de escape ANSI ao portapapeis."

msgid "Copy Selection as HTML to Clipboard"
msgstr "Copiar a selección como HTML ao portapapeis"

msgid "Copy the selected text as HTML to the clipboard."
msgstr "Copia o texto seleccionado como HTML ao portapapeis."

msgid "Copy URL to Clipboard"
msgstr "Copiar o URL ao portapapeis"

msgid "Copy the URL under the cursor to the clipboard."
msgstr "Copia ao portapapeis o URL que hai baixo o cursor."

msgid "Copy Terminal Title to Clipboard"
msgstr "Copiar o título do terminal ao portapapeis"

msgid "Copy the terminal title to the clipboard. If the terminal title is not set this has no effect."
msgstr "Copia o título do terminal ao portapapeis. Se non hai un título definido, non ten efecto."

msgid "Paste from Clipboard"
msgstr "Pegar do portapapeis"

msgid "Paste the contents of the main clipboard."
msgstr "Pega o contido do portapapeis principal."

msgid "Paste from Selection"
msgstr "Pegar da selección"

msgid "Paste the contents of the selection clipboard."
msgstr "Pega o contido do portapapeis de selección."

msgid "Start Search"
msgstr "Iniciar a busca"

msgid "Start a search if one isn't already active."
msgstr "Inicia unha busca se aínda non hai ningunha activa."

msgid "Search Selection"
msgstr "Buscar a selección"

msgid "Start a search for the current text selection."
msgstr "Inicia unha busca do texto seleccionado actualmente."

msgid "End Search"
msgstr "Finalizar a busca"

msgid "End the current search if any and hide any GUI elements."
msgstr "Finaliza a busca actual, se hai algunha, e oculta os elementos da interface."

msgid "Next Search Result"
msgstr "Seguinte resultado da busca"

msgid "Navigate to the next search result, if any."
msgstr "Vai ao seguinte resultado da busca, se hai algún."

msgid "Previous Search Result"
msgstr "Resultado anterior da busca"

msgid "Navigate to the previous search result, if any."
msgstr "Vai ao resultado anterior da busca, se hai algún."

msgid "Increase Font Size"
msgstr "Aumentar o tamaño da letra"

msgid "Increase the font size by 1 point."
msgstr "Aumenta o tamaño da letra en 1 punto."

msgid "Decrease Font Size"
msgstr "Diminuír o tamaño da letra"

msgid "Decrease the font size by 1 point."
msgstr "Diminúe o tamaño da letra en 1 punto."

msgid "Reset Font Size"
msgstr "Restablecer o tamaño da letra"

msgid "Reset the font size to the default."
msgstr "Restablece o tamaño da letra ao valor predeterminado."

msgid "Clear Screen"
msgstr "Limpar a pantalla"

msgid "Clear the screen and scrollback."
msgstr "Limpa a pantalla e o historial de desprazamento."

msgid "Select All"
msgstr "Seleccionar todo"

msgid "Select all text on the screen."
msgstr "Selecciona todo o texto da pantalla."

msgid "Scroll to Top"
msgstr "Desprazar ao principio"

msgid "Scroll to the top of the screen."
msgstr "Desprázase ao principio da pantalla."

msgid "Scroll to Bottom"
msgstr "Desprazar ao final"

msgid "Scroll to the bottom of the screen."
msgstr "Desprázase ao final da pantalla."

msgid "Scroll to Selection"
msgstr "Desprazar á selección"

msgid "Scroll to the selected text."
msgstr "Desprázase ao texto seleccionado."

msgid "Scroll Page Up"
msgstr "Desprazar unha páxina cara arriba"

msgid "Scroll the screen up by a page."
msgstr "Despraza a pantalla unha páxina cara arriba."

msgid "Scroll Page Down"
msgstr "Desprazar unha páxina cara abaixo"

msgid "Scroll the screen down by a page."
msgstr "Despraza a pantalla unha páxina cara abaixo."

msgid "Copy Screen to Temporary File and Copy Path"
msgstr "Copiar a pantalla a un ficheiro temporal e copiar a ruta"

msgid "Copy the screen contents to a temporary file and copy the path to the clipboard."
msgstr "Copia o contido da pantalla a un ficheiro temporal e copia a ruta ao portapapeis."

msgid "Copy Screen to Temporary File and Paste Path"
msgstr "Copiar a pantalla a un ficheiro temporal e pegar a ruta"

msgid "Copy the screen contents to a temporary file and paste the path to the file."
msgstr "Copia o contido da pantalla a un ficheiro temporal e pega a ruta do ficheiro."

msgid "Copy Screen to Temporary File and Open"
msgstr "Copiar a pantalla a un ficheiro temporal e abrilo"

msgid "Copy the screen contents to a temporary file and open it."
msgstr "Copia o contido da pantalla a un ficheiro temporal e ábreo."

msgid "Copy Screen as HTML to Temporary File and Copy Path"
msgstr "Copiar a pantalla como HTML a un ficheiro temporal e copiar a ruta"

msgid "Copy the screen contents as HTML to a temporary file and copy the path to the clipboard."
msgstr "Copia o contido da pantalla como HTML a un ficheiro temporal e copia a ruta ao portapapeis."

msgid "Copy Screen as HTML to Temporary File and Paste Path"
msgstr "Copiar a pantalla como HTML a un ficheiro temporal e pegar a ruta"

msgid "Copy the screen contents as HTML to a temporary file and paste the path to the file."
msgstr "Copia o contido da pantalla como HTML a un ficheiro temporal e pega a ruta do ficheiro."

msgid "Copy Screen as HTML to Temporary File and Open"
msgstr "Copiar a pantalla como HTML a un ficheiro temporal e abrilo"

msgid "Copy the screen contents as HTML to a temporary file and open it."
msgstr "Copia o contido da pantalla como HTML a un ficheiro temporal e ábreo."

msgid "Copy Screen as ANSI Sequences to Temporary File and Copy Path"
msgstr "Copiar a pantalla como secuencias ANSI a un ficheiro temporal e copiar a ruta"

msgid "Copy the screen contents as ANSI escape sequences to a temporary file and copy the path to the clipboard."
msgstr "Copia o contido da pantalla como secuencias de escape ANSI a un ficheiro temporal e copia a ruta ao portapapeis."

msgid "Copy Screen as ANSI Sequences to Temporary File and Paste Path"
msgstr "Copiar a pantalla como secuencias ANSI a un ficheiro temporal e pegar a ruta"

msgid "Copy the screen contents as ANSI escape sequences to a temporary file and paste the path to the file."
msgstr "Copia o contido da pantalla como secuencias de escape ANSI a un ficheiro temporal e pega a ruta do ficheiro."

msgid "Copy Screen as ANSI Sequences to Temporary File and Open"
msgstr "Copiar a pantalla como secuencias ANSI a un ficheiro temporal e abrilo"

msgid "Copy the screen contents as ANSI escape sequences to a temporary file and open it."
msgstr "Copia o contido da pantalla como secuencias de escape ANSI a un ficheiro temporal e ábreo."

msgid "Copy Selection to Temporary File and Copy Path"
msgstr "Copiar a selección a un ficheiro temporal e copiar a ruta"

msgid "Copy the selection contents to a temporary file and copy the path to the clipboard."
msgstr "Copia o contido da selección a un ficheiro temporal e copia a ruta ao portapapeis."

msgid "Copy Selection to Temporary File and Paste Path"
msgstr "Copiar a selección a un ficheiro temporal e pegar a ruta"

msgid "Copy the selection contents to a temporary file and paste the path to the file."
msgstr "Copia o contido da selección a un ficheiro temporal e pega a ruta do ficheiro."

msgid "Copy Selection to Temporary File and Open"
msgstr "Copiar a selección a un ficheiro temporal e abrilo"

msgid "Copy the selection contents to a temporary file and open it."
msgstr "Copia o contido da selección a un ficheiro temporal e ábreo."

msgid "Copy Selection as HTML to Temporary File and Copy Path"
msgstr "Copiar a selección como HTML a un ficheiro temporal e copiar a ruta"

msgid "Copy the selection contents as HTML to a temporary file and copy the path to the clipboard."
msgstr "Copia o contido da selección como HTML a un ficheiro temporal e copia a ruta ao portapapeis."

msgid "Copy Selection as HTML to Temporary File and Paste Path"
msgstr "Copiar a selección como HTML a un ficheiro temporal e pegar a ruta"

msgid "Copy the selection contents as HTML to a temporary file and paste the path to the file."
msgstr "Copia o contido da selección como HTML a un ficheiro temporal e pega a ruta do ficheiro."

msgid "Copy Selection as HTML to Temporary File and Open"
msgstr "Copiar a selección como HTML a un ficheiro temporal e abrilo"

msgid "Copy the selection contents as HTML to a temporary file and open it."
msgstr "Copia o contido da selección como HTML a un ficheiro temporal e ábreo."

msgid "Copy Selection as ANSI Sequences to Temporary File and Copy Path"
msgstr "Copiar a selección como secuencias ANSI a un ficheiro temporal e copiar a ruta"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and copy the path to the clipboard."
msgstr "Copia o contido da selección como secuencias de escape ANSI a un ficheiro temporal e copia a ruta ao portapapeis."

msgid "Copy Selection as ANSI Sequences to Temporary File and Paste Path"
msgstr "Copiar a selección como secuencias ANSI a un ficheiro temporal e pegar a ruta"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and paste the path to the file."
msgstr "Copia o contido da selección como secuencias de escape ANSI a un ficheiro temporal e pega a ruta do ficheiro."

