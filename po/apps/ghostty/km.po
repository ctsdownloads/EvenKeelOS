msgstr "ផ្ដោតលើការបំបែកនៅខាងឆ្វេង ប្រសិនបើមាន។"

msgid "Focus Split: Right"
msgstr "ផ្ដោតលើការបំបែក៖ ស្ដាំ"

msgid "Focus the split to the right, if it exists."
msgstr "ផ្ដោតលើការបំបែកនៅខាងស្ដាំ ប្រសិនបើមាន។"

msgid "Focus Split: Up"
msgstr "ផ្ដោតលើការបំបែក៖ ឡើងលើ"

msgid "Focus the split above, if it exists."
msgstr "ផ្ដោតលើការបំបែកនៅខាងលើ ប្រសិនបើមាន។"

msgid "Focus Split: Down"
msgstr "ផ្ដោតលើការបំបែក៖ ចុះក្រោម"

msgid "Focus the split below, if it exists."
msgstr "ផ្ដោតលើការបំបែកនៅខាងក្រោម ប្រសិនបើមាន។"

msgid "Focus Window: Previous"
msgstr "ផ្ដោតលើបង្អួច៖ មុន"

msgid "Focus the previous window, if any."
msgstr "ផ្ដោតលើបង្អួចមុន ប្រសិនបើមាន។"

msgid "Focus Window: Next"
msgstr "ផ្ដោតលើបង្អួច៖ បន្ទាប់"

msgid "Focus the next window, if any."
msgstr "ផ្ដោតលើបង្អួចបន្ទាប់ ប្រសិនបើមាន។"

msgid "Toggle Split Zoom"
msgstr "បិទ/បើកការពង្រីកការបំបែក"

msgid "Toggle the zoom state of the current split."
msgstr "បិទ/បើកស្ថានភាពពង្រីកនៃការបំបែកបច្ចុប្បន្ន។"

msgid "Toggle Read-Only Mode"
msgstr "បិទ/បើករបៀបអានតែប៉ុណ្ណោះ"

msgid "Toggle read-only mode for the current surface."
msgstr "បិទ/បើករបៀបអានតែប៉ុណ្ណោះសម្រាប់ផ្ទៃបច្ចុប្បន្ន។"

msgid "Equalize Splits"
msgstr "ធ្វើឱ្យការបំបែកស្មើគ្នា"

msgid "Equalize the size of all splits."
msgstr "ធ្វើឱ្យទំហំនៃការបំបែកទាំងអស់ស្មើគ្នា។"

msgid "Reset Window Size"
msgstr "កំណត់ទំហំបង្អួចឡើងវិញ"

msgid "Reset the window size to the default."
msgstr "កំណត់ទំហំបង្អួចឡើងវិញទៅលំនាំដើម។"

msgid "Toggle Inspector"
msgstr "បិទ/បើកកម្មវិធីត្រួតពិនិត្យ"

msgid "Toggle the inspector."
msgstr "បិទ/បើកកម្មវិធីត្រួតពិនិត្យ។"

msgid "Show the GTK Inspector"
msgstr "បង្ហាញកម្មវិធីត្រួតពិនិត្យ GTK"

msgid "Show the GTK inspector."
msgstr "បង្ហាញកម្មវិធីត្រួតពិនិត្យ GTK។"

msgid "Show On-Screen Keyboard"
msgstr "បង្ហាញក្ដារចុចលើអេក្រង់"

msgid "Show the on-screen keyboard if present."
msgstr "បង្ហាញក្ដារចុចលើអេក្រង់ ប្រសិនបើមាន។"

msgid "Open Config Using OS editor"
msgstr "បើកការកំណត់រចនាសម្ព័ន្ធដោយប្រើកម្មវិធីនិពន្ធរបស់ប្រព័ន្ធ"

msgid "Open the config file with the OS's default editor."
msgstr "បើកឯកសារការកំណត់រចនាសម្ព័ន្ធដោយកម្មវិធីនិពន្ធលំនាំដើមរបស់ប្រព័ន្ធ។"

msgid "Open Config in New Terminal Window"
msgstr "បើកការកំណត់រចនាសម្ព័ន្ធក្នុងបង្អួចស្ថានីយថ្មី"

msgid "Open the config file in a new window using $EDITOR or $VISUAL."
msgstr "បើកឯកសារការកំណត់រចនាសម្ព័ន្ធក្នុងបង្អួចថ្មីដោយប្រើ $EDITOR ឬ $VISUAL។"

msgid "Reload Config"
msgstr "ផ្ទុកការកំណត់រចនាសម្ព័ន្ធឡើងវិញ"

msgid "Reload the config file."
msgstr "ផ្ទុកឯកសារការកំណត់រចនាសម្ព័ន្ធឡើងវិញ។"

msgid "Close Terminal"
msgstr "បិទស្ថានីយ"

msgid "Close the current terminal."
msgstr "បិទស្ថានីយបច្ចុប្បន្ន។"

msgid "Close the current tab."
msgstr "បិទផ្ទាំងបច្ចុប្បន្ន។"

msgid "Close Other Tabs"
msgstr "បិទផ្ទាំងផ្សេងទៀត"

msgid "Close all tabs in this window except the current one."
msgstr "បិទផ្ទាំងទាំងអស់ក្នុងបង្អួចនេះ លើកលែងតែផ្ទាំងបច្ចុប្បន្ន។"

msgid "Close Tabs to the Right"
msgstr "បិទផ្ទាំងនៅខាងស្ដាំ"

msgid "Close all tabs to the right of the current one."
msgstr "បិទផ្ទាំងទាំងអស់នៅខាងស្ដាំនៃផ្ទាំងបច្ចុប្បន្ន។"

msgid "Close the current window."
msgstr "បិទបង្អួចបច្ចុប្បន្ន។"

msgid "Close All Windows"
msgstr "បិទបង្អួចទាំងអស់"

msgid "Close all windows."
msgstr "បិទបង្អួចទាំងអស់។"

msgid "Toggle Maximize"
msgstr "បិទ/បើកការពង្រីកអតិបរមា"

msgid "Toggle the maximized state of the current window."
msgstr "បិទ/បើកស្ថានភាពពង្រីកអតិបរមានៃបង្អួចបច្ចុប្បន្ន។"

msgid "Toggle Fullscreen"
msgstr "បិទ/បើកពេញអេក្រង់"

msgid "Toggle the fullscreen state of the current window."
msgstr "បិទ/បើកស្ថានភាពពេញអេក្រង់នៃបង្អួចបច្ចុប្បន្ន។"

msgid "Toggle Window Decorations"
msgstr "បិទ/បើកការតុបតែងបង្អួច"

msgid "Toggle the window decorations."
msgstr "បិទ/បើកការតុបតែងបង្អួច។"

msgid "Toggle Float on Top"
msgstr "បិទ/បើកការអណ្ដែតនៅលើគេ"

msgid "Toggle the float on top state of the current window."
msgstr "បិទ/បើកស្ថានភាពអណ្ដែតនៅលើគេនៃបង្អួចបច្ចុប្បន្ន។"

msgid "Toggle Secure Input"
msgstr "បិទ/បើកការបញ្ចូលសុវត្ថិភាព"

msgid "Toggle secure input mode."
msgstr "បិទ/បើករបៀបបញ្ចូលសុវត្ថិភាព។"

msgid "Toggle Mouse Reporting"
msgstr "បិទ/បើកការរាយការណ៍កណ្ដុរ"

msgid "Toggle whether mouse events are reported to terminal applications."
msgstr "បិទ/បើកថាតើព្រឹត្តិការណ៍កណ្ដុរត្រូវបានរាយការណ៍ទៅកម្មវិធីស្ថានីយឬអត់។"

msgid "Toggle Background Opacity"
msgstr "បិទ/បើកភាពស្រអាប់នៃផ្ទៃខាងក្រោយ"

msgid "Toggle the background opacity of a window that started transparent."
msgstr "បិទ/បើកភាពស្រអាប់នៃផ្ទៃខាងក្រោយរបស់បង្អួចដែលចាប់ផ្ដើមដោយថ្លា។"

msgid "Check for Updates"
msgstr "ពិនិត្យមើលបច្ចុប្បន្នភាព"

msgid "Check for updates to the application."
msgstr "ពិនិត្យមើលបច្ចុប្បន្នភាពសម្រាប់កម្មវិធី។"

msgid "Undo"
msgstr "មិនធ្វើវិញ"

msgid "Undo the last action."
msgstr "មិនធ្វើសកម្មភាពចុងក្រោយវិញ។"

msgid "Redo"
msgstr "ធ្វើវិញ"

msgid "Redo the last undone action."
msgstr "ធ្វើសកម្មភាពដែលបានមិនធ្វើចុងក្រោយវិញ។"

msgid "Quit the application."
msgstr "ចាកចេញពីកម្មវិធី។"

msgid "Ghostty"
msgstr "Ghostty"

msgid "Put a little Ghostty in your terminal."
msgstr "ដាក់ Ghostty បន្តិចក្នុងស្ថានីយរបស់អ្នក។"
