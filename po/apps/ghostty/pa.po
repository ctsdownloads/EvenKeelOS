msgid "Toggle Split Zoom"
msgstr "ਵੰਡ ਜ਼ੂਮ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle the zoom state of the current split."
msgstr "ਮੌਜੂਦਾ ਵੰਡ ਦੀ ਜ਼ੂਮ ਹਾਲਤ ਬਦਲੋ।"

msgid "Toggle Read-Only Mode"
msgstr "ਸਿਰਫ਼-ਪੜ੍ਹਨ ਮੋਡ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle read-only mode for the current surface."
msgstr "ਮੌਜੂਦਾ ਸਰਫ਼ੇਸ ਲਈ ਸਿਰਫ਼-ਪੜ੍ਹਨ ਮੋਡ ਚਾਲੂ/ਬੰਦ ਕਰੋ।"

msgid "Equalize Splits"
msgstr "ਵੰਡਾਂ ਨੂੰ ਬਰਾਬਰ ਕਰੋ"

msgid "Equalize the size of all splits."
msgstr "ਸਾਰੀਆਂ ਵੰਡਾਂ ਦਾ ਆਕਾਰ ਬਰਾਬਰ ਕਰੋ।"

msgid "Reset Window Size"
msgstr "ਵਿੰਡੋ ਦਾ ਆਕਾਰ ਮੁੜ-ਸੈੱਟ ਕਰੋ"

msgid "Reset the window size to the default."
msgstr "ਵਿੰਡੋ ਦਾ ਆਕਾਰ ਮੂਲ ਮੁੱਲ 'ਤੇ ਮੁੜ-ਸੈੱਟ ਕਰੋ।"

msgid "Toggle Inspector"
msgstr "ਇੰਸਪੈਕਟਰ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle the inspector."
msgstr "ਇੰਸਪੈਕਟਰ ਚਾਲੂ/ਬੰਦ ਕਰੋ।"

msgid "Show the GTK Inspector"
msgstr "GTK ਇੰਸਪੈਕਟਰ ਵਿਖਾਓ"

msgid "Show the GTK inspector."
msgstr "GTK ਇੰਸਪੈਕਟਰ ਵਿਖਾਓ।"

msgid "Show On-Screen Keyboard"
msgstr "ਆਨ-ਸਕਰੀਨ ਕੀਬੋਰਡ ਵਿਖਾਓ"

msgid "Show the on-screen keyboard if present."
msgstr "ਜੇ ਮੌਜੂਦ ਹੈ ਤਾਂ ਆਨ-ਸਕਰੀਨ ਕੀਬੋਰਡ ਵਿਖਾਓ।"

msgid "Open Config Using OS editor"
msgstr "ਸੰਰਚਨਾ ਨੂੰ OS ਦੇ ਸੰਪਾਦਕ ਨਾਲ ਖੋਲ੍ਹੋ"

msgid "Open the config file with the OS's default editor."
msgstr "ਸੰਰਚਨਾ ਫ਼ਾਈਲ ਨੂੰ OS ਦੇ ਮੂਲ ਸੰਪਾਦਕ ਨਾਲ ਖੋਲ੍ਹੋ।"

msgid "Open Config in New Terminal Window"
msgstr "ਸੰਰਚਨਾ ਨੂੰ ਨਵੀਂ ਟਰਮੀਨਲ ਵਿੰਡੋ ਵਿੱਚ ਖੋਲ੍ਹੋ"

msgid "Open the config file in a new window using $EDITOR or $VISUAL."
msgstr "ਸੰਰਚਨਾ ਫ਼ਾਈਲ ਨੂੰ $EDITOR ਜਾਂ $VISUAL ਵਰਤ ਕੇ ਨਵੀਂ ਵਿੰਡੋ ਵਿੱਚ ਖੋਲ੍ਹੋ।"

msgid "Reload Config"
msgstr "ਸੰਰਚਨਾ ਮੁੜ-ਲੋਡ ਕਰੋ"

msgid "Reload the config file."
msgstr "ਸੰਰਚਨਾ ਫ਼ਾਈਲ ਮੁੜ-ਲੋਡ ਕਰੋ।"

msgid "Close Terminal"
msgstr "ਟਰਮੀਨਲ ਬੰਦ ਕਰੋ"

msgid "Close the current terminal."
msgstr "ਮੌਜੂਦਾ ਟਰਮੀਨਲ ਬੰਦ ਕਰੋ।"

msgid "Close the current tab."
msgstr "ਮੌਜੂਦਾ ਟੈਬ ਬੰਦ ਕਰੋ।"

msgid "Close Other Tabs"
msgstr "ਹੋਰ ਟੈਬਾਂ ਬੰਦ ਕਰੋ"

msgid "Close all tabs in this window except the current one."
msgstr "ਮੌਜੂਦਾ ਟੈਬ ਤੋਂ ਬਿਨਾਂ ਇਸ ਵਿੰਡੋ ਦੀਆਂ ਸਾਰੀਆਂ ਟੈਬਾਂ ਬੰਦ ਕਰੋ।"

msgid "Close Tabs to the Right"
msgstr "ਸੱਜੇ ਪਾਸੇ ਦੀਆਂ ਟੈਬਾਂ ਬੰਦ ਕਰੋ"

msgid "Close all tabs to the right of the current one."
msgstr "ਮੌਜੂਦਾ ਟੈਬ ਦੇ ਸੱਜੇ ਪਾਸੇ ਦੀਆਂ ਸਾਰੀਆਂ ਟੈਬਾਂ ਬੰਦ ਕਰੋ।"

msgid "Close the current window."
msgstr "ਮੌਜੂਦਾ ਵਿੰਡੋ ਬੰਦ ਕਰੋ।"

msgid "Close All Windows"
msgstr "ਸਾਰੀਆਂ ਵਿੰਡੋਆਂ ਬੰਦ ਕਰੋ"

msgid "Close all windows."
msgstr "ਸਾਰੀਆਂ ਵਿੰਡੋਆਂ ਬੰਦ ਕਰੋ।"

msgid "Toggle Maximize"
msgstr "ਵੱਧ ਤੋਂ ਵੱਧ ਆਕਾਰ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle the maximized state of the current window."
msgstr "ਮੌਜੂਦਾ ਵਿੰਡੋ ਦੀ ਵੱਧ ਤੋਂ ਵੱਧ ਆਕਾਰ ਵਾਲੀ ਹਾਲਤ ਬਦਲੋ।"

msgid "Toggle Fullscreen"
msgstr "ਪੂਰੀ ਸਕਰੀਨ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle the fullscreen state of the current window."
msgstr "ਮੌਜੂਦਾ ਵਿੰਡੋ ਦੀ ਪੂਰੀ ਸਕਰੀਨ ਵਾਲੀ ਹਾਲਤ ਬਦਲੋ।"

msgid "Toggle Window Decorations"
msgstr "ਵਿੰਡੋ ਸਜਾਵਟਾਂ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle the window decorations."
msgstr "ਵਿੰਡੋ ਸਜਾਵਟਾਂ ਚਾਲੂ/ਬੰਦ ਕਰੋ।"

msgid "Toggle Float on Top"
msgstr "ਸਭ ਤੋਂ ਉੱਪਰ ਤੈਰਨਾ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle the float on top state of the current window."
msgstr "ਮੌਜੂਦਾ ਵਿੰਡੋ ਦੀ ਸਭ ਤੋਂ ਉੱਪਰ ਤੈਰਨ ਵਾਲੀ ਹਾਲਤ ਬਦਲੋ।"

msgid "Toggle Secure Input"
msgstr "ਸੁਰੱਖਿਅਤ ਇੰਪੁੱਟ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle secure input mode."
msgstr "ਸੁਰੱਖਿਅਤ ਇੰਪੁੱਟ ਮੋਡ ਚਾਲੂ/ਬੰਦ ਕਰੋ।"

msgid "Toggle Mouse Reporting"
msgstr "ਮਾਊਸ ਰਿਪੋਰਟਿੰਗ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle whether mouse events are reported to terminal applications."
msgstr "ਚਾਲੂ/ਬੰਦ ਕਰੋ ਕਿ ਮਾਊਸ ਇਵੈਂਟ ਟਰਮੀਨਲ ਐਪਲੀਕੇਸ਼ਨਾਂ ਨੂੰ ਦੱਸੇ ਜਾਣ ਜਾਂ ਨਹੀਂ।"

msgid "Toggle Background Opacity"
msgstr "ਪਿਛੋਕੜ ਦੀ ਧੁੰਦਲਾਪਨ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgid "Toggle the background opacity of a window that started transparent."
msgstr "ਪਾਰਦਰਸ਼ੀ ਸ਼ੁਰੂ ਹੋਈ ਵਿੰਡੋ ਦੇ ਪਿਛੋਕੜ ਦੀ ਧੁੰਦਲਾਪਨ ਚਾਲੂ/ਬੰਦ ਕਰੋ।"

msgid "Check for Updates"
msgstr "ਅੱਪਡੇਟਾਂ ਲਈ ਜਾਂਚ ਕਰੋ"

msgid "Check for updates to the application."
msgstr "ਐਪਲੀਕੇਸ਼ਨ ਦੇ ਅੱਪਡੇਟਾਂ ਲਈ ਜਾਂਚ ਕਰੋ।"

msgid "Undo"
msgstr "ਅਣਕੀਤਾ ਕਰੋ"

msgid "Undo the last action."
msgstr "ਪਿਛਲੀ ਕਾਰਵਾਈ ਨੂੰ ਅਣਕੀਤਾ ਕਰੋ।"

msgid "Redo"
msgstr "ਮੁੜ-ਕਰੋ"

msgid "Redo the last undone action."
msgstr "ਪਿਛਲੀ ਅਣਕੀਤੀ ਕੀਤੀ ਕਾਰਵਾਈ ਨੂੰ ਮੁੜ-ਕਰੋ।"

msgid "Quit the application."
msgstr "ਐਪਲੀਕੇਸ਼ਨ ਬੰਦ ਕਰੋ।"

msgid "Ghostty"
msgstr "Ghostty"

msgid "Put a little Ghostty in your terminal."
msgstr "ਆਪਣੇ ਟਰਮੀਨਲ ਵਿੱਚ ਥੋੜ੍ਹਾ ਜਿਹਾ Ghostty ਪਾਓ।"
