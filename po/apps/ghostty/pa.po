msgid "Open in Ghostty"
msgstr "Ghostty ਵਿੱਚ ਖੋਲ੍ਹੋ"

msgid "Find…"
msgstr "ਲੱਭੋ…"

msgid "Previous Match"
msgstr "ਪਿਛਲਾ ਮਿਲਾਨ"

msgid "Next Match"
msgstr "ਅਗਲਾ ਮਿਲਾਨ"

msgid "Close"
msgstr "ਬੰਦ ਕਰੋ"

msgid "Oh, no."
msgstr "ਓਹ, ਨਹੀਂ।"

msgid "Unable to acquire an OpenGL context for rendering."
msgstr "ਰੈਂਡਰਿੰਗ ਲਈ OpenGL ਕਨਟੈਕਸਟ ਹਾਸਲ ਕਰਨ ਵਿੱਚ ਅਸਮਰੱਥ।"

msgid "This terminal is in read-only mode. You can still view, select, and scroll through the content, but no input events will be sent to the running application."
msgstr "ਇਹ ਟਰਮੀਨਲ ਸਿਰਫ਼-ਪੜ੍ਹਨ ਮੋਡ ਵਿੱਚ ਹੈ। ਤੁਸੀਂ ਹਾਲੇ ਵੀ ਸਮੱਗਰੀ ਨੂੰ ਵੇਖ, ਚੁਣ ਅਤੇ ਸਕਰੋਲ ਕਰ ਸਕਦੇ ਹੋ, ਪਰ ਚੱਲ ਰਹੀ ਐਪਲੀਕੇਸ਼ਨ ਨੂੰ ਕੋਈ ਇੰਪੁੱਟ ਇਵੈਂਟ ਨਹੀਂ ਭੇਜਿਆ ਜਾਵੇਗਾ।"

msgid "Read-only"
msgstr "ਸਿਰਫ਼-ਪੜ੍ਹਨ ਲਈ"

msgid "Copy"
msgstr "ਕਾਪੀ ਕਰੋ"

msgid "Paste"
msgstr "ਪੇਸਟ ਕਰੋ"

msgid "Notify on Next Command Finish"
msgstr "ਅਗਲੀ ਕਮਾਂਡ ਮੁਕੰਮਲ ਹੋਣ 'ਤੇ ਸੂਚਿਤ ਕਰੋ"

msgid "Clear"
msgstr "ਸਾਫ਼ ਕਰੋ"

msgid "Reset"
msgstr "ਮੁੜ-ਸੈੱਟ ਕਰੋ"

msgid "Split"
msgstr "ਵੰਡੋ"

msgid "Change Title…"
msgstr "ਸਿਰਲੇਖ ਬਦਲੋ…"

msgid "Split Up"
msgstr "ਉੱਤੇ ਵੰਡੋ"

msgid "Split Down"
msgstr "ਹੇਠਾਂ ਵੰਡੋ"

msgid "Split Left"
msgstr "ਖੱਬੇ ਵੰਡੋ"

msgid "Split Right"
msgstr "ਸੱਜੇ ਵੰਡੋ"

msgid "Close Split"
msgstr "ਵੰਡ ਬੰਦ ਕਰੋ"

msgid "Tab"
msgstr "ਟੈਬ"

msgid "Change Tab Title…"
msgstr "ਟੈਬ ਦਾ ਸਿਰਲੇਖ ਬਦਲੋ…"

msgid "New Tab"
msgstr "ਨਵੀਂ ਟੈਬ"

msgid "Close Tab"
msgstr "ਟੈਬ ਬੰਦ ਕਰੋ"

msgid "Window"
msgstr "ਵਿੰਡੋ"

msgid "Change Window Title…"
msgstr "ਵਿੰਡੋ ਦਾ ਸਿਰਲੇਖ ਬਦਲੋ…"

msgid "New Window"
msgstr "ਨਵੀਂ ਵਿੰਡੋ"

msgid "Close Window"
msgstr "ਵਿੰਡੋ ਬੰਦ ਕਰੋ"

msgid "Config"
msgstr "ਸੰਰਚਨਾ"

msgid "Open Configuration in OS Editor"
msgstr "ਸੰਰਚਨਾ ਨੂੰ OS ਦੇ ਸੰਪਾਦਕ ਵਿੱਚ ਖੋਲ੍ਹੋ"

msgid "Open Configuration in New Window"
msgstr "ਸੰਰਚਨਾ ਨੂੰ ਨਵੀਂ ਵਿੰਡੋ ਵਿੱਚ ਖੋਲ੍ਹੋ"

msgid "Reload Configuration"
msgstr "ਸੰਰਚਨਾ ਮੁੜ-ਲੋਡ ਕਰੋ"

msgid "⚠️ You're running a debug build of Ghostty! Performance will be degraded."
msgstr "⚠️ ਤੁਸੀਂ Ghostty ਦਾ ਡੀਬੱਗ ਬਿਲਡ ਚਲਾ ਰਹੇ ਹੋ! ਕਾਰਗੁਜ਼ਾਰੀ ਘੱਟ ਹੋਵੇਗੀ।"

msgid "Ghostty: Terminal Inspector"
msgstr "Ghostty: ਟਰਮੀਨਲ ਇੰਸਪੈਕਟਰ"

msgid "New Split"
msgstr "ਨਵੀਂ ਵੰਡ"

msgid "View Open Tabs"
msgstr "ਖੁੱਲ੍ਹੀਆਂ ਟੈਬਾਂ ਵੇਖੋ"

msgid "Main Menu"
msgstr "ਮੁੱਖ ਮੀਨੂ"

msgid "Command Palette"
msgstr "ਕਮਾਂਡ ਪੈਲੇਟ"

msgid "Terminal Inspector"
msgstr "ਟਰਮੀਨਲ ਇੰਸਪੈਕਟਰ"

msgid "About Ghostty"
msgstr "Ghostty ਬਾਰੇ"

msgid "Quit"
msgstr "ਬੰਦ ਕਰੋ"

msgid "Authorize Clipboard Access"
msgstr "ਕਲਿੱਪਬੋਰਡ ਪਹੁੰਚ ਨੂੰ ਅਧਿਕਾਰਤ ਕਰੋ"

msgid "Deny"
msgstr "ਇਨਕਾਰ ਕਰੋ"

msgid "Allow"
msgstr "ਇਜਾਜ਼ਤ ਦਿਓ"

msgid "Remember choice for this split"
msgstr "ਇਸ ਵੰਡ ਲਈ ਚੋਣ ਯਾਦ ਰੱਖੋ"

msgid "Reload configuration to show this prompt again"
msgstr "ਇਹ ਪ੍ਰੋਂਪਟ ਦੁਬਾਰਾ ਵੇਖਣ ਲਈ ਸੰਰਚਨਾ ਮੁੜ-ਲੋਡ ਕਰੋ"

msgid "Cancel"
msgstr "ਰੱਦ ਕਰੋ"

msgid "Execute a command…"
msgstr "ਕੋਈ ਕਮਾਂਡ ਚਲਾਓ…"

msgid "Configuration Errors"
msgstr "ਸੰਰਚਨਾ ਗਲਤੀਆਂ"

msgid "One or more configuration errors were found. Please review the errors below, and either reload your configuration or ignore these errors."
msgstr "ਇੱਕ ਜਾਂ ਵੱਧ ਸੰਰਚਨਾ ਗਲਤੀਆਂ ਮਿਲੀਆਂ ਹਨ। ਕਿਰਪਾ ਕਰਕੇ ਹੇਠਾਂ ਦਿੱਤੀਆਂ ਗਲਤੀਆਂ ਨੂੰ ਵੇਖੋ ਅਤੇ ਜਾਂ ਤਾਂ ਆਪਣੀ ਸੰਰਚਨਾ ਮੁੜ-ਲੋਡ ਕਰੋ ਜਾਂ ਇਹਨਾਂ ਗਲਤੀਆਂ ਨੂੰ ਅਣਡਿੱਠਾ ਕਰੋ।"

msgid "Ignore"
msgstr "ਅਣਡਿੱਠਾ ਕਰੋ"

msgid "Leave blank to restore the default title."
msgstr "ਮੂਲ ਸਿਰਲੇਖ ਬਹਾਲ ਕਰਨ ਲਈ ਖਾਲੀ ਛੱਡੋ।"

msgid "OK"
msgstr "ਠੀਕ ਹੈ"

msgid "The keybind was revoked by the system."
msgstr "ਕੀਬਾਈਂਡ ਨੂੰ ਸਿਸਟਮ ਵੱਲੋਂ ਰੱਦ ਕਰ ਦਿੱਤਾ ਗਿਆ ਸੀ।"

msgid "The keybind was denied by the system."
msgstr "ਕੀਬਾਈਂਡ ਨੂੰ ਸਿਸਟਮ ਵੱਲੋਂ ਇਨਕਾਰ ਕਰ ਦਿੱਤਾ ਗਿਆ ਸੀ।"

msgid "Global keybind unavailable"
msgstr "ਗਲੋਬਲ ਕੀਬਾਈਂਡ ਉਪਲਬਧ ਨਹੀਂ"

msgid "Export Terminal IO Events"
msgstr "ਟਰਮੀਨਲ IO ਇਵੈਂਟ ਨਿਰਯਾਤ ਕਰੋ"

msgid "Export"
msgstr "ਨਿਰਯਾਤ ਕਰੋ"

msgid "Editing configuration file"
msgstr "ਸੰਰਚਨਾ ਫ਼ਾਈਲ ਨੂੰ ਸੋਧਿਆ ਜਾ ਰਿਹਾ ਹੈ"

msgid "An application is attempting to write to the clipboard. The current clipboard contents are shown below."
msgstr "ਇੱਕ ਐਪਲੀਕੇਸ਼ਨ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਲਿਖਣ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰ ਰਹੀ ਹੈ। ਮੌਜੂਦਾ ਕਲਿੱਪਬੋਰਡ ਸਮੱਗਰੀ ਹੇਠਾਂ ਵਿਖਾਈ ਗਈ ਹੈ।"

msgid "An application is attempting to read from the clipboard. The current clipboard contents are shown below."
msgstr "ਇੱਕ ਐਪਲੀਕੇਸ਼ਨ ਕਲਿੱਪਬੋਰਡ ਤੋਂ ਪੜ੍ਹਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰ ਰਹੀ ਹੈ। ਮੌਜੂਦਾ ਕਲਿੱਪਬੋਰਡ ਸਮੱਗਰੀ ਹੇਠਾਂ ਵਿਖਾਈ ਗਈ ਹੈ।"

msgid "Warning: Potentially Unsafe Paste"
msgstr "ਚੇਤਾਵਨੀ: ਸੰਭਾਵੀ ਤੌਰ 'ਤੇ ਅਸੁਰੱਖਿਅਤ ਪੇਸਟ"

msgid "Pasting this text into the terminal may be dangerous as it looks like some commands may be executed."
msgstr "ਇਸ ਟੈਕਸਟ ਨੂੰ ਟਰਮੀਨਲ ਵਿੱਚ ਪੇਸਟ ਕਰਨਾ ਖ਼ਤਰਨਾਕ ਹੋ ਸਕਦਾ ਹੈ ਕਿਉਂਕਿ ਲੱਗਦਾ ਹੈ ਕਿ ਕੁਝ ਕਮਾਂਡਾਂ ਚੱਲ ਸਕਦੀਆਂ ਹਨ।"

msgid "Quit Ghostty?"
msgstr "Ghostty ਬੰਦ ਕਰਨਾ ਹੈ?"

msgid "Close Tab?"
msgstr "ਟੈਬ ਬੰਦ ਕਰਨੀ ਹੈ?"

msgid "Close Window?"
msgstr "ਵਿੰਡੋ ਬੰਦ ਕਰਨੀ ਹੈ?"

msgid "Close Split?"
msgstr "ਵੰਡ ਬੰਦ ਕਰਨੀ ਹੈ?"

msgid "All terminal sessions will be terminated."
msgstr "ਸਾਰੇ ਟਰਮੀਨਲ ਸੈਸ਼ਨ ਖ਼ਤਮ ਕਰ ਦਿੱਤੇ ਜਾਣਗੇ।"

msgid "All terminal sessions in this tab will be terminated."
msgstr "ਇਸ ਟੈਬ ਵਿਚਲੇ ਸਾਰੇ ਟਰਮੀਨਲ ਸੈਸ਼ਨ ਖ਼ਤਮ ਕਰ ਦਿੱਤੇ ਜਾਣਗੇ।"

msgid "All terminal sessions in this window will be terminated."
msgstr "ਇਸ ਵਿੰਡੋ ਵਿਚਲੇ ਸਾਰੇ ਟਰਮੀਨਲ ਸੈਸ਼ਨ ਖ਼ਤਮ ਕਰ ਦਿੱਤੇ ਜਾਣਗੇ।"

msgid "The currently running process in this split will be terminated."
msgstr "ਇਸ ਵੰਡ ਵਿੱਚ ਇਸ ਵੇਲੇ ਚੱਲ ਰਹੀ ਪ੍ਰਕਿਰਿਆ ਖ਼ਤਮ ਕਰ ਦਿੱਤੀ ਜਾਵੇਗੀ।"

msgid "Command Finished"
msgstr "ਕਮਾਂਡ ਮੁਕੰਮਲ ਹੋਈ"

msgid "Command Succeeded"
msgstr "ਕਮਾਂਡ ਸਫ਼ਲ ਰਹੀ"

msgid "Command Failed"
msgstr "ਕਮਾਂਡ ਅਸਫ਼ਲ ਰਹੀ"

msgid "Change Terminal Title"
msgstr "ਟਰਮੀਨਲ ਦਾ ਸਿਰਲੇਖ ਬਦਲੋ"

msgid "Change Tab Title"
msgstr "ਟੈਬ ਦਾ ਸਿਰਲੇਖ ਬਦਲੋ"

msgid "Change Window Title"
msgstr "ਵਿੰਡੋ ਦਾ ਸਿਰਲੇਖ ਬਦਲੋ"

msgid "Reloaded the configuration"
msgstr "ਸੰਰਚਨਾ ਮੁੜ-ਲੋਡ ਕੀਤੀ ਗਈ"

msgid "Copied to clipboard"
msgstr "ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕੀਤਾ ਗਿਆ"

msgid "Cleared clipboard"
msgstr "ਕਲਿੱਪਬੋਰਡ ਸਾਫ਼ ਕੀਤਾ ਗਿਆ"

msgid "Ghostty Developers"
msgstr "Ghostty ਡਿਵੈਲਪਰ"

msgid "Reset Terminal"
msgstr "ਟਰਮੀਨਲ ਮੁੜ-ਸੈੱਟ ਕਰੋ"

msgid "Reset the terminal to a clean state."
msgstr "ਟਰਮੀਨਲ ਨੂੰ ਸਾਫ਼ ਹਾਲਤ ਵਿੱਚ ਮੁੜ-ਸੈੱਟ ਕਰੋ।"

msgid "Copy to Clipboard"
msgstr "ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ"

msgid "Copy the selected text to the clipboard in both plain and styled formats."
msgstr "ਚੁਣੇ ਹੋਏ ਟੈਕਸਟ ਨੂੰ ਸਾਦੇ ਅਤੇ ਸਟਾਈਲ ਵਾਲੇ ਦੋਵਾਂ ਰੂਪਾਂ ਵਿੱਚ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ।"

msgid "Copy Selection as Plain Text to Clipboard"
msgstr "ਚੋਣ ਨੂੰ ਸਾਦੇ ਟੈਕਸਟ ਵਜੋਂ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ"

msgid "Copy the selected text as plain text to the clipboard."
msgstr "ਚੁਣੇ ਹੋਏ ਟੈਕਸਟ ਨੂੰ ਸਾਦੇ ਟੈਕਸਟ ਵਜੋਂ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ।"

msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "ਚੋਣ ਨੂੰ ANSI ਸੀਕੁਐਂਸਾਂ ਵਜੋਂ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ"

msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr "ਚੁਣੇ ਹੋਏ ਟੈਕਸਟ ਨੂੰ ANSI ਐਸਕੇਪ ਸੀਕੁਐਂਸਾਂ ਵਜੋਂ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ।"

msgid "Copy Selection as HTML to Clipboard"
msgstr "ਚੋਣ ਨੂੰ HTML ਵਜੋਂ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ"

msgid "Copy the selected text as HTML to the clipboard."
msgstr "ਚੁਣੇ ਹੋਏ ਟੈਕਸਟ ਨੂੰ HTML ਵਜੋਂ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ।"

msgid "Copy URL to Clipboard"
msgstr "URL ਨੂੰ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ"

msgid "Copy the URL under the cursor to the clipboard."
msgstr "ਕਰਸਰ ਹੇਠਲੇ URL ਨੂੰ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ।"

msgid "Copy Terminal Title to Clipboard"
msgstr "ਟਰਮੀਨਲ ਦਾ ਸਿਰਲੇਖ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ"

msgid "Copy the terminal title to the clipboard. If the terminal title is not set this has no effect."
msgstr "ਟਰਮੀਨਲ ਦਾ ਸਿਰਲੇਖ ਕਲਿੱਪਬੋਰਡ ਵਿੱਚ ਕਾਪੀ ਕਰੋ। ਜੇ ਟਰਮੀਨਲ ਦਾ ਸਿਰਲੇਖ ਸੈੱਟ ਨਹੀਂ ਹੈ ਤਾਂ ਇਸ ਦਾ ਕੋਈ ਅਸਰ ਨਹੀਂ ਹੁੰਦਾ।"

msgid "Paste from Clipboard"
msgstr "ਕਲਿੱਪਬੋਰਡ ਤੋਂ ਪੇਸਟ ਕਰੋ"

msgid "Paste the contents of the main clipboard."
msgstr "ਮੁੱਖ ਕਲਿੱਪਬੋਰਡ ਦੀ ਸਮੱਗਰੀ ਪੇਸਟ ਕਰੋ।"

msgid "Paste from Selection"
msgstr "ਚੋਣ ਤੋਂ ਪੇਸਟ ਕਰੋ"

msgid "Paste the contents of the selection clipboard."
msgstr "ਚੋਣ ਕਲਿੱਪਬੋਰਡ ਦੀ ਸਮੱਗਰੀ ਪੇਸਟ ਕਰੋ।"

msgid "Start Search"
msgstr "ਖੋਜ ਸ਼ੁਰੂ ਕਰੋ"

msgid "Start a search if one isn't already active."
msgstr "ਜੇ ਕੋਈ ਖੋਜ ਪਹਿਲਾਂ ਤੋਂ ਸਰਗਰਮ ਨਹੀਂ ਹੈ ਤਾਂ ਖੋਜ ਸ਼ੁਰੂ ਕਰੋ।"

msgid "Search Selection"
msgstr "ਚੋਣ ਖੋਜੋ"

msgid "Start a search for the current text selection."
msgstr "ਮੌਜੂਦਾ ਟੈਕਸਟ ਚੋਣ ਲਈ ਖੋਜ ਸ਼ੁਰੂ ਕਰੋ।"

msgid "End Search"
msgstr "ਖੋਜ ਖ਼ਤਮ ਕਰੋ"

msgid "End the current search if any and hide any GUI elements."
msgstr "ਜੇ ਕੋਈ ਮੌਜੂਦਾ ਖੋਜ ਹੈ ਤਾਂ ਉਸ ਨੂੰ ਖ਼ਤਮ ਕਰੋ ਅਤੇ ਕੋਈ ਵੀ GUI ਤੱਤ ਲੁਕਾ ਦਿਓ।"

msgid "Next Search Result"
msgstr "ਅਗਲਾ ਖੋਜ ਨਤੀਜਾ"

msgid "Navigate to the next search result, if any."
msgstr "ਜੇ ਕੋਈ ਹੈ ਤਾਂ ਅਗਲੇ ਖੋਜ ਨਤੀਜੇ 'ਤੇ ਜਾਓ।"

msgid "Previous Search Result"
msgstr "ਪਿਛਲਾ ਖੋਜ ਨਤੀਜਾ"

msgid "Navigate to the previous search result, if any."
msgstr "ਜੇ ਕੋਈ ਹੈ ਤਾਂ ਪਿਛਲੇ ਖੋਜ ਨਤੀਜੇ 'ਤੇ ਜਾਓ।"

msgid "Increase Font Size"
msgstr "ਫ਼ੌਂਟ ਦਾ ਆਕਾਰ ਵਧਾਓ"

msgid "Increase the font size by 1 point."
msgstr "ਫ਼ੌਂਟ ਦਾ ਆਕਾਰ 1 ਪੁਆਇੰਟ ਵਧਾਓ।"

msgid "Decrease Font Size"
msgstr "ਫ਼ੌਂਟ ਦਾ ਆਕਾਰ ਘਟਾਓ"

msgid "Decrease the font size by 1 point."
msgstr "ਫ਼ੌਂਟ ਦਾ ਆਕਾਰ 1 ਪੁਆਇੰਟ ਘਟਾਓ।"

msgid "Reset Font Size"
msgstr "ਫ਼ੌਂਟ ਦਾ ਆਕਾਰ ਮੁੜ-ਸੈੱਟ ਕਰੋ"

msgid "Reset the font size to the default."
msgstr "ਫ਼ੌਂਟ ਦਾ ਆਕਾਰ ਮੂਲ ਮੁੱਲ 'ਤੇ ਮੁੜ-ਸੈੱਟ ਕਰੋ।"

msgid "Clear Screen"
msgstr "ਸਕਰੀਨ ਸਾਫ਼ ਕਰੋ"

msgid "Clear the screen and scrollback."
msgstr "ਸਕਰੀਨ ਅਤੇ ਸਕਰੋਲਬੈਕ ਸਾਫ਼ ਕਰੋ।"

msgid "Select All"
msgstr "ਸਭ ਚੁਣੋ"

msgid "Select all text on the screen."
