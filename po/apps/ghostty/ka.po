msgid "Open in Ghostty"
msgstr "Ghostty-ში გახსნა"

msgid "Find…"
msgstr "ძებნა…"

msgid "Previous Match"
msgstr "წინა დამთხვევა"

msgid "Next Match"
msgstr "შემდეგი დამთხვევა"

msgid "Close"
msgstr "დახურვა"

msgid "Oh, no."
msgstr "ოჰ, არა."

msgid "Unable to acquire an OpenGL context for rendering."
msgstr "რენდერისთვის OpenGL-ის კონტექსტის მიღება შეუძლებელია."

msgid "This terminal is in read-only mode. You can still view, select, and scroll through the content, but no input events will be sent to the running application."
msgstr "ეს ტერმინალი მხოლოდ კითხვის რეჟიმშია. შეგიძლიათ შიგთავსის ნახვა, მონიშვნა და გადახვევა, თუმცა გაშვებულ აპლიკაციას შეყვანის მოვლენები არ გაეგზავნება."

msgid "Read-only"
msgstr "მხოლოდ კითხვა"

msgid "Copy"
msgstr "კოპირება"

msgid "Paste"
msgstr "ჩასმა"

msgid "Notify on Next Command Finish"
msgstr "შემდეგი ბრძანების დასრულებისას შეტყობინება"

msgid "Clear"
msgstr "გასუფთავება"

msgid "Reset"
msgstr "ჩამოყრა"

msgid "Split"
msgstr "გაყოფა"

msgid "Change Title…"
msgstr "სათაურის შეცვლა…"

msgid "Split Up"
msgstr "გაყოფა ზემოთ"

msgid "Split Down"
msgstr "გაყოფა ქვემოთ"

msgid "Split Left"
msgstr "გაყოფა მარცხნივ"

msgid "Split Right"
msgstr "გაყოფა მარჯვნივ"

msgid "Close Split"
msgstr "გაყოფის დახურვა"

msgid "Tab"
msgstr "ჩანართი"

msgid "Change Tab Title…"
msgstr "ჩანართის სათაურის შეცვლა…"

msgid "New Tab"
msgstr "ახალი ჩანართი"

msgid "Close Tab"
msgstr "ჩანართის დახურვა"

msgid "Window"
msgstr "ფანჯარა"

msgid "Change Window Title…"
msgstr "ფანჯრის სათაურის შეცვლა…"

msgid "New Window"
msgstr "ახალი ფანჯარა"

msgid "Close Window"
msgstr "ფანჯრის დახურვა"

msgid "Config"
msgstr "კონფიგურაცია"

msgid "Open Configuration in OS Editor"
msgstr "კონფიგურაციის გახსნა ოპერაციული სისტემის რედაქტორში"

msgid "Open Configuration in New Window"
msgstr "კონფიგურაციის გახსნა ახალ ფანჯარაში"

msgid "Reload Configuration"
msgstr "კონფიგურაციის თავიდან ჩატვირთვა"

msgid "⚠️ You're running a debug build of Ghostty! Performance will be degraded."
msgstr "⚠️ თქვენ აწარმოებთ Ghostty-ის გამართვის აგებას! წარმადობა დაქვეითებული იქნება."

msgid "Ghostty: Terminal Inspector"
msgstr "Ghostty: ტერმინალის ინსპექტორი"

msgid "New Split"
msgstr "ახალი გაყოფა"

msgid "View Open Tabs"
msgstr "ღია ჩანართების ნახვა"

msgid "Main Menu"
msgstr "მთავარი მენიუ"

msgid "Command Palette"
msgstr "ბრძანებების პალიტრა"

msgid "Terminal Inspector"
msgstr "ტერმინალის ინსპექტორი"

msgid "About Ghostty"
msgstr "Ghostty-ის შესახებ"

msgid "Quit"
msgstr "გასვლა"

msgid "Authorize Clipboard Access"
msgstr "გაცვლის ბუფერზე წვდომის ავტორიზაცია"

msgid "Deny"
msgstr "აკრძალვა"

msgid "Allow"
msgstr "დაშვება"

msgid "Remember choice for this split"
msgstr "არჩევანის დამახსოვრება ამ გაყოფისთვის"

msgid "Reload configuration to show this prompt again"
msgstr "ამ მოთხოვნის კვლავ საჩვენებლად კონფიგურაცია თავიდან ჩატვირთეთ"

msgid "Cancel"
msgstr "გაუქმება"

msgid "Execute a command…"
msgstr "ბრძანების შესრულება…"

msgid "Configuration Errors"
msgstr "კონფიგურაციის შეცდომები"

msgid "One or more configuration errors were found. Please review the errors below, and either reload your configuration or ignore these errors."
msgstr "აღმოჩენილია ერთი ან მეტი კონფიგურაციის შეცდომა. გთხოვთ, გადაათვალიეროთ ქვემოთ მოცემული შეცდომები და თავიდან ჩატვირთოთ კონფიგურაცია ან უგულებელყოთ ეს შეცდომები."

msgid "Ignore"
msgstr "უგულებელყოფა"

msgid "Leave blank to restore the default title."
msgstr "ნაგულისხმევი სათაურის დასაბრუნებლად დატოვეთ ცარიელი."

msgid "OK"
msgstr "კარგი"

msgid "The keybind was revoked by the system."
msgstr "სისტემამ კლავიშთა მიბმა გააუქმა."

msgid "The keybind was denied by the system."
msgstr "სისტემამ კლავიშთა მიბმა უარყო."

msgid "Global keybind unavailable"
msgstr "გლობალური კლავიშთა მიბმა მიუწვდომელია"

msgid "Export Terminal IO Events"
msgstr "ტერმინალის შეყვანა/გამოტანის მოვლენების გატანა"

msgid "Export"
msgstr "გატანა"

msgid "Editing configuration file"
msgstr "კონფიგურაციის ფაილის ჩასწორება"

msgid "An application is attempting to write to the clipboard. The current clipboard contents are shown below."
msgstr "აპლიკაცია ცდილობს გაცვლის ბუფერში ჩაწერას. გაცვლის ბუფერის მიმდინარე შიგთავსი ნაჩვენებია ქვემოთ."

msgid "An application is attempting to read from the clipboard. The current clipboard contents are shown below."
msgstr "აპლიკაცია ცდილობს გაცვლის ბუფერიდან წაკითხვას. გაცვლის ბუფერის მიმდინარე შიგთავსი ნაჩვენებია ქვემოთ."

msgid "Warning: Potentially Unsafe Paste"
msgstr "გაფრთხილება: პოტენციურად სახიფათო ჩასმა"

msgid "Pasting this text into the terminal may be dangerous as it looks like some commands may be executed."
msgstr "ამ ტექსტის ტერმინალში ჩასმა შეიძლება სახიფათო იყოს, რადგან ჩანს, რომ რამდენიმე ბრძანება შესრულდება."

msgid "Quit Ghostty?"
msgstr "გსურთ Ghostty-იდან გასვლა?"

msgid "Close Tab?"
msgstr "გსურთ ჩანართის დახურვა?"

msgid "Close Window?"
msgstr "გსურთ ფანჯრის დახურვა?"

msgid "Close Split?"
msgstr "გსურთ გაყოფის დახურვა?"

msgid "All terminal sessions will be terminated."
msgstr "ყველა ტერმინალური სესია შეწყდება."

msgid "All terminal sessions in this tab will be terminated."
msgstr "ამ ჩანართში ყველა ტერმინალური სესია შეწყდება."

msgid "All terminal sessions in this window will be terminated."
msgstr "ამ ფანჯარაში ყველა ტერმინალური სესია შეწყდება."

msgid "The currently running process in this split will be terminated."
msgstr "ამ გაყოფაში ამჟამად გაშვებული პროცესი შეწყდება."

msgid "Command Finished"
msgstr "ბრძანება დასრულდა"

msgid "Command Succeeded"
msgstr "ბრძანება წარმატებით შესრულდა"

msgid "Command Failed"
msgstr "ბრძანება ვერ შესრულდა"

msgid "Change Terminal Title"
msgstr "ტერმინალის სათაურის შეცვლა"

msgid "Change Tab Title"
msgstr "ჩანართის სათაურის შეცვლა"

msgid "Change Window Title"
msgstr "ფანჯრის სათაურის შეცვლა"

msgid "Reloaded the configuration"
msgstr "კონფიგურაცია თავიდან ჩაიტვირთა"

msgid "Copied to clipboard"
msgstr "დაკოპირდა გაცვლის ბუფერში"

msgid "Cleared clipboard"
msgstr "გაცვლის ბუფერი გასუფთავდა"

msgid "Ghostty Developers"
msgstr "Ghostty-ის შემქმნელები"

msgid "Reset Terminal"
msgstr "ტერმინალის ჩამოყრა"

msgid "Reset the terminal to a clean state."
msgstr "ტერმინალის სუფთა მდგომარეობაში ჩამოყრა."

msgid "Copy to Clipboard"
msgstr "გაცვლის ბუფერში კოპირება"

msgid "Copy the selected text to the clipboard in both plain and styled formats."
msgstr "მონიშნული ტექსტის გაცვლის ბუფერში კოპირება როგორც უბრალო, ასევე სტილიზებული ფორმატით."

msgid "Copy Selection as Plain Text to Clipboard"
msgstr "მონიშნულის გაცვლის ბუფერში კოპირება უბრალო ტექსტად"

msgid "Copy the selected text as plain text to the clipboard."
msgstr "მონიშნული ტექსტის გაცვლის ბუფერში კოპირება უბრალო ტექსტად."

msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "მონიშნულის გაცვლის ბუფერში კოპირება ANSI მიმდევრობებად"

msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr "მონიშნული ტექსტის გაცვლის ბუფერში კოპირება ANSI გასვლის მიმდევრობებად."

msgid "Copy Selection as HTML to Clipboard"
msgstr "მონიშნულის გაცვლის ბუფერში კოპირება HTML-ად"

msgid "Copy the selected text as HTML to the clipboard."
msgstr "მონიშნული ტექსტის გაცვლის ბუფერში კოპირება HTML-ად."

msgid "Copy URL to Clipboard"
msgstr "URL-ის გაცვლის ბუფერში კოპირება"

msgid "Copy the URL under the cursor to the clipboard."
msgstr "კურსორის ქვეშ მდებარე URL-ის გაცვლის ბუფერში კოპირება."

msgid "Copy Terminal Title to Clipboard"
msgstr "ტერმინალის სათაურის გაცვლის ბუფერში კოპირება"

msgid "Copy the terminal title to the clipboard. If the terminal title is not set this has no effect."
msgstr "ტერმინალის სათაურის გაცვლის ბუფერში კოპირება. თუ ტერმინალის სათაური დაყენებული არაა, ამას ეფექტი არ ექნება."

msgid "Paste from Clipboard"
msgstr "ჩასმა გაცვლის ბუფერიდან"

msgid "Paste the contents of the main clipboard."
msgstr "მთავარი გაცვლის ბუფერის შიგთავსის ჩასმა."

msgid "Paste from Selection"
msgstr "ჩასმა მონიშნულიდან"

msgid "Paste the contents of the selection clipboard."
msgstr "მონიშვნის გაცვლის ბუფერის შიგთავსის ჩასმა."

msgid "Start Search"
msgstr "ძებნის დაწყება"

msgid "Start a search if one isn't already active."
msgstr "ძებნის დაწყება, თუ ის უკვე აქტიური არაა."

msgid "Search Selection"
msgstr "მონიშნულის ძებნა"

msgid "Start a search for the current text selection."
msgstr "მიმდინარე მონიშნული ტექსტის ძებნის დაწყება."

msgid "End Search"
msgstr "ძებნის დასრულება"

msgid "End the current search if any and hide any GUI elements."
msgstr "მიმდინარე ძებნის დასრულება, ასეთის არსებობის შემთხვევაში, და ყველა გრაფიკული ელემენტის დამალვა."

msgid "Next Search Result"
msgstr "შემდეგი ძებნის შედეგი"

msgid "Navigate to the next search result, if any."
msgstr "შემდეგ ძებნის შედეგზე გადასვლა, ასეთის არსებობის შემთხვევაში."

msgid "Previous Search Result"
msgstr "წინა ძებნის შედეგი"

msgid "Navigate to the previous search result, if any."
msgstr "წინა ძებნის შედეგზე გადასვლა, ასეთის არსებობის შემთხვევაში."

msgid "Increase Font Size"
msgstr "შრიფტის ზომის გაზრდა"

msgid "Increase the font size by 1 point."
msgstr "შრიფტის ზომის 1 პუნქტით გაზრდა."

msgid "Decrease Font Size"
msgstr "შრიფტის ზომის შემცირება"

msgid "Decrease the font size by 1 point."
msgstr "შრიფტის ზომის 1 პუნქტით შემცირება."

msgid "Reset Font Size"
msgstr "შრიფტის ზომის ჩამოყრა"

msgid "Reset the font size to the default."
msgstr "შრიფტის ზომის ნაგულისხმევზე ჩამოყრა."

msgid "Clear Screen"
msgstr "ეკრანის გასუფთავება"

msgid "Clear the screen and scrollback."
msgstr "ეკრანისა და გადახვევის ბუფერის გასუფთავება."

msgid "Select All"
msgstr "ყველაფრის მონიშვნა"

msgid "Select all text on the screen."
msgstr "ეკრანზე მთელი ტექსტის მონიშვნა."

msgid "Scroll to Top"
msgstr "გადახვევა თავში"

msgid "Scroll to the top of the screen."
msgstr "ეკრანის თავში გადახვევა."

msgid "Scroll to Bottom"
msgstr "გადახვევა ბოლოში"

msgid "Scroll to the bottom of the screen."
msgstr "ეკრანის ბოლოში გადახვევა."

msgid "Scroll to Selection"
msgstr "გადახვევა მონიშნულთან"

msgid "Scroll to the selected text."
msgstr "მონიშნულ ტექსტთან გადახვევა."

msgid "Scroll Page Up"
msgstr "გვერდით ზემოთ გადახვევა"

msgid "Scroll the screen up by a page."
msgstr "ეკრანის ერთი გვერდით ზემოთ გადახვევა."

msgid "Scroll Page Down"
msgstr "გვერდით ქვემოთ გადახვევა"

msgid "Scroll the screen down by a page."
msgstr "ეკრანის ერთი გვერდით ქვემოთ გადახვევა."

msgid "Copy Screen to Temporary File and Copy Path"
msgstr "ეკრანის დროებით ფაილში კოპირება და მისი ბილიკის კოპირება"

msgid "Copy the screen contents to a temporary file and copy the path to the clipboard."
msgstr "ეკრანის შიგთავსის დროებით ფაილში კოპირება და ბილიკის გაცვლის ბუფერში კოპირება."

msgid "Copy Screen to Temporary File and Paste Path"
msgstr "ეკრანის დროებით ფაილში კოპირება და მისი ბილიკის ჩასმა"

msgid "Copy the screen contents to a temporary file and paste the path to the file."
msgstr "ეკრანის შიგთავსის დროებით ფაილში კოპირება და ფაილის ბილიკის ჩასმა."

msgid "Copy Screen to Temporary File and Open"
msgstr "ეკრანის დროებით ფაილში კოპირება და გახსნა"

msgid "Copy the screen contents to a temporary file and open it."
msgstr "ეკრანის შიგთავსის დროებით ფაილში კოპირება და მისი გახსნა."

msgid "Copy Screen as HTML to Temporary File and Copy Path"
msgstr "ეკრანის HTML-ად დროებით ფაილში კოპირება და მისი ბილიკის კოპირება"

msgid "Copy the screen contents as HTML to a temporary file and copy the path to the clipboard."
msgstr "ეკრანის შიგთავსის HTML-ად დროებით ფაილში კოპირება და ბილიკის გაცვლის ბუფერში კოპირება."

msgid "Copy Screen as HTML to Temporary File and Paste Path"
msgstr "ეკრანის HTML-ად დროებით ფაილში კოპირება და მისი ბილიკის ჩასმა"

msgid "Copy the screen contents as HTML to a temporary file and paste the path to the file."
