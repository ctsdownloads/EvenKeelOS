msgid "Copy the selection contents as HTML to a temporary file and open it."
msgstr "चयन की सामग्री को HTML के रूप में अस्थायी फ़ाइल में कॉपी करें और उसे खोलें।"

msgid "Copy Selection as ANSI Sequences to Temporary File and Copy Path"
msgstr "चयन ANSI सीक्वेंस के रूप में अस्थायी फ़ाइल में कॉपी करें और पाथ कॉपी करें"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and copy the path to the clipboard."
msgstr "चयन की सामग्री को ANSI एस्केप सीक्वेंस के रूप में अस्थायी फ़ाइल में कॉपी करें और पाथ को क्लिपबोर्ड पर कॉपी करें।"

msgid "Copy Selection as ANSI Sequences to Temporary File and Paste Path"
msgstr "चयन ANSI सीक्वेंस के रूप में अस्थायी फ़ाइल में कॉपी करें और पाथ पेस्ट करें"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and paste the path to the file."
msgstr "चयन की सामग्री को ANSI एस्केप सीक्वेंस के रूप में अस्थायी फ़ाइल में कॉपी करें और फ़ाइल का पाथ पेस्ट करें।"

msgid "Copy Selection as ANSI Sequences to Temporary File and Open"
msgstr "चयन ANSI सीक्वेंस के रूप में अस्थायी फ़ाइल में कॉपी करें और खोलें"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and open it."
msgstr "चयन की सामग्री को ANSI एस्केप सीक्वेंस के रूप में अस्थायी फ़ाइल में कॉपी करें और उसे खोलें।"

msgid "Open a new window."
msgstr "नई विंडो खोलें।"

msgid "Open a new tab."
msgstr "नया टैब खोलें।"

msgid "Move Tab Left"
msgstr "टैब को बाईं ओर ले जाएँ"

msgid "Move the current tab to the left."
msgstr "मौजूदा टैब को बाईं ओर ले जाएँ।"

msgid "Move Tab Right"
msgstr "टैब को दाईं ओर ले जाएँ"

msgid "Move the current tab to the right."
msgstr "मौजूदा टैब को दाईं ओर ले जाएँ।"

msgid "Move Tab to New Window"
msgstr "टैब को नई विंडो में ले जाएँ"

msgid "Move the current tab to a new window."
msgstr "मौजूदा टैब को नई विंडो में ले जाएँ।"

msgid "Toggle Tab Overview"
msgstr "टैब ओवरव्यू टॉगल करें"

msgid "Toggle the tab overview."
msgstr "टैब ओवरव्यू को टॉगल करें।"

msgid "Change Terminal Title…"
msgstr "टर्मिनल का शीर्षक बदलें…"

msgid "Prompt for a new title for the current terminal."
msgstr "मौजूदा टर्मिनल के लिए नया शीर्षक पूछें।"

msgid "Prompt for a new title for the current tab."
msgstr "मौजूदा टैब के लिए नया शीर्षक पूछें।"

msgid "Split the terminal to the left."
msgstr "टर्मिनल को बाईं ओर स्प्लिट करें।"

msgid "Split the terminal to the right."
msgstr "टर्मिनल को दाईं ओर स्प्लिट करें।"

msgid "Split the terminal up."
msgstr "टर्मिनल को ऊपर की ओर स्प्लिट करें।"

msgid "Split the terminal down."
msgstr "टर्मिनल को नीचे की ओर स्प्लिट करें।"

msgid "Focus Split: Previous"
msgstr "फ़ोकस स्प्लिट: पिछला"

msgid "Focus the previous split, if any."
msgstr "अगर कोई पिछला स्प्लिट है, तो उस पर फ़ोकस करें।"

msgid "Focus Split: Next"
msgstr "फ़ोकस स्प्लिट: अगला"

msgid "Focus the next split, if any."
msgstr "अगर कोई अगला स्प्लिट है, तो उस पर फ़ोकस करें।"

msgid "Focus Split: Left"
msgstr "फ़ोकस स्प्लिट: बायाँ"

msgid "Focus the split to the left, if it exists."
msgstr "बाईं ओर का स्प्लिट, अगर मौजूद है, तो उस पर फ़ोकस करें।"

msgid "Focus Split: Right"
msgstr "फ़ोकस स्प्लिट: दायाँ"

msgid "Focus the split to the right, if it exists."
msgstr "दाईं ओर का स्प्लिट, अगर मौजूद है, तो उस पर फ़ोकस करें।"

msgid "Focus Split: Up"
msgstr "फ़ोकस स्प्लिट: ऊपर"

msgid "Focus the split above, if it exists."
msgstr "ऊपर का स्प्लिट, अगर मौजूद है, तो उस पर फ़ोकस करें।"

msgid "Focus Split: Down"
msgstr "फ़ोकस स्प्लिट: नीचे"

msgid "Focus the split below, if it exists."
msgstr "नीचे का स्प्लिट, अगर मौजूद है, तो उस पर फ़ोकस करें।"

msgid "Focus Window: Previous"
msgstr "फ़ोकस विंडो: पिछली"

msgid "Focus the previous window, if any."
msgstr "अगर कोई पिछली विंडो है, तो उस पर फ़ोकस करें।"

msgid "Focus Window: Next"
msgstr "फ़ोकस विंडो: अगली"

msgid "Focus the next window, if any."
msgstr "अगर कोई अगली विंडो है, तो उस पर फ़ोकस करें।"

msgid "Toggle Split Zoom"
msgstr "स्प्लिट ज़ूम टॉगल करें"

msgid "Toggle the zoom state of the current split."
msgstr "मौजूदा स्प्लिट की ज़ूम स्थिति को टॉगल करें।"

msgid "Toggle Read-Only Mode"
msgstr "रीड-ओनली मोड टॉगल करें"

msgid "Toggle read-only mode for the current surface."
msgstr "मौजूदा सरफ़ेस के लिए रीड-ओनली मोड टॉगल करें।"

msgid "Equalize Splits"
msgstr "स्प्लिट बराबर करें"

msgid "Equalize the size of all splits."
msgstr "सभी स्प्लिट का आकार बराबर करें।"

msgid "Reset Window Size"
msgstr "विंडो का आकार रीसेट करें"

msgid "Reset the window size to the default."
msgstr "विंडो का आकार डिफ़ॉल्ट पर रीसेट करें।"

msgid "Toggle Inspector"
msgstr "इंस्पेक्टर टॉगल करें"

msgid "Toggle the inspector."
msgstr "इंस्पेक्टर को टॉगल करें।"

msgid "Show the GTK Inspector"
msgstr "GTK इंस्पेक्टर दिखाएँ"

msgid "Show the GTK inspector."
msgstr "GTK इंस्पेक्टर दिखाएँ।"

msgid "Show On-Screen Keyboard"
msgstr "ऑन-स्क्रीन कीबोर्ड दिखाएँ"

msgid "Show the on-screen keyboard if present."
msgstr "अगर ऑन-स्क्रीन कीबोर्ड मौजूद है, तो उसे दिखाएँ।"

msgid "Open Config Using OS editor"
msgstr "OS एडिटर से कॉन्फ़िग खोलें"

msgid "Open the config file with the OS's default editor."
msgstr "कॉन्फ़िग फ़ाइल को OS के डिफ़ॉल्ट एडिटर से खोलें।"

msgid "Open Config in New Terminal Window"
msgstr "कॉन्फ़िग को नई टर्मिनल विंडो में खोलें"

msgid "Open the config file in a new window using $EDITOR or $VISUAL."
msgstr "$EDITOR या $VISUAL का उपयोग करके कॉन्फ़िग फ़ाइल को नई विंडो में खोलें।"

msgid "Reload Config"
msgstr "कॉन्फ़िग फिर से लोड करें"

msgid "Reload the config file."
msgstr "कॉन्फ़िग फ़ाइल फिर से लोड करें।"

msgid "Close Terminal"
msgstr "टर्मिनल बंद करें"

msgid "Close the current terminal."
msgstr "मौजूदा टर्मिनल बंद करें।"

msgid "Close the current tab."
msgstr "मौजूदा टैब बंद करें।"

msgid "Close Other Tabs"
msgstr "अन्य टैब बंद करें"

msgid "Close all tabs in this window except the current one."
msgstr "इस विंडो के सभी टैब बंद करें, सिवाय मौजूदा टैब के।"

msgid "Close Tabs to the Right"
msgstr "दाईं ओर के टैब बंद करें"

msgid "Close all tabs to the right of the current one."
msgstr "मौजूदा टैब के दाईं ओर के सभी टैब बंद करें।"

msgid "Close the current window."
msgstr "मौजूदा विंडो बंद करें।"

msgid "Close All Windows"
msgstr "सभी विंडो बंद करें"

msgid "Close all windows."
msgstr "सभी विंडो बंद करें।"

msgid "Toggle Maximize"
msgstr "मैक्सिमाइज़ टॉगल करें"

msgid "Toggle the maximized state of the current window."
msgstr "मौजूदा विंडो की मैक्सिमाइज़ स्थिति टॉगल करें।"

msgid "Toggle Fullscreen"
msgstr "फ़ुलस्क्रीन टॉगल करें"

msgid "Toggle the fullscreen state of the current window."
msgstr "मौजूदा विंडो की फ़ुलस्क्रीन स्थिति टॉगल करें।"

msgid "Toggle Window Decorations"
msgstr "विंडो डेकोरेशन टॉगल करें"

msgid "Toggle the window decorations."
msgstr "विंडो डेकोरेशन टॉगल करें।"

msgid "Toggle Float on Top"
msgstr "हमेशा ऊपर रखना टॉगल करें"

msgid "Toggle the float on top state of the current window."
msgstr "मौजूदा विंडो की हमेशा ऊपर रहने की स्थिति टॉगल करें।"

msgid "Toggle Secure Input"
msgstr "सुरक्षित इनपुट टॉगल करें"

msgid "Toggle secure input mode."
msgstr "सुरक्षित इनपुट मोड टॉगल करें।"

msgid "Toggle Mouse Reporting"
msgstr "माउस रिपोर्टिंग टॉगल करें"

msgid "Toggle whether mouse events are reported to terminal applications."
msgstr "माउस इवेंट टर्मिनल ऐप्लिकेशन को रिपोर्ट किए जाएँ या नहीं, इसे टॉगल करें।"

msgid "Toggle Background Opacity"
msgstr "बैकग्राउंड पारदर्शिता टॉगल करें"

msgid "Toggle the background opacity of a window that started transparent."
msgstr "पारदर्शी रूप में शुरू हुई विंडो की बैकग्राउंड पारदर्शिता टॉगल करें।"

msgid "Check for Updates"
msgstr "अपडेट जाँचें"

msgid "Check for updates to the application."
msgstr "ऐप्लिकेशन के अपडेट जाँचें।"

msgid "Undo"
msgstr "पूर्ववत करें"

msgid "Undo the last action."
msgstr "पिछली कार्रवाई को पूर्ववत करें।"

msgid "Redo"
msgstr "दोबारा करें"

msgid "Redo the last undone action."
msgstr "पूर्ववत की गई पिछली कार्रवाई को दोबारा करें।"

msgid "Quit the application."
msgstr "ऐप्लिकेशन बंद करें।"

msgid "Ghostty"
msgstr "Ghostty"

msgid "Put a little Ghostty in your terminal."
msgstr "अपने टर्मिनल में थोड़ा-सा Ghostty रखें।"
