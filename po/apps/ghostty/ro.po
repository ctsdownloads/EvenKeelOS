msgstr "Dezvoltatorii Ghostty"

msgid "Reset Terminal"
msgstr "Resetează terminalul"

msgid "Reset the terminal to a clean state."
msgstr "Resetează terminalul la o stare curată."

msgid "Copy to Clipboard"
msgstr "Copiază în clipboard"

msgid "Copy the selected text to the clipboard in both plain and styled formats."
msgstr "Copiază textul selectat în clipboard, atât în format simplu, cât și stilizat."

msgid "Copy Selection as Plain Text to Clipboard"
msgstr "Copiază selecția ca text simplu în clipboard"

msgid "Copy the selected text as plain text to the clipboard."
msgstr "Copiază textul selectat ca text simplu în clipboard."

msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "Copiază selecția ca secvențe ANSI în clipboard"

msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr "Copiază textul selectat ca secvențe de evadare ANSI în clipboard."

msgid "Copy Selection as HTML to Clipboard"
msgstr "Copiază selecția ca HTML în clipboard"

msgid "Copy the selected text as HTML to the clipboard."
msgstr "Copiază textul selectat ca HTML în clipboard."

msgid "Copy URL to Clipboard"
msgstr "Copiază adresa URL în clipboard"

msgid "Copy the URL under the cursor to the clipboard."
msgstr "Copiază adresa URL de sub cursor în clipboard."

msgid "Copy Terminal Title to Clipboard"
msgstr "Copiază titlul terminalului în clipboard"

msgid "Copy the terminal title to the clipboard. If the terminal title is not set this has no effect."
msgstr "Copiază titlul terminalului în clipboard. Dacă titlul terminalului nu este setat, nu are niciun efect."

msgid "Paste from Clipboard"
msgstr "Lipește din clipboard"

msgid "Paste the contents of the main clipboard."
msgstr "Lipește conținutul clipboardului principal."

msgid "Paste from Selection"
msgstr "Lipește din selecție"

msgid "Paste the contents of the selection clipboard."
msgstr "Lipește conținutul clipboardului de selecție."

msgid "Start Search"
msgstr "Începe căutarea"

msgid "Start a search if one isn't already active."
msgstr "Începe o căutare dacă nu este deja una activă."

msgid "Search Selection"
msgstr "Caută selecția"

msgid "Start a search for the current text selection."
msgstr "Începe o căutare pentru textul selectat în prezent."

msgid "End Search"
msgstr "Termină căutarea"

msgid "End the current search if any and hide any GUI elements."
msgstr "Termină căutarea curentă, dacă există, și ascunde elementele grafice."

msgid "Next Search Result"
msgstr "Următorul rezultat al căutării"

msgid "Navigate to the next search result, if any."
msgstr "Navighează la următorul rezultat al căutării, dacă există."

msgid "Previous Search Result"
msgstr "Rezultatul anterior al căutării"

msgid "Navigate to the previous search result, if any."
msgstr "Navighează la rezultatul anterior al căutării, dacă există."

msgid "Increase Font Size"
msgstr "Mărește dimensiunea fontului"

msgid "Increase the font size by 1 point."
msgstr "Mărește dimensiunea fontului cu 1 punct."

msgid "Decrease Font Size"
msgstr "Micșorează dimensiunea fontului"

msgid "Decrease the font size by 1 point."
msgstr "Micșorează dimensiunea fontului cu 1 punct."

msgid "Reset Font Size"
msgstr "Resetează dimensiunea fontului"

msgid "Reset the font size to the default."
msgstr "Resetează dimensiunea fontului la valoarea implicită."

msgid "Clear Screen"
msgstr "Golește ecranul"

msgid "Clear the screen and scrollback."
msgstr "Golește ecranul și istoricul de derulare."

msgid "Select All"
msgstr "Selectează tot"

msgid "Select all text on the screen."
msgstr "Selectează tot textul de pe ecran."

msgid "Scroll to Top"
msgstr "Derulează la început"

msgid "Scroll to the top of the screen."
msgstr "Derulează la începutul ecranului."

msgid "Scroll to Bottom"
msgstr "Derulează la sfârșit"

msgid "Scroll to the bottom of the screen."
msgstr "Derulează la sfârșitul ecranului."

msgid "Scroll to Selection"
msgstr "Derulează la selecție"

msgid "Scroll to the selected text."
msgstr "Derulează la textul selectat."

msgid "Scroll Page Up"
msgstr "Derulează o pagină în sus"

msgid "Scroll the screen up by a page."
msgstr "Derulează ecranul în sus cu o pagină."

msgid "Scroll Page Down"
msgstr "Derulează o pagină în jos"

msgid "Scroll the screen down by a page."
msgstr "Derulează ecranul în jos cu o pagină."

msgid "Copy Screen to Temporary File and Copy Path"
msgstr "Copiază ecranul într-un fișier temporar și copiază calea"

msgid "Copy the screen contents to a temporary file and copy the path to the clipboard."
msgstr "Copiază conținutul ecranului într-un fișier temporar și copiază calea în clipboard."

msgid "Copy Screen to Temporary File and Paste Path"
msgstr "Copiază ecranul într-un fișier temporar și lipește calea"

msgid "Copy the screen contents to a temporary file and paste the path to the file."
msgstr "Copiază conținutul ecranului într-un fișier temporar și lipește calea către fișier."

msgid "Copy Screen to Temporary File and Open"
msgstr "Copiază ecranul într-un fișier temporar și deschide-l"

msgid "Copy the screen contents to a temporary file and open it."
msgstr "Copiază conținutul ecranului într-un fișier temporar și deschide-l."

msgid "Copy Screen as HTML to Temporary File and Copy Path"
msgstr "Copiază ecranul ca HTML într-un fișier temporar și copiază calea"

msgid "Copy the screen contents as HTML to a temporary file and copy the path to the clipboard."
msgstr "Copiază conținutul ecranului ca HTML într-un fișier temporar și copiază calea în clipboard."

msgid "Copy Screen as HTML to Temporary File and Paste Path"
msgstr "Copiază ecranul ca HTML într-un fișier temporar și lipește calea"

msgid "Copy the screen contents as HTML to a temporary file and paste the path to the file."
msgstr "Copiază conținutul ecranului ca HTML într-un fișier temporar și lipește calea către fișier."

msgid "Copy Screen as HTML to Temporary File and Open"
msgstr "Copiază ecranul ca HTML într-un fișier temporar și deschide-l"

msgid "Copy the screen contents as HTML to a temporary file and open it."
msgstr "Copiază conținutul ecranului ca HTML într-un fișier temporar și deschide-l."

msgid "Copy Screen as ANSI Sequences to Temporary File and Copy Path"
msgstr "Copiază ecranul ca secvențe ANSI într-un fișier temporar și copiază calea"

msgid "Copy the screen contents as ANSI escape sequences to a temporary file and copy the path to the clipboard."
msgstr "Copiază conținutul ecranului ca secvențe de evadare ANSI într-un fișier temporar și copiază calea în clipboard."

msgid "Copy Screen as ANSI Sequences to Temporary File and Paste Path"
msgstr "Copiază ecranul ca secvențe ANSI într-un fișier temporar și lipește calea"

msgid "Copy the screen contents as ANSI escape sequences to a temporary file and paste the path to the file."
msgstr "Copiază conținutul ecranului ca secvențe de evadare ANSI într-un fișier temporar și lipește calea către fișier."

msgid "Copy Screen as ANSI Sequences to Temporary File and Open"
msgstr "Copiază ecranul ca secvențe ANSI într-un fișier temporar și deschide-l"

msgid "Copy the screen contents as ANSI escape sequences to a temporary file and open it."
msgstr "Copiază conținutul ecranului ca secvențe de evadare ANSI într-un fișier temporar și deschide-l."

msgid "Copy Selection to Temporary File and Copy Path"
msgstr "Copiază selecția într-un fișier temporar și copiază calea"

msgid "Copy the selection contents to a temporary file and copy the path to the clipboard."
msgstr "Copiază conținutul selecției într-un fișier temporar și copiază calea în clipboard."

msgid "Copy Selection to Temporary File and Paste Path"
msgstr "Copiază selecția într-un fișier temporar și lipește calea"

msgid "Copy the selection contents to a temporary file and paste the path to the file."
msgstr "Copiază conținutul selecției într-un fișier temporar și lipește calea către fișier."

msgid "Copy Selection to Temporary File and Open"
msgstr "Copiază selecția într-un fișier temporar și deschide-l"

msgid "Copy the selection contents to a temporary file and open it."
msgstr "Copiază conținutul selecției într-un fișier temporar și deschide-l."

msgid "Copy Selection as HTML to Temporary File and Copy Path"
msgstr "Copiază selecția ca HTML într-un fișier temporar și copiază calea"

msgid "Copy the selection contents as HTML to a temporary file and copy the path to the clipboard."
msgstr "Copiază conținutul selecției ca HTML într-un fișier temporar și copiază calea în clipboard."

msgid "Copy Selection as HTML to Temporary File and Paste Path"
msgstr "Copiază selecția ca HTML într-un fișier temporar și lipește calea"

msgid "Copy the selection contents as HTML to a temporary file and paste the path to the file."
msgstr "Copiază conținutul selecției ca HTML într-un fișier temporar și lipește calea către fișier."

msgid "Copy Selection as HTML to Temporary File and Open"
msgstr "Copiază selecția ca HTML într-un fișier temporar și deschide-l"

msgid "Copy the selection contents as HTML to a temporary file and open it."
msgstr "Copiază conținutul selecției ca HTML într-un fișier temporar și deschide-l."

msgid "Copy Selection as ANSI Sequences to Temporary File and Copy Path"
msgstr "Copiază selecția ca secvențe ANSI într-un fișier temporar și copiază calea"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and copy the path to the clipboard."
msgstr "Copiază conținutul selecției ca secvențe de evadare ANSI într-un fișier temporar și copiază calea în clipboard."

msgid "Copy Selection as ANSI Sequences to Temporary File and Paste Path"
msgstr "Copiază selecția ca secvențe ANSI într-un fișier temporar și lipește calea"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and paste the path to the file."
msgstr "Copiază conținutul selecției ca secvențe de evadare ANSI într-un fișier temporar și lipește calea către fișier."

