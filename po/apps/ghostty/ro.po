msgid "Configuration Errors"
msgstr "Erori de configurație"

msgid "One or more configuration errors were found. Please review the errors below, and either reload your configuration or ignore these errors."
msgstr "Au fost găsite una sau mai multe erori de configurație. Verifică erorile de mai jos și fie reîncarcă configurația, fie ignoră aceste erori."

msgid "Ignore"
msgstr "Ignoră"

msgid "Leave blank to restore the default title."
msgstr "Lasă gol pentru a restaura titlul implicit."

msgid "OK"
msgstr "OK"

msgid "The keybind was revoked by the system."
msgstr "Combinația de taste a fost revocată de sistem."

msgid "The keybind was denied by the system."
msgstr "Combinația de taste a fost refuzată de sistem."

msgid "Global keybind unavailable"
msgstr "Combinație globală de taste indisponibilă"

