msgstr "Copiază conținutul selecției ca secvențe de evadare ANSI într-un fișier temporar și deschide-l."

msgid "Open a new window."
msgstr "Deschide o fereastră nouă."

msgid "Open a new tab."
msgstr "Deschide o filă nouă."

msgid "Move Tab Left"
msgstr "Mută fila la stânga"

msgid "Move the current tab to the left."
msgstr "Mută fila curentă la stânga."

msgid "Move Tab Right"
msgstr "Mută fila la dreapta"

msgid "Move the current tab to the right."
msgstr "Mută fila curentă la dreapta."

msgid "Move Tab to New Window"
msgstr "Mută fila într-o fereastră nouă"

msgid "Move the current tab to a new window."
msgstr "Mută fila curentă într-o fereastră nouă."

msgid "Toggle Tab Overview"
msgstr "Comută prezentarea filelor"

msgid "Toggle the tab overview."
msgstr "Comută prezentarea generală a filelor."

msgid "Change Terminal Title…"
msgstr "Schimbă titlul terminalului…"

msgid "Prompt for a new title for the current terminal."
msgstr "Solicită un titlu nou pentru terminalul curent."

msgid "Prompt for a new title for the current tab."
msgstr "Solicită un titlu nou pentru fila curentă."

msgid "Split the terminal to the left."
msgstr "Împarte terminalul la stânga."

msgid "Split the terminal to the right."
msgstr "Împarte terminalul la dreapta."

msgid "Split the terminal up."
msgstr "Împarte terminalul în sus."

msgid "Split the terminal down."
msgstr "Împarte terminalul în jos."

msgid "Focus Split: Previous"
msgstr "Focalizează împărțirea: anterioară"

msgid "Focus the previous split, if any."
msgstr "Focalizează împărțirea anterioară, dacă există."

msgid "Focus Split: Next"
msgstr "Focalizează împărțirea: următoare"

msgid "Focus the next split, if any."
msgstr "Focalizează următoarea împărțire, dacă există."

msgid "Focus Split: Left"
msgstr "Focalizează împărțirea: stânga"

msgid "Focus the split to the left, if it exists."
msgstr "Focalizează împărțirea din stânga, dacă există."

msgid "Focus Split: Right"
msgstr "Focalizează împărțirea: dreapta"

msgid "Focus the split to the right, if it exists."
msgstr "Focalizează împărțirea din dreapta, dacă există."

msgid "Focus Split: Up"
msgstr "Focalizează împărțirea: sus"

msgid "Focus the split above, if it exists."
msgstr "Focalizează împărțirea de deasupra, dacă există."

msgid "Focus Split: Down"
msgstr "Focalizează împărțirea: jos"

msgid "Focus the split below, if it exists."
msgstr "Focalizează împărțirea de dedesubt, dacă există."

msgid "Focus Window: Previous"
msgstr "Focalizează fereastra: anterioară"

msgid "Focus the previous window, if any."
msgstr "Focalizează fereastra anterioară, dacă există."

msgid "Focus Window: Next"
msgstr "Focalizează fereastra: următoare"

msgid "Focus the next window, if any."
msgstr "Focalizează următoarea fereastră, dacă există."

msgid "Toggle Split Zoom"
msgstr "Comută mărirea împărțirii"

msgid "Toggle the zoom state of the current split."
msgstr "Comută starea de mărire a împărțirii curente."

msgid "Toggle Read-Only Mode"
msgstr "Comută modul doar pentru citire"

msgid "Toggle read-only mode for the current surface."
msgstr "Comută modul doar pentru citire pentru suprafața curentă."

msgid "Equalize Splits"
msgstr "Egalizează împărțirile"

msgid "Equalize the size of all splits."
msgstr "Egalizează dimensiunea tuturor împărțirilor."

msgid "Reset Window Size"
msgstr "Resetează dimensiunea ferestrei"

msgid "Reset the window size to the default."
msgstr "Resetează dimensiunea ferestrei la valoarea implicită."

msgid "Toggle Inspector"
msgstr "Comută inspectorul"

msgid "Toggle the inspector."
msgstr "Comută inspectorul."

msgid "Show the GTK Inspector"
msgstr "Arată inspectorul GTK"

msgid "Show the GTK inspector."
msgstr "Arată inspectorul GTK."

msgid "Show On-Screen Keyboard"
msgstr "Arată tastatura de pe ecran"

msgid "Show the on-screen keyboard if present."
msgstr "Arată tastatura de pe ecran, dacă există."

msgid "Open Config Using OS editor"
msgstr "Deschide configurația cu editorul sistemului"

msgid "Open the config file with the OS's default editor."
msgstr "Deschide fișierul de configurație cu editorul implicit al sistemului."

msgid "Open Config in New Terminal Window"
msgstr "Deschide configurația într-o fereastră nouă de terminal"

msgid "Open the config file in a new window using $EDITOR or $VISUAL."
msgstr "Deschide fișierul de configurație într-o fereastră nouă folosind $EDITOR sau $VISUAL."

msgid "Reload Config"
msgstr "Reîncarcă configurația"

msgid "Reload the config file."
msgstr "Reîncarcă fișierul de configurație."

msgid "Close Terminal"
msgstr "Închide terminalul"

msgid "Close the current terminal."
msgstr "Închide terminalul curent."

msgid "Close the current tab."
msgstr "Închide fila curentă."

msgid "Close Other Tabs"
msgstr "Închide celelalte file"

msgid "Close all tabs in this window except the current one."
msgstr "Închide toate filele din această fereastră, în afară de cea curentă."

msgid "Close Tabs to the Right"
msgstr "Închide filele din dreapta"

msgid "Close all tabs to the right of the current one."
msgstr "Închide toate filele din dreapta celei curente."

msgid "Close the current window."
msgstr "Închide fereastra curentă."

msgid "Close All Windows"
msgstr "Închide toate ferestrele"

msgid "Close all windows."
msgstr "Închide toate ferestrele."

msgid "Toggle Maximize"
msgstr "Comută maximizarea"

msgid "Toggle the maximized state of the current window."
msgstr "Comută starea maximizată a ferestrei curente."

msgid "Toggle Fullscreen"
msgstr "Comută ecranul complet"

msgid "Toggle the fullscreen state of the current window."
msgstr "Comută starea de ecran complet a ferestrei curente."

msgid "Toggle Window Decorations"
msgstr "Comută decorațiile ferestrei"

msgid "Toggle the window decorations."
msgstr "Comută decorațiile ferestrei."

msgid "Toggle Float on Top"
msgstr "Comută menținerea deasupra"

msgid "Toggle the float on top state of the current window."
msgstr "Comută starea de menținere deasupra a ferestrei curente."

msgid "Toggle Secure Input"
msgstr "Comută intrarea securizată"

msgid "Toggle secure input mode."
msgstr "Comută modul de intrare securizată."

msgid "Toggle Mouse Reporting"
msgstr "Comută raportarea mouse-ului"

msgid "Toggle whether mouse events are reported to terminal applications."
msgstr "Comută dacă evenimentele mouse-ului sunt raportate aplicațiilor de terminal."

msgid "Toggle Background Opacity"
msgstr "Comută opacitatea fundalului"

msgid "Toggle the background opacity of a window that started transparent."
msgstr "Comută opacitatea fundalului unei ferestre care a pornit transparentă."

msgid "Check for Updates"
msgstr "Caută actualizări"

msgid "Check for updates to the application."
msgstr "Caută actualizări pentru aplicație."

msgid "Undo"
msgstr "Anulează"

msgid "Undo the last action."
msgstr "Anulează ultima acțiune."

msgid "Redo"
msgstr "Refă"

msgid "Redo the last undone action."
msgstr "Refă ultima acțiune anulată."

msgid "Quit the application."
msgstr "Ieși din aplicație."

msgid "Ghostty"
msgstr "Ghostty"

msgid "Put a little Ghostty in your terminal."
msgstr "Pune un pic de Ghostty în terminalul tău."
