msgid "Open in Ghostty"
msgstr "Ghostty ನಲ್ಲಿ ತೆರೆಯಿರಿ"

msgid "Find…"
msgstr "ಹುಡುಕಿ…"

msgid "Previous Match"
msgstr "ಹಿಂದಿನ ಹೊಂದಾಣಿಕೆ"

msgid "Next Match"
msgstr "ಮುಂದಿನ ಹೊಂದಾಣಿಕೆ"

msgid "Close"
msgstr "ಮುಚ್ಚಿ"

msgid "Oh, no."
msgstr "ಅಯ್ಯೋ."

msgid "Unable to acquire an OpenGL context for rendering."
msgstr "ರೆಂಡರಿಂಗ್‌ಗಾಗಿ OpenGL ಕಾಂಟೆಕ್ಸ್ಟ್ ಅನ್ನು ಪಡೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "This terminal is in read-only mode. You can still view, select, and scroll through the content, but no input events will be sent to the running application."
msgstr "ಈ ಟರ್ಮಿನಲ್ ಓದಲು-ಮಾತ್ರ ಮೋಡ್‌ನಲ್ಲಿದೆ. ನೀವು ಇನ್ನೂ ವಿಷಯವನ್ನು ವೀಕ್ಷಿಸಬಹುದು, ಆಯ್ಕೆ ಮಾಡಬಹುದು ಮತ್ತು ಸ್ಕ್ರಾಲ್ ಮಾಡಬಹುದು, ಆದರೆ ಚಾಲನೆಯಲ್ಲಿರುವ ಆ್ಯಪ್‌ಗೆ ಯಾವುದೇ ಇನ್‌ಪುಟ್ ಈವೆಂಟ್‌ಗಳನ್ನು ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ."

msgid "Read-only"
msgstr "ಓದಲು-ಮಾತ್ರ"

msgid "Copy"
msgstr "ನಕಲಿಸಿ"

msgid "Paste"
msgstr "ಅಂಟಿಸಿ"

msgid "Notify on Next Command Finish"
msgstr "ಮುಂದಿನ ಆಜ್ಞೆ ಮುಗಿದಾಗ ಸೂಚಿಸಿ"

msgid "Clear"
msgstr "ತೆರವುಗೊಳಿಸಿ"

msgid "Reset"
msgstr "ಮರುಹೊಂದಿಸಿ"

msgid "Split"
msgstr "ವಿಭಜಿಸಿ"

msgid "Change Title…"
msgstr "ಶೀರ್ಷಿಕೆಯನ್ನು ಬದಲಾಯಿಸಿ…"

msgid "Split Up"
msgstr "ಮೇಲಕ್ಕೆ ವಿಭಜಿಸಿ"

msgid "Split Down"
msgstr "ಕೆಳಕ್ಕೆ ವಿಭಜಿಸಿ"

msgid "Split Left"
msgstr "ಎಡಕ್ಕೆ ವಿಭಜಿಸಿ"

msgid "Split Right"
msgstr "ಬಲಕ್ಕೆ ವಿಭಜಿಸಿ"

msgid "Close Split"
msgstr "ವಿಭಜನೆಯನ್ನು ಮುಚ್ಚಿ"

msgid "Tab"
msgstr "ಟ್ಯಾಬ್"

msgid "Change Tab Title…"
msgstr "ಟ್ಯಾಬ್ ಶೀರ್ಷಿಕೆಯನ್ನು ಬದಲಾಯಿಸಿ…"

msgid "New Tab"
msgstr "ಹೊಸ ಟ್ಯಾಬ್"

msgid "Close Tab"
msgstr "ಟ್ಯಾಬ್ ಮುಚ್ಚಿ"

msgid "Window"
msgstr "ವಿಂಡೋ"

msgid "Change Window Title…"
msgstr "ವಿಂಡೋ ಶೀರ್ಷಿಕೆಯನ್ನು ಬದಲಾಯಿಸಿ…"

msgid "New Window"
msgstr "ಹೊಸ ವಿಂಡೋ"

msgid "Close Window"
msgstr "ವಿಂಡೋ ಮುಚ್ಚಿ"

msgid "Config"
msgstr "ಸಂರಚನೆ"

msgid "Open Configuration in OS Editor"
msgstr "ಸಿಸ್ಟಂ ಎಡಿಟರ್‌ನಲ್ಲಿ ಸಂರಚನೆಯನ್ನು ತೆರೆಯಿರಿ"

msgid "Open Configuration in New Window"
msgstr "ಹೊಸ ವಿಂಡೋದಲ್ಲಿ ಸಂರಚನೆಯನ್ನು ತೆರೆಯಿರಿ"

msgid "Reload Configuration"
msgstr "ಸಂರಚನೆಯನ್ನು ಮರುಲೋಡ್ ಮಾಡಿ"

msgid "⚠️ You're running a debug build of Ghostty! Performance will be degraded."
msgstr "⚠️ ನೀವು Ghostty ಯ ಡೀಬಗ್ ಬಿಲ್ಡ್ ಅನ್ನು ಚಲಾಯಿಸುತ್ತಿದ್ದೀರಿ! ಕಾರ್ಯಕ್ಷಮತೆ ಕಡಿಮೆಯಾಗುತ್ತದೆ."

msgid "Ghostty: Terminal Inspector"
msgstr "Ghostty: ಟರ್ಮಿನಲ್ ಇನ್‌ಸ್ಪೆಕ್ಟರ್"

msgid "New Split"
msgstr "ಹೊಸ ವಿಭಜನೆ"

msgid "View Open Tabs"
msgstr "ತೆರೆದ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಿ"

msgid "Main Menu"
msgstr "ಮುಖ್ಯ ಮೆನು"

msgid "Command Palette"
msgstr "ಕಮಾಂಡ್ ಪ್ಯಾಲೆಟ್"

msgid "Terminal Inspector"
msgstr "ಟರ್ಮಿನಲ್ ಇನ್‌ಸ್ಪೆಕ್ಟರ್"

msgid "About Ghostty"
msgstr "Ghostty ಕುರಿತು"

msgid "Quit"
msgstr "ನಿರ್ಗಮಿಸಿ"

msgid "Authorize Clipboard Access"
msgstr "ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಪ್ರವೇಶವನ್ನು ಅಧಿಕೃತಗೊಳಿಸಿ"

msgid "Deny"
msgstr "ನಿರಾಕರಿಸಿ"

msgid "Allow"
msgstr "ಅನುಮತಿಸಿ"

msgid "Remember choice for this split"
msgstr "ಈ ವಿಭಜನೆಗಾಗಿ ಆಯ್ಕೆಯನ್ನು ನೆನಪಿಡಿ"

msgid "Reload configuration to show this prompt again"
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಅನ್ನು ಮತ್ತೆ ತೋರಿಸಲು ಸಂರಚನೆಯನ್ನು ಮರುಲೋಡ್ ಮಾಡಿ"

msgid "Cancel"
msgstr "ರದ್ದುಗೊಳಿಸಿ"

msgid "Execute a command…"
msgstr "ಆಜ್ಞೆಯನ್ನು ಚಲಾಯಿಸಿ…"

msgid "Configuration Errors"
msgstr "ಸಂರಚನಾ ದೋಷಗಳು"

msgid "One or more configuration errors were found. Please review the errors below, and either reload your configuration or ignore these errors."
msgstr "ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ ಸಂರಚನಾ ದೋಷಗಳು ಕಂಡುಬಂದಿವೆ. ದಯವಿಟ್ಟು ಕೆಳಗಿನ ದೋಷಗಳನ್ನು ಪರಿಶೀಲಿಸಿ, ನಂತರ ನಿಮ್ಮ ಸಂರಚನೆಯನ್ನು ಮರುಲೋಡ್ ಮಾಡಿ ಅಥವಾ ಈ ದೋಷಗಳನ್ನು ನಿರ್ಲಕ್ಷಿಸಿ."

msgid "Ignore"
msgstr "ನಿರ್ಲಕ್ಷಿಸಿ"

msgid "Leave blank to restore the default title."
msgstr "ಡೀಫಾಲ್ಟ್ ಶೀರ್ಷಿಕೆಯನ್ನು ಮರುಸ್ಥಾಪಿಸಲು ಖಾಲಿ ಬಿಡಿ."

msgid "OK"
msgstr "ಸರಿ"

msgid "The keybind was revoked by the system."
msgstr "ಕೀಬೈಂಡ್ ಅನ್ನು ಸಿಸ್ಟಂ ಹಿಂತೆಗೆದುಕೊಂಡಿದೆ."

msgid "The keybind was denied by the system."
msgstr "ಕೀಬೈಂಡ್ ಅನ್ನು ಸಿಸ್ಟಂ ನಿರಾಕರಿಸಿದೆ."

msgid "Global keybind unavailable"
msgstr "ಜಾಗತಿಕ ಕೀಬೈಂಡ್ ಲಭ್ಯವಿಲ್ಲ"

msgid "Export Terminal IO Events"
msgstr "ಟರ್ಮಿನಲ್ IO ಈವೆಂಟ್‌ಗಳನ್ನು ರಫ್ತು ಮಾಡಿ"

msgid "Export"
msgstr "ರಫ್ತು ಮಾಡಿ"

msgid "Editing configuration file"
msgstr "ಸಂರಚನಾ ಫೈಲ್ ಅನ್ನು ಸಂಪಾದಿಸಲಾಗುತ್ತಿದೆ"

msgid "An application is attempting to write to the clipboard. The current clipboard contents are shown below."
msgstr "ಒಂದು ಆ್ಯಪ್ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ಬರೆಯಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಪ್ರಸ್ತುತ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ವಿಷಯಗಳನ್ನು ಕೆಳಗೆ ತೋರಿಸಲಾಗಿದೆ."

msgid "An application is attempting to read from the clipboard. The current clipboard contents are shown below."
msgstr "ಒಂದು ಆ್ಯಪ್ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ನಿಂದ ಓದಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಪ್ರಸ್ತುತ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ವಿಷಯಗಳನ್ನು ಕೆಳಗೆ ತೋರಿಸಲಾಗಿದೆ."

msgid "Warning: Potentially Unsafe Paste"
msgstr "ಎಚ್ಚರಿಕೆ: ಅಸುರಕ್ಷಿತವಾಗಿರಬಹುದಾದ ಅಂಟಿಸುವಿಕೆ"

msgid "Pasting this text into the terminal may be dangerous as it looks like some commands may be executed."
msgstr "ಈ ಪಠ್ಯವನ್ನು ಟರ್ಮಿನಲ್‌ಗೆ ಅಂಟಿಸುವುದು ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು, ಏಕೆಂದರೆ ಇದರಲ್ಲಿರುವ ಕೆಲವು ಆಜ್ಞೆಗಳು ಚಾಲನೆಯಾಗುವಂತೆ ಕಾಣುತ್ತಿದೆ."

msgid "Quit Ghostty?"
msgstr "Ghostty ನಿಂದ ನಿರ್ಗಮಿಸಬೇಕೇ?"

msgid "Close Tab?"
msgstr "ಟ್ಯಾಬ್ ಮುಚ್ಚಬೇಕೇ?"

msgid "Close Window?"
msgstr "ವಿಂಡೋ ಮುಚ್ಚಬೇಕೇ?"

msgid "Close Split?"
msgstr "ವಿಭಜನೆಯನ್ನು ಮುಚ್ಚಬೇಕೇ?"

msgid "All terminal sessions will be terminated."
msgstr "ಎಲ್ಲಾ ಟರ್ಮಿನಲ್ ಸೆಷನ್‌ಗಳನ್ನು ಕೊನೆಗೊಳಿಸಲಾಗುತ್ತದೆ."

msgid "All terminal sessions in this tab will be terminated."
msgstr "ಈ ಟ್ಯಾಬ್‌ನಲ್ಲಿರುವ ಎಲ್ಲಾ ಟರ್ಮಿನಲ್ ಸೆಷನ್‌ಗಳನ್ನು ಕೊನೆಗೊಳಿಸಲಾಗುತ್ತದೆ."

msgid "All terminal sessions in this window will be terminated."
msgstr "ಈ ವಿಂಡೋದಲ್ಲಿರುವ ಎಲ್ಲಾ ಟರ್ಮಿನಲ್ ಸೆಷನ್‌ಗಳನ್ನು ಕೊನೆಗೊಳಿಸಲಾಗುತ್ತದೆ."

msgid "The currently running process in this split will be terminated."
msgstr "ಈ ವಿಭಜನೆಯಲ್ಲಿ ಪ್ರಸ್ತುತ ಚಾಲನೆಯಲ್ಲಿರುವ ಪ್ರಕ್ರಿಯೆಯನ್ನು ಕೊನೆಗೊಳಿಸಲಾಗುತ್ತದೆ."

msgid "Command Finished"
msgstr "ಆಜ್ಞೆ ಮುಗಿದಿದೆ"

msgid "Command Succeeded"
msgstr "ಆಜ್ಞೆ ಯಶಸ್ವಿಯಾಗಿದೆ"

msgid "Command Failed"
msgstr "ಆಜ್ಞೆ ವಿಫಲವಾಗಿದೆ"

msgid "Change Terminal Title"
msgstr "ಟರ್ಮಿನಲ್ ಶೀರ್ಷಿಕೆಯನ್ನು ಬದಲಾಯಿಸಿ"

msgid "Change Tab Title"
msgstr "ಟ್ಯಾಬ್ ಶೀರ್ಷಿಕೆಯನ್ನು ಬದಲಾಯಿಸಿ"

msgid "Change Window Title"
msgstr "ವಿಂಡೋ ಶೀರ್ಷಿಕೆಯನ್ನು ಬದಲಾಯಿಸಿ"

msgid "Reloaded the configuration"
msgstr "ಸಂರಚನೆಯನ್ನು ಮರುಲೋಡ್ ಮಾಡಲಾಗಿದೆ"

msgid "Copied to clipboard"
msgstr "ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಲಾಗಿದೆ"

msgid "Cleared clipboard"
msgstr "ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಅನ್ನು ತೆರವುಗೊಳಿಸಲಾಗಿದೆ"

msgid "Ghostty Developers"
msgstr "Ghostty ಡೆವಲಪರ್‌ಗಳು"

msgid "Reset Terminal"
msgstr "ಟರ್ಮಿನಲ್ ಅನ್ನು ಮರುಹೊಂದಿಸಿ"

msgid "Reset the terminal to a clean state."
msgstr "ಟರ್ಮಿನಲ್ ಅನ್ನು ಸ್ವಚ್ಛ ಸ್ಥಿತಿಗೆ ಮರುಹೊಂದಿಸಿ."

msgid "Copy to Clipboard"
msgstr "ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ"

msgid "Copy the selected text to the clipboard in both plain and styled formats."
msgstr "ಆಯ್ದ ಪಠ್ಯವನ್ನು ಸರಳ ಮತ್ತು ಶೈಲೀಕೃತ ಎರಡೂ ಸ್ವರೂಪಗಳಲ್ಲಿ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ."

msgid "Copy Selection as Plain Text to Clipboard"
msgstr "ಆಯ್ಕೆಯನ್ನು ಸರಳ ಪಠ್ಯವಾಗಿ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ"

msgid "Copy the selected text as plain text to the clipboard."
msgstr "ಆಯ್ದ ಪಠ್ಯವನ್ನು ಸರಳ ಪಠ್ಯವಾಗಿ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ."

msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "ಆಯ್ಕೆಯನ್ನು ANSI ಸೀಕ್ವೆನ್ಸ್‌ಗಳಾಗಿ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ"

msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr "ಆಯ್ದ ಪಠ್ಯವನ್ನು ANSI ಎಸ್ಕೇಪ್ ಸೀಕ್ವೆನ್ಸ್‌ಗಳಾಗಿ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ."

msgid "Copy Selection as HTML to Clipboard"
msgstr "ಆಯ್ಕೆಯನ್ನು HTML ಆಗಿ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ"

msgid "Copy the selected text as HTML to the clipboard."
msgstr "ಆಯ್ದ ಪಠ್ಯವನ್ನು HTML ಆಗಿ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ."

msgid "Copy URL to Clipboard"
msgstr "URL ಅನ್ನು ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ"

msgid "Copy the URL under the cursor to the clipboard."
msgstr "ಕರ್ಸರ್‌ನ ಕೆಳಗಿರುವ URL ಅನ್ನು ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ."

msgid "Copy Terminal Title to Clipboard"
msgstr "ಟರ್ಮಿನಲ್ ಶೀರ್ಷಿಕೆಯನ್ನು ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ"

msgid "Copy the terminal title to the clipboard. If the terminal title is not set this has no effect."
msgstr "ಟರ್ಮಿನಲ್ ಶೀರ್ಷಿಕೆಯನ್ನು ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಿ. ಟರ್ಮಿನಲ್ ಶೀರ್ಷಿಕೆಯನ್ನು ಹೊಂದಿಸದಿದ್ದರೆ ಇದರಿಂದ ಯಾವುದೇ ಪರಿಣಾಮವಾಗುವುದಿಲ್ಲ."

msgid "Paste from Clipboard"
msgstr "ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ನಿಂದ ಅಂಟಿಸಿ"

msgid "Paste the contents of the main clipboard."
msgstr "ಮುಖ್ಯ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ನ ವಿಷಯಗಳನ್ನು ಅಂಟಿಸಿ."

msgid "Paste from Selection"
msgstr "ಆಯ್ಕೆಯಿಂದ ಅಂಟಿಸಿ"

msgid "Paste the contents of the selection clipboard."
msgstr "ಆಯ್ಕೆಯ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ನ ವಿಷಯಗಳನ್ನು ಅಂಟಿಸಿ."

msgid "Start Search"
msgstr "ಹುಡುಕಾಟ ಪ್ರಾರಂಭಿಸಿ"

msgid "Start a search if one isn't already active."
msgstr "ಹುಡುಕಾಟವು ಈಗಾಗಲೇ ಸಕ್ರಿಯವಾಗಿಲ್ಲದಿದ್ದರೆ ಹುಡುಕಾಟವನ್ನು ಪ್ರಾರಂಭಿಸಿ."

msgid "Search Selection"
msgstr "ಆಯ್ಕೆಯನ್ನು ಹುಡುಕಿ"

msgid "Start a search for the current text selection."
msgstr "ಪ್ರಸ್ತುತ ಪಠ್ಯ ಆಯ್ಕೆಗಾಗಿ ಹುಡುಕಾಟವನ್ನು ಪ್ರಾರಂಭಿಸಿ."

msgid "End Search"
msgstr "ಹುಡುಕಾಟ ಮುಗಿಸಿ"

msgid "End the current search if any and hide any GUI elements."
msgstr "ಪ್ರಸ್ತುತ ಹುಡುಕಾಟವನ್ನು (ಇದ್ದರೆ) ಮುಗಿಸಿ ಮತ್ತು ಯಾವುದೇ GUI ಅಂಶಗಳನ್ನು ಮರೆಮಾಡಿ."

msgid "Next Search Result"
msgstr "ಮುಂದಿನ ಹುಡುಕಾಟ ಫಲಿತಾಂಶ"

msgid "Navigate to the next search result, if any."
