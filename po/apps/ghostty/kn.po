msgstr "ಟರ್ಮಿನಲ್ ಅನ್ನು ಮೇಲಕ್ಕೆ ವಿಭಜಿಸಿ."

msgid "Split the terminal down."
msgstr "ಟರ್ಮಿನಲ್ ಅನ್ನು ಕೆಳಕ್ಕೆ ವಿಭಜಿಸಿ."

msgid "Focus Split: Previous"
msgstr "ವಿಭಜನೆಗೆ ಫೋಕಸ್: ಹಿಂದಿನದು"

msgid "Focus the previous split, if any."
msgstr "ಹಿಂದಿನ ವಿಭಜನೆಗೆ (ಇದ್ದರೆ) ಫೋಕಸ್ ಮಾಡಿ."

msgid "Focus Split: Next"
msgstr "ವಿಭಜನೆಗೆ ಫೋಕಸ್: ಮುಂದಿನದು"

msgid "Focus the next split, if any."
msgstr "ಮುಂದಿನ ವಿಭಜನೆಗೆ (ಇದ್ದರೆ) ಫೋಕಸ್ ಮಾಡಿ."

msgid "Focus Split: Left"
msgstr "ವಿಭಜನೆಗೆ ಫೋಕಸ್: ಎಡ"

msgid "Focus the split to the left, if it exists."
msgstr "ಎಡಭಾಗದಲ್ಲಿರುವ ವಿಭಜನೆಗೆ (ಇದ್ದರೆ) ಫೋಕಸ್ ಮಾಡಿ."

msgid "Focus Split: Right"
msgstr "ವಿಭಜನೆಗೆ ಫೋಕಸ್: ಬಲ"

msgid "Focus the split to the right, if it exists."
msgstr "ಬಲಭಾಗದಲ್ಲಿರುವ ವಿಭಜನೆಗೆ (ಇದ್ದರೆ) ಫೋಕಸ್ ಮಾಡಿ."

msgid "Focus Split: Up"
msgstr "ವಿಭಜನೆಗೆ ಫೋಕಸ್: ಮೇಲೆ"

msgid "Focus the split above, if it exists."
msgstr "ಮೇಲಿರುವ ವಿಭಜನೆಗೆ (ಇದ್ದರೆ) ಫೋಕಸ್ ಮಾಡಿ."

msgid "Focus Split: Down"
msgstr "ವಿಭಜನೆಗೆ ಫೋಕಸ್: ಕೆಳಗೆ"

msgid "Focus the split below, if it exists."
msgstr "ಕೆಳಗಿರುವ ವಿಭಜನೆಗೆ (ಇದ್ದರೆ) ಫೋಕಸ್ ಮಾಡಿ."

msgid "Focus Window: Previous"
msgstr "ವಿಂಡೋಗೆ ಫೋಕಸ್: ಹಿಂದಿನದು"

msgid "Focus the previous window, if any."
msgstr "ಹಿಂದಿನ ವಿಂಡೋಗೆ (ಇದ್ದರೆ) ಫೋಕಸ್ ಮಾಡಿ."

msgid "Focus Window: Next"
msgstr "ವಿಂಡೋಗೆ ಫೋಕಸ್: ಮುಂದಿನದು"

msgid "Focus the next window, if any."
msgstr "ಮುಂದಿನ ವಿಂಡೋಗೆ (ಇದ್ದರೆ) ಫೋಕಸ್ ಮಾಡಿ."

msgid "Toggle Split Zoom"
msgstr "ವಿಭಜನೆಯ ಜೂಮ್ ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle the zoom state of the current split."
msgstr "ಪ್ರಸ್ತುತ ವಿಭಜನೆಯ ಜೂಮ್ ಸ್ಥಿತಿಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Toggle Read-Only Mode"
msgstr "ಓದಲು-ಮಾತ್ರ ಮೋಡ್ ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle read-only mode for the current surface."
msgstr "ಪ್ರಸ್ತುತ ಸರ್ಫೇಸ್‌ಗಾಗಿ ಓದಲು-ಮಾತ್ರ ಮೋಡ್ ಅನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Equalize Splits"
msgstr "ವಿಭಜನೆಗಳನ್ನು ಸಮಗೊಳಿಸಿ"

msgid "Equalize the size of all splits."
msgstr "ಎಲ್ಲಾ ವಿಭಜನೆಗಳ ಗಾತ್ರವನ್ನು ಸಮಗೊಳಿಸಿ."

msgid "Reset Window Size"
msgstr "ವಿಂಡೋ ಗಾತ್ರವನ್ನು ಮರುಹೊಂದಿಸಿ"

msgid "Reset the window size to the default."
msgstr "ವಿಂಡೋ ಗಾತ್ರವನ್ನು ಡೀಫಾಲ್ಟ್‌ಗೆ ಮರುಹೊಂದಿಸಿ."

msgid "Toggle Inspector"
msgstr "ಇನ್‌ಸ್ಪೆಕ್ಟರ್ ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle the inspector."
msgstr "ಇನ್‌ಸ್ಪೆಕ್ಟರ್ ಅನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Show the GTK Inspector"
msgstr "GTK ಇನ್‌ಸ್ಪೆಕ್ಟರ್ ತೋರಿಸಿ"

msgid "Show the GTK inspector."
msgstr "GTK ಇನ್‌ಸ್ಪೆಕ್ಟರ್ ಅನ್ನು ತೋರಿಸಿ."

msgid "Show On-Screen Keyboard"
msgstr "ಆನ್-ಸ್ಕ್ರೀನ್ ಕೀಬೋರ್ಡ್ ತೋರಿಸಿ"

msgid "Show the on-screen keyboard if present."
msgstr "ಆನ್-ಸ್ಕ್ರೀನ್ ಕೀಬೋರ್ಡ್ ಇದ್ದರೆ ಅದನ್ನು ತೋರಿಸಿ."

msgid "Open Config Using OS editor"
msgstr "ಸಿಸ್ಟಂ ಎಡಿಟರ್ ಬಳಸಿ ಸಂರಚನೆಯನ್ನು ತೆರೆಯಿರಿ"

msgid "Open the config file with the OS's default editor."
msgstr "ಸಂರಚನಾ ಫೈಲ್ ಅನ್ನು ಸಿಸ್ಟಂನ ಡೀಫಾಲ್ಟ್ ಎಡಿಟರ್‌ನಲ್ಲಿ ತೆರೆಯಿರಿ."

msgid "Open Config in New Terminal Window"
msgstr "ಹೊಸ ಟರ್ಮಿನಲ್ ವಿಂಡೋದಲ್ಲಿ ಸಂರಚನೆಯನ್ನು ತೆರೆಯಿರಿ"

msgid "Open the config file in a new window using $EDITOR or $VISUAL."
msgstr "$EDITOR ಅಥವಾ $VISUAL ಬಳಸಿ ಸಂರಚನಾ ಫೈಲ್ ಅನ್ನು ಹೊಸ ವಿಂಡೋದಲ್ಲಿ ತೆರೆಯಿರಿ."

msgid "Reload Config"
msgstr "ಸಂರಚನೆಯನ್ನು ಮರುಲೋಡ್ ಮಾಡಿ"

msgid "Reload the config file."
msgstr "ಸಂರಚನಾ ಫೈಲ್ ಅನ್ನು ಮರುಲೋಡ್ ಮಾಡಿ."

msgid "Close Terminal"
msgstr "ಟರ್ಮಿನಲ್ ಮುಚ್ಚಿ"

msgid "Close the current terminal."
msgstr "ಪ್ರಸ್ತುತ ಟರ್ಮಿನಲ್ ಅನ್ನು ಮುಚ್ಚಿ."

msgid "Close the current tab."
msgstr "ಪ್ರಸ್ತುತ ಟ್ಯಾಬ್ ಅನ್ನು ಮುಚ್ಚಿ."

msgid "Close Other Tabs"
msgstr "ಇತರ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮುಚ್ಚಿ"

msgid "Close all tabs in this window except the current one."
msgstr "ಪ್ರಸ್ತುತ ಟ್ಯಾಬ್ ಹೊರತುಪಡಿಸಿ ಈ ವಿಂಡೋದ ಎಲ್ಲಾ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮುಚ್ಚಿ."

msgid "Close Tabs to the Right"
msgstr "ಬಲಭಾಗದ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮುಚ್ಚಿ"

msgid "Close all tabs to the right of the current one."
msgstr "ಪ್ರಸ್ತುತ ಟ್ಯಾಬ್‌ನ ಬಲಭಾಗದಲ್ಲಿರುವ ಎಲ್ಲಾ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮುಚ್ಚಿ."

msgid "Close the current window."
msgstr "ಪ್ರಸ್ತುತ ವಿಂಡೋವನ್ನು ಮುಚ್ಚಿ."

msgid "Close All Windows"
msgstr "ಎಲ್ಲಾ ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚಿ"

msgid "Close all windows."
msgstr "ಎಲ್ಲಾ ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚಿ."

msgid "Toggle Maximize"
msgstr "ಗರಿಷ್ಠಗೊಳಿಸುವಿಕೆಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle the maximized state of the current window."
msgstr "ಪ್ರಸ್ತುತ ವಿಂಡೋದ ಗರಿಷ್ಠಗೊಳಿಸಿದ ಸ್ಥಿತಿಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Toggle Fullscreen"
msgstr "ಪೂರ್ಣಪರದೆಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle the fullscreen state of the current window."
msgstr "ಪ್ರಸ್ತುತ ವಿಂಡೋದ ಪೂರ್ಣಪರದೆ ಸ್ಥಿತಿಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Toggle Window Decorations"
msgstr "ವಿಂಡೋ ಅಲಂಕಾರಗಳನ್ನು ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle the window decorations."
msgstr "ವಿಂಡೋ ಅಲಂಕಾರಗಳನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Toggle Float on Top"
msgstr "ಮೇಲೆ ತೇಲುವಿಕೆಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle the float on top state of the current window."
msgstr "ಪ್ರಸ್ತುತ ವಿಂಡೋದ ಮೇಲೆ ತೇಲುವ ಸ್ಥಿತಿಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Toggle Secure Input"
msgstr "ಸುರಕ್ಷಿತ ಇನ್‌ಪುಟ್ ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle secure input mode."
msgstr "ಸುರಕ್ಷಿತ ಇನ್‌ಪುಟ್ ಮೋಡ್ ಅನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Toggle Mouse Reporting"
msgstr "ಮೌಸ್ ವರದಿ ಮಾಡುವಿಕೆಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle whether mouse events are reported to terminal applications."
msgstr "ಮೌಸ್ ಈವೆಂಟ್‌ಗಳನ್ನು ಟರ್ಮಿನಲ್ ಆ್ಯಪ್‌ಗಳಿಗೆ ವರದಿ ಮಾಡಬೇಕೇ ಎಂಬುದನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Toggle Background Opacity"
msgstr "ಹಿನ್ನೆಲೆ ಅಪಾರದರ್ಶಕತೆಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ"

msgid "Toggle the background opacity of a window that started transparent."
msgstr "ಪಾರದರ್ಶಕವಾಗಿ ಪ್ರಾರಂಭವಾದ ವಿಂಡೋದ ಹಿನ್ನೆಲೆ ಅಪಾರದರ್ಶಕತೆಯನ್ನು ಟಾಗಲ್ ಮಾಡಿ."

msgid "Check for Updates"
msgstr "ಅಪ್‌ಡೇಟ್‌ಗಳಿಗಾಗಿ ಪರಿಶೀಲಿಸಿ"

msgid "Check for updates to the application."
msgstr "ಆ್ಯಪ್‌ನ ಅಪ್‌ಡೇಟ್‌ಗಳಿಗಾಗಿ ಪರಿಶೀಲಿಸಿ."

msgid "Undo"
msgstr "ರದ್ದುಮಾಡಿ"

msgid "Undo the last action."
msgstr "ಕೊನೆಯ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಮಾಡಿ."

msgid "Redo"
msgstr "ಮತ್ತೆ ಮಾಡಿ"

msgid "Redo the last undone action."
msgstr "ಕೊನೆಯ ರದ್ದುಮಾಡಿದ ಕ್ರಿಯೆಯನ್ನು ಮತ್ತೆ ಮಾಡಿ."

msgid "Quit the application."
msgstr "ಆ್ಯಪ್‌ನಿಂದ ನಿರ್ಗಮಿಸಿ."

msgid "Ghostty"
msgstr "Ghostty"

msgid "Put a little Ghostty in your terminal."
msgstr "ನಿಮ್ಮ ಟರ್ಮಿನಲ್‌ನಲ್ಲಿ ಸ್ವಲ್ಪ Ghostty ಇರಿಸಿ."
