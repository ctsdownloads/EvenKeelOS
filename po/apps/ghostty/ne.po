msgstr "हालको ट्याबलाई दायाँतिर सार्नुहोस्।"

msgid "Move Tab to New Window"
msgstr "ट्याबलाई नयाँ विन्डोमा सार्नुहोस्"

msgid "Move the current tab to a new window."
msgstr "हालको ट्याबलाई नयाँ विन्डोमा सार्नुहोस्।"

msgid "Toggle Tab Overview"
msgstr "ट्याब अवलोकन टगल गर्नुहोस्"

msgid "Toggle the tab overview."
msgstr "ट्याब अवलोकन टगल गर्नुहोस्।"

msgid "Change Terminal Title…"
msgstr "टर्मिनलको शीर्षक परिवर्तन गर्नुहोस्…"

msgid "Prompt for a new title for the current terminal."
msgstr "हालको टर्मिनलका लागि नयाँ शीर्षक सोध्नुहोस्।"

msgid "Prompt for a new title for the current tab."
msgstr "हालको ट्याबका लागि नयाँ शीर्षक सोध्नुहोस्।"

msgid "Split the terminal to the left."
