msgstr "अपडेटहरू जाँच गर्नुहोस्"

msgid "Check for updates to the application."
msgstr "एप्लिकेसनका लागि अपडेटहरू जाँच गर्नुहोस्।"

msgid "Undo"
msgstr "पूर्ववत गर्नुहोस्"

msgid "Undo the last action."
msgstr "पछिल्लो कार्य पूर्ववत गर्नुहोस्।"

msgid "Redo"
msgstr "पुनः गर्नुहोस्"

