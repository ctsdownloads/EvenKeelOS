msgid "Open a new window."
msgstr "नयाँ विन्डो खोल्नुहोस्।"

msgid "Open a new tab."
msgstr "नयाँ ट्याब खोल्नुहोस्।"

msgid "Move Tab Left"
msgstr "ट्याबलाई बायाँ सार्नुहोस्"

