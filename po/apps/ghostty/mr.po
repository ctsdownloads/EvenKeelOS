msgstr "निवडलेला मजकूर ANSI एस्केप सिक्वेन्सेस म्हणून तात्पुरत्या फाइलमध्ये कॉपी करा आणि पाथ क्लिपबोर्डवर कॉपी करा."

msgid "Copy Selection as ANSI Sequences to Temporary File and Paste Path"
msgstr "निवड ANSI सिक्वेन्सेस म्हणून तात्पुरत्या फाइलमध्ये कॉपी करा आणि पाथ पेस्ट करा"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and paste the path to the file."
msgstr "निवडलेला मजकूर ANSI एस्केप सिक्वेन्सेस म्हणून तात्पुरत्या फाइलमध्ये कॉपी करा आणि फाइलचा पाथ पेस्ट करा."

msgid "Copy Selection as ANSI Sequences to Temporary File and Open"
msgstr "निवड ANSI सिक्वेन्सेस म्हणून तात्पुरत्या फाइलमध्ये कॉपी करा आणि उघडा"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and open it."
msgstr "निवडलेला मजकूर ANSI एस्केप सिक्वेन्सेस म्हणून तात्पुरत्या फाइलमध्ये कॉपी करा आणि ती उघडा."

msgid "Open a new window."
msgstr "नवीन विंडो उघडा."

msgid "Open a new tab."
msgstr "नवीन टॅब उघडा."

msgid "Move Tab Left"
msgstr "टॅब डावीकडे हलवा"

msgid "Move the current tab to the left."
msgstr "सध्याचा टॅब डावीकडे हलवा."

msgid "Move Tab Right"
msgstr "टॅब उजवीकडे हलवा"

msgid "Move the current tab to the right."
msgstr "सध्याचा टॅब उजवीकडे हलवा."

msgid "Move Tab to New Window"
msgstr "टॅब नवीन विंडोमध्ये हलवा"

msgid "Move the current tab to a new window."
msgstr "सध्याचा टॅब नवीन विंडोमध्ये हलवा."

msgid "Toggle Tab Overview"
msgstr "टॅब विहंगावलोकन टॉगल करा"

msgid "Toggle the tab overview."
msgstr "टॅब विहंगावलोकन टॉगल करा."

msgid "Change Terminal Title…"
msgstr "टर्मिनलचे शीर्षक बदला…"

msgid "Prompt for a new title for the current terminal."
msgstr "सध्याच्या टर्मिनलसाठी नवीन शीर्षक विचारा."

msgid "Prompt for a new title for the current tab."
msgstr "सध्याच्या टॅबसाठी नवीन शीर्षक विचारा."

msgid "Split the terminal to the left."
msgstr "टर्मिनल डावीकडे विभाजित करा."

msgid "Split the terminal to the right."
msgstr "टर्मिनल उजवीकडे विभाजित करा."

msgid "Split the terminal up."
msgstr "टर्मिनल वर विभाजित करा."

msgid "Split the terminal down."
msgstr "टर्मिनल खाली विभाजित करा."

msgid "Focus Split: Previous"
msgstr "विभाजनावर फोकस: मागील"

msgid "Focus the previous split, if any."
msgstr "मागील विभाजनावर फोकस करा, असल्यास."

msgid "Focus Split: Next"
msgstr "विभाजनावर फोकस: पुढील"

msgid "Focus the next split, if any."
msgstr "पुढील विभाजनावर फोकस करा, असल्यास."

msgid "Focus Split: Left"
msgstr "विभाजनावर फोकस: डावीकडील"

msgid "Focus the split to the left, if it exists."
msgstr "डावीकडील विभाजनावर फोकस करा, असल्यास."

msgid "Focus Split: Right"
msgstr "विभाजनावर फोकस: उजवीकडील"

msgid "Focus the split to the right, if it exists."
msgstr "उजवीकडील विभाजनावर फोकस करा, असल्यास."

msgid "Focus Split: Up"
msgstr "विभाजनावर फोकस: वरील"

msgid "Focus the split above, if it exists."
msgstr "वरील विभाजनावर फोकस करा, असल्यास."

msgid "Focus Split: Down"
msgstr "विभाजनावर फोकस: खालील"

msgid "Focus the split below, if it exists."
msgstr "खालील विभाजनावर फोकस करा, असल्यास."

msgid "Focus Window: Previous"
msgstr "विंडोवर फोकस: मागील"

msgid "Focus the previous window, if any."
msgstr "मागील विंडोवर फोकस करा, असल्यास."

msgid "Focus Window: Next"
msgstr "विंडोवर फोकस: पुढील"

msgid "Focus the next window, if any."
msgstr "पुढील विंडोवर फोकस करा, असल्यास."

msgid "Toggle Split Zoom"
msgstr "विभाजन झूम टॉगल करा"

msgid "Toggle the zoom state of the current split."
msgstr "सध्याच्या विभाजनाची झूम स्थिती टॉगल करा."

msgid "Toggle Read-Only Mode"
msgstr "केवळ-वाचन मोड टॉगल करा"

msgid "Toggle read-only mode for the current surface."
msgstr "सध्याच्या सरफेससाठी केवळ-वाचन मोड टॉगल करा."

msgid "Equalize Splits"
msgstr "विभाजने समान करा"

msgid "Equalize the size of all splits."
msgstr "सर्व विभाजनांचा आकार समान करा."

msgid "Reset Window Size"
msgstr "विंडोचा आकार रीसेट करा"

msgid "Reset the window size to the default."
msgstr "विंडोचा आकार डिफॉल्टवर रीसेट करा."

msgid "Toggle Inspector"
msgstr "इन्स्पेक्टर टॉगल करा"

msgid "Toggle the inspector."
msgstr "इन्स्पेक्टर टॉगल करा."

msgid "Show the GTK Inspector"
msgstr "GTK इन्स्पेक्टर दाखवा"

msgid "Show the GTK inspector."
msgstr "GTK इन्स्पेक्टर दाखवा."

msgid "Show On-Screen Keyboard"
msgstr "ऑन-स्क्रीन कीबोर्ड दाखवा"

msgid "Show the on-screen keyboard if present."
msgstr "ऑन-स्क्रीन कीबोर्ड असल्यास तो दाखवा."

msgid "Open Config Using OS editor"
msgstr "कॉन्फिग OS एडिटर वापरून उघडा"

msgid "Open the config file with the OS's default editor."
msgstr "कॉन्फिग फाइल OS च्या डिफॉल्ट एडिटरमध्ये उघडा."

msgid "Open Config in New Terminal Window"
msgstr "कॉन्फिग नवीन टर्मिनल विंडोमध्ये उघडा"

msgid "Open the config file in a new window using $EDITOR or $VISUAL."
msgstr "$EDITOR किंवा $VISUAL वापरून कॉन्फिग फाइल नवीन विंडोमध्ये उघडा."

msgid "Reload Config"
msgstr "कॉन्फिग पुन्हा लोड करा"

msgid "Reload the config file."
msgstr "कॉन्फिग फाइल पुन्हा लोड करा."

msgid "Close Terminal"
msgstr "टर्मिनल बंद करा"

msgid "Close the current terminal."
msgstr "सध्याचे टर्मिनल बंद करा."

msgid "Close the current tab."
msgstr "सध्याचा टॅब बंद करा."

msgid "Close Other Tabs"
msgstr "इतर टॅब बंद करा"

msgid "Close all tabs in this window except the current one."
msgstr "सध्याचा टॅब वगळता या विंडोमधील सर्व टॅब बंद करा."

msgid "Close Tabs to the Right"
msgstr "उजवीकडील टॅब बंद करा"

msgid "Close all tabs to the right of the current one."
msgstr "सध्याच्या टॅबच्या उजवीकडील सर्व टॅब बंद करा."

msgid "Close the current window."
msgstr "सध्याची विंडो बंद करा."

msgid "Close All Windows"
msgstr "सर्व विंडो बंद करा"

msgid "Close all windows."
msgstr "सर्व विंडो बंद करा."

msgid "Toggle Maximize"
msgstr "मोठे करणे टॉगल करा"

msgid "Toggle the maximized state of the current window."
msgstr "सध्याच्या विंडोची मोठी केलेली स्थिती टॉगल करा."

msgid "Toggle Fullscreen"
msgstr "पूर्ण स्क्रीन टॉगल करा"

msgid "Toggle the fullscreen state of the current window."
msgstr "सध्याच्या विंडोची पूर्ण स्क्रीन स्थिती टॉगल करा."

msgid "Toggle Window Decorations"
msgstr "विंडो सजावट टॉगल करा"

msgid "Toggle the window decorations."
msgstr "विंडो सजावट टॉगल करा."

msgid "Toggle Float on Top"
msgstr "नेहमी वर ठेवणे टॉगल करा"

msgid "Toggle the float on top state of the current window."
msgstr "सध्याच्या विंडोची नेहमी वर ठेवण्याची स्थिती टॉगल करा."

msgid "Toggle Secure Input"
msgstr "सुरक्षित इनपुट टॉगल करा"

msgid "Toggle secure input mode."
msgstr "सुरक्षित इनपुट मोड टॉगल करा."

msgid "Toggle Mouse Reporting"
msgstr "माउस रिपोर्टिंग टॉगल करा"

msgid "Toggle whether mouse events are reported to terminal applications."
msgstr "माउस इव्हेंट टर्मिनल ॲप्लिकेशन्सना कळवले जावेत की नाही ते टॉगल करा."

msgid "Toggle Background Opacity"
msgstr "पार्श्वभूमीची अपारदर्शकता टॉगल करा"

msgid "Toggle the background opacity of a window that started transparent."
msgstr "पारदर्शक म्हणून सुरू झालेल्या विंडोची पार्श्वभूमी अपारदर्शकता टॉगल करा."

msgid "Check for Updates"
msgstr "अपडेट्स तपासा"

msgid "Check for updates to the application."
msgstr "ॲप्लिकेशनसाठी अपडेट्स तपासा."

msgid "Undo"
msgstr "पूर्ववत करा"

msgid "Undo the last action."
msgstr "शेवटची क्रिया पूर्ववत करा."

msgid "Redo"
msgstr "पुन्हा करा"

msgid "Redo the last undone action."
msgstr "पूर्ववत केलेली शेवटची क्रिया पुन्हा करा."

msgid "Quit the application."
msgstr "ॲप्लिकेशनमधून बाहेर पडा."

msgid "Ghostty"
msgstr "Ghostty"

msgid "Put a little Ghostty in your terminal."
msgstr "तुमच्या टर्मिनलमध्ये थोडेसे Ghostty ठेवा."
