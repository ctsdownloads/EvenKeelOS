msgstr "Copia o conteúdo do ecrã para um ficheiro temporário e cola o caminho do ficheiro."

msgid "Copy Screen to Temporary File and Open"
msgstr "Copiar ecrã para ficheiro temporário e abrir"

msgid "Copy the screen contents to a temporary file and open it."
msgstr "Copia o conteúdo do ecrã para um ficheiro temporário e abre-o."

msgid "Copy Screen as HTML to Temporary File and Copy Path"
msgstr "Copiar ecrã como HTML para ficheiro temporário e copiar caminho"

msgid "Copy the screen contents as HTML to a temporary file and copy the path to the clipboard."
msgstr "Copia o conteúdo do ecrã como HTML para um ficheiro temporário e copia o caminho para a área de transferência."

msgid "Copy Screen as HTML to Temporary File and Paste Path"
msgstr "Copiar ecrã como HTML para ficheiro temporário e colar caminho"

msgid "Copy the screen contents as HTML to a temporary file and paste the path to the file."
msgstr "Copia o conteúdo do ecrã como HTML para um ficheiro temporário e cola o caminho do ficheiro."

msgid "Copy Screen as HTML to Temporary File and Open"
msgstr "Copiar ecrã como HTML para ficheiro temporário e abrir"

msgid "Copy the screen contents as HTML to a temporary file and open it."
msgstr "Copia o conteúdo do ecrã como HTML para um ficheiro temporário e abre-o."

msgid "Copy Screen as ANSI Sequences to Temporary File and Copy Path"
msgstr "Copiar ecrã como sequências ANSI para ficheiro temporário e copiar caminho"

msgid "Copy the screen contents as ANSI escape sequences to a temporary file and copy the path to the clipboard."
msgstr "Copia o conteúdo do ecrã como sequências de escape ANSI para um ficheiro temporário e copia o caminho para a área de transferência."

msgid "Copy Screen as ANSI Sequences to Temporary File and Paste Path"
msgstr "Copiar ecrã como sequências ANSI para ficheiro temporário e colar caminho"

msgid "Copy the screen contents as ANSI escape sequences to a temporary file and paste the path to the file."
msgstr "Copia o conteúdo do ecrã como sequências de escape ANSI para um ficheiro temporário e cola o caminho do ficheiro."

msgid "Copy Screen as ANSI Sequences to Temporary File and Open"
msgstr "Copiar ecrã como sequências ANSI para ficheiro temporário e abrir"

msgid "Copy the screen contents as ANSI escape sequences to a temporary file and open it."
msgstr "Copia o conteúdo do ecrã como sequências de escape ANSI para um ficheiro temporário e abre-o."

msgid "Copy Selection to Temporary File and Copy Path"
msgstr "Copiar seleção para ficheiro temporário e copiar caminho"

msgid "Copy the selection contents to a temporary file and copy the path to the clipboard."
msgstr "Copia o conteúdo da seleção para um ficheiro temporário e copia o caminho para a área de transferência."

msgid "Copy Selection to Temporary File and Paste Path"
msgstr "Copiar seleção para ficheiro temporário e colar caminho"

msgid "Copy the selection contents to a temporary file and paste the path to the file."
msgstr "Copia o conteúdo da seleção para um ficheiro temporário e cola o caminho do ficheiro."

msgid "Copy Selection to Temporary File and Open"
msgstr "Copiar seleção para ficheiro temporário e abrir"

msgid "Copy the selection contents to a temporary file and open it."
msgstr "Copia o conteúdo da seleção para um ficheiro temporário e abre-o."

msgid "Copy Selection as HTML to Temporary File and Copy Path"
msgstr "Copiar seleção como HTML para ficheiro temporário e copiar caminho"

msgid "Copy the selection contents as HTML to a temporary file and copy the path to the clipboard."
msgstr "Copia o conteúdo da seleção como HTML para um ficheiro temporário e copia o caminho para a área de transferência."

msgid "Copy Selection as HTML to Temporary File and Paste Path"
msgstr "Copiar seleção como HTML para ficheiro temporário e colar caminho"

msgid "Copy the selection contents as HTML to a temporary file and paste the path to the file."
msgstr "Copia o conteúdo da seleção como HTML para um ficheiro temporário e cola o caminho do ficheiro."

msgid "Copy Selection as HTML to Temporary File and Open"
msgstr "Copiar seleção como HTML para ficheiro temporário e abrir"

msgid "Copy the selection contents as HTML to a temporary file and open it."
msgstr "Copia o conteúdo da seleção como HTML para um ficheiro temporário e abre-o."

msgid "Copy Selection as ANSI Sequences to Temporary File and Copy Path"
msgstr "Copiar seleção como sequências ANSI para ficheiro temporário e copiar caminho"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and copy the path to the clipboard."
msgstr "Copia o conteúdo da seleção como sequências de escape ANSI para um ficheiro temporário e copia o caminho para a área de transferência."

msgid "Copy Selection as ANSI Sequences to Temporary File and Paste Path"
msgstr "Copiar seleção como sequências ANSI para ficheiro temporário e colar caminho"

msgid "Copy the selection contents as ANSI escape sequences to a temporary file and paste the path to the file."
msgstr "Copia o conteúdo da seleção como sequências de escape ANSI para um ficheiro temporário e cola o caminho do ficheiro."

