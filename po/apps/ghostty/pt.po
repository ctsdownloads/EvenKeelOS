msgid "Reset Terminal"
msgstr "Repor terminal"

msgid "Reset the terminal to a clean state."
msgstr "Repõe o terminal num estado limpo."

msgid "Copy to Clipboard"
msgstr "Copiar para a área de transferência"

msgid "Copy the selected text to the clipboard in both plain and styled formats."
msgstr "Copia o texto selecionado para a área de transferência nos formatos simples e com estilo."

msgid "Copy Selection as Plain Text to Clipboard"
msgstr "Copiar seleção como texto simples para a área de transferência"

msgid "Copy the selected text as plain text to the clipboard."
msgstr "Copia o texto selecionado como texto simples para a área de transferência."

msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "Copiar seleção como sequências ANSI para a área de transferência"

msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr "Copia o texto selecionado como sequências de escape ANSI para a área de transferência."

msgid "Copy Selection as HTML to Clipboard"
msgstr "Copiar seleção como HTML para a área de transferência"

msgid "Copy the selected text as HTML to the clipboard."
msgstr "Copia o texto selecionado como HTML para a área de transferência."

msgid "Copy URL to Clipboard"
msgstr "Copiar URL para a área de transferência"

msgid "Copy the URL under the cursor to the clipboard."
msgstr "Copia o URL sob o cursor para a área de transferência."

msgid "Copy Terminal Title to Clipboard"
msgstr "Copiar título do terminal para a área de transferência"

msgid "Copy the terminal title to the clipboard. If the terminal title is not set this has no effect."
msgstr "Copia o título do terminal para a área de transferência. Se o título do terminal não estiver definido, não tem qualquer efeito."

msgid "Paste from Clipboard"
msgstr "Colar da área de transferência"

msgid "Paste the contents of the main clipboard."
msgstr "Cola o conteúdo da área de transferência principal."

msgid "Paste from Selection"
msgstr "Colar da seleção"

msgid "Paste the contents of the selection clipboard."
msgstr "Cola o conteúdo da área de transferência da seleção."

msgid "Start Search"
msgstr "Iniciar pesquisa"

msgid "Start a search if one isn't already active."
msgstr "Inicia uma pesquisa se ainda não estiver nenhuma ativa."

msgid "Search Selection"
msgstr "Pesquisar seleção"

msgid "Start a search for the current text selection."
msgstr "Inicia uma pesquisa pela seleção de texto atual."

msgid "End Search"
msgstr "Terminar pesquisa"

msgid "End the current search if any and hide any GUI elements."
msgstr "Termina a pesquisa atual, se existir, e oculta todos os elementos da interface."

msgid "Next Search Result"
msgstr "Resultado de pesquisa seguinte"

msgid "Navigate to the next search result, if any."
msgstr "Navega para o resultado de pesquisa seguinte, se existir."

msgid "Previous Search Result"
msgstr "Resultado de pesquisa anterior"

msgid "Navigate to the previous search result, if any."
msgstr "Navega para o resultado de pesquisa anterior, se existir."

msgid "Increase Font Size"
msgstr "Aumentar tamanho do tipo de letra"

msgid "Increase the font size by 1 point."
msgstr "Aumenta o tamanho do tipo de letra em 1 ponto."

msgid "Decrease Font Size"
msgstr "Diminuir tamanho do tipo de letra"

msgid "Decrease the font size by 1 point."
msgstr "Diminui o tamanho do tipo de letra em 1 ponto."

msgid "Reset Font Size"
msgstr "Repor tamanho do tipo de letra"

msgid "Reset the font size to the default."
msgstr "Repõe o tamanho do tipo de letra para o predefinido."

msgid "Clear Screen"
msgstr "Limpar ecrã"

msgid "Clear the screen and scrollback."
msgstr "Limpa o ecrã e o histórico de deslocamento."

msgid "Select All"
msgstr "Selecionar tudo"

msgid "Select all text on the screen."
msgstr "Seleciona todo o texto no ecrã."

msgid "Scroll to Top"
msgstr "Deslocar para o topo"

msgid "Scroll to the top of the screen."
msgstr "Desloca para o topo do ecrã."

msgid "Scroll to Bottom"
msgstr "Deslocar para o fundo"

msgid "Scroll to the bottom of the screen."
msgstr "Desloca para o fundo do ecrã."

msgid "Scroll to Selection"
msgstr "Deslocar para a seleção"

msgid "Scroll to the selected text."
msgstr "Desloca para o texto selecionado."

msgid "Scroll Page Up"
msgstr "Deslocar uma página para cima"

msgid "Scroll the screen up by a page."
msgstr "Desloca o ecrã uma página para cima."

msgid "Scroll Page Down"
msgstr "Deslocar uma página para baixo"

msgid "Scroll the screen down by a page."
msgstr "Desloca o ecrã uma página para baixo."

msgid "Copy Screen to Temporary File and Copy Path"
msgstr "Copiar ecrã para ficheiro temporário e copiar caminho"

msgid "Copy the screen contents to a temporary file and copy the path to the clipboard."
msgstr "Copia o conteúdo do ecrã para um ficheiro temporário e copia o caminho para a área de transferência."

msgid "Copy Screen to Temporary File and Paste Path"
msgstr "Copiar ecrã para ficheiro temporário e colar caminho"

