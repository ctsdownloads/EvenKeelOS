msgid ""
"  codecs web   Web video in Firefox only. Replaces Fedora's empty OpenH264 stand-in with\n"
"               Cisco's OpenH264 from Fedora's Cisco repository, under Cisco's own H.264\n"
"               patent license.\n"
"  codecs full  Everything. Replaces Fedora's free ffmpeg libraries with the full ffmpeg,\n"
"               x264 and x265 from RPM Fusion, the source standard Fedora uses."
msgstr ""
"  codecs web   וידאו ברשת ב-Firefox בלבד. מחליף את תחליף ה-OpenH264 הריק של Fedora\n"
"               ב-OpenH264 של Cisco ממאגר Cisco של Fedora, תחת רישיון הפטנט של Cisco\n"
"               עצמה ל-H.264.\n"
"  codecs full  הכול. מחליף את ספריות ה-ffmpeg החופשיות של Fedora ב-ffmpeg המלא,\n"
"               ב-x264 וב-x265 מ-RPM Fusion, המקור שבו משתמשות התקנות Fedora רגילות."

msgid ""
"  evenkeel-os-packages install [FILE]   install an .rpm or .deb (no FILE: pick one from Downloads)\n"
"  evenkeel-os-packages remove           remove an app installed this way\n"
"  evenkeel-os-packages check FILE       say what a package needs, without installing anything\n"
"  evenkeel-os-packages repair           set a broken app box up again (--if-broken: only if one does not work)\n"
"  evenkeel-os-packages login            choose box apps that start when you log in\n"
"  evenkeel-os-packages windows FILE     a Windows .exe or .msi: offer a Linux app that does its job\n"
"  evenkeel-os-packages check-windows FILE  say what a Windows file is and what would be offered, without any window\n"
"  evenkeel-os-packages zoom LINK        a Zoom \"open the app\" link: open the meeting in Zoom's web version, in Chrome\n"
"  evenkeel-os-packages vpn [NAME]       add a VPN from its company's own download source (mullvad, proton, ivpn,\n"
"                                        nordvpn; no NAME: pick one)"
msgstr ""
"  evenkeel-os-packages install [FILE]   התקנת קובץ ‎.rpm או ‎.deb (בלי FILE: בחירת קובץ מתיקיית ההורדות)\n"
"  evenkeel-os-packages remove           הסרת יישום שהותקן בדרך זו\n"
"  evenkeel-os-packages check FILE       הצגת מה שחבילה צריכה, בלי להתקין דבר\n"
"  evenkeel-os-packages repair           הקמה מחדש של תיבת יישומים פגומה (--if-broken: רק אם אחת מהן לא עובדת)\n"
"  evenkeel-os-packages login            בחירת יישומי תיבה שיופעלו עם הכניסה\n"
"  evenkeel-os-packages windows FILE     קובץ ‎.exe או ‎.msi של Windows: הצעת יישום ל-Linux שעושה את אותה העבודה\n"
"  evenkeel-os-packages check-windows FILE  הצגת מהו קובץ Windows ומה יוצע עבורו, בלי לפתוח חלון\n"
"  evenkeel-os-packages zoom LINK        קישור „פתיחת היישום” של Zoom: פתיחת הפגישה בגרסת הרשת של Zoom, ב-Chrome\n"
"  evenkeel-os-packages vpn [NAME]       הוספת VPN ממקור ההורדה של החברה עצמה (mullvad, proton, ivpn,\n"
"                                        nordvpn; בלי NAME: בחירה מרשימה)"

#, python-brace-format
msgid ""
"\"{name}\" comes with Fedora. The trusted list is rebuilt from Fedora's "
"current list at every start, so an update replaces or drops it; keep "
"automatic updates on. If this alert stays after updating and restarting, tell"
" your helper."
msgstr ""
"„{name}” מגיע עם Fedora. רשימת האישורים המהימנים נבנית מחדש מהרשימה הנוכחית "
"של Fedora בכל הפעלה, כך שעדכון יחליף או יסיר אותו; כדאי להשאיר את העדכונים "
"האוטומטיים פעילים. אם ההתראה הזו נשארת גם אחרי עדכון והפעלה מחדש, יש לפנות "
"למי שעוזר לך."

#, python-brace-format
msgid ""
"\"{name}\" has expired, but its file ({file}) holds {n} certificate, and "
"removing it would remove them all, the good ones too. Tell your helper."
msgid_plural ""
"\"{name}\" has expired, but its file ({file}) holds {n} certificates, and "
"removing it would remove them all, the good ones too. Tell your helper."
msgstr[0] ""
"תוקפו של „{name}” פג, אבל הקובץ שלו ({file}) מכיל {n} אישור, והסרתו תסיר את "
"כל מה שבו, גם את האישורים התקינים. יש לפנות למי שעוזר לך."
msgstr[1] ""
"תוקפו של „{name}” פג, אבל הקובץ שלו ({file}) מכיל {n} אישורים, והסרתו תסיר את"
" כולם, גם את התקינים. יש לפנות למי שעוזר לך."

#, python-brace-format
msgid ""
"\"{name}\" has expired. It was added in a way Wheelhouse can't remove; tell "
"your helper."
msgstr ""
"תוקפו של „{name}” פג. הוא נוסף בדרך ש-Wheelhouse לא יכול להסיר; יש לפנות למי "
"שעוזר לך."

#, python-brace-format
msgid "\"{name}\" is removed and no longer trusted."
msgstr "„{name}” הוסר ואינו מהימן עוד."

#, python-brace-format
msgid ""
"\"{name}\" was added to this computer and expired on {date}. An expired "
"certificate shouldn't be relied on. Remove it if you no longer need it; if "
"you do, ask whoever gave it to you for a new one. Removing it needs your "
"password."
msgstr ""
"„{name}” נוסף למחשב הזה ותוקפו פג ב-{date}. אין לסמוך על אישור שתוקפו פג. "
"אפשר להסיר אותו אם כבר אין בו צורך; אם עדיין יש בו צורך, יש לבקש אישור חדש "
"ממי שנתן לך אותו. הסרתו דורשת את הססמה שלך."

#, python-brace-format
msgid ""
"\"{name}\" was added to this computer and expires on {date}. Ask whoever gave"
" it to you for a new one before then."
msgstr ""
"„{name}” נוסף למחשב הזה ותוקפו יפוג ב-{date}. כדאי לבקש אישור חדש ממי שנתן לך"
" אותו לפני כן."

#. Translators: a weekday and date ("Thursday, November 26"). Uses strftime codes.
msgid "%A, %B %-d"
msgstr "%A, %-d ב%B"

#. Translators: a date: month and day ("November 26"). Uses strftime codes.
msgid "%B %-d"
msgstr "%-d ב%B"

#. Translators: a date and a 12-hour time ("November 26, 7:02 PM"). Uses strftime codes.
msgid "%B %-d, %-I:%M %p"
msgstr "%-d ב%B, %-I:%M %p"

#. Translators: a date and a 24-hour time ("November 26, 19:02"). Uses strftime codes.
msgid "%B %-d, %H:%M"
msgstr "%-d ב%B, %-H:%M"

msgid "(nothing was printed)"
msgstr "(הפקודה לא הציגה פלט)"

#, python-brace-format
msgid "- and {n} more"
msgid_plural "- and {n} more"
msgstr[0] "- ועוד {n}"
msgstr[1] "- ועוד {n}"

msgid ""
"1.00 is the normal size. Large text in Settings, Accessibility sets 1.25."
msgstr "1.00 הוא הגודל הרגיל. „טקסט גדול” בהגדרות, תחת „נגישות”, קובע 1.25."

msgid "12 hour"
msgstr "12 שעות"

msgid "24 hour"
msgstr "24 שעות"

msgid ""
"A .deb driver can't be installed. The window says how to get the .rpm from "
"the maker."
msgstr ""
"לא ניתן להתקין מנהל התקן מסוג ‎.deb. החלון מסביר איך להשיג את קובץ ה-‎.rpm "
"מהיצרן."

msgid "A USB mouse works."
msgstr "עכבר USB עובד."

msgid "A USB webcam works."
msgstr "מצלמת רשת USB עובדת."

msgid "A VPN"
msgstr "VPN"

msgid "A Windows program you downloaded (.exe or .msi)"
msgstr "תכנית Windows שהורדת (‎.exe או ‎.msi)"

msgid "A background service fails"
msgstr "שירות רקע נכשל"

msgid ""
"A background service that runs on this computer fails to start (the mobile "
"broadband service, or the graphics switching service)."
msgstr ""
"שירות רקע שפועל במחשב הזה לא מצליח לעלות (שירות הפס הרחב הסלולרי או שירות "
"החלפת הגרפיקה)."

msgid "A bottom bar, with a start menu on the logo"
msgstr "סרגל תחתון, עם תפריט התחלה על הסמליל"

msgid "A broken app box"
msgstr "תיבת יישומים פגומה"

msgid "A built-in camera of the newer laptop kind was found."
msgstr "נמצאה מצלמה מובנית מהסוג של מחשבים ניידים חדשים יותר."

msgid "A café, hotel, airport, or anywhere else. Nothing gets in."
msgstr "בית קפה, מלון, שדה תעופה או כל מקום אחר. שום דבר לא נכנס."

#, python-brace-format
msgid "A certificate needs attention"
msgid_plural "{n} certificates need attention"
msgstr[0] "{n} אישור דורש תשומת לב"
msgstr[1] "{n} אישורים דורשים תשומת לב"

msgid ""
"A change to the boot options is waiting. It starts at your next restart. It isn't an update.\n"
"\n"
"If you don't want it: Don't use it. The computer starts with the boot options it has now, and automatic updates aren't paused.\n"
"\n"
"Or Keep it."
msgstr ""
"שינוי באפשרויות האתחול ממתין. הוא ייכנס לתוקף בהפעלה מחדש הבאה. זה לא עדכון.\n"
"\n"
"אם אין בו צורך: „לא להשתמש בזה”. המחשב יעלה עם אפשרויות האתחול שיש לו עכשיו, והעדכונים האוטומטיים לא יושהו.\n"
"\n"
"או „להשאיר”."

msgid "A device"
msgstr "התקן"

#, python-brace-format
msgid "A device lost its driver ({driver})"
msgstr "התקן איבד את מנהל ההתקן שלו ({driver})"

msgid "A disk is hidden."
msgstr "דיסק מוסתר."

msgid "A driver file from the maker"
msgstr "קובץ מנהל התקן מהיצרן"

msgid "A file of recent errors to email to your helper"
msgstr "קובץ של שגיאות אחרונות לשליחה בדוא״ל למי שעוזר לך"

msgid "A full name can't have : or , in it."
msgstr "שם מלא לא יכול לכלול „:” או „,”."

msgid "A graphics chip has no driver."
msgstr "לשבב גרפי אין מנהל התקן."

msgid ""
"A network is only needed for automatic time and time zone. To use Wi-Fi, "
"click a network. Or click Next to go on without it."
msgstr ""
"רשת נדרשת רק לשעה ולאזור זמן אוטומטיים. כדי להשתמש ברשת אלחוטית, יש ללחוץ על "
"רשת. אפשר גם ללחוץ על „הבא” כדי להמשיך בלעדיה."

msgid ""
"A new layout shows after you log out and back in. It changes only your own "
"desktop."
msgstr ""
"פריסה חדשה תופיע אחרי יציאה וכניסה מחדש. היא משנה רק את שולחן העבודה שלך."

msgid "A new system is ready."
msgstr "מערכת חדשה מוכנה."

msgid "A new system is ready. Restart to use it."
msgstr "מערכת חדשה מוכנה. יש להפעיל מחדש כדי להשתמש בה."

msgid ""
"A new system version is used from the next restart. Keep working, and restart"
" when it suits you."
msgstr ""
"גרסת מערכת חדשה תיכנס לשימוש מההפעלה מחדש הבאה. אפשר להמשיך לעבוד ולהפעיל "
"מחדש מתי שנוח."

msgid ""
"A new version also goes back if something that worked before is broken after "
"you log in, like sound, Wi-Fi, Bluetooth, the camera or printing. Unplugged "
"or switched-off things don't count."
msgstr ""
"גרסה חדשה מוחזרת לאחור גם אם משהו שעבד קודם מקולקל אחרי הכניסה, כמו צליל, רשת"
" אלחוטית, בלוטות', המצלמה או ההדפסה. דברים מנותקים או כבויים לא נחשבים."

msgid "A new version is ready"
msgstr "גרסה חדשה מוכנה"

msgid ""
"A note at the next login says so and names what broke, and automatic updates "
"pause for 3 days."
msgstr ""
"בכניסה הבאה תופיע הודעה שאומרת זאת ומציינת מה התקלקל, והעדכונים האוטומטיים "
"יושהו ל-3 ימים."

msgid ""
"A rollback test copy is running. Restart first, so the computer goes back to "
"the usual version."
msgstr ""
"עותק בדיקה של חזרה לאחור פועל כעת. יש להפעיל מחדש קודם, כדי שהמחשב יחזור "
"לגרסה הרגילה."

msgid "A security certificate expired, expires within 30 days, or was removed."
msgstr "תוקפו של אישור אבטחה פג, יפוג בתוך 30 יום, או שהאישור הוסר."

msgid "A slideshow of your own pictures"
msgstr "מצגת של התמונות שלך"

msgid "A sound chip was found, but it didn't start."
msgstr "נמצא שבב שמע, אבל הוא לא עלה."

msgid "A start-up check fails"
msgstr "בדיקת הפעלה נכשלת"

msgid ""
"A start-up check fails on purpose. The computer restarts by itself within "
"seconds, twice, and the third start is back on this version."
msgstr ""
"בדיקת הפעלה נכשלת בכוונה. המחשב יופעל מחדש מעצמו תוך שניות, פעמיים, ובהפעלה "
"השלישית הוא יחזור לגרסה הזו."

msgid "A system service fails"
msgstr "שירות מערכת נכשל"

msgid "A system update is also waiting for a restart."
msgstr "גם עדכון מערכת ממתין להפעלה מחדש."

msgid "A tool"
msgstr "כלי"

msgid "A top bar, with the logo menu at the top left"
msgstr "סרגל עליון, עם תפריט הסמליל בפינה השמאלית העליונה"

msgid ""
"A user name uses small letters, digits, - and _, and starts with a letter."
msgstr "שם משתמש מורכב מאותיות קטנות, ספרות, ‎- ו-_, ומתחיל באות."

msgid ""
"A wired network is set to Home, so this happens on any cable you plug in."
msgstr "רשת קווית מוגדרת כ„בית”, כך שזה קורה בכל כבל שמחברים."

msgid "A wireless chip was found, but it didn't start."
msgstr "נמצא שבב אלחוטי, אבל הוא לא עלה."

msgid "A wireless chip was found, with no driver for it."
msgstr "נמצא שבב אלחוטי, ואין לו מנהל התקן."

msgid "AMD: flicker, turn off Panel Replay"
msgstr "AMD: ריצוד, כיבוי Panel Replay"

msgid "AMD: flicker, turn off Panel Self Refresh"
msgstr "AMD: ריצוד, כיבוי Panel Self Refresh"

msgid "AMD: flicker, turn off both"
msgstr "AMD: ריצוד, כיבוי של שניהם"

msgid "AMD: screen dims or shifts colors on its own"
msgstr "AMD: המסך מתעמעם או משנה צבעים מעצמו"

msgid "AMD: white flickering"
msgstr "AMD: ריצוד לבן"

msgid ""
"About 20 seconds after the login screen shows, the computer locks up. Hold "
"the power button until it turns off, then turn it on. After the second "
"freeze, the next start is back on this version."
msgstr ""
"כ-20 שניות אחרי שמסך הכניסה מופיע, המחשב נתקע. יש להחזיק את כפתור ההפעלה עד "
"שהמחשב נכבה, ואז להדליק אותו. אחרי ההיתקעות השנייה, ההפעלה הבאה חוזרת לגרסה "
"הזו."

msgid "About it"
msgstr "אודות"

msgid "About this driver"
msgstr "אודות מנהל ההתקן הזה"

msgid "Accent color and wallpaper"
msgstr "צבע הדגשה ורקע"

msgid "Account"
msgstr "חשבון"

msgid "Add"
msgstr "הוספה"

msgid "Add a folder"
msgstr "הוספת תיקייה"

msgid "Add a folder and set the sharing password below."
msgstr "יש להוסיף תיקייה ולהגדיר את ססמת השיתוף למטה."

msgid "Add a folder from your home folder."
msgstr "אפשר להוסיף תיקייה מתוך תיקיית הבית שלך."

msgid "Add a printer"
msgstr "הוספת מדפסת"

msgid "Add a setting, like amdgpu.abmlevel=0"
msgstr "הוספת הגדרה, למשל amdgpu.abmlevel=0"

msgid "Add anyway"
msgstr "להוסיף בכל זאת"

msgid "Add it"
msgstr "הוספה"

msgid ""
"Add it only if you know you need it. If the computer then won't start, "
"automatic rollback goes back to the version before."
msgstr ""
"כדאי להוסיף אותה רק אם ידוע לך שיש בה צורך. אם המחשב לא יעלה אחר כך, החזרה "
"האוטומטית לאחור תחזור לגרסה הקודמת."

msgid "Add or remove an app's hardware rules"
msgstr "הוספה או הסרה של כללי חומרה של יישום"

msgid "Add or remove media codecs"
msgstr "הוספה או הסרה של מקודדי מדיה"

msgid "Add the media codecs"
msgstr "הוספת מקודדי המדיה"

msgid "Add to the system"
msgstr "הוספה למערכת"

msgid "Add video and audio codecs"
msgstr "הוספת מקודדי וידאו ושמע"

msgid "Add, turn on or remove a VPN or an app's background service"
msgstr "הוספה, הפעלה או הסרה של VPN או של שירות רקע של יישום"

msgid "Added by you"
msgstr "נוסף על ידך"

msgid "Added to this computer"
msgstr "נוסף למחשב הזה"

msgid "Adding a printer, and printer driver files from the maker"
msgstr "הוספת מדפסת, וקובצי מנהלי התקן מהיצרן"

msgid ""
"Adding the desktop parts apps expect (progress windows and notifications)"
msgstr "הוספת רכיבי שולחן העבודה שיישומים מצפים להם (חלונות התקדמות והתראות)"

#, python-brace-format
msgid "Adding the download source {name}"
msgstr "הוספת מקור ההורדה {name}"

#, python-brace-format
msgid "Adding {title} to the system"
msgstr "הוספת {title} למערכת"

#, python-brace-format
msgid "Adding {title} to the system from Fedora. A progress window shows it."
msgstr "מתבצעת הוספה של {title} למערכת מ-Fedora. חלון התקדמות מציג זאת."

#, python-brace-format
msgid "Adding {title} to the system from Fedora. This can take a few minutes."
msgstr "מתבצעת הוספה של {title} למערכת מ-Fedora. זה עשוי להימשך כמה דקות."

#, python-brace-format
msgid "Adding {title} to the system. A progress window shows it."
msgstr "מתבצעת הוספה של {title} למערכת. חלון התקדמות מציג זאת."

#, python-brace-format
msgid "Adding {title} to the system. This can take a few minutes."
msgstr "מתבצעת הוספה של {title} למערכת. זה עשוי להימשך כמה דקות."

msgid "Administrator"
msgstr "מנהל מערכת"

msgid "Administrator account (root)"
msgstr "חשבון מנהל המערכת (root)"

msgid "Administrator: no."
msgstr "מנהל מערכת: לא."

msgid "Administrator: yes."
msgstr "מנהל מערכת: כן."

msgid ""
"After a BIOS update, it may ask for the disk password again. Turn it on again"
" here."
msgstr ""
"אחרי עדכון BIOS, ייתכן שתופיע שוב בקשה לססמת הדיסק. אפשר להפעיל זאת שוב כאן."

msgid ""
"After an undo, so the same update doesn't come straight back. They turn back "
"on by themselves."
msgstr "אחרי ביטול, כדי שאותו עדכון לא יחזור מיד. הם יחזרו לפעול מעצמם."

msgid "After the restart, you will be asked to add your printer."
msgstr "אחרי ההפעלה מחדש, תופיע בקשה להוסיף את המדפסת שלך."

msgid ""
"After the restart, you'll be asked for your password once, to turn it on."
msgstr ""
"אחרי ההפעלה מחדש, תופיע בקשה להזין את הססמה שלך פעם אחת, כדי להפעיל זאת."

msgid "After the restart, you'll get a message when it's ready."
msgstr "אחרי ההפעלה מחדש, תופיע הודעה כשזה יהיה מוכן."

msgid "Alpha"
msgstr "אלפא"

msgid "Also let in, on Home"
msgstr "מתן גישה גם ברשת בית"

msgid ""
"Alt+Tab switches between apps. Alt and the key above Tab switches between "
"windows of the same app."
msgstr ""
"Alt+Tab עובר בין יישומים. Alt עם המקש שמעל Tab עובר בין חלונות של אותו יישום."

msgid ""
"An .rpm or .deb installs the app. An .exe or .msi gets its Linux version."
msgstr ""
"קובץ ‎.rpm או ‎.deb מתקין את היישום. עבור קובץ ‎.exe או ‎.msi מוצעת גרסת "
"ה-Linux שלו."

msgid "An app that comes as a .rpm or .deb file"
msgstr "יישום שמגיע כקובץ ‎.rpm או ‎.deb"

msgid "An office. Nothing gets in, and your folders aren't shared."
msgstr "משרד. שום דבר לא נכנס, והתיקיות שלך לא משותפות."

#, python-brace-format
msgid ""
"An update from {staged} is waiting. It starts at your next restart. The version you're using now is from {booted}.\n"
"\n"
"If you don't want it: Don't use it. Your computer keeps the version it has now. A boot options change made since the update came is dropped with it."
msgstr ""
"עדכון מ-{staged} ממתין. הוא ייכנס לתוקף בהפעלה מחדש הבאה. הגרסה שבשימוש עכשיו היא מ-{booted}.\n"
"\n"
"אם אין בו צורך: „לא להשתמש בזה”. המחשב ישמור על הגרסה שיש לו עכשיו. שינוי באפשרויות האתחול שנעשה מאז שהעדכון הגיע יבוטל יחד איתו."

msgid "An update is waiting for a restart. Restart first, then run the test."
msgstr "עדכון ממתין להפעלה מחדש. יש להפעיל מחדש קודם, ואז להריץ את הבדיקה."

msgid "Another disk is hidden by a BIOS setting."
msgstr "דיסק נוסף מוסתר בגלל הגדרת BIOS."

#, python-brace-format
msgid ""
"Another install or removal is running ({doing}). This waits for it to finish,"
" then goes on."
msgstr "התקנה או הסרה אחרת פועלת כעת ({doing}). המתנה לסיומה, ואז ההמשך."

msgid ""
"Another version is set to start at your next restart (after Undo the last "
"update, or picking a version in the boot menu), so the test wouldn't test "
"anything. Restart first, then run the test."
msgstr ""
"גרסה אחרת מוגדרת לעלות בהפעלה מחדש הבאה (אחרי „ביטול העדכון האחרון” או בחירת "
"גרסה בתפריט האתחול), כך שהבדיקה לא תבדוק דבר. יש להפעיל מחדש קודם, ואז להריץ "
"את הבדיקה."

msgid "App"
msgstr "יישום"

msgid "App, game or port number"
msgstr "יישום, משחק או מספר פורט"

msgid ""
"Applies them at login: the next slide for \"at each login\", and dark or "
"light for the time of day"
msgstr ""
"מחיל אותם בכניסה: את השקופית הבאה עבור „בכל כניסה”, ומצב כהה או בהיר לפי השעה"
" ביום"

msgid "Apps"
msgstr "יישומים"

msgid "Apps and ports let in"
msgstr "יישומים ופורטים שקיבלו גישה"

msgid "Apps from Bazaar have this setting inside the app."
msgstr "ליישומים מ-Bazaar ההגדרה הזו נמצאת בתוך היישום."

msgid "Apps from Bazaar update on their own. Remove them in Bazaar too."
msgstr "יישומים מ-Bazaar מתעדכנים בעצמם. גם את ההסרה שלהם עושים ב-Bazaar."

msgid "Apps from Bazaar: open Bazaar and remove it there."
msgstr "יישומים מ-Bazaar: יש לפתוח את Bazaar ולהסיר אותם שם."

msgid ""
"Apps from a file, Get a VPN or a Windows program: Wheelhouse, Apps, Remove "
"apps."
msgstr ""
"יישומים מקובץ, מ„השגת VPN” או מ„תכנית Windows”: Wheelhouse, „יישומים”, „הסרת "
"יישומים”."

msgid ""
"Apps from a file: open Wheelhouse, Apps, Start apps at login, and pick the "
"app. Picking it again stops it."
msgstr ""
"יישומים מקובץ: יש לפתוח את Wheelhouse, „יישומים”, „הפעלת יישומים בכניסה”, "
"ולבחור את היישום. בחירה נוספת בו מפסיקה זאת."

msgid "Apps from package files"
msgstr "יישומים מקובצי חבילות"

msgid "Apps from their own download sources"
msgstr "יישומים ממקורות ההורדה שלהם"

msgid "Apps you added from files, Get a VPN or Windows programs"
msgstr "יישומים שהוספת מקבצים, מ„השגת VPN” או מ„תכנית Windows”"

msgid "April"
msgstr "אפריל"

msgid ""
"ArtCraft's downloads can't be reached right now. Check the internet "
"connection and try again."
msgstr ""
"אין גישה כרגע להורדות של ArtCraft. יש לבדוק את החיבור לאינטרנט ולנסות שוב."

msgid "ArtCraft's signature is checked first, and it updates once a day."
msgstr "החתימה של ArtCraft נבדקת קודם, והוא מתעדכן פעם ביום."

msgid ""
"Asks once whether a password Wi-Fi or wired network is Home, Work or a Public"
" place"
msgstr ""
"שואל פעם אחת אם רשת אלחוטית עם ססמה או רשת קווית היא „בית”, „עבודה” או „מקום "
"ציבורי”"

msgid "At each login"
msgstr "בכל כניסה"

msgid "August"
msgstr "אוגוסט"

msgid "Authentication is required to add or remove an app's hardware rules"
msgstr "נדרש אימות כדי להוסיף או להסיר כללי חומרה של יישום"

msgid "Authentication is required to add or remove media codecs"
msgstr "נדרש אימות כדי להוסיף או להסיר מקודדי מדיה"

msgid ""
"Authentication is required to add, turn on or remove a VPN or an app's "
"background service"
msgstr "נדרש אימות כדי להוסיף, להפעיל או להסיר VPN או שירות רקע של יישום"

msgid "Authentication is required to change a Wheelhouse setting"
msgstr "נדרש אימות כדי לשנות הגדרה של Wheelhouse"

msgid "Authentication is required to change the boot options"
msgstr "נדרש אימות כדי לשנות את אפשרויות האתחול"

msgid ""
"Authentication is required to delete important settings for the repair test"
msgstr "נדרש אימות כדי למחוק הגדרות חשובות לצורך בדיקת התיקון"

msgid "Authentication is required to install EvenKeelOS"
msgstr "נדרש אימות כדי להתקין את EvenKeelOS"

msgid "Authentication is required to remove a trusted certificate"
msgstr "נדרש אימות כדי להסיר אישור מהימן"

msgid "Automatic"
msgstr "אוטומטי"

msgid "Automatic disk unlock"
msgstr "שחרור נעילה אוטומטי של הדיסק"

msgid "Automatic rollback"
msgstr "חזרה אוטומטית לאחור"

msgid "Automatic rollback note"
msgstr "הערה על חזרה אוטומטית לאחור"

msgid "Automatic updates"
msgstr "עדכונים אוטומטיים"

msgid "Automatic updates are back on."
msgstr "העדכונים האוטומטיים פעילים שוב."

msgid "Automatic updates are back on. The next daily update runs as normal."
msgstr "העדכונים האוטומטיים פעילים שוב. העדכון היומי הבא ירוץ כרגיל."

msgid "Automatic updates are off"
msgstr "העדכונים האוטומטיים כבויים"

msgid "Automatic updates are off. Run System Update yourself to update."
msgstr ""
"העדכונים האוטומטיים כבויים. כדי לעדכן, יש להריץ את „עדכון מערכת” בעצמך."

msgid ""
"Automatic updates are off: nothing updates until you run System Update yourself.\n"
"\n"
"Recommended: Turn on. Everything then updates by itself every day at 4 am, and updates fix security problems."
msgstr ""
"העדכונים האוטומטיים כבויים: שום דבר לא מתעדכן עד שמריצים את „עדכון מערכת” בעצמך.\n"
"\n"
"מומלץ: „הפעלה”. כך הכול יתעדכן מעצמו כל יום ב-4 לפנות בוקר, והעדכונים מתקנים בעיות אבטחה."

msgid "Automatic updates are on."
msgstr "העדכונים האוטומטיים פעילים."

msgid ""
"Automatic updates are on: everything updates by itself every day at 4 am.\n"
"\n"
"Recommended: Keep them on. Updates fix security problems.\n"
"\n"
"Or Turn off: nothing updates until you run System Update yourself."
msgstr ""
"העדכונים האוטומטיים פעילים: הכול מתעדכן מעצמו כל יום ב-4 לפנות בוקר.\n"
"\n"
"מומלץ: „להשאיר פעילים”. העדכונים מתקנים בעיות אבטחה.\n"
"\n"
"או „כיבוי”: שום דבר לא מתעדכן עד שמריצים את „עדכון מערכת” בעצמך."

#, python-brace-format
msgid "Automatic updates are paused until {day}"
msgstr "העדכונים האוטומטיים מושהים עד {day}"

#, python-brace-format
msgid ""
"Automatic updates are paused until {day}, after an undo, so the bad update doesn't come back. They turn back on by themselves.\n"
"\n"
"Recommended: Keep the pause.\n"
"\n"
"Or Resume now: the next daily update runs as normal. Or Turn off: nothing updates until you run System Update yourself."
msgstr ""
"העדכונים האוטומטיים מושהים עד {day}, אחרי ביטול, כדי שהעדכון הפגום לא יחזור. הם יחזרו לפעול מעצמם.\n"
"\n"
"מומלץ: „להשאיר את ההשהיה”.\n"
"\n"
"או „חידוש כעת”: העדכון היומי הבא ירוץ כרגיל. או „כיבוי”: שום דבר לא מתעדכן עד שמריצים את „עדכון מערכת” בעצמך."

#, python-brace-format
msgid ""
"Automatic updates are paused until {day}, so the bad update doesn't come "
"back. They turn back on by themselves."
msgstr ""
"העדכונים האוטומטיים מושהים עד {day}, כדי שהעדכון הפגום לא יחזור. הם יחזרו "
"לפעול מעצמם."

#, python-brace-format
msgid ""
"Automatic updates are paused until {day}, so the same update doesn't come "
"straight back. They turn back on by themselves."
msgstr ""
"העדכונים האוטומטיים מושהים עד {day}, כדי שאותו עדכון לא יחזור מיד. הם יחזרו "
"לפעול מעצמם."

msgid ""
"Automatic updates are still paused after the undo. Resume them in Automatic "
"updates."
msgstr ""
"העדכונים האוטומטיים עדיין מושהים אחרי הביטול. אפשר לחדש אותם ב„עדכונים "
"אוטומטיים”."

msgid ""
"Automatic updates could not be paused, so the next one may bring the update "
"back. If it does, turn off Automatic updates in Wheelhouse and tell your "
"helper."
msgstr ""
"לא ניתן היה להשהות את העדכונים האוטומטיים, ולכן העדכון הבא עלול להחזיר את "
"העדכון. אם זה קורה, יש לכבות את „עדכונים אוטומטיים” ב-Wheelhouse ולפנות למי "
"שעוזר לך."

msgid ""
"Automatic updates pause for 3 days, so the same update doesn't come straight "
"back. They turn back on by themselves."
msgstr ""
"העדכונים האוטומטיים מושהים ל-3 ימים, כדי שאותו עדכון לא יחזור מיד. הם יחזרו "
"לפעול מעצמם."

msgid ""
"Automatic updates then pause for 3 days, so the bad update doesn't come "
"straight back. If the problem returns after that, turn off Automatic updates "
"in Wheelhouse and tell your helper."
msgstr ""
"לאחר מכן העדכונים האוטומטיים מושהים ל-3 ימים, כדי שהעדכון הפגום לא יחזור מיד."
" אם הבעיה חוזרת אחרי זה, יש לכבות את „עדכונים אוטומטיים” ב-Wheelhouse ולפנות "
"למי שעוזר לך."

msgid "Automatic updates, undoing an update, firmware and certificate alerts"
msgstr "עדכונים אוטומטיים, ביטול עדכון, התראות קושחה ואישורים"

msgid ""
"Away from home, the switch shows off: sharing only runs on a Home network, "
"and comes back by itself there."
msgstr ""
"מחוץ לבית, המתג מופיע ככבוי: השיתוף פועל רק ברשת „בית”, ושם הוא חוזר לפעול "
"מעצמו."

msgid "BIOS settings"
msgstr "הגדרות BIOS"

msgid "Back"
msgstr "חזרה"

msgid "Back to the original"
msgstr "חזרה למקור"

msgid "Background: click a picture. To use your own photo, click Add Picture."
msgstr ""
"רקע: יש ללחוץ על תמונה. כדי להשתמש בתמונה משלך, יש ללחוץ על „הוספת תמונה”."

msgid "Basic graphics only"
msgstr "גרפיקה בסיסית בלבד"

msgid "Battery status"
msgstr "מצב הסוללה"

msgid "Bazaar is open. Close it when you're done looking."
msgstr "Bazaar פתוח. אפשר לסגור אותו בסיום העיון."

msgid "Bazaar, the app store (Flathub)"
msgstr "Bazaar, חנות היישומים (Flathub)"

msgid ""
"Before you unplug it, click the eject button next to its name, and wait until"
" it's gone from the list."
msgstr ""
"לפני הניתוק, יש ללחוץ על כפתור השליפה שליד השם שלו, ולהמתין עד שייעלם "
"מהרשימה."

msgid "Bluetooth"
msgstr "בלוטות'"

msgid "Bluetooth driver blocked"
msgstr "מנהל ההתקן של הבלוטות' חסום"

msgid "Bluetooth found."
msgstr "נמצא בלוטות'."

msgid "Boot entries that will be renamed to \"%s\":"
msgstr "רשומות אתחול שישונה שמן ל-„%s”:"

msgid "Boot options"
msgstr "אפשרויות אתחול"

msgid "Boot options in Wheelhouse can change them back later."
msgstr "אפשר להחזיר אותן בהמשך דרך „אפשרויות אתחול” ב-Wheelhouse."

msgid "Both"
msgstr "שניהם"

msgid "Both ask for your password, and work only on Home."
msgstr "שניהם מבקשים את הססמה שלך, ועובדים רק ב„בית”."

msgid "Bottom bar and a start menu"
msgstr "סרגל תחתון ותפריט התחלה"

msgid "Box"
msgstr "תיבה"

msgid "Broadcom Wi-Fi chip found. Its driver or firmware can't be included."
msgstr ""
"נמצא שבב רשת אלחוטית של Broadcom. אי אפשר לכלול את מנהל ההתקן או את הקושחה "
"שלו."

msgid "Browse and install apps in Bazaar. They update on their own."
msgstr "אפשר לעיין ביישומים ולהתקין אותם ב-Bazaar. הם מתעדכנים בעצמם."

msgid "Camera"
msgstr "מצלמה"

msgid "Camera found."
msgstr "נמצאה מצלמה."

msgid "Can install software and change system settings. Click to turn it off."
msgstr "יכול להתקין תכנה ולשנות הגדרות מערכת. יש ללחוץ כדי לכבות זאת."

msgid "Can install software and change system settings. Click to turn it on."
msgstr "יכול להתקין תכנה ולשנות הגדרות מערכת. יש ללחוץ כדי להפעיל זאת."

msgid "Cancel"
msgstr "ביטול"

msgid "Certificate"
msgstr "אישור"

msgid "Certificate alert"
msgstr "התראת אישור"

msgid "Certificate alerts"
msgstr "התראות אישורים"

msgid ""
"Certificates are how the computer knows a secure website is real. An alert "
"shows when one has expired, expires soon, or was removed."
msgstr ""
"אישורים הם הדרך שבה המחשב יודע שאתר מאובטח הוא אמיתי. התראה מופיעה כשתוקפו של"
" אישור פג, עומד לפוג בקרוב, או כשאישור הוסר."

msgid "Change"
msgstr "שינוי"

msgid "Change Scale. A bigger number makes everything bigger."
msgstr "יש לשנות את „קנה מידה”. מספר גדול יותר מגדיל הכול."

msgid "Change a Wheelhouse setting"
msgstr "שינוי הגדרה של Wheelhouse"

msgid "Change it"
msgstr "שינוי"

msgid "Change the kernel settings the computer starts with"
msgstr "שינוי הגדרות הליבה שאיתן המחשב עולה"

msgid "Change the layout"
msgstr "שינוי הפריסה"

msgid "Change the wallpaper to the next picture in a folder"
msgstr "החלפת הרקע לתמונה הבאה בתיקייה"

msgid ""
"Changed your mind? Open Undo the last update again and click Use the newer "
"version."
msgstr ""
"שינית את דעתך? יש לפתוח שוב את „ביטול העדכון האחרון” וללחוץ על „שימוש בגרסה "
"החדשה יותר”."

#, python-brace-format
msgid "Changing {title}"
msgstr "מתבצע שינוי של {title}"

msgid ""
"Check everything. Click a line to change it, or click Install to put "
"EvenKeelOS on the disk."
msgstr ""
"יש לבדוק הכול. אפשר ללחוץ על שורה כדי לשנות אותה, או ללחוץ על „התקנה” כדי "
"להתקין את EvenKeelOS בדיסק."

msgid "Check that automatic rollback works"
msgstr "בדיקה שהחזרה האוטומטית לאחור עובדת"

msgid "Check that it can't break"
msgstr "בדיקה שזה לא יכול להישבר"

msgid ""
"Check that the computer goes back by itself when a new version won't start, "
"and puts back deleted settings"
msgstr ""
"בדיקה שהמחשב חוזר לאחור מעצמו כשגרסה חדשה לא עולה, ומחזיר הגדרות שנמחקו"

msgid "Check the BIOS's storage settings."
msgstr "יש לבדוק את הגדרות האחסון ב-BIOS."

msgid "Check the boxes"
msgstr "בדיקת התיבות"

msgid "Checked against its own docs"
msgstr "נבדק מול התיעוד שלו עצמו"

msgid "Checked every day too"
msgstr "נבדק גם כל יום"

msgid "Checking for firmware updates."
msgstr "מתבצע חיפוש של עדכוני קושחה."

msgid "Checking sharing…"
msgstr "בדיקת השיתוף…"

msgid "Checking the network…"
msgstr "בדיקת הרשת…"

msgid "Checking this computer's parts..."
msgstr "בדיקת הרכיבים של המחשב הזה..."

#, python-brace-format
msgid "Checking whether Fedora has {name}."
msgstr "מתבצעת בדיקה אם יש ב-Fedora את {name}."

msgid "Checking…"
msgstr "בבדיקה…"

msgid "Choose"
msgstr "בחירה"

msgid "Choose apps from .rpm or .deb files that start when you log in"
msgstr "בחירת יישומים מקובצי ‎.rpm או ‎.deb שיופעלו עם הכניסה"

msgid "Choose which app opens a file"
msgstr "בחירת היישום שפותח קובץ"

#, python-brace-format
msgid "Chosen: automatic, from {servers}."
msgstr "נבחר: אוטומטי, מ-{servers}."

msgid "Chosen: don't encrypt."
msgstr "נבחר: ללא הצפנה."

msgid "Chosen: enabled."
msgstr "נבחר: פעיל."

msgid "Chosen: encrypt."
msgstr "נבחר: הצפנה."

msgid "Chosen: locked."
msgstr "נבחר: נעול."

#, python-brace-format
msgid "Chosen: {disk}."
msgstr "נבחר: {disk}."

#, python-brace-format
msgid "Chosen: {names}."
msgstr "נבחר: {names}."

#, python-brace-format
msgid "Chosen: {name}."
msgstr "נבחר: {name}."

#, python-brace-format
msgid "Chosen: {time}."
msgstr "נבחר: {time}."

msgid ""
"Click Add a folder and pick it. It starts as Read only: change it to Read and"
" write if the other computer should save there too."
msgstr ""
