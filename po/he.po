#, python-brace-format
msgid "Updating the system: downloading the new version, {size} in {n} parts."
msgid_plural ""
"Updating the system: downloading the new version, {size} in {n} parts."
msgstr[0] "עדכון המערכת: הגרסה החדשה בהורדה, {size} ב-{n} חלק."
msgstr[1] "עדכון המערכת: הגרסה החדשה בהורדה, {size} ב-{n} חלקים."

msgid "Updating the system: it is already up to date."
msgstr "עדכון המערכת: המערכת כבר מעודכנת."

#, python-brace-format
msgid "Updating the system: step {step} of {total}, {stage} ({elapsed})."
msgstr "עדכון המערכת: שלב {step} מתוך {total}, {stage} ({elapsed})."

#, python-brace-format
msgid "Updating the system: step {step} of {total}, {stage}."
msgstr "עדכון המערכת: שלב {step} מתוך {total}, {stage}."

msgid ""
"Updating the system: the new version is installed. It starts at your next "
"restart."
msgstr "עדכון המערכת: הגרסה החדשה הותקנה. היא תעלה בהפעלה מחדש הבאה."

#, python-brace-format
msgid "Updating {title}"
msgstr "עדכון {title}"

#, python-brace-format
msgid "Updating {title} in the {label}."
msgstr "מתבצע עדכון של {title} ב{label}."

#, python-brace-format
msgid "Updating {title} on the system"
msgstr "עדכון {title} במערכת"

#, python-brace-format
msgid "Updating {title} on the system. A progress window shows it."
msgstr "מתבצע עדכון של {title} במערכת. חלון התקדמות מציג זאת."

#, python-brace-format
msgid "Updating {title} on the system. This can take a few minutes."
msgstr "מתבצע עדכון של {title} במערכת. זה עשוי להימשך כמה דקות."

#, python-brace-format
msgid "Updating {title}: {description}"
msgstr "עדכון {title}: {description}"

#, python-brace-format
msgid ""
"Use 1 to {max} ports from 1 to 65535, each as 8096/tcp or 2456-2458/udp."
msgstr ""
"יש להשתמש ב-1 עד {max} פורטים בין 1 ל-65535, כל אחד בצורה 8096/tcp או "
"2456-2458/udp."

msgid "Use Flathub"
msgstr "שימוש ב-Flathub"

msgid "Use Open a port with its number."
msgstr "יש להשתמש ב„פתיחת פורט” עם המספר שלו."

msgid "Use a network cable, or a USB Wi-Fi adapter that works with Linux."
msgstr "אפשר להשתמש בכבל רשת, או במתאם רשת אלחוטית USB שעובד עם Linux."

msgid "Use a network cable."
msgstr "אפשר להשתמש בכבל רשת."

msgid "Use letters, digits and -, not at the start or end."
msgstr "יש להשתמש באותיות, ספרות ו-‎-, לא בהתחלה ולא בסוף."

msgid "Use the file"
msgstr "שימוש בקובץ"

msgid "Use the newer version"
msgstr "שימוש בגרסה החדשה יותר"

msgid "Use the number the app's own instructions give."
msgstr "יש להשתמש במספר שמופיע בהוראות של היישום עצמו."

msgid "Use the usual browser"
msgstr "שימוש בדפדפן הרגיל"

#, python-brace-format
msgid "Use {min} to 127 characters, on one line."
msgstr "יש להשתמש ב-{min} עד 127 תווים, בשורה אחת."

msgid "User name"
msgstr "שם משתמש"

msgid "VPN"
msgstr "VPN"

msgid ""
"VPNs, codecs and apps added to the system, while automatic updates are on. "
"New versions start at the next restart."
msgstr ""
"VPN, מקודדים ויישומים שנוספו למערכת, כל עוד העדכונים האוטומטיים פעילים. "
"גרסאות חדשות נכנסות לשימוש בהפעלה מחדש הבאה."

msgid ""
"Video and audio that need them stop playing. Needs your password and a "
"restart."
msgstr "וידאו ושמע שצריכים אותם יפסיקו להתנגן. נדרשים הססמה שלך והפעלה מחדש."

#, python-brace-format
msgid "Waiting for the other install or removal to finish ({doing})."
msgstr "ממתין לסיום ההתקנה או ההסרה האחרת ({doing})."

msgid "Wallpaper slideshow"
msgstr "מצגת רקעים"

msgid "Weak"
msgstr "חלשה"

msgid "Web video is already installed. Restart if you have not yet."
msgstr "וידאו ברשת כבר מותקן. אם עוד לא הפעלת מחדש, כדאי לעשות זאת."

msgid "Web video only"
msgstr "וידאו ברשת בלבד"

msgid "Welcome to EvenKeelOS"
msgstr "ברוכים הבאים אל EvenKeelOS"

msgid ""
"Welcome. A few things to set up, one at a time.\n"
"\n"
"1. Media codecs, for web video\n"
"2. Skip the disk password at startup\n"
"3. How to get apps\n"
"\n"
"Each can be skipped.\n"
"\n"
"Recommended: Start. Or Later: this opens again at the next login. Or Don't show again: it's in Wheelhouse any time."
msgstr ""
"ברוכים הבאים. כמה דברים להגדיר, אחד בכל פעם.\n"
"\n"
"1. מקודדי מדיה, לווידאו ברשת\n"
"2. דילוג על ססמת הדיסק בהפעלה\n"
"3. איך להשיג יישומים\n"
"\n"
"אפשר לדלג על כל אחד מהם.\n"
"\n"
"מומלץ: „התחלה”. או „מאוחר יותר”: זה ייפתח שוב בכניסה הבאה. או „לא להציג שוב”: זה נמצא ב-Wheelhouse בכל זמן."

msgid "What happens"
msgstr "מה קורה"

msgid "What is new:"
msgstr "מה חדש:"

msgid "What it does"
msgstr "מה זה עושה"

msgid "What stopped working with them:"
msgstr "מה הפסיק לעבוד יחד איתם:"

msgid "What the test copy found broken:"
msgstr "מה עותק הבדיקה מצא מקולקל:"

msgid "What's different"
msgstr "מה שונה"

msgid "Wheelhouse"
msgstr "Wheelhouse"

msgid "When neither of the two above is enough"
msgstr "כששתי האפשרויות שלמעלה לא מספיקות"

#, python-brace-format
msgid "Where is {name}?"
msgstr "איפה {name}?"

#, python-brace-format
msgid ""
"Where is {network}? This sets what other devices on it can reach once "
"EvenKeelOS is installed. Pick Public place anywhere you're not sure."
msgstr ""
"איפה {network}? כאן נקבע למה התקנים אחרים ברשת יוכלו להגיע אחרי ש-EvenKeelOS "
"תותקן. בכל מקום שלא בטוחים לגביו, כדאי לבחור „מקום ציבורי”."

msgid "Where it's from"
msgstr "המקור"

msgid "Where things are"
msgstr "איפה הדברים נמצאים"

msgid ""
"Which VPN do you want? Each one comes from its company's own download source "
"and keeps updating. To connect, you need an account with that company."
msgstr ""
"איזה VPN לבחור? כל אחד מגיע ממקור ההורדה של החברה שלו וממשיך להתעדכן. כדי "
"להתחבר, נדרש חשבון אצל אותה חברה."

msgid "Which app do you want to remove?"
msgstr "איזה יישום להסיר?"

msgid "Which app do you want? Start typing its name."
msgstr "איזה יישום להשיג? אפשר להתחיל להקליד את שמו."

msgid "Which app should start, or stop starting, when you log in?"
msgstr "איזה יישום יופעל, או יפסיק לפעול, עם הכניסה?"

msgid "Which box do you want to repair?"
msgstr "איזו תיבה לתקן?"

#, python-brace-format
msgid "Which city in {region} has your time? Back goes to the regions."
msgstr "איזו עיר ב-{region} נמצאת באזור הזמן שלך? „חזרה” חוזר לאזורים."

msgid ""
"Which disk should EvenKeelOS go on? Everything on it will be erased. The USB "
"stick this runs from is not listed."
msgstr ""
"באיזה דיסק להתקין את EvenKeelOS? כל מה שיש בו יימחק. הדיסק און קי שממנו זה רץ"
" לא מופיע ברשימה."

msgid "Which file do you want to install?"
msgstr "איזה קובץ להתקין?"

msgid ""
"Which keyboard layouts do you use? Click one to add it, or click it again to "
"take it off. The first one is used unless you switch."
msgstr ""
"באילו פריסות מקלדת משתמשים? יש ללחוץ על פריסה כדי להוסיף אותה, או ללחוץ עליה "
"שוב כדי להסיר אותה. הראשונה בשימוש, אלא אם מחליפים."

msgid "Which language should EvenKeelOS use?"
msgstr "באיזו שפה EvenKeelOS תשתמש?"

msgid "Which one? Back goes to the list of languages."
msgstr "איזו מהן? „חזרה” חוזר לרשימת השפות."

msgid "Which tool do you want?"
msgstr "איזה כלי לפתוח?"

msgid "Wi-Fi"
msgstr "רשת אלחוטית"

msgid "Wi-Fi driver blocked"
msgstr "מנהל התקן הרשת האלחוטית חסום"

msgid "Wi-Fi found."
msgstr "נמצא רכיב רשת אלחוטית."

msgid "Wi-Fi password"
msgstr "ססמת הרשת האלחוטית"

msgid "Wi-Fi, how safe each network is, and Bluetooth"
msgstr "רשת אלחוטית, עד כמה כל רשת בטוחה, ובלוטות'"

msgid "Wi-Fi, sound, brightness and power"
msgstr "רשת אלחוטית, צליל, בהירות וצריכת חשמל"

msgid "Will this computer work?"
msgstr "האם המחשב הזה יעבוד?"

msgid "Windows Program"
msgstr "תכנית Windows"

msgid "Windows Program is open"
msgstr "„תכנית Windows” פתוח"

msgid "Windows key + L locks the screen."
msgstr "מקש Windows + L נועל את המסך."

msgid "Windows programs"
msgstr "תכניות Windows"

msgid ""
"Windows programs (.exe and .msi) don't run here. Open one anyway: Wheelhouse "
"tells you the version for EvenKeelOS, or a replacement when there is one, and"
" installs it."
msgstr ""
"תכניות Windows ‏(‎.exe ו-‎.msi) לא רצות כאן. אפשר לפתוח אחת בכל זאת: "
"Wheelhouse יציג את הגרסה ל-EvenKeelOS, או תחליף אם יש, ויתקין אותו."

msgid "Windows programs (.exe, .msi)"
msgstr "תכניות Windows ‏(‎.exe, ‎.msi)"

msgid "Windows-style"
msgstr "בסגנון Windows"

msgid "Windows-style bottom bar or the standard top bar"
msgstr "סרגל תחתון בסגנון Windows או הסרגל העליון הרגיל"

msgid "Wired"
msgstr "קווי"

msgid "Wired network"
msgstr "רשת קווית"

msgid "Wired network: connected."
msgstr "רשת קווית: מחוברת."

msgid "Wired network: not connected."
msgstr "רשת קווית: לא מחוברת."

msgid ""
"With the Windows-style layout: click the sailboat button at the bottom left, "
"then Wheelhouse."
msgstr ""
"בפריסה בסגנון Windows: יש ללחוץ על כפתור המפרשית בפינה השמאלית התחתונה, ואז "
"על Wheelhouse."

msgid ""
"With the Windows-style layout: click the sailboat button at the bottom left, "
"then click the app, or start typing its name and press Enter."
msgstr ""
"בפריסה בסגנון Windows: יש ללחוץ על כפתור המפרשית בפינה השמאלית התחתונה, ואז "
"על היישום, או להתחיל להקליד את שמו וללחוץ Enter."

msgid ""
"With the standard layout: click the logo at the top left, then Wheelhouse."
msgstr ""
"בפריסה הרגילה: יש ללחוץ על הסמליל בפינה השמאלית העליונה, ואז על Wheelhouse."

msgid ""
"With the standard layout: press the Windows key, start typing the app's name,"
" and press Enter. Or press Windows key + A to see every app."
msgstr ""
"בפריסה הרגילה: יש ללחוץ על מקש Windows, להתחיל להקליד את שם היישום וללחוץ "
"Enter. אפשר גם ללחוץ על מקש Windows + A כדי לראות את כל היישומים."

msgid ""
"Word, Excel and PowerPoint: LibreOffice Writer, Calc and Impress. They open "
"and save Office files."
msgstr ""
"Word, ‏Excel ו-PowerPoint: ‏LibreOffice Writer, ‏Calc ו-Impress. הם פותחים "
"ושומרים קובצי Office."

msgid "Work"
msgstr "עבודה"

msgid ""
"Work: like a Public place, nothing gets in and your folders aren't shared. "
"The office's own shared drives still open."
msgstr ""
"עבודה: כמו ב„מקום ציבורי”, שום דבר לא נכנס והתיקיות שלך לא משותפות. הכוננים "
"המשותפים של המשרד עדיין נפתחים."

msgid "Working…"
msgstr "בעבודה…"

msgid "Year"
msgstr "שנה"

msgid "Yes"
msgstr "כן"

msgid ""
"You can still switch it yourself. It stays that way until the next change."
msgstr "עדיין אפשר להחליף בעצמך. זה נשאר כך עד השינוי הבא."

msgid ""
"You don't need to do anything. If a new version fails to start twice in a "
"row, the computer goes back to the version before by itself."
msgstr ""
"אין צורך לעשות דבר. אם גרסה חדשה נכשלת בהפעלה פעמיים ברציפות, המחשב חוזר "
"מעצמו לגרסה הקודמת."

#, python-brace-format
msgid ""
"You're using an earlier version, from {current}, after an undo. The newer one, from {newer}, is still on this computer.\n"
"\n"
"If the problem is fixed or you want it back: Use the newer version. It starts at your next restart.\n"
"\n"
"Or Cancel: the newer version comes back with the next update after the pause."
msgstr ""
"הגרסה שבשימוש היא גרסה קודמת, מ-{current}, אחרי ביטול. הגרסה החדשה יותר, מ-{newer}, עדיין נמצאת במחשב הזה.\n"
"\n"
"אם הבעיה תוקנה או שרוצים אותה בחזרה: „שימוש בגרסה החדשה יותר”. היא תעלה בהפעלה מחדש הבאה.\n"
"\n"
"או „ביטול”: הגרסה החדשה יותר תחזור עם העדכון הבא אחרי ההשהיה."

#, python-brace-format
msgid ""
"You're using the version from {current}, picked when the computer started. At your next restart the newer version, from {newer}, starts again.\n"
"\n"
"To stay on this one, pick it again when the computer starts, and tell your helper."
msgstr ""
"הגרסה שבשימוש היא מ-{current}, שנבחרה כשהמחשב עלה. בהפעלה מחדש הבאה, הגרסה החדשה יותר, מ-{newer}, תעלה שוב.\n"
"\n"
"כדי להישאר בגרסה הזו, יש לבחור אותה שוב כשהמחשב עולה, ולפנות למי שעוזר לך."

msgid "Your Boot options settings"
msgstr "ההגדרות שלך ב„אפשרויות אתחול”"

msgid "Your account"
msgstr "החשבון שלך"

msgid "Your account could not be found."
msgstr "החשבון שלך לא נמצא."

msgid "Your account could not be made."
msgstr "לא ניתן היה ליצור את החשבון שלך."

msgid "Your account's home folder could not be found."
msgstr "תיקיית הבית של החשבון שלך לא נמצאה."

msgid "Your account's home folder could not be set up."
msgstr "לא ניתן היה להקים את תיקיית הבית של החשבון שלך."

msgid "Your account's password could not be set."
msgstr "לא ניתן היה להגדיר את הססמה של החשבון שלך."

msgid ""
"Your app boxes are working. The box that did not update was made outside "
"Install Package File, so Repair cannot fix it."
msgstr ""
"תיבות היישומים שלך עובדות. התיבה שלא התעדכנה נוצרה מחוץ ל„התקנת קובץ חבילה”, "
"ולכן „תיקון” לא יכול לתקן אותה."

msgid "Your computer is in good shape"
msgstr "המחשב שלך במצב טוב"

msgid "Your computer needs an answer before it restarts."
msgstr "המחשב שלך צריך תשובה לפני שהוא מופעל מחדש."

msgid "Your computer put back missing system settings."
msgstr "המחשב החזיר הגדרות מערכת שחסרו."

msgid ""
"Your computer saves its list of what works 4 minutes after a good start, and "
"it hasn't saved one yet. Wait a few minutes and try again."
msgstr ""
"המחשב שומר את רשימת מה שעובד 4 דקות אחרי הפעלה תקינה, ועדיין לא שמר אחת. יש "
"להמתין כמה דקות ולנסות שוב."

msgid "Your computer went back to the previous version."
msgstr "המחשב חזר לגרסה הקודמת."

#, python-brace-format
msgid ""
"Your computer went back to the version from {since}, because the newer "
"version didn't start properly. Your files and your apps aren't touched."
msgstr ""
"המחשב חזר לגרסה מ-{since}, כי הגרסה החדשה יותר לא עלתה כמו שצריך. הקבצים "
"והיישומים שלך לא נפגעו."

#, python-brace-format
msgid ""
"Your computer went back to the version from {since}, because these stopped working on the newer version:\n"
"{broke}\n"
"\n"
"Your files and your apps aren't touched."
msgstr ""
"המחשב חזר לגרסה מ-{since}, כי אלה הפסיקו לעבוד בגרסה החדשה יותר:\n"
"{broke}\n"
"\n"
"הקבצים והיישומים שלך לא נפגעו."

msgid "Your computer's firmware is up to date."
msgstr "הקושחה של המחשב מעודכנת."

msgid ""
"Your disk isn't encrypted, so there's no disk password to skip. Nothing to "
"do."
msgstr "הדיסק שלך לא מוצפן, ולכן אין ססמת דיסק לדלג עליה. אין מה לעשות."

msgid ""
"Your file is newer than Fedora's. Use the file only if you need that newer "
"version now."
msgstr ""
"הקובץ שלך חדש יותר מזה של Fedora. כדאי להשתמש בקובץ רק אם יש צורך בגרסה החדשה"
" יותר עכשיו."

msgid ""
"Your files and apps aren't touched, and automatic updates aren't paused.\n"
"\n"
"The setting that caused it isn't in use. Disk and startup, Boot options in Wheelhouse shows what's in use now."
msgstr ""
