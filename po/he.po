msgstr ""
"„תיקון”: בונה אותה מחדש (מוריד כ-{size} MB) ומחזיר את היישומים שלה: {names}."

#, python-brace-format
msgid "Repair: rebuilds it and puts back its apps: {names}."
msgstr "„תיקון”: בונה אותה מחדש ומחזיר את היישומים שלה: {names}."

