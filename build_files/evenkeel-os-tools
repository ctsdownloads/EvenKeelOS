def running_test():
    """The test this start is running (its kernel argument), or None."""
    for arg in Path("/proc/cmdline").read_text().split():
        if arg.startswith("evenkeel_os.test_rollback="):
            return arg.split("=", 1)[1]
    return None


def test_rollback():
    w = _("Test automatic rollback")
    kind = running_test()
    if kind:
        name = _(next((t for k, t, _see in ROLLBACK_TESTS if k == kind), kind))
        if ask(_("This computer is running a test copy ({name}) as its normal version, so a new test can't start "
                 "from it.\n\nRecommended: Remove the test marker. The version without it starts at your next "
                 "restart. Needs your password.").format(name=name), ok=_("Remove the test marker"), title=w) != "ok":
            return 1
        rc = run(N_("Removing the test marker."), ["pkexec", ADMIN, "test-rollback", "clear"], title=w)
        if rc != 0:
            say(_("The administrator password wasn't given, so nothing was changed.") if rc in (126, 127) else
                _("It didn't work, and nothing was changed.\n\nThe details are in {log}").format(log=LOG), "warning",
                title=w)
            return 1
        offer_restart(_("The test marker is removed. The version without it starts at your next restart."))
        return 0
    i = choose(_("Pick a problem to test. Your computer should fix it by itself."), [_("Problem"), _("What happens")],
               [(_(t), _(TEST_SHORT[k])) for k, t, _see in ROLLBACK_TESTS] +
               [(_(SETTINGS_TEST_ROW[0]), _(TEST_SHORT["settings"]))], width=560, height=620)
    if i is None:
        return 1
    if i == len(ROLLBACK_TESTS):
        return test_settings(w)
    kind, name, see = ROLLBACK_TESTS[i]
    name, see = _(name), _(see)
    if kind in AFTER_LOGIN_TESTS:
        see = f"{see} {_(AFTER_LOGIN)}"
    # Tests that break the start before the desktop have no window to ask on.
    first = (_("Save your work first.") if kind in AFTER_LOGIN_TESTS else
             _("Save your work first: once it starts, it can't be stopped. It breaks the start before there's a "
               "desktop to ask on, so it restarts without asking and ends by itself."))
    # Translators: {name} is the test's name, {steps} what it does, {save} what to do before it starts.
    if ask(_("{name}: {steps}\n\nWhen it comes back, a message says the test worked, and the test copy is removed. "
             "Don't turn the computer off during the test unless the steps say to. {save}\n\nThe test copy takes "
             "the place of the earlier version kept for Undo the last update, so Undo has nothing to go back to "
             "until the next update.").format(name=name, steps=see, save=first),
           ok=_("Start the test"), title=w) != "ok":
