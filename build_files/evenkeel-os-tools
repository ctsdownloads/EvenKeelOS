def test_rollback():
    w = "Test automatic rollback"
    i = choose("Pick the problem to test. A test copy of this version is made with that problem, and starts at "
               "your next restart. Your computer should then go back to the version you're using now by itself.",
               ["Problem", "What you'll see"], [(t, see) for _, t, see in ROLLBACK_TESTS], width=760, height=460)
    if i is None:
        return 1
    kind, name, see = ROLLBACK_TESTS[i]
    if ask(f"{name}: {see}\n\nWhen it comes back, a message says the test worked, and the test copy is "
           "removed. Don't turn the computer off during the test unless the steps say to. Save your work first: "
           "the test restarts the computer without asking.\n\nThe test copy takes the place of the earlier "
           "version kept for Undo the last update, so Undo has nothing to go back to until the next update.",
           ok="Start the test", title=w) != "ok":
        return 1
    rc = run("Making the test copy.", ["pkexec", ADMIN, "test-rollback", kind], title=w)
    if rc == 4:
        say("This computer can't go back by itself: it was installed before automatic rollback was added. "
            "Computers installed from a newer USB have it.", "warning", title=w)
        return 1
    if rc == 5:
        say("An update is waiting for a restart. Restart first, then run the test.", title=w)
        return 1
    if rc != 0:
        say("The administrator password wasn't given, so nothing was changed." if rc in (126, 127) else
            f"It didn't work, and nothing was changed.\n\nThe details are in {LOG}", "warning", title=w)
        return 1
    offer_restart(f"The test copy ({name}) is ready. It starts at your next restart.", see)
    return 0


def rolled_back_note():
    """Say once, at login, that the computer went back to the previous version by itself."""
    w = "Automatic rollback"
    # greenboot may still be checking this start (it waits for a login); the note is written when it's done.
    for _ in range(240):
        r = subprocess.run(["systemctl", "is-active", "greenboot-healthcheck.service"], capture_output=True, text=True)
        if r.stdout.strip() != "activating":
            break
        time.sleep(5)
    try:
        kind, stamp = ROLLED_BACK.read_text().split()
    except (OSError, ValueError):
        return 0
    try:
        if ROLLED_BACK_SHOWN.read_text().strip() == stamp:
            return 0
    except OSError:
        pass
    ds = deployments() or []
    booted = next((d for d in ds if d.get("booted")), None)
    since = when(booted) if booted else "before the update"
    if kind == "test":
        notify("The automatic rollback test worked.")
        say(f"The test worked. Your computer went back by itself to the version from {since}, and the test copy is "
            f"removed.", title=w)
    else:
        until = paused_until()
        pause = (f"Automatic updates are paused until {day(until)}, so the same update doesn't come straight back. "
                 "They turn back on by themselves." if until else "")
        notify("Your computer went back to the previous version.")
        say(f"Your computer went back to the version from {since}, because the newer version didn't start "
            f"properly. Your files and your apps aren't touched." + (f"\n\n{pause}" if pause else "") +
            "\n\nIf it happens again, tell your helper. Save problem details in System Tools makes a file to send "
            "them.", "warning", title=w)
    STATE.mkdir(parents=True, exist_ok=True)
    ROLLED_BACK_SHOWN.write_text(stamp)
    return 0


TOOLS = [("firmware", "Update firmware", "Updates for the computer's own parts, like the BIOS", firmware),
         ("disk-unlock", "Unlock disk automatically", "Skip the disk password at startup", disk_unlock),
         ("free-space", "Free up disk space", "Remove things the computer no longer needs", free_space),
         ("bios", "Restart into BIOS settings", "Open the computer's BIOS settings screen", bios),
         ("updates", "Automatic updates", "Turn them on or off", updates),
         ("undo-update", "Undo the last update", "Go back to the version from before the last update", undo_update),
         ("problem-details", "Save problem details", "A file of recent errors to email to your helper",
          problem_details),
         ("setup", "Setup checklist", "Media codecs, disk unlock and getting apps, one at a time",
          setup_checklist),
         ("layout", "Desktop layout", "Windows-style bottom bar or the standard top bar", layout),
         ("test-rollback", "Test automatic rollback",
          "Check that the computer goes back by itself when a new version won't start", test_rollback)]


def main(argv):
    if len(argv) > 1:
        if argv[1:] == ["setup", "--first-login"]:
            return setup_checklist(first_login=True)
        if argv[1:] == ["rolled-back", "--at-login"]:
            return rolled_back_note()
        for key, _, _, fn in TOOLS:
            if argv[1] == key and len(argv) == 2:
                return fn()
        print(__doc__)
        return 2
    i = choose("Which tool do you want?", ["Tool", "What it does"], [[name, about] for _, name, about, _ in TOOLS],
               width=900, height=500)
    return TOOLS[i][3]() if i is not None else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
