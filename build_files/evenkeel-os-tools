#!/usr/bin/python3 -I
"""Wheelhouse: every EvenKeelOS tool in one window, from Show Apps; each job also runs on its own.

  evenkeel-os-tools                 the Wheelhouse window (--page=updates, apps, disk, yours or help)
  evenkeel-os-tools firmware        update firmware
  evenkeel-os-tools disk-unlock     unlock the disk automatically at startup (TPM)
  evenkeel-os-tools free-space      free up disk space
  evenkeel-os-tools bios            restart into the BIOS settings
  evenkeel-os-tools updates         turn automatic updates on or off
  evenkeel-os-tools undo-update     go back to the system version from before the last update
  evenkeel-os-tools problem-details save the computer's recent error messages to a file, for your helper
  evenkeel-os-tools layout          switch between the standard and the Windows-style desktop layout
  evenkeel-os-tools vpn             get a VPN app (Mullvad, Proton, IVPN or NordVPN) that keeps updating
  evenkeel-os-tools test-rollback   check that the computer goes back by itself when a new version won't start, and
                                    puts back deleted settings
  evenkeel-os-tools rolled-back --at-login   say once that the computer went back or put back settings by itself
  evenkeel-os-tools restart-question KIND first|last   ask before an automatic restart (the startup check runs it)
  evenkeel-os-tools certificates    security certificates that expired, expire within 30 days or were removed
  evenkeel-os-tools setup           the setup checklist: media codecs, disk unlock, getting apps
  evenkeel-os-tools setup --first-login   the same, once, at a new user's first login
"""
