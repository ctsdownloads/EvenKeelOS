def settings_note():
    """Say once, at login, that missing settings were put back (only once this start passed its checks)."""
    w = _("Settings put back")
    r = subprocess.run(["systemctl", "is-active", "greenboot-healthcheck.service"], capture_output=True, text=True)
    if r.stdout.strip() != "active":
        return 0
    try:
        lines = SETTINGS_REPAIRED.read_text().splitlines()
        kind, stamp, saved = lines[0].split()
        saved = ui.date_text(time.localtime(int(saved)), with_time=True)
    except (OSError, ValueError, IndexError):
        return 0
    # Only soon after: an account made later doesn't get an old message.
    if time.time() - int(stamp) > 3 * 86400:
        return 0
    if SETTINGS_SHOWN.is_file() and SETTINGS_SHOWN.read_text().strip() == stamp:
        return 0
    paths = lines[1:]
    named = [_(SETTINGS_NAMES[p]) for p in paths if p in SETTINGS_NAMES]
    rest = [p for p in paths if p not in SETTINGS_NAMES]
    what = ", ".join(named + rest[:10]) + (" " + _("and {n} more").format(n=len(rest) - 10) if len(rest) > 10 else "")
    if kind == "test":
        notify(_("The settings repair test worked."))
        say(ngettext("The test worked. At the next start your computer found important settings missing, put back "
                     "{n} setting from the copy it saved {saved}, and restarted by itself.\n\nPut back: {what}.",
                     "The test worked. At the next start your computer found important settings missing, put back "
                     "{n} settings from the copy it saved {saved}, and restarted by itself.\n\nPut back: {what}.",
                     len(paths)).format(n=len(paths), saved=saved, what=what), title=w)
    else:
        notify(_("Your computer put back missing system settings."))
        say(ngettext("The last start failed its start-up checks, and some system settings were missing or replaced. "
                     "Your computer put back {n} from the copy it saved {saved}, then restarted. Your files and "
                     "apps aren't touched.\n\nPut back: {what}.\n\nIf it happens again, tell your helper. Save "
                     "problem details in Wheelhouse makes a file to send them.",
                     "The last start failed its start-up checks, and some system settings were missing or replaced. "
                     "Your computer put back {n} from the copy it saved {saved}, then restarted. Your files and "
                     "apps aren't touched.\n\nPut back: {what}.\n\nIf it happens again, tell your helper. Save "
                     "problem details in Wheelhouse makes a file to send them.",
                     len(paths)).format(n=len(paths), saved=saved, what=what), "warning", title=w)
    STATE.mkdir(parents=True, exist_ok=True)
    SETTINGS_SHOWN.write_text(stamp)
    return 0


def what_broke(stamp):
    """What the trial check found broken on the newer version, in plain words, if it was this rollback's cause."""
    try:
        lines = ROLLED_BACK_WHY.read_text().splitlines()
        found = int(lines[0])
    except (OSError, ValueError, IndexError):
        return ""
    # Written by the failed start, shortly before the rollback's note.
    if not 0 <= int(stamp) - found <= 86400 or len(lines) < 2:
        return ""
    names = list(dict.fromkeys(n for n in lines[1:] if n))
    more = "\n  " + _("and {n} more").format(n=len(names) - 12) if len(names) > 12 else ""
    return "\n".join(f"  \u2022 {health.display(n)}" for n in names[:12]) + more


def rolled_back_note():
    """Say once, at login, that the computer went back to the previous version by itself."""
    w = _("Automatic rollback")
    # greenboot may still be checking this start (it waits for a login); the note is written when it's done.
    for _wait in range(240):
        r = subprocess.run(["systemctl", "is-active", "greenboot-healthcheck.service"], capture_output=True, text=True)
        if r.stdout.strip() != "activating":
            break
        time.sleep(5)
    try:
        kind, stamp = ROLLED_BACK.read_text().split()
    except (OSError, ValueError):
        return 0
    if ROLLED_BACK_SHOWN.is_file() and ROLLED_BACK_SHOWN.read_text().strip() == stamp:
        return 0
    ds = deployments() or []
    booted = next((d for d in ds if d.get("booted")), None)
    # Translators: {since} is a date such as "Oct 14", or the words "before the update" when the date isn't known.
    since = when(booted) if booted else _("before the update")
    if kind == "settings-test":
        notify(_("The settings repair test didn't work."))
        say(_("The settings repair test didn't work: your computer couldn't put the deleted settings back, so it went "
              "back to the version from {since}, which has its own settings. Your files and apps aren't touched, "
              "and automatic updates aren't paused.\n\nTell your helper. Save problem details in Wheelhouse makes "
              "a file to send them.").format(since=since), "warning", title=w)
    elif kind == "settings-failed":
        notify(_("Your computer went back to the previous version."))
        say(_("Some important system settings were broken, and putting them back didn't fix the start, so your "
              "computer went back to the version from {since}, which has its own settings. Your files and apps "
              "aren't touched, and automatic updates aren't paused.\n\nTell your helper. Save problem details in "
              "Wheelhouse makes a file to send them.").format(since=since), "warning", title=w)
    elif kind == "boot-options":
        notify(_("Your computer went back to the previous version."))
        broke = what_broke(stamp)
        say(_("The computer didn't start properly with the boot options changed in Wheelhouse, so it went back to "
              "the version from {since}, with the boot options it had before.").format(since=since) +
            ("\n\n" + _("What stopped working with them:") + f"\n{broke}\n\n" if broke else " ") +
            _("Your files and apps aren't touched, and automatic updates aren't paused.\n\nThe setting that caused "
              "it isn't in use. Disk and startup, Boot options in Wheelhouse shows what's in use now."), "warning",
            title=w)
    elif kind == "test":
        notify(_("The automatic rollback test worked."))
        broke = what_broke(stamp)
        say(_("The test worked. Your computer went back by itself to the version from {since}, and the test copy is "
              "removed.").format(since=since) +
            ("\n\n" + _("What the test copy found broken:") + f"\n{broke}" if broke else ""), title=w)
    else:
        until = paused_until()
        pause = (_("Automatic updates are paused until {day}, so the same update doesn't come straight back. They "
                   "turn back on by themselves.").format(day=day(until)) if until else "")
        notify(_("Your computer went back to the previous version."))
        broke = what_broke(stamp)
        if broke:
            why = _("Your computer went back to the version from {since}, because these stopped working on the newer "
                    "version:\n{broke}\n\nYour files and your apps aren't touched.").format(since=since, broke=broke)
        else:
            why = _("Your computer went back to the version from {since}, because the newer version didn't start "
                    "properly. Your files and your apps aren't touched.").format(since=since)
        say(why + (f"\n\n{pause}" if pause else "") +
            "\n\n" + _("If it happens again, tell your helper. Save problem details in Wheelhouse makes a file to "
                         "send them."), "warning", title=w)
    STATE.mkdir(parents=True, exist_ok=True)
    ROLLED_BACK_SHOWN.write_text(stamp)
    return 0


RESTART_WAIT = 120      # seconds a real problem waits for an answer (evenkeel_os_health.COUNTDOWN)
RESTART_QUESTION = Path("/run/evenkeel-os/restart-question")   # the boot ID, then what broke (evenkeel_os_health)


def restart_question(kind, start):
    """Ask before an automatic restart: 0 restart now, 3 keep (password given), 1 window couldn't show."""
    try:
        names = [n[:200] for n in RESTART_QUESTION.read_text().splitlines()[1:] if n]
    except OSError:
        return 1
    more = "\n  " + _("and {n} more").format(n=len(names) - 12) if len(names) > 12 else ""
    broke = "\n".join(f"  • {health.display(n)}" for n in names[:12]) + more
    test = next((_(t) for k, t, _see in ROLLBACK_TESTS if k == kind and k in AFTER_LOGIN_TESTS), None)
    last = start == "last"
    if test:
        found = (_("This start found these still broken, as the test expects:") if last else
                 _("This start found these broken, as the test expects:"))
        then = (_("Restart now: the computer restarts back on this version, and the test copy is removed. At login, a "
                  "note says the test worked.") if last else
                _("Restart now: the computer restarts and tries the test copy once more. About 3 minutes after you "
                  "log in, this window shows once more, and the start after that is back on this version, with the "
                  "test copy removed."))
        text = (_("{test}: the test is working.").format(test=test) + f"\n\n{found}\n{broke}\n\n{then}\n\n" +
                _("Not yet: nothing restarts until you click Restart now, so you can save your work first."))
        if kind == "graphics":
            text += "\n\n" + _("No answer in 2 minutes: it restarts by itself, because this test can leave the "
                                 "screen black.")
        ok, other, timed = _("Restart now"), _("Not yet"), kind == "graphics"
    elif kind in ("update", "boot-options"):
        if last:
            head = (_("Still not working after a restart.\n\nThese still don't work since the update:\n{broke}")
                    if kind == "update" else
                    _("Still not working after a restart.\n\nThese still don't work since the Boot options "
                      "change:\n{broke}")).format(broke=broke)
            go = (_("Recommended: Go back now. The computer restarts on the version that worked before. Your files "
                    "and apps aren't touched. If automatic updates are on, they pause for 3 days, so the same update "
                    "doesn't come straight back.") if kind == "update" else
                  _("Recommended: Go back now. The computer restarts with the boot options you had before."))
            ok = _("Go back now")
        else:
            head = (_("Something stopped working after the update.\n\nThese worked before the update and don't "
                      "now:\n{broke}") if kind == "update" else
                    _("Something stopped working after the Boot options change.\n\nThese worked before the Boot "
                      "options change and don't now:\n{broke}")).format(broke=broke)
            go = _("Recommended: Restart now. The computer restarts and tries once more. If it's still broken, this "
                   "window asks once more about 3 minutes after you log in, and then it can go back.")
            ok = _("Restart now")
        other = _("Keep this update") if kind == "update" else _("Keep these options")
        later = (_("Undo the last update in Wheelhouse can still take you back later.") if kind == "update" else
                 _("Boot options in Wheelhouse can change them back later."))
        text = (f"{head}\n\n{go}\n\n" +
                _("{other}: no more automatic restarts, and what broke stays broken. Needs an administrator to "
                  "approve it.").format(other=other) + f" {later}\n\n" +
                (_("No answer in 2 minutes: it goes back by itself.") if last else
                 _("No answer in 2 minutes: it restarts by itself.")))
        timed = True
    else:
        return 1
    if not GUI:
        return 1
    # zenity's own exit code 1 is a window that couldn't open or lost the screen; Esc opens it again.
    os.environ.update(ZENITY_CANCEL="4", ZENITY_ESC="9")
    notify(_("Your computer needs an answer before it restarts."))
    end = time.monotonic() + RESTART_WAIT if timed else None
    quick = 0
    waiting = False
    while True:
        left = int(end - time.monotonic()) if end else 0
        if end and left <= 0:
            return 0
        opened = time.monotonic()
        r = ui.zenity("--question", "--no-markup", f"--text={text}", f"--ok-label={ok}", f"--cancel-label={other}",
                      *([f"--timeout={left}"] if end else []), title=_("Automatic rollback"))
        if r.returncode in (0, 5):      # Restart now (or Go back now), or no answer in time
            return 0
        if r.returncode == 9:
            quick = quick + 1 if time.monotonic() - opened < 1 else 0
            if quick >= 3:              # it closes as soon as it opens: it can't show
                return 1
            continue
        if r.returncode != 4:
            return 1
        if test:
            if not waiting:
                text = _("Restart now is waiting: click it once your work is saved.") + "\n\n" + text
                waiting = True
            end = None                  # Not yet: no restart until Restart now
            continue
        # The password window gets what's left of the countdown, and at least a minute to type in.
        try:
            rc = subprocess.run(["pkexec", ADMIN, "keep-update"], capture_output=True,
                                timeout=max(int(end - time.monotonic()), 60)).returncode
        except subprocess.TimeoutExpired:
            return 0
        if rc == 0:
            return 3
        # The password wasn't given: the same question again, and the countdown carries on.


def cert_alerts(check=True):
    """The certificate alerts (see evenkeel-os-certs), checked now; None when they can't be read."""
    if check:
        subprocess.run([CERTS, "check"], capture_output=True)
    try:
        return json.loads(CERT_ALERTS.read_text())
    except (OSError, ValueError):
        return None


def certificates():
    w = _("Certificate alerts")
    alerts = cert_alerts()
    if alerts is None:
        say(_("The certificates couldn't be checked."), "warning", title=w)
        return 1
    if not alerts:
        say(_("No alerts: no security certificate this computer trusts has expired, expires within 30 days, or was "
              "removed."), title=w)
        return 0
    problem = {"expired": lambda a: _("Expired {date}").format(date=a["ends"][:10]),
               "expiring": lambda a: _("Expires {date}").format(date=a["ends"][:10]),
               "removed": lambda a: _("Removed")}
    rows = [(a["name"], problem[a["kind"]](a),
             _("Added to this computer") if a["added"] else _("Comes with the system")) for a in alerts]
    i = choose(_("These security certificates need attention. Pick one to see what to do."),
               [_("Certificate"), _("Problem"), _("Where it's from")], rows, width=760, height=420)
    if i is None:
        return 0
    a = alerts[i]
    name = a["name"]
    if a["kind"] == "removed":
        say(_("The certificate \"{name}\" was added to this computer and has been removed, so it's no longer "
              "trusted. If you didn't remove it, tell your helper.").format(name=name), "warning", title=w)
        subprocess.run([CERTS, "seen", a["fingerprint"]], capture_output=True)
        return 0
    if not a["added"]:
        say(_("\"{name}\" comes with Fedora. The trusted list is rebuilt from Fedora's current list at every start, "
              "so an update replaces or drops it; keep automatic updates on. If this alert stays after updating and "
              "restarting, tell your helper.").format(name=name), "warning", title=w)
        return 0
    if a["kind"] == "expiring":
        say(_("\"{name}\" was added to this computer and expires on {date}. Ask whoever gave it to you for a new "
              "one before then.").format(name=name, date=a["ends"][:10]), "warning", title=w)
        return 0
    if not a["file"] or not CERT_FILE.fullmatch(a["file"]):
        say(_("\"{name}\" has expired. It was added in a way Wheelhouse can't remove; tell your helper.").format(
            name=name), "warning", title=w)
        return 0
    if a.get("in_file", 1) > 1:
        say(ngettext("\"{name}\" has expired, but its file ({file}) holds {n} certificate, and removing it would "
                     "remove them all, the good ones too. Tell your helper.",
                     "\"{name}\" has expired, but its file ({file}) holds {n} certificates, and removing it would "
                     "remove them all, the good ones too. Tell your helper.", a["in_file"]).format(
                         name=name, file=a["file"], n=a["in_file"]), "warning", title=w)
        return 0
    if ask(_("\"{name}\" was added to this computer and expired on {date}. An expired certificate shouldn't be "
             "relied on. Remove it if you no longer need it; if you do, ask whoever gave it to you for a new one. "
             "Removing it needs your password.").format(name=name, date=a["ends"][:10]),
           ok=_("Remove it"), cancel=_("Keep it"), title=w) != "ok":
        return 0
    rc = run(N_("Removing the certificate."), ["pkexec", CERT_REMOVE, a["file"], a["fingerprint"]], title=w)
    if rc != 0:
        problem = (_("The administrator password wasn't given, so nothing was changed.") if rc in (126, 127) else
                   _("Its file changed or holds more than one certificate, so nothing was removed. Tell your "
                     "helper.") if rc == 3 else _("It didn't work.\n\nThe details are in {log}").format(log=LOG))
        say(problem, "warning", title=w)
        return 1
    cert_alerts()
    subprocess.run([CERTS, "seen", a["fingerprint"]], capture_output=True)    # removed here: no "removed" alert
    if subprocess.run([CERTS, "trusted", a["fingerprint"]], capture_output=True).returncode == 0:
        say(_("Its file is removed, but \"{name}\" is still trusted: it was added somewhere else too. Tell your "
              "helper.").format(name=name), "warning", title=w)
        return 1
    say(_("\"{name}\" is removed and no longer trusted.").format(name=name), title=w)
    return 0


