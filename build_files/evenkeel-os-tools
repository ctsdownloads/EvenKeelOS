# ---------------------------------------------------------------- windows

def password(text):
    """The disk password, typed. None when cancelled."""
    if GUI:
        r = subprocess.run([ui.DIALOGS, f"--title={ui.TITLE}", "--password", f"--text={text}"],
                           capture_output=True, text=True)
        return r.stdout.rstrip("\n") if r.returncode == 0 and r.stdout.strip() else None
    import getpass
    try:
        return getpass.getpass(text + " ") or None
    except EOFError:
        return None


def busy(text, title=None):
    """Show a moving progress window with this text (or print it without a desktop). Close it with done(bar)."""
    if not GUI:
        print(text)
        return None
    return subprocess.Popen([ui.DIALOGS, f"--title={title or ui.TITLE}", "--progress", "--pulsate", "--auto-close",
                             "--no-cancel", "--width=480", f"--text={text}"], stdin=subprocess.PIPE, text=True)


def done(bar):
    if bar:
        ui.finish(bar)


def run(text, cmd, stdin=None, title=None):
    """Run one command with a progress window; its exit code. text is English (N_): the log keeps it as is."""
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as log:
        log.write(f"\n=== {time.strftime('%Y-%m-%d %H:%M:%S')} {text}\n$ {' '.join(cmd)}\n")
        log.flush()
        bar = busy(_(text), title)
        try:
            rc = subprocess.run(cmd, input=stdin, stdout=log, stderr=subprocess.STDOUT, text=True).returncode
        except OSError as e:
            log.write(f"{e}\n")
            rc = 127
        done(bar)
    return rc


def output(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None


# ---------------------------------------------------------------- state

def luks_uuid():
    """The encrypted system disk's UUID, from the kernel command line, or None when the disk is not encrypted."""
    try:
        args = Path("/proc/cmdline").read_text().split()
    except OSError:
        return None
    for a in args:
        if a.startswith("rd.luks.uuid="):
            v = a.split("=", 1)[1]
            return v[5:] if v.startswith("luks-") else v
    return None


def has_tpm():
    return Path("/dev/tpmrm0").exists()


def secure_boot_on():
    """True, False, or None when it cannot be told."""
    for f in Path("/sys/firmware/efi/efivars").glob("SecureBoot-*"):
        try:
            data = f.read_bytes()
            return len(data) >= 5 and data[4] == 1
        except OSError:
            return None
    return None


def updates_on():
    r = output(["systemctl", "is-enabled", "uupd.timer"])
    return bool(r) and r.stdout.strip() == "enabled"


def paused_until():
    """When an undo's pause on automatic updates ends, or None when there is none."""
    try:
        until = int(PAUSE.read_text())
    except (OSError, ValueError):
        return None
    return until if until > time.time() else None


def day(t):
    return ui.day_text(time.localtime(t))


def pause_updates(w):
    """After an undo: pause automatic updates, so the next one doesn't bring the update straight back."""
    if not updates_on():
        return ""
    run(N_("Pausing automatic updates."), ["pkexec", SAFE, "updates", "pause"], title=w)
    until = paused_until()
    if not until:
        return _("Automatic updates could not be paused, so the next one may bring the update back. If it does, turn "
                 "off Automatic updates in Wheelhouse and tell your helper.")
    return _("Automatic updates are paused until {day}, so the bad update doesn't come back. They turn back on by "
             "themselves.").format(day=day(until))


# ---------------------------------------------------------------- tools

def firmware():
    w = _("Update firmware")
    if run(N_("Checking for firmware updates."), ["fwupdmgr", "refresh", "--force", "--no-remote-check",
                                              "--no-metadata-check", "--no-unreported-check"], title=w) not in (0, 2):
        say(_("Couldn't check for firmware updates. Check your internet connection and try again."), "warning",
            title=w)
        return 1
    r = output(["fwupdmgr", "get-updates", "--json", "--no-unreported-check", "--no-metadata-check"])
    if not r or r.returncode not in (0, 2):     # 2: no updates
        say(_("Couldn't check for firmware updates. Try again later."), "warning", title=w)
        return 1
    devices = []
    if r.returncode == 0:
        try:
            for d in json.loads(r.stdout).get("Devices", []):
                rel = (d.get("Releases") or [{}])[0]
                devices.append("  - " + _("{name}: {old} to {new}").format(
                    name=d.get("Name", _("A device")), old=d.get("Version", "?"), new=rel.get("Version", "?")))
        except (ValueError, AttributeError):
            devices = []
    if not devices:
        say(_("Your computer's firmware is up to date."), title=w)
        return 0
    note = ""
    if DISK_UNLOCK_ON.exists():
        note = "\n\n" + _("Unlock disk automatically is on. After some firmware updates, the computer asks for the "
                           "disk password once. Then turn Unlock disk automatically on again in Wheelhouse.")
    if ask(_("Firmware updates are available for:") + "\n" + "\n".join(devices) + "\n\n" +
           _("Firmware is the software built into the computer's own parts, like the BIOS.") + "\n\n" +
           _("Recommended: Update. Keep the computer plugged in. Some updates finish while the computer restarts.") +
           note, ok=_("Update"), title=w) != "ok":
        return 1
    rc = run(N_("Updating firmware. Keep the computer plugged in."),
             ["fwupdmgr", "update", "--assume-yes", "--no-reboot-check", "--no-remote-check", "--no-metadata-check",
              "--no-unreported-check"], title=w)
    if rc == 2:     # nothing to do after all
        say(_("Your computer's firmware is up to date."), title=w)
        return 0
    if rc != 0:
        say(_("The firmware update didn't finish. Try again later."), "warning", title=w)
        return 1
    notify(_("Firmware updated."))
    offer_restart(_("Firmware updated. Some updates finish while the computer restarts."))
    return 0


def disk_unlock(in_checklist=False):
    w = _("Unlock disk automatically")
    uuid = luks_uuid()
    if not uuid:
        say(_("Your disk isn't encrypted, so there's no disk password to skip. Nothing to do."), title=w)
        return 0
    if not has_tpm():
        say(_("This computer has no security chip (TPM) that can do this, so the disk password stays."), title=w)
        return 0
    if DISK_UNLOCK_ON.exists():
        if ask(_("Unlock disk automatically is on: the disk unlocks by itself when the computer starts.\n\n"
                 "Turn off: you type the disk password at every start again."), ok=_("Turn off"),
               cancel=_("Keep it on"), title=w) != "ok":
            return 1
        pw = password(_("Type the disk password (the one you type when the computer starts):"))
        if not pw:
            return 1
        rc = run(N_("Turning off automatic disk unlock."), ["pkexec", SAFE, "disk-unlock", "off"], stdin=pw, title=w)
        return done_disk(rc, _("Unlock disk automatically is off. From your next start, the computer asks for the "
                               "disk password again."), w)
    if secure_boot_on() is False:
        a = ask(_("Right now you type the disk password every time the computer starts.\n\nSecure Boot is off on "
                  "this computer, so this would be less safe: someone could change how the computer starts and still "
                  "get the disk unlocked.\n\nRecommended: Cancel, then turn Secure Boot on in the BIOS settings first "
                  "(Restart into BIOS settings, in Wheelhouse).\n\nOr Turn on anyway."), ok=_("Turn on anyway"),
                title=w)
    else:
        a = ask(_("Right now you type the disk password every time the computer starts.\n\nRecommended: Turn on. The "
                  "computer's security chip unlocks the disk for you. If the disk is ever taken out of this computer, "
                  "or its startup settings change, it asks for the password as before.\n\nNeeds the disk password "
                  "one last time, then a restart."), ok=_("Turn on"), title=w)
    if a != "ok":
        return 1
    pw = password(_("Type the disk password (the one you type when the computer starts):"))
    if not pw:
        return 1
    rc = run(N_("Turning on automatic disk unlock."), ["pkexec", SAFE, "disk-unlock", "on"], stdin=pw, title=w)
    if rc == 0:
        if in_checklist:    # the checklist offers the restart at its end, so its last steps aren't lost
            say(_("It's on. From your next restart, the disk unlocks by itself."), title=w)
        else:
            offer_restart(_("It's on. From your next restart, the disk unlocks by itself."))
        return 0
    return done_disk(rc, "", w)


def done_disk(rc, text, w):
    if rc == 0:
        say(text, title=w)
        return 0
    if rc == 3:
        say(_("That isn't the disk password, so nothing was changed. Try again."), "warning", title=w)
    elif rc == 4:
        say(_("That was the wrong disk password too many times, so it's locked for an hour. Nothing was changed. "
              "Try again after that."), "warning", title=w)
    elif rc in (126, 127):
        say(_("The administrator password wasn't given, so nothing was changed."), "warning", title=w)
    else:
        say(_("It didn't work, and nothing was changed. Try again later.\n\nThe details are in {log}").format(
            log=LOG), "warning", title=w)
    return 1


def free_space():
    w = _("Free up disk space")
    before = free_mb()
    now = _("{size} is free now.").format(size=human(before)) + "\n\n" if before is not None else ""
    if ask(now + _("This removes things the computer no longer needs: unused app parts, old system update files, and "
                   "unused container images. Your files and your apps aren't touched."),
           ok=_("Free up space"), title=w) != "ok":
        return 1
    # System leftovers go through the no-password helper; the rest is the user's own.
    steps = [(N_("Removing unused container images."), ["podman", "image", "prune", "-af"]),
             (N_("Removing your unused app parts."), ["flatpak", "uninstall", "--user", "--unused", "-y",
                                                      "--noninteractive"]),
             (N_("Removing old system update files and unused app parts."), ["pkexec", SAFE, "free-space"])]
    brew = "/home/linuxbrew/.linuxbrew/bin/brew"
    if os.access(brew, os.X_OK):
        steps += [(N_("Removing unused command-line tools."), [brew, "autoremove"]),
                  (N_("Removing old command-line tool downloads."), [brew, "cleanup"])]
    for text, cmd in steps:
        if shutil.which(cmd[0]) or cmd[0].startswith("/"):
            run(text, cmd, title=w)
    after = free_mb()
    if before is not None and after is not None:
        freed = max(after - before, 0)
        say(_("Done. {freed} freed. {free} is free now.").format(freed=human(freed), free=human(after)), title=w)
    else:
        say(_("Done."), title=w)
    return 0


def bios():
    w = _("Restart into BIOS settings")
    if not Path("/sys/firmware/efi").is_dir():
        say(_("This computer can't open its BIOS settings from here. Press the BIOS key while it starts (often F2, "
              "F10, F12 or Delete)."), title=w)
        return 0
    if ask(_("The computer restarts and opens its BIOS settings screen. Save your work first.\n\nThe BIOS settings "
             "are used with the keyboard. When you're done, choose Save and Exit, or Exit, to start the computer "
             "again."), ok=_("Restart now"), title=w) != "ok":
        return 1
    r = output(["systemctl", "reboot", "--firmware-setup"])
    if not r or r.returncode != 0:
        say(_("This computer can't open its BIOS settings from here. Press the BIOS key while it starts (often F2, "
              "F10, F12 or Delete)."), title=w)
        return 1
    return 0


def updates():
    w = _("Automatic updates")
    off = (N_("Turning off automatic updates."), ["pkexec", ADMIN, "updates", "off"],
           _("Automatic updates are off. Run System Update yourself to update."))
    until = paused_until() if updates_on() else None
    if until:
        answer = ask(_("Automatic updates are paused until {day}, after an undo, so the bad update doesn't come back. "
                       "They turn back on by themselves.\n\nRecommended: Keep the pause.\n\nOr Resume now: the next "
                       "daily update runs as normal. Or Turn off: nothing updates until you run System Update "
                       "yourself.").format(day=day(until)),
                     ok=_("Resume now"), cancel=_("Keep the pause"), extra=_("Turn off"), title=w)
        if answer == "ok":
            step, cmd, text = (N_("Turning automatic updates back on."), ["pkexec", SAFE, "updates", "resume"],
                               _("Automatic updates are back on. The next daily update runs as normal."))
        elif answer == "extra":
            step, cmd, text = off
        else:
            return 1
    elif updates_on():
        if ask(_("Automatic updates are on: everything updates by itself every day at 4 am.\n\nRecommended: Keep "
                 "them on. Updates fix security problems.\n\nOr Turn off: nothing updates until you run System "
                 "Update yourself."), ok=_("Turn off"), cancel=_("Keep them on"), title=w) != "ok":
            return 1
        step, cmd, text = off
    else:
        if ask(_("Automatic updates are off: nothing updates until you run System Update yourself.\n\nRecommended: "
                 "Turn on. Everything then updates by itself every day at 4 am, and updates fix security problems."),
               ok=_("Turn on"), cancel=_("Keep them off"), title=w) != "ok":
            return 1
        step, cmd, text = (N_("Turning on automatic updates."), ["pkexec", SAFE, "updates", "on"],
                           _("Automatic updates are on."))
    rc = run(step, cmd, title=w)
    if rc == 0:
        say(text, title=w)
        return 0
    say(_("The administrator password wasn't given, so nothing was changed.") if rc in (126, 127) else
        _("It didn't work, and nothing was changed.\n\nThe details are in {log}").format(log=LOG), "warning", title=w)
    return 1


def deployments():
    """The system versions on disk, newest first (rpm-ostree status --json), or None."""
    r = output(["rpm-ostree", "status", "--json"])
    if not r or r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)["deployments"]
    except (ValueError, KeyError):
        return None


def built(d):
    try:
        return time.localtime(int(d["timestamp"]))
    except (KeyError, ValueError, TypeError):
        return None


def when(d, other=None):
    """A version's date ("October 14"), with the time ("October 14, 1:03 AM") if `other` is from that day too."""
    t = built(d)
    if t is None:
        return _("an earlier date")
    o = built(other) if other is not None else None
    same_day = o is not None and t[:3] == o[:3]
    return ui.date_text(t, with_time=same_day)


def undo_update():
    w = _("Undo the last update")
    ds = deployments()
    if ds is None:
        say(_("Couldn't read which system versions are on this computer. Try again later."), "warning", title=w)
        return 1
    booted = next((d for d in ds if d.get("booted")), None)
    staged = next((d for d in ds if d.get("staged")), None)
    later = ("\n\n" + _("Automatic updates then pause for 3 days, so the bad update doesn't come straight back. If "
                         "the problem returns after that, turn off Automatic updates in Wheelhouse and tell your "
                         "helper.") if updates_on() else "")
    nxt = ds[0] if ds and not ds[0].get("booted") else None
    if nxt and booted and nxt.get("checksum") == booted.get("checksum") and \
            int(nxt.get("serial", 0)) > int(booted.get("serial", 0)):
        # The same system with other boot options (Wheelhouse, Boot options), not an update.
        if ask(_("A change to the boot options is waiting. It starts at your next restart. It isn't an "
                 "update.\n\nIf you don't want it: Don't use it. The computer starts with the boot options it has "
                 "now, and automatic updates aren't paused.\n\nOr Keep it."), ok=_("Don't use it"),
               cancel=_("Keep it"), title=w) != "ok":
            return 1
        drop = ["rpm-ostree", "cleanup", "-p"] if nxt.get("staged") else ["rpm-ostree", "rollback"]
        if run(N_("Removing the waiting change."), drop, title=w) != 0:
            say(_("It didn't work, and nothing was changed.\n\nThe details are in {log}").format(log=LOG),
                "warning", title=w)
            return 1
        say(_("Done. The computer starts with the boot options it has now."), title=w)
        return 0
    if staged:
        # Translators: {booted} is a date such as "Oct 14", or the words "before it" when the date isn't known.
        if ask(_("An update from {staged} is waiting. It starts at your next restart. The version you're using now "
                 "is from {booted}.\n\nIf you don't want it: Don't use it. Your computer keeps the version it has "
                 "now. A boot options change made since the update came is dropped with it.").format(
                     staged=when(staged, booted), booted=when(booted, staged) if booted else _("before it")) +
               later + "\n\n" + _("Or Keep it."),
               ok=_("Don't use it"), cancel=_("Keep it"), title=w) != "ok":
            return 1
        rc = run(N_("Removing the waiting update."), ["rpm-ostree", "cleanup", "-p"], title=w)
        if rc != 0:
            say(_("It didn't work, and nothing was changed.\n\nThe details are in {log}").format(log=LOG),
                "warning", title=w)
            return 1
        note = pause_updates(w)
        say(_("Done. Your computer keeps the version it has now.") + (f"\n\n{note}" if note else ""), title=w)
        return 0
    if booted is not None and ds and ds[0] is not booted:
        if int(ds[0].get("timestamp", 0)) <= int(booted.get("timestamp", 0)):
            # An earlier undo: the older version is set to start next time.
            offer_restart(_("It's already set: the version from {date} starts at your next restart.").format(
                date=when(ds[0], booted)))
        else:
            # Started from the boot menu on the older version: the newer one is still the one that starts.
            say(_("You're using the version from {current}, picked when the computer started. At your next restart "
                  "the newer version, from {newer}, starts again.\n\nTo stay on this one, pick it again when the "
                  "computer starts, and tell your helper.").format(current=when(booted, ds[0]),
                                                                    newer=when(ds[0], booted)), title=w)
        return 0
    older = next((d for d in ds if not d.get("booted") and not d.get("staged")), None)
    if older is None:
        say(_("There's no earlier version on this computer to go back to. Only the version you're using now is "
              "kept."), title=w)
        return 0
    if booted is not None and int(older.get("timestamp", 0)) > int(booted.get("timestamp", 0)):
        # After an undo: the other version on disk is the newer one.
        if ask(_("You're using an earlier version, from {current}, after an undo. The newer one, from {newer}, is "
                 "still on this computer.\n\nIf the problem is fixed or you want it back: Use the newer version. It "
                 "starts at your next restart.\n\nOr Cancel: the newer version comes back with the next update after "
                 "the pause.").format(current=when(booted, older), newer=when(older, booted)),
               ok=_("Use the newer version"), title=w) != "ok":
            return 1
        rc = run(N_("Setting the newer version to start next time."), ["rpm-ostree", "rollback"], title=w)
        if rc != 0:
            say(_("The administrator password wasn't given, so nothing was changed.") if rc in (126, 127) else
                _("It didn't work, and nothing was changed.\n\nThe details are in {log}").format(log=LOG), "warning",
                title=w)
            return 1
        back = ""
        if paused_until():
            run(N_("Turning automatic updates back on."), ["pkexec", SAFE, "updates", "resume"], title=w)
            back = (_("Automatic updates are still paused after the undo. Resume them in Automatic updates.")
                    if paused_until() else _("Automatic updates are back on."))
        offer_restart(_("Done. The version from {date} starts at your next restart.").format(
            date=when(older, booted)), back)
        return 0
    if booted and older.get("checksum") == booted.get("checksum"):
        # The version running now differs from the one before only in its boot options.
        if ask(_("The version you're using now is the one before it with boot options changed in "
                 "Wheelhouse.\n\nUndo the change: the computer starts with the boot options it had before, at your "
                 "next restart. Automatic updates aren't paused.\n\nOr Cancel."), ok=_("Undo the change"),
               title=w) != "ok":
            return 1
        if run(N_("Setting the earlier boot options to start next time."), ["rpm-ostree", "rollback"],
               title=w) != 0:
            say(_("It didn't work, and nothing was changed.\n\nThe details are in {log}").format(log=LOG),
                "warning", title=w)
            return 1
        offer_restart(_("Done. The earlier boot options start at your next restart."))
        return 0
    # Translators: {current} is a date such as "Oct 14", or the words "the last update" when the date isn't known.
    if ask(_("The version you're using now is from {current}. The one from before it, from {older}, is still on this "
             "computer.\n\nIf something stopped working after the last update: Undo the update. The version from "
             "{older} starts at your next restart. Your files and your apps aren't touched.").format(
