def tail(text, n):
    lines = text.splitlines()
    cut = len(lines) - n
    return ("(... %d earlier lines left out ...)\n" % cut if cut > 0 else "") + "\n".join(lines[-n:])


def problem_details():
    w = _("Save problem details")
    folder = documents()
    name = f"problem-details-{time.strftime('%Y-%m-%d-%H%M')}.txt"
    if ask(_("This saves the computer's recent error messages, its system version and the list of your apps to one "
             "file, {name}, in your Documents folder. What your apps showed or opened isn't in it.\n\nThen email "
             "that file to your helper. They can see what went wrong without being here.\n\nNothing is sent "
             "anywhere by itself.").format(name=name),
           ok=_("Save details"), title=w) != "ok":
        return 1
    bar = busy(_("Collecting the problem details."), w)
    parts = [f"Problem details from EvenKeelOS, {time.strftime('%Y-%m-%d %H:%M')}"]
    for heading, cmd, n in DETAILS:
        r = output(cmd) if shutil.which(cmd[0]) else None
        text = (r.stdout + r.stderr).strip() if r else "(not available)"
        parts.append(f"\n===== {heading} =====\n{tail(text, n) or '(nothing)'}")
    # Our tools' logs; box apps' own logs stay out (they hold addresses and file names).
    for f in sorted(CACHE.glob("*.log")):
        try:
            body = tail(f.read_text(errors='replace'), 200)
        except OSError as e:
            body = f"(couldn't be read: {e.strerror})"
        parts.append(f"\n===== {f.name} =====\n{body}")
    path = folder / name
    try:
        folder.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(parts) + "\n")
        ok = True
    except OSError:
        ok = False
    done(bar)
    if not ok:
        say(_("Couldn't save the file in {folder}. Check that there's free disk space and try again.").format(
            folder=folder), "warning", title=w)
        return 1
    if ask(_("Saved: {name}, in your Documents folder.\n\nEmail it to your helper: attach it like any other "
             "file.\n\nRecommended: Show the file, to see where it is. Or Close.").format(name=name),
           ok=_("Show the file"), cancel=_("Close"), title=w) == "ok":
        if shutil.which("nautilus"):
            subprocess.Popen(["nautilus", "--select", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             env=ui.LAUNCH_ENV)
        else:
            subprocess.Popen(["xdg-open", str(folder)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             env=ui.LAUNCH_ENV)
    return 0


