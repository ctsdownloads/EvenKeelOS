def checklist_open():
    """Whether this user's setup checklist from login is still open."""
    want = b"/usr/bin/evenkeel-os-tools\0setup\0--first-login\0"
    for d in Path("/proc").glob("[0-9]*"):
        try:
            if d.stat().st_uid == os.getuid() and want in (d / "cmdline").read_bytes():
                return True
        except OSError:
            continue
    return False


def guide_at_login():
    """New to EvenKeelOS? in Wheelhouse, after the setup checklist, until "Don't show this again" is ticked."""
    if not GUI or GUIDE_HIDDEN.exists():
        return 0
    time.sleep(5)               # the checklist starts a few seconds earlier
    while checklist_open():
        time.sleep(5)
    import evenkeel_os_panel
    return evenkeel_os_panel.run(sys.modules[__name__], "guide", first_login=True)


def main(argv):
    page = next((a.split("=", 1)[1] for a in argv[1:2] if a.startswith("--page=")), None)
    if GUI and (len(argv) == 1 or page):
        import evenkeel_os_panel
        return evenkeel_os_panel.run(sys.modules[__name__], page or "overview")
    if len(argv) > 1:
        if argv[1:] == ["setup", "--first-login"]:
            return setup_checklist(first_login=True)
        if argv[1:] == ["guide", "--first-login"]:
            return guide_at_login()
        if argv[1:] == ["rolled-back", "--at-login"]:
            return max(rolled_back_note(), settings_note())
        if argv[1:2] == ["restart-question"] and len(argv) == 4 and argv[3] in ("first", "last"):
            return restart_question(argv[2], argv[3])
        for key, name, _about, fn in TOOLS:
            if argv[1] == key and len(argv) == 2:
                ui.TITLE = _(name)     # its windows carry its own name, not Wheelhouse's
                return fn()
        print(__doc__)
        return 2
    i = choose(_("Which tool do you want?"), [_("Tool"), _("What it does")],
               [[_(name), _(about)] for _key, name, about, _fn in TOOLS], width=900, height=500)
    return TOOLS[i][3]() if i is not None else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
