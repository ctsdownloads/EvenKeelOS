[Desktop Entry]
Type=Application
Name=New to EvenKeelOS at login
Comment=Opens New to EvenKeelOS at login, after the setup checklist, until its Don't show this again box is ticked
Exec=/usr/bin/evenkeel-os-tools guide --first-login
Terminal=false
NoDisplay=true
OnlyShowIn=GNOME;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=25
