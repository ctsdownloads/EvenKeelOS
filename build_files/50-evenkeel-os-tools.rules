// No password for a local, active wheel user running evenkeel-os-tools-safe; the rest asks.
polkit.addRule(function(action, subject) {
    if (action.id == "io.github.ctsdownloads.evenkeel-os.tools.safe" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
