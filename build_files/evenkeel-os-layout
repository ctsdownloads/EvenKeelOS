#!/usr/bin/python3 -I
"""Switch this user's desktop layout.

  evenkeel-os-layout windows   bottom bar and start menu
  evenkeel-os-layout current   top bar and Logo Menu
  evenkeel-os-layout           print the layout in use
"""
import ast
import subprocess
import sys

sys.path.insert(0, "/usr/lib/evenkeel-os")
from evenkeel_os_ui import _  # noqa: E402

LAYOUTS = {"current": ["logomenu@aryan_k"],
           "windows": ["arcmenu@arcmenu.com", "dash-to-panel@jderose9.github.com"]}
OURS = {uuid for uuids in LAYOUTS.values() for uuid in uuids}
KEY = ["org.gnome.shell", "enabled-extensions"]


def enabled():
    out = subprocess.run(["gsettings", "get", *KEY], capture_output=True, text=True, check=True).stdout
    return ast.literal_eval(out.removeprefix("@as ").strip())


def main():
    now = enabled()
    if len(sys.argv) == 1:
        print("windows" if set(LAYOUTS["windows"]) <= set(now) else "current")
        return
    if len(sys.argv) != 2 or sys.argv[1] not in LAYOUTS:
        sys.exit(__doc__)
    # Keep any extensions the user turned on themselves.
    new = [uuid for uuid in now if uuid not in OURS] + LAYOUTS[sys.argv[1]]
    subprocess.run(["gsettings", "set", *KEY, str(new)], check=True)
    # Translators: {layout} is a layout keyword that stays English: windows or current
    print(_("Layout set to {layout}. Log out and back in to finish.").format(layout=sys.argv[1]))


if __name__ == "__main__":
    main()
