[Desktop Entry]
Type=Application
Name=Automatic rollback note
Comment=Says once at login that the computer went back to the previous version or put back settings by itself
Exec=/usr/bin/evenkeel-os-tools rolled-back --at-login
Terminal=false
NoDisplay=true
OnlyShowIn=GNOME;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=10
