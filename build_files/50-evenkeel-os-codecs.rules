// No password for a local, active wheel user running the codecs helper (web, full or skip only).
polkit.addRule(function(action, subject) {
    if (action.id == "io.github.ctsdownloads.evenkeel-os.codecs.setup" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
