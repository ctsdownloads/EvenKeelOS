#!/bin/bash
# A new language was picked in Settings or for the computer: fetch Flatpak apps' translations for it now,
# not at the next daily update.
set -euo pipefail
state=/var/lib/evenkeel-os/flatpak-languages
# Each account's language, and the computer's (Flatpak reads both); either may be missing.
now=$({ sed -n 's/^Language=//p' /var/lib/AccountsService/users/* 2>/dev/null || true
        sed -n 's/^LANG=//p' /etc/locale.conf 2>/dev/null || true; } | sort -u | tr '\n' ' ')
[ "$now" != "$(cat "$state" 2>/dev/null)" ] || exit 0
mapfile -t refs < <(flatpak list --system --columns=ref | grep '\.Locale/' || true)
# Updating a translations package adds the languages Flatpak now reads from every account's settings.
[ "${#refs[@]}" -eq 0 ] || flatpak update --system --noninteractive "${refs[@]}"
install -Dm644 /dev/stdin "$state" <<< "$now"
