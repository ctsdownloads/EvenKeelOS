#!/usr/bin/bash
# System Update: run uupd now with a progress window, or follow the automatic update if it's running.
set -u
export TEXTDOMAIN=evenkeel-os
title=$(gettext "System Update")
MANUAL=uupd-manual.service
SERVICE=$MANUAL
AUTO=uupd.service
HELPER=/usr/libexec/evenkeel-os-update-helper
# Started from Wheelhouse: windows show inside it, through the same options and answers as zenity's.
zenity=zenity; [ -n "${EVENKEEL_OS_PANEL:-}" ] && zenity=/usr/libexec/evenkeel-os-dialog

staged() {   # is a new system image waiting for a restart?
  "$HELPER" staged
}

# The updater's own summary of what failed, from this run's log ("1 update module(s) failed: ...").
failed_parts() {
  can_read_log || return 0
  journalctl -u "$SERVICE" --since "$1" -o cat | "$HELPER" failed-parts
}

can_read_log() { id -nG | grep -qwE 'wheel|adm|systemd-journal'; }

# Is the automatic update running? (A service waiting to retry after a failure is not running.)
auto_running() {
  [ "$(systemctl show -p ActiveState --value "$AUTO")" = activating ] &&
    [ "$(systemctl show -p SubState --value "$AUTO")" != auto-restart ]
}
# Did our start fail because the automatic update held uupd's lock?
lost_to_auto() {
  auto_running && return 0
  can_read_log && journalctl -u "$MANUAL" --since "$1" -o cat | grep -q 'already running'
}
# Wait for the automatic update to finish; its result as an exit code.
follow_auto() {
  while auto_running; do sleep 2; done
  [ "$(systemctl show -p Result --value "$AUTO")" = success ]
}
# The manual service retries on failure, so start it without waiting and watch its start job.
manual_job() { [ -n "$(systemctl show -p Job --value "$MANUAL")" ]; }
manual_retrying() { [ "$(systemctl show -p SubState --value "$MANUAL")" = auto-restart ]; }
# Start the update, or follow the automatic one; sets SERVICE.
run_update() {
  if ! auto_running; then
    systemctl start --no-block "$MANUAL" || return 1
    lost=""
    while manual_job; do
      if manual_retrying && lost_to_auto "$1"; then
        # the automatic update holds the lock and is doing the same work: cancel the manual retry, follow it
        systemctl stop "$MANUAL"
        lost=1; break
      fi
      sleep 2
    done
    if [ -z "$lost" ]; then
      [ "$(systemctl show -p Result --value "$MANUAL")" = success ] && return 0
      # (systemd versions that end the start job at the first failure, before the retry)
      lost_to_auto "$1" || return 1
      systemctl stop "$MANUAL"
    fi
  fi
  SERVICE=$AUTO
  echo "$AUTO" > "${followfile:-/dev/null}"
  follow_auto
}

start=$(date '+%Y-%m-%d %H:%M:%S')
# Battery charge, if on battery and below uupd's bat-min-percent (default 20).
battery=""; auto_running || battery=$("$HELPER" low-battery)

if ! command -v zenity >/dev/null 2>&1 || [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
  [ -n "$battery" ] && printf '%s\n' "$(printf "$(gettext "The battery is at %s%%. Plug the computer in: if it runs out during the update, the update is lost.")" "$battery")"
  gettext "Updating the system, apps and containers. This can take a while."; echo
  auto_running && { gettext "The automatic update is already running. Following it until it is done."; echo; }
  run_update "$start"; rc=$?
  failed=$(failed_parts "$start")
  if [ "$rc" -ne 0 ] && [ -n "$failed" ]; then printf '%s\n' "$(printf "$(gettext "Updated, except: %s")" "$failed")"
  elif [ "$rc" -ne 0 ]; then
    # Translators: %s is a systemd service name
    printf '%s\n' "$(printf "$(gettext "The update did not finish. Details: journalctl -u %s")" "$SERVICE")"; exit 1
  else gettext "Done."; echo; fi
  staged && { gettext "A new system is ready. Restart to use it."; echo; }
  exit 0
fi

# Turn uupd's and rpm-ostree's log lines into plain progress text and bar moves.
steps() {   # $1: the updater service to follow
  journalctl -f -n 0 -o cat -u "$1" | "$HELPER" progress
}

if [ -n "$battery" ]; then
  "$zenity" --question --title="$title" --width=480 --ok-label="$(gettext "Update anyway")" --cancel-label="$(gettext "Not now")" \
    --text="$(printf "$(gettext "The battery is at %s%% and the computer isn't plugged in. If the battery runs out during the update, the update is lost and has to start again.\n\nRecommended: Not now. Plug the computer in, then start System Update again.\n\nOr Update anyway.")" "$battery")" \
    || exit 0
fi

pulse=(); can_read_log || pulse=(--pulsate)     # no log to follow: keep the bar moving
rcfile=$(mktemp); followfile=$(mktemp)
following=$(gettext "The automatic update is already running, so this window follows it until it's done. You can keep working.")
text=$(gettext "Updating everything: the system, your apps and the app boxes. This can take a while. You can keep working.")
auto_running && text=$following
(
  stop_steps() { [ -n "${spid:-}" ] && { pkill -P "$spid" 2>/dev/null; kill "$spid" 2>/dev/null; }; spid=""; }
  if auto_running; then
    switched=1      # following it from the start: the window already says so
    if can_read_log; then steps "$AUTO" & spid=$!; fi
  elif can_read_log; then
    steps "$MANUAL" & spid=$!; sleep 1
  fi
  run_update "$start" &
  upid=$!
  # The automatic update may have started first: then switch to following it
  while kill -0 "$upid" 2>/dev/null; do
    if [ -s "$followfile" ] && [ -z "${switched:-}" ]; then
      switched=1; stop_steps
      echo "# $following"
      can_read_log && { steps "$AUTO" & spid=$!; }
    fi
    sleep 1
  done
  wait "$upid"; echo $? > "$rcfile"
  stop_steps
  echo 100
) | "$zenity" --progress "${pulse[@]}" --auto-close --no-cancel --title="$title" --width=480 \
      --text="$text"
rc=1; [ -s "$rcfile" ] && rc=$(cat "$rcfile"); rm -f "$rcfile"
[ -s "$followfile" ] && SERVICE=$AUTO; rm -f "$followfile"

# Also notify, in case the window is behind others.
notify() { command -v notify-send >/dev/null 2>&1 && notify-send --app-name="$title" --icon=software-update-available-symbolic "$title" "$1"; }

failed=""; [ "$rc" -ne 0 ] && failed=$(failed_parts "$start")
if [ "$rc" -ne 0 ] && [ -z "$failed" ]; then
  notify "$(gettext "The update didn't finish.")"
  "$zenity" --error --title="$title" --width=480 \
    --text="$(gettext "The update didn't finish. Nothing is broken: your computer keeps running the version it has.\n\nTry again later.")"
  exit 1
fi
note=""; [ -n "$failed" ] && note="$(printf "$(gettext "Everything updated except: %s. Nothing is broken. It tries again at the next update.")" "$failed")\n\n"
# Boxes did not update: offer to check the app boxes from Install Package File and repair one that is broken.
if [[ "$failed" == *Distroboxes* ]] && [ -x /usr/bin/evenkeel-os-packages ]; then
  "$zenity" --question --title="$title" --width=480 --ok-label="$(gettext "Check the boxes")" --cancel-label="$(gettext "Not now")" \
    --text="$(gettext "Some app boxes didn't update.\n\nRecommended: Check the boxes. It checks them and repairs one that's broken. Your files aren't touched.\n\nOr Not now.")" \
    && /usr/bin/evenkeel-os-packages repair --if-broken
fi
if staged; then
  ready=$(gettext "A new system is ready. Restart to use it.")
  [ -n "$failed" ] && ready="$(printf "$(gettext "Everything updated except: %s.")" "$failed") $ready"
  notify "$ready"
  # What the new version changes: titles from its changes.txt, minus what's already here, at most 8.
  new=$("$HELPER" whats-new); [ -n "$new" ] && new="\n\n$new"
  "$zenity" --question --title="$title" --width=560 --ok-label="$(gettext "Restart now")" --cancel-label="$(gettext "Later")" \
    --text="${note}$(gettext "A new system is ready.")$new\n\n$(gettext "Recommended: Restart now to start using it. Or Later, if you're in the middle of something.")" && systemctl reboot
elif [ -n "$failed" ]; then
  notify "$(printf "$(gettext "Everything updated except: %s")" "$failed")"
  "$zenity" --warning --title="$title" --width=480 --text="${note%\\n\\n}"
else
  done_text=$(gettext "Done. Everything is up to date.")
  notify "$done_text"
  "$zenity" --info --title="$title" --text="$done_text"
fi
