<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>EvenKeelOS</vendor>
  <vendor_url>https://github.com/ctsdownloads/EvenKeelOS</vendor_url>

  <!-- Wheelhouse: automatic updates, disk unlock and the rollback tests. Admin password. -->
  <action id="io.github.ctsdownloads.evenkeel-os.tools">
    <description>Change a Wheelhouse setting</description>
    <message>Authentication is required to change a Wheelhouse setting</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/evenkeel-os-tools-admin</annotate>
  </action>

  <!-- Wheelhouse's settings repair test really deletes important settings: the admin password every time. -->
  <action id="io.github.ctsdownloads.evenkeel-os.settings-test">
    <description>Delete important settings to test the settings repair</description>
    <message>Authentication is required to delete important settings for the repair test</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/evenkeel-os-settings-test</annotate>
  </action>

  <!-- Certificate alerts: removing a certificate added to this computer. The admin password every time. -->
  <action id="io.github.ctsdownloads.evenkeel-os.cert-remove">
    <description>Remove a certificate added to this computer from its trusted list</description>
    <message>Authentication is required to remove a trusted certificate</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/evenkeel-os-cert-remove</annotate>
  </action>

  <!-- Boot options: kernel settings the computer starts with. The admin password every time. -->
  <action id="io.github.ctsdownloads.evenkeel-os.boot-options">
    <description>Change the kernel settings the computer starts with</description>
    <message>Authentication is required to change the boot options</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/evenkeel-os-boot-options</annotate>
  </action>

  <!-- Harmless Wheelhouse jobs: 50-evenkeel-os.rules lets an admin at the computer skip the password. -->
  <action id="io.github.ctsdownloads.evenkeel-os.tools.safe">
    <description>Turn on automatic updates or automatic disk unlock, or free up disk space</description>
    <message>Authentication is required to change a Wheelhouse setting</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/evenkeel-os-tools-safe</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
