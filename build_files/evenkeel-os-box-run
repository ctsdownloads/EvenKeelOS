#!/usr/bin/bash
# Start a box app with its output in a log (so it can't crash on a closed link), or --stop it.
set -u
export TEXTDOMAIN=evenkeel-os
STATE="${XDG_RUNTIME_DIR:-/tmp}/evenkeel-os-box-apps"

tree() {   # a process and all its children, children first
  local c
  for c in $(pgrep -P "$1" 2>/dev/null); do tree "$c"; done
  echo "$1"
}

# Quitting from the dock takes a few seconds; say so.
quit_notice() {
  local name="" f
  for f in "$HOME"/.local/share/applications/*.desktop; do
    grep -q -- "--stop $1\$" "$f" 2>/dev/null || continue
    name=$(sed -n 's/^Name=//p' "$f" | head -1); break
  done
  name=${name:-$1}
  command -v notify-send >/dev/null 2>&1 && notify-send --app-name="$name" --icon=application-exit-symbolic \
    "$(printf "$(gettext "Quitting %s")" "$name")" \
    "$(printf "$(gettext "Stopping %s in its box. This takes a few seconds. If GNOME shows a Force Quit / Wait window, you do not need to press anything: %s closes on its own.")" "$name" "$name")"
}

stop_key() {
  local f pid pids=""
  for f in "$STATE/$1".*.pid; do
    [ -s "$f" ] || continue
    pid=$(cat "$f")
    kill -0 "$pid" 2>/dev/null && pids="$pids $(tree "$pid" | tr '\n' ' ')"
    rm -f "$f"
  done
  [ -n "$pids" ] || return 0
  [ -n "${EVENKEEL_QUIET:-}" ] || quit_notice "$1"
  kill -TERM $pids 2>/dev/null
  for _ in $(seq 20); do
    kill -0 $pids 2>/dev/null || return 0
    sleep 0.5
  done
  kill -KILL $pids 2>/dev/null
  return 0
}

if [ "${1:-}" = --stop ]; then
  [ -n "${2:-}" ] || { echo "usage: evenkeel-os-box-run --stop KEY"; exit 2; }
  stop_key "$2"
  exit 0
fi
[ "$#" -ge 2 ] || { echo "usage: evenkeel-os-box-run BOX COMMAND [ARGS...]"; exit 2; }

box=$1; shift
key=$(basename "$1")
mkdir -p "$STATE"
pidf="$STATE/$key.$$.pid"
log="$HOME/.cache/evenkeel-os/logs/$key.log"
mkdir -p "${log%/*}"
[ -f "$log" ] && [ "$(stat -c %s "$log")" -gt 5000000 ] && mv -f "$log" "$log.old"

trap 'stop_key "$key"; exit 0' TERM INT HUP
# Record the process ID, then become the app with its output going to the log.
env -u TEXTDOMAIN distrobox-enter -n "$box" -- env EVENKEEL_PID="$pidf" EVENKEEL_LOG="$log" \
  sh -c 'echo $$ > "$EVENKEEL_PID"; exec "$@" </dev/null >>"$EVENKEEL_LOG" 2>&1' sh "$@" </dev/null >/dev/null 2>&1 &
wait $!
rc=$?
# the link ended; forget the app only if it ended too (if it is still running, Quit must still find it)
[ -s "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null || rm -f "$pidf"
exit "$rc"
