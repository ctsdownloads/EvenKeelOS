[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/evenkeel-os/main-day.jpg'
picture-uri-dark='file:///usr/share/backgrounds/evenkeel-os/main-night.jpg'
picture-options='zoom'
primary-color='#0b2340'
secondary-color='#0b2340'
color-shading-type='solid'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/evenkeel-os/main-night.jpg'
picture-options='zoom'
primary-color='#0b2340'
secondary-color='#0b2340'
color-shading-type='solid'
