# Install the Flathub default apps; tries again every 15 minutes until they are in.
[Unit]
Description=Install the EvenKeelOS apps from Flathub
Wants=network-online.target
After=network-online.target evenkeel-os-flathub.service
ConditionPathExists=!/var/lib/evenkeel-os/flathub-apps-installed

[Service]
Type=oneshot
ExecStart=/usr/libexec/evenkeel-os-flathub-apps
ExecStartPost=/usr/bin/mkdir -p /var/lib/evenkeel-os
ExecStartPost=/usr/bin/touch /var/lib/evenkeel-os/flathub-apps-installed
Restart=on-failure
RestartSec=15min

[Install]
WantedBy=multi-user.target
