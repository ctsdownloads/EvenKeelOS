#!/bin/bash
# Add or remove the media codecs Fedora leaves out (patents). Run codecs with no option to see the choices.
set -uo pipefail
export TEXTDOMAIN=evenkeel-os
title=$(gettext "Install Media Codecs")

. /usr/libexec/evenkeel-os-codecs-lib.sh
SETUP=/usr/libexec/evenkeel-os-codecs-setup
ADMIN=/usr/libexec/evenkeel-os-codecs-admin
USTATE="${XDG_STATE_HOME:-$HOME/.local/state}/evenkeel-os"
# Started from Wheelhouse: windows show inside it, through the same options and answers as zenity's.
zenity=zenity; [ -n "${EVENKEEL_OS_PANEL:-}" ] && zenity=/usr/libexec/evenkeel-os-dialog
ARGS=("$@")
NO_RESTART=""   # set by --no-restart: the installed window doesn't offer a restart (the setup checklist does)

say() { printf '%s\n' "$*"; }

run_helper() {   # $1 = web, full, remove or skip
  if [ "$(id -u)" -eq 0 ]; then "$ADMIN" "$1"; return; fi          # already root, for example via sudo
  command -v pkexec >/dev/null 2>&1 || { say "$(gettext "pkexec is missing. Run this with sudo instead.")"; return 1; }
  case "$1" in
    web|full) pkexec "$SETUP" "$1" ;;                       # fixed packages: no password (see the rules file)
    skip)     window_open && pkexec "$SETUP" skip ;;        # closes the first-time window
    *)        pkexec "$ADMIN" "$1" ;;                       # remove: administrator password
  esac
}

explain() {
  say "$(gettext "Some audio and video formats are covered by patents in some countries.
Fedora, and this image, leave them out. Installing them is your choice and your
responsibility.")"
  say
  say "$(gettext "Two choices:")"
  say "$(gettext "  codecs web   Web video in Firefox only. Replaces Fedora's empty OpenH264 stand-in with
               Cisco's OpenH264 from Fedora's Cisco repository, under Cisco's own H.264
               patent license.
  codecs full  Everything. Replaces Fedora's free ffmpeg libraries with the full ffmpeg,
               x264 and x265 from RPM Fusion, the source standard Fedora uses.")"
  say
  say "$(gettext "Either choice installs with no password on an administrator account. Taking them out asks for it.
Restart afterwards. To take them out again: codecs remove")"
}

ask() {   # prints web or full, or nothing for "Not now"
  local note out rc
  note=$(gettext "Either choice installs with no password.")
  everything=$(gettext "Everything")
  out=$("$zenity" --question --title="$title" --width=600 \
        --ok-label="$(gettext "Web video only")" --extra-button="$everything" --cancel-label="$(gettext "Not now")" \
        --text="$(gettext "Some video formats (like most web video) need extra codecs that Fedora, and this system, leave out because of patents in some countries. Installing them is your choice and your responsibility.\n\nWeb video only: lets Firefox play most web video. A small addition to the system.\n\nEverything: plays all common video and audio, in every app. It replaces some parts of the system, so system updates take a little longer.\n\nNot now: they're in Wheelhouse, Apps, Media codecs, any time.\n\nPick by what you need. If you only watch video in Firefox, Web video only is enough.")\n\n$note" 2>/dev/null); rc=$?
  if [ "$rc" -eq 0 ]; then say web; elif [ "$out" = "$everything" ]; then say full; fi
}

install_with_window() {   # $1 = web or full
  local log pid rc; log=$(mktemp)
  run_helper "$1" >"$log" 2>&1 &
  pid=$!
  ( while kill -0 "$pid" 2>/dev/null; do echo; sleep 1; done; echo 100 ) | \
    "$zenity" --progress --pulsate --auto-close --no-cancel --title="$title" --text="$(gettext "Installing the codecs. This can take a few minutes.")"
  wait "$pid"; rc=$?
  if [ "$rc" -eq 0 ] && [ -n "$NO_RESTART" ]; then     # the setup checklist offers the restart
    "$zenity" --info --title="$title" --width=480 \
      --text="$(gettext "The codecs are installed. They start working after a restart, which the setup checklist offers at its end.")"
  elif [ "$rc" -eq 0 ]; then
    "$zenity" --question --title="$title" --ok-label="$(gettext "Restart now")" --cancel-label="$(gettext "Later")" \
      --text="$(gettext "The codecs are installed.\n\nRecommended: Restart now to start using them. Or Later.")" && systemctl reboot
  else
    "$zenity" --error --title="$title" --width=520 \
      --text="$(gettext "It didn't work, and nothing was changed.")\n\n$(sed -n '/^error:/,$p' "$log" | head -n 10 | head -c 900)\n\n$(gettext "Try again later.")"
  fi
  rm -f "$log"
}

gui() {
  command -v zenity >/dev/null 2>&1 || { say "$(gettext "zenity is missing. Use the typed commands instead: run  codecs")"; exit 1; }
  local choice; choice=$(ask)
  if [ -n "$choice" ]; then install_with_window "$choice"
  elif window_open; then run_helper skip >/dev/null; fi      # "Not now" closes the setup window
  return 0
}

first_login() {
  command -v zenity >/dev/null 2>&1 || exit 0
  window_open || exit 0
  [ -e "$USTATE/codecs-asked" ] && exit 0
  mkdir -p "$USTATE" && : > "$USTATE/codecs-asked"
  gui
}

mode=explain
for a in "${ARGS[@]}"; do
  case "$a" in
    web|--web) mode=web ;; full|--full) mode=full ;; remove|--remove) mode=remove ;;
    gui|--gui) mode=gui ;; --first-login) mode=first ;; --no-restart) NO_RESTART=1 ;; --apply) ;; -h|--help|help) mode=explain ;;
    *) say "$(printf "$(gettext "Unknown option: %s. Run  codecs  to see the choices.")" "$a")"; exit 2 ;;
  esac
done
case "$mode" in
  explain) explain ;;
  web)     run_helper web ;;
  full)    run_helper full ;;
  remove)  run_helper remove ;;
  gui)     gui ;;
  first)   first_login ;;
esac
