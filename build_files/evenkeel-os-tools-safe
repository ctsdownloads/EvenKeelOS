#!/usr/bin/python3 -I
"""System Tools jobs an administrator at the computer runs without a password, as root through polkit.

  evenkeel-os-tools-safe updates on|pause|resume   (pause: 3 days, after an undo)
  evenkeel-os-tools-safe disk-unlock on|off      (the disk password on standard input)
  evenkeel-os-tools-safe free-space
"""
import importlib.machinery
import importlib.util
import os
import subprocess
import sys
import time
from pathlib import Path

ADMIN = "/usr/libexec/evenkeel-os-tools-admin"
FAILURES = Path("/var/lib/evenkeel-os/disk-password-wrong")    # the times of recent wrong disk passwords
PAUSE = Path("/var/lib/evenkeel-os/updates-paused-until")      # read by evenkeel-os-updates-pause-check
PAUSE_DAYS = 3
MAX_WRONG, WINDOW = 5, 3600


def recent_wrong():
    now = time.time()
    try:
        times = [float(x) for x in FAILURES.read_text().split()]
    except (OSError, ValueError):
        times = []
    return [t for t in times if now - WINDOW < t <= now]


def disk_unlock(state):
    wrong = recent_wrong()
    if len(wrong) >= MAX_WRONG:
        print("Too many wrong disk passwords. Try again in an hour.")
        return 4
    try:
        admin().disk_unlock(state)
        rc = 0
    except SystemExit as e:
        rc = e.code if isinstance(e.code, int) else 1
    if rc == 3:             # wrong disk password
        FAILURES.parent.mkdir(parents=True, exist_ok=True)
        FAILURES.write_text(" ".join(str(t) for t in wrong + [time.time()]))
    elif rc == 0:
        FAILURES.unlink(missing_ok=True)
    return rc


def admin():
    loader = importlib.machinery.SourceFileLoader("evenkeel_os_tools_admin", ADMIN)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main(argv):
    if os.geteuid() != 0:
        print("This helper runs as root, through polkit.")
        return 1
    if argv[1:] == ["updates", "on"]:
        PAUSE.unlink(missing_ok=True)
        return subprocess.run(["systemctl", "enable", "--now", "uupd.timer"]).returncode
    if argv[1:] == ["updates", "pause"]:
        PAUSE.parent.mkdir(parents=True, exist_ok=True)
        PAUSE.write_text(f"{int(time.time()) + PAUSE_DAYS * 86400}\n")
        return 0
    if argv[1:] == ["updates", "resume"]:
        PAUSE.unlink(missing_ok=True)
        return 0
    if len(argv) == 3 and argv[1] == "disk-unlock" and argv[2] in ("on", "off"):
        return disk_unlock(argv[2])
    if argv[1:] == ["free-space"]:
        rc = subprocess.run(["rpm-ostree", "cleanup", "-bm"]).returncode
        subprocess.run(["flatpak", "uninstall", "--system", "--unused", "-y", "--noninteractive"])
        return rc
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
