#!/usr/bin/python3 -I
"""Add or remove an app's hardware rules (udev) on the system, as root through polkit.

  evenkeel-os-hwrules add PACKAGE RULEFILE...
  evenkeel-os-hwrules remove PACKAGE
"""
import os
import re
import stat
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/evenkeel-os")
from evenkeel_os_ui import PACKAGE_NAME, _, fail, first_line, write_file  # noqa: E402

RULES = Path("/etc/udev/rules.d")
FILE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}\.rules$")
RUNS_PROGRAM = re.compile(r"\bRUN\b(?!\{builtin\})|\bPROGRAM\b|IMPORT\{program\}")   # RUN{builtin} stays in udev
# Access changes (MODE, OWNER, GROUP, uaccess) are allowed only for these device kinds: never disks or memory.
SUBSYSTEMS_OK = {"usb", "usbmisc", "hidraw", "hid", "input", "tty", "sound", "video4linux", "media", "i2c-dev", "gpio",
                 "drm", "dri", "leds", "bluetooth", "misc"}
KERNELS_OK = ("hidraw", "tty", "uinput", "uhid", "js", "event", "mouse", "i2c-", "gpiochip", "card", "renderD",
              "video", "media", "v4l-", "snd", "controlC", "pcm", "hiddev", "usb", "bus/usb")
GRANTS = re.compile(r"\b(MODE|OWNER|GROUP)\s*:?=(?!=)|TAG\s*\+=\s*\"uaccess\"")
SUBSYSTEM = re.compile(r'\bSUBSYSTEM\s*==\s*"([^"]*)"')
KERNEL = re.compile(r'\bKERNEL\s*==\s*"([^"]*)"')
# Keyboards and mice can be read through these, so a rule for them must name the device maker.
READS_KEYS = {"usb", "usbmisc", "hidraw", "hid", "input"}
READS_KEYS_NAMES = ("hidraw", "js", "event", "mouse", "hiddev", "usb", "bus/usb")
ONE_MAKER = re.compile(r'\bATTRS?\{idVendor\}\s*==\s*"[0-9A-Fa-f]{4}"'
                       r'|\bKERNELS\s*==\s*"[^"]*(?:[0-9A-Fa-f]{4}|:[0-9A-Fa-f]{4}):')
FLAG_SET = re.compile(r'\bENV\{(\w+)\}\s*=\s*"')
FLAG_TEST = re.compile(r'\bENV\{(\w+)\}\s*==\s*"')
GUARD = re.compile(r'\bSUBSYSTEM\s*!=\s*"([^"]*)"\s*,.*\bGOTO\s*=\s*"([^"]+)"')
LABEL = re.compile(r'\bLABEL\s*=\s*"([^"]+)"')


def unwrapped(text):
    """A rule file with its continued lines (ending in a backslash) joined."""
    return re.sub(r"\\\n", " ", text)


def runs_program(text):
    """Whether a rule file starts a program (Install Package File asks this too)."""
    return any(RUNS_PROGRAM.search(line) for line in unwrapped(text).splitlines() if not line.lstrip().startswith("#"))


def kinds_ok(subsystems, kernels):
    """Only allowed device kinds; misc (which holds device-mapper and kvm) only with an allowed device name."""
    subs = [k for v in subsystems for k in v.split("|")]
    names = [k for v in kernels for k in v.split("|")]
    if not all(k in SUBSYSTEMS_OK for k in subs) or not all(k.startswith(KERNELS_OK) for k in names):
        return False
    return "misc" not in subs or bool(names)


def grants_storage(text):
    """Does a rule give access to a device that isn't one of the allowed kinds (a disk, for one)?"""
    guard = None                  # the label a 'SUBSYSTEM!="usb", GOTO=...' line skips to
    flags = set()                 # ENV flags set only on lines that name a device maker
    unnamed = set()               # ENV flags set anywhere else
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = LABEL.search(line)
        if m and m.group(1) == guard:
            guard = None
        m = GUARD.search(line)
        if m and kinds_ok([m.group(1)], []) and "misc" not in m.group(1):
            guard = m.group(2)
            continue
        for f in FLAG_SET.findall(line):
            (flags if ONE_MAKER.search(line) else unnamed).add(f)
        if not GRANTS.search(line):
            continue
        subsystems, kernels = SUBSYSTEM.findall(line), KERNEL.findall(line)
        if (subsystems or kernels) and not kinds_ok(subsystems, kernels):
            return True
        if ONE_MAKER.search(line) or any(f in flags and f not in unnamed for f in FLAG_TEST.findall(line)):
            continue
        subs = {k for v in subsystems for k in v.split("|")}
        names = [k for v in kernels for k in v.split("|")]
        if not subsystems and not kernels and guard is None:
            return True           # no device kind: it would match every device, disks too
        if subs & READS_KEYS or any(n.startswith(READS_KEYS_NAMES) for n in names) or not (subs or names):
            return True           # every keyboard or mouse, which lets programs read what is typed
    return False


def marker(pkg):
    return f"# evenkeel-os-package: {pkg}\n"


def ours(path, pkg):
    return first_line(path) == marker(pkg)


def reload():
    """Apply the rules now; when udev can't, they still apply from the next start."""
    for args in (["control", "--reload"], ["trigger", "--action=change"]):
        if subprocess.run(["/usr/bin/udevadm", *args]).returncode != 0:
            print(f"udevadm {args[0]} failed; the rules apply from the next start")
            return


def add(pkg, files):
    texts = {}
    for f in files:
        name = os.path.basename(f)
        if not FILE.match(name):
            fail(_("Not a rule file name: {name}").format(name=name))
        try:            # never through a shortcut (symlink): read only the plain file itself
            fd = os.open(f, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        except OSError:
            fail(_("{name} can't be read, or is a shortcut to another file.").format(name=name))
        with os.fdopen(fd, "rb") as fh:
            st = os.fstat(fh.fileno())
            if not stat.S_ISREG(st.st_mode):
                fail(_("{name} is not a plain file.").format(name=name))
            if st.st_size > 64 * 1024:
                fail(_("{name} is too large for a hardware rule.").format(name=name))
            try:
                text = fh.read(64 * 1024 + 1).decode("utf-8")
            except UnicodeDecodeError:
                fail(_("{name} is not a text file.").format(name=name))
        if runs_program(text):
            fail(_("{name} runs a program, so it is not added.").format(name=name))
        if grants_storage(unwrapped(text)):
            fail(_("{name} could give access to disks, other system devices or every keyboard, "
                   "so it is not added.").format(name=name))
        target = RULES / name
        if target.exists() and not ours(target, pkg):
            fail(_("{path} already exists and belongs to something else.").format(path=target))
        texts[name] = text
    if not texts:
        fail(_("No rule files given."))
    for name, text in texts.items():
        write_file(RULES / name, marker(pkg) + "# Added by Install Package File. Remove it with Remove Apps.\n" + text)
        print(f"Added {RULES / name}")
    reload()


def remove(pkg):
    for path in sorted(RULES.glob("*.rules")):
        if ours(path, pkg):
            path.unlink()
            print(f"Removed {path}")
    reload()


def main(argv):
    if os.geteuid() != 0:
        fail("This helper runs through polkit (pkexec).")
    if len(argv) >= 3 and argv[1] in ("add", "remove") and PACKAGE_NAME.fullmatch(argv[2]):
        if argv[1] == "add" and len(argv) > 3:
            add(argv[2], argv[3:])
            return 0
        if argv[1] == "remove" and len(argv) == 3:
            remove(argv[2])
            return 0
    print(__doc__.split("\n\n")[1])
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
