[Desktop Entry]
Type=Application
Name=System Tools
Comment=Every EvenKeelOS tool in one place: updates, apps, VPNs, disk and startup, layout, and help
Icon=applications-system-symbolic
Categories=System;Settings;
Keywords=firmware;bios;uefi;tpm;disk;unlock;space;clean;updates;update;upgrade;ujust;rollback;undo;logs;problem;report;rpm;deb;install;remove;apps;codecs;vpn;layout;control;panel;settings;
Exec=/usr/bin/evenkeel-os-tools
Terminal=false
StartupWMClass=io.github.ctsdownloads.evenkeel-os.Tools
