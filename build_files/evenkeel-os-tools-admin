#!/usr/bin/python3 -I
"""Wheelhouse jobs that change the system, as root through polkit (administrator password).

  evenkeel-os-tools-admin updates on|off
  evenkeel-os-tools-admin disk-unlock on|off      (the disk password on standard input)
  evenkeel-os-tools-admin disk-unlock check
  evenkeel-os-tools-admin test-rollback KIND      KIND: quick, no-login-screen, no-networking, stuck, login-loop,
                                                  freeze, sound, wifi, bluetooth, graphics, printing, firewall,
                                                  update-program, service
                                                  (exit 4: installed before greenboot, 5: an update is waiting,
                                                  6: this start is a test copy, 7: no list of what works yet,
                                                  8: nothing here to break, 9: the driver is built in)
  evenkeel-os-tools-admin test-rollback clear     take the test marker off the version running now
  evenkeel-os-tools-admin keep-update             keep the new version a failed startup check is asking about
  evenkeel-os-tools-admin firewall SERVICE on|off  SERVICE: ssh, ipp; on Home networks only
  evenkeel-os-tools-admin firewall default        a network with no place set is a Public place
  evenkeel-os-tools-admin sharing on|off          Shared folders, on Home networks only (exit 3: no password yet)
  evenkeel-os-tools-admin sharing add FOLDER ro|rw
  evenkeel-os-tools-admin sharing mode FOLDER ro|rw
  evenkeel-os-tools-admin sharing remove FOLDER
  evenkeel-os-tools-admin sharing password        the sharing password on standard input
  evenkeel-os-tools-admin sharing sync            run it if a Home network is connected, stop it if not
  evenkeel-os-tools-admin let-in PLACE app SERVICE        PLACE: home, work, public; SERVICE: a firewalld service
  evenkeel-os-tools-admin let-in PLACE ports LABEL PORT...  PORT: 8096/tcp or 2456-2458/udp, up to 20
  evenkeel-os-tools-admin let-in PLACE remove ID         take an app or ports back out (exit 3: refused)
  evenkeel-os-tools-admin let-in update          once, after the update: Work lets nothing in, like Public
"""
import fcntl
import json
import os
import pwd
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/evenkeel-os")
import evenkeel_os_health as health  # noqa: E402
import evenkeel_os_letin as letin  # noqa: E402
import evenkeel_os_network as net  # noqa: E402
import evenkeel_os_sharing as sharing  # noqa: E402
