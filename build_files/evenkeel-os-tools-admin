DISK_UNLOCK_ON = Path("/var/lib/evenkeel-os/disk-unlock-on")
# Switched on from /usr (build.sh), so deleting /etc can't switch it off; systemctl is-enabled only reads /etc.
GREENBOOT_ON = Path("/usr/lib/systemd/system/multi-user.target.wants/greenboot-healthcheck.service")
# Extra kernel arguments the running test copy was made with (a driver block), taken off with its marker.
TEST_ARGS = Path("/var/lib/evenkeel-os/test-rollback-args")
UUID = re.compile(r"^[0-9a-fA-F-]{36}$")
FIREWALL_SERVICES = ("ssh", "ipp")             # the Network safety switches: SSH, Share my printer
SWITCHED_ZONES = ("evenkeel-home",)


def fail(msg, code=1):
    print(msg)
    sys.exit(code)


def disk():
    for a in Path("/proc/cmdline").read_text().split():
        if a.startswith("rd.luks.uuid="):
            v = a.split("=", 1)[1]
            v = v[5:] if v.startswith("luks-") else v
            if UUID.match(v) and Path(f"/dev/disk/by-uuid/{v}").exists():
                return f"/dev/disk/by-uuid/{v}"
            fail("The encrypted disk named at startup was not found.")
    fail("The system disk is not encrypted.")


def tpm_enrolled(dev):
    """Does the disk's LUKS header hold a TPM enrollment? None when the header can't be read."""
    r = subprocess.run(["/usr/sbin/cryptsetup", "luksDump", "--dump-json-metadata", dev],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        tokens = json.loads(r.stdout).get("tokens", {})
    except ValueError:
        return None
    return any(t.get("type") == "systemd-tpm2" for t in tokens.values())


def mark(on):
    if on:
        DISK_UNLOCK_ON.parent.mkdir(parents=True, exist_ok=True)
        DISK_UNLOCK_ON.write_text("TPM2 unlock enrolled (checked against the disk)\n")
    else:
        DISK_UNLOCK_ON.unlink(missing_ok=True)


def disk_unlock_check():
    dev = None
    for a in Path("/proc/cmdline").read_text().split():
        if a.startswith("rd.luks.uuid="):
            v = a.split("=", 1)[1]
            v = v[5:] if v.startswith("luks-") else v
            if UUID.match(v) and Path(f"/dev/disk/by-uuid/{v}").exists():
                dev = f"/dev/disk/by-uuid/{v}"
    if dev is None:             # no encrypted system disk: nothing to unlock
        mark(False)
        return
    on = tpm_enrolled(dev)
    if on is not None:          # leave the note alone if the header couldn't be read
        mark(on)
    print("on" if on else "off" if on is not None else "unknown")


def updates(state):
    cmd = ["/usr/bin/systemctl", "enable", "--now", "uupd.timer"] if state == "on" else \
        ["/usr/bin/systemctl", "disable", "--now", "uupd.timer"]
    sys.exit(subprocess.run(cmd).returncode)


def disk_unlock(state):
    dev = disk()
    pw = sys.stdin.read(4096)
    if not pw:
        fail("No disk password was given.")
    # A wrong password changes nothing: check it before anything else.
    if subprocess.run(["/usr/sbin/cryptsetup", "open", "--test-passphrase", "--key-file=-", dev], input=pw.encode(),
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        fail("That is not the disk password.", 3)
    env = {"PATH": "/usr/sbin:/usr/bin", "PASSWORD": pw}
    if state == "on":
        if not Path("/dev/tpmrm0").exists():
            fail("This computer has no TPM.")
        # Enrolls the TPM, then wipes any older TPM enrollment (the new one is kept).
        cmd = ["/usr/bin/systemd-cryptenroll", "--wipe-slot=tpm2", "--tpm2-device=auto", "--tpm2-pcrs=7+14", dev]
    else:
        cmd = ["/usr/bin/systemd-cryptenroll", "--wipe-slot=tpm2", dev]
    r = subprocess.run(cmd, env=env, stdin=subprocess.DEVNULL)
    if r.returncode != 0:
        fail("systemd-cryptenroll did not finish.")
    # Check the disk itself, not the command's exit code alone, and keep the note in step with it.
    on = tpm_enrolled(dev)
    mark(bool(on))
    if on is None:
        fail("The disk's settings couldn't be read back to check.")
    if on != (state == "on"):
        fail("The disk didn't take the change.")
    print("done")


TEST_KINDS = ("quick", "no-login-screen", "no-networking", "stuck", "login-loop", "freeze", "sound", "wifi",
              "bluetooth", "graphics", "printing", "firewall", "update-program", "service")


def running_test():
    """The test this start is running (its kernel argument), or None."""
    for arg in Path("/proc/cmdline").read_text().split():
        if arg.startswith("evenkeel_os.test_rollback="):
            return arg.split("=", 1)[1]
    return None


def test_rollback_clear():
    kind = running_test()
    if kind is None:
        fail("This start isn't a test copy.")
    try:
        extra = [a for a in json.loads(TEST_ARGS.read_text()) if isinstance(a, str)]
    except (OSError, ValueError, TypeError):
        extra = []
    running = Path("/proc/cmdline").read_text().split()
    cmd = ["/usr/bin/rpm-ostree", "kargs", f"--delete=evenkeel_os.test_rollback={kind}"]
    cmd += [f"--delete={a}" for a in extra if a in running]
    rc = subprocess.run(cmd).returncode
    if rc == 0:
        TEST_ARGS.unlink(missing_ok=True)
    sys.exit(rc)


def test_rollback(kind):
    """A copy of the running version that breaks on purpose (see build_files/greenboot), for the next restart."""
    masked = subprocess.run(["/usr/bin/systemctl", "is-enabled", "greenboot-healthcheck.service"],
                            capture_output=True, text=True).stdout.strip().startswith("masked")
    if not GREENBOOT_ON.exists() or masked:
        fail("Automatic rollback is not turned on in this version, or it was switched off (masked).", 4)
    try:
        counting = "boot_counter" in Path("/boot/grub2/grub.cfg").read_text()
    except OSError:
        counting = False
    if not counting:
        fail("The boot menu has no rollback counter: this computer was installed before automatic rollback.", 4)
    if running_test():
        fail("This start is a test copy; take its test marker off first.", 6)
    try:
        ds = json.loads(subprocess.run(["/usr/bin/rpm-ostree", "status", "--json"], capture_output=True, text=True,
                                       check=True).stdout)["deployments"]
    except (subprocess.CalledProcessError, ValueError, KeyError) as e:
        fail(f"The system versions couldn't be read: {e}")
    if any(d.get("staged") for d in ds):
        fail("An update is waiting for a restart.", 5)
    extra = health.test_args(kind)
    if extra == 7:
        fail("No list of what works has been saved yet: it is saved 4 minutes after a good start.", 7)
    if extra == 8:
        fail("This computer doesn't have what this test breaks, or it wasn't working at this start.", 8)
    if extra == 9:
        fail("The driver is built into the system, so it can't be blocked.", 9)
    TEST_ARGS.parent.mkdir(parents=True, exist_ok=True)
    TEST_ARGS.write_text(json.dumps(extra) + "\n")
    Path(health.LOST).unlink(missing_ok=True)
    cmd = ["/usr/bin/rpm-ostree", "kargs", f"--append=evenkeel_os.test_rollback={kind}"]
    sys.exit(subprocess.run(cmd + [f"--append={a}" for a in extra]).returncode)


def keep_update():
    """Answers the startup check that's asking before a restart (evenkeel_os_health.ask_first): this start passes."""
    boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    try:
        asked = Path(health.QUESTION).read_text().split("\n", 1)[0]
    except OSError:
        asked = ""
    if asked != boot:
        fail("No startup check is asking about a restart.")
    Path(health.KEEP).write_text(boot + "\n")
    print("done")


def let_in(service, state):
    """Home networks let the service in (on) or keep it out (off); saved and reloaded. "" when it worked."""
    for zone in SWITCHED_ZONES:
        flag = f"--{'add' if state == 'on' else 'remove'}-service={service}"
        r = subprocess.run(["/usr/bin/firewall-cmd", "--permanent", f"--zone={zone}", flag],
                           capture_output=True, text=True)
        if r.returncode != 0 and "ALREADY_ENABLED" not in r.stderr and "NOT_ENABLED" not in r.stderr:
            return f"The firewall didn't take the change: {r.stderr.strip()}"
    if subprocess.run(["/usr/bin/firewall-cmd", "--reload"], capture_output=True).returncode != 0:
        return "The firewall didn't reload."
    return ""


def firewall(service, state):
    """Switch a service on (it runs, and Home networks let it in) or off; both or neither."""
    problem = let_in(service, state)
    if problem:
        fail(problem)
    if service == "ssh":        # the SSH server, off in Fedora until switched on
        run = ["/usr/bin/systemctl", "enable" if state == "on" else "disable", "--now", "sshd.service"]
    else:                       # printers plugged into this computer, shared with the network or not
        run = ["/usr/bin/cupsctl", "--share-printers" if state == "on" else "--no-share-printers"]
    r = subprocess.run(run, capture_output=True, text=True)
    if r.returncode != 0:
        let_in(service, "off" if state == "on" else "on")       # put the firewall back as it was
        fail(f"{service} didn't change, so the firewall was left as it was: {(r.stderr or r.stdout).strip()}")


def firewall_default():
    r = subprocess.run(["/usr/bin/firewall-cmd", "--set-default-zone=evenkeel-public"], capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"The firewall didn't take the change: {r.stderr.strip()}")


USER = re.compile(r"^[a-z_][a-z0-9_.-]{0,31}$")
PEOPLE = range(1000, 60000)                    # people's accounts; root, system accounts and nobody can't share
WSDD_OPTIONS = Path("/run/evenkeel-os/wsdd")   # also the sign that Shared folders started Samba
IFACE = re.compile(r"^[A-Za-z0-9_.-]{1,15}$")
SHARING_LOCK = Path("/run/evenkeel-os/sharing.lock")


def caller():
    """The person who asked, through pkexec."""
    try:
        user = pwd.getpwuid(int(os.environ.get("PKEXEC_UID", "")))
    except (ValueError, KeyError):
        fail("Run this through pkexec, as yourself.")
    if user.pw_uid not in PEOPLE or not USER.match(user.pw_name):
        fail(_("This account can't share folders."))
    return user.pw_name


def save_sharing(state):
    tmp = sharing.STATE.with_suffix(".tmp")
    tmp.parent.mkdir(parents=True, exist_ok=True)
    tmp.write_text(json.dumps(state, indent=1) + "\n")
    tmp.chmod(0o644)
    os.replace(tmp, sharing.STATE)


def systemctl(*args):
    return subprocess.run(["/usr/bin/systemctl", *args], capture_output=True, text=True).returncode == 0


def home_devices():
    return sorted({n.device for n in net.networks() if n.device and n.zone == net.HOME and IFACE.match(n.device)})


def sharing_stop():
    """Stop what Shared folders started; a Samba set up by hand (not started here) is left alone."""
    if WSDD_OPTIONS.exists():
        systemctl("stop", "--no-block", "wsdd.service", "smb.service")
        subprocess.run(["/usr/sbin/setsebool", "samba_enable_home_dirs", "off"], capture_output=True)
        WSDD_OPTIONS.unlink()


def sharing_sync(close=None):
    """Samba gets the folder list and runs only while a Home network is connected; Windows finds it only there.
    close: a share taken out or changed, so connections already open to it are dropped."""
    if not sharing.set_up():          # smb.conf was replaced: stop only what Shared folders started
        sharing_stop()
        return
    state = sharing.load()
    home = home_devices()
    shared = any(f["owner"] in state["passwords"] for f in state["folders"])
    sharing.SHARES.write_text(sharing.shares_conf(state))
    sharing.SHARES.chmod(0o644)
    if not (state["on"] and shared and home):
        sharing_stop()
        return
    options = "OPTIONS=" + " ".join(f"-i {i}" for i in home) + "\n"
    moved = not WSDD_OPTIONS.exists() or WSDD_OPTIONS.read_text() != options
    WSDD_OPTIONS.parent.mkdir(parents=True, exist_ok=True)
    WSDD_OPTIONS.write_text(options)
    subprocess.run(["/usr/sbin/setsebool", "samba_enable_home_dirs", "on"], capture_output=True)   # until restart
    systemctl("start", "--no-block", "avahi-daemon.service")
    if sharing.running():
        subprocess.run(["/usr/bin/smbcontrol", "smbd", "reload-config"], capture_output=True)
        if close:
            subprocess.run(["/usr/bin/smbcontrol", "smbd", "close-share", close], capture_output=True)
    else:                              # first start, or it stopped: start it again
        systemctl("start", "--no-block", "smb.service")
    systemctl("restart" if moved else "start", "--no-block", "wsdd.service")      # wsdd on the Home network only


def sharing_switch(want):
    """On: Home networks let sharing in (port 445). Off: taken back out, Samba stopped. For the whole computer."""
    state = sharing.load()
    on = want == "on"
    if on and not sharing.set_up():
        fail(_("{path} was changed on this computer and no longer reads the shared folders list.").format(
            path=sharing.SMB_CONF))
    if on and caller() not in state["passwords"]:
        fail(_("Set a sharing password first."), 3)
    flag = f"--{'add' if on else 'remove'}-service={sharing.FIREWALL_SERVICE}"
    r = subprocess.run(["/usr/bin/firewall-cmd", "--permanent", f"--zone={net.HOME}", flag],
                       capture_output=True, text=True)
    if r.returncode != 0 and "ALREADY_ENABLED" not in r.stderr and "NOT_ENABLED" not in r.stderr:
        fail(_("The firewall didn't take the change: {reason}").format(reason=r.stderr.strip()))
    if subprocess.run(["/usr/bin/firewall-cmd", "--reload"], capture_output=True).returncode != 0:
        fail(_("The firewall didn't reload."))
    state["on"] = on
    save_sharing(state)
    if on:
        sharing_sync()
    else:                              # off works even where smb.conf was replaced
        sharing_stop()


def real_folder(path, user):
    real = os.path.realpath(path) if path.startswith("/") else ""
    problem = sharing.folder_problem(real, user) if real else _("That folder wasn't found.")
    if problem:
        fail(problem, 3)
    return real


def sharing_folder(verb, path, mode=None):
    user = caller()
    state = sharing.load()
    real = real_folder(path, user) if verb == "add" else path      # remove and mode take the path as listed
    mine = next((f for f in state["folders"] if f["path"] == real and f["owner"] == user), None)
    if verb == "add":
        if mine:
            fail(_("That folder is already shared, as {name}.").format(name=mine["name"]), 3)
        name = sharing.share_name(real, [f["name"] for f in state["folders"]])
        state["folders"].append({"path": real, "owner": user, "mode": mode, "name": name})
    elif mine is None:
        fail(_("That folder isn't shared."), 3)
    elif verb == "mode":
        mine["mode"] = mode
    else:
        state["folders"].remove(mine)
    save_sharing(state)
    sharing_sync(close=None if verb == "add" else mine["name"])


def sharing_password():
    user = caller()
    pw = sys.stdin.read(1024)
    pw = pw[:-1] if pw.endswith("\n") else pw          # echo adds one
    if not sharing.clean(pw) or not sharing.MIN_PASSWORD <= len(pw) <= 127:
        fail(_("Use {min} to 127 characters, on one line.").format(min=sharing.MIN_PASSWORD), 3)
    r = subprocess.run(["/usr/bin/smbpasswd", "-s", "-a", user], input=f"{pw}\n{pw}\n", capture_output=True,
                       text=True)
    if r.returncode != 0:
        fail(_("The password wasn't saved: {reason}").format(reason=(r.stderr or r.stdout).strip()))
    state = sharing.load()
    if user not in state["passwords"]:
        state["passwords"].append(user)
    save_sharing(state)
    sharing_sync()


def sharing_command(args):
    SHARING_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(SHARING_LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if len(args) == 1 and args[0] in ("on", "off"):
            sharing_switch(args[0])
        elif len(args) == 3 and args[0] in ("add", "mode") and args[2] in sharing.MODES:
            sharing_folder(args[0], args[1], args[2])
        elif len(args) == 2 and args[0] == "remove":
            sharing_folder("remove", args[1])
        elif args == ["password"]:
            sharing_password()
        elif args == ["sync"]:
            sharing_sync()


LET_IN_LOCK = Path("/run/evenkeel-os/let-in.lock")
LET_IN_ZONES = {"home": net.HOME, "work": net.WORK, "public": net.PUBLIC}
# Done once: before this, Work let in ports 1025 to 65535 and the SSH and printer switches, like Home.
WORK_UPDATED = Path("/var/lib/evenkeel-os/work-lets-nothing-in")
OLD_WORK = (["--remove-port=1025-65535/tcp", "--remove-port=1025-65535/udp", "--remove-service=ssh",
             "--remove-service=ipp"])


def firewall_change(zone, flags, mend=()):
    """Saved changes to one zone, then reloaded; "" when it worked. Already there, or already gone, is fine.
    mend: changes made even when one of flags failed, so the saved settings never keep a hole."""
    problem = ""
    for flag in [*flags, *mend]:
        if problem and flag not in mend:
            continue
        r = subprocess.run(["/usr/bin/firewall-cmd", "--permanent", f"--zone={zone}", flag],
                           capture_output=True, text=True)
        if r.returncode != 0 and not any(w in r.stderr for w in ("ALREADY_ENABLED", "NOT_ENABLED")):
            problem = problem or _("The firewall didn't take the change: {reason}").format(reason=r.stderr.strip())
    if subprocess.run(["/usr/bin/firewall-cmd", "--reload"], capture_output=True).returncode != 0:
        problem = problem or _("The firewall didn't reload.")
    return problem


def save_let_in(state):
    tmp = letin.STATE.with_suffix(".tmp")
    tmp.parent.mkdir(parents=True, exist_ok=True)
    tmp.write_text(json.dumps(state, indent=1) + "\n")
    tmp.chmod(0o644)
    os.replace(tmp, letin.STATE)


def still_open(zone, entries):
    """Adds back every port the place itself and these entries use. firewalld merges and splits port ranges, so taking
    a port out can cut a hole in a range something else needs; adding them all back mends it."""
    unused, base_ports = letin.zone_base(zone)
    return [f"--add-port={p}" for p in sorted(base_ports | {p for e in entries for p in e["ports"]})]


def let_in_add(zone, entry, flags):
    state = letin.load()
    entries = state.setdefault(zone, [])
    if any(e["id"] == entry["id"] for e in entries):
        fail(_("{label} is already let in here.").format(label=entry["label"]), 3)
    problem = firewall_change(zone, flags)
    if problem:         # take back whatever got in before the firewall refused
        firewall_change(zone, [f.replace("--add-", "--remove-", 1) for f in flags], still_open(zone, entries))
        fail(problem)
    entries.append(entry)
    save_let_in(state)


SHARING_PORTS = ("445/tcp", "139/tcp", "137/udp", "138/udp", "3702/udp", "3702/tcp", "5357/tcp")    # Samba, wsdd


def shares_folders(zone, ports):
    """Folders are shared only on Home (Shared folders): Samba's and wsdd's ports can't be let in anywhere else."""
    def inside(p, q):
        (lo, hi), (qlo, qhi) = (tuple(map(int, (x.split("/")[0].split("-") * 2)[:2])) for x in (p, q))
        return p.split("/")[1] == q.split("/")[1] and lo <= qhi and qlo <= hi
    return zone != net.HOME and any(inside(p, q) for p in ports for q in SHARING_PORTS)


def service_ports(service, seen=()):
    """A firewalld service's ports, with those of the services it includes; [] for one that isn't there."""
    path = letin.SERVICES / f"{service}.xml"
    if service in seen or not letin.SERVICE_NAME.match(service) or not path.is_file():
        return []
    text = path.read_text()
    found = [letin.port(f"{p}/{proto}") for p, proto in
             re.findall(r'<port\b(?=[^>]*\bport="([0-9-]+)")(?=[^>]*\bprotocol="(tcp|udp)")[^>]*>', text)]
    for inc in re.findall(r'<include\s+service="([^"]+)"', text):
        found += service_ports(inc, (*seen, service))
    return [p for p in found if p]


def let_in_app(zone, service):
    """A firewalld service from the image's own list; the SSH and printer switches cover those two on Home."""
    path = letin.SERVICES / f"{service}.xml"
    base, unused = letin.zone_base(zone)
    if not letin.SERVICE_NAME.match(service) or not path.is_file() or service.startswith("evenkeel-"):
        fail(_("{service} isn't an app on this computer's list.").format(service=service), 3)
    if service in base:
        fail(_("{service} is always let in here.").format(service=service), 3)
    if zone == net.HOME and service in FIREWALL_SERVICES:
        fail(_("On Home, use the switch for it above."), 3)
    if shares_folders(zone, service_ports(service)):
        fail(_("It opens file sharing ports: folders are shared only on Home networks, in Shared folders."), 3)
    short = re.search(r"<short>([^<]*)</short>", path.read_text())
    let_in_add(zone, {"id": service, "label": letin.label(short[1] if short else "") or service,
                      "service": service, "ports": []}, [f"--add-service={service}"])


def let_in_ports(zone, name, specs):
    tidy, ports = letin.label(name), letin.ports(specs)
    if not tidy:
        fail(_("Give it a name of 1 to {max} characters.").format(max=letin.MAX_LABEL), 3)
    if ports is None:
        fail(_("Use 1 to {max} ports from 1 to 65535, each as 8096/tcp or 2456-2458/udp.").format(
            max=letin.MAX_PORTS), 3)
    if shares_folders(zone, ports):
        fail(_("Those are file sharing ports: folders are shared only on Home networks, in Shared folders."), 3)
    entry_id = "ports:" + ",".join(ports)
    let_in_add(zone, {"id": entry_id, "label": tidy, "service": "", "ports": ports},
               [f"--add-port={p}" for p in ports])


def let_in_remove(zone, entry_id):
    """Out of the list and the zone; a port another entry or the place itself still uses stays open."""
    state = letin.load()
    entries = state.get(zone, [])
    entry = next((e for e in entries if e["id"] == entry_id), None)
    if entry is None:
        fail(_("That isn't let in here."), 3)
    rest = [e for e in entries if e is not entry]
    base_services, unused = letin.zone_base(zone)
    flags = [f"--remove-port={p}" for p in entry["ports"]]
    if entry["service"] and entry["service"] not in base_services:
        flags.append(f"--remove-service={entry['service']}")
    problem = firewall_change(zone, flags, still_open(zone, rest) if entry["ports"] else ())
    if problem:
        fail(problem)
    state[zone] = rest
    save_let_in(state)


def let_in_update():
    """Once: Work becomes like Public. Only a Work zone changed on this computer (in /etc) holds the old rules."""
    if WORK_UPDATED.exists():
        return
    if Path(f"/etc/firewalld/zones/{net.WORK}.xml").exists():
        problem = firewall_change(net.WORK, OLD_WORK)
        if problem:
            fail(problem)
    WORK_UPDATED.parent.mkdir(parents=True, exist_ok=True)
    WORK_UPDATED.touch()


def let_in_command(args):
    LET_IN_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(LET_IN_LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args == ["update"]:
            let_in_update()
            return
        zone = LET_IN_ZONES[args[0]]
        if args[1] == "app":
            let_in_app(zone, args[2])
        elif args[1] == "ports":
            let_in_ports(zone, args[2], args[3:])
        else:
            let_in_remove(zone, args[2])


def main(argv):
    if os.geteuid() != 0:
        fail("This helper runs as root, through polkit.")
    if len(argv) == 3 and argv[1] == "updates" and argv[2] in ("on", "off"):
        updates(argv[2])
    elif len(argv) == 3 and argv[1] == "disk-unlock" and argv[2] == "check":
        disk_unlock_check()
    elif len(argv) == 3 and argv[1] == "disk-unlock" and argv[2] in ("on", "off"):
        disk_unlock(argv[2])
    elif argv[1:] == ["test-rollback", "clear"]:
        test_rollback_clear()
    elif len(argv) == 3 and argv[1] == "test-rollback" and argv[2] in TEST_KINDS:
        test_rollback(argv[2])
    elif argv[1:] == ["keep-update"]:
        keep_update()
    elif len(argv) == 4 and argv[1] == "firewall" and argv[2] in FIREWALL_SERVICES and argv[3] in ("on", "off"):
        firewall(argv[2], argv[3])
    elif argv[1:] == ["firewall", "default"]:
        firewall_default()
    elif argv[1:2] == ["sharing"] and (argv[2:] in (["on"], ["off"], ["password"], ["sync"]) or
                                       (len(argv) == 5 and argv[2] in ("add", "mode") and argv[4] in sharing.MODES)
                                       or (len(argv) == 4 and argv[2] == "remove")):
        sharing_command(argv[2:])
    elif argv[1:] == ["let-in", "update"] or (len(argv) >= 5 and argv[1] == "let-in" and argv[2] in LET_IN_ZONES and
                                               ((argv[3] in ("app", "remove") and len(argv) == 5) or
                                                (argv[3] == "ports" and len(argv) >= 6))):
        let_in_command(argv[2:])
    else:
        fail(__doc__, 2)


if __name__ == "__main__":
    main(sys.argv)
