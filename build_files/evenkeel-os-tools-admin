#!/usr/bin/python3 -I
"""System Tools jobs that change the system, as root through polkit (administrator password).

  evenkeel-os-tools-admin updates on|off
  evenkeel-os-tools-admin disk-unlock on|off      (the disk password on standard input)
  evenkeel-os-tools-admin disk-unlock check
  evenkeel-os-tools-admin test-rollback KIND      KIND: quick, no-login-screen, no-networking, stuck, login-loop, freeze
                                                  (exit 4: installed before greenboot, 5: an update is waiting,
                                                  6: this start is a test copy)
  evenkeel-os-tools-admin test-rollback clear     take the test marker off the version running now
  evenkeel-os-tools-admin firewall SERVICE on|off  SERVICE: ssh, ipp; on Home and Work networks only, never Public
  evenkeel-os-tools-admin firewall default        a network with no place set is a Public place
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

DISK_UNLOCK_ON = Path("/var/lib/evenkeel-os/disk-unlock-on")
# Switched on from /usr (build.sh), so deleting /etc can't switch it off; systemctl is-enabled only reads /etc.
GREENBOOT_ON = Path("/usr/lib/systemd/system/multi-user.target.wants/greenboot-healthcheck.service")
UUID = re.compile(r"^[0-9a-fA-F-]{36}$")
FIREWALL_SERVICES = ("ssh", "ipp")             # the Network safety switches: SSH, Share my printer
SWITCHED_ZONES = ("evenkeel-home", "evenkeel-work")


def fail(msg, code=1):
    print(msg)
    sys.exit(code)


def disk():
    for a in Path("/proc/cmdline").read_text().split():
        if a.startswith("rd.luks.uuid="):
            v = a.split("=", 1)[1]
            v = v[5:] if v.startswith("luks-") else v
            if UUID.match(v) and Path(f"/dev/disk/by-uuid/{v}").exists():
                return f"/dev/disk/by-uuid/{v}"
            fail("The encrypted disk named at startup was not found.")
    fail("The system disk is not encrypted.")


def tpm_enrolled(dev):
    """Does the disk's LUKS header hold a TPM enrollment? None when the header can't be read."""
    r = subprocess.run(["/usr/sbin/cryptsetup", "luksDump", "--dump-json-metadata", dev],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        tokens = json.loads(r.stdout).get("tokens", {})
    except ValueError:
        return None
    return any(t.get("type") == "systemd-tpm2" for t in tokens.values())


def mark(on):
    if on:
        DISK_UNLOCK_ON.parent.mkdir(parents=True, exist_ok=True)
        DISK_UNLOCK_ON.write_text("TPM2 unlock enrolled (checked against the disk)\n")
    else:
        DISK_UNLOCK_ON.unlink(missing_ok=True)


def disk_unlock_check():
    dev = None
    for a in Path("/proc/cmdline").read_text().split():
        if a.startswith("rd.luks.uuid="):
            v = a.split("=", 1)[1]
            v = v[5:] if v.startswith("luks-") else v
            if UUID.match(v) and Path(f"/dev/disk/by-uuid/{v}").exists():
                dev = f"/dev/disk/by-uuid/{v}"
    if dev is None:             # no encrypted system disk: nothing to unlock
        mark(False)
        return
    on = tpm_enrolled(dev)
    if on is not None:          # leave the note alone if the header couldn't be read
        mark(on)
    print("on" if on else "off" if on is not None else "unknown")


def updates(state):
    cmd = ["/usr/bin/systemctl", "enable", "--now", "uupd.timer"] if state == "on" else \
        ["/usr/bin/systemctl", "disable", "--now", "uupd.timer"]
    sys.exit(subprocess.run(cmd).returncode)


def disk_unlock(state):
    dev = disk()
    pw = sys.stdin.read(4096)
    if not pw:
        fail("No disk password was given.")
    # A wrong password changes nothing: check it before anything else.
    if subprocess.run(["/usr/sbin/cryptsetup", "open", "--test-passphrase", "--key-file=-", dev], input=pw.encode(),
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        fail("That is not the disk password.", 3)
    env = {"PATH": "/usr/sbin:/usr/bin", "PASSWORD": pw}
    if state == "on":
        if not Path("/dev/tpmrm0").exists():
            fail("This computer has no TPM.")
        # Enrolls the TPM, then wipes any older TPM enrollment (the new one is kept).
        cmd = ["/usr/bin/systemd-cryptenroll", "--wipe-slot=tpm2", "--tpm2-device=auto", "--tpm2-pcrs=7+14", dev]
    else:
        cmd = ["/usr/bin/systemd-cryptenroll", "--wipe-slot=tpm2", dev]
    r = subprocess.run(cmd, env=env, stdin=subprocess.DEVNULL)
    if r.returncode != 0:
        fail("systemd-cryptenroll did not finish.")
    # Check the disk itself, not the command's exit code alone, and keep the note in step with it.
    on = tpm_enrolled(dev)
    mark(bool(on))
    if on is None:
        fail("The disk's settings couldn't be read back to check.")
    if on != (state == "on"):
        fail("The disk didn't take the change.")
    print("done")


TEST_KINDS = ("quick", "no-login-screen", "no-networking", "stuck", "login-loop", "freeze")


def running_test():
    """The test this start is running (its kernel argument), or None."""
    for arg in Path("/proc/cmdline").read_text().split():
        if arg.startswith("evenkeel_os.test_rollback="):
            return arg.split("=", 1)[1]
    return None


def test_rollback_clear():
    kind = running_test()
    if kind is None:
        fail("This start isn't a test copy.")
    sys.exit(subprocess.run(["/usr/bin/rpm-ostree", "kargs", f"--delete=evenkeel_os.test_rollback={kind}"]).returncode)


def test_rollback(kind):
    """A copy of the running version that breaks on purpose (see build_files/greenboot), for the next restart."""
    masked = subprocess.run(["/usr/bin/systemctl", "is-enabled", "greenboot-healthcheck.service"],
                            capture_output=True, text=True).stdout.strip().startswith("masked")
    if not GREENBOOT_ON.exists() or masked:
        fail("Automatic rollback is not turned on in this version, or it was switched off (masked).", 4)
    try:
        counting = "boot_counter" in Path("/boot/grub2/grub.cfg").read_text()
    except OSError:
        counting = False
    if not counting:
        fail("The boot menu has no rollback counter: this computer was installed before automatic rollback.", 4)
    if running_test():
        fail("This start is a test copy; take its test marker off first.", 6)
    try:
        ds = json.loads(subprocess.run(["/usr/bin/rpm-ostree", "status", "--json"], capture_output=True, text=True,
                                       check=True).stdout)["deployments"]
    except (subprocess.CalledProcessError, ValueError, KeyError) as e:
        fail(f"The system versions couldn't be read: {e}")
    if any(d.get("staged") for d in ds):
        fail("An update is waiting for a restart.", 5)
    sys.exit(subprocess.run(["/usr/bin/rpm-ostree", "kargs", f"--append=evenkeel_os.test_rollback={kind}"]).returncode)


def let_in(service, state):
    """Home and Work networks let the service in (on) or keep it out (off); saved and reloaded. "" when it worked."""
    for zone in SWITCHED_ZONES:
        flag = f"--{'add' if state == 'on' else 'remove'}-service={service}"
        r = subprocess.run(["/usr/bin/firewall-cmd", "--permanent", f"--zone={zone}", flag],
                           capture_output=True, text=True)
        if r.returncode != 0 and "ALREADY_ENABLED" not in r.stderr and "NOT_ENABLED" not in r.stderr:
            return f"The firewall didn't take the change: {r.stderr.strip()}"
    if subprocess.run(["/usr/bin/firewall-cmd", "--reload"], capture_output=True).returncode != 0:
        return "The firewall didn't reload."
    return ""


def firewall(service, state):
    """Switch a service on (it runs, and Home and Work networks let it in) or off; both or neither."""
    problem = let_in(service, state)
    if problem:
        fail(problem)
    if service == "ssh":        # the SSH server, off in Fedora until switched on
        run = ["/usr/bin/systemctl", "enable" if state == "on" else "disable", "--now", "sshd.service"]
    else:                       # printers plugged into this computer, shared with the network or not
        run = ["/usr/bin/cupsctl", "--share-printers" if state == "on" else "--no-share-printers"]
    r = subprocess.run(run, capture_output=True, text=True)
    if r.returncode != 0:
        let_in(service, "off" if state == "on" else "on")       # put the firewall back as it was
        fail(f"{service} didn't change, so the firewall was left as it was: {(r.stderr or r.stdout).strip()}")


def firewall_default():
    r = subprocess.run(["/usr/bin/firewall-cmd", "--set-default-zone=evenkeel-public"], capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"The firewall didn't take the change: {r.stderr.strip()}")


def main(argv):
    if os.geteuid() != 0:
        fail("This helper runs as root, through polkit.")
    if len(argv) == 3 and argv[1] == "updates" and argv[2] in ("on", "off"):
        updates(argv[2])
    elif len(argv) == 3 and argv[1] == "disk-unlock" and argv[2] == "check":
        disk_unlock_check()
    elif len(argv) == 3 and argv[1] == "disk-unlock" and argv[2] in ("on", "off"):
        disk_unlock(argv[2])
    elif argv[1:] == ["test-rollback", "clear"]:
        test_rollback_clear()
    elif len(argv) == 3 and argv[1] == "test-rollback" and argv[2] in TEST_KINDS:
        test_rollback(argv[2])
    elif len(argv) == 4 and argv[1] == "firewall" and argv[2] in FIREWALL_SERVICES and argv[3] in ("on", "off"):
        firewall(argv[2], argv[3])
    elif argv[1:] == ["firewall", "default"]:
        firewall_default()
    else:
        fail(__doc__, 2)


if __name__ == "__main__":
    main(sys.argv)
