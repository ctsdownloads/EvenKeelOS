#!/usr/bin/python3 -I
"""System Update's helpers: staged, failed-parts, low-battery, progress, whats-new."""

import json
import os
import re
import select
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/evenkeel-os")
from evenkeel_os_ui import N_, _, human, ngettext


def staged():
    """Exit 0 when rpm-ostree's status (stdin) has a new system waiting for a restart."""
    sys.exit(0 if any(d.get("staged") for d in json.load(sys.stdin)["deployments"]) else 1)


def failed_parts():
    """The updater's own summary of what failed, from its log lines on stdin."""
    out = ""
    for line in sys.stdin:
        try:
            m = json.loads(line).get("msg", "")
        except ValueError:      # not one of the updater's JSON lines
            continue
        if "module(s) failed:" in m:
            out = m.split("failed:", 1)[1].strip()
    print(out)


def low_battery():
    """The battery charge, if on battery and below uupd's bat-min-percent."""
    try:
        limit = int(json.loads(Path("/etc/uupd/config.json").read_text())["checks"]["hardware"]["bat-min-percent"])
    except (OSError, ValueError, KeyError, TypeError):
        limit = 20          # uupd's own default when its config is missing or unreadable
    ps = Path("/sys/class/power_supply")

    def read(d, f):
        try:
            return (d / f).read_text().strip()
        except OSError:          # an entry that has gone, or has no such file
            return ""

    supplies = list(ps.iterdir()) if ps.is_dir() else []
    if any(read(d, "type") in ("Mains", "USB") and read(d, "online") == "1" for d in supplies):
        raise SystemExit
    levels = [int(read(d, "capacity")) for d in supplies
              if read(d, "type") == "Battery" and read(d, "scope") != "Device" and read(d, "capacity").isdigit()
              and read(d, "status") == "Discharging"]
    if levels and min(levels) < limit:
        print(min(levels))


def received():
    total = 0
    try:
        for line in open("/proc/net/dev").read().splitlines()[2:]:
            name, data = line.split(":", 1)
            if name.strip() != "lo":
                total += int(data.split()[0])
    except (OSError, ValueError, IndexError):
        return None
    return total


def nbytes(size):
    m = re.match(r"([0-9.]+)\s*([kMGT]?B)", size.replace(" ", " "))
    if not m:
        return None
    return float(m.group(1)) * {"B": 1, "kB": 1e3, "MB": 1e6, "GB": 1e9, "TB": 1e12}[m.group(2)]


def added_to_system():
    """Does the running system have apps added to it (layered packages)? Then the install has a stage for them."""
    try:
        out = subprocess.run(["rpm-ostree", "status", "--json", "--booted"], capture_output=True, timeout=30).stdout
        d = next(d for d in json.loads(out)["deployments"] if d.get("booted"))
    except (OSError, ValueError, KeyError, StopIteration, subprocess.SubprocessError):
        return False
    return any(d.get(k) for k in ("requested-packages", "requested-local-packages", "requested-base-removals",
                                  "requested-base-local-replacements"))


STAGES = {"unpack": N_("unpacking the new version"),
          "apps": N_("adding the apps you put on the system to the new version"),
          "save": N_("saving the new version so it starts at your next restart")}


def ago(secs):
    if secs < 60:
        return ngettext("{n} second so far", "{n} seconds so far", secs).format(n=secs)
    return ngettext("about {n} min so far", "about {n} min so far", round(secs / 60)).format(n=round(secs / 60))


def progress():
    """Turn the updater's log lines on stdin into progress text and bar moves for zenity."""
    sys.stdout.reconfigure(line_buffering=True)
    step, since, shown, buf = "", 0.0, 0, b""
    parts = done = 0
    size_text, size, base, said = "", None, None, 0.0
    low, width = 0.0, 0.0        # the part of the bar that belongs to the system step
    order, stage, began = [], "", 0.0

    def bar(frac):
        if width:
            print(int(low + width * min(max(frac, 0.0), 1.0)))

    def install(name):
        nonlocal stage, began, said
        stage, began, said = name, time.time(), time.time()
        k = order.index(name)
        bar(0.7 + 0.3 * k / len(order))
        # Translators: {stage} is a phrase that ends the sentence, such as "unpacking the new version"
        print("# " + _("Updating the system: step {step} of {total}, {stage}.").format(
            step=k + 1, total=len(order), stage=_(STAGES[name])))

    while True:
        ready, _w, _x = select.select([sys.stdin], [], [], 5)
        if ready:
            chunk = os.read(sys.stdin.fileno(), 65536)
            if not chunk:
                break
            buf += chunk
            *lines, buf = buf.split(b"\n")
            for line in lines:
                try:
                    d = json.loads(line)
                except ValueError:      # not one of the updater's JSON lines
                    continue
                msg = str(d.get("msg", ""))
                if msg == "Updating" and "title" in d:
                    step = _("Updating {title}: {description}").format(title=d["title"],
                                                                        description=d.get("description", ""))
                    since, shown = time.time(), 0
                    parts = done = 0
                    stage = ""
                    low, width = float(d.get("overall", 0)), 0.0
                    if d["title"] == "System":
                        width = 100.0 / max(int(d.get("total", 1) or 1), 1)
                        order = ["unpack", "apps", "save"] if added_to_system() else ["unpack", "save"]
                    print(int(low))
                    print("# " + step)
                    continue
                text = None
                m = re.search(r"layers needed: (\d+) \(([^)]*)\)", msg)
                if m:
                    parts += int(m.group(1))
                    size_text = m.group(2).replace(" ", " ")
                    size, base = nbytes(size_text), received()
                    text = ngettext("Updating the system: downloading the new version, {size} in {n} parts.",
                                    "Updating the system: downloading the new version, {size} in {n} parts.",
                                    parts).format(size=size_text, n=parts)
                elif re.match(r"\[(\d+)/(\d+)\]", msg) and msg.endswith("done"):
                    done, parts = map(int, re.match(r"\[(\d+)/(\d+)\]", msg).groups())
                    if done < parts:
                        text = _("Updating the system: downloaded part {done} of {total}.").format(
                            done=done, total=parts)
                        bar(0.7 * done / parts)
                    elif order:
                        install("unpack")
                elif msg.startswith("Pulling manifest"):
                    text = _("Updating the system: checking for a new version.")
                elif msg.startswith("Checking out tree") and order:
                    install(order[1])
                elif msg.startswith("Writing OSTree commit") and stage == "apps":
                    install("save")
                elif msg.startswith("Staging deployment") and msg.endswith("done"):
                    stage = ""
                    bar(1.0)
                    text = _("Updating the system: the new version is installed. It starts at your next restart.")
                elif msg.startswith("No upgrade available"):
                    text = _("Updating the system: it is already up to date.")
                if text:
                    since, shown, said = time.time(), 0, time.time()
                    print("# " + text)
        elif stage:
            if time.time() - said >= 10:
                said = time.time()
                k = order.index(stage)
                # Translators: {stage} is a phrase such as "unpacking the new version"; {elapsed} is the time so far
                print("# " + _("Updating the system: step {step} of {total}, {stage} ({elapsed}).").format(
                    step=k + 1, total=len(order), stage=_(STAGES[stage]), elapsed=ago(int(time.time() - began))))
        elif parts and done < parts and size and base is not None and time.time() - said >= 10:
            now = received()
            if now is not None:
                got = min(max(now - base, 0), size)
                said = time.time()
                bar(0.7 * got / size)
                print("# " + _("Updating the system: downloading part {part} of {total}, "
                                "about {got} of {size} so far.").format(
                    part=min(done + 1, parts), total=parts, got=human(got / 1e6), size=size_text))
        elif step:
            mins = int(time.time() - since) // 60
            if mins > shown:
                shown = mins
                print("# " + _("{step}  (still working, {n} min so far)").format(step=step, n=mins))


def whats_new():
    """What the staged version changes, from rpm-ostree's status on stdin."""
    try:
        ds = json.load(sys.stdin)["deployments"]
        new = next(d for d in ds if d.get("staged"))
        now = next(d for d in ds if d.get("booted"))
        f = Path("/ostree/deploy/%s/deploy/%s.%s/usr/share/evenkeel-os/changes.txt" % (new["osname"], new["checksum"],
                                                                                       new["serial"]))
        lines = f.read_text().splitlines()
    except (ValueError, KeyError, StopIteration, OSError):
        sys.exit()
    try:
        have = set(Path("/usr/share/evenkeel-os/changes.txt").read_text().splitlines())
    except OSError:
        have = set()
    since = time.strftime("%Y-%m-%d", time.gmtime(int(now.get("timestamp", 0))))
    out = []
    for line in lines:
        date, _tab, title = line.partition("\t")
        if line in have or date < since or re.match(r"(README|Build)\b", title):
            continue
        title = re.sub(r"\s*\(#\d+\)$", "", title)
        out.append("- " + title.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
    if out:
        more = len(out) - 8
        rest = ngettext("- and {n} more", "- and {n} more", more).format(n=more) if more > 0 else ""
        print(_("What is new:") + "\n" + "\n".join(out[:8]) + ("\n" + rest if rest else ""))


COMMANDS = {"staged": staged, "failed-parts": failed_parts, "low-battery": low_battery, "progress": progress,
            "whats-new": whats_new}

if __name__ == "__main__":
    if len(sys.argv) != 2 or sys.argv[1] not in COMMANDS:
        sys.exit("usage: evenkeel-os-update-helper " + "|".join(COMMANDS))
    COMMANDS[sys.argv[1]]()
