#!/usr/bin/python3 -I
"""Wheelhouse, Boot options, as root through polkit (the administrator password every time).

  evenkeel-os-boot-options set [SETTING...]   the full list of settings Wheelhouse adds (none: take them all out);
                                              common fixes left out are taken out too
                                              (exit 3: refused; 4: a rollback test copy is running)
"""
import fcntl
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/evenkeel-os")
import evenkeel_os_bootopts as bootopts  # noqa: E402
import evenkeel_os_health as health  # noqa: E402
from evenkeel_os_ui import _, fail, save_json  # noqa: E402

LOCK = Path("/run/evenkeel-os/boot-options.lock")


def change(settings):
    for s in settings:
        if bootopts.problem(s):
            fail(bootopts.problem(s), 3)
    if len(settings) > bootopts.MAX or len({bootopts.name(s) for s in settings}) != len(settings):
        fail(_("Up to {max} settings, each name once.").format(max=bootopts.MAX), 3)
    if health.running_test() is not None:
        fail(_("A rollback test copy is running. Restart first, so the computer goes back to the usual version."), 4)
    before = bootopts.next_start()
    if before is None:
        fail(_("The boot options the computer starts with couldn't be read."))
    # A setting the computer already had (like quiet) isn't recorded as added, so it's never taken out.
    out = [s for s in dict.fromkeys(bootopts.added() + sorted(bootopts.COMMON_SETTINGS)) if s not in settings]
    mine = [s for s in settings if s not in before or s in bootopts.added()]
    cmd = ["/usr/bin/rpm-ostree", "kargs", "--unchanged-exit-77"]
    cmd += [f"--delete-if-present={s}" for s in out] + [f"--append-if-missing={s}" for s in settings]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode not in (0, 77):
        fail(_("The boot options didn't change: {reason}").format(reason=" ".join((r.stderr or r.stdout).split())))
    save_json(bootopts.STATE, {"options": mine})


def main(argv):
    if os.geteuid() != 0:
        fail("This helper runs as root, through polkit.")
    if argv[1:2] != ["set"]:
        fail(__doc__, 2)
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        change(argv[2:])


if __name__ == "__main__":
    main(sys.argv)
