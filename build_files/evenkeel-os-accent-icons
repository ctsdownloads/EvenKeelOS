#!/usr/bin/bash
# Keeps the folder icons in the accent color picked in Settings, Appearance (blue is GNOME's own icons).
# Only switches between GNOME's own icons and our colored copies of them; any other icon theme is left alone.
# --once: match once and exit (the build test); otherwise match at login and whenever the accent color changes.
match() {
  local cur acc want
  cur=$(gsettings get org.gnome.desktop.interface icon-theme | tr -d "'")
  case "$cur" in
    Adwaita|Adwaita-blue|Adwaita-teal|Adwaita-green|Adwaita-yellow|Adwaita-orange|Adwaita-red|Adwaita-pink|\
Adwaita-purple|Adwaita-slate) ;;
    *) return 0 ;;
  esac
  acc=$(gsettings get org.gnome.desktop.interface accent-color | tr -d "'")
  want=Adwaita-$acc
  [ "$acc" = blue ] && want=Adwaita
  [ -f "/usr/share/icons/$want/index.theme" ] || want=Adwaita
  [ "$cur" = "$want" ] || gsettings set org.gnome.desktop.interface icon-theme "$want"
}
match
[ "${1:-}" = --once ] && exit 0
gsettings monitor org.gnome.desktop.interface accent-color | while read -r _; do
  match
done
