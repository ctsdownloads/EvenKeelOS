// No password for a local, active wheel user running evenkeel-os-tools-safe or the codecs helper; the rest asks.
polkit.addRule(function(action, subject) {
    if ((action.id == "io.github.ctsdownloads.evenkeel-os.tools.safe" ||
         action.id == "io.github.ctsdownloads.evenkeel-os.codecs.setup") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
