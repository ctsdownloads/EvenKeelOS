[Desktop Entry]
Type=Application
Name=Network safety question
Comment=Asks once whether a password Wi-Fi or wired network is Home, Work or a Public place
Exec=/usr/libexec/evenkeel-os-network-ask --watch
Terminal=false
NoDisplay=true
OnlyShowIn=GNOME;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
