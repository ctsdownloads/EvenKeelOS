#!/usr/bin/python3 -I
"""Wheelhouse's settings repair test, as root through polkit (admin password every time). Takes no arguments.

  evenkeel-os-settings-test     delete important settings for real and restart; the next start puts them back
                                (exit 4: installed before automatic rollback, 5: an update is waiting, 6: this start
                                is a test copy, 7: no saved copy from this start, 8: no earlier version to fall back
                                to, 9: another version is set to start next, 10: settings were deleted but the
                                restart didn't happen: restart now, 11: the earlier version has no settings repair)
"""
import os
import re
import subprocess
import sys

sys.path.insert(0, "/usr/lib/evenkeel-os")
import evenkeel_os_health as health  # noqa: E402

SETTINGS = "/usr/libexec/evenkeel-os-settings"
# Starts greenboot's retry counter, so a start that hangs before the checks still counts (see start_counter).
ARM = ('ro=0; findmnt -no OPTIONS /boot | tr , "\\n" | grep -qx ro && ro=1; '
       '[ "$ro" = 0 ] || mount -o remount,rw /boot || exit 1; '
       'grub2-editenv /boot/grub2/grubenv set boot_counter=1; rc=$?; '
       '[ "$ro" = 0 ] || mount -o remount,bind,ro /boot; exit "$rc"')


def fail(msg, code=1):
    print(msg)
    sys.exit(code)


def check_ready():
    """Refuse when greenboot can't catch the test, or while a test copy or an update is waiting."""
    code, why, ds = health.test_refusal()
    if code:
        fail(why, code)
    if len(ds) < 2:
        fail("There's no earlier version to fall back to.", 8)
    # After Undo or a boot menu pick, the restart starts another version, so nothing would be tested.
    if not ds[0].get("booted"):
        fail("Another version is set to start at the next restart.", 9)
    # If the repair fails, the start falls back to the earlier version: its own steps must know about this test.
    fallback = ds[1].get("checksum", "")
    if not re.fullmatch(r"[0-9a-f]{64}", fallback) or subprocess.run(
            ["/usr/bin/ostree", "ls", "--repo=/ostree/repo", fallback, "/usr/libexec/evenkeel-os-settings"],
            capture_output=True).returncode != 0:
        fail("The earlier version doesn't have the settings repair.", 11)
    if not os.path.ismount("/boot"):
        fail("/boot isn't mounted.")


def main(argv):
    if len(argv) != 1:
        fail(__doc__, 2)
    if os.geteuid() != 0:
        fail("This helper runs as root, through polkit.", 2)
    check_ready()
    rc = subprocess.run([SETTINGS, "fresh"]).returncode
    if rc != 0:
        sys.exit(7 if rc == 7 else 1)
    if subprocess.run(["/usr/bin/unshare", "--mount", "--propagation", "private", "/usr/bin/bash", "-c",
                       ARM]).returncode != 0:
        fail("The retry counter couldn't be started; nothing was deleted.")
    rc = subprocess.run([SETTINGS, "test-delete"]).returncode
    if rc == 10:
        fail("Deleting stopped partway: some settings are already deleted. Restart now.", 10)
    if rc != 0:
        fail("The settings weren't deleted.", 7 if rc == 7 else 1)
    if subprocess.run(["/usr/bin/systemctl", "reboot"]).returncode != 0:
        fail("The settings are deleted, but the restart didn't start. Restart now.", 10)
    sys.exit(0)


if __name__ == "__main__":
    main(sys.argv)
