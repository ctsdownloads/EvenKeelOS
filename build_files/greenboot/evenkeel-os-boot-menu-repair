#!/usr/bin/bash
# Repairs old boot menus where greenboot's file had no final line break and ran into the next line.
cfg=/boot/grub2/grub.cfg
bad='save_env boot_success### END'
grep -qF "$bad" "$cfg" || exit 0
tmp=$(mktemp)
sed "s/save_env boot_success### END/save_env boot_success\n### END/" "$cfg" >"$tmp"
if grep -qF "$bad" "$tmp" || ! grub2-script-check "$tmp"; then
  echo "The repaired boot menu didn't check out; nothing was changed."
  rm -f "$tmp"
  exit 1
fi
remount=0
if findmnt -no OPTIONS /boot | tr ',' '\n' | grep -qx ro; then
  mount -o remount,rw /boot || { echo "Can't make /boot writable"; rm -f "$tmp"; exit 1; }
  remount=1
fi
cp -p "$cfg" "$cfg.before-evenkeel-os-repair" && cat "$tmp" >"$cfg.new" && sync "$cfg.new" && mv "$cfg.new" "$cfg"
rc=$?
rm -f "$tmp"
# bind: read-only again for this service only, as greenboot does (not the whole /boot file system).
[ "$remount" = 1 ] && mount -o remount,bind,ro /boot
[ "$rc" = 0 ] && echo "Boot menu repaired: the automatic rollback counter now counts."
exit "$rc"
