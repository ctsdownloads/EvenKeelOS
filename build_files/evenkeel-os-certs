#!/usr/bin/python3 -I
"""Certificate alerts: the certificates this computer trusts that have expired, expire soon, or (ones added to it)
were removed. Runs as the person logged in, needs no administrator rights, and changes nothing in the system.

  evenkeel-os-certs check            write the alerts to ~/.local/state/evenkeel-os/cert-alerts.json
  evenkeel-os-certs check --notify   the same, with a notification when the alerts changed
  evenkeel-os-certs seen FINGERPRINT a removed certificate's alert was read: drop it
  evenkeel-os-certs trusted FINGERPRINT   exit 0 when that certificate is still trusted, 1 when it isn't
"""
import datetime
import hashlib
import json
import os
import re
import subprocess
import sys
import warnings
from pathlib import Path

from cryptography import x509
from cryptography.hazmat.primitives.serialization import Encoding

sys.path.insert(0, "/usr/lib/evenkeel-os")
from evenkeel_os_ui import _, ngettext  # noqa: E402

TRUSTED = Path("/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem")    # what secure connections trust now
BUILT_IN = Path("/usr/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem")    # this version's own list (ostree)
ADDED = Path("/etc/pki/ca-trust/source/anchors")    # certificates added to this computer
SOON = datetime.timedelta(days=30)
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "evenkeel-os"
ALERTS = STATE / "cert-alerts.json"
KNOWN = STATE / "cert-added.json"      # the added certificates seen before, to notice one that's removed
NOTIFIED = STATE / "cert-notified.json"
REMOVED_HERE = Path("/var/lib/evenkeel-os/certs-removed")   # removed in Wheelhouse (for every account)
PEM = re.compile(rb"-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----", re.S)
FINGERPRINT = re.compile(r"[0-9a-f]{64}")
NOTIFY = "/usr/bin/notify-send"


def certs(data):
    """The certificates in a PEM or DER file's bytes."""
    found = PEM.findall(data)
    out = []
    for blob in found or [data]:
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")    # a few long-trusted roots break newer rules (a zero serial number)
            try:
                out.append(x509.load_pem_x509_certificate(blob) if found else x509.load_der_x509_certificate(blob))
            except ValueError:
                if found:
                    print(f"A trusted certificate couldn't be read, so its date isn't checked:\n{blob.decode()}")
    return out


def describe(cert, file=""):
    names = cert.subject.get_attributes_for_oid(x509.NameOID.COMMON_NAME) or \
        cert.subject.get_attributes_for_oid(x509.NameOID.ORGANIZATION_NAME)
    der = cert.public_bytes(Encoding.DER)
    return {"name": str(names[0].value) if names else cert.subject.rfc4514_string(),
            "ends": cert.not_valid_after_utc.isoformat(), "fingerprint": hashlib.sha256(der).hexdigest(),
            "file": file}


def read(path):
    try:
        return path.read_bytes()
    except OSError:
        return b""


def added():
    """{fingerprint: description} of the certificates in ADDED (regular files only)."""
    out = {}
    try:
        files = sorted(p for p in ADDED.iterdir() if p.is_file() and not p.is_symlink())
    except OSError:
        return out
    for p in files:
        found = certs(read(p))
        for c in found:
            d = describe(c, p.name)
            d["in_file"] = len(found)      # removing the file removes them all
            out.setdefault(d["fingerprint"], d)
    return out


def load(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def save(path, data):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".new")
    tmp.write_text(json.dumps(data, indent=1))
    os.replace(tmp, path)


def trusted_now():
    """{fingerprint: description} trusted now (the system list and the added files), the added ones, built-in ones."""
    mine = added()
    built_in = {describe(c)["fingerprint"] for c in certs(read(BUILT_IN))}
    trusted = {}
    for c in certs(read(TRUSTED)):
        d = describe(c)
        trusted[d["fingerprint"]] = d
    trusted.update(mine)
    return trusted, mine, built_in


def check(notify):
    now = datetime.datetime.now(datetime.timezone.utc)
    trusted, mine, built_in = trusted_now()
    alerts = []
    for fp, d in sorted(trusted.items(), key=lambda kv: kv[1]["ends"]):
        ends = datetime.datetime.fromisoformat(d["ends"])
        kind = "expired" if ends <= now else "expiring" if ends - now <= SOON else None
        if kind:
            alerts.append({**d, "kind": kind, "added": fp in mine or (bool(built_in) and fp not in built_in)})
    known = load(KNOWN, {})
    try:
        removed_here = set(REMOVED_HERE.read_text().split())
    except OSError:
        removed_here = set()
    for fp in removed_here:
        known.pop(fp, None)     # taken out on purpose in Wheelhouse: no alert for anyone
    for fp, d in known.items():
        if fp not in mine:
            alerts.append({**d, "kind": "removed", "added": True})
    save(KNOWN, {**known, **mine})
    save(ALERTS, alerts)
    if notify:
        keys = sorted(f"{a['kind']} {a['fingerprint']}" for a in alerts)
        if not alerts:
            save(NOTIFIED, keys)
        elif keys != load(NOTIFIED, []) and os.path.exists(NOTIFY):
            n = len(alerts)
            text = ngettext("{n} security certificate expired, expire within 30 days or were removed. "
                            "Open Wheelhouse to see which.",
                            "{n} security certificates expired, expire within 30 days or were removed. "
                            "Open Wheelhouse to see which.", n).format(n=n)
            r = subprocess.run([NOTIFY, "--app-name=Wheelhouse", "--icon=security-high-symbolic",
                                _("Certificate alert"), text], capture_output=True, text=True)
            if r.returncode == 0:       # marked as shown only once it was: tried again at the next check otherwise
                save(NOTIFIED, keys)
            else:
                print(f"The notification couldn't be shown: {r.stderr.strip()}")
    print(f"{len(trusted)} trusted certificates, {len(mine)} added here; {len(alerts)} alerts.")
    return 0


def seen(fp):
    if not FINGERPRINT.fullmatch(fp):
        print(__doc__)
        return 2
    known = load(KNOWN, {})
    known.pop(fp, None)
    save(KNOWN, known)
    save(ALERTS, [a for a in load(ALERTS, []) if not (a.get("kind") == "removed" and a.get("fingerprint") == fp)])
    return 0


def trusted(fp):
    if not FINGERPRINT.fullmatch(fp):
        print(__doc__)
        return 2
    return 0 if fp in trusted_now()[0] else 1


def main(argv):
    if argv[1:] in (["check"], ["check", "--notify"]):
        return check(len(argv) == 3)
    if len(argv) == 3 and argv[1] == "seen":
        return seen(argv[2])
    if len(argv) == 3 and argv[1] == "trusted":
        return trusted(argv[2])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
